{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/paradigmxyz/solar/main/benches/lsp/raw.schema.json",
  "title": "Solar LSP benchmark raw manifest",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "context",
    "protocol",
    "upstream",
    "fixture",
    "binaries",
    "passes"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "kind": { "const": "solar-lsp-benchmark-raw" },
    "context": { "$ref": "#/$defs/context" },
    "protocol": {
      "type": "object",
      "required": [
        "warmup_iterations",
        "measured_iterations_per_session",
        "sessions_per_order",
        "passes",
        "methods",
        "sample_unit",
        "sample_precision",
        "threshold_percent",
        "threshold_absolute_ms",
        "confidence_level"
      ],
      "properties": {
        "warmup_iterations": { "const": 5 },
        "measured_iterations_per_session": { "const": 10 },
        "sessions_per_order": {
          "description": "Independent runner sessions in each server-order stratum",
          "const": 5
        },
        "passes": { "const": ["base-first", "head-first"] },
        "methods": {
          "description": "Pinned upstream benchmark selectors; textDocument/diagnostic measures didOpen to publishDiagnostics",
          "const": [
            "initialize",
            "textDocument/diagnostic",
            "textDocument/hover",
            "textDocument/definition",
            "textDocument/references",
            "textDocument/completion",
            "textDocument/documentSymbol"
          ]
        },
        "sample_unit": { "const": "milliseconds" },
        "sample_precision": {
          "description": "Measured iteration values are retained without the upstream two-decimal rounding",
          "const": "unrounded-f64"
        },
        "threshold_percent": { "const": 10.0 },
        "threshold_absolute_ms": { "const": 1.0 },
        "confidence_level": { "const": 0.95 }
      },
      "additionalProperties": false
    },
    "upstream": {
      "const": {
        "schema_version": 2,
        "repository": "asyncswap/lsp-bench",
        "version": "0.3.3",
        "tag": "v0.3.3",
        "commit": "ca0651f86f430290dacdbeb62c9c6987a3ad6966",
        "source": {
          "name": "lsp-bench-ca0651f86f430290dacdbeb62c9c6987a3ad6966.tar.gz",
          "url": "https://codeload.github.com/asyncswap/lsp-bench/tar.gz/ca0651f86f430290dacdbeb62c9c6987a3ad6966",
          "sha256": "145dc03c5606d6b5ec66647d233486bab9f4e65022275763bf445bc26414470e"
        },
        "adapter": {
          "path": "benches/lsp/lsp-bench-direct.patch",
          "sha256": "8d5242a63ff812056b449dedffd96e3f60bcc475dd8f39142b340acae7dbf7a2"
        }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } },
      "additionalProperties": false
    },
    "binaries": {
      "type": "object",
      "required": ["base", "head"],
      "properties": {
        "base": { "$ref": "#/$defs/binary" },
        "head": { "$ref": "#/$defs/binary" }
      },
      "additionalProperties": false
    },
    "passes": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/base_first_pass",
          "properties": {
            "session": { "const": 1 },
            "config": {
              "properties": { "path": { "const": "passes/base-first/1/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/base-first/1/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/head_first_pass",
          "properties": {
            "session": { "const": 1 },
            "config": {
              "properties": { "path": { "const": "passes/head-first/1/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/head-first/1/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/head_first_pass",
          "properties": {
            "session": { "const": 2 },
            "config": {
              "properties": { "path": { "const": "passes/head-first/2/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/head-first/2/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/base_first_pass",
          "properties": {
            "session": { "const": 2 },
            "config": {
              "properties": { "path": { "const": "passes/base-first/2/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/base-first/2/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/base_first_pass",
          "properties": {
            "session": { "const": 3 },
            "config": {
              "properties": { "path": { "const": "passes/base-first/3/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/base-first/3/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/head_first_pass",
          "properties": {
            "session": { "const": 3 },
            "config": {
              "properties": { "path": { "const": "passes/head-first/3/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/head-first/3/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/head_first_pass",
          "properties": {
            "session": { "const": 4 },
            "config": {
              "properties": { "path": { "const": "passes/head-first/4/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/head-first/4/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/base_first_pass",
          "properties": {
            "session": { "const": 4 },
            "config": {
              "properties": { "path": { "const": "passes/base-first/4/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/base-first/4/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/base_first_pass",
          "properties": {
            "session": { "const": 5 },
            "config": {
              "properties": { "path": { "const": "passes/base-first/5/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/base-first/5/results.json" } }
            }
          }
        },
        {
          "$ref": "#/$defs/head_first_pass",
          "properties": {
            "session": { "const": 5 },
            "config": {
              "properties": { "path": { "const": "passes/head-first/5/config.json" } }
            },
            "results": {
              "properties": { "path": { "const": "passes/head-first/5/results.json" } }
            }
          }
        }
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$(?![\\s\\S])"
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])" },
    "context": {
      "type": "object",
      "required": [
        "comparison_mode",
        "repository",
        "pr_head_repository",
        "workflow_repository",
        "pr_number",
        "base_sha",
        "head_sha",
        "main_sha",
        "pr_head_sha",
        "merge_candidate_sha",
        "run_url"
      ],
      "properties": {
        "comparison_mode": { "const": "main-merge-candidate" },
        "repository": { "$ref": "#/$defs/repository" },
        "pr_head_repository": { "$ref": "#/$defs/repository" },
        "workflow_repository": { "$ref": "#/$defs/repository" },
        "pr_number": { "type": "integer", "minimum": 1 },
        "base_sha": { "$ref": "#/$defs/sha" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "main_sha": { "$ref": "#/$defs/sha" },
        "pr_head_sha": { "$ref": "#/$defs/sha" },
        "merge_candidate_sha": { "$ref": "#/$defs/sha" },
        "run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "binary": {
      "type": "object",
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } },
      "additionalProperties": false
    },
    "artifact_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "required": ["name", "session", "server_order", "config", "results"],
      "properties": {
        "name": { "enum": ["base-first", "head-first"] },
        "session": {
          "description": "Independent session identity within the named order stratum",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "server_order": {
          "type": "array",
          "items": { "enum": ["base", "head"] },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "config": { "$ref": "#/$defs/artifact_file" },
        "results": { "$ref": "#/$defs/artifact_file" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "name": { "const": "base-first" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "server_order": { "const": ["base", "head"] },
              "config": {
                "$ref": "#/$defs/artifact_file",
                "properties": {
                  "path": { "pattern": "^passes/base-first/[1-5]/config\\.json$" }
                }
              },
              "results": {
                "$ref": "#/$defs/artifact_file",
                "properties": {
                  "path": { "pattern": "^passes/base-first/[1-5]/results\\.json$" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "name": { "const": "head-first" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "server_order": { "const": ["head", "base"] },
              "config": {
                "$ref": "#/$defs/artifact_file",
                "properties": {
                  "path": { "pattern": "^passes/head-first/[1-5]/config\\.json$" }
                }
              },
              "results": {
                "$ref": "#/$defs/artifact_file",
                "properties": {
                  "path": { "pattern": "^passes/head-first/[1-5]/results\\.json$" }
                }
              }
            }
          }
        }
      ]
    },
    "base_first_pass": {
      "$ref": "#/$defs/pass",
      "properties": {
        "name": { "const": "base-first" },
        "server_order": { "const": ["base", "head"] }
      }
    },
    "head_first_pass": {
      "$ref": "#/$defs/pass",
      "properties": {
        "name": { "const": "head-first" },
        "server_order": { "const": ["head", "base"] }
      }
    }
  }
}
