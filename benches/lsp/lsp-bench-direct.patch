 struct DiagnosticsInfo {
     message: Value,
+}
+
+fn is_fixture_ready_diagnostics(message: &Value, expected_uri: &str) -> bool {
+    message.get("method").and_then(Value::as_str) == Some("textDocument/publishDiagnostics")
+        && message.pointer("/params/uri").and_then(Value::as_str) == Some(expected_uri)
+        && message
+            .pointer("/params/diagnostics")
+            .and_then(Value::as_array)
+            .is_some_and(|diagnostics| {
+                diagnostics.iter().any(|diagnostic| {
+                    diagnostic.get("code").is_some_and(|code| {
+                        code.as_str() == Some("2018") || code.as_i64() == Some(2018)
+                    }) && diagnostic.get("severity").and_then(Value::as_u64) == Some(2)
+                        && diagnostic.get("message").and_then(Value::as_str)
+                            == Some("function state mutability can be restricted to view")
+                })
+            })
+}
+
+fn is_valid_initialize_response(response: &Value) -> bool {
+    response
+        .pointer("/result/capabilities")
+        .and_then(Value::as_object)
+        .is_some()
+}
+
+#[cfg(test)]
+mod direct_adapter_tests {
+    use super::*;
+
+    fn diagnostics(uri: &str, code: Value) -> Value {
+        json!({
+            "jsonrpc": "2.0",
+            "method": "textDocument/publishDiagnostics",
+            "params": {
+                "uri": uri,
+                "diagnostics": [{
+                    "code": code,
+                    "severity": 2,
+                    "message": "function state mutability can be restricted to view"
+                }]
+            }
+        })
+    }
+
+    #[test]
+    fn matches_only_the_fixture_ready_diagnostic() {
+        let uri = "file:///fixture/Main.sol";
+        assert!(is_fixture_ready_diagnostics(
+            &diagnostics(uri, json!("2018")),
+            uri
+        ));
+        assert!(is_fixture_ready_diagnostics(
+            &diagnostics(uri, json!(2018)),
+            uri
+        ));
+        assert!(!is_fixture_ready_diagnostics(
+            &diagnostics("file:///other/Main.sol", json!(2018)),
+            uri
+        ));
+        assert!(!is_fixture_ready_diagnostics(
+            &diagnostics(uri, json!(2019)),
+            uri
+        ));
+    }
+
+    #[test]
+    fn initialize_requires_capabilities() {
+        assert!(is_valid_initialize_response(
+            &json!({"jsonrpc": "2.0", "id": 1, "result": {"capabilities": {}}})
+        ));
+        assert!(!is_valid_initialize_response(
+            &json!({"jsonrpc": "2.0", "id": 1, "result": {}})
+        ));
+        assert!(!is_valid_initialize_response(
+            &json!({"jsonrpc": "2.0", "id": 1, "error": {"code": -1, "message": "no"}})
+        ));
+    }
 }
 
