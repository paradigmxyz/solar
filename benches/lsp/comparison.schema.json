{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/paradigmxyz/solar/main/benches/lsp/comparison.schema.json",
  "title": "Solar LSP benchmark trusted comparison",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "comparison_mode",
    "repository",
    "pr_head_repository",
    "workflow_repository",
    "pr_number",
    "base_sha",
    "head_sha",
    "main_sha",
    "pr_head_sha",
    "merge_candidate_sha",
    "run_url",
    "threshold_percent",
    "threshold_absolute_ms",
    "confidence_level",
    "overall",
    "methods"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "kind": { "const": "solar-lsp-benchmark-comparison" },
    "comparison_mode": { "const": "main-merge-candidate" },
    "repository": { "$ref": "#/$defs/repository" },
    "pr_head_repository": { "$ref": "#/$defs/repository" },
    "workflow_repository": { "$ref": "#/$defs/repository" },
    "pr_number": { "type": "integer", "minimum": 1 },
    "base_sha": { "$ref": "#/$defs/sha" },
    "head_sha": { "$ref": "#/$defs/sha" },
    "main_sha": { "$ref": "#/$defs/sha" },
    "pr_head_sha": { "$ref": "#/$defs/sha" },
    "merge_candidate_sha": { "$ref": "#/$defs/sha" },
    "run_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$(?![\\s\\S])"
    },
    "threshold_percent": { "const": 10.0 },
    "threshold_absolute_ms": { "const": 1.0 },
    "confidence_level": { "const": 0.95 },
    "freshness": {
      "enum": ["current", "main-advanced", "superseded"]
    },
    "current_main_sha": { "$ref": "#/$defs/sha" },
    "current_pr_head_sha": { "$ref": "#/$defs/sha" },
    "overall": {
      "enum": ["regression", "improvement", "stable", "inconclusive"]
    },
    "methods": { "type": "array" },
    "error": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["error"],
      "properties": {
        "overall": { "const": "inconclusive" },
        "methods": { "const": [] }
      }
    },
    {
      "not": { "required": ["error"] },
      "required": ["freshness", "current_main_sha", "current_pr_head_sha"],
      "properties": {
        "overall": { "enum": ["regression", "improvement", "stable"] },
        "methods": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/initialize" },
            { "$ref": "#/$defs/diagnostic" },
            { "$ref": "#/$defs/hover" },
            { "$ref": "#/$defs/definition" },
            { "$ref": "#/$defs/references" },
            { "$ref": "#/$defs/completion" },
            { "$ref": "#/$defs/document_symbol" }
          ],
          "minItems": 7,
          "maxItems": 7
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$(?![\\s\\S])"
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])" },
    "metric": {
      "type": "object",
      "required": ["p50_ms", "p95_ms"],
      "properties": {
        "p50_ms": { "type": "number", "minimum": 0.0001 },
        "p95_ms": { "type": "number", "minimum": 0.0001 }
      },
      "additionalProperties": false
    },
    "delta": {
      "type": "object",
      "required": ["p50", "p95"],
      "properties": {
        "p50": { "type": "number" },
        "p95": { "type": "number" }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      },
      "additionalProperties": false
    },
    "delta_interval": {
      "type": "object",
      "required": ["p50", "p95"],
      "properties": {
        "p50": { "$ref": "#/$defs/interval" },
        "p95": { "$ref": "#/$defs/interval" }
      },
      "additionalProperties": false
    },
    "confidence_interval": {
      "type": "object",
      "required": ["delta_ms", "delta_percent"],
      "properties": {
        "delta_ms": { "$ref": "#/$defs/delta_interval" },
        "delta_percent": { "$ref": "#/$defs/delta_interval" }
      },
      "additionalProperties": false
    },
    "stratum": {
      "type": "object",
      "required": [
        "order",
        "sample_count",
        "session_count",
        "base",
        "head",
        "delta_ms",
        "delta_percent",
        "confidence_interval_95"
      ],
      "properties": {
        "order": { "enum": ["base-first", "head-first"] },
        "sample_count": {
          "description": "Measured request samples per role; these are not independent sessions",
          "const": 50
        },
        "session_count": {
          "description": "Independent paired sessions in this server-order stratum",
          "const": 5
        },
        "base": {
          "description": "Means of the five base per-session nearest-rank percentiles",
          "$ref": "#/$defs/metric"
        },
        "head": {
          "description": "Means of the five head per-session nearest-rank percentiles",
          "$ref": "#/$defs/metric"
        },
        "delta_ms": { "$ref": "#/$defs/delta" },
        "delta_percent": { "$ref": "#/$defs/delta" },
        "confidence_interval_95": {
          "description": "Exact paired-bootstrap intervals over the five session pairs",
          "$ref": "#/$defs/confidence_interval"
        }
      },
      "additionalProperties": false
    },
    "base_first_stratum": {
      "$ref": "#/$defs/stratum",
      "properties": { "order": { "const": "base-first" } }
    },
    "head_first_stratum": {
      "$ref": "#/$defs/stratum",
      "properties": { "order": { "const": "head-first" } }
    },
    "method": {
      "type": "object",
      "required": [
        "name",
        "sample_count",
        "session_count",
        "base",
        "head",
        "delta_ms",
        "delta_percent",
        "strata",
        "verdict"
      ],
      "properties": {
        "name": { "type": "string" },
        "sample_count": {
          "description": "Measured request samples per role; these are not independent sessions",
          "const": 100
        },
        "session_count": {
          "description": "Independent paired sessions across both balanced order strata",
          "const": 10
        },
        "base": {
          "description": "Means of the ten base per-session nearest-rank percentiles",
          "$ref": "#/$defs/metric"
        },
        "head": {
          "description": "Means of the ten head per-session nearest-rank percentiles",
          "$ref": "#/$defs/metric"
        },
        "delta_ms": { "$ref": "#/$defs/delta" },
        "delta_percent": { "$ref": "#/$defs/delta" },
        "strata": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/base_first_stratum" },
            { "$ref": "#/$defs/head_first_stratum" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "verdict": { "enum": ["regression", "improvement", "stable"] }
      },
      "additionalProperties": false
    },
    "initialize": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "initialize" } }
    },
    "diagnostic": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "didOpen/publishDiagnostics" } }
    },
    "hover": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "textDocument/hover" } }
    },
    "definition": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "textDocument/definition" } }
    },
    "references": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "textDocument/references" } }
    },
    "completion": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "textDocument/completion" } }
    },
    "document_symbol": {
      "$ref": "#/$defs/method",
      "properties": { "name": { "const": "textDocument/documentSymbol" } }
    }
  }
}
