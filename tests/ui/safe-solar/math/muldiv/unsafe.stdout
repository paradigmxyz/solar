// === ROOT/tests/ui/safe-solar/math/muldiv/unsafe.sol:Unsafe ===
@module Unsafe
@phase lowered
fn @quotient() [selector=0x211bc189, abi_wrapper, inline_assembly, pure] {
  bb0:
    v2 = calldatasize
    v3 = lt v2, 100
    jumpi v3, bb1, bb2
  bb2:
    v0 = mul arg0, arg1
    v1 = div v0, arg2
    mstore 0, v1 !metadata(memory=scratch)
    returndata 0, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb3, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb3, [0x211bc189 => bb2]
  bb2:
    tail_call @quotient
  bb3:
    revert 0, 0
}
