// === ROOT/tests/ui/safe-solar/math/wrapping/unsafe.sol:Unsafe ===
@module Unsafe
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = calldatasize
    v2 = lt v1, 68
    v3 = or v0, v2
    jumpi v3, bb1, bb2
  bb2:
    v4 = calldataload 0
    v5 = shr 224, v4
    v6 = calldataload 4
    v7 = calldataload 36
    switch v5, default bb1, [0x1d3b9edf => bb3, 0xa95cb7f7 => bb4, 0xcad0899b => bb5]
  bb5:
    v10 = add v6, v7
    mstore 128, v10
    returndata 128, 32
  bb4:
    v9 = sub v6, v7
    mstore 128, v9
    returndata 128, 32
  bb3:
    v8 = mul v6, v7
    mstore 128, v8
    returndata 128, 32
  bb1:
    revert 0, 0
}
