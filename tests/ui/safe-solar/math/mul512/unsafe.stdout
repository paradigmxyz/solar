// === ROOT/tests/ui/safe-solar/math/mul512/unsafe.sol:Unsafe ===
@module Unsafe
@phase lowered
types:
  struct0: {u256, u256}

fn @product() [selector=0xba88c3b7, abi_wrapper, pure] {
  bb0:
    v8 = calldatasize
    v9 = lt v8, 68
    jumpi v9, bb1, bb2
  bb2:
    v1 = mulmod arg0, arg1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v2 = mul arg0, arg1
    v3 = lt v1, v2
    v4 = sub v1, v2
    v5 = sub v4, v3
    mstore 128, v5
    mstore 160, v2
    returndata 128, 64
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb3, [0xba88c3b7 => bb2]
  bb2:
    tail_call @product
  bb3:
    revert 0, 0
}
