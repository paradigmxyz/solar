// Each merge must match the module's checked body on every input, including
// unsorted ones and repeated values, which it merges the same way.
import {WordArrays} from "solar:core/v1/WordArrays.sol";

contract Safe {
    function unionUint(uint256[] memory a, uint256[] memory b)
        public
        pure
        returns (uint256[] memory)
    {
        return WordArrays.union(a, b);
    }

    function intersectionUint(uint256[] memory a, uint256[] memory b)
        public
        pure
        returns (uint256[] memory)
    {
        return WordArrays.intersection(a, b);
    }

    function differenceUint(uint256[] memory a, uint256[] memory b)
        public
        pure
        returns (uint256[] memory)
    {
        return WordArrays.difference(a, b);
    }

    function unionInt(int256[] memory a, int256[] memory b)
        public
        pure
        returns (int256[] memory)
    {
        return WordArrays.union(a, b);
    }

    function intersectionInt(int256[] memory a, int256[] memory b)
        public
        pure
        returns (int256[] memory)
    {
        return WordArrays.intersection(a, b);
    }

    function differenceInt(int256[] memory a, int256[] memory b)
        public
        pure
        returns (int256[] memory)
    {
        return WordArrays.difference(a, b);
    }

    function unionAddress(address[] memory a, address[] memory b)
        public
        pure
        returns (address[] memory)
    {
        return WordArrays.union(a, b);
    }

    function intersectionAddress(address[] memory a, address[] memory b)
        public
        pure
        returns (address[] memory)
    {
        return WordArrays.intersection(a, b);
    }

    function differenceAddress(address[] memory a, address[] memory b)
        public
        pure
        returns (address[] memory)
    {
        return WordArrays.difference(a, b);
    }

    function unionBytes32(bytes32[] memory a, bytes32[] memory b)
        public
        pure
        returns (bytes32[] memory)
    {
        return WordArrays.union(a, b);
    }

    function intersectionBytes32(bytes32[] memory a, bytes32[] memory b)
        public
        pure
        returns (bytes32[] memory)
    {
        return WordArrays.intersection(a, b);
    }

    function differenceBytes32(bytes32[] memory a, bytes32[] memory b)
        public
        pure
        returns (bytes32[] memory)
    {
        return WordArrays.difference(a, b);
    }
}
