// === ROOT/tests/ui/safe-solar/arrays/truncate/unsafe.sol:Unsafe ===
@module Unsafe
@phase evm-shaped
fn @shorten() [selector=0xf0187838, pure] {
  bb0:
    v2 = icall @decode_calldata_type, 1, 4
    mstore v2, arg1
    v7 = iszero v2
    v8 = iszero v7
    v9 = mul arg1, v8
    v10 = add v2, 32
    v11 = shl 5, v9
    v12 = add v10, 32
    mcopy v12, v10, v11
    mstore v2, 32
    mstore v10, v9
    v13 = add v11, 64
    returndata v2, v13
}

fn @viaAlias() [selector=0xcc1cce1f, pure] {
  bb0:
    v3 = icall @decode_calldata_type, 1, 4
    mstore v3, arg1
    mstore 128, arg1
    returndata 128, 32
}

fn @decode_calldata_type(arg0: u256) -> memptr {
  bb0:
    v0 = calldatasize
    v1 = calldataload arg0
    v2 = add v1, 4
    v3 = add v2, 32
    v4 = gt v1, 0xffffffffffffffff
    v5 = gt v3, v0
    v6 = or v4, v5
    jumpi v6, bb1, bb2
  bb2:
    v7 = calldataload v2
    v9 = shl 5, v7
    v11 = shr 5, v9
    v12 = eq v11, v7
    jumpi v12, bb4, bb3
  bb4:
    v15 = add v9, 32
    v16 = lt v15, v9
    jumpi v16, bb3, bb5
  bb5:
    v17 = mload 64 !metadata(memory=scratch, effect=memory_write)
    v25 = add v17, v15
    v26 = lt v25, v17
    v27 = gt v25, 0xffffffffffffffff
    v28 = or v26, v27
    jumpi v28, bb3, bb7
  bb7:
    mstore 64, v25 !metadata(memory=scratch)
    mstore v17, v7
    v18 = sub v0, v3
    v19 = shr 5, v18
    v20 = gt v7, v19
    jumpi v20, bb1, bb6
  bb6:
    v22 = add v17, 32
    calldatacopy v22, v3, v9
    ret v17
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 65 !metadata(memory=scratch)
    revert 0, 36
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = calldatasize
    v2 = lt v1, 68
    v3 = or v0, v2
    jumpi v3, bb1, bb2
  bb2:
    v4 = calldataload 0
    v5 = shr 224, v4
    switch v5, default bb1, [0xcc1cce1f => bb3, 0xf0187838 => bb4]
  bb4:
    tail_call @shorten
  bb3:
    tail_call @viaAlias
  bb1:
    revert 0, 0
}
