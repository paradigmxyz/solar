// === ROOT/tests/ui/safe-solar/bits/clz/safe.sol:Safe ===
@module Safe
@phase lowered
fn @leading() [selector=0x3ce23483, abi_wrapper, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb2:
    v0 = clz arg0
    mstore 0, v0 !metadata(memory=scratch)
    returndata 0, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb3, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb3, [0x3ce23483 => bb2]
  bb2:
    tail_call @leading
  bb3:
    revert 0, 0
}
