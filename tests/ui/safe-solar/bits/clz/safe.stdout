// === <solar:core/v1/Bits.sol>:Bits ===
@module Bits
@phase lowered
@library
fn @entry() [entry] {
  bb0:
    revert 0, 0
}

// === ROOT/tests/ui/safe-solar/bits/clz/safe.sol:Safe ===
@module Safe
@phase lowered
fn @leading() [selector=0x3ce23483, abi_wrapper, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb2:
    v0 = clz arg0
    mstore 128, v0
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb3, [0x3ce23483 => bb2]
  bb2:
    tail_call @leading
  bb3:
    revert 0, 0
}
