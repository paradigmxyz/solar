// === ROOT/tests/ui/safe-solar/cast/narrow/safe.sol:Safe ===
@module Safe
@phase lowered
fn @narrow() [selector=0x0ebb6188, abi_wrapper, pure] {
  bb0:
    v4 = calldatasize
    v5 = lt v4, 36
    jumpi v5, bb3, bb4
  bb4:
    v1 = gt arg0, 0xffffffffff
    jumpi v1, bb1, bb2
  bb2:
    v2 = and arg0, 0xffffffffff
    mstore 128, v2
    returndata 128, 32
  bb1:
    tail_call @_overflow
  bb3:
    revert 0, 0
}

fn @_overflow() [pure] {
  bb0:
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    mstore 32, 17 !metadata(memory=scratch)
    revert 28, 36
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb3, [0xebb6188 => bb2]
  bb2:
    tail_call @narrow
  bb3:
    revert 0, 0
}
