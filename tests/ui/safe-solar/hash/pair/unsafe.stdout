// === ROOT/tests/ui/safe-solar/hash/pair/unsafe.sol:Unsafe ===
@module Unsafe
@phase lowered
fn @pair() [selector=0x9280bddf, abi_wrapper, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 68
    jumpi v2, bb1, bb2
  bb2:
    mstore 0, arg0
    mstore 32, arg1
    v0 = keccak256 0, 64 !metadata(memory=scratch)
    mstore 128, v0
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @mixed() [selector=0x662ae64e, abi_wrapper, pure] {
  bb0:
    v2 = calldatasize
    v3 = lt v2, 68
    jumpi v3, bb1, bb2
  bb2:
    v4 = calldataload 4
    v5 = signextend 0, v4
    v6 = eq v4, v5
    jumpi v6, bb3, bb1
  bb3:
    v7 = calldataload 36
    v8 = shl 32, v7
    v9 = eq v8, 0
    jumpi v9, bb4, bb1
  bb4:
    v0 = signextend 0, arg0
    mstore 0, v0 !metadata(memory=scratch)
    mstore 32, arg1
    v1 = keccak256 0, 64 !metadata(memory=scratch)
    mstore 128, v1
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @single() [selector=0x6bd47c49, abi_wrapper, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb2:
    v3 = calldataload 4
    v4 = lt v3, 2
    jumpi v4, bb3, bb1
  bb3:
    mstore 0, arg0
    v0 = keccak256 0, 32 !metadata(memory=scratch)
    mstore 128, v0
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb5, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb5, [0x662ae64e => bb2, 0x6bd47c49 => bb3, 0x9280bddf => bb4]
  bb4:
    tail_call @pair
  bb3:
