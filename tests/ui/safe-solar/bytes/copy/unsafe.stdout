// === ROOT/tests/ui/safe-solar/bytes/copy/unsafe.sol:Unsafe ===
@module Unsafe
@phase evm-shaped
fn @shift() [selector=0x524ffe38, pure] {
  bb0:
    v4 = calldatasize
    v5 = lt v4, 36
    jumpi v5, bb1, bb2
  bb2:
    v6 = icall @decode_calldata_type, 1, 4
    v0 = add v6, 32
    v1 = mload v6
    v2 = sub v1, 1
    v3 = add v0, 1
    mcopy v3, v0, v2
    v11 = iszero v6
    v12 = iszero v11
    v13 = mul v1, v12
    v15 = add v13, 31
    v17 = and v15, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v18 = add v0, v17
    mstore v18, 0
    v19 = add v0, 32
    mcopy v19, v0, v13
    mstore v6, 32
    mstore v0, v13
    v20 = add v17, 64
    returndata v6, v20
  bb1:
    revert 0, 0
}

fn @between() [selector=0xf75bb619, pure] {
  bb0:
    v2 = calldatasize
    v3 = lt v2, 68
    jumpi v3, bb1, bb2
  bb2:
    v4 = icall @decode_calldata_type, 1, 4
    v5 = icall @decode_calldata_type, 1, 36
    v0 = add v5, 33
    v1 = add v4, 34
    mcopy v1, v0, 5
    v10 = iszero v4
    v11 = iszero v10
    v9 = mload v4
    v12 = mul v9, v11
    v13 = add v4, 32
    v14 = add v12, 31
    v16 = and v14, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v17 = add v13, v16
    mstore v17, 0
    v18 = add v13, 32
    mcopy v18, v13, v12
    mstore v4, 32
    mstore v13, v12
    v19 = add v16, 64
    returndata v4, v19
  bb1:
    revert 0, 0
}

fn @decode_calldata_type(arg0: u256) -> memptr {
  bb0:
    v0 = calldatasize
    v1 = calldataload arg0
    v2 = add v1, 4
    v3 = add v2, 32
    v4 = gt v1, 0xffffffffffffffff
    v5 = gt v3, v0
    v6 = or v4, v5
    jumpi v6, bb1, bb2
  bb2:
    v7 = calldataload v2
    v9 = add v7, 63
    v10 = lt v9, v7
    jumpi v10, bb3, bb4
  bb4:
    v12 = and v9, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v13 = mload 64 !metadata(memory=scratch, effect=memory_write)
    v20 = add v13, v12
    v21 = lt v20, v13
    v22 = gt v20, 0xffffffffffffffff
    v23 = or v21, v22
    jumpi v23, bb3, bb6
  bb6:
    mstore 64, v20 !metadata(memory=scratch)
    mstore v13, v7
    v14 = sub v0, v3
    v15 = gt v7, v14
    jumpi v15, bb1, bb5
  bb5:
    v17 = add v13, 32
    calldatacopy v17, v3, v7
    ret v13
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 65 !metadata(memory=scratch)
    revert 0, 36
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb4, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb4, [0x524ffe38 => bb2, 0xf75bb619 => bb3]
  bb3:
    tail_call @between
  bb2:
    tail_call @shift
  bb4:
    revert 0, 0
}
