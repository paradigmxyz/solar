fn @peek() [selector=0xa230438f, abi_wrapper, inline_assembly, pure] {
  bb0:
    v5 = calldatasize
    v6 = lt v5, 68
    jumpi v6, bb1, bb2
  bb2:
    v7 = calldataload 4
    v8 = add v7, 4
    v9 = add v8, 32
    v10 = gt v7, 0xffffffffffffffff
    v11 = gt v9, v5
    v12 = or v10, v11
    v13 = zext i1 v12 to i256
    v14 = calldataload v8
    v16 = sub v5, v9
    v17 = gt v14, v16
    v18 = zext i1 v17 to i256
    v19 = or v13, v18
    v20 = ne v19, 0
    jumpi v20, bb1, bb3
  bb3:
    v1 = add v9, arg1
    v2 = calldataload v1
    v24 = and v2, 0xffffffff00000000000000000000000000000000000000000000000000000000
    mstore 128, 1
    mstore 160, v24
    returndata 128, 64
  bb1:
