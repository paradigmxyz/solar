+ ; === ROOT/tests/ui/codegen/mir/none/semicolon_comments.mir (after none) ===
  @module Comments
  ; selector 0x12345678
  fn @branch(arg0: i1) -> i256 [selector=0x12345678] {
    bb0:
      v0 = add 2, 1
      jumpi arg0, bb1, bb2
