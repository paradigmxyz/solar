//@compile-flags: -Zmir-pipeline=none
//@filecheck:
@module Identity
// CHECK-LABEL: {{^[ +].*}}fn @add{{[( ]}}
// CHECK: {{^[ +].*}}[[SUM:v[0-9]+]] = add arg0, arg1
// CHECK: {{^[ +].*}}ret [[SUM]]
fn @add(arg0: word, arg1: word) -> word {
  bb0:
    v2 = add arg0, arg1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @double{{[( ]}}
// CHECK: {{^[ +].*}}[[SUM:v[0-9]+]] = add arg0, arg0
// CHECK: {{^[ +].*}}ret [[SUM]]
fn @double(arg0: word) -> word {
  bb0:
    v1 = add arg0, arg0
    ret v1
}
