+ // === ROOT/tests/ui/codegen/mir/none/identity.mir (after none) ===
  @module Identity
  fn @add(arg0: word, arg1: word) -> word {
    bb0:
      v0 = add arg0, arg1
      ret v0
  }
  
  fn @double(arg0: word) -> word {
    bb0:
      v0 = add arg0, arg0
      ret v0
  }
  
