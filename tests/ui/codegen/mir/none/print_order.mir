//@compile-flags: -Zmir-pipeline=none
//@filecheck:

// The constructor, `receive` and `fallback` print first, in that order. The other functions keep
// their order.
@module PrintOrder

// CHECK-LABEL: fn @constructor
// CHECK-LABEL: fn @receive
// CHECK-LABEL: fn @fallback
// CHECK-LABEL: fn @helper_a
// CHECK-LABEL: fn @helper_b

fn @helper_a() {
  bb0:
    stop
}

fn @fallback() [fallback] {
  bb0:
    stop
}

fn @helper_b() {
  bb0:
    stop
}

fn @receive() [receive] {
  bb0:
    stop
}

fn @constructor() [constructor] {
  bb0:
    stop
}
