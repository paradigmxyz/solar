//@compile-flags: -Zmir-pipeline=none
//@filecheck: --enable-var-scope
@module CanonicalOperands
@types
  struct0: {i256, i256, i256}
  struct1: {i256, i256, i256, i256}
  struct2: {i1, i1, i1, i1}

// The text parser puts every instruction in canonical operand order, as the builder does, so a
// test that writes the other order still compiles the canonical instruction.

// CHECK-LABEL: @constant_operand_order
// CHECK: {{v[0-9]+}} = add arg0, 7
// CHECK: {{v[0-9]+}} = mul arg1, 11
// CHECK: {{v[0-9]+}} = or arg2, 13
// CHECK: {{v[0-9]+}} = xor arg3, 17
fn @constant_operand_order(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> struct1 [return_abi=[i256, i256, i256, i256]] {
  bb0:
    v4 = add 7, arg0
    v5 = mul 11, arg1
    v6 = or 13, arg2
    v7 = xor 17, arg3
    ret v4, v5, v6, v7
}

// CHECK-LABEL: @constant_comparison_order
// CHECK: {{v[0-9]+}} = gt arg0, 13
// CHECK: {{v[0-9]+}} = lt arg1, 13
// CHECK: {{v[0-9]+}} = sgt arg2, 13
// CHECK: {{v[0-9]+}} = slt arg3, 13
fn @constant_comparison_order(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> struct2 [return_abi=[i1, i1, i1, i1]] {
  bb0:
    v4 = lt 13, arg0
    v5 = gt 13, arg1
    v6 = slt 13, arg2
    v7 = sgt 13, arg3
    ret v4, v5, v6, v7
}

// A comparison of two values is `lt` or `slt`.
// CHECK-LABEL: @variable_comparison_order
// CHECK: {{v[0-9]+}} = lt arg1, arg0
// CHECK: {{v[0-9]+}} = slt arg3, arg2
// CHECK: {{v[0-9]+}} = lt arg0, arg1
// CHECK: {{v[0-9]+}} = slt arg2, arg3
fn @variable_comparison_order(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> struct2 [return_abi=[i1, i1, i1, i1]] {
  bb0:
    v4 = gt arg0, arg1
    v5 = sgt arg2, arg3
    v6 = lt arg0, arg1
    v7 = slt arg2, arg3
    ret v4, v5, v6, v7
}

// The more complex operand goes first; a load is more complex than an argument.
// CHECK-LABEL: @complexity_order
// CHECK: [[LOAD:v[0-9]+]] = mload arg0
// CHECK: {{v[0-9]+}} = add [[LOAD]], arg1
fn @complexity_order(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = mload arg0
    v1 = add arg1, v0
    ret v1
}

// Two immediates order by value, larger first; the modulus stays in place.
// CHECK-LABEL: @constant_pairs
// CHECK: {{v[0-9]+}} = add 5, 3
// CHECK: {{v[0-9]+}} = mulmod 5, 0, arg0
// CHECK: {{v[0-9]+}} = addmod arg0, 9, arg1
fn @constant_pairs(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256, i256]] {
  bb0:
    v2 = add 3, 5
    v3 = mulmod 0, 5, arg0
    v4 = addmod 9, arg0, arg1
    ret v2, v3, v4
}
