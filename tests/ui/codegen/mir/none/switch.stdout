- ; === ROOT/tests/ui/codegen/mir/none/switch.mir (before none) ===
+ ; === ROOT/tests/ui/codegen/mir/none/switch.mir (after none) ===
  @module SwitchTest
  fn @dispatch(arg0: i256) -> i256 {
    bb0:
      switch arg0, default bb4, [1 => bb1, 2 => bb2, 3 => bb3]
    bb3:                                            ; preds = bb0
      ret 1
    bb2:                                            ; preds = bb0
      ret 0
    bb1:                                            ; preds = bb0
      ret arg0
    bb4:                                            ; preds = bb0
      ret 2
  }
  
