  @module Display
  fn @linear(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 1
      ret v0
  }
  
  fn @diamond(arg0: i256, arg1: i1) -> i256 {
    bb0:
      jumpi arg1, bb1, bb2
    bb2:
      ret arg0
    bb1:
      ret arg0
  }
  
  fn @storage_ops(arg0: i256, arg1: i256) -> i256 {
    bb0:
      sstore arg0, arg1 !metadata(storage=symbolic(arg0))
      v0 = sload arg0 !metadata(storage=symbolic(arg0))
      ret v0
  }
  
  fn @over.load.4() -> i256 {
    bb0:
      v0 = icall @over.load.5
      ret v0
  }
  
  fn @over.load.5() -> i256 {
    bb0:
      ret 1
  }
  
  fn @boolean_ops(arg0: i1, arg1: i1) -> i1 {
    bb0:
      v0 = and arg0, arg1
      v1 = or v0, arg1
      v2 = xor v1, arg0
      jumpi v2, bb1, bb2
    bb2:
      ret v0
    bb1:
      ret v1
  }
  
