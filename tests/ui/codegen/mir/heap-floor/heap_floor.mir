//@compile-flags: -Zmir-pipeline=heap-floor
//@filecheck:
@module HeapFloor

// An absolute word stored as the pointer and loaded back is raised to the heap floor.
// CHECK-LABEL: {{^[ +].*}}fn @reset_then_load{{[( ]}}
// CHECK: + [[FLOOR:v[0-9]+]] = heap_floor
// CHECK-NEXT: + [[BELOW:v[0-9]+]] = lt 128, [[FLOOR]]
// CHECK-NEXT: + [[CLAMPED:v[0-9]+]] = select [[BELOW]], [[FLOOR]], 128
// CHECK-NEXT: + mstore 64, [[CLAMPED]]
fn @reset_then_load() -> i256 {
  bb0:
    mstore 64, 128
    v0 = mload 64
    mstore v0, 1
    ret v0
}

// A calldata word hashed in the pointer's slot and restored before anything reads the slot as
// the pointer keeps its value.
// CHECK-LABEL: {{^[ +].*}}fn @scratch_restored{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @scratch_restored() -> i256 {
  bb0:
    v0 = mload 64
    v1 = calldataload 4
    mstore 64, v1
    v2 = keccak256 0, 96
    mstore 64, v0
    ret v2
}

// An error argument written into the slot before a revert keeps its value.
// CHECK-LABEL: {{^[ +].*}}fn @revert_argument{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @revert_argument() {
  bb0:
    v0 = calldataload 36
    mstore 64, v0
    revert 28, 68
}

// A pointer derived from the slot's own value is a heap pointer and stays as stored.
// CHECK-LABEL: {{^[ +].*}}fn @heap_bump{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @heap_bump() -> i256 {
  bb0:
    v0 = mload 64
    v1 = add v0, 32
    mstore 64, v1
    v2 = mload 64
    ret v2
}

// An external function returning only scalar words ends execution there: codegen encodes the
// result in a static buffer without reading the slot.
// CHECK-LABEL: {{^[ +].*}}fn @scalar_return{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @scalar_return() -> i256 [selector=0x12345678] {
  bb0:
    v0 = calldataload 4
    mstore 64, v0
    v1 = keccak256 0, 96
    ret v1
}

fn @allocate() -> i256 {
  bb0:
    v0 = mload 64
    v1 = add v0, 64
    mstore 64, v1
    ret v0
}

// A callee that allocates from the slot reads the stored word as the pointer.
// CHECK-LABEL: {{^[ +].*}}fn @reset_then_call{{[( ]}}
// CHECK: + {{v[0-9]+}} = heap_floor
// CHECK: + mstore 64, {{v[0-9]+}}
// CHECK: icall @allocate
fn @reset_then_call() -> i256 {
  bb0:
    mstore 64, 128
    v0 = icall @allocate
    ret v0
}

fn @hash_scratch(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    v1 = keccak256 0, 96
    ret v1
  bb2:
    v2 = sub arg0, 1
    v3 = icall @hash_scratch, v2
    ret v3
}

// A recursive helper that hashes the slot as data passes the word through its recursive call,
// so the scratch word keeps its value up to the restore.
// CHECK-LABEL: {{^[ +].*}}fn @scratch_through_recursion{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @scratch_through_recursion() -> i256 {
  bb0:
    v0 = mload 64
    v1 = calldataload 4
    mstore 64, v1
    v2 = icall @hash_scratch, 0
    mstore 64, v0
    ret v2
}

// A copy over the whole slot replaces the scratch word, so a later read of the pointer reads the
// copied word, not the stored one.
// CHECK-LABEL: {{^[ +].*}}fn @copy_replaces_scratch{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @copy_replaces_scratch() -> i256 {
  bb0:
    v0 = calldataload 4
    mstore 64, v0
    v1 = keccak256 0, 96
    calldatacopy 64, 36, 32
    v2 = mload 64
    mstore v2, v1
    ret v1
}

// A word loaded from the slot and only stored elsewhere is data, so the calldata word stays.
// CHECK-LABEL: {{^[ +].*}}fn @scratch_read_as_data{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @scratch_read_as_data() -> i256 {
  bb0:
    v0 = mload 64
    v1 = calldataload 4
    mstore 64, v1
    v2 = mload 64
    mstore 0, v2
    v3 = keccak256 0, 32
    mstore 64, v0
    ret v3
}

// A word read as data before a call allocates from it keeps its value for the data read, and the
// slot is clamped right before the call.
// CHECK-LABEL: {{^[ +].*}}fn @data_then_allocate{{[( ]}}
// CHECK: [[READ:v[0-9]+]] = mload 64
// CHECK-NEXT: mstore 0, [[READ]]
// CHECK-NEXT: + [[SLOT:v[0-9]+]] = mload 64
// CHECK-NEXT: + [[FLOOR:v[0-9]+]] = heap_floor
// CHECK-NEXT: + [[BELOW:v[0-9]+]] = lt [[SLOT]], [[FLOOR]]
// CHECK-NEXT: + [[CLAMPED:v[0-9]+]] = select [[BELOW]], [[FLOOR]], [[SLOT]]
// CHECK-NEXT: + mstore 64, [[CLAMPED]]
// CHECK-NEXT: icall @allocate
fn @data_then_allocate() -> i256 {
  bb0:
    v0 = calldataload 4
    mstore 64, v0
    v1 = mload 64
    mstore 0, v1
    v2 = icall @allocate
    ret v2
}

// A load that takes the word as the pointer after a read of it as data reads the clamped word,
// while the slot keeps the stored one.
// CHECK-LABEL: {{^[ +].*}}fn @data_then_pointer_load{{[( ]}}
// CHECK: mstore 0, {{v[0-9]+}}
// CHECK-NEXT: [[POINTER:v[0-9]+]] = mload 64
// CHECK-NEXT: - mstore [[POINTER]], 1
// CHECK-NEXT: - {{v[0-9]+}} = add [[POINTER]], 32
// CHECK-NEXT: + [[FLOOR:v[0-9]+]] = heap_floor
// CHECK-NEXT: + [[BELOW:v[0-9]+]] = lt [[POINTER]], [[FLOOR]]
// CHECK-NEXT: + [[CLAMPED:v[0-9]+]] = select [[BELOW]], [[FLOOR]], [[POINTER]]
// CHECK-NEXT: + mstore [[CLAMPED]], 1
// CHECK-NEXT: + {{v[0-9]+}} = add [[CLAMPED]], 32
fn @data_then_pointer_load() {
  bb0:
    v0 = calldataload 4
    mstore 64, v0
    v1 = mload 64
    mstore 0, v1
    v2 = mload 64
    mstore v2, 1
    v3 = add v2, 32
    mstore 64, v3
    ret
}

fn @transfer_scratch(arg0: i256) {
  bb0:
    v0 = mload 64
    mstore 36, arg0
    mstore 68, arg0
    v1 = gas
    v2 = call v1, arg0, 0, 0, 100, 0, 0
    mstore 64, v0
    ret
}

// Stores that together overwrite every byte of the slot replace the word, as a token transfer
// that lays its call data out over the slot does, so the call does not read the word as data and
// the word is clamped where it is stored.
// CHECK-LABEL: {{^[ +].*}}fn @transfer_scratch{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK-LABEL: {{^[ +].*}}fn @reset_then_transfer{{[( ]}}
// CHECK: + [[FLOOR:v[0-9]+]] = heap_floor
// CHECK-NEXT: + [[BELOW:v[0-9]+]] = lt [[WORD:v[0-9]+]], [[FLOOR]]
// CHECK-NEXT: + [[CLAMPED:v[0-9]+]] = select [[BELOW]], [[FLOOR]], [[WORD]]
// CHECK-NEXT: + mstore 64, [[CLAMPED]]
// CHECK-NEXT: icall @transfer_scratch
fn @reset_then_transfer() -> i256 {
  bb0:
    v0 = calldataload 4
    mstore 64, v0
    icall @transfer_scratch, 1
    v1 = icall @allocate
    ret v1
}

fn @put_scratch() {
  bb0:
    v0 = calldataload 4
    mstore 64, v0
    ret
}

// A helper's scratch word keeps its value for a caller that hashes it, and a caller that
// allocates from it clamps the slot after the call.
// CHECK-LABEL: {{^[ +].*}}fn @put_scratch{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK-LABEL: {{^[ +].*}}fn @hash_helper_scratch{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @hash_helper_scratch() -> i256 {
  bb0:
    v0 = mload 64
    icall @put_scratch
    v1 = keccak256 0, 96
    mstore 64, v0
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @allocate_after_helper{{[( ]}}
// CHECK: icall @put_scratch
// CHECK-NEXT: + [[SLOT:v[0-9]+]] = mload 64
// CHECK-NEXT: + [[FLOOR:v[0-9]+]] = heap_floor
// CHECK-NEXT: + [[BELOW:v[0-9]+]] = lt [[SLOT]], [[FLOOR]]
// CHECK-NEXT: + [[CLAMPED:v[0-9]+]] = select [[BELOW]], [[FLOOR]], [[SLOT]]
// CHECK-NEXT: + mstore 64, [[CLAMPED]]
// CHECK-NEXT: icall @allocate
fn @allocate_after_helper() -> i256 {
  bb0:
    icall @put_scratch
    v0 = icall @allocate
    ret v0
}

fn @read_word() -> i256 {
  bb0:
    v0 = mload 64
    v1 = calldataload 4
    mstore 64, v1
    v2 = mload 64
    mstore 64, v0
    ret v2
}

// A word a helper loads and returns to an external function that returns it is data, as in an
// assembly function that reads its scratch word back.
// CHECK-LABEL: {{^[ +].*}}fn @read_word{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK-LABEL: {{^[ +].*}}fn @read_in_helper{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @read_in_helper() -> i256 [selector=0x12345679] {
  bb0:
    v0 = icall @read_word
    ret v0
}
