//@ compile-flags: -Zmir-pipeline=lower-abi-encode
//@ filecheck:
@module CalldataCopyEscape

// The function stores the copy's address in storage, so the copy escapes. It never returns to
// an internal caller, so the escape check decides. The copy keeps its length and bytes.
// CHECK-LABEL: (after lower-abi-encode)
// CHECK: fn @escape
// CHECK: {{^ }}[[OBJ:v[0-9]+]] = alloc
// CHECK-NEXT: {{^ }}mstore [[OBJ]],
// CHECK: {{^ }}calldatacopy
fn @escape(arg0: slice<calldata>) {
  bb0:
    jump bb2
  bb1:
    v10 = ptrtoint ptr<memory> v0 to i256
    sstore 0, v10
    returndata v7, v8
  bb2:
    v1 = extract_value slice<calldata>, arg0, 1
    v2 = add v1, 32
    v0 = alloc v2
    mstore v0, v1
    v4 = ptradd v0, 32
    v5 = extract_value slice<calldata>, arg0, 0
    calldatacopy v4, v5, v1
    v6 = abi_encode [memory_bytes], scratch, args v0
    v7 = extract_value slice<memory>, v6, 0
    v8 = extract_value slice<memory>, v6, 1
    jump bb1
}
