//@ compile-flags: -Zmir-pipeline=lower-abi-encode,egraph,dce,defer-alloc
//@ filecheck:
@module ReservationAddress

// The size becomes constant only after encoding through the heap frontier.
// Reserving that memory must not relocate it away from the preceding stores.
// CHECK-LABEL: (after defer-alloc)
// CHECK: fn @encode_empty
// CHECK: store {{v[0-9]+}}, 32
// CHECK: store {{v[0-9]+}}, 0
// CHECK: = alloc 64 !metadata(preserves_fmp){{$}}
// CHECK-NOT: deferred_alloc
// CHECK: returndata
fn @encode_empty() [selector=0x01020304, pure] {
  bb0:
    v0 = make_calldata_slice ptr<calldata> 0, 0
    v1 = abi_encode [calldata_bytes], args v0
    v2 = extract_value slice<memory>, v1, 0
    v3 = extract_value slice<memory>, v1, 1
    returndata v2, v3
}
