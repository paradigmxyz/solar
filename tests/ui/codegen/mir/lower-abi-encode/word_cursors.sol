contract WordCursors {
    function reencode(uint8[] memory values, uint256 dirty) external pure returns (bytes memory) {
        assembly {
            for { let i := 0 } lt(i, mload(values)) { i := add(i, 1) } {
                mstore(add(add(values, 32), mul(i, 32)), add(dirty, i))
            }
        }
        return abi.encode(values);
    }

    function encode(uint256 length, uint256 dirty) external pure returns (bytes memory) {
        require(length <= 64);
        uint8[] memory values = new uint8[](length);
        assembly {
            let ptr := add(values, 32)
            for { let i := 0 } lt(i, length) { i := add(i, 1) } {
                mstore(add(ptr, mul(i, 32)), add(dirty, i))
            }
        }
        return abi.encode(values);
    }

    enum Mode { Off, On }

    function enums(uint256 first, uint256 second) external pure returns (bytes memory) {
        Mode[] memory values = new Mode[](2);
        assembly {
            mstore(add(values, 32), first)
            mstore(add(values, 64), second)
        }
        return abi.encode(values);
    }

    function grownSmall() external pure returns (bytes memory) {
        uint16[] memory values = new uint16[](1);
        // Allocation size only guides profitability. Encoding must still use
        // the current length when assembly expands the object and heap frontier.
        assembly {
            mstore(values, 2)
            mstore(add(values, 32), 0x10001)
            mstore(add(values, 64), 0x10002)
            mstore(0x40, add(values, 96))
        }
        return abi.encode(values);
    }

    function defaultArray() external pure returns (bytes memory) {
        uint8[] memory values;
        return abi.encode(values);
    }
}
