//@ compile-flags: -Zmir-pipeline=lower-abi-encode
//@ filecheck:
@module CalldataCopyEnlarged

// An earlier object's length grows past its allocation, so encoding it reads
// the copy above it. The copy keeps its length and bytes for that read.
// CHECK-LABEL: (after lower-abi-encode)
// CHECK: fn @enlarged
// CHECK: {{^ }}[[OBJ:v[0-9]+]] = alloc v
// CHECK-NEXT: {{^ }}mstore [[OBJ]],
// CHECK: {{^ }}calldatacopy
fn @enlarged(arg0: slice<calldata>) {
  bb0:
    v0 = alloc 64
    mstore v0, 1000
    v1 = extract_value slice<calldata>, arg0, 1
    v2 = add v1, 32
    v3 = alloc v2
    mstore v3, v1
    v4 = ptradd v3, 32
    v5 = extract_value slice<calldata>, arg0, 0
    calldatacopy v4, v5, v1
    v6 = abi_encode [memory_bytes], object, args v3
    v7 = abi_encode [memory_bytes, memory_bytes], scratch, args v6, v0
    v8 = extract_value slice<memory>, v7, 0
    v9 = extract_value slice<memory>, v7, 1
    returndata v8, v9
}
