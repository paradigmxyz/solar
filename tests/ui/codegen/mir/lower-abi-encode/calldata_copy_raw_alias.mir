//@ compile-flags: -Zmir-pipeline=lower-abi-encode
//@ filecheck:
@module CalldataCopyRawAlias

// The encoding that reads the copy also reads a raw pointer, which may be the
// copy's address. The copy keeps its length and bytes for that read.
// CHECK-LABEL: (after lower-abi-encode)
// CHECK: fn @raw
// CHECK: {{^ }}[[OBJ:v[0-9]+]] = alloc v
// CHECK-NEXT: {{^ }}mstore [[OBJ]],
// CHECK: {{^ }}calldatacopy
fn @raw(arg0: slice<calldata>, arg1: i256) {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 1
    v1 = add v0, 32
    v2 = alloc v1
    mstore v2, v0
    v3 = ptradd v2, 32
    v4 = extract_value slice<calldata>, arg0, 0
    calldatacopy v3, v4, v0
    v5 = inttoptr i256 arg1 to ptr<memory>
    v6 = abi_encode [memory_bytes, memory_bytes], scratch, args v2, v5
    v7 = extract_value slice<memory>, v6, 0
    v8 = extract_value slice<memory>, v6, 1
    returndata v7, v8
}
