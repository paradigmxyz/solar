//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=lower-abi-encode
//@[gas] filecheck: --check-prefix=GAS
//@[size] compile-flags: -Osize -Zmir-pipeline=lower-abi-encode
//@[size] filecheck: --check-prefix=SIZE
@module BytePadding

// GAS-LABEL: {{^[ +].*}}fn @encode
// GAS: + [[LEN:v[0-9]+]] = extract_value slice<calldata>, arg0, 1
// GAS: + [[PAD:v[0-9]+]] = and
// GAS: + [[LAST:v[0-9]+]] = add {{v[0-9]+}}, [[PAD]]
// GAS-NEXT: + store [[LAST]], 0
// GAS-NEXT: + store {{v[0-9]+}}, [[LEN]]
// GAS-NOT: jumpi
// GAS: + copy calldata
// Size mode keeps the guarded store, which can share machine-level encoder tails.
// SIZE-LABEL: {{^[ +].*}}fn @encode
// SIZE: + [[LEN:v[0-9]+]] = extract_value slice<calldata>, arg0, 1
// SIZE-NEXT: + store [[DEST:v[0-9]+]], [[LEN]]
// SIZE: + [[PAD:v[0-9]+]] = and
// SIZE: + {{v[0-9]+}} = eq {{v[0-9]+}}, 0
// SIZE-NEXT: + jumpi
// SIZE: + [[LAST:v[0-9]+]] = add [[DEST]], [[PAD]]
// SIZE-NEXT: + store [[LAST]], 0
// SIZE: + copy calldata
fn @encode(arg0: slice<calldata>) -> slice<memory> {
  bb0:
    v0 = abi_encode [calldata_bytes], args arg0
    ret v0
}
