//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=lower-abi-encode
//@[gas] filecheck: --check-prefix=CHECK
//@[size] compile-flags: -Osize -Zmir-pipeline=lower-abi-encode
//@[size] filecheck: --check-prefix=CHECK
@module BytePadding

// Both objectives zero the last padded word before writing the length header.
// CHECK-LABEL: {{^[ +].*}}fn @encode
// CHECK: + [[LEN:v[0-9]+]] = extract_value slice<calldata>, arg0, 1
// CHECK: + [[PAD:v[0-9]+]] = and
// CHECK: + [[LAST:v[0-9]+]] = add {{v[0-9]+}}, [[PAD]]
// CHECK-NEXT: + mstore [[LAST]], 0
// CHECK-NEXT: + mstore {{v[0-9]+}}, [[LEN]]
// CHECK-NOT: jumpi
// CHECK: + calldatacopy
fn @encode(arg0: slice<calldata>) -> slice<memory> {
  bb0:
    v0 = abi_encode [calldata_bytes], args arg0
    ret v0
}
