//@ compile-flags: -O gas -Zmir-pipeline=lower-abi-encode
//@ filecheck:
@module TerminalArrayReturn

// A terminal ABI encoder may reuse a fresh full-word array. The payload moves
// forward once, then the old length and data words become the tuple header.
// A fresh object is never null, so its length needs no null guard.
// CHECK-LABEL: {{^[ +].*}}fn @fresh_array{{[( ]}}
fn @fresh_array() -> ptr<memory> {
  bb0:
    v0 = alloc 96
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 2
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @terminal{{[( ]}}
// CHECK: - {{v[0-9]+}} = abi_encode
// CHECK: + [[LENGTH:v[0-9]+]] = mload [[OBJECT:v[0-9]+]]
// CHECK-NEXT: + [[SOURCE:v[0-9]+]] = ptradd [[OBJECT]], 32
// CHECK: + [[BYTES:v[0-9]+]] = shl 5, [[LENGTH]]
// CHECK: + [[DESTINATION:v[0-9]+]] = ptradd [[OBJECT]], 64
// CHECK: + mcopy [[DESTINATION]], [[SOURCE]], [[BYTES]]
// CHECK: + mstore [[OBJECT]], 32
// CHECK: + mstore [[SOURCE]], [[LENGTH]]
// CHECK: + [[TOTAL:v[0-9]+]] = add [[BYTES]], 64
// CHECK: + [[ENCODED:v[0-9]+]] = make_memory_slice [[OBJECT]], [[TOTAL]]
fn @terminal() {
  bb0:
    v0 = icall @fresh_array
    v1 = abi_encode [memory_array<word>], args v0
    v2 = extract_value slice<memory>, v1, 0
    v3 = extract_value slice<memory>, v1, 1
    returndata v2, v3
}

// A caller-visible array cannot be destructively encoded.
// CHECK-LABEL: {{^[ +].*}}fn @borrowed{{[( ]}}
// CHECK: + mcopy
// CHECK: + [[BUFFER_PTR:v[0-9]+]] = alloc
// CHECK-NEXT: + {{v[0-9]+}} = make_memory_slice [[BUFFER_PTR]], {{v[0-9]+}}
fn @borrowed(arg0: ptr<memory>) {
  bb0:
    v0 = abi_encode [memory_array<word>], args arg0
    v1 = extract_value slice<memory>, v0, 0
    v2 = extract_value slice<memory>, v0, 1
    returndata v1, v2
}

fn @fresh_bytes(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = alloc 96
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    ret v0
}

fn @fresh_bytes_wrapper(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = icall @fresh_bytes, arg0
    ret v0
}

// Freshness propagates through the wrapper call. A terminal byte encoding
// clears the padding before moving the payload over its old length word.
// CHECK-LABEL: {{^[ +].*}}fn @terminal_bytes{{[( ]}}
// CHECK: - {{v[0-9]+}} = abi_encode
// CHECK: + [[LENGTH:v[0-9]+]] = mload [[OBJECT:v[0-9]+]]
// CHECK-NEXT: + [[SOURCE:v[0-9]+]] = ptradd [[OBJECT]], 32
// CHECK: + [[SOURCE_WORD:v[0-9]+]] = ptrtoint ptr<memory> [[SOURCE]] to i256
// CHECK-NEXT: + [[LAST:v[0-9]+]] = add [[SOURCE_WORD]],
// CHECK: + mstore [[LAST]], 0
// CHECK: + [[DESTINATION:v[0-9]+]] = ptradd [[OBJECT]], 64
// CHECK: + mcopy [[DESTINATION]], [[SOURCE]], [[LENGTH]]
// CHECK: + mstore [[OBJECT]], 32
fn @terminal_bytes(arg0: i256) {
  bb0:
    v0 = icall @fresh_bytes_wrapper, arg0
    v1 = abi_encode [memory_bytes], args v0
    v2 = extract_value slice<memory>, v1, 0
    v3 = extract_value slice<memory>, v1, 1
    returndata v2, v3
}
