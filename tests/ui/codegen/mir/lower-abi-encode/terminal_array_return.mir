//@ compile-flags: -O gas -Zmir-pipeline=lower-abi-encode
//@ filecheck:
@module TerminalArrayReturn

// A terminal ABI encoder may reuse a fresh full-word array. The payload moves
// forward once, then the old length and data words become the tuple header.
// CHECK-LABEL: {{^[ +].*}}fn @fresh_array{{[( ]}}
fn @fresh_array() -> memoryarray {
  bb0:
    v0 = alloc memoryarray<1>, exact, uninitialized, infallible, 96
    set_memory_object_len memoryarray, v0, 2
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @terminal{{[( ]}}
// CHECK: - {{v[0-9]+}} = abi_encode
// CHECK: + [[LENGTH:v[0-9]+]] = memory_object_len memoryarray, [[OBJECT:v[0-9]+]]
// CHECK: + [[ENCODE_LENGTH:v[0-9]+]] = mul [[LENGTH]], {{v[0-9]+}}
// CHECK: + [[SOURCE_PTR:v[0-9]+]] = memory_object_data memoryarray, [[OBJECT]]
// CHECK: + [[BYTES:v[0-9]+]] = shl 5, [[ENCODE_LENGTH]]
// CHECK: + [[SOURCE:v[0-9]+]] = ptrtoint memptr [[SOURCE_PTR]] to i256
// CHECK: + [[DESTINATION:v[0-9]+]] = add [[SOURCE]], 32
// CHECK: + [[COPY_SOURCE:v[0-9]+]] = ptrtoint memptr [[SOURCE_PTR]] to i256
// CHECK: + mcopy [[DESTINATION]], [[COPY_SOURCE]], [[BYTES]]
// CHECK: + [[POINTER:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} [[OBJECT]]
// CHECK: + mstore [[POINTER]], 32
// CHECK: + [[LENGTH_POINTER:v[0-9]+]] = ptrtoint memptr [[SOURCE_PTR]] to i256
// CHECK: + mstore [[LENGTH_POINTER]], [[ENCODE_LENGTH]]
// CHECK: + [[TOTAL:v[0-9]+]] = add [[BYTES]], 64
// CHECK: + [[SLICE_POINTER:v[0-9]+]] = ptrtoint memoryarray [[OBJECT]] to i256
// CHECK: + [[ENCODED:v[0-9]+]] = make_memory_slice [[SLICE_POINTER]], [[TOTAL]]
fn @terminal() {
  bb0:
    v0 = icall @fresh_array
    v1 = abi_encode [memory_array<word>], args v0
    v2 = slice_ptr v1
    v3 = slice_len v1
    returndata v2, v3
}

// A caller-visible array cannot be destructively encoded.
// CHECK-LABEL: {{^[ +].*}}fn @borrowed{{[( ]}}
// CHECK: + mcopy
// CHECK: + [[BUFFER_PTR:v[0-9]+]] = alloc raw
// CHECK: [[BUFFER:v[0-9]+]] = ptrtoint memptr [[BUFFER_PTR]] to i256
fn @borrowed(arg0: memoryarray) {
  bb0:
    v0 = abi_encode [memory_array<word>], args arg0
    v1 = slice_ptr v0
    v2 = slice_len v0
    returndata v1, v2
}

fn @fresh_bytes(arg0: i256) -> memorybytes {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 96
    set_memory_object_len memorybytes, v0, arg0
    ret v0
}

fn @fresh_bytes_wrapper(arg0: i256) -> memorybytes {
  bb0:
    v0 = icall @fresh_bytes, arg0
    ret v0
}

// Freshness propagates through the wrapper call. A terminal byte encoding
// clears the padding before moving the payload over its old length word.
// CHECK-LABEL: {{^[ +].*}}fn @terminal_bytes{{[( ]}}
// CHECK: - {{v[0-9]+}} = abi_encode
// CHECK: + [[LENGTH:v[0-9]+]] = memory_object_len memorybytes, [[OBJECT:v[0-9]+]]
// CHECK: + [[ENCODE_LENGTH:v[0-9]+]] = mul [[LENGTH]],
// CHECK: + [[SOURCE_PTR:v[0-9]+]] = memory_object_data memorybytes, [[OBJECT]]
// CHECK: [[SOURCE:v[0-9]+]] = ptrtoint memptr [[SOURCE_PTR]] to i256
// CHECK: + [[LAST:v[0-9]+]] = add [[SOURCE]],
// CHECK: + mstore [[LAST]], 0
// CHECK: + [[MOVE_SOURCE:v[0-9]+]] = ptrtoint memptr [[SOURCE_PTR]] to i256
// CHECK: + [[DESTINATION:v[0-9]+]] = add [[MOVE_SOURCE]], 32
// CHECK: + [[COPY_SOURCE:v[0-9]+]] = ptrtoint memptr [[SOURCE_PTR]] to i256
// CHECK: + mcopy [[DESTINATION]], [[COPY_SOURCE]], [[ENCODE_LENGTH]]
// CHECK: + [[POINTER:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} [[OBJECT]]
// CHECK: + mstore [[POINTER]], 32
fn @terminal_bytes(arg0: i256) {
  bb0:
    v0 = icall @fresh_bytes_wrapper, arg0
    v1 = abi_encode [memory_bytes], args v0
    v2 = slice_ptr v1
    v3 = slice_len v1
    returndata v2, v3
}
