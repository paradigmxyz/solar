//@compile-flags: -Zmir-pipeline=lower-abi-encode
//@filecheck:
@module LowerAbiEncode

// CHECK-LABEL: {{^[ +].*}}fn @static{{[( ]}}
// CHECK: + [[STATIC_MEMORY_PTR:v[0-9]+]] = alloc 64
// CHECK: + store [[STATIC_MEMORY_PTR]], 0x1234567800000000000000000000000000000000000000000000000000000000
// CHECK: + store {{v[0-9]+}}, arg0
// CHECK: + {{v[0-9]+}} = make_memory_slice [[STATIC_MEMORY_PTR]], 36
fn @static(arg0: i256) -> slice<memory> {
  bb0:
    v0 = abi_encode [word], selector 0x1234567800000000000000000000000000000000000000000000000000000000, args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @static_bytes{{[( ]}}
// CHECK: + [[OBJECT:v[0-9]+]] = alloc 96 !metadata(preserves_fmp)
// CHECK: + store [[OBJECT]], 64
fn @static_bytes(arg0: i256, arg1: i256) -> ptr<memory> {
  bb0:
    v0 = abi_encode [word, word], object, args arg0, arg1
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @selector_bytes{{[( ]}}
// CHECK: + [[SELECTOR_OBJECT:v[0-9]+]] = alloc 96 !metadata(preserves_fmp)
// CHECK: + store [[SELECTOR_OBJECT]], 36
fn @selector_bytes(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = abi_encode [word], selector 0x1234567800000000000000000000000000000000000000000000000000000000, object, args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @scratch{{[( ]}}
// CHECK: + [[SCRATCH_MEMORY_PTR:v[0-9]+]] = fmp
// CHECK: + store [[SCRATCH_MEMORY_PTR]], arg0
// CHECK-NOT: alloc
// CHECK: + {{v[0-9]+}} = make_memory_slice [[SCRATCH_MEMORY_PTR]], 32
fn @scratch(arg0: i256) -> slice<memory> {
  bb0:
    v0 = abi_encode [word], scratch, args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @dynamic{{[( ]}}
// CHECK: + [[DYNAMIC_MEMORY_PTR:v[0-9]+]] = fmp
// CHECK: + {{v[0-9]+}} = sub
// CHECK: + store [[DYNAMIC_MEMORY_PTR]], {{v[0-9]+}}
// CHECK: + [[LENGTH:v[0-9]+]] = extract_value slice<calldata>, arg0, 1
// CHECK: + copy calldata
// CHECK: + [[ALLOCATED_MEMORY_PTR:v[0-9]+]] = alloc {{v[0-9]+}}
// CHECK: + {{v[0-9]+}} = make_memory_slice [[ALLOCATED_MEMORY_PTR]], {{v[0-9]+}}
fn @dynamic(arg0: slice<calldata>) -> slice<memory> {
  bb0:
    v0 = abi_encode [calldata_bytes], args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @nested_dynamic_array{{[( ]}}
// CHECK: + {{v[0-9]+}} = load arg0
// CHECK: + {{v[0-9]+}} = zext i1
// CHECK: + {{v[0-9]+}} = ptradd arg0, 32
fn @nested_dynamic_array(arg0: ptr<memory>) -> slice<memory> {
  bb0:
    v0 = abi_encode [memory_array<memory_array<word>>], args arg0
    ret v0
}

// A fixed array expands one encoder site per element.
// CHECK-LABEL: {{^[ +].*}}fn @fixed_nested_dynamic_arrays{{[( ]}}
// CHECK: + [[DEST:v[0-9]+]] = inttoptr i256 [[TAIL:v[0-9]+]] to ptr<memory>
// CHECK-NEXT: + [[ENCODED_LEN:v[0-9]+]] = icall @encode_abi_array, {{v[0-9]+}}, [[DEST]]
// CHECK-NEXT: + {{v[0-9]+}} = add [[TAIL]], [[ENCODED_LEN]]
fn @fixed_nested_dynamic_arrays(arg0: ptr<memory>) -> slice<memory> {
  bb0:
    v0 = abi_encode [array<2, memory_array<word<u8>>>], args arg0
    ret v0
}

fn @returndata_bytes() -> slice<memory> {
  bb0:
    v0 = returndatasize
    v1 = make_returndata_slice ptr<returndata> 0, v0
    v2 = abi_encode [returndata_bytes], args v1
    ret v2
}

fn @returndata_words(arg0: i256) -> slice<memory> {
  bb0:
    v0 = make_returndata_slice ptr<returndata> 0, arg0
    v1 = abi_encode [returndata_array<word>], args v0
    ret v1
}
