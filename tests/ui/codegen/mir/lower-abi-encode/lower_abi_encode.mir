//@compile-flags: -Zmir-pipeline=lower-abi-encode
//@filecheck:
@module LowerAbiEncode

// CHECK-LABEL: {{^[ +].*}}fn @static{{[( ]}}
// CHECK: + [[STATIC_MEMORY:v[0-9]+]] = alloc raw, exact, uninitialized, infallible, 64
// CHECK: + mstore [[STATIC_MEMORY]], 0x1234567800000000000000000000000000000000000000000000000000000000
// CHECK: + mstore {{v[0-9]+}}, arg0
// CHECK: + {{v[0-9]+}} = make_memory_slice [[STATIC_MEMORY]], 36
fn @static(arg0: u256) -> memoryslice {
  bb0:
    v0 = abi_encode [word], selector 0x1234567800000000000000000000000000000000000000000000000000000000, args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @scratch{{[( ]}}
// CHECK: + [[SCRATCH_MEMORY:v[0-9]+]] = fmp
// CHECK: + mstore [[SCRATCH_MEMORY]], arg0
// CHECK-NOT: alloc
// CHECK: + {{v[0-9]+}} = make_memory_slice [[SCRATCH_MEMORY]], 32
fn @scratch(arg0: u256) -> memoryslice {
  bb0:
    v0 = abi_encode [word], scratch, args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @dynamic{{[( ]}}
// CHECK: + [[DYNAMIC_MEMORY:v[0-9]+]] = fmp
// CHECK: + mstore [[DYNAMIC_MEMORY]], {{v[0-9]+}}
// CHECK: + [[LENGTH:v[0-9]+]] = slice_len arg0
// CHECK: + calldatacopy
// CHECK: + [[ALLOCATED_MEMORY:v[0-9]+]] = alloc raw, exact, uninitialized, infallible, {{v[0-9]+}}
// CHECK: + {{v[0-9]+}} = make_memory_slice [[ALLOCATED_MEMORY]], {{v[0-9]+}}
fn @dynamic(arg0: calldataslice) -> memoryslice {
  bb0:
    v0 = abi_encode [calldata_bytes], args arg0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @nested_dynamic_array{{[( ]}}
// CHECK: + {{v[0-9]+}} = memory_object_len memoryarray, arg0
// CHECK: + {{v[0-9]+}} = memory_object_data memoryarray, arg0
fn @nested_dynamic_array(arg0: memoryarray) -> memoryslice {
  bb0:
    v0 = abi_encode [memory_array<memory_array<word>>], args arg0
    ret v0
}

// A fixed array expands one encoder site per element.
// CHECK-LABEL: {{^[ +].*}}fn @fixed_nested_dynamic_arrays{{[( ]}}
// CHECK: + {{v[0-9]+}} = icall @encode_abi_array
fn @fixed_nested_dynamic_arrays(arg0: memoryfixedarray) -> memoryslice {
  bb0:
    v0 = abi_encode [array<2, memory_array<word<u8>>>], args arg0
    ret v0
}

fn @returndata_bytes() -> memoryslice {
  bb0:
    v0 = returndatasize
    v1 = make_returndata_slice 0, v0
    v2 = abi_encode [returndata_bytes], args v1
    ret v2
}

fn @returndata_words(arg0: u256) -> memoryslice {
  bb0:
    v0 = make_returndata_slice 0, arg0
    v1 = abi_encode [returndata_array<word>], args v0
    ret v1
}
