  fn @shared(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = mul arg1, arg2
      jumpi arg0, bb1, bb2
    bb2:
      v1 = add v0, arg1
      ret v1
    bb1:
      ret v0
  }
  
  fn @phi_edge(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = mul arg1, arg2
      jumpi arg0, bb1, bb2
    bb2:
      ret arg2
    bb1:
      v1 = phi [bb0: v0]
      ret v1
  }
  
  fn @gas_barrier(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = mul arg1, arg2
      v1 = gas
      jumpi arg0, bb1, bb2
    bb2:
      ret v1
    bb1:
      v2 = add v0, v1
      ret v2
  }
  
  fn @read_barrier(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = mload arg1
      v1 = mul v0, arg2
      jumpi arg0, bb1, bb2
    bb2:
      ret arg2
    bb1:
      ret v1
  }
  
  fn @loop(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = mul arg1, arg2
      jumpi arg0, bb1, bb2
    bb1:
      v1 = phi [bb0: 0], [bb1: v2]
      v2 = add v1, v0
      v3 = lt v2, arg1
      jumpi v3, bb1, bb2
    bb2:
      ret arg2
  }
  
  fn @keep_pressure(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = mul arg1, arg2
      jumpi arg0, bb1, bb2
    bb2:
      ret 0
    bb1:
      ret v0
  }
  
  fn @across_store(arg0: i256) -> i256 {
    bb0:
      v0 = mul arg0, 9
      sstore 0, arg0
      v1 = add v0, 7
      ret v1
  }
  
  fn @keep_gas(arg0: i256) -> i256 {
    bb0:
      v0 = mul arg0, 9
      sstore 0, arg0
      v1 = gas
      v2 = add v0, v1
      ret v2
  }
  
  fn @keep_read(arg0: i256) -> i256 {
    bb0:
      v0 = mload 0
      mstore 0, arg0
      v1 = add v0, 7
      ret v1
  }
  
  fn @sibling_store(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = mul arg1, 9
      jumpi arg0, bb1, bb2
    bb2:
      sstore 0, arg1
      ret 0
    bb1:
      ret v0
  }
  
  fn @reconvergent_store(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = mul arg1, 9
      jumpi arg0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      v1 = add v0, 7
      jump bb3
    bb3:
      v2 = phi [bb1: v1], [bb2: 0]
      sstore 0, arg1
      ret v2
  }
  
  fn @called_branch(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = mul arg1, 9
      jumpi arg0, bb1, bb2
    bb2:
      ret 0
    bb1:
      ret v0
  }
  
  fn @storing_caller(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = icall @called_branch, arg0, arg1
      sstore 0, arg1
      ret v0
  }
  
  fn @tail_branch(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = mul arg1, 9
      jumpi arg0, bb1, bb2
    bb2:
      ret 0
    bb1:
      ret v0
  }
  
  fn @tail_forward(arg0: i1, arg1: i256) -> i256 {
    bb0:
      tail_call @tail_branch, arg0, arg1
  }
  
  fn @storing_tail_caller(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = icall @tail_forward, arg0, arg1
      sstore 0, arg1
      ret v0
  }
  
