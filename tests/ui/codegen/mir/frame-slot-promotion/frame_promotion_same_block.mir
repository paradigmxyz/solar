//@compile-flags: -Zmir-pipeline=frame-slot-promotion,dce
//@filecheck:
@module FramePromotionSameBlock
// CHECK-LABEL: {{^[ +].*}}fn @same_block{{[( ]}}
// CHECK: + [[RESULT:v[0-9]+]] = add 7, 1
// CHECK: + ret [[RESULT]]
fn @same_block() -> i256 {
  bb0:
    v8 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v8 to i256
    mstore v1, 7
    v9 = internal_frame_addr 128
    v2 = ptrtoint ptr<memory> v9 to i256
    v3 = mload v2
    v4 = add v3, 1
    v10 = internal_frame_addr 128
    v5 = ptrtoint ptr<memory> v10 to i256
    mstore v5, v4
    v11 = internal_frame_addr 128
    v6 = ptrtoint ptr<memory> v11 to i256
    v7 = mload v6
    ret v7
}

// A logical frame slot of a function with one return word starts after the
// two-word header and the return word, so offset 32 is internal frame address
// 128. Its store overwrites the slot, which must stay in memory.
// CHECK-LABEL: {{^[ +].*}}fn @frame_store_overlap{{[( ]}}
// CHECK: {{^ .*}}[[LOAD:v[0-9]+]] = mload
// CHECK: {{^ .*}}ret [[LOAD]]
fn @frame_store_overlap() -> i256 {
  bb0:
    v0 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 7
    frame_store internal_frame, word, 32, 9
    v2 = mload v1
    ret v2
}
