//@compile-flags: -Zmir-pipeline=frame-slot-promotion,dce
//@filecheck:
@module FramePromotionSameBlock
// CHECK-LABEL: {{^[ +].*}}fn @same_block{{[( ]}}
// CHECK: + [[RESULT:v[0-9]+]] = add 7, 1
// CHECK: + ret [[RESULT]]
fn @same_block() -> i256 {
  bb0:
    v8 = internal_frame_addr 128
    v1 = ptrtoint memptr v8 to i256
    mstore v1, 7
    v9 = internal_frame_addr 128
    v2 = ptrtoint memptr v9 to i256
    v3 = mload v2
    v4 = add v3, 1
    v10 = internal_frame_addr 128
    v5 = ptrtoint memptr v10 to i256
    mstore v5, v4
    v11 = internal_frame_addr 128
    v6 = ptrtoint memptr v11 to i256
    v7 = mload v6
    ret v7
}
