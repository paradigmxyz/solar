//@compile-flags: -Zmir-pipeline=frame-slot-promotion,cfg-simplify,dce
//@filecheck:
@module SequentialCounter
// CHECK-LABEL: {{^[ +].*}}fn @sequential{{[( ]}}
// CHECK: + [[FIRST:v[0-9]+]] = phi [bb0: 0], [bb2: [[NEXT_FIRST:v[0-9]+]]]
// CHECK: + [[SECOND:v[0-9]+]] = phi [bb0: 0], [bb2: [[NEXT_SECOND:v[0-9]+]]]
// CHECK: + [[NEXT_FIRST]] = add [[FIRST]], 1
// CHECK: + [[NEXT_SECOND]] = add [[SECOND]], 1
fn @sequential(arg0: i256) -> i256 {
  bb0:
    v28 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v28 to i256
    store v1, 0
    v29 = internal_frame_addr 160
    v2 = ptrtoint ptr<memory> v29 to i256
    store v2, 0
    jump bb1
  bb1:
    v30 = internal_frame_addr 160
    v3 = ptrtoint ptr<memory> v30 to i256
    v4 = load v3
    v5 = lt v4, arg0
    jumpi v5, bb2, bb3
  bb2:
    v31 = internal_frame_addr 128
    v6 = ptrtoint ptr<memory> v31 to i256
    v7 = load v6
    v8 = add v7, 1
    v32 = internal_frame_addr 128
    v9 = ptrtoint ptr<memory> v32 to i256
    store v9, v8
    v33 = internal_frame_addr 160
    v10 = ptrtoint ptr<memory> v33 to i256
    v11 = load v10
    v12 = add v11, 1
    v34 = internal_frame_addr 160
    v13 = ptrtoint ptr<memory> v34 to i256
    store v13, v12
    jump bb1
  bb3:
    v35 = internal_frame_addr 192
    v14 = ptrtoint ptr<memory> v35 to i256
    store v14, 0
    jump bb4
  bb4:
    v36 = internal_frame_addr 192
    v15 = ptrtoint ptr<memory> v36 to i256
    v16 = load v15
    v17 = lt v16, arg0
    jumpi v17, bb5, bb6
  bb5:
    v37 = internal_frame_addr 128
    v18 = ptrtoint ptr<memory> v37 to i256
    v19 = load v18
    v20 = add v19, 1
    v38 = internal_frame_addr 128
    v21 = ptrtoint ptr<memory> v38 to i256
    store v21, v20
    v39 = internal_frame_addr 192
    v22 = ptrtoint ptr<memory> v39 to i256
    v23 = load v22
    v24 = add v23, 1
    v40 = internal_frame_addr 192
    v25 = ptrtoint ptr<memory> v40 to i256
    store v25, v24
    jump bb4
  bb6:
    v41 = internal_frame_addr 128
    v26 = ptrtoint ptr<memory> v41 to i256
    v27 = load v26
    ret v27
}
