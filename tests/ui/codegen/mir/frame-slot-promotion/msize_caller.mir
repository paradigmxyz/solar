//@compile-flags: -Zmir-pipeline=frame-slot-promotion
//@filecheck:
@module FramePromotionMsizeCaller

// Frame slots lie below the free-memory pointer, so `msize` in a caller does not keep the slot's
// traffic in memory.
// CHECK-LABEL: fn @frame{{[( ]}}
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK: {{^[ +]+}}ret arg0
fn @frame(arg0: i256) -> i256 {
  bb0:
    v0 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    v2 = mload v1
    ret v2
}

fn @caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @frame, arg0
    v1 = msize
    v2 = add v0, v1
    ret v2
}

// `msize` stays in place while the slot leaves memory.
// CHECK-LABEL: @msize_observed
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK: {{^ +}}{{v[0-9]+}} = msize
// CHECK: {{^[ +]+}}ret 42
fn @msize_observed() -> i256 {
  bb0:
    v17 = internal_frame_addr 128
    v0 = ptrtoint ptr<memory> v17 to i256
    mstore v0, 42
    v1 = msize
    v2 = mload v0
    ret v2
}

// A store, `msize`, and a load in one function promote the slot too.
// CHECK-LABEL: {{^[ +].*}}fn @promote_around_msize{{[( ]}}
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK: {{^[ +].*}}msize
fn @promote_around_msize() -> i256 {
  bb0:
    v10 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v10 to i256
    mstore v1, 9
    v2 = msize
    v11 = internal_frame_addr 128
    v3 = ptrtoint ptr<memory> v11 to i256
    v4 = mload v3
    v5 = add v4, v2
    ret v5
}
