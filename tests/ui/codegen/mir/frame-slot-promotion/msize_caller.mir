//@compile-flags: -Zmir-pipeline=frame-slot-promotion
//@filecheck:
@module FramePromotionMsizeCaller

// Internal calls share memory, so `msize` in a caller observes the expansion
// of the frame slot's store even though `@frame` never reads `msize` itself.
// CHECK-LABEL: fn @frame{{[( ]}}
// CHECK: mstore [[SLOT:v[0-9]+]], arg0
// CHECK: mload [[SLOT]]
fn @frame(arg0: i256) -> i256 {
  bb0:
    v0 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    v2 = mload v1
    ret v2
}

fn @caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @frame, arg0
    v1 = msize
    v2 = add v0, v1
    ret v2
}

// `msize` observes the memory extent, which removing local-slot traffic
// changes, so it stays a barrier and the slot keeps its memory form.
// CHECK-LABEL: @msize_observed
// CHECK: {{^ +}}mstore [[FRAME:v[0-9]+]], 42
// CHECK: {{^ +}}{{v[0-9]+}} = msize
// CHECK: {{^ +}}[[LOAD:v[0-9]+]] = mload [[FRAME]]
// CHECK: {{^ +}}ret [[LOAD]]
fn @msize_observed() -> i256 {
  bb0:
    v17 = internal_frame_addr 128
    v0 = ptrtoint ptr<memory> v17 to i256
    mstore v0, 42
    v1 = msize
    v2 = mload v0
    ret v2
}

// A store, `msize`, and a load in one function keep the slot in memory.
// CHECK-LABEL: {{^[ +].*}}fn @keep_msize_observation{{[( ]}}
// CHECK: {{^[ +].*}}[[SLOT_PTR:v[0-9]+]] = internal_frame_addr 128
// CHECK: [[SLOT:v[0-9]+]] = ptrtoint ptr<memory> [[SLOT_PTR]] to i256
// CHECK: {{^[ +].*}}mstore [[SLOT]], 9
// CHECK: {{^[ +].*}}msize
// CHECK: {{^[ +](.*[^a-z_])?}}mload
fn @keep_msize_observation() -> i256 {
  bb0:
    v10 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v10 to i256
    mstore v1, 9
    v2 = msize
    v11 = internal_frame_addr 128
    v3 = ptrtoint ptr<memory> v11 to i256
    v4 = mload v3
    v5 = add v4, v2
    ret v5
}
