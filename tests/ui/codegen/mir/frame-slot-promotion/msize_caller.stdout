- // === ROOT/tests/ui/codegen/mir/frame-slot-promotion/msize_caller.mir (before frame-slot-promotion) ===
+ // === ROOT/tests/ui/codegen/mir/frame-slot-promotion/msize_caller.mir (after frame-slot-promotion) ===
  @module FramePromotionMsizeCaller
  fn @frame(arg0: i256) -> i256 {
    bb0:
      v0 = internal_frame_addr 128
      v1 = ptrtoint ptr<memory> v0 to i256
      mstore v1, arg0
      v2 = mload v1
      ret v2
  }
  
  fn @caller(arg0: i256) -> i256 {
    bb0:
      v0 = icall @frame, arg0
      v1 = msize
      v2 = add v0, v1
      ret v2
  }
  
  fn @msize_observed() -> i256 {
    bb0:
      v0 = internal_frame_addr 128
      v1 = ptrtoint ptr<memory> v0 to i256
      mstore v1, 42
      v2 = msize
      v3 = mload v1
      ret v3
  }
  
  fn @keep_msize_observation() -> i256 {
    bb0:
      v0 = internal_frame_addr 128
      v1 = ptrtoint ptr<memory> v0 to i256
      mstore v1, 9
      v2 = msize
      v3 = internal_frame_addr 128
      v4 = ptrtoint ptr<memory> v3 to i256
      v5 = mload v4
      v6 = add v5, v2
      ret v6
  }
  
