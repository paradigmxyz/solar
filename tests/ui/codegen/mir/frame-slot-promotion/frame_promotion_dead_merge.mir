//@compile-flags: -Zmir-pipeline=frame-slot-promotion
//@filecheck:
@module FramePromotionDeadMerge
// CHECK-LABEL: {{^[ +].*}}fn @dead_merge{{[( ]}}
// CHECK: + [[COUNTER:v[0-9]+]] = phi [bb3: 0], [bb5: [[NEXT:v[0-9]+]]]
// CHECK: + ret [[COUNTER]]
// CHECK: + [[NEXT]] = add [[COUNTER]], 1
fn @dead_merge(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v9 = internal_frame_addr 128
    v1 = ptrtoint memptr v9 to i256
    mstore v1, 0
    jump bb4
  bb4:
    v10 = internal_frame_addr 128
    v2 = ptrtoint memptr v10 to i256
    v3 = mload v2
    v4 = lt v3, arg0
    jumpi v4, bb5, bb6
  bb5:
    v5 = add v3, 1
    v11 = internal_frame_addr 128
    v6 = ptrtoint memptr v11 to i256
    mstore v6, v5
    jump bb4
  bb6:
    v12 = internal_frame_addr 128
    v7 = ptrtoint memptr v12 to i256
    v8 = mload v7
    ret v8
}
