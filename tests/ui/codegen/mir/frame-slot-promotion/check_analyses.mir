//@ revisions: off on
//@[off] compile-flags: -Zmir-pipeline=frame-slot-promotion,dce
//@[off] filecheck: --check-prefixes=CHECK,OFF
//@[on] compile-flags: -Zmir-pipeline=frame-slot-promotion,dce,frame-slot-promotion -Zcheck-analyses=true
//@[on] filecheck: --check-prefixes=CHECK,ON
@module FrameSlotPromotionCheckAnalyses

// With `-Zcheck-analyses`, a promoted slot keeps its stores and loads: every use of a load reads the
// promoted value, and the load stays as the evidence that the slot still holds it. A second run
// leaves the evidence alone. Without the flag the slot's memory traffic goes.
// CHECK-LABEL: {{^[ +].*}}fn @loop_slot{{[( ]}}
// OFF: - mstore v1, 0
// ON: {{^ .*}}mstore v1, 0
// CHECK: + [[COUNTER:v[0-9]+]] = phi [bb0: 0], [bb2: [[NEXT:v[0-9]+]]]
// ON: {{^ .*}}[[HEAD:v[0-9]+]] = mload
// ON: + assume eq frame_slot_promotion, [[HEAD]], [[COUNTER]]
// ON: {{^ .*}}[[EXIT:v[0-9]+]] = mload
// ON: + assume eq frame_slot_promotion, [[EXIT]], [[COUNTER]]
// ON: {{^ .*}}[[BODY:v[0-9]+]] = mload
// ON: {{^ .*}}mstore
// ON-NEXT: + assume eq frame_slot_promotion, [[BODY]], [[COUNTER]]
// OFF-NOT: assume
// ON: (after dce)
// ON-NOT: {{^[+-] +[^ ;]}}
fn @loop_slot(arg0: i256) -> i256 {
  bb0:
    v11 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v11 to i256
    mstore v1, 0
    jump bb1
  bb1:
    v12 = internal_frame_addr 128
    v2 = ptrtoint ptr<memory> v12 to i256
    v3 = mload v2
    v4 = lt v3, arg0
    jumpi v4, bb2, bb3
  bb2:
    v13 = internal_frame_addr 128
    v5 = ptrtoint ptr<memory> v13 to i256
    v6 = mload v5
    v7 = add v6, 1
    v14 = internal_frame_addr 128
    v8 = ptrtoint ptr<memory> v14 to i256
    mstore v8, v7
    jump bb1
  bb3:
    v15 = internal_frame_addr 128
    v9 = ptrtoint ptr<memory> v15 to i256
    v10 = mload v9
    ret v10
}
