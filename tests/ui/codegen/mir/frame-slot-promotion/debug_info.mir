//@compile-flags: -Zmir-pipeline=frame-slot-promotion
//@filecheck:
@module DebugInfo

// CHECK-LABEL: {{^[ +].*}}fn @promote_loop_carried_slot{{[( ]}}
// CHECK: + [[COUNTER:v[0-9]+]] = phi [bb0: 0], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: + ret [[COUNTER]]
// CHECK: + [[NEXT]] = add [[COUNTER]], 1 !metadata(span=30..40)
fn @promote_loop_carried_slot(arg0: u256) -> u256 {
  bb0:
    v1 = internal_frame_addr 128 !metadata(span=10..20)
    mstore v1, 0 !metadata(span=10..20)
    jump bb1
  bb1:
    v2 = internal_frame_addr 128 !metadata(span=20..30)
    v3 = mload v2 !metadata(span=20..30)
    v4 = lt v3, arg0 !metadata(span=20..30)
    jumpi v4, bb2, bb3
  bb2:
    v5 = internal_frame_addr 128 !metadata(span=30..40)
    v6 = mload v5 !metadata(span=30..40)
    v7 = add v6, 1 !metadata(span=30..40)
    v8 = internal_frame_addr 128 !metadata(span=30..40)
    mstore v8, v7 !metadata(span=30..40)
    jump bb1
  bb3:
    v9 = internal_frame_addr 128 !metadata(span=40..50)
    v10 = mload v9 !metadata(span=40..50)
    ret v10
}
