//@ compile-flags: -Zmir-pipeline=lower-structs
//@ filecheck:
@module StructDebugOrigins

@types
  struct0: {i256, i256}

// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: + {{v[0-9]+}} = icall @pair, arg0 !metadata(spans=[10..20, 30..40], modifier_depth=2)
// CHECK: + {{v[0-9]+}} = frame_load multi_return, word, 0 !metadata(memory=scratch, spans=[10..20, 30..40], modifier_depth=2)
// CHECK: + {{v[0-9]+}} = mload {{v[0-9]+}} !metadata(spans=[10..20, 30..40], modifier_depth=2)
// CHECK: + {{v[0-9]+}} = select arg1, {{.*}} !metadata(spans=[50..60, 70..80], modifier_depth=3)
// CHECK: + {{v[0-9]+}} = select arg1, {{.*}} !metadata(spans=[50..60, 70..80], modifier_depth=3)
// CHECK: + ret {{.*}} !metadata(span=90..100, modifier_depth=4)
fn @caller(arg0: i256, arg1: i1) -> struct0 {
  bb0:
    v0 = icall @pair, arg0 !metadata(spans=[10..20, 30..40], modifier_depth=2)
    v1 = select arg1, v0, undef struct0 !metadata(spans=[50..60, 70..80], modifier_depth=3)
    ret v1 !metadata(span=90..100, modifier_depth=4)
}

fn @pair(arg0: i256) -> struct0 {
  bb0:
    v0 = insert_value struct0, undef struct0, 0, arg0 !metadata(span=110..120)
    v1 = insert_value struct0, v0, 1, 42 !metadata(span=120..130)
    ret v1 !metadata(span=130..140)
}

// Scalar insertions and projections emit no instruction. Their origins join the enclosed or
// enclosing definition of the leaf they select.
// CHECK-LABEL: {{^[ +].*}}fn @fold{{[( ]}}
// CHECK: + {{v[0-9]+}} = add arg0, 1 !metadata(spans=[152..154, 150..160, 153..154])
fn @fold(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1 !metadata(span=152..154)
    v1 = insert_value struct0, undef struct0, 0, v0 !metadata(span=150..160)
    v2 = extract_value struct0, v1, 0 !metadata(span=153..154)
    ret v2
}

// A projection whose span nests with nothing in the leaf's definition keeps its origin dropped.
// CHECK-LABEL: {{^[ +].*}}fn @unrelated{{[( ]}}
// CHECK: {{v[0-9]+}} = add arg0, 1 !metadata(span=252..254){{$}}
fn @unrelated(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1 !metadata(span=252..254)
    v1 = insert_value struct0, undef struct0, 0, v0 !metadata(span=260..270)
    v2 = extract_value struct0, v1, 0 !metadata(span=260..270)
    ret v2
}
