//@ compile-flags: -Zmir-pipeline=lower-structs
//@ filecheck:
@module StructDebugOrigins

types:
  struct0: {u256, u256}

// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: + {{v[0-9]+}} = icall @pair, arg0 !metadata(spans=[10..20, 30..40], modifier_depth=2)
// CHECK: + {{v[0-9]+}} = frame_load multi_return, word, 0 !metadata(memory=scratch, spans=[10..20, 30..40], modifier_depth=2)
// CHECK: + {{v[0-9]+}} = mload {{v[0-9]+}} !metadata(spans=[10..20, 30..40], modifier_depth=2)
// CHECK: + {{v[0-9]+}} = select arg1, {{.*}} !metadata(spans=[50..60, 70..80], modifier_depth=3)
// CHECK: + {{v[0-9]+}} = select arg1, {{.*}} !metadata(spans=[50..60, 70..80], modifier_depth=3)
// CHECK: + ret {{.*}} !metadata(span=90..100, modifier_depth=4)
fn @caller(arg0: u256, arg1: bool) -> struct0 {
  bb0:
    v0 = icall @pair, arg0 !metadata(spans=[10..20, 30..40], modifier_depth=2)
    v1 = select arg1, v0, undef struct0 !metadata(spans=[50..60, 70..80], modifier_depth=3)
    ret v1 !metadata(span=90..100, modifier_depth=4)
}

fn @pair(arg0: u256) -> struct0 {
  bb0:
    v0 = insert_value struct0, undef struct0, 0, arg0 !metadata(span=110..120)
    v1 = insert_value struct0, v0, 1, 42 !metadata(span=120..130)
    ret v1 !metadata(span=130..140)
}
