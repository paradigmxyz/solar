//@ compile-flags: -Zmir-pipeline=call-cleanup
//@ filecheck:
@module ReturnedMasks

// A callee that returns masked words makes the caller's mask of the result redundant.
// CHECK-LABEL: fn @clean_result
// CHECK-NOT: {{^[ +].*}}= and v0
// CHECK: ret v0
fn @clean_result(arg0: i256) -> i256 {
  bb0:
    v0 = icall @masked, arg0
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffff
    ret v1
}

// A callee with one wider return keeps the caller's mask.
// CHECK-LABEL: fn @dirty_result
// CHECK: = and v0, 0xffffffffffffffffffffffffffffffffffffffff
fn @dirty_result(arg0: i256) -> i256 {
  bb0:
    v0 = icall @sometimes_dirty, arg0
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffff
    ret v1
}

fn @masked(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 0xffffffffffffffffffffffffffffffffffffffff
    ret v0
}

fn @sometimes_dirty(arg0: i256) -> i256 {
  bb0:
    v1 = ne arg0, 0
    jumpi v1, bb1, bb2
  bb1:
    v0 = and arg0, 0xffffffffffffffffffffffffffffffffffffffff
    ret v0
  bb2:
    ret arg0
}

// A callee that tail-calls a function that may return has an unknown return width.
// CHECK-LABEL: fn @tail_result
// CHECK: = and v0, 255
fn @tail_result(arg0: i256) -> i256 {
  bb0:
    v0 = icall @forwards, arg0
    v1 = and v0, 0xff
    ret v1
}

fn @forwards(arg0: i256) -> i256 {
  bb0:
    tail_call @masked, arg0
}

// A recursive callee that returns a constant or a masked recursive result fits its mask.
// CHECK-LABEL: fn @recursive_result
// CHECK-NOT: {{^[ +].*}}= and v0
// CHECK: ret v0
fn @recursive_result(arg0: i256) -> i256 {
  bb0:
    v0 = icall @recursive, arg0
    v1 = and v0, 0xff
    ret v1
}

fn @recursive(arg0: i256) -> i256 {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    v1 = sub arg0, 1
    v2 = icall @recursive, v1
    v3 = and v2, 0xff
    ret v3
  bb2:
    ret 5
}

// A recursive callee whose base case is wider keeps the mask.
// CHECK-LABEL: fn @wide_recursive_result
// CHECK: = and v0, 255
fn @wide_recursive_result(arg0: i256) -> i256 {
  bb0:
    v0 = icall @wide_recursive, arg0
    v1 = and v0, 0xff
    ret v1
}

fn @wide_recursive(arg0: i256) -> i256 {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    v1 = sub arg0, 1
    v2 = icall @wide_recursive, v1
    v3 = and v2, 0xff
    ret v3
  bb2:
    ret arg0
}
