//@ compile-flags: -Zmir-pipeline=call-cleanup,dce
@module BooleanReturns

fn @clean(arg0: i256) -> i1 {
  bb0:
    v0 = lt arg0, 128
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 1], [bb2: 0]
    v2 = ne v1, 0
    ret v2
}

// Assembly words must be normalized before returning a boolean.
fn @dirty(arg0: i256) -> i1 {
  bb0:
    v0 = ne arg0, 0
    ret v0
}

// Recursive calls preserve the declared boolean contract.
fn @recursive(arg0: i256) -> i1 {
  bb0:
    v0 = icall @recursive, arg0
    ret v0
}

fn @compare(arg0: i256) -> i1 {
  bb0:
    v0 = icall @clean, arg0
    v1 = eq v0, false
    v2 = eq v1, false
    ret v2
}

fn @keep_dirty(arg0: i256) -> i1 {
  bb0:
    v0 = icall @dirty, arg0
    v1 = eq v0, false
    v2 = eq v1, false
    ret v2
}

fn @keep_recursive(arg0: i256) -> i1 {
  bb0:
    v0 = icall @recursive, arg0
    v1 = eq v0, false
    v2 = eq v1, false
    ret v2
}

// Every return arm normalizes raw words to booleans.
fn @mixed(arg0: i256) -> i1 {
  bb0:
    v0 = lt arg0, 5
    jumpi v0, bb1, bb2
  bb1:
    ret true
  bb2:
    v1 = ne 2, 0
    ret v1
}

fn @keep_mixed(arg0: i256) -> i1 {
  bb0:
    v0 = icall @mixed, arg0
    v1 = eq v0, false
    v2 = eq v1, false
    ret v2
}
