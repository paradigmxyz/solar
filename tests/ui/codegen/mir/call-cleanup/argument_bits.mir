//@ compile-flags: -Zmir-pipeline=call-cleanup
//@ filecheck:
@module ArgumentBits

fn @root(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    v1 = icall @forward, v0
    ret v1
}

// CHECK-LABEL: fn @forward
// CHECK-NOT: {{^[ +].*}}= and
// CHECK: tail_call @leaf, arg0
fn @forward(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    tail_call @leaf, v0
}

// CHECK-LABEL: fn @leaf
// CHECK-NOT: {{^[ +].*}}= and
// CHECK: ret arg0
fn @leaf(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    ret v0
}

fn @clean_caller() -> i256 {
  bb0:
    v3 = caller
    v0 = zext i160 v3 to i256
    v1 = icall @mixed, v0
    ret v1
}

fn @dirty_caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @mixed, arg0
    ret v0
}

// One dirty caller prevents cleanup removal, regardless of the signature.
// CHECK-LABEL: fn @mixed
// CHECK: = and arg0, 0xffffffffffffffffffffffffffffffffffffffff
fn @mixed(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 0xffffffffffffffffffffffffffffffffffffffff
    ret v0
}

fn @recursive_root(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    v1 = icall @recursive, v0
    ret v1
}

// A recursive identity edge does not bootstrap its own argument fact.
// CHECK-LABEL: fn @recursive
// CHECK: = and arg0, 255
fn @recursive(arg0: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    jumpi v2, bb1, bb2
  bb1:
    v0 = icall @recursive, arg0
    ret v0
  bb2:
    v1 = and arg0, 255
    ret v1
}

fn @sanitized_root(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    v1 = icall @sanitized_recursive, v0
    ret v1
}

// Every edge, including the recursive one, explicitly supplies a clean word.
// CHECK-LABEL: fn @sanitized_recursive
// CHECK-NOT: {{^[ +].*}}= and
// CHECK: icall @sanitized_recursive, arg0
fn @sanitized_recursive(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    v2 = ne v0, 0
    jumpi v2, bb1, bb2
  bb1:
    v1 = icall @sanitized_recursive, v0
    ret v1
  bb2:
    ret v0
}

fn @bool_root(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 0
    v1 = icall @bool_leaf, v0
    ret v1
}

// CHECK-LABEL: fn @bool_leaf
// CHECK: [[WORD:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} arg0
// CHECK-NOT: {{^[ +].*}}= and
// CHECK: ret [[WORD]]
fn @bool_leaf(arg0: i1) -> i256 {
  bb0:
    v1 = zext i1 arg0 to i256
    v0 = and v1, 1
    ret v0
}

fn @public_caller() -> i256 {
  bb0:
    v0 = icall @public_input, 1
    ret v0
}

// A direct internal call does not constrain an external entry's inputs.
// CHECK-LABEL: fn @public_input
// CHECK: = and arg0, 255
fn @public_input(arg0: i256) -> i256 [selector=0x01020304] {
  bb0:
    v0 = and arg0, 255
    ret v0
}

fn @frame_caller() -> i256 {
  bb0:
    v0 = icall @frame_input, 1
    ret v0
}

// Explicit frame addresses can write an argument home after the call boundary.
// CHECK-LABEL: fn @frame_input
// CHECK: = and arg0, 255
fn @frame_input(arg0: i256) -> i256 {
  bb0:
    v4 = internal_frame_addr 64
    v0 = ptrtoint memptr v4 to i256
    mstore v0, 511
    v1 = and arg0, 255
    ret v1
}

fn @across_caller() -> i256 {
  bb0:
    v0 = icall @across_call, 1
    ret v0
}

// Retain a materialized mask across calls to avoid changing the preserved stack.
// CHECK-LABEL: fn @across_call
// CHECK: [[MASK:v[0-9]+]] = and arg0, 255
// CHECK: icall @clobber
// CHECK: ret [[MASK]]
fn @across_call(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 255
    icall @clobber
    ret v0
}

fn @clobber() {
  bb0:
    sstore 0, 1
    stop
}

fn @cast_caller() -> i1 {
  bb0:
    v0 = caller
    v1 = zext i160 v0 to i256
    v2 = icall @clean_cast, v1
    ret v2
}

// A proved-clean argument retains its original word identity after a cast pair.
// CHECK-LABEL: fn @clean_cast
// CHECK: [[NARROW:v[0-9]+]] = trunc i256 arg0 to i160
// CHECK-NOT: {{^[ +].*}}= zext
// CHECK: [[TEST:v[0-9]+]] = eq arg0, 0
// CHECK: mstore 0, arg0
// CHECK: ret [[TEST]]
fn @clean_cast(arg0: i256) -> i1 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    v2 = eq v0, i160 0
    mstore 0, v1
    ret v2
}

// An unconstrained word still needs the narrowing mask.
// CHECK-LABEL: fn @dirty_cast
// CHECK: [[NARROW:v[0-9]+]] = trunc i256 arg0 to i160
// CHECK: [[WORD:v[0-9]+]] = zext i160 [[NARROW]] to i256
// CHECK: ret [[WORD]]
fn @dirty_cast(arg0: i256) -> i256 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    ret v1
}

fn @wider_caller() -> i256 {
  bb0:
    v0 = icall @wider_cast, i160 1
    ret v0
}

// A roundtrip whose result has a wider type cannot merge with its input.
// CHECK-LABEL: fn @wider_cast
// CHECK: = trunc i160 arg0 to i1
// CHECK: = zext i1
fn @wider_cast(arg0: i160) -> i256 {
  bb0:
    v0 = trunc i160 arg0 to i1
    v1 = zext i1 v0 to i256
    ret v1
}

fn @cast_across_caller() -> i256 {
  bb0:
    v0 = icall @cast_across_call, 1
    ret v0
}

// Keep the existing profitability guard for a cast result live across a call.
// CHECK-LABEL: fn @cast_across_call
// CHECK: [[NARROW:v[0-9]+]] = trunc i256 arg0 to i160
// CHECK: [[WORD:v[0-9]+]] = zext i160 [[NARROW]] to i256
// CHECK: icall @clobber
// CHECK: ret [[WORD]]
fn @cast_across_call(arg0: i256) -> i256 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    icall @clobber
    ret v1
}

fn @zero_caller() -> i1 {
  bb0:
    v0 = icall @clean_zero_tests, 7
    ret v0
}

// CHECK-LABEL: fn @clean_zero_tests
// CHECK: = eq arg0, 0
// CHECK: = ne arg0, 0
fn @clean_zero_tests(arg0: i256) -> i1 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = eq v0, i160 0
    v2 = ne i160 0, v0
    v3 = select v1, v1, v2
    ret v3
}

// CHECK-LABEL: fn @dirty_zero_tests
// CHECK: [[NARROW:v[0-9]+]] = trunc i256 arg0 to i160
// CHECK: = eq [[NARROW]], i160 0
// CHECK: = ne i160 0, [[NARROW]]
fn @dirty_zero_tests(arg0: i256) -> i1 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = eq v0, i160 0
    v2 = ne i160 0, v0
    v3 = select v1, v1, v2
    ret v3
}

fn @zero_across_caller() -> i1 {
  bb0:
    v0 = icall @zero_across_call, 1
    ret v0
}

// Preserve the narrowed word identity when it lives across a call.
// CHECK-LABEL: fn @zero_across_call
// CHECK: [[NARROW:v[0-9]+]] = trunc i256 arg0 to i160
// CHECK: icall @clobber
// CHECK: = ne [[NARROW]], i160 0
fn @zero_across_call(arg0: i256) -> i1 {
  bb0:
    v0 = trunc i256 arg0 to i160
    icall @clobber
    v1 = ne v0, i160 0
    ret v1
}
