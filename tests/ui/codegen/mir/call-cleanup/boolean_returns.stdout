- // === ROOT/tests/ui/codegen/mir/call-cleanup/boolean_returns.mir (before call-cleanup) ===
+ // === ROOT/tests/ui/codegen/mir/call-cleanup/boolean_returns.mir (after call-cleanup) ===
  @module BooleanReturns
  fn @clean(arg0: u256) -> bool {
    bb0:
      v0 = lt arg0, 128
      jumpi v0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      jump bb3
    bb3:
      v1 = phi [bb1: 1], [bb2: 0]
      ret v1
  }
  
  fn @dirty(arg0: u256) -> bool {
    bb0:
      ret arg0
  }
  
  fn @recursive(arg0: u256) -> bool {
    bb0:
      v0 = icall @recursive, 1, arg0
      ret v0
  }
  
  fn @compare(arg0: u256) -> bool {
    bb0:
      v0 = icall @clean, 1, arg0
      v1 = iszero v0
-     v2 = iszero v1
-     ret v2
+     ret v0
  }
  
  fn @keep_dirty(arg0: u256) -> bool {
    bb0:
      v0 = icall @dirty, 1, arg0
      v1 = iszero v0
      v2 = iszero v1
      ret v2
  }
  
  fn @keep_recursive(arg0: u256) -> bool {
    bb0:
      v0 = icall @recursive, 1, arg0
      v1 = iszero v0
      v2 = iszero v1
      ret v2
  }
  
  fn @mixed(arg0: u256) -> bool {
    bb0:
      v0 = lt arg0, 5
      jumpi v0, bb1, bb2
    bb2:
      ret 2
    bb1:
      ret 1
  }
  
  fn @keep_mixed(arg0: u256) -> bool {
    bb0:
      v0 = icall @mixed, 1, arg0
      v1 = iszero v0
      v2 = iszero v1
      ret v2
  }
  
