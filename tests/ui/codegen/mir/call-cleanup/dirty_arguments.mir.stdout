; === ROOT/tests/ui/codegen/mir/call-cleanup/dirty_arguments.sol:DirtyArguments ===
@module DirtyArguments
; function normalizedReturn(uint256 word) external pure returns (bool) [selector 0xaca23352]
fn @normalizedReturn(arg0: i256) -> i256 [selector=0xaca23352, pure, abi_params=[uint256], abi_returns=[word<bool>], abi_return_params=[bool]] {
  bb0:
    v0 = icall @rawReturn, arg0
    ret v0
}

; function compareRawReturn(uint256 word, bool flag) external pure returns (bool) [selector 0x6585d271]
fn @compareRawReturn(arg0: i256, arg1: i1) -> i1 [selector=0x6585d271, pure, abi_params=[uint256, bool], abi_returns=[word<bool>], abi_return_params=[bool]] {
  bb0:
    v0 = icall @rawReturn, arg0
    v1 = ne v0, 0
    v2 = eq v1, arg1
    ret v2
}

; function rawReturn(uint256 word) internal pure returns (bool result)
fn @rawReturn(arg0: i256) -> i256 [pure] {
  bb0:
    ret arg0
}

; function compareReturns(uint256 a, uint256 b) external pure returns (bool) [selector 0xf3b43d04]
fn @compareReturns(arg0: i256, arg1: i256) -> i1 [selector=0xf3b43d04, pure, abi_params=[uint256, uint256], abi_returns=[word<bool>], abi_return_params=[bool]] {
  bb0:
    v0 = icall @canonicalReturn, arg0
    v1 = icall @canonicalReturn, arg1
    v2 = eq v0, v1
    ret v2
}

; function canonicalReturn(uint256 word) internal pure returns (bool)
fn @canonicalReturn(arg0: i256) -> i1 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    ret false
  bb1:                                            ; preds = bb0
    ret true
}

; function selectedClean(bool condition) external pure returns (uint256) [selector 0x4d264e8d]
