; function selected(bool condition) internal pure returns (uint256)
fn @selected(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v1 = phi [bb1: 19], [bb2: 7]
    ret v1
}

