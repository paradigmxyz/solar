; function narrow(uint256 word) external pure returns (uint256) [selector 0x0ebb6188]
fn @narrow(arg0: i256) -> i256 [selector=0x0ebb6188, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = trunc i256 arg0 to i8
    v1 = icall @forward, v0
    ret v1
}

; function forward(uint8 value) internal pure returns (uint256)
fn @forward(arg0: i8) -> i256 [pure] {
  bb0:
    v0 = zext i8 arg0 to i256
    ret v0
}

; function recurse(uint256 word, uint256 depth) external pure returns (uint256) [selector 0x0dac78c4]
fn @recurse(arg0: i256, arg1: i256) -> i256 [selector=0x0dac78c4, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = gt arg1, 4
    v1 = eq v0, false
    v2 = eq v1, false
    icall revert_if<empty>, v2
    v3 = trunc i256 arg0 to i8
    v4 = icall @recursive, v3, arg1
    ret v4
}

; function recursive(uint8 value, uint256 depth) internal pure returns (uint256)
fn @recursive(arg0: i8, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg1, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    v2 = checked_sub uint256, arg1, 1
    v3 = icall @recursive, arg0, v2
    ret v3
  bb1:                                            ; preds = bb0
    v1 = zext i8 arg0 to i256
    ret v1
}
