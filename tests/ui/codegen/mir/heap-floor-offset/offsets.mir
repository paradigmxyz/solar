//@ compile-flags: -Ogas -Zmir-pipeline=heap-floor-offset
@module HeapFloorOffsets

// The floor plus a constant is one operation, and the floor stays for its other uses.
fn @floor() [selector=0x11111111, abi_wrapper] {
  bb0:
    v0 = heap_floor
    v1 = add v0, 32
    mstore v1, 1
    mstore v0, 2
    stop
}

// Either operand order folds, and a chain folds into one offset.
fn @chain() [selector=0x22222222, abi_wrapper] {
  bb0:
    v0 = heap_floor
    v1 = add 32, v0
    v2 = add v1, 64
    mstore v2, 1
    stop
}

// A non-constant offset, and an offset above 32 bits, stay additions.
fn @unchanged(arg0: i256) {
  bb0:
    v0 = heap_floor
    v1 = add v0, arg0
    v2 = add v0, 0x100000000
    mstore v1, 1
    mstore v2, 2
    ret
}
