// === ROOT/tests/ui/codegen/mir/dump_phase.sol:DumpPhase ===
@module DumpPhase
@phase evm-shaped
fn @f() {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb2:
    mstore 128, arg0
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb3, [0xb3de648b => bb2]
  bb2:
    tail_call @f
  bb3:
    revert 0, 0
}
