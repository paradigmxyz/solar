@module DumpPhase
@phase evm-shaped
fn @f() [selector=0xb3de648b, pure] {
  bb0:
    v2 = calldatasize
    v3 = lt v2, 36
    jumpi v3, bb1, bb2
  bb2:
    mstore 128, arg0
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb3, [0xb3de648b => bb2]
  bb2:
    tail_call @f
  bb3:
    revert 0, 0
}

