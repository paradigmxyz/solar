// === ROOT/tests/ui/codegen/mir/dump_phase.sol:DumpPhase ===
@module DumpPhase
@phase evm-shaped
fn @f() {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    mstore 128, arg0
    returndata 128, 32
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb4, bb1
  bb1:
    v1 = calldatasize
    jumpi v1, bb2, bb4
  bb2:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb4, [0xb3de648b => bb3]
  bb3:
    tail_call @f
  bb4:
    revert 0, 0
}

