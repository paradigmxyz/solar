//@ revisions: gas size lowered
//@[gas] compile-flags: -Ogas -Zmir-pipeline=loop-unswitch,const-fold,cfg-simplify
//@[size] compile-flags: -Osize -Zmir-pipeline=loop-unswitch,const-fold,cfg-simplify
//@[lowered] compile-flags: -Ogas -Zmir-pipeline=loop-unswitch,const-fold,cfg-simplify,lower-evm-shaped
@module Unswitch

fn @guard(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = eq arg1, 0
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v7]
    v2 = phi [bb0: arg0], [bb3: v3]
    v8 = lt v1, arg2
    jumpi v8, bb2, bb4
  bb2:
    v3 = mul v2, arg1
    v4 = div v3, arg1
    v5 = eq v4, v2
    v6 = or v0, v5
    jumpi v6, bb3, bb5
  bb3:
    v7 = add v1, 1
    jump bb1
  bb4:
    ret v2
  bb5:
    revert 0, 0
}

fn @keep_memory(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = eq arg1, 0
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v7]
    v2 = phi [bb0: arg0], [bb3: v3]
    v8 = lt v1, arg2
    jumpi v8, bb2, bb4
  bb2:
    mstore 128, v2
    v3 = mul v2, arg1
    v4 = div v3, arg1
    v5 = eq v4, v2
    v6 = or v0, v5
    jumpi v6, bb3, bb5
  bb3:
    v7 = add v1, 1
    jump bb1
  bb4:
    ret v2
  bb5:
    revert 0, 0
}

fn @inside_guard(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v7]
    v2 = phi [bb0: arg0], [bb3: v3]
    v8 = lt v1, arg2
    jumpi v8, bb2, bb4
  bb2:
    v3 = mul v2, arg1
    v4 = div v3, arg1
    v5 = eq v4, v2
    v0 = eq arg1, 0
    v6 = or v0, v5
    jumpi v6, bb3, bb5
  bb3:
    v7 = add v1, 1
    jump bb1
  bb4:
    ret v2
  bb5:
    revert 0, 0
}

fn @deferred_exit(arg0: i256, arg1: i256, arg2: i256) -> memptr {
  bb0:
    v0 = eq arg1, 0
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v7]
    v2 = phi [bb0: arg0], [bb3: v3]
    v8 = lt v1, arg2
    jumpi v8, bb2, bb4
  bb2:
    v3 = mul v2, arg1
    v4 = div v3, arg1
    v5 = eq v4, v2
    v6 = or v0, v5
    jumpi v6, bb3, bb5
  bb3:
    v7 = add v1, 1
    jump bb1
  bb4:
    v9 = alloc raw, exact, uninitialized, infallible, 32 !metadata(deferred_alloc)
    v10 = ptrtoint memptr v9 to i256
    mstore v10, v2
    ret v9
  bb5:
    revert 0, 0
}
