//@compile-flags: -Zmir-pipeline=default
//@filecheck:
@module FreshArrayBoundsPipeline

// A constant index still needs a bounds check when an FMP update may alias
// the object's length word. The raw FMP load carries no address proof.
// CHECK-LABEL: fn @constant_index{{[( ]}}
// CHECK: calldatacopy {{v[0-9]+}}, 0, 96
// CHECK: [[LENGTH:v[0-9]+]] = mload {{v[0-9]+}}
// CHECK: [[IN_BOUNDS:v[0-9]+]] = lt 1, [[LENGTH]]
// CHECK: jumpi [[IN_BOUNDS]], bb2, bb1
// CHECK: revert 0, 36
// CHECK: ret 7
fn @constant_index() -> u256 {
  bb0:
    v0 = mload 64
    mstore v0, 3
    v1 = add v0, 128
    mstore 64, v1
    v2 = add v0, 32
    calldatacopy v2, 0, 96
    v3 = mload v0
    v4 = lt 1, v3
    jumpi v4, bb2, bb1
  bb1:
    revert 0, 36
  bb2:
    ret 7
}

// Runtime lengths still need the bounds branch.
// CHECK-LABEL: fn @runtime_index{{[( ]}}
// CHECK: [[LENGTH:v[0-9]+]] = mload {{v[0-9]+}}
// CHECK: [[IN_BOUNDS:v[0-9]+]] = lt 1, [[LENGTH]]
// CHECK: jumpi [[IN_BOUNDS]], bb2, bb1
// CHECK: revert 0, 36
fn @runtime_index(arg0: u256) -> u256 {
  bb0:
    v0 = mload 64
    mstore v0, arg0
    v1 = shl 5, arg0
    v2 = add v1, 32
    v3 = add v0, v2
    mstore 64, v3
    v4 = add v0, 32
    calldatacopy v4, 0, v1
    v5 = mload v0
    v6 = lt 1, v5
    jumpi v6, bb2, bb1
  bb1:
    revert 0, 36
  bb2:
    ret 7
}
