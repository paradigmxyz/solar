//@compile-flags: -Zmir-pipeline=cse,memory-dse,storage-load-cse,storage-dse,dce
//@filecheck:
@module AggregateEffects

// CSE forwards across aggregate effects only when their ranges are disjoint.
// CHECK: + // === {{.*}} (after cse) ===
// CHECK: {{^[ +].*}}fn @flat_memory_write_is_precise{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload 128
// CHECK: + {{v[0-9]+}} = add [[FLAT:v[0-9]+]], [[FLAT]]
// CHECK: {{^[ +].*}}fn @nested_memory_write_is_barrier{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload 128
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload 128
// CHECK: {{^[ +].*}}fn @disjoint_storage{{[( ]}}
// CHECK: + {{v[0-9]+}} = add [[SLOAD:v[0-9]+]], [[SLOAD]]
// CHECK: {{^[ +].*}}fn @overlapping_storage{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
// Only unconditional stores prove overwrites; aggregate effects describe possible writes.
// CHECK: + // === {{.*}} (after storage-dse) ===
// CHECK: {{^[ +].*}}fn @overwrites_memory{{[( ]}}
// CHECK: {{^[ +].*}}mstore arg0, 7
// CHECK: {{^[ +].*}}fn @clobbers_stored_value{{[( ]}}
// CHECK: - sstore 0, 1 !metadata(storage=slot(0))

fn @reads_memory(arg0: i256) {
  bb0:
    mstore arg0, 7
    v10 = inttoptr i256 arg0 to memorystruct
    memory_to_storage struct<word>, v10, 0
    stop
}

fn @overwrites_memory(arg0: i256) -> i256 {
  bb0:
    mstore arg0, 7
    v10 = inttoptr i256 arg0 to memorystruct
    storage_to_memory struct<word>, 0, v10
    v0 = mload arg0
    ret v0
}

fn @flat_memory_write_is_precise() -> i256 {
  bb0:
    v0 = mload 128
    v10 = inttoptr i256 256 to memorystruct
    storage_to_memory struct<word>, 0, v10
    v1 = mload 128
    v2 = add v0, v1
    ret v2
}

fn @nested_memory_write_is_barrier() -> i256 {
  bb0:
    v0 = mload 128
    v10 = inttoptr i256 256 to memorystruct
    storage_to_memory struct<struct<word>>, 0, v10
    v1 = mload 128
    v2 = add v0, v1
    ret v2
}

fn @disjoint_storage() -> i256 {
  bb0:
    v0 = sload 0
    clear_storage struct<word, word>, 10
    v1 = sload 0
    v2 = add v0, v1
    ret v2
}

fn @overlapping_storage() -> i256 {
  bb0:
    v0 = sload 0
    clear_storage struct<word, word>, 0
    v1 = sload 0
    v2 = add v0, v1
    ret v2
}

fn @observes_storage(arg0: i256) {
  bb0:
    sstore 0, 1
    v10 = inttoptr i256 arg0 to memorystruct
    storage_to_memory struct<word>, 0, v10
    sstore 0, 2
    stop
}

fn @clobbers_stored_value() {
  bb0:
    sstore 0, 1
    clear_storage struct<word>, 0
    sstore 0, 1
    stop
}
