  bb0:
    v0 = mload 64
    mstore v0, 3
    v1 = add v0, 128
    mstore 64, v1
    v2 = add v0, 32
    calldatacopy v2, 0, 96
    v3 = mload v0
    v4 = gt v3, 1
    jumpi v4, bb2, bb1
  bb1 [cold]:
    revert 0, 36
  bb2:
    ret 7
}

