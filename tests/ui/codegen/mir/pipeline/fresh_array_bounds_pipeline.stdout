    mstore v0, arg0
    v1 = shl arg0, 5
    v2 = add v1, 32
    v3 = add v0, v2
    v7 = heap_floor
    v8 = lt v3, v7
    v9 = select v8, v7, v3
    mstore 64, v9
    v4 = add v0, 32
    calldatacopy v4, 0, v1
    v5 = mload v0
    v6 = gt v5, 1
    jumpi v6, bb2, bb1
  bb1 [cold]:
    revert 0, 36
  bb2:
