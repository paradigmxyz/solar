//@compile-flags: -Zmir-pipeline=default
//@filecheck: --implicit-check-not=internal_frame_addr --implicit-check-not=mload
@module PipelineFrameIndVar
// The promoted frame counter feeds a scaled and offset address, which the
// strength reduction turns into a pointer phi.
// CHECK-LABEL: fn @frame_counter_feeds_affine_address{{[( ]}}
// CHECK: [[START:v[0-9]+]] = add arg1, 32
// CHECK: [[INDEX:v[0-9]+]] = phi [bb0: 0], [bb2: [[NEXT_INDEX:v[0-9]+]]]
// CHECK: [[ADDRESS:v[0-9]+]] = phi [bb0: [[START]]], [bb2: [[NEXT_ADDRESS:v[0-9]+]]]
// CHECK: mstore [[ADDRESS]], [[INDEX]]
// CHECK: [[NEXT_INDEX]] = add [[INDEX]], 1
// CHECK: [[NEXT_ADDRESS]] = add [[ADDRESS]], 32
fn @frame_counter_feeds_affine_address(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v10 = internal_frame_addr 128
    v1 = ptrtoint memptr v10 to i256
    mstore v1, 0
    jump bb1
  bb1:
    v11 = internal_frame_addr 128
    v2 = ptrtoint memptr v11 to i256
    v3 = mload v2
    v4 = lt v3, arg0
    jumpi v4, bb2, bb3
  bb2:
    v5 = mul v3, 32
    v9 = add arg1, v5
    v6 = add v9, 32
    mstore v6, v3
    v7 = add v3, 1
    v12 = internal_frame_addr 128
    v8 = ptrtoint memptr v12 to i256
    mstore v8, v7
    jump bb1
  bb3:
    ret 0
}
