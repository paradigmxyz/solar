@module PingPong
fn @pingpong(arg0: u256, arg1: u256) {
  bb0:
    switch arg1, default bb1, [1 => bb2, 2 => bb3, 3 => bb4]
  bb4:
    v3 = add arg0, 7
    jump bb6
  bb3:
    v2 = add arg0, 7
    jump bb6
  bb2:
    v1 = add arg0, 7
    jump bb5
  bb1:
    v0 = add arg0, 7
    jump bb5
  bb5:
    v4 = add arg0, 7
    jump bb6
  bb6:
    jump bb5
}
