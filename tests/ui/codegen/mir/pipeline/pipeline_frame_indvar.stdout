@module PipelineFrameIndVar
@phase lowered
fn @frame_counter_feeds_affine_address(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v13 = add arg1, 32
    jump bb1
  bb1:
    v12 = phi [bb0: 0], [bb2: v9]
    v14 = phi [bb0: v13], [bb2: v15]
    v5 = lt v12, arg0
    jumpi v5, bb2, bb3
  bb3:
    ret 0
  bb2:
    mstore v14, v12
    v9 = add v12, 1
    v15 = add v14, 32
