//@ compile-flags: -Zmir-pipeline=default -Zprint-after-stage
//@ filecheck:

// CHECK: stage=input checkpoint=mir.input
// CHECK: stage=abi checkpoint=mir.abi
// CHECK: stage=dispatch checkpoint=mir.dispatch
// CHECK: stage=intrinsics-lowered checkpoint=mir.intrinsics-lowered
// CHECK: stage=target-lowered checkpoint=mir.target-lowered
// CHECK: stage=evm-shaped checkpoint=mir.evm-shaped
@module StageCheckpoints

fn @f(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}
