//@ compile-flags: -Zmir-pipeline=default -Zprint-after-stage
//@ filecheck:

// CHECK: stage=input round=1 checkpoint=mir.input
// CHECK: stage=lower-abi round=1 checkpoint=mir.abi
// CHECK: stage=lower-dispatch round=1 checkpoint=mir.dispatch
// CHECK: stage=lower-intrinsics round=1 checkpoint=mir.intrinsics-lowered
// CHECK: stage=lower-target round=1 checkpoint=mir.target-lowered
// CHECK: stage=evm-shape round=1 checkpoint=mir.evm-shaped
@module StageCheckpoints

fn @f(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}
