//@compile-flags: -Zmir-pipeline=default
//@filecheck:
@module PostLoweringCleanup
@phase dispatch

// Lowering field zero produces `add arg0, 0`. The post-lowering scalar
// cleanup must fold it before stack scheduling.
// CHECK-LABEL: fn @field_zero{{[( ]}}
// CHECK-NOT: add arg0, 0
// CHECK: mstore arg0, 7
fn @field_zero(arg0: memorystruct) {
  bb0:
    v1 = memory_object_field_addr memorystruct<2>, arg0, 0
    mstore v1, 7
    stop
}
