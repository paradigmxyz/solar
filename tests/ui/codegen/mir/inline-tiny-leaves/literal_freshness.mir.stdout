    v1 = phi [bb0: arg0], [bb3: v1]
    v2 = phi [bb0: memorybytes 96], [bb3: v5]
    v3 = phi [bb0: 0], [bb3: v3]
    v4 = lt v0, 2
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
