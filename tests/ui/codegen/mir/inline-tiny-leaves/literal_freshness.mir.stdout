  bb0:
    v0 = shl 224, 0x12345678
    v1 = icall @encodedWord
    v2 = alloc memorybytes, exact, uninitialized, infallible, 32 !metadata(preserves_fmp)
    store v2, 0
    v3 = ptrtoint memptr v2 to i256
    v4 = abi_encode [memory_bytes, word, memory_bytes], object, selector v0, args v1, arg0, v2
