  bb4:
    v5 = icall @literal
    v6 = memory_object_len memorybytes, v5
    v7 = eq v6, 1
    v8 = iszero v7
    jumpi v8, bb8, bb7
  bb7:
    v9 = memory_object_len memorybytes, v5
    v10 = lt 0, v9
