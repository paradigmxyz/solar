//@ compile-flags: -Ogas -Zmir-pipeline=inline-tiny-leaves
//@ filecheck:
@module CalldataAndStructLeaves
@types
  struct0: {i256, i256}

// `_msgData()` measures `msg.data` with `calldatasize` and is otherwise slice
// construction, so every caller reads the size itself instead of calling a
// helper whose two-word slice result travels through the multi-return buffer.
// CHECK-LABEL: {{^[ +].*}}fn @first_caller{{[( ]}}
// CHECK: - {{v[0-9]+}} = icall @msg_data
// CHECK: + {{v[0-9]+}} = calldatasize
// CHECK-LABEL: {{^[ +].*}}fn @second_caller{{[( ]}}
// CHECK: - {{v[0-9]+}} = icall @msg_data
// CHECK: + {{v[0-9]+}} = calldatasize
fn @first_caller() -> i256 {
  bb0:
    v0 = icall @msg_data
    v1 = extract_value slice<calldata>, v0, 1
    ret v1
}

fn @second_caller() -> i256 {
  bb0:
    v0 = icall @msg_data
    v1 = extract_value slice<calldata>, v0, 1
    ret v1
}

fn @msg_data() -> slice<calldata> [view] {
  bb0:
    v0 = calldatasize
    v1 = make_calldata_slice ptr<calldata> 0, v0
    ret v1
}

// Insertions into a struct result emit no code, so a leaf computing two words
// stays within the shared leaf budget and inlines at every call.
// CHECK-LABEL: {{^[ +].*}}fn @count_caller{{[( ]}}
// CHECK-NOT: {{^[ +] .*}}icall @counts
// CHECK: + {{v[0-9]+}} = and arg0, 0xffff
// CHECK-LABEL: {{^[ +].*}}fn @counts{{[( ]}}
fn @count_caller(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = icall @counts, arg0
    v1 = icall @counts, arg1
    v2 = extract_value struct0, v0, 0
    v3 = extract_value struct0, v1, 1
    v4 = add v2, v3
    ret v4
}

fn @counts(arg0: i256) -> struct0 [pure] {
  bb0:
    v0 = and arg0, 0xffff
    v1 = shr 16, arg0
    v2 = and v1, 0xffff
    v3 = insert_value struct0, undef struct0, 0, v0
    v4 = insert_value struct0, v3, 1, v2
    ret v4
}
