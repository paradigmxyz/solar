//@compile-flags: -Zmir-pipeline=loop-split
//@filecheck:
@module LookaheadGuards

// A group loop stepping by four tests `i + 1 < n` and `i + 3 < n` in its
// body. It is duplicated into a main loop that runs while `i + 3 < n` and
// the original loop, which the main loop's exit enters with its counters.
// CHECK-LABEL: {{^[ +].*}}fn @group_loop{{[( ]}}
// CHECK: - jump bb1
// CHECK: + jump [[MAIN:bb[0-9]+]]
// CHECK: + [[MAIN]]:
// CHECK: + [[I:v[0-9]+]] = phi [bb0: 0], {{\[}}[[LATCH:bb[0-9]+]]: [[NEXT:v[0-9]+]]]
// CHECK: + [[A:v[0-9]+]] = add [[I]], 3
// CHECK: + [[C:v[0-9]+]] = lt [[A]], arg1
// CHECK: + jumpi [[C]], {{bb[0-9]+}}, bb1
// CHECK: - {{v[0-9]+}} = phi [bb0: 0], [bb5: {{v[0-9]+}}]
// CHECK: + {{v[0-9]+}} = phi {{\[}}[[MAIN]]: [[I]]], [bb5: {{v[0-9]+}}]
// CHECK: + [[LATCH]]:
// CHECK: + [[NEXT]] = add [[I]], 4
// CHECK: + jump [[MAIN]]
fn @group_loop(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v9]
    v1 = phi [bb0: 0], [bb5: v8]
    v2 = lt v0, arg1
    jumpi v2, bb2, bb6
  bb2:
    v3 = add v0, 1
    v4 = lt v3, arg1
    jumpi v4, bb3, bb4
  bb3:
    v5 = add v1, v3
    jump bb4
  bb4:
    v6 = phi [bb2: v1], [bb3: v5]
    v7 = add v0, 3
    v10 = lt v7, arg1
    v8 = add v6, v10
    jump bb5
  bb5:
    v9 = add v0, 4
    jump bb1
  bb6:
    ret v1
}

// Without a lookahead guard there is nothing to fold: the loop is kept.
// CHECK-LABEL: {{^[ +].*}}fn @plain_loop{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @plain_loop(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = add v0, 4
    jump bb1
  bb3:
    ret v1
}

// A body exit whose target reads a loop value outside a phi would lose its
// dominating definition once both copies reach it: the loop is kept.
// CHECK-LABEL: {{^[ +].*}}fn @body_exit_use{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @body_exit_use(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v6]
    v1 = lt v0, arg1
    jumpi v1, bb2, bb4
  bb2:
    v2 = add v0, 1
    v3 = lt v2, arg1
    v4 = add v0, arg0
    jumpi v3, bb3, bb5
  bb3:
    v6 = add v0, 4
    jump bb1
  bb4:
    ret 0
  bb5:
    ret v4
}

// A step that is not a literal cannot bound the counter's travel: the loop
// is kept.
// CHECK-LABEL: {{^[ +].*}}fn @variable_step{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @variable_step(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v5]
    v1 = lt v0, arg1
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    v3 = lt v2, arg1
    v4 = add v0, v3
    v5 = add v0, arg0
    jump bb1
  bb3:
    ret v0
}
