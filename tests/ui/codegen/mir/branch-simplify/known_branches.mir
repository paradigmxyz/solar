//@ compile-flags: -Zmir-pipeline=branch-simplify
//@ filecheck:
//@ run-call: constant(uint256)(uint256) 4 => 5
//@ run-call: same(uint256)(uint256) 4 => 8
//@ run-call: repeated(uint256)(uint256) 0 => 100
//@ run-call: repeated(uint256)(uint256) 4 => 41
//@ run-call: switched(uint256)(uint256) 1 => 111
//@ run-call: switched(uint256)(uint256) 2 => 22
//@ run-call: switched(uint256)(uint256) 3 => 33
//@ run-call: unknown(uint256)(uint256) 0 => 100
//@ run-call: unknown(uint256)(uint256) 4 => 4
// A branch folds when its condition is a constant, when both arms go to one block, or when a
// chain of single predecessors already established the condition. A switch loses the cases that
// go where the default goes. Blocks left without a predecessor disappear. A join reached by
// both arms of an earlier branch learns nothing from it.
@module KnownBranches
@phase lowered

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb6, [0xce4d3874 => bb1, 0x8f5383a4 => bb2, 0x0abef8a2 => bb3, 0x10198fd2 => bb4, 0x71667367 => bb5]
  bb1:
    tail_call @constant
  bb2:
    tail_call @same
  bb3:
    tail_call @repeated
  bb4:
    tail_call @switched
  bb5:
    tail_call @unknown
  bb6:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @constant{{[( ]}}
// CHECK: - jumpi true, bb1, bb2
// CHECK: - mstore 0, 99
// CHECK: + jump bb1
fn @constant() {
  bb0:
    v0 = calldataload 4
    jumpi true, bb1, bb2
  bb1:
    v1 = add v0, 1
    mstore 0, v1
    returndata 0, 32
  bb2:
    mstore 0, 99
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @same{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb1, bb1
// CHECK: + jump bb1
fn @same() {
  bb0:
    v0 = calldataload 4
    v1 = ne v0, 0
    jumpi v1, bb1, bb1
  bb1:
    v2 = add v0, v0
    mstore 0, v2
    returndata 0, 32
}

// The second test of `v1` in bb1 repeats the one that led there from bb0.
// CHECK-LABEL: {{^[ +].*}}fn @repeated{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb2, bb3
// CHECK: - mstore 0, 7
// CHECK: + jump bb2
fn @repeated() {
  bb0:
    v0 = calldataload 4
    v1 = ne v0, 0
    jumpi v1, bb1, bb4
  bb1:
    v2 = sub v0, 1
    jumpi v1, bb2, bb3
  bb2:
    v3 = mul v2, 10
    v4 = add v3, 11
    mstore 0, v4
    returndata 0, 32
  bb3:
    mstore 0, 7
    returndata 0, 32
  bb4:
    mstore 0, 100
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @switched{{[( ]}}
// CHECK: - switch {{v[0-9]+}}, default bb1, [1 => bb1, 2 => bb1]
// CHECK: + jump bb1
// CHECK: - switch {{v[0-9]+}}, default bb3, [1 => bb2, 2 => bb3]
// CHECK: + switch {{v[0-9]+}}, default bb3, [1 => bb2]
fn @switched() {
  bb0:
    v0 = calldataload 4
    switch v0, default bb1, [1 => bb1, 2 => bb1]
  bb1:
    switch v0, default bb3, [1 => bb2, 2 => bb3]
  bb2:
    mstore 0, 111
    returndata 0, 32
  bb3:
    v1 = mul v0, 11
    mstore 0, v1
    returndata 0, 32
}

// The join bb3 is reached from both arms of the first branch, so its branch on the same
// condition stays.
// CHECK-LABEL: {{^[ +].*}}fn @unknown{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb4, bb5
// CHECK-NOT: {{^[-+] +(jump|jumpi|switch)}}
fn @unknown() {
  bb0:
    v0 = calldataload 4
    v1 = ne v0, 0
    jumpi v1, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    jumpi v1, bb4, bb5
  bb4:
    mstore 0, v0
    returndata 0, 32
  bb5:
    mstore 0, 100
    returndata 0, 32
}
