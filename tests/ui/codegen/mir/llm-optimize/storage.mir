//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace --evm-version=cancun
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/storage.script
// Storage, transient storage, logs, and context reads run in the tests, on storage and context
// derived from each input. A candidate must leave every slot the original writes the same, write
// no other slot, and log the same events; storage accesses cost what the slots' states cost.
@module Storage
@phase lowered
fn @main() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = calldataload 32
    v2 = trunc i256 v0 to i160
    icall @credit, v2, v1
    icall @move, v2, v1
    icall @locked, v1
    stop
}

fn @credit(arg0: i160, arg1: i256) {
  bb0:
    v0 = zext i160 arg0 to i256
    mstore 0, v0
    mstore 32, 0
    v1 = keccak256 0, 64
    v2 = sload v1
    v3 = add v2, arg1
    sstore v1, v3
    v4 = sload v1
    mstore 0, v4
    log2 0, 32, 0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef, v0
    ret
}

fn @move(arg0: i160, arg1: i256) {
  bb0:
    v0 = caller
    v1 = zext i160 v0 to i256
    mstore 0, v1
    mstore 32, 0
    v2 = keccak256 0, 64
    v3 = sload v2
    v4 = lt v3, arg1
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v5 = sub v3, arg1
    sstore v2, v5
    v6 = zext i160 arg0 to i256
    mstore 0, v6
    v7 = keccak256 0, 64
    v8 = sload v7
    v9 = add v8, arg1
    sstore v7, v9
    ret
}

fn @locked(arg0: i256) {
  bb0:
    v0 = tload 0
    v1 = ne v0, 0
    jumpi v1, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    tstore 0, 1
    sstore 5, arg0
    tstore 0, 0
    ret
}
