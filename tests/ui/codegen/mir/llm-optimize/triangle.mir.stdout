; === ROOT/tests/ui/codegen/mir/llm-optimize/triangle.sol:Triangle ===
@module Triangle
; function triangle(uint256 n) external pure returns (uint256) [selector 0x50c2698d]
fn @triangle(arg0: i256) -> i256 [selector=0x50c2698d, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sumBelow, arg0
    ret v0
}

; function triangles(uint256 a, uint256 b) external pure returns (uint256) [selector 0x461d6332]
fn @triangles(arg0: i256, arg1: i256) -> i256 [selector=0x461d6332, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sumBelow, arg0
    v1 = icall @sumBelow, arg1
    v2 = add v0, v1
    ret v2
}

; function sumBelow(uint256 n) internal pure returns (uint256 s)
fn @sumBelow(arg0: i256) -> i256 [pure] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v6]
    v2 = phi [bb0: 0], [bb3: v7]
    v3 = trunc i256 v0 to i8
    v4 = zext i8 v3 to i256
    v5 = lt v2, v4
    jumpi v5, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v1
  bb4:                                            ; preds = bb1
    v6 = add v1, v2
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v7 = add v2, 1
    jump bb1
}
