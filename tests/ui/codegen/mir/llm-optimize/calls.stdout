llm-optimize Calls @main: not offered: is the dispatch entry
llm-optimize Calls @increment: offered at 52 gas, 21 bytes
llm-optimize Calls @increment: round 1: nothing cheaper
llm-optimize Calls @twice: offered at 260 gas, 35 bytes
llm-optimize Calls @twice: round 1: accepted at 52 gas, 21 bytes
llm-optimize Calls @twice: round 2: nothing cheaper
llm-optimize Calls @twice: rewritten from 260 gas, 35 bytes to 52 gas, 21 bytes
llm-optimize Calls @forward: offered at 67 gas, 6 bytes
llm-optimize Calls @forward: round 1: rejected at cost: costs 52 gas, 21 bytes, which does not beat 67 gas, 6 bytes
llm-optimize Calls @forward: round 2: nothing cheaper
llm-optimize Calls @gas_left: not offered: uses `gas`
llm-optimize Calls @reads_gas: not offered: calls `@gas_left`, which uses `gas`
llm-optimize Calls @recursive: not offered: is recursive
llm-optimize Calls @code_size: not offered: uses `codesize`
llm-optimize Calls @pair: not offered: returns several values
llm-optimize Calls @uses_pair: not offered: calls `@pair`, which returns several values
llm-optimize Calls @framed: not offered: uses `internal_frame_addr`
- // === ROOT/tests/ui/codegen/mir/llm-optimize/calls.mir (before llm-optimize) ===
+ // === ROOT/tests/ui/codegen/mir/llm-optimize/calls.mir (after llm-optimize) ===
  @module Calls
  @phase lowered
  @types
    struct0: {i256, i256}
  
  fn @main() [entry] {
    bb0:
      v0 = calldataload 0
      v1 = icall @twice, v0
      v2 = icall @forward, v1
      v3 = icall @gas_left, v2
      v4 = icall @reads_gas, v3
      v5 = icall @recursive, v4
      v6 = icall @code_size, v5
      v7 = icall @pair, v6
      v8 = icall @uses_pair, v7
      v9 = icall @framed, v8
      mstore 0, v9
      returndata 0, 32
  }
  
  fn @increment(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 1
      ret v0
  }
  
  fn @twice(arg0: i256) -> i256 {
    bb0:
-     v0 = icall @increment, arg0
-     v1 = icall @increment, v0
-     ret v1
+     v0 = add arg0, 2
+     ret v0
  }
  
  fn @forward(arg0: i256) -> i256 {
    bb0:
      tail_call @increment, arg0
  }
  
  fn @gas_left(arg0: i256) -> i256 {
    bb0:
      v0 = gas
      v1 = add arg0, v0
      ret v1
  }
  
  fn @reads_gas(arg0: i256) -> i256 {
    bb0:
      v0 = icall @gas_left, arg0
      ret v0
  }
  
  fn @recursive(arg0: i256) -> i256 {
    bb0:
      v0 = eq arg0, 0
      jumpi v0, bb1, bb2
    bb2:
      v1 = sub arg0, 1
      v2 = icall @recursive, v1
      ret v2
    bb1:
      ret 0
  }
  
  fn @code_size(arg0: i256) -> i256 {
    bb0:
      v0 = codesize
      v1 = add arg0, v0
      ret v1
  }
  
  fn @pair(arg0: i256) -> struct0 [return_abi=[i256, i256]] {
    bb0:
      v0 = add arg0, 1
      ret arg0, v0
  }
  
  fn @uses_pair(arg0: i256) -> i256 {
    bb0:
      v0 = icall @pair, arg0
      v1 = mload 32
      v2 = mload v1
      v3 = add v0, v2
      ret v3
  }
  
  fn @framed(arg0: i256) -> i256 {
    bb0:
      v0 = internal_frame_addr 64
      v1 = ptrtoint memptr v0 to i256
      mstore v1, arg0
      v2 = mload v1
      ret v2
  }
  
