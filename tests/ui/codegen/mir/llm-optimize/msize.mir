//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/calls.script
// A candidate may touch memory its original does not, which `msize` would observe, so a module
// that reads it offers nothing.
@module MSize
@phase lowered
fn @main() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = icall @twice, v0
    v2 = msize
    v3 = add v1, v2
    mstore 0, v3
    returndata 0, 32
}

fn @twice(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1
    v1 = add v0, 1
    ret v1
}
