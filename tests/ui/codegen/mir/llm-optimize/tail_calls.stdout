llm-optimize TailCalls: offers nothing: the module writes storage; SSTORE gas-prefix safety is unproved
- ; === ROOT/tests/ui/codegen/mir/llm-optimize/tail_calls.mir (before llm-optimize) ===
+ ; === ROOT/tests/ui/codegen/mir/llm-optimize/tail_calls.mir (after llm-optimize) ===
  @module TailCalls
  @phase lowered
  ; creation entry
  fn @constructor() [constructor] {
    bb0:
      v0 = icall @shared, 7
      sstore 0, v0
      stop
  }
  
  ; runtime dispatch entry
  fn @main() [entry, cold] {
    bb0 [cold]:
      v0 = calldataload 0
      v1 = icall @wraps, v0
      v2 = icall @forwards, v1
      v3 = icall @shared, v2
      icall @ends, v3
      invalid
  }
  
  fn @helper(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 1
      ret v0
  }
  
  fn @parity(arg0: i256) -> i256 {
    bb0:
      v0 = and arg0, 1
      v1 = eq v0, 0
      jumpi v1, bb1, bb2
    bb2:                                            ; preds = bb0
      v2 = sub arg0, 1
      v3 = icall @parity, v2
      ret v3
    bb1:                                            ; preds = bb0
      ret arg0
  }
  
  fn @wraps(arg0: i256) -> i256 {
    bb0:
      v0 = mul arg0, 4
      v1 = add v0, 0
      v2 = icall @helper, v1
      ret v2
  }
  
  fn @forwards(arg0: i256) -> i256 {
    bb0:
      v0 = mul arg0, 3
      v1 = icall @parity, v0
      ret v1
  }
  
  fn @shared(arg0: i256) -> i256 {
    bb0:
      v0 = mul arg0, 3
      v1 = icall @helper, v0
      ret v1
  }
  
  fn @ends(arg0: i256) {
    bb0:
      v0 = mul arg0, 4
      v1 = add v0, 0
      tail_call @finish, v1
  }
  
  fn @finish(arg0: i256) {
    bb0:
      mstore 0, arg0
      returndata 0, 32
  }
  
