//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace --evm-version=cancun
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/fuel.script
// The loop takes as many steps as its argument says. Where the tests' first fuel runs out, the
// original runs again with more, which compares a candidate tripling the sum from 8192 on. Where
// even that runs out, what the loop returns is unknown, so the candidate must still be running
// too: closed forms, which return at once, are rejected. At a candidate's own constants, and the
// powers of two its shifts cross, the original runs as long as a call could on chain: candidates
// of `@total` that drop its loop's redundant `mul` but triple the sum from 60001, or from 2^16,
// are compared there; they are cheaper, and passed before.
@module Fuel
@phase lowered
fn @main() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = icall @sum, v0
    v2 = icall @total, v1
    mstore 0, v2
    returndata 0, 32
}

fn @sum(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v4]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v0, 1
    v4 = add v1, v0
    jump bb1
  bb3:
    ret v1
}

fn @total(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v0, 1
    v4 = add v1, v0
    v5 = mul v4, 1
    jump bb1
  bb3:
    ret v1
}
