//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace --evm-version=cancun
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/storage_writes.script
// Persistent writes anywhere in the module exclude every function, including callees whose
// reordered work could make a later SSTORE fail its EIP-2200 gas sentry. Keep the original body.
@module StorageWrites
@phase lowered
fn @main() [entry] {
  bb0:
    icall @rewrite
    icall @rewrite_transient
    stop
}

fn @rewrite() {
  bb0:
    v0 = sload 7
    sstore 7, v0
    ret
}

fn @rewrite_transient() {
  bb0:
    v0 = tload 7
    tstore 7, v0
    ret
}
