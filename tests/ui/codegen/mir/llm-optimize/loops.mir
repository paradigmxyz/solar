//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace --evm-version=cancun
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/loops.script
// Each accepted candidate raises the bar for the next: the second closed form is accepted
// against the first, and the third saves less than the model can tell. The masked bound keeps
// every loop within the tests' fuel, so the closed forms are compared on every input.
@module Loops
@phase lowered
fn @main() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = icall @sum, v0
    mstore 0, v1
    returndata 0, 32
}

fn @sum(arg0: i256) -> i256 {
  bb0:
    v5 = and arg0, 255
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v4]
    v2 = lt v0, v5
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v0, 1
    v4 = add v1, v0
    jump bb1
  bb3:
    ret v1
}
