Candidates for `tail_calls.mir`: each turns the final call into a tail call, which only `wraps`
may do.

--- function wraps
--- candidate
fn @wraps(arg0: i256) -> i256 {
  bb0:
    v0 = mul arg0, 3
    tail_call @helper, v0
}

--- function forwards
--- candidate
fn @forwards(arg0: i256) -> i256 {
  bb0:
    v0 = mul arg0, 3
    tail_call @parity, v0
}

--- function shared
--- candidate
fn @shared(arg0: i256) -> i256 {
  bb0:
    v0 = mul arg0, 3
    tail_call @helper, v0
}
