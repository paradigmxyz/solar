Candidates for `early_ends.mir`: the loop without its redundant `mul`s, taking the sum modulo
0x30000001, and the loop alone.

--- function sum
--- candidate
fn @sum(arg0: i256) -> i256 {
  bb0:
    v0 = shr 8, arg0
    v1 = and v0, 0xffff
    v14 = slt arg0, 0
    v15 = select v14, 0, v1
    jump bb1
  bb1:
    v2 = phi [bb0: 0], [bb2: v5]
    v3 = phi [bb0: 0], [bb2: v6]
    v4 = lt v2, v15
    jumpi v4, bb2, bb3
  bb2:
    v5 = add v2, 1
    v6 = add v3, v2
    jump bb1
  bb3:
    v7 = mod v3, 0x30000001
    ret v7
}
