Candidates for `storage.mir`: for `credit`, one without the event, one that also writes another
slot, and one logging the new balance without reading it back; for `move`, one that reads the
receiver's balance before writing the sender's, which differs when the caller pays itself; for
`locked`, one that keeps the lock and one that drops the lock write no read observes.

--- function credit
--- candidate
fn @credit(arg0: i160, arg1: i256) {
  bb0:
    v0 = zext i160 arg0 to i256
    mstore 0, v0
    mstore 32, 0
    v1 = keccak256 0, 64
    v2 = sload v1
    v3 = add v2, arg1
    sstore v1, v3
    mstore 0, v3
    ret
}
