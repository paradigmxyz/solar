--- function move
--- candidate
fn @move(arg0: i160, arg1: i256) {
  bb0:
    v0 = caller
    v1 = zext i160 v0 to i256
    mstore 0, v1
    mstore 32, 0
    v2 = keccak256 0, 64
    v3 = sload v2
    v4 = lt v3, arg1
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v6 = zext i160 arg0 to i256
    mstore 0, v6
    v7 = keccak256 0, 64
    v8 = sload v7
    v5 = sub v3, arg1
    sstore v2, v5
    v9 = add v8, arg1
    sstore v7, v9
    ret
}

