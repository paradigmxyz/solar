//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace --evm-version=cancun
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/calls.script
// Internal calls and tail calls run in the tests, so a candidate may drop them. Functions the
// tests cannot run, or whose results pass through memory the backend owns, are not offered.
@module Calls
@phase lowered
@types
  struct0: {i256, i256}

fn @main() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = icall @twice, v0
    v2 = icall @forward, v1
    v3 = icall @storage, v2
    v4 = icall @reads_storage, v3
    v5 = icall @recursive, v4
    v6 = icall @environment, v5
    v7 = icall @pair, v6
    v8 = icall @uses_pair, v7
    v9 = icall @framed, v8
    mstore 0, v9
    returndata 0, 32
}

fn @increment(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}

fn @twice(arg0: i256) -> i256 {
  bb0:
    v0 = icall @increment, arg0
    v1 = icall @increment, v0
    ret v1
}

fn @forward(arg0: i256) -> i256 {
  bb0:
    tail_call @increment, arg0
}

fn @storage(arg0: i256) -> i256 {
  bb0:
    v0 = sload arg0
    ret v0
}

fn @reads_storage(arg0: i256) -> i256 {
  bb0:
    v0 = icall @storage, arg0
    ret v0
}

fn @recursive(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    ret 0
  bb2:
    v1 = sub arg0, 1
    v2 = icall @recursive, v1
    ret v2
}

fn @environment(arg0: i256) -> i256 {
  bb0:
    v0 = caller
    v1 = zext i160 v0 to i256
    v2 = add arg0, v1
    ret v2
}

fn @pair(arg0: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    v0 = add arg0, 1
    ret arg0, v0
}

fn @uses_pair(arg0: i256) -> i256 {
  bb0:
    v0 = icall @pair, arg0
    v1 = mload 32
    v2 = mload v1
    v3 = add v0, v2
    ret v3
}

fn @framed(arg0: i256) -> i256 {
  bb0:
    v0 = internal_frame_addr 64
    v1 = ptrtoint memptr v0 to i256
    mstore v1, arg0
    v2 = mload v1
    ret v2
}
