      mstore 32, arg1
      v0 = keccak256 0, 64
      ret v0
  }
  
  fn @aliasing(arg0: i256, arg1: i256) -> i256 {
    bb0:
      mstore arg0, 1
      mstore arg1, 2
      v0 = mload arg0
      ret v0
  }
  
  fn @check(arg0: i256) {
