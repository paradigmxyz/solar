//@ compile-flags: -Zmir-pipeline=llm-optimize -Zllm-optimize=script -Zllm-trace --evm-version=cancun
//@ compile-flags: -Zllm-script=../../tests/ui/codegen/mir/llm-optimize/auxiliary/early_ends.script
// The loop runs up to 0xffff times, none for a negative argument, and does twice the work its sum
// needs, so on most inputs the original runs out of the tests' fuel. Without the redundant `mul`s,
// a candidate ends within the same fuel on many of them; there, the original runs on until it ends,
// and the candidate must return what it does. One that takes the sum modulo 0x30000001 differs from
// 40133 iterations on, which no input at its constants or at the powers of two its shifts cross
// reaches, and passed while it only had to run past a quarter of the fuel. The loop alone is right,
// and cheaper.
@module EarlyEnds
@phase lowered
fn @main() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = icall @sum, v0
    mstore 0, v1
    returndata 0, 32
}

fn @sum(arg0: i256) -> i256 {
  bb0:
    v0 = shr 8, arg0
    v1 = and v0, 0xffff
    v14 = slt arg0, 0
    v15 = select v14, 0, v1
    jump bb1
  bb1:
    v2 = phi [bb0: 0], [bb2: v5]
    v3 = phi [bb0: 0], [bb2: v13]
    v4 = lt v2, v15
    jumpi v4, bb2, bb3
  bb2:
    v5 = add v2, 1
    v6 = add v3, v2
    v7 = mul v6, 1
    v8 = mul v7, 1
    v9 = mul v8, 1
    v10 = mul v9, 1
    v11 = mul v10, 1
    v12 = mul v11, 1
    v13 = mul v12, 1
    jump bb1
  bb3:
    ret v3
}
