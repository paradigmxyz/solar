  fn @sum(arg0: i256) -> i256 {
    bb0:
      jump bb1
    bb1:                                            ; preds = bb0, bb2
      v0 = phi [bb0: 0], [bb2: v3]
      v1 = phi [bb0: 0], [bb2: v4]
      v2 = lt v0, arg0
      jumpi v2, bb2, bb3
    bb3:                                            ; preds = bb1
      ret v1
    bb2:                                            ; preds = bb1
      v3 = add v0, 1
      v4 = add v1, v0
      jump bb1
  }
  
  fn @total(arg0: i256) -> i256 {
    bb0:
      jump bb1
    bb1:                                            ; preds = bb0, bb2
      v0 = phi [bb0: 0], [bb2: v3]
      v1 = phi [bb0: 0], [bb2: v5]
      v2 = lt v0, arg0
