//@compile-flags: -Zmir-pipeline=defer-alloc
//@filecheck:
@module DeferAllocUnreservedFmpVariableSize

// A read of a variable number of bytes from a constant address in low memory may reach the
// free-memory pointer's slot, so it keeps every bump in the module.
// CHECK:   fn @helper{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @helper(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    revert v0, 32
}

fn @observer(arg0: i256) {
  bb0:
    keccak256 0, arg0
    revert 0, arg0
}
