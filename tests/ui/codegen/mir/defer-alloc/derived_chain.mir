//@compile-flags: -Zmir-pipeline=defer-alloc
//@filecheck:
@module DeferAllocDerivedChain

// The CFG visits bb5 through bb1, opposite the block storage order. Discovering
// the full derived-address chain therefore requires more than four scans.
// CHECK:   fn @derived_chain{{.*}}
// CHECK: {{.*}}[[ALLOC:v[0-9]+]] = alloc 32 !metadata(deferred_alloc)
// CHECK: {{.*}}[[BASE:v[0-9]+]] = ptrtoint ptr<memory> [[ALLOC]] to i256
// CHECK: {{.*}}[[LOAD:v[0-9]+]] = mload {{v[0-9]+}}
// CHECK: {{.*}}ret [[LOAD]]
fn @derived_chain() -> i256 [selector=0x01020304] {
  bb0:
    v7 = alloc 32
    v0 = ptrtoint ptr<memory> v7 to i256
    jump bb5
  bb1:
    v5 = add v4, 0
    v6 = mload v5
    ret v6
  bb2:
    v4 = add v3, 0
    jump bb1
  bb3:
    v3 = add v2, 0
    jump bb2
  bb4:
    v2 = add v1, 0
    jump bb3
  bb5:
    v1 = add v0, 0
    jump bb4
}
