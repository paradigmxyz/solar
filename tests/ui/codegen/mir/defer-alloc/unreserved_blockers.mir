//@compile-flags: -Zmir-pipeline=defer-alloc
//@filecheck:
@module DeferAllocUnreservedBlockers

// Each function below has an allocation that could stay unreserved, except for one instruction
// inside its lifetime or one use of its pointer. The allocation must keep its bump.

// A second allocation inside the lifetime would hand out the same memory.
// CHECK:   fn @second_allocation{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @second_allocation(arg0: i256) {
  bb0:
    v0 = alloc arg0
    v1 = alloc arg0
    mstore v0, 1
    mstore v1, 2
    revert v0, 32
}

// ABI encoding stages at the free-memory pointer.
// CHECK:   fn @abi_encode_inside{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @abi_encode_inside(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    v1 = abi_encode [word], scratch, args arg0
    mstore v0, 2
    revert v0, 32
}

// A call that stages its input and output at the pointer overwrites the region.
// A call whose output range is not addressed from the allocation overwrites the region.
// CHECK:   fn @call_output_elsewhere{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @call_output_elsewhere(arg0: i256) {
  bb0:
    v0 = alloc arg0
    v2 = staticcall 1000, 0xbeef, 0, 0, 4096, 32
    mstore v0, 1
    revert v0, 32
}

// A call that stages its input and output at the pointer overwrites the region.
// CHECK:   fn @external_call_at_pointer{{.*}}
// CHECK-NOT: + {{.*}}v{{[0-9]+}} = fmp
fn @external_call_at_pointer(arg0: i256) {
  bb0:
    v0 = alloc arg0
    v1 = fmp
    v2 = staticcall 1000, 0xbeef, v1, 4, v1, 32
    mstore v0, 1
    revert v0, 32
}

// Assembly that reads through a variable address may read the free-memory pointer's slot.
// CHECK:   fn @variable_address_read{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @variable_address_read(arg0: i256, arg1: i256) {
  bb0:
    v0 = alloc arg0
    v1 = mload arg1
    mstore v0, v1
    revert v0, 32
}

// Assembly that writes an absolute address can overwrite the region.
// CHECK:   fn @assembly_writes_absolute{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @assembly_writes_absolute(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    mstore 4096, 2
    revert v0, 32
}

// An allocation returned to an internal caller outlives the function.
// CHECK:   fn @returned_to_caller{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @returned_to_caller(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    ret v0
}

// A pointer stored into another object outlives the function too.
// CHECK:   fn @stored_in_object{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @stored_in_object(arg0: ptr<memory>, arg1: i256) {
  bb0:
    v0 = alloc arg1
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore arg0, v1
    ret
}

// A pointer stored into a scratch word outlives the function too.
// CHECK:   fn @stored_in_scratch{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @stored_in_scratch(arg0: i256) {
  bb0:
    v0 = alloc arg0
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore 0, v1
    ret
}

// A pointer merged by a phi can reach a use after another allocation runs.
// CHECK:   fn @phi_escape{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @phi_escape(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = alloc arg0
    jumpi arg1, bb1, bb2
  bb1:
    v1 = alloc arg0
    jump bb2
  bb2:
    v2 = phi [bb0: v0], [bb1: v1]
    v3 = mload v2
    ret v3
}

// A callee that allocates moves the free-memory pointer under the region.
// CHECK:   fn @callee_allocates{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @callee_allocates(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    icall @allocates
    v1 = mload v0
    mstore v0, v1
    revert v0, 32
}

fn @allocates() {
  bb0:
    v0 = alloc 32 !metadata(preserves_fmp)
    mstore v0, 1
    ret
}

// A callee that writes an absolute address can overwrite the region.
// CHECK:   fn @callee_writes_absolute{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @callee_writes_absolute(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    icall @writes_absolute
    revert v0, 32
}

fn @writes_absolute() {
  bb0:
    mstore 4096, 1
    ret
}

// A callee that writes through a pointer the allocation does not address can too.
// CHECK:   fn @callee_writes_argument{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @callee_writes_argument(arg0: i256, arg1: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    icall @writes_argument, arg1
    revert v0, 32
}

fn @writes_argument(arg0: i256) {
  bb0:
    mstore arg0, 1
    ret
}

// Each blocker below is the only one in its function. A second allocation inside the lifetime
// hands out the same memory.
// CHECK:   fn @allocation_only{{.*}}
// CHECK-NOT: + {{.*}}v0 = fmp
fn @allocation_only(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    v1 = alloc arg0 !metadata(preserves_fmp)
    revert v0, 32
}

// A read of the free-memory pointer inside the lifetime can derive a region from it.
// CHECK:   fn @fmp_only{{.*}}
// CHECK-NOT: + {{.*}}v0 = fmp
fn @fmp_only(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    v1 = fmp
    revert v0, 32
}

// So can a read of the memory size, which changes with the region.
// CHECK:   fn @msize_only{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @msize_only(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    v1 = msize
    revert v0, 32
}

// An allocation marked as a source-visible advance keeps its bump.
// CHECK:   fn @preserves_fmp{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @preserves_fmp(arg0: i256) {
  bb0:
    v0 = alloc arg0 !metadata(preserves_fmp)
    mstore v0, 1
    revert v0, 32
}

// A block between the allocation and its use is part of the lifetime.
// CHECK:   fn @blocker_in_middle_block{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @blocker_in_middle_block(arg0: i256) {
  bb0:
    v0 = alloc arg0
    jump bb1
  bb1:
    mstore 4096, 1
    jump bb2
  bb2:
    revert v0, 32
}

// So is the rest of a block that has a use, when another use follows in a later block.
// CHECK:   fn @blocker_between_uses{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @blocker_between_uses(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    mstore 4096, 1
    jump bb1
  bb1:
    revert v0, 32
}

// The pointer cannot also be the size of the terminator's range.
// CHECK:   fn @pointer_as_size{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @pointer_as_size(arg0: i256) {
  bb0:
    v0 = alloc arg0
    v1 = ptrtoint ptr<memory> v0 to i256
    revert v1, v1
}

// A write of the free-memory pointer inside the lifetime moves the region.
// CHECK:   fn @set_fmp_inside{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @set_fmp_inside(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    set_fmp v0
    revert v0, 32
}

// A write on a path that returns to the allocation's block, after the last use in it, still
// follows an earlier use of the pointer.
// CHECK:   fn @blocker_around_back_edge{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @blocker_around_back_edge(arg0: i256, arg1: i1) {
  bb0:
    v0 = alloc arg0
    jump bb1
  bb1:
    v1 = mload v0
    mstore 4096, v1
    jumpi arg1, bb1, bb2
  bb2:
    stop
}

// A pointer returned to the caller from a loop iteration stays a phi use.
// CHECK:   fn @loop_carried{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @loop_carried(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb1: v2]
    v0 = alloc arg0
    v2 = ptrtoint ptr<memory> v0 to i256
    jumpi true, bb1, bb2
  bb2:
    v4 = mload v3
    ret v4
}
