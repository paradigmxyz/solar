- // === ROOT/tests/ui/codegen/mir/defer-alloc/unreserved_fmp_value.mir (before defer-alloc) ===
+ // === ROOT/tests/ui/codegen/mir/defer-alloc/unreserved_fmp_value.mir (after defer-alloc) ===
  @module DeferAllocUnreservedFmpValue
  fn @helper(arg0: i256) -> i256 {
    bb0:
      v0 = fmp
      v1 = ptrtoint ptr<memory> v0 to i256
      v2 = alloc arg0
      mstore v2, 1
      v3 = fmp
      v4 = ptrtoint ptr<memory> v3 to i256
      v5 = sub v4, v1
      ret v5
  }
  
