//@compile-flags: -Zmir-pipeline=defer-alloc
//@filecheck:
@module DeferAllocUnreservedFmpVariableAddress

// A read through an address the compiler cannot place on the heap may read the free-memory
// pointer's slot, so it keeps every bump in the module.
// CHECK:   fn @helper{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @helper(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    revert v0, 32
}

fn @observer(arg0: i256) -> i256 {
  bb0:
    v0 = mload arg0
    ret v0
}
