//@compile-flags: -Zmir-pipeline=defer-alloc
//@filecheck:
@module DeferAllocUnreservedFmpRead

// Assembly can read the free-memory pointer anywhere in the contract, as `mload(0x40)` before and
// after a call to `helper`, and see the bump of its allocation. One such read keeps every bump.
// CHECK:   fn @helper{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @helper(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    revert v0, 32
}

fn @observer() -> i256 {
  bb0:
    v0 = mload 64
    ret v0
}
