//@compile-flags: -Zmir-pipeline=defer-alloc
//@filecheck:
@module DeferAllocUnreservedFmpRangeRead

// A sized range read that covers the free-memory pointer's slot observes it too, here as the
// data of a `revert`.
// CHECK:   fn @helper{{.*}}
// CHECK-NOT: + {{.*}}fmp
fn @helper(arg0: i256) {
  bb0:
    v0 = alloc arg0
    mstore v0, 1
    revert v0, 32
}

fn @observer() {
  bb0:
    revert 64, 32
}
