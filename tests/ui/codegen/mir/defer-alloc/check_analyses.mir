//@ revisions: off on
//@[off] compile-flags: -Zmir-pipeline=defer-alloc,defer-alloc
//@[off] filecheck: --check-prefixes=CHECK,OFF
//@[on] compile-flags: -Zmir-pipeline=defer-alloc,defer-alloc -Zcheck-analyses=true
//@[on] filecheck: --check-prefixes=CHECK,ON
@module DeferAllocCheckAnalyses

// With `-Zcheck-analyses`, the block of a deferred allocation reads a guard word of the entry's
// local region before it, records it zero and sets it: the block runs at most once per call. The
// entry block records the heap floor above the guard. The second run keeps the first guard. Without the flag the pass only marks the allocation.
// CHECK-LABEL: {{^[ +].*}}fn @deferred{{[( ]}}
// ON: + [[FLOOR:v[0-9]+]] = heap_floor
// ON-NEXT: + assume ule defer_alloc, 160, [[FLOOR]]
// ON: + [[SEEN:v[0-9]+]] = mload 128
// ON-NEXT: + mstore 128, 1
// CHECK: alloc 32 !metadata(deferred_alloc)
// ON: + assume eq defer_alloc, [[SEEN]], 0
// OFF-NOT: mload 128
// CHECK: (after defer-alloc)
// CHECK-NOT: {{^[+-] +[^ ;]}}
fn @deferred() -> i256 [selector=0x01020304] {
  bb0:
    v1 = calldataload 4
    v4 = ne v1, 0
    jumpi v4, bb1, bb2
  bb1:
    v2 = alloc 32
    v0 = ptrtoint ptr<memory> v2 to i256
    mstore v0, 7
    v3 = mload v0
    ret v3
  bb2:
    ret 0
}
