//@compile-flags: -Zmir-pipeline=cse
//@filecheck:
@module CseGlobalLoads
@immutables
  value: uint256

// CHECK-LABEL: {{^[ +].*}}fn @dominating_mload{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload 0
// CHECK: + ret 22
// CHECK: + ret 11
fn @dominating_mload(arg0: i1) -> i256 {
  bb0:
    mstore 0, 11
    v1 = mload 0
    jumpi arg0, bb1, bb2
  bb1:
    v2 = mload 0
    ret v2
  bb2:
    mstore 0, 22
    v3 = mload 0
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @dominating_sload{{[( ]}}
// CHECK: - {{v[0-9]+}} = sload 0
// CHECK: + ret 7
// CHECK: - {{v[0-9]+}} = sload 0
// CHECK: + ret {{v[0-9]+}}
fn @dominating_sload(arg0: i1) -> i256 {
  bb0:
    v1 = sload 0
    jumpi arg0, bb1, bb2
  bb1:
    v2 = sload 0
    ret v2
  bb2:
    sstore 0, 7
    v3 = sload 0
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @dominating_loadimmutable{{[( ]}}
// CHECK: {{^[ +].*}}[[LOAD:v[0-9]+]] = loadimmutable value
// CHECK: {{^[ +].*}}storeimmutable value, 7
// CHECK-NEXT: {{^[ +].*}}{{v[0-9]+}} = loadimmutable value
// CHECK: - {{v[0-9]+}} = loadimmutable value
// CHECK: + ret [[LOAD]]
fn @dominating_loadimmutable(arg0: i1) -> i256 {
  bb0:
    v1 = loadimmutable value
    jumpi arg0, bb1, bb2
  bb1:
    v2 = loadimmutable value
    ret v2
  bb2:
    storeimmutable value, 7
    v3 = loadimmutable value
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_phi_immutable_loads_before_branch_stores{{[( ]}}
// CHECK: {{^[ +].*}}[[RIGHT:v[0-9]+]] = loadimmutable value
// CHECK-NEXT: {{^[ +].*}}storeimmutable value, 2
// CHECK: {{^[ +].*}}[[LEFT:v[0-9]+]] = loadimmutable value
// CHECK-NEXT: {{^[ +].*}}storeimmutable value, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = phi [bb1: [[LEFT]]], [bb2: [[RIGHT]]]
fn @keep_phi_immutable_loads_before_branch_stores(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v1 = loadimmutable value
    storeimmutable value, 1
    jump bb3
  bb2:
    v2 = loadimmutable value
    storeimmutable value, 2
    jump bb3
  bb3:
    v3 = phi [bb1: v1], [bb2: v2]
    ret v3
}

// A word loaded from a constant address is cheaper to load again in a dominated block than to
// carry there once nothing else reads it.
// CHECK-LABEL: {{^[ +].*}}fn @reload_constant_word_in_dominated_block{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK: {{^ *}}}
fn @reload_constant_word_in_dominated_block(arg0: i1) -> i256 {
  bb0:
    v0 = mload 16
    v1 = add v0, 1
    jumpi arg0, bb1, bb2
  bb1:
    v2 = mload 16
    v3 = add v2, v1
    ret v3
  bb2:
    ret v1
}

// Within one block the word is still merged: carrying it there costs no more than loading it again.
// CHECK-LABEL: {{^[ +].*}}fn @merge_constant_word_in_one_block{{[( ]}}
// CHECK: {{^-}}{{.*}} = mload 16
fn @merge_constant_word_in_one_block() -> i256 {
  bb0:
    v0 = mload 16
    v1 = add v0, 1
    v2 = mload 16
    v3 = add v2, v1
    ret v3
}

// A stored word is forwarded even when it was loaded from another constant address, which can leave
// the store dead.
// CHECK-LABEL: {{^[ +].*}}fn @forward_stored_word_to_dominated_block{{[( ]}}
// CHECK: {{^-}}{{.*}} = mload 16
fn @forward_stored_word_to_dominated_block(arg0: i1) -> i256 {
  bb0:
    v0 = mload 32
    mstore 16, v0
    jumpi arg0, bb1, bb2
  bb1:
    v2 = mload 16
    ret v2
  bb2:
    ret 0
}
