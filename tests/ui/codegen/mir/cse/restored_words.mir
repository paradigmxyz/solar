//@ compile-flags: -Zmir-pipeline=cse
//@ filecheck:
@module RestoredWords

// CHECK-LABEL: fn @reuse
// CHECK: {{^ +}}v0 = icall @restore_pair
// CHECK: - {{ *}}v1 = icall @restore_pair
// CHECK: + {{ *}}v2 = add v0, v0
fn @reuse(arg0: memptr, arg1: u256) -> u256 {
  bb0:
    v0 = icall @restore_pair, 1, arg0, arg1
    v1 = icall @restore_pair, 1, arg0, arg1
    v2 = add v0, v1
    ret v2
}
fn @restore_pair(arg0: memptr, arg1: u256) -> u256 {
  bb0:
    v0 = add arg0, 32
    v1 = mload arg0
    v2 = mload v0
    mstore arg0, 17
    mstore v0, 23
    v3 = add arg0, arg1
    v4 = mload v3
    mstore v0, v2
    mstore arg0, v1
    ret v4
}

// The second word is dirty on one return path.
// CHECK-LABEL: fn @dirty_path
// CHECK: {{^ +}}v0 = icall @dirty_pair
// CHECK: {{^ +}}v1 = icall @dirty_pair
fn @dirty_path(arg0: memptr, arg1: bool) -> u256 {
  bb0:
    v0 = icall @dirty_pair, 1, arg0, arg1
    v1 = icall @dirty_pair, 1, arg0, arg1
    v2 = add v0, v1
    ret v2
}
fn @dirty_pair(arg0: memptr, arg1: bool) -> u256 {
  bb0:
    v0 = add arg0, 32
    v1 = mload arg0
    v2 = mload v0
    mstore arg0, 17
    mstore v0, 23
    mstore arg0, v1
    jumpi arg1, bb1, bb2
  bb1:
    mstore v0, v2
    jump bb2
  bb2:
    ret v2
}

// Saving overlapping words after the first write cannot prove restoration.
// CHECK-LABEL: fn @overlapping
// CHECK: {{^ +}}v0 = icall @overlap_pair
// CHECK: {{^ +}}v1 = icall @overlap_pair
fn @overlapping(arg0: memptr) -> u256 {
  bb0:
    v0 = icall @overlap_pair, 1, arg0
    v1 = icall @overlap_pair, 1, arg0
    v2 = add v0, v1
    ret v2
}
fn @overlap_pair(arg0: memptr) -> u256 {
  bb0:
    v0 = add arg0, 16
    v1 = mload arg0
    mstore arg0, 17
    v2 = mload v0
    mstore v0, 23
    mstore arg0, v1
    mstore v0, v2
    ret v2
}

// Distinct SSA arguments are not evidence that their word ranges are disjoint.
// CHECK-LABEL: fn @unknown_alias
// CHECK: {{^ +}}v0 = icall @unknown_pair
// CHECK: {{^ +}}v1 = icall @unknown_pair
fn @unknown_alias(arg0: memptr, arg1: memptr) -> u256 {
  bb0:
    v0 = icall @unknown_pair, 1, arg0, arg1
    v1 = icall @unknown_pair, 1, arg0, arg1
    v2 = add v0, v1
    ret v2
}
fn @unknown_pair(arg0: memptr, arg1: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    mstore arg0, 17
    v1 = mload arg1
    mstore arg1, 23
    mstore arg0, v0
    mstore arg1, v1
    ret v1
}
