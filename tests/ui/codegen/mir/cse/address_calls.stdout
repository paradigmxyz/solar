- // === ROOT/tests/ui/codegen/mir/cse/address_calls.mir (before cse) ===
+ // === ROOT/tests/ui/codegen/mir/cse/address_calls.mir (after cse) ===
  @module AddressCallEffects
  fn @calls(arg0: i256, arg1: memorybytes) -> i256 {
    bb0:
      v0 = trunc i256 arg0 to i160
      v1 = sload 0
      v2 = balance arg0
      v3 = address_staticcall v0, arg1
      v4 = sload 0
      v5 = balance arg0
      v6 = address_call v0, arg1
      v7 = sload 0
      v8 = balance arg0
      v9 = address_delegatecall v0, arg1
      v10 = sload 0
      v11 = balance arg0
      v12 = add v1, v2
      v13 = add v4, v5
      v14 = add v7, v8
      v15 = add v10, v11
      v16 = add v12, v13
      v17 = add v14, v15
      v18 = add v16, v17
      ret v18
  }
  
  fn @capture(arg0: i256, arg1: memorybytes) -> i256 {
    bb0:
      v0 = trunc i256 arg0 to i160
      v1 = address_call v0, arg1
      v2 = icall returndata_bytes<>
      v3 = address_call v0, arg1
      v4 = icall returndata_bytes<>
      v5 = memory_object_len memorybytes, v2
      v6 = memory_object_len memorybytes, v4
      v7 = add v5, v6
      ret v7
  }
  
