//@compile-flags: -Zmir-pipeline=cse
//@filecheck:
// A storage alias names its base slot like an operand, so replacing the base
// with an equal value renames it in the alias instead of leaving a deleted value.
@module CseStorageAliasBase
// CHECK-LABEL: {{^[ +].*}}fn @store{{[( ]}}
// CHECK: {{^ +}}[[SUM:v[0-9]+]] = add arg0, arg1
// CHECK: + sstore {{v[0-9]+}}, arg2 !metadata(storage=offset([[SUM]], 1))
fn @store(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    v1 = add arg0, arg1
    v2 = add arg0, arg1
    v3 = add v2, 1
    sstore v3, arg2 !metadata(storage=offset(v2, 1))
    v4 = add v1, v3
    sstore v1, v4
    stop
}
