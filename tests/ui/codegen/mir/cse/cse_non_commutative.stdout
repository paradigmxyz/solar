- // === ROOT/tests/ui/codegen/mir/cse/cse_non_commutative.mir (before cse) ===
+ // === ROOT/tests/ui/codegen/mir/cse/cse_non_commutative.mir (after cse) ===
  @module CseNonCommutative
  fn @non_commutative(arg0: word, arg1: word) -> word {
    bb0:
      v0 = sub arg0, arg1
      v1 = sub arg1, arg0
      v2 = add v0, v1
      ret v2
  }
  
