//@compile-flags: -Zmir-pipeline=cse
//@filecheck:
@module CseICallSummaries
// CHECK-LABEL: {{^[ +].*}}fn @keep_load_across_reader{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload arg0
// CHECK: + {{v[0-9]+}} = add [[LOAD:v[0-9]+]], [[LOAD]]
fn @keep_load_across_reader(arg0: memptr) -> u256 {
  bb0:
    v1 = mload arg0
    v2 = icall fn3, arg0
    v3 = mload arg0
    v4 = add v1, v3
    v5 = add v4, v2
    ret v5
}

// CHECK-LABEL: {{^[ +].*}}fn @invalidate_load_across_writer{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload arg0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload arg0
fn @invalidate_load_across_writer(arg0: memptr) -> u256 {
  bb0:
    v1 = mload arg0
    icall fn4, arg0
    v2 = mload arg0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_load_across_allocation_fmp_update{{[( ]}}
// CHECK: {{^[ +].*}}[[FIRST:v[0-9]+]] = mload [[OBJECT:v[0-9]+]]
// CHECK: {{^[ +].*}}[[SECOND:v[0-9]+]] = mload [[OBJECT]]
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add [[FIRST]], [[SECOND]]
fn @keep_load_across_allocation_fmp_update() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = mload v0
    icall fn5
    v2 = alloc raw, exact, uninitialized, infallible, 32
    mstore v2, 7
    v3 = mload v0
    v4 = add v1, v3
    ret v4
}

fn @reader(arg0: memptr) -> u256 {
  bb0:
    v1 = mload arg0
    ret v1
}

fn @writer(arg0: memptr) {
  bb0:
    mstore arg0, 9
    ret
}

fn @noop() {
  bb0:
    ret
}

// CHECK-LABEL: {{^[ +].*}}fn @disjoint_storage{{[( ]}}
// CHECK: - {{v[0-9]+}} = sload 0
// CHECK: + {{v[0-9]+}} = add [[DISJOINT_STORAGE:v[0-9]+]], [[DISJOINT_STORAGE]]
fn @disjoint_storage(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @write_slot_one
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @overlapping_storage{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
fn @overlapping_storage(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @write_slot_zero
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_storage{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
fn @unknown_storage(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @write_unknown, arg0
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @transitive_storage{{[( ]}}
// CHECK: - {{v[0-9]+}} = sload 0
// CHECK: + {{v[0-9]+}} = add [[TRANSITIVE_STORAGE:v[0-9]+]], [[TRANSITIVE_STORAGE]]
fn @transitive_storage(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @tail_writer
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @recursive_storage{{[( ]}}
// CHECK: - {{v[0-9]+}} = sload 0
// CHECK: + {{v[0-9]+}} = add [[RECURSIVE_STORAGE:v[0-9]+]], [[RECURSIVE_STORAGE]]
fn @recursive_storage(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @recursive_writer, arg0
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @disjoint_transient{{[( ]}}
// CHECK: - {{v[0-9]+}} = tload 0
// CHECK: + {{v[0-9]+}} = add [[DISJOINT_TRANSIENT:v[0-9]+]], [[DISJOINT_TRANSIENT]]
fn @disjoint_transient(arg0: u256) -> u256 {
  bb0:
    v1 = tload 0
    icall @write_transient_one
    v2 = tload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @overlapping_transient{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = tload 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = tload 0
fn @overlapping_transient(arg0: u256) -> u256 {
  bb0:
    v1 = tload 0
    icall @write_transient_zero
    v2 = tload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @separate_spaces{{[( ]}}
// CHECK: - {{v[0-9]+}} = sload 0
// CHECK: + {{v[0-9]+}} = add [[SEPARATE_SPACES:v[0-9]+]], [[SEPARATE_SPACES]]
fn @separate_spaces(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @write_transient_zero
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @wide_storage{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload 0
fn @wide_storage(arg0: u256) -> u256 {
  bb0:
    v1 = sload 0
    icall @write_many_slots
    v2 = sload 0
    v3 = add v1, v2
    ret v3
}

fn @write_slot_one() {
  bb0:
    sstore 1, 7
    ret
}

fn @write_slot_zero() {
  bb0:
    sstore 0, 7
    ret
}

fn @write_unknown(arg0: u256) {
  bb0:
    sstore arg0, 7
    ret
}

fn @tail_writer() {
  bb0:
    tail_call @write_slot_one
}

fn @recursive_writer(arg0: u256) {
  bb0:
    sstore 1, 7
    jumpi arg0, bb1, bb2
  bb1:
    icall @recursive_writer, 0
    ret
  bb2:
    ret
}

fn @write_transient_one() {
  bb0:
    tstore 1, 7
    ret
}

fn @write_transient_zero() {
  bb0:
    tstore 0, 7
    ret
}

fn @write_many_slots() {
  bb0:
    sstore 1, 7
    sstore 2, 7
    sstore 3, 7
    sstore 4, 7
    sstore 5, 7
    sstore 6, 7
    sstore 7, 7
    sstore 8, 7
    sstore 9, 7
    sstore 10, 7
    sstore 11, 7
    sstore 12, 7
    sstore 13, 7
    sstore 14, 7
    sstore 15, 7
    sstore 16, 7
    sstore 17, 7
    sstore 18, 7
    sstore 19, 7
    sstore 20, 7
    sstore 21, 7
    sstore 22, 7
    sstore 23, 7
    sstore 24, 7
    sstore 25, 7
    sstore 26, 7
    sstore 27, 7
    sstore 28, 7
    sstore 29, 7
    sstore 30, 7
    sstore 31, 7
    sstore 32, 7
    sstore 33, 7
    ret
}

// CHECK-LABEL: {{^[ +].*}}fn @disjoint_parameter_range{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload arg0
// CHECK: + {{v[0-9]+}} = add [[BEFORE:v[0-9]+]], [[BEFORE]]
fn @disjoint_parameter_range(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    icall @write_next_word, arg0
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @overlapping_parameter_range{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload arg0
fn @overlapping_parameter_range(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    v1 = add arg0, 1
    icall @writer, v1
    v2 = mload arg0
    v3 = add v0, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @distinct_parameters_may_alias{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload arg0
fn @distinct_parameters_may_alias(arg0: memptr, arg1: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    icall @writer, arg1
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @transitive_memory_range{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload arg0
// CHECK: + {{v[0-9]+}} = add [[TRANSITIVE:v[0-9]+]], [[TRANSITIVE]]
fn @transitive_memory_range(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    icall @write_second_word, arg0
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @tail_memory_range{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload arg0
// CHECK: + {{v[0-9]+}} = add [[TAIL:v[0-9]+]], [[TAIL]]
fn @tail_memory_range(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    icall @tail_write_next_word, arg0
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @bounded_allocation_range{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload
// CHECK: + {{v[0-9]+}} = add [[BOUNDED:v[0-9]+]], [[BOUNDED]]
fn @bounded_allocation_range() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 64
    v1 = alloc raw, exact, uninitialized, infallible, 32
    v2 = mload v1
    icall @write_next_word, v0
    v3 = mload v1
    v4 = add v2, v3
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @out_of_bounds_allocation_range{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload
fn @out_of_bounds_allocation_range() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = alloc raw, exact, uninitialized, infallible, 32
    v2 = mload v1
    icall @write_next_word, v0
    v3 = mload v1
    v4 = add v2, v3
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_memory_size{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload arg0
fn @unknown_memory_size(arg0: memptr, arg1: memptr, arg2: u256) -> u256 {
  bb0:
    v0 = mload arg0
    icall @copy_dynamic, arg1, arg0, arg2
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @absolute_memory_range{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload 64
// CHECK: + {{v[0-9]+}} = add [[ABSOLUTE:v[0-9]+]], [[ABSOLUTE]]
fn @absolute_memory_range() -> u256 {
  bb0:
    v0 = mload 64
    icall @write_absolute_word
    v1 = mload 64
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @recursive_memory_widening{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload
fn @recursive_memory_widening(arg0: memptr, arg1: u256) -> u256 {
  bb0:
    v0 = add arg0, 4096
    v1 = mload v0
    icall @write_recursive_words, arg0, arg1
    v2 = mload v0
    v3 = add v1, v2
    ret v3
}

fn @write_next_word(arg0: memptr) {
  bb0:
    v0 = add arg0, 32
    mstore v0, 7
    ret
}

fn @write_second_word(arg0: memptr) {
  bb0:
    v0 = add arg0, 32
    icall @write_next_word, v0
    ret
}

fn @tail_write_next_word(arg0: memptr) {
  bb0:
    v0 = add arg0, 32
    tail_call @writer, v0
}

fn @copy_dynamic(arg0: memptr, arg1: memptr, arg2: u256) {
  bb0:
    mcopy arg0, arg1, arg2
    ret
}

fn @write_absolute_word() {
  bb0:
    mstore 0, 7
    ret
}

fn @write_recursive_words(arg0: memptr, arg1: u256) {
  bb0:
    mstore arg0, 7
    jumpi arg1, bb1, bb2
  bb1:
    v0 = add arg0, 32
    v1 = sub arg1, 1
    icall @write_recursive_words, v0, v1
    ret
  bb2:
    ret
}

// CHECK-LABEL: {{^[ +].*}}fn @transitive_memory_overlap{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload
fn @transitive_memory_overlap(arg0: memptr) -> u256 {
  bb0:
    v0 = add arg0, 64
    v1 = mload v0
    icall @write_second_word, arg0
    v2 = mload v0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @tail_memory_overlap{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload
fn @tail_memory_overlap(arg0: memptr) -> u256 {
  bb0:
    v0 = add arg0, 32
    v1 = mload v0
    icall @tail_write_next_word, arg0
    v2 = mload v0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @absolute_memory_overlap{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload 16
fn @absolute_memory_overlap() -> u256 {
  bb0:
    v0 = mload 16
    icall @write_absolute_word
    v1 = mload 16
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_indirect_pointer{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload arg0
fn @unknown_indirect_pointer(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    icall @write_indirect
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

fn @write_indirect() {
  bb0:
    v0 = mload 0
    mstore v0, 7
    ret
}

// CHECK-LABEL: {{^[ +].*}}fn @out_of_bounds_caller_read{{[( ]}}
// CHECK-COUNT-2: {{^[ +].*}}{{v[0-9]+}} = mload
fn @out_of_bounds_caller_read() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = alloc raw, exact, uninitialized, infallible, 32
    v2 = add v0, 32
    v3 = mload v2
    icall @writer, v1
    v4 = mload v2
    v5 = add v3, v4
    ret v5
}
