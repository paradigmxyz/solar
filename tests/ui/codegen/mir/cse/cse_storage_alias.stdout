      ret v3
  }
  
  fn @reuse_tload_after_disjoint_store(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = tload arg0
      v1 = add arg0, 1
      tstore v1, arg1
-     v2 = tload arg0
-     v3 = add v0, v2
+     v3 = add v0, v0
      ret v3
  }
  
  fn @keep_sload_after_external_call(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = sload arg0
