//@compile-flags: -Zmir-pipeline=cse
@module FrameConstantPhi

// The phi inputs read `calldatasize` in different blocks, so they share a key, but the
// backedge input uses a read that sits after the phi. Phi sinking must clone the entry
// input, whose operands exist where the sunk expression goes, in either incoming order.
fn @backedge_first(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = calldatasize
    v1 = xor v0, arg0
    jump bb1
  bb1:
    v2 = phi [bb2: v4], [bb0: v1]
    v3 = calldatasize
    jumpi arg1, bb2, bb3
  bb2:
    v4 = xor v3, arg0
    jump bb1
  bb3:
    ret v2
}

fn @entry_first(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = calldatasize
    v1 = xor v0, arg0
    jump bb1
  bb1:
    v2 = phi [bb0: v1], [bb2: v4]
    v3 = calldatasize
    jumpi arg1, bb2, bb3
  bb2:
    v4 = xor v3, arg0
    jump bb1
  bb3:
    ret v2
}
