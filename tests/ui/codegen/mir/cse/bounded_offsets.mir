//@ compile-flags: -Zmir-pipeline=cse
//@ filecheck:
@module BoundedOffsets

// A copy of `len` bytes that ran before bounds `len` below `2^64`, so the zero tail stored at
// `p + 32 + len` starts past the length word and cannot wrap onto it.
// CHECK-LABEL: fn @copied_length
// CHECK: calldatacopy
// CHECK: memory_zero
// CHECK: -{{ +}}{{v[0-9]+}} = mload
// CHECK: +{{ +}}ret arg0
fn @copied_length(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, arg0
    v4 = add v3, 32
    calldatacopy v4, arg1, arg0
    v5 = add v4, arg0
    v6 = inttoptr i256 v5 to ptr<memory>
    memory_zero v6, 1
    v7 = mload v3
    ret v7
}

// Without that copy `len` may be any word, and the tail may wrap onto the length word.
// CHECK-LABEL: fn @uncopied_length
// CHECK-NOT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: ret
fn @uncopied_length(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, arg0
    v4 = add v3, 32
    v5 = add v4, arg0
    v6 = inttoptr i256 v5 to ptr<memory>
    memory_zero v6, 1
    v7 = mload v3
    ret v7
}

// A copy of another length proves nothing about `len`.
// CHECK-LABEL: fn @copied_other_length
// CHECK-NOT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: ret
fn @copied_other_length(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, arg0
    v4 = add v3, 32
    calldatacopy v4, arg1, arg1
    v5 = add v4, arg0
    v6 = inttoptr i256 v5 to ptr<memory>
    memory_zero v6, 1
    v7 = mload v3
    ret v7
}

// A copy in a block the tail does not follow may have been skipped.
// CHECK-LABEL: fn @copied_in_other_branch
// CHECK-NOT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: ret
fn @copied_in_other_branch(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, arg0
    v4 = add v3, 32
    v8 = ne arg2, 0
    jumpi v8, bb1, bb2
  bb1:
    calldatacopy v4, arg1, arg0
    jump bb2
  bb2:
    v5 = add v4, arg0
    v6 = inttoptr i256 v5 to ptr<memory>
    memory_zero v6, 1
    v7 = mload v3
    ret v7
}

// The padding of a copy at the free-memory pointer is a store at a runtime offset from it, past
// the allocation that precedes the pointer.
// CHECK-LABEL: fn @padded_encoding
// CHECK: mstore {{v[0-9]+}}, 0
// CHECK-NEXT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: +{{ +}}ret arg0
fn @padded_encoding(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, arg0
    v4 = add v3, 32
    calldatacopy v4, arg1, arg0
    v5 = fmp
    v6 = ptrtoint ptr<memory> v5 to i256
    v7 = add arg0, 31
    v8 = and v7, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v9 = add v6, v8
    mstore v9, 0
    v10 = mload v3
    ret v10
}

// An offset from the pointer that no access bounds may wrap below the allocation.
// CHECK-LABEL: fn @padded_unbounded
// CHECK-NOT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: ret
fn @padded_unbounded(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, arg0
    v5 = fmp
    v6 = ptrtoint ptr<memory> v5 to i256
    v9 = add v6, arg1
    mstore v9, 0
    v10 = mload v3
    ret v10
}
