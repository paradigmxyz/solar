@module Test
@inline_assembly
types:
  struct0: {i256, i256}

fn @temporary(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = mload arg0
    v1 = add arg0, 31
    mstore8 v1, 7
    v2 = mload arg0
    mstore arg0, v0
    ret v2
}

fn @check(arg0: i256) -> struct0 [selector=0x5f72f450, pure, abi_params=[u256], abi_returns=[word, word], abi_return_params=[u256, u256]] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    v1 = add v0, 32
    mstore 64, v1 !metadata(memory=scratch)
    mstore v0, arg0
    v2 = icall @temporary, v0
    v3 = icall @temporary, v0
    v4 = add v2, v3
    v5 = mload v0
    v6 = insert_value struct0, undef struct0, 0, v4
    v7 = insert_value struct0, v6, 1, v5
    ret v7
}
