- // === ROOT/tests/ui/codegen/mir/cse/payable_calls.mir (before cse) ===
+ // === ROOT/tests/ui/codegen/mir/cse/payable_calls.mir (after cse) ===
  @module PayableCallEffects
  fn @observe(arg0: i256) -> i256 {
    bb0:
      v0 = trunc i256 arg0 to i160
      v1 = balance arg0
      v2 = selfbalance
      v3 = sload 0
      v4 = tload 0
      v5 = icall send<>, v0, 1
      v6 = balance arg0
      v7 = selfbalance
      v8 = sload 0
      v9 = tload 0
      icall transfer<>, v0, 1
      v10 = balance arg0
      v11 = selfbalance
      v12 = sload 0
      v13 = tload 0
      v14 = add v1, v2
      v15 = add v3, v4
      v16 = add v6, v7
      v17 = add v8, v9
      v18 = add v10, v11
      v19 = add v12, v13
      v20 = add v14, v15
      v21 = add v16, v17
      v22 = add v18, v19
      v23 = add v20, v21
      v24 = add v23, v22
      ret v24
  }
  
