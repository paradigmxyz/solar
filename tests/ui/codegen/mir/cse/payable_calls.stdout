- ; === ROOT/tests/ui/codegen/mir/cse/payable_calls.mir (before cse) ===
+ ; === ROOT/tests/ui/codegen/mir/cse/payable_calls.mir (after cse) ===
  @module PayableCallEffects
  fn @observe(arg0: i256) -> i256 {
    bb0:
      v0 = trunc i256 arg0 to i160
      v1 = balance arg0
      v2 = selfbalance
      v3 = sload 0
      v4 = tload 0
      v5 = extcall v0, gas 0, value 1
      v6 = balance arg0
      v7 = selfbalance
      v8 = sload 0
      v9 = tload 0
      v10 = extcall v0, gas 0, value 1
      v11 = balance arg0
      v12 = selfbalance
      v13 = sload 0
      v14 = tload 0
      v15 = add v1, v2
      v16 = add v3, v4
      v17 = add v6, v7
      v18 = add v8, v9
      v19 = add v11, v12
      v20 = add v13, v14
      v21 = add v15, v16
      v22 = add v17, v18
      v23 = add v19, v20
      v24 = add v21, v22
      v25 = add v24, v23
      ret v25
  }
  
