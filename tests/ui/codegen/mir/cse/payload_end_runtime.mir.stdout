; function wrap(bytes memory s, uint256 n) external pure returns (uint256) [selector 0x2d3d4ade]
fn @wrap(arg0: ptr<memory>, arg1: i256) -> i256 [selector=0x2d3d4ade, pure, abi_params=[bytes, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
