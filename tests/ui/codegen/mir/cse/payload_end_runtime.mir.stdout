; function pad(bytes memory s, uint256 start) external pure returns (bytes memory r, uint256 tail) [selector 0xb20ac612]
fn @pad(arg0: ptr<memory>, arg1: i256) -> struct0 [selector=0xb20ac612, pure, abi_params=[bytes, uint256], abi_returns=[memory_bytes, word], abi_return_params=[bytes, uint256]] {
  bb0:
    icall @_dirty
    v0 = mload arg0
    v1 = checked_sub uint256, v0, arg1
    v2 = add v1, 31
    v3 = and v2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v4 = add v3, 32
    v5 = lt v4, v1
    icall panic_if<0x41>, v5
    v6 = alloc zeroed checked v4
    mstore v6, v1
    jump bb1
  bb1:  ; preds = bb0, bb3
    v7 = phi [bb0: arg0], [bb3: v7]
    v8 = phi [bb0: arg1], [bb3: v8]
    v9 = phi [bb0: v6], [bb3: v9]
    v10 = phi [bb0: 0], [bb3: v10]
    v11 = phi [bb0: v1], [bb3: v11]
    v12 = phi [bb0: 0], [bb3: v29]
    v13 = lt v12, v11
    jumpi v13, bb4, bb5
  bb5:  ; preds = bb1
    jump bb2
  bb2:  ; preds = bb5
    icall @_zeroPad, v9
    v30 = icall @_tail, v9
    v31 = insert_value struct0, undef struct0, 0, v9
    v32 = insert_value struct0, v31, 1, v30
    ret v32
  bb4:  ; preds = bb1
    v14 = checked_add uint256, v8, v12
    v15 = mload v7
    v16 = lt v14, v15
    v17 = eq v16, false
    icall panic_if<0x32>, v17
    v18 = ptradd v7, v14
    v19 = ptradd v18, 32
    v20 = mload v19
    v21 = byte 0, v20
    v22 = shl v21, 248
    v23 = mload v9
    v24 = lt v12, v23
    v25 = eq v24, false
    icall panic_if<0x32>, v25
    v26 = byte 0, v22
    v27 = ptradd v9, v12
    v28 = ptradd v27, 32
    mstore8 v28, v26
    jump bb6
  bb6:  ; preds = bb4
    jump bb3
  bb3:  ; preds = bb6
    v29 = checked_add uint256, v12, 1
    jump bb1
}

; function truncate(bytes32 word, uint256 n) external pure returns (bytes memory r, uint256 tail) [selector 0xe0b7b2e6]
fn @truncate(arg0: i256, arg1: i256) -> struct0 [selector=0xe0b7b2e6, pure, abi_params=[bytes32, uint256], abi_returns=[memory_bytes, word], abi_return_params=[bytes, uint256]] {
