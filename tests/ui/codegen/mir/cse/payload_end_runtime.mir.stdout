; function _zeroPad(bytes memory b) private pure
fn @_zeroPad(arg0: ptr<memory>) [pure] {
  bb0:
    v0 = ptrtoint ptr<memory> arg0 to i256
    v1 = mload arg0
    v2 = ptrtoint ptr<memory> arg0 to i256
