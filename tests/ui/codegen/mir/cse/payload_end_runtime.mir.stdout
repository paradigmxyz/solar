; function next() external pure returns (uint256 first, uint256 second) [selector 0x4c8fe526]
fn @next() -> struct1 [selector=0x4c8fe526, pure, abi_params=[], abi_returns=[word, word], abi_return_params=[uint256, uint256]] {
  bb0:
    v0 = alloc zeroed checked 64
