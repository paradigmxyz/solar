//@compile-flags: -Zmir-pipeline=cse
//@filecheck: --enable-var-scope

@module CseLengthAcrossAlloc

// An allocation bumps the free-memory pointer, a write to the reserved word at
// 0x40. A memory-object argument was allocated by a caller, so it is the zero
// slot or a heap object and its length word starts at or above 0x60.
// CHECK-LABEL: fn @argument(
// CHECK:       [[LEN:v[0-9]+]] = memory_object_len memorybytes, arg0
// CHECK: -{{ +}}{{v[0-9]+}} = memory_object_len memorybytes, arg0
// CHECK: +{{ +}}{{v[0-9]+}} = add [[LEN]], [[LEN]]
fn @argument(arg0: memorybytes) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = alloc memorybytes, exact, zeroed, panic, 64
    v2 = memory_object_len memorybytes, arg0
    v3 = add v0, v2
    ret v3
}

// Nor the length of an allocation made before it, which lies at or above the
// heap start.
// CHECK-LABEL: fn @earlier(
// CHECK: -{{ +}}{{v[0-9]+}} = memory_object_len memorybytes,
// CHECK: -{{ +}}{{v[0-9]+}} = memory_object_len memorybytes,
// CHECK: +{{ +}}{{v[0-9]+}} = add arg0, arg0
fn @earlier(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, zeroed, panic, 64
    set_memory_object_len memorybytes, v0, arg0
    v1 = memory_object_len memorybytes, v0
    v2 = alloc memorybytes, exact, uninitialized, infallible, 64
    v3 = memory_object_len memorybytes, v0
    v4 = add v1, v3
    ret v4
}

// `new bytes(n)`: the size is not a constant, but the fill is the allocation's
// own extent and the length word is the object's own first word, so neither
// is a write through an unknown pointer.
// CHECK-LABEL: fn @sized(
// CHECK:       [[LEN:v[0-9]+]] = memory_object_len memorybytes, arg0
// CHECK:       alloc memorybytes, exact, zeroed, panic, arg1
// CHECK:       set_memory_object_len memorybytes
// CHECK: -{{ +}}{{v[0-9]+}} = memory_object_len memorybytes, arg0
// CHECK: +{{ +}}{{v[0-9]+}} = add [[LEN]], [[LEN]]
fn @sized(arg0: memorybytes, arg1: u256) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = alloc memorybytes, exact, zeroed, panic, arg1
    set_memory_object_len memorybytes, v1, 7
    v2 = memory_object_len memorybytes, arg0
    v3 = add v0, v2
    ret v3
}

// The shape that matters: the length read before an output buffer is allocated
// is the length the loop compares against, so the loop's condition and its
// bounds check test one value and the check can go.
// CHECK-LABEL: fn @loop(
// CHECK:       [[LEN:v[0-9]+]] = memory_object_len memorybytes, arg0
// CHECK: -{{ +}}{{v[0-9]+}} = memory_object_len memorybytes, arg0
// CHECK: +{{ +}}[[COND:v[0-9]+]] = lt {{v[0-9]+}}, [[LEN]]
// CHECK: -{{ +}}{{v[0-9]+}} = memory_object_len memorybytes, arg0
// CHECK: +{{ +}}icall panic_if_zero<0x32>, [[COND]]
fn @loop(arg0: memorybytes, arg1: u256) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = alloc memorybytes, exact, zeroed, panic, arg1
    set_memory_object_len memorybytes, v1, 32
    jumpi v0, bb1, bb4
  bb1:
    v2 = phi [bb0: 0], [bb3: v9]
    v3 = memory_object_len memorybytes, arg0
    v4 = lt v2, v3
    jumpi v4, bb2, bb4
  bb2:
    v5 = memory_object_len memorybytes, arg0
    v6 = lt v2, v5
    icall panic_if_zero<0x32>, v6
    v7 = memory_object_load_byte memorybytes, arg0, v2
    memory_object_store_byte memorybytes, v1, 0, v7
    jump bb3
  bb3:
    v9 = add v2, 1
    jump bb1
  bb4:
    ret v0
}

// A raw pointer is not known to be an object: a word read through it may be
// the pointer slot itself, and is read again.
// CHECK-LABEL: fn @raw(
// CHECK: {{^ +}}[[FIRST:v[0-9]+]] = mload arg0
// CHECK: {{^ +}}[[SECOND:v[0-9]+]] = mload arg0
// CHECK: {{^ +}}{{v[0-9]+}} = add [[FIRST]], [[SECOND]]
fn @raw(arg0: u256) -> u256 {
  bb0:
    v0 = mload arg0
    v1 = alloc memorybytes, exact, zeroed, panic, 64
    v2 = mload arg0
    v3 = add v0, v2
    ret v3
}

// A raw allocation has no length word, so a store to one of unknown size may
// run past it and stays a write through an unknown pointer.
// CHECK-LABEL: fn @raw_allocation(
// CHECK: {{^ +}}[[FIRST:v[0-9]+]] = memory_object_len memorybytes, arg0
// CHECK: {{^ +}}[[SECOND:v[0-9]+]] = memory_object_len memorybytes, arg0
// CHECK: {{^ +}}{{v[0-9]+}} = add [[FIRST]], [[SECOND]]
fn @raw_allocation(arg0: memorybytes, arg1: u256) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = alloc raw, exact, uninitialized, infallible, arg1
    mstore v1, 7
    v2 = memory_object_len memorybytes, arg0
    v3 = add v0, v2
    ret v3
}
