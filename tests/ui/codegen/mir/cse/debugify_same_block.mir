//@ compile-flags: -Zmir-pipeline=cse -Zdebugify=check
// The surviving instruction runs exactly when the deleted one would have: it is in the same
// block, before it, with no side effect between them, so the survivor keeps both origins.
@module DebugifySameBlock
fn @pure(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1 !metadata(span=10..20)
    v1 = add arg0, arg1 !metadata(span=30..40)
    v2 = mul v0, v1 !metadata(span=50..60)
    ret v2
}

fn @load(arg0: i256) -> i256 {
  bb0:
    v0 = sload arg0 !metadata(span=110..120)
    v1 = sload arg0 !metadata(span=130..140)
    v2 = add v0, v1 !metadata(span=150..160)
    ret v2
}

// A call that restores the memory it touches is deleted in the local walk of its block.
fn @restoring(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = icall @restore, arg0, arg1 !metadata(span=210..220)
    v1 = icall @restore, arg0, arg1 !metadata(span=230..240)
    v2 = add v0, v1 !metadata(span=250..260)
    ret v2
}
fn @restore(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = mload arg0 !metadata(span=310..320)
    mstore arg0, 17 !metadata(span=330..340)
    v1 = lt v0, arg1 !metadata(span=350..360)
    v2 = zext i1 v1 to i256 !metadata(span=370..380)
    mstore arg0, v0 !metadata(span=390..400)
    ret v2
}
