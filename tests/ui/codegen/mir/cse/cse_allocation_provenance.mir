//@compile-flags: -Zmir-pipeline=cse
//@filecheck: --enable-var-scope

@module CseAllocationProvenance

// CHECK-LABEL: @fresh
// CHECK:       store [[ADDR:v[0-9]+]], arg0
// CHECK: -     {{v[0-9]+}} = load [[ADDR]]
// CHECK: -     {{v[0-9]+}} = load [[ADDR]]
// CHECK: +     [[SUM:v[0-9]+]] = add arg0, arg0
// CHECK:       ret [[SUM]]
fn @fresh(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    v11 = alloc 32
    v3 = ptrtoint ptr<memory> v11 to i256
    store v2, arg0
    v5 = load v2
    store v3, arg1
    v7 = load v2
    v8 = add v5, v7
    ret v8
}

// CHECK-LABEL: @reset
// CHECK: {{^ +}}store [[ADDR:v[0-9]+]], arg0
// CHECK: -     {{v[0-9]+}} = load [[ADDR]]
// CHECK: {{^ +}}set_fmp {{v[0-9]+}}
// CHECK: {{^ +}}[[SECOND:v[0-9]+]] = load [[ADDR]]
// CHECK: +     [[SUM:v[0-9]+]] = add arg0, [[SECOND]]
// CHECK: {{^ +}}ret [[SUM]]
fn @reset(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v12 = alloc 32
    v2 = ptrtoint ptr<memory> v12 to i256
    store v2, arg0
    v4 = load v2
    set_fmp v12
    v13 = alloc 32
    v6 = ptrtoint ptr<memory> v13 to i256
    store v6, arg1
    v8 = load v2
    v9 = add v4, v8
    ret v9
}

// CHECK-LABEL: @unbounded_heap_copy_keeps_reserved_load
// CHECK: {{^ +}}[[FIRST:v[0-9]+]] = load 96
// CHECK: {{^ +}}copy
// CHECK: {{^ +}}[[SECOND:v[0-9]+]] = load 96
// CHECK: {{^ +}}{{v[0-9]+}} = add [[FIRST]], [[SECOND]]
fn @unbounded_heap_copy_keeps_reserved_load(arg0: i256) -> i256 {
  bb0:
    v14 = alloc 32
    v1 = ptrtoint ptr<memory> v14 to i256
    v2 = load 96
    copy v1, 0, arg0
    v3 = load 96
    v4 = add v2, v3
    ret v4
}

// CHECK-LABEL: @unbounded_heap_copy_can_reach_other_allocation
// CHECK: {{^ +}}[[FIRST:v[0-9]+]] = load [[OTHER:v[0-9]+]]
// CHECK: {{^ +}}copy
// CHECK: {{^ +}}[[SECOND:v[0-9]+]] = load [[OTHER]]
// CHECK: {{^ +}}{{v[0-9]+}} = add [[FIRST]], [[SECOND]]
fn @unbounded_heap_copy_can_reach_other_allocation(arg0: i256) -> i256 {
  bb0:
    v15 = alloc 32
    v1 = ptrtoint ptr<memory> v15 to i256
    v16 = alloc 32
    v2 = ptrtoint ptr<memory> v16 to i256
    v3 = load v2
    copy v1, 0, arg0
    v4 = load v2
    v5 = add v3, v4
    ret v5
}

// CHECK-LABEL: @loop_allocation_after_fmp_reset
// CHECK: {{^ +}}[[BEFORE:v[0-9]+]] = load 96
// CHECK: {{^ +}}copy
// CHECK: {{^ +}}[[AFTER:v[0-9]+]] = load 96
// CHECK: {{^ +}}{{v[0-9]+}} = add [[BEFORE]], [[AFTER]]
fn @loop_allocation_after_fmp_reset(arg0: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v18 = inttoptr i256 0 to ptr<memory>
    set_fmp v18
    v17 = alloc 32
    v1 = ptrtoint ptr<memory> v17 to i256
    v2 = load 96
    copy v1, 128, 128
    v3 = load 96
    v4 = add v2, v3
    jumpi arg0, bb1, bb2
  bb2:
    ret v4
}

// A nominal caller object may overlap the fresh allocation.
// CHECK-LABEL: @argument_header
// CHECK: {{^ +}}[[LEN:v[0-9]+]] = load arg0
// CHECK: {{^ +}}store8
// CHECK: {{^ +}}[[AFTER:v[0-9]+]] = load arg0
// CHECK: {{^ +}}{{v[0-9]+}} = add [[LEN]], [[AFTER]]
fn @argument_header(arg0: ptr<memory>) -> i256 {
  bb0:
    v1 = alloc 64
    v0 = load arg0
    v5 = ptrtoint ptr<memory> v1 to i256
    store v5, 32
    v9001 = ptradd v1, 32
    store8 v9001, 7
    v2 = load arg0
    v3 = add v0, v2
    ret v3
}

// Hashing a memory or calldata mapping key may reset the free memory pointer,
// so a later allocation may overlap an earlier one.
// CHECK-LABEL: @mapping_slot_memory_reset
// CHECK: {{^ +}}store {{v[0-9]+}}, arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = load
fn @mapping_slot_memory_reset(arg0: i256, arg1: i256, arg2: ptr<memory>) -> i256 {
  bb0:
    v10 = alloc 32
    v1 = ptrtoint ptr<memory> v10 to i256
    v2 = mapping_slot_bytes arg2, arg1
    v11 = alloc 32
    v3 = ptrtoint ptr<memory> v11 to i256
    store v3, arg1
    store v1, arg0
    v4 = load v3
    v5 = add v4, v2
    ret v5
}

// CHECK-LABEL: @mapping_slot_calldata_reset
// CHECK: {{^ +}}store {{v[0-9]+}}, arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = load
fn @mapping_slot_calldata_reset(arg0: i256, arg1: i256, arg2: slice<calldata>) -> i256 {
  bb0:
    v10 = alloc 32
    v1 = ptrtoint ptr<memory> v10 to i256
    v2 = mapping_slot_bytes arg2, arg1
    v11 = alloc 32
    v3 = ptrtoint ptr<memory> v11 to i256
    store v3, arg1
    store v1, arg0
    v4 = load v3
    v5 = add v4, v2
    ret v5
}

// A callee that sets the free memory pointer resets it for the caller too.
// CHECK-LABEL: @call_reset
// CHECK: {{^ +}}store {{v[0-9]+}}, arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = load
fn @call_reset(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v1 = ptrtoint ptr<memory> v10 to i256
    icall @resetter, v10
    v11 = alloc 32
    v3 = ptrtoint ptr<memory> v11 to i256
    store v3, arg1
    store v1, arg0
    v4 = load v3
    ret v4
}

fn @resetter(arg0: ptr<memory>) {
  bb0:
    set_fmp arg0
    ret
}
