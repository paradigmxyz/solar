//@compile-flags: -Zmir-pipeline=cse
//@filecheck: --enable-var-scope

@module CseAllocationProvenance

// CHECK-LABEL: @fresh
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK: -     {{v[0-9]+}} = mload [[ADDR]]
// CHECK: -     {{v[0-9]+}} = mload [[ADDR]]
// CHECK: +     [[SUM:v[0-9]+]] = add arg0, arg0
// CHECK:       ret [[SUM]]
fn @fresh(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v2 = alloc raw, exact, uninitialized, infallible, 32
    v3 = alloc raw, exact, uninitialized, infallible, 32
    mstore v2, arg0
    v5 = mload v2
    mstore v3, arg1
    v7 = mload v2
    v8 = add v5, v7
    ret v8
}

// CHECK-LABEL: @reset
// CHECK: {{^ +}}mstore [[ADDR:v[0-9]+]], arg0
// CHECK: -     {{v[0-9]+}} = mload [[ADDR]]
// CHECK: {{^ +}}set_fmp [[ADDR]]
// CHECK: {{^ +}}[[SECOND:v[0-9]+]] = mload [[ADDR]]
// CHECK: +     [[SUM:v[0-9]+]] = add arg0, [[SECOND]]
// CHECK: {{^ +}}ret [[SUM]]
fn @reset(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v2 = alloc raw, exact, uninitialized, infallible, 32
    mstore v2, arg0
    v4 = mload v2
    set_fmp v2
    v6 = alloc raw, exact, uninitialized, infallible, 32
    mstore v6, arg1
    v8 = mload v2
    v9 = add v4, v8
    ret v9
}

// A memory-object argument existed before the function ran, so writes into a
// fresh allocation never reach its header.
// CHECK-LABEL: @argument_header
// CHECK: {{^ +}}[[LEN:v[0-9]+]] = memory_object_len memorybytes, arg0
// CHECK: {{^ +}}memory_object_store_byte
// CHECK: -     {{v[0-9]+}} = memory_object_len memorybytes, arg0
// CHECK: +     {{v[0-9]+}} = add [[LEN]], [[LEN]]
fn @argument_header(arg0: memorybytes) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = alloc memorybytes, exact, uninitialized, infallible, 64
    set_memory_object_len memorybytes, v1, 32
    memory_object_store_byte memorybytes, v1, 0, 7
    v2 = memory_object_len memorybytes, arg0
    v3 = add v0, v2
    ret v3
}
