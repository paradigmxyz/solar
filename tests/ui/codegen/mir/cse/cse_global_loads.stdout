-     v0 = mload 0
      jumpi arg0, bb1, bb2
    bb2:                                            ; preds = bb0
      mstore 0, 22
-     v2 = mload 0
-     ret v2
+     ret 22
    bb1:                                            ; preds = bb0
-     v1 = mload 0
-     ret v1
+     ret 11
  }
  
  fn @dominating_sload(arg0: i1) -> i256 {
    bb0:
      v0 = sload 0
