+ ; === ROOT/tests/ui/codegen/mir/cse/cse_global_loads.mir (after cse) ===
  @module CseGlobalLoads
  @immutables
    value: uint256
  
  fn @dominating_mload(arg0: i1) -> i256 {
    bb0:
