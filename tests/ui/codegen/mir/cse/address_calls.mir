//@ compile-flags: -Zmir-pipeline=cse,dce
@module AddressCallEffects

fn @calls(arg0: address, arg1: memorybytes) -> u256 {
  bb0:
    v0 = sload 0
    v1 = balance arg0
    v2 = address_staticcall arg0, arg1
    v3 = sload 0
    v4 = balance arg0
    v5 = address_call arg0, arg1
    v6 = sload 0
    v7 = balance arg0
    v8 = address_delegatecall arg0, arg1
    v9 = sload 0
    v10 = balance arg0
    v11 = add v0, v1
    v12 = add v3, v4
    v13 = add v6, v7
    v14 = add v9, v10
    v15 = add v11, v12
    v16 = add v13, v14
    v17 = add v15, v16
    ret v17
}

fn @capture(arg0: address, arg1: memorybytes) -> u256 {
  bb0:
    v0 = address_call arg0, arg1
    v1 = returndata_bytes
    v2 = address_call arg0, arg1
    v3 = returndata_bytes
    v4 = memory_object_len memorybytes, v1
    v5 = memory_object_len memorybytes, v3
    v6 = add v4, v5
    ret v6
}
