//@compile-flags: -Zmir-pipeline=cse
//@filecheck:
@module MemoryObjectCse

// CHECK-LABEL: {{^[ +].*}}fn @reuse_projections{{[( ]}}
// CHECK: - {{v[0-9]+}} = memory_object_data memorybytes, arg0
// CHECK: - {{v[0-9]+}} = memory_object_field_addr memorystruct<3>, arg1, 2
// CHECK: - {{v[0-9]+}} = memory_object_element_addr memoryarray<2>, arg2, arg3
fn @reuse_projections(arg0: memorybytes, arg1: memorystruct, arg2: memoryarray, arg3: u256) -> u256 {
  bb0:
    v4 = memory_object_data memorybytes, arg0
    v5 = memory_object_data memorybytes, arg0
    v6 = memory_object_field_addr memorystruct<3>, arg1, 2
    v7 = memory_object_field_addr memorystruct<3>, arg1, 2
    v8 = memory_object_element_addr memoryarray<2>, arg2, arg3
    v9 = memory_object_element_addr memoryarray<2>, arg2, arg3
    v10 = eq v4, v5
    v11 = eq v6, v7
    v12 = eq v8, v9
    v13 = add v10, v11
    v14 = add v13, v12
    ret v14
}

// CHECK-LABEL: {{^[ +].*}}fn @invalidate_length{{[( ]}}
// CHECK: - {{v[0-9]+}} = memory_object_len memorybytes, arg0
// CHECK: + {{v[0-9]+}} = add [[LENGTH:v[0-9]+]], [[LENGTH]]
fn @invalidate_length(arg0: memorybytes) -> u256 {
  bb0:
    v1 = memory_object_len memorybytes, arg0
    v2 = memory_object_len memorybytes, arg0
    set_memory_object_len memorybytes, arg0, 9
    v3 = memory_object_len memorybytes, arg0
    v4 = add v1, v2
    v5 = add v4, v3
    ret v5
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_local_length{{[( ]}}
// CHECK:       bb1:
// CHECK-NEXT:       [[LOCAL:v[0-9]+]] = memory_object_len memorybytes,
// CHECK-NEXT:       ret [[LOCAL]]
fn @keep_local_length() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v1 = memory_object_len memorybytes, v0
    jumpi v1, bb1, bb2
  bb1:
    v2 = memory_object_len memorybytes, v0
    ret v2
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @reuse_live_length{{[( ]}}
// CHECK: -     {{v[0-9]+}} = memory_object_len memorybytes,
// CHECK: +     {{v[0-9]+}} = add [[LIVE:v[0-9]+]], [[LIVE]]
fn @reuse_live_length() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v1 = memory_object_len memorybytes, v0
    jumpi v1, bb1, bb2
  bb1:
    v2 = memory_object_len memorybytes, v0
    v3 = add v1, v2
    ret v3
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @reuse_struct_field{{[( ]}}
// CHECK:       [[FIELD:v[0-9]+]] = mload
// CHECK: -     {{v[0-9]+}} = mload
// CHECK: +     {{v[0-9]+}} = add [[FIELD]], [[FIELD]]
fn @reuse_struct_field() -> u256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v1 = memory_object_field_addr memorystruct<1>, v0, 0
    v2 = mload v1
    jumpi v2, bb1, bb2
  bb1:
    v3 = mload v1
    v4 = add v2, v3
    ret v4
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @forward_initialized_length{{[( ]}}
// CHECK: -     {{v[0-9]+}} = memory_object_len memorybytes,
// CHECK: +     ret 3
fn @forward_initialized_length() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    set_memory_object_len memorybytes, v0, 3
    v1 = memory_object_data memorybytes, v0
    mstore v1, 0
    jump bb1
  bb1:
    v2 = memory_object_len memorybytes, v0
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @raw_header_clobber{{[( ]}}
// CHECK:       [[LENGTH:v[0-9]+]] = memory_object_len memorybytes,
// CHECK-NEXT:       ret [[LENGTH]]
fn @raw_header_clobber(arg0: memorybytes, arg1: u256) -> u256 {
  bb0:
    set_memory_object_len memorybytes, arg0, 3
    v2 = word_cast arg0
    mstore v2, arg1
    v3 = memory_object_len memorybytes, arg0
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @diamond_header_clobber{{[( ]}}
// CHECK:       bb3:
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = memory_object_len memorybytes,
// CHECK-NEXT:       ret [[LENGTH]]
fn @diamond_header_clobber(arg0: memorybytes, arg1: u256) -> u256 {
  bb0:
    set_memory_object_len memorybytes, arg0, 3
    jumpi arg1, bb1, bb2
  bb1:
    set_memory_object_len memorybytes, arg0, 4
    jump bb3
  bb2:
    jump bb3
  bb3:
    v2 = memory_object_len memorybytes, arg0
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @loop_header_clobber{{[( ]}}
// CHECK:       bb1:
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = memory_object_len memorybytes,
// CHECK-NEXT:       jumpi [[LENGTH]],
fn @loop_header_clobber(arg0: memorybytes) -> u256 {
  bb0:
    set_memory_object_len memorybytes, arg0, 7
    jump bb1
  bb1:
    v1 = memory_object_len memorybytes, arg0
    jumpi v1, bb2, bb3
  bb2:
    set_memory_object_len memorybytes, arg0, 0
    jump bb1
  bb3:
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @recycled_header_clobber{{[( ]}}
// CHECK:       [[LENGTH:v[0-9]+]] = memory_object_len memorybytes,
// CHECK-NEXT:       ret [[LENGTH]]
fn @recycled_header_clobber() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    set_memory_object_len memorybytes, v0, 3
    v1 = word_cast v0
    set_fmp v1
    v2 = alloc memorybytes, exact, uninitialized, infallible, 32
    set_memory_object_len memorybytes, v2, 4
    v3 = memory_object_len memorybytes, v0
    ret v3
}
