//@ compile-flags: -Zmir-pipeline=cse,dce
@module ExtCallEffects

fn @calls(arg0: i256, arg1: ptr<memory>) -> i256 {
  bb0:
    v18 = trunc i256 arg0 to i160
    v0 = sload 0
    v1 = balance arg0
    v2 = extcall static v18, arg1
    v3 = sload 0
    v4 = balance arg0
    v5 = extcall v18, arg1
    v6 = sload 0
    v7 = balance arg0
    v8 = extcall delegate v18, arg1
    v9 = sload 0
    v10 = balance arg0
    v11 = add v0, v1
    v12 = add v3, v4
    v13 = add v6, v7
    v14 = add v9, v10
    v15 = add v11, v12
    v16 = add v13, v14
    v17 = add v15, v16
    ret v17
}

fn @capture(arg0: i256, arg1: ptr<memory>) -> i256 {
  bb0:
    v7 = trunc i256 arg0 to i160
    v0 = extcall v7, arg1
    v1 = icall returndata_bytes<>
    v2 = extcall v7, arg1
    v3 = icall returndata_bytes<>
    v4 = mload v1
    v5 = mload v3
    v6 = add v4, v5
    ret v6
}
