//@compile-flags: -Zmir-pipeline=cse
//@filecheck: --enable-var-scope

@module CseAllocUpward

// A write of runtime length at a unique allocation cannot reach an allocation that runs before it.
// CHECK-LABEL: @write_at_later_alloc
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK:       calldatacopy
// CHECK: -     {{v[0-9]+}} = mload [[ADDR]]
// CHECK: -     ret {{v[0-9]+}}
// CHECK: +     ret arg0
fn @write_at_later_alloc(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    mstore v2, arg0
    v11 = alloc 64
    v3 = ptrtoint ptr<memory> v11 to i256
    v4 = add v3, 32
    calldatacopy v4, 0, arg1
    v7 = mload v2
    ret v7
}

// The earlier allocation may sit in any dominating block.
// CHECK-LABEL: @earlier_alloc_in_dominator
// CHECK:       [[FIRST:v[0-9]+]] = mload [[ADDR:v[0-9]+]]
// CHECK:       calldatacopy
// CHECK: -     {{v[0-9]+}} = mload [[ADDR]]
// CHECK: +     [[SUM:v[0-9]+]] = add [[FIRST]], [[FIRST]]
// CHECK:       ret [[SUM]]
fn @earlier_alloc_in_dominator(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    v5 = mload v2
    jump bb1
  bb1:
    v11 = alloc 64
    v3 = ptrtoint ptr<memory> v11 to i256
    v4 = add v3, 32
    calldatacopy v4, 0, arg1
    v7 = mload v2
    v8 = add v5, v7
    ret v8
}

// The write starts at its offset, so words of the same allocation below it stay cached.
// CHECK-LABEL: @words_below_write
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK:       calldatacopy
// CHECK: -     {{v[0-9]+}} = mload [[ADDR]]
// CHECK: -     ret {{v[0-9]+}}
// CHECK: +     ret arg0
fn @words_below_write(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v11 = alloc 64
    v3 = ptrtoint ptr<memory> v11 to i256
    mstore v3, arg0
    v4 = add v3, 32
    calldatacopy v4, 0, arg1
    v7 = mload v3
    ret v7
}

// A write that starts at or below a cached word of its own allocation may overwrite it.
// CHECK-LABEL: @write_from_word
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK:       calldatacopy
// CHECK:       {{v[0-9]+}} = mload [[ADDR]]
fn @write_from_word(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v11 = alloc 64
    v3 = ptrtoint ptr<memory> v11 to i256
    mstore v3, arg0
    calldatacopy v3, 0, arg1
    v7 = mload v3
    ret v7
}

// A write at an allocation reaches the allocations that run after it.
// CHECK-LABEL: @write_before_later_alloc
// CHECK:       calldatacopy
// CHECK:       {{v[0-9]+}} = mload
fn @write_before_later_alloc(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v11 = alloc 64
    v3 = ptrtoint ptr<memory> v11 to i256
    mstore v3, arg0
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    mstore v2, arg0
    calldatacopy v3, 0, arg1
    v7 = mload v2
    ret v7
}

// A reset between the allocations can move the pointer below the earlier one.
// CHECK-LABEL: @reset_between
// CHECK:       set_fmp
// CHECK:       calldatacopy
// CHECK:       {{v[0-9]+}} = mload
fn @reset_between(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    mstore v2, arg0
    v12 = inttoptr i256 arg2 to ptr<memory>
    set_fmp v12
    v11 = alloc 64
    v3 = ptrtoint ptr<memory> v11 to i256
    v4 = add v3, 32
    calldatacopy v4, 0, arg1
    v7 = mload v2
    ret v7
}

// A runtime index wraps, so a write at one may land below its allocation, in an earlier one.
// CHECK-LABEL: @indexed_write
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK:       mstore
// CHECK:       {{v[0-9]+}} = mload [[ADDR]]
fn @indexed_write(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    mstore v2, arg0
    v11 = alloc arg1
    v12 = ptradd v11, arg2
    v13 = ptradd v12, 32
    mstore v13, 9
    v7 = mload v2
    ret v7
}

// An indexed write into an earlier allocation wraps too, and may land in a later one.
// CHECK-LABEL: @indexed_write_into_earlier
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK:       mstore
// CHECK:       {{v[0-9]+}} = mload [[ADDR]]
fn @indexed_write_into_earlier(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v10 = alloc 64
    v11 = alloc arg1
    v2 = ptrtoint ptr<memory> v11 to i256
    mstore v2, arg0
    v12 = ptradd v10, arg2
    mstore v12, 9
    v7 = mload v2
    ret v7
}

// An indexed write wraps, so it may land on a word of the allocation below its own offset.
// CHECK-LABEL: @indexed_write_same_allocation
// CHECK:       mstore [[ADDR:v[0-9]+]], arg0
// CHECK:       mstore
// CHECK:       {{v[0-9]+}} = mload [[ADDR]]
fn @indexed_write_same_allocation(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v10 = alloc 32
    v2 = ptrtoint ptr<memory> v10 to i256
    v3 = add v2, 16
    mstore v3, arg0
    v12 = ptradd v10, arg1
    v13 = ptradd v12, 64
    mstore v13, 9
    v7 = mload v3
    ret v7
}
