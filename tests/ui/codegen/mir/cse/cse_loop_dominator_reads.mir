//@compile-flags: -Zmir-pipeline=cse
//@filecheck:
@module CseLoopDominatorReads

// The header read dominates the body read. The store after the body reaches
// the body again only through the header, which reloads, so the body's read
// reuses the header value even though the store may alias it, and the
// repeated comparison collapses onto the header's condition.
// CHECK-LABEL: @reuse_dominating_read_in_loop
// CHECK: {{^ +}}[[LEN:v[0-9]+]] = mload arg0
// CHECK-NEXT: {{^ +}}[[COND:v[0-9]+]] = lt {{v[0-9]+}}, [[LEN]]
// CHECK: -     {{v[0-9]+}} = mload arg0
// CHECK-NEXT: -     {{v[0-9]+}} = lt
// CHECK-NEXT: -     jumpi
// CHECK-NEXT: +     jumpi [[COND]],
fn @reuse_dominating_read_in_loop(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = mload arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb4
  bb2:
    v3 = mload arg0
    v4 = lt v0, v3
    jumpi v4, bb3, bb5
  bb3:
    v6 = add arg1, v0
    mstore v6, v0
    v5 = add v0, 1
    jump bb1
  bb4:
    ret v1
  bb5:
    revert 0, 0
}

// The inner body stores and returns to the inner header without passing the
// outer header, so the inner header's read must stay: on the second inner
// iteration the outer value is stale.
// CHECK-LABEL: @keep_read_across_inner_cycle
// CHECK: {{^ +}}{{v[0-9]+}} = mload arg0
// CHECK: {{^ +}}{{v[0-9]+}} = mload arg0
fn @keep_read_across_inner_cycle(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v6]
    v1 = mload arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb5
  bb2:
    v3 = phi [bb1: v0], [bb3: v4]
    v7 = mload arg0
    v8 = lt v3, v7
    jumpi v8, bb3, bb4
  bb3:
    mstore arg1, v3
    v4 = add v3, 1
    jump bb2
  bb4:
    v6 = add v0, 1
    jump bb1
  bb5:
    ret v1
}
