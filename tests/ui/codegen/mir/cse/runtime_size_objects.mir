//@compile-flags: -Zmir-pipeline=cse
//@filecheck: --enable-var-scope

@module RuntimeSizeObjects

// A checked allocation is a Solidity object of at least one word, so its header
// stays inside it even at a runtime size, and an indexed store, which `ptradd`
// keeps inside the other object, cannot reach it.
// CHECK-LABEL: @header_past_indexed_store
// CHECK:       mstore [[HEADER:v[0-9]+]], arg1
// CHECK: -     {{v[0-9]+}} = mload [[HEADER]]
// CHECK: +     ret arg1
fn @header_past_indexed_store(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = alloc checked arg0
    v1 = alloc checked arg0
    mstore v0, arg1
    v2 = shl arg2, 5
    v3 = ptradd v1, v2
    v4 = ptradd v3, 32
    mstore v4, 7
    v5 = mload v0
    ret v5
}

// An unchecked allocation of runtime size may hold less than a word, so its
// first word may reach the next object.
// CHECK-LABEL: @unchecked_header_may_overlap
// CHECK:       mstore [[HEADER:v[0-9]+]], arg1
// CHECK:       [[LOAD:v[0-9]+]] = mload [[HEADER]]
// CHECK:       ret [[LOAD]]
fn @unchecked_header_may_overlap(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = alloc arg0
    v1 = alloc checked arg0
    mstore v0, arg1
    v2 = shl arg2, 5
    v3 = ptradd v1, v2
    v4 = ptradd v3, 32
    mstore v4, 7
    v5 = mload v0
    ret v5
}

// A constant offset past the first word may leave an object of runtime size,
// so the store may reach the next object's header.
// CHECK-LABEL: @constant_offset_may_leave
// CHECK:       mstore [[HEADER:v[0-9]+]], arg1
// CHECK:       [[LOAD:v[0-9]+]] = mload [[HEADER]]
// CHECK:       ret [[LOAD]]
fn @constant_offset_may_leave(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc checked arg0
    v1 = alloc checked arg0
    mstore v1, arg1
    v2 = ptradd v0, 64
    mstore v2, 7
    v3 = mload v1
    ret v3
}

// Accesses to one object compare by offset whether or not they may leave it.
// CHECK-LABEL: @same_object_offsets
// CHECK:       mstore [[HEADER:v[0-9]+]], arg1
// CHECK: -     {{v[0-9]+}} = mload [[HEADER]]
// CHECK: +     ret arg1
fn @same_object_offsets(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc checked arg0
    mstore v0, arg1
    v1 = ptradd v0, 64
    mstore v1, 7
    v2 = mload v0
    ret v2
}
