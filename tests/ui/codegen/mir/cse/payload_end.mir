//@ compile-flags: -Zmir-pipeline=cse
//@ filecheck:
@module PayloadEnd

// A word stored at the end of a fresh object's payload, `p + 32 + len` for a length its
// allocation's block stored, as a port pads its result with a zero word, starts past the length
// word: the length stays known.
// CHECK-LABEL: fn @pad_fresh
// CHECK: mstore {{v[0-9]+}}, 0
// CHECK-NEXT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: +{{ +}}ret arg0
fn @pad_fresh(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    mstore v2, arg0
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 32
    v5 = add v4, arg0
    mstore v5, 0
    v6 = mload v2
    ret v6
}

// The padding may spell the length as a load of the length word, in the other association.
// CHECK-LABEL: fn @pad_length_word
// CHECK: mstore {{v[0-9]+}}, 0
// CHECK-NEXT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: +{{ +}}ret arg0
fn @pad_length_word(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    mstore v2, arg0
    jump bb1
  bb1:
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = mload v2
    v5 = add v3, v4
    v6 = add v5, 32
    mstore v6, 0
    v7 = mload v2
    ret v7
}

// A trusted assembly block that shortens an object stores its new length, then pads it.
// CHECK-LABEL: fn @truncate
// CHECK: mstore {{v[0-9]+}}, 0
// CHECK-NEXT: -{{ +}}{{v[0-9]+}} = mload arg0
// CHECK: +{{ +}}ret arg1
fn @truncate(arg0: ptr<memory>, arg1: i256) -> i256 {
  bb0:
    mstore arg0, arg1
    v0 = ptrtoint ptr<memory> arg0 to i256
    v1 = add v0, 32
    v2 = add v1, arg1
    mstore v2, 0
    v3 = mload arg0
    ret v3
}

// A store past the padding keeps no length known, and nor does an offset that no stored length
// gives: either may wrap around onto the length word.
// CHECK-LABEL: fn @unknown_offset
// CHECK-NOT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: ret
fn @unknown_offset(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    mstore v2, arg0
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 32
    v5 = add v4, arg1
    mstore v5, 0
    v6 = mload v2
    v7 = add v3, 64
    v8 = add v7, arg0
    mstore v8, 0
    v9 = mload v2
    v10 = add v6, v9
    ret v10
}

// The length must be stored before the address is formed.
// CHECK-LABEL: fn @stored_after
// CHECK-NOT: -{{ +}}{{v[0-9]+}} = mload
// CHECK: ret
fn @stored_after(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 32
    v5 = add v4, arg0
    mstore v2, arg0
    mstore v5, 0
    v6 = mload v2
    ret v6
}

// The padding may reach the next object, whose length must be read again.
// CHECK-LABEL: fn @next_object
// CHECK: mstore {{v[0-9]+}}, 0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload
// CHECK: +{{ +}}{{v[0-9]+}} = add arg0, {{v[0-9]+}}
fn @next_object(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    v3 = alloc 32
    mstore v2, arg0
    mstore v3, arg1
    v4 = ptrtoint ptr<memory> v2 to i256
    v5 = add v4, 32
    v6 = add v5, arg0
    mstore v6, 0
    v7 = mload v3
    v8 = mload v2
    v9 = add v8, v7
    ret v9
}

// The padding stays above the free memory pointer, so allocations after it keep their own
// identities and stay apart.
// CHECK-LABEL: fn @later_allocations
// CHECK: -{{ +}}{{v[0-9]+}} = mload
// CHECK: +{{ +}}ret arg1
fn @later_allocations(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = add arg0, 63
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v2 = alloc zeroed checked v1
    mstore v2, arg0
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 32
    v5 = add v4, arg0
    mstore v5, 0
    v6 = alloc 32
    v7 = alloc 32
    mstore v6, arg1
    mstore v7, arg2
    v8 = mload v6
    ret v8
}
