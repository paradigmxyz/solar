//@compile-flags: -Zmir-pipeline=sccp
//@filecheck:
@module SccpEdge
// CHECK-LABEL: {{^[ +].*}}fn @phi_ignores_unreachable_predecessor{{[( ]}}
// CHECK: + jump bb1
// CHECK: + ret 11
fn @phi_ignores_unreachable_predecessor() -> u256 {
  bb0:
    v0 = eq 1, 1
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 11], [bb2: 22]
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_branch_keeps_phi{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, bb1, bb2
// CHECK: {{^[ +].*}}{{v[0-9]+}} = phi [bb1: 11], [bb2: 22]
fn @unknown_branch_keeps_phi(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 11], [bb2: 22]
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @constant_switch_selects_one_case{{[( ]}}
// CHECK: + jump bb2
// CHECK: {{^[ +].*}}ret 22
fn @constant_switch_selects_one_case() -> u256 {
  bb0:
    switch 2, default bb4, [1 => bb1, 2 => bb2, 3 => bb3]
  bb1:
    ret 11
  bb2:
    ret 22
  bb3:
    ret 33
  bb4:
    ret 44
}

// CHECK-LABEL: {{^[ +].*}}fn @duplicate_switch_edges{{[( ]}}
// CHECK: jump bb1
// CHECK: + {{v[0-9]+}} = phi [bb0: arg0]
fn @duplicate_switch_edges(arg0: u256, arg1: u256) -> u256 {
  bb0:
    switch 1, default bb2, [1 => bb1, 2 => bb1, 3 => bb2]
  bb1:
    v0 = phi [bb0: arg0], [bb2: arg1]
    ret v0
  bb2:
    jump bb1
}

// CHECK-LABEL: {{^[ +].*}}fn @fold_loop_backedge{{[( ]}}
// CHECK: + jump bb2
// CHECK: + invalid
fn @fold_loop_backedge(arg0: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb1: 7]
    jumpi 0, bb1, bb2
  bb2:
    ret v0
  bb3:
    jump bb3
}
