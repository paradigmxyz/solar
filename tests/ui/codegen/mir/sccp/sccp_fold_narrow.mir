//@compile-flags: -Zmir-pipeline=sccp
//@filecheck:
// Constant folding below 256 bits wraps, sign-extends, and counts bits in the
// operand's width, and casts mask to the target width.
@module SccpFoldNarrow

// 255 + 1 wraps to 0.
// CHECK-LABEL: {{^[ +].*}}fn @add_wraps{{[( ]}}
// CHECK: + ret i8 0
fn @add_wraps() -> i8 {
  bb0:
    v0 = add i8 255, i8 1
    ret v0
}

// 0 - 1 wraps to 255.
// CHECK-LABEL: {{^[ +].*}}fn @sub_wraps{{[( ]}}
// CHECK: + ret i8 255
fn @sub_wraps() -> i8 {
  bb0:
    v0 = sub i8 0, i8 1
    ret v0
}

// 255 * 255 wraps to 1.
// CHECK-LABEL: {{^[ +].*}}fn @mul_wraps{{[( ]}}
// CHECK: + ret i8 1
fn @mul_wraps() -> i8 {
  bb0:
    v0 = mul i8 255, i8 255
    ret v0
}

// `not 0` sets only the low 8 bits.
// CHECK-LABEL: {{^[ +].*}}fn @not_masks{{[( ]}}
// CHECK: + ret i8 255
fn @not_masks() -> i8 {
  bb0:
    v0 = not i8 0
    ret v0
}

// -128 sdiv -1 wraps back to -128.
// CHECK-LABEL: {{^[ +].*}}fn @sdiv_min_by_neg_one{{[( ]}}
// CHECK: + ret i8 128
fn @sdiv_min_by_neg_one() -> i8 {
  bb0:
    v0 = sdiv i8 128, i8 255
    ret v0
}

// -7 smod 2 is -1.
// CHECK-LABEL: {{^[ +].*}}fn @smod_negative{{[( ]}}
// CHECK: + ret i8 255
fn @smod_negative() -> i8 {
  bb0:
    v0 = smod i8 249, i8 2
    ret v0
}

// -128 is less than 0.
// CHECK-LABEL: {{^[ +].*}}fn @slt_negative{{[( ]}}
// CHECK: + ret true
fn @slt_negative() -> i1 {
  bb0:
    v0 = slt i8 128, i8 0
    ret v0
}

// 0 is greater than -128.
// CHECK-LABEL: {{^[ +].*}}fn @sgt_negative{{[( ]}}
// CHECK: + ret true
fn @sgt_negative() -> i1 {
  bb0:
    v0 = sgt i8 0, i8 128
    ret v0
}

// A shift by the full width clears every bit.
// CHECK-LABEL: {{^[ +].*}}fn @shl_by_width{{[( ]}}
// CHECK: + ret i8 0
fn @shl_by_width() -> i8 {
  bb0:
    v0 = shl i8 8, i8 255
    ret v0
}

// An arithmetic shift by the full width fills a negative value with ones.
// CHECK-LABEL: {{^[ +].*}}fn @sar_by_width{{[( ]}}
// CHECK: + ret i8 255
fn @sar_by_width() -> i8 {
  bb0:
    v0 = sar i8 8, i8 128
    ret v0
}

// `clz` counts leading zeros within 8 bits.
// CHECK-LABEL: {{^[ +].*}}fn @clz_zero{{[( ]}}
// CHECK: + ret i8 8
fn @clz_zero() -> i8 {
  bb0:
    v0 = clz i8 0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @clz_one{{[( ]}}
// CHECK: + ret i8 7
fn @clz_one() -> i8 {
  bb0:
    v0 = clz i8 1
    ret v0
}

// `ptrtoint` to `i160` keeps the low 160 bits.
// CHECK-LABEL: {{^[ +].*}}fn @ptrtoint_masks{{[( ]}}
// CHECK: + ret i160 0xffffffffffffffffffffffffffffffffffffffff
fn @ptrtoint_masks() -> i160 {
  bb0:
    v0 = inttoptr i256 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff to memptr
    v1 = ptrtoint memptr v0 to i160
    ret v1
}
