//@compile-flags: -Zmir-pipeline=merge-aborts
@module AccountReads

fn @balance(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = lt v0, arg0
    jumpi v1, bb3, bb1
  bb1:
    v2 = balance arg2
    v3 = add v0, v2
    v4 = lt v3, v0
    jumpi v4, bb3, bb2
  bb2:
    ret v3
  bb3:
    revert 0, 0
}

fn @code_size(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = lt v0, arg0
    jumpi v1, bb3, bb1
  bb1:
    v2 = extcodesize arg2
    v3 = add v0, v2
    v4 = lt v3, v0
    jumpi v4, bb3, bb2
  bb2:
    ret v3
  bb3:
    revert 0, 0
}

fn @code_hash(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = lt v0, arg0
    jumpi v1, bb3, bb1
  bb1:
    v2 = extcodehash arg2
    v3 = add v0, v2
    v4 = lt v3, v0
    jumpi v4, bb3, bb2
  bb2:
    ret v3
  bb3:
    revert 0, 0
}
