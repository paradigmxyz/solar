//@ compile-flags: -Zmir-pipeline=merge-aborts -Ogas
//@ filecheck:
@module WidthTests

// A test that a word fits in `k` bits is `x >> k == 0` or `x < 2^k`, and its negation `x >> k != 0`
// or `x > 2^k - 1`; the merge treats either spelling the same. Outside loops, tests that abort on
// a word with a bit above `k` join as the shifted words, `ne (or w1, w2), 0`, which a branch
// reads for free, and a comparison joins them as a boolean beside them, `or`.
// CHECK-LABEL: {{^[ +].*}}fn @shifts{{[( ]}}
// CHECK: + [[WORDS:v[0-9]+]] = or {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NEXT: + [[ANY:v[0-9]+]] = ne [[WORDS]], 0
// CHECK-NEXT: + jumpi [[ANY]], bb3, bb2
fn @shifts(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = shr arg0, 64
    v1 = ne v0, 0
    jumpi v1, bb3, bb1
  bb1:
    v2 = shr arg1, 8
    v3 = ne v2, 0
    jumpi v3, bb3, bb2
  bb2:
    ret arg0
  bb3:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @comparisons{{[( ]}}
// CHECK: + [[EITHER:v[0-9]+]] = or {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NEXT: + jumpi [[EITHER]], bb3, bb2
fn @comparisons(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffffffffffff
    jumpi v0, bb3, bb1
  bb1:
    v2 = gt arg1, 255
    jumpi v2, bb3, bb2
  bb2:
    ret arg0
  bb3:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @mixed{{[( ]}}
// CHECK: + [[WIDE:v[0-9]+]] = zext i1 {{v[0-9]+}} to i256
// CHECK-NEXT: + [[WORDS:v[0-9]+]] = or [[WIDE]], {{v[0-9]+}}
// CHECK-NEXT: + [[ANY:v[0-9]+]] = ne [[WORDS]], 0
// CHECK-NEXT: + jumpi [[ANY]], bb3, bb2
fn @mixed(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffffffffffff
    jumpi v0, bb3, bb1
  bb1:
    v2 = shr arg1, 8
    v3 = ne v2, 0
    jumpi v3, bb3, bb2
  bb2:
    ret arg0
  bb3:
    revert 0, 0
}

// In a loop, a width test that aborts on the other sense, when the word fits, turns into the
// comparison that holds exactly when it does, whichever way it is spelled, and merges: `x < 256`
// for the test `x >> 8 != 0` that aborts on false, `x > 255` for the test `x < 256` that does.
// CHECK-LABEL: {{^[ +].*}}fn @shift_aborts_when_fit{{[( ]}}
// CHECK: + [[FITS:v[0-9]+]] = lt {{[^ ,]+}}, 256
// CHECK: + [[EITHER:v[0-9]+]] = or {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NEXT: + jumpi [[EITHER]], bb5, bb4
fn @shift_aborts_when_fit(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v5]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb6
  bb2:
    v2 = shr arg1, 8
    v3 = ne v2, 0
    jumpi v3, bb3, bb5
  bb3:
    v4 = gt arg2, 255
    jumpi v4, bb5, bb4
  bb4:
    v5 = add v0, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @compare_aborts_when_fit{{[( ]}}
// CHECK: + [[EXCEEDS:v[0-9]+]] = gt {{[^ ,]+}}, 255
// CHECK: + [[EITHER:v[0-9]+]] = or {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NEXT: + jumpi [[EITHER]], bb5, bb4
fn @compare_aborts_when_fit(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v5]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb6
  bb2:
    v2 = lt arg1, 256
    jumpi v2, bb3, bb5
  bb3:
    v4 = gt arg2, 255
    jumpi v4, bb5, bb4
  bb4:
    v5 = add v0, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v0
}

// A narrow word cannot meet the `i256` literal of a comparison, so its width test turns around
// as a boolean, `eq test, false`, not as a comparison with a limit.
// CHECK-LABEL: {{^[ +].*}}fn @shift_narrow_word{{[( ]}}
// CHECK: + {{v[0-9]+}} = eq {{v[0-9]+}}, false
fn @shift_narrow_word(arg0: i256, arg1: i8, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v5]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb6
  bb2:
    v2 = shr arg1, i8 4
    v3 = ne v2, i8 0
    jumpi v3, bb3, bb5
  bb3:
    v4 = gt arg2, 255
    jumpi v4, bb5, bb4
  bb4:
    v5 = add v0, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @compare_narrow_word{{[( ]}}
// CHECK: + {{v[0-9]+}} = eq {{v[0-9]+}}, false
fn @compare_narrow_word(arg0: i256, arg1: i8, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v5]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb6
  bb2:
    v3 = gt arg1, i8 15
    jumpi v3, bb3, bb5
  bb3:
    v4 = gt arg2, 255
    jumpi v4, bb5, bb4
  bb4:
    v5 = add v0, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v0
}
