; === ROOT/tests/ui/codegen/mir/merge-aborts/abi_checks.sol:AbiChecks ===
@module AbiChecks
; function check(bool a, address b, uint96 c, int24 d) external pure returns (uint256 r) [selector 0x05c051e1]
fn @check(arg0: i1, arg1: i160, arg2: i96, arg3: i24) -> i256 [selector=0x05c051e1, pure, abi_params=[bool, address, uint96, int24], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sext i24 arg3 to i256
    v1 = zext i96 arg2 to i256
    v2 = add v1, v0
    v3 = zext i160 arg1 to i256
    v4 = zext i1 arg0 to i256
    v5 = add v4, v3
    v6 = add v5, v2
    ret v6
}
