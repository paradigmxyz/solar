- // === ROOT/tests/ui/codegen/mir/merge-aborts/negated_boolean.mir (before merge-aborts) ===
+ // === ROOT/tests/ui/codegen/mir/merge-aborts/negated_boolean.mir (after merge-aborts) ===
  @module NegatedBoolean
  fn @negated(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = gt arg0, arg1
      v1 = eq v0, false
      jumpi v1, bb1, bb3
    bb1:
      v2 = add arg0, arg1
      v3 = lt v2, arg0
      jumpi v3, bb3, bb2
    bb2:
      ret v2
    bb3:
      revert 0, 0
  }
  
