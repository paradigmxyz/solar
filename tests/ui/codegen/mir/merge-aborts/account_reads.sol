pragma solidity ^0.8.0;

contract AccountReads {
    function balance(uint256 a, uint256 b, address target) external view returns (uint256) {
        uint256 sum = a + b;
        return sum + target.balance;
    }

    function codeSize(uint256 a, uint256 b, address target) external view returns (uint256) {
        uint256 sum = a + b;
        return sum + target.code.length;
    }

    function codeHash(uint256 a, uint256 b, address target) external view returns (uint256) {
        uint256 sum = a + b;
        return sum + uint256(target.codehash);
    }
}
