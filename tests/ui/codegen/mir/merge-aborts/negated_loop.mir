//@ revisions: gas size
//@[gas] compile-flags: -Zmir-pipeline=merge-aborts -Ogas
//@[size] compile-flags: -Zmir-pipeline=merge-aborts -Osize
//@ filecheck:
@module NegatedLoop

// In a loop, a test that aborts on its false edge and compares two words turns into its
// negation, `eq c, false`, and merges, in size builds too: the `or` and `iszero` cost less
// than the `jumpi` and label push they replace.
// CHECK-LABEL: {{^[ +].*}}fn @mixed_loop{{[( ]}}
// CHECK: - jumpi [[BELOW:v[0-9]+]], bb3, bb5
// CHECK-NEXT: + [[NOT_BELOW:v[0-9]+]] = eq [[BELOW]], false
// CHECK-NEXT: + jump bb3
// CHECK: + [[EITHER:v[0-9]+]] = or [[NOT_BELOW]], {{v[0-9]+}}
// CHECK-NEXT: + jumpi [[EITHER]], bb5, bb4
fn @mixed_loop(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v5]
    v1 = phi [bb0: 0], [bb4: v4]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb6
  bb2:
    v6 = lt v1, arg1
    jumpi v6, bb3, bb5
  bb3:
    v4 = add v1, arg1
    v7 = lt v4, v1
    jumpi v7, bb5, bb4
  bb4:
    v5 = add v0, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v1
}
