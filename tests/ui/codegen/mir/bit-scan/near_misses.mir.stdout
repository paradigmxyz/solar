; function toUint(bool b) internal pure returns (uint256 u)
fn @toUint(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    v1 = zext i1 v0 to i256
    v2 = eq v1, 0
    v3 = zext i1 v2 to i256
    ret v3
}

