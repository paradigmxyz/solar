//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=word-sequence,lower-evm-shaped
//@[size] compile-flags: -Osize -Zmir-pipeline=word-sequence,lower-evm-shaped
@module BooleanSelectNarrowArithmetic

// No select recipe needs arithmetic at one bit, which `lowered` MIR rejects.
fn @all_ones_left(arg0: i1, arg1: i1) -> i1 {
  bb0:
    v0 = select arg0, true, arg1
    ret v0
}

fn @all_ones_right(arg0: i1, arg1: i1) -> i1 {
  bb0:
    v0 = select arg0, arg1, true
    ret v0
}

fn @zero_left(arg0: i1, arg1: i1) -> i1 {
  bb0:
    v0 = select arg0, false, arg1
    ret v0
}

fn @zero_right(arg0: i1, arg1: i1) -> i1 {
  bb0:
    v0 = select arg0, arg1, false
    ret v0
}

fn @constants(arg0: i1) -> i1 {
  bb0:
    v0 = select arg0, true, false
    ret v0
}
