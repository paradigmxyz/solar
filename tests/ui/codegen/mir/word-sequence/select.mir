// RECIPE-NEXT: + {{ *}}[[MASK:v[0-9]+]] = sub [[Z]], 1
// RECIPE-NEXT: + {{ *}}[[R:v[0-9]+]] = or arg1, [[MASK]]
fn @max_right_dirty(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v1 = select v2, arg1, 115792089237316195423570985008687907853269984665640564039457584007913129639935
    ret v1
}

// GAS-LABEL: fn @max_left_dirty(
// GAS: + {{ *}}[[BOOL:v[0-9]+]] = eq {{v[0-9]+}}, {{(0|false)}}
// GAS-NEXT: + {{ *}}[[Z:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} [[BOOL]]
// GAS-NEXT: + {{ *}}[[MASK:v[0-9]+]] = sub [[Z]], 1
// GAS-NEXT: + {{ *}}[[R:v[0-9]+]] = or arg1, [[MASK]]
// SIZE-LABEL: fn @max_left_dirty(
// SIZE: select {{v[0-9]+}}, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, arg1
fn @max_left_dirty(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v1 = select v2, 115792089237316195423570985008687907853269984665640564039457584007913129639935, arg1
    ret v1
}

fn @one_right_dirty(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v1 = select v2, arg1, 1
    ret v1
