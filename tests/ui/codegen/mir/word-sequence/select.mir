// RECIPE-LABEL: fn @zero_right_canonical(
// RECIPE: + {{ *}}[[R:v[0-9]+]] = mul {{v[0-9]+}}, arg1
// RECIPE-NEXT: {{ *}}ret [[R]]
fn @zero_right_canonical(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    v1 = select v0, arg1, 0
    ret v1
}

