//@ revisions: gas size shape
//@[gas] compile-flags: -Ogas -Zmir-pipeline=word-sequence
//@[size] compile-flags: -Osize -Zmir-pipeline=word-sequence
//@[shape] compile-flags: -Zmir-pipeline=lower-evm-shaped
@module ConstantSelectRecipes
@phase memory-lowered

fn @zero_right_dirty(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v1 = select arg0, arg1, 0
    ret v1
}

fn @zero_left_dirty(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v1 = select arg0, 0, arg1
    ret v1
}

fn @max_right_dirty(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v1 = select arg0, arg1, 115792089237316195423570985008687907853269984665640564039457584007913129639935
    ret v1
}

fn @max_left_dirty(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v1 = select arg0, 115792089237316195423570985008687907853269984665640564039457584007913129639935, arg1
    ret v1
}

