// SHAPE-LABEL: fn @canonical_bool(
// SHAPE: {{ *}}[[R:v[0-9]+]] = select arg0, arg1, 0
fn @canonical_bool(arg0: i1, arg1: i256) -> i256 {
  bb0:
    v0 = select arg0, arg1, 0
    ret v0
}

// RECIPE-LABEL: fn @pointer_arm(
// RECIPE: {{^ *}}[[R:v[0-9]+]] = select arg0, arg1, memorybytes 0
// RECIPE-NEXT: {{ *}}ret [[R]]
fn @pointer_arm(arg0: i1, arg1: memorybytes) -> memorybytes {
  bb0:
    v0 = select arg0, arg1, memorybytes 0
    ret v0
}

fn @factor_add(arg0: i1, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = add arg1, arg2
    v1 = select arg0, v0, arg2
    ret v1
}

fn @factor_add_reverse(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v0 = add arg2, arg1
    v1 = select v2, arg2, v0
    ret v1
}

fn @factor_sub(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v0 = sub arg2, arg1
    v1 = select v2, v0, arg2
    ret v1
}

fn @factor_or(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v0 = or arg1, arg2
    v1 = select v2, v0, arg2
    ret v1
}

fn @factor_xor(arg0: i1, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = xor arg2, arg1
    v1 = select arg0, v0, arg2
    ret v1
}

fn @factor_and(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v0 = and arg1, arg2
    v1 = select v2, v0, arg2
    ret v1
}
