//@ revisions: gas size shape
//@[gas] compile-flags: -Ogas -Zmir-pipeline=word-sequence
//@[size] compile-flags: -Osize -Zmir-pipeline=word-sequence
//@[shape] compile-flags: -Zmir-pipeline=lower-memory-objects,lower-evm-shaped
//@[gas] filecheck: --check-prefixes=RECIPE,GAS
//@[size] filecheck: --check-prefixes=RECIPE,SIZE
//@[shape] filecheck: --check-prefix=SHAPE
@module ConstantSelectRecipes
@phase semantic

// RECIPE-LABEL: fn @zero_right_dirty(
// RECIPE: {{ *}}[[Z:v[0-9]+]] = ne arg0, 0
// RECIPE: + {{ *}}[[B:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} [[Z]]
// RECIPE-NEXT: + {{ *}}[[R:v[0-9]+]] = mul [[B]], arg1
// RECIPE-NEXT: {{ *}}ret [[R]]
// SHAPE-LABEL: fn @zero_right_dirty(
// SHAPE: {{ *}}[[Z:v[0-9]+]] = ne arg0, 0
// SHAPE-NEXT: {{ *}}[[R:v[0-9]+]] = select [[Z]], arg1, 0
fn @zero_right_dirty(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v1 = select v2, arg1, 0
    ret v1
}

fn @zero_left_dirty(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v2 = ne arg0, 0
    v1 = select v2, 0, arg1
    ret v1
}

// RECIPE-LABEL: fn @max_right_dirty(
