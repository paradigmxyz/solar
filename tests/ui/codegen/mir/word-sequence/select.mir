    ret v1
}

fn @wide_dirty(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v1 = select arg0, 57896044618658097711785492504343953926634992332820282019728792003956564819968, 7
    ret v1
}

fn @variable_dirty(arg0: u256, arg1: u256, arg2: u256) -> u256 {
