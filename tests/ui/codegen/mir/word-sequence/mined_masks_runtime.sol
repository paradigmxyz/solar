contract MinedMasks {
    function masks(uint256 n) external pure returns (uint256 low, uint256 high) {
        assembly {
            low := sub(shl(n, 1), 1)
            high := not(sub(shl(n, 1), 1))
        }
    }

    function negate(uint256 x) external pure returns (uint256 result) {
        assembly { result := not(sub(x, 1)) }
    }

    function same(uint256 x, uint256 y, uint256 m) external pure returns (bool result) {
        assembly { result := eq(and(x, m), and(y, m)) }
    }

    function checkedLow(uint256 n) external pure returns (uint256) {
        return (uint256(1) << n) - 1;
    }
}
