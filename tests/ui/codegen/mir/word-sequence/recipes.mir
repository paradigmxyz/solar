//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=word-sequence
//@[size] compile-flags: -Osize -Zmir-pipeline=word-sequence
@module WordCandidates

fn @rule_0(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = not arg0
    v1 = not arg1
    v2 = and v0, v1
    ret v2
}

