//@ compile-flags: -Zmir-pipeline=egraph,word-sequence,dce
@module MinedWords
fn @odd(arg0: u256) -> u256 {
  bb0:
    v0 = shl 1, arg0
    v1 = or v0, 1
    ret v1
}
fn @double_plus(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = shl 1, arg0
    v1 = add v0, arg1
    ret v1
}
fn @shared(arg0: u256, arg1: u256) -> (u256, u256) {
  bb0:
    v0 = shl 1, arg0
    v1 = add v0, arg1
    ret v0, v1
}
