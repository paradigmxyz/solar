//@ compile-flags: -Zmir-pipeline=egraph,word-sequence,dce
@module MinedWords
types:
  struct0: {i256, i256}

fn @odd(arg0: i256) -> i256 {
  bb0:
    v0 = shl 1, arg0
    v1 = or v0, 1
    ret v1
}
fn @double_plus(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = shl 1, arg0
    v1 = add v0, arg1
    ret v1
}
fn @shared(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    v0 = shl 1, arg0
    v1 = add v0, arg1
    ret v0, v1
}
