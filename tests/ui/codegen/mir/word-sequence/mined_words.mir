//@ compile-flags: -Zmir-pipeline=egraph,word-sequence,dce
@module MinedWords
types:
  struct0: {word, word}

fn @odd(arg0: word) -> word {
  bb0:
    v0 = shl 1, arg0
    v1 = or v0, 1
    ret v1
}
fn @double_plus(arg0: word, arg1: word) -> word {
  bb0:
    v0 = shl 1, arg0
    v1 = add v0, arg1
    ret v1
}
fn @shared(arg0: word, arg1: word) -> struct0 [return_abi=[word, word]] {
  bb0:
    v0 = shl 1, arg0
    v1 = add v0, arg1
    ret v0, v1
}
