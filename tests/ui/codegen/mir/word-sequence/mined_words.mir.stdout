// === ROOT/tests/ui/codegen/mir/word-sequence/mined_words.sol:MinedWords ===
@module MinedWords
@types
  struct0: {i256, i256}

; function odd(uint256 x) external pure returns (uint256 result) [selector 0x0602c36a]
fn @odd(arg0: i256) -> i256 [selector=0x0602c36a, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = shl arg0, 1
    v1 = or v0, 1
    ret v1
}

; function doublePlus(uint256 x, uint256 y) external pure returns (uint256 result) [selector 0x3b0f99ab]
fn @doublePlus(arg0: i256, arg1: i256) -> i256 [selector=0x3b0f99ab, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = shl arg0, 1
    v1 = add v0, arg1
    ret v1
}

; function shared(uint256 x, uint256 y) external pure returns (uint256 doubled, uint256 sum) [selector 0xa03ce1ed]
fn @shared(arg0: i256, arg1: i256) -> struct0 [selector=0xa03ce1ed, pure, abi_params=[uint256, uint256], abi_returns=[word, word], abi_return_params=[uint256, uint256]] {
  bb0:
    v0 = shl arg0, 1
    v1 = add v0, arg1
    v2 = insert_value struct0, undef struct0, 0, v0
    v3 = insert_value struct0, v2, 1, v1
    ret v3
}
