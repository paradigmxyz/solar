// A low-bit mask is a shift pair when the extraction or insertion around it saves the shifts, or
// when its materialization costs more than the pair. A mask that is cheap to push stays an `and`.
contract ShiftPairMasks {
    function low(uint256 x) external pure returns (uint256 r) {
        assembly { r := and(x, 0xffffffffffffffffffffffffffffffffffffffff) }
    }

    function extract(uint256 x) external pure returns (uint256 r) {
        assembly { r := and(shr(16, x), 0xffffffffffffffffffffffffffffffffffffffff) }
    }

    function field(uint256 x) external pure returns (uint256 r) {
        assembly { r := and(shr(200, x), 0xffffff) }
    }

    function insert(uint256 x) external pure returns (uint256 r) {
        assembly { r := shl(8, and(x, 0xffffffffffffffffffffffffffffffffffffffff)) }
    }

    function pair(uint256 x) external pure returns (uint256 r) {
        assembly { r := shl(8, shr(96, shl(96, x))) }
    }

    function narrow(uint256 x) external pure returns (uint256 r) {
        assembly { r := and(shr(8, x), 0xffff) }
    }
}
