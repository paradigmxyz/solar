    v14 = not v12
    v15 = and v13, v14
    v16 = and v11, 0xffffffffffffffffffffffff
    v17 = shl 160, v16
    v18 = or v15, v17
    sstore 0, v18 !metadata(storage=slot(0))
    v19 = sload 0 !metadata(storage=slot(0))
    v20 = trunc i256 v19 to i160
    v21 = sload 0 !metadata(storage=slot(0))
    v22 = shr 160, v21
