- // === ROOT/tests/ui/codegen/mir/word-sequence/mined_masks.mir (before word-sequence) ===
+ // === ROOT/tests/ui/codegen/mir/word-sequence/mined_masks.mir (after word-sequence) ===
  @module MinedMasks
  types:
    struct0: {word, word}
    struct1: {word, word, bool}
  
  fn @low_mask(arg0: word) -> word {
    bb0:
      v0 = shl arg0, 1
      v1 = sub v0, 1
      ret v1
  }
  
  fn @shared_shift(arg0: word) -> struct0 [return_abi=[word, word]] {
    bb0:
      v0 = shl arg0, 1
      v1 = sub v0, 1
      ret v0, v1
  }
  
  fn @masked_eq_0(arg0: word, arg1: word, arg2: word) -> bool {
    bb0:
-     v0 = and arg0, arg2
-     v1 = and arg2, arg1
-     v2 = eq v0, v1
+     v3 = xor arg0, arg1
+     v4 = and v3, arg2
+     v2 = eq v4, 0
      ret v2
  }
  
  fn @masked_eq_1(arg0: word, arg1: word, arg2: word) -> bool {
    bb0:
-     v0 = and arg0, arg2
-     v1 = and arg1, arg2
-     v2 = eq v0, v1
+     v3 = xor arg0, arg1
+     v4 = and v3, arg2
+     v2 = eq v4, 0
      ret v2
  }
  
  fn @masked_eq_2(arg0: word, arg1: word, arg2: word) -> bool {
    bb0:
-     v0 = and arg2, arg0
-     v1 = and arg2, arg1
-     v2 = eq v0, v1
+     v3 = xor arg0, arg1
+     v4 = and v3, arg2
+     v2 = eq v4, 0
      ret v2
  }
  
  fn @masked_eq_3(arg0: word, arg1: word, arg2: word) -> bool {
    bb0:
-     v0 = and arg2, arg0
-     v1 = and arg1, arg2
-     v2 = eq v0, v1
+     v3 = xor arg0, arg1
+     v4 = and v3, arg2
+     v2 = eq v4, 0
      ret v2
  }
  
  fn @shared_masked_values(arg0: word, arg1: word, arg2: word) -> struct1 [return_abi=[word, word, bool]] {
    bb0:
      v0 = and arg0, arg2
      v1 = and arg1, arg2
      v2 = eq v0, v1
      ret v0, v1, v2
  }
  
  fn @different_masks(arg0: word, arg1: word, arg2: word, arg3: word) -> bool {
    bb0:
      v0 = and arg0, arg2
      v1 = and arg1, arg3
      v2 = eq v0, v1
      ret v2
  }
  
  fn @effect_barrier(arg0: word, arg1: word, arg2: word) -> bool {
    bb0:
      v0 = and arg0, arg2
      v1 = and arg1, arg2
      v2 = gas
      v3 = eq v0, v1
      ret v3
  }
  
