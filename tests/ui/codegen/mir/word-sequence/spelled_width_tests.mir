//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=spell-width-tests
//@[size] compile-flags: -Osize -Zmir-pipeline=spell-width-tests
//@[gas] filecheck: --check-prefixes=CHECK,GAS
//@[size] filecheck:
@module SpelledWidthTests
@phase lowered

// A branch reads a nonzero test for free, so `x > 2^k - 1` is the shorter `x >> k` when the
// branch is its only use.
// CHECK-LABEL: {{^[ +].*}}fn @branch_only{{[( ]}}
// CHECK: - {{v[0-9]+}} = gt arg0, 0xffffffffffffffff
// CHECK: + [[HIGH:v[0-9]+]] = shr arg0, 64
// CHECK: + {{v[0-9]+}} = ne [[HIGH]], 0
fn @branch_only(arg0: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffffffffffff
    jumpi v0, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret arg0
}

// A branch that goes to a cold block when a fits test fails, and to a hot block that only it
// enters when it holds, jumps on `x >> k` for free: `x < 2^16` is the shift, a byte shorter than
// the inverted `x > 0xffff`.
// CHECK-LABEL: {{^[ +].*}}fn @fits_to_cold{{[( ]}}
// CHECK: - {{v[0-9]+}} = lt arg0, 0x10000
// CHECK: + [[HIGH:v[0-9]+]] = shr arg0, 16
// CHECK: + {{v[0-9]+}} = eq [[HIGH]], 0
fn @fits_to_cold(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 0x10000
    jumpi v0, bb1, bb2
  bb1:
    ret arg0
  bb2:
    revert 0, 0
}

// A hot block that another path also enters may be placed elsewhere, and the branch then jumps
// when the test holds, which the shift pays an `iszero` for: a gas build keeps the comparison.
// CHECK-LABEL: {{^[ +].*}}fn @fits_to_cold_join{{[( ]}}
// GAS-NOT: shr
// GAS: {{^ +}}v0 = lt arg0, 0x10000
fn @fits_to_cold_join(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = lt arg0, 0x10000
    jumpi v0, bb2, bb3
  bb2:
    ret arg0
  bb3:
    revert 0, 0
}

// The same holds for a loop latch whose hot side is the loop header.
// CHECK-LABEL: {{^[ +].*}}fn @fits_latch{{[( ]}}
// GAS-NOT: shr
// GAS: {{^ +}}v{{[0-9]+}} = lt {{v[0-9]+}}, 0x10000
fn @fits_latch(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v1]
    v1 = add v0, 3
    v2 = eq v1, 77
    jumpi v2, bb2, bb3
  bb2:
    ret v1
  bb3:
    v3 = lt v1, 0x10000
    jumpi v3, bb1, bb4
  bb4:
    revert 0, 0
}

// With both sides hot the branch jumps when the test holds, which the shift pays an `iszero`
// for, so the comparison, as short as that shift, stays.
// CHECK-LABEL: {{^[ +].*}}fn @fits_both_hot{{[( ]}}
// CHECK-NOT: shr
// CHECK: {{^ +}}v0 = lt arg0, 256
fn @fits_both_hot(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 0x100
    jumpi v0, bb1, bb2
  bb1:
    ret arg0
  bb2:
    ret 0
}

// A test that is also a value keeps the comparison, which costs less than shifting and then
// normalizing the word to a boolean.
// CHECK-LABEL: {{^[ +].*}}fn @also_value{{[( ]}}
// CHECK-NOT: shr
// CHECK: gt arg0, 0xffffffff
fn @also_value(arg0: i256) -> i1 {
  bb0:
    v0 = gt arg0, 0xffffffff
    jumpi v0, bb1, bb2
  bb1:
    ret v0
  bb2:
    ret v0
}

// The backend folds a nonzero test into `JUMPI` only in the branching block, so a test defined
// in another block is a value: it pays for its zero test, and takes the shift where the bytes of
// the nine-byte limit it saves repay that gas.
// CHECK-LABEL: {{^[ +].*}}fn @other_block{{[( ]}}
// CHECK: + [[HIGH:v[0-9]+]] = shr arg0, 64
// CHECK-NEXT: + {{v[0-9]+}} = ne [[HIGH]], 0
fn @other_block(arg0: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffffffffffff
    jump bb1
  bb1:
    jumpi v0, bb2, bb3
  bb2:
    revert 0, 0
  bb3:
    ret arg0
}

// The tests that an `or` joins and a branch reads are one shifted word: each width gets its own
// shift, and a boolean joins as a word. A width whose limit is as short as its shift keeps the
// comparison.
// CHECK-LABEL: {{^[ +].*}}fn @joined{{[( ]}}
// CHECK: + [[A:v[0-9]+]] = shr arg0, 160
// CHECK: + [[B:v[0-9]+]] = shr arg1, 16
// CHECK: + [[C:v[0-9]+]] = shr arg2, 32
// CHECK: + [[ANY:v[0-9]+]] = ne {{v[0-9]+}}, 0
// CHECK: jumpi [[ANY]]
fn @joined(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = calldatasize
    v1 = lt v0, 228
    v2 = gt arg0, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = or v1, v2
    v4 = gt arg1, 0xffff
    v5 = or v3, v4
    v6 = gt arg2, 0xffffffff
    v7 = or v5, v6
    jumpi v7, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret arg0
}

// A width test and a zero test that an `and` joins are one word zero test.
// CHECK-LABEL: {{^[ +].*}}fn @fits_and_zero{{[( ]}}
// CHECK: + [[HIGH:v[0-9]+]] = shr arg0, 64
// CHECK: + [[ANY:v[0-9]+]] = or [[HIGH]], arg1
// CHECK: + {{v[0-9]+}} = eq [[ANY]], 0
fn @fits_and_zero(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = lt arg0, 0x10000000000000000
    v1 = eq arg1, 0
    v2 = and v0, v1
    jumpi v2, bb1, bb2
  bb1:
    ret arg0
  bb2:
    revert 0, 0
}

// A shift the block computes already prices a test of the same width at its zero test.
// CHECK-LABEL: {{^[ +].*}}fn @shared_shift{{[( ]}}
// CHECK: [[HIGH:v[0-9]+]] = shr arg0, 8
// CHECK-NOT: shr
// CHECK: + {{v[0-9]+}} = eq [[HIGH]], 0
fn @shared_shift(arg0: i256) -> i256 {
  bb0:
    v0 = shr arg0, 8
    v1 = lt arg0, 256
    jumpi v1, bb1, bb2
  bb1:
    ret v0
  bb2:
    ret arg0
}

// A recipe never moves work across an observation of the remaining gas: the `not`s stay before
// `gas` and their `and` stays after it, instead of becoming one `or` and `not` after it.
// CHECK-LABEL: {{^[ +].*}}fn @gas_barrier{{[( ]}}
// CHECK-NOT: = or
// CHECK: gas
fn @gas_barrier(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = not arg0
    v1 = not arg1
    v2 = gas
    v3 = and v0, v1
    v4 = xor v3, v2
    ret v4
}

// A width test that joins a zero-tested word as a shift is computed where the comparison was, so
// it stays before an observation of the remaining gas.
// CHECK-LABEL: {{^[ +].*}}fn @leaf_gas_barrier{{[( ]}}
// CHECK: [[HIGH:v[0-9]+]] = shr arg0, 64
// CHECK: = gas
// CHECK: = or [[HIGH]], arg1
fn @leaf_gas_barrier(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffffffffffff
    v1 = zext i1 v0 to i256
    v2 = gas
    v3 = or v1, arg1
    v4 = ne v3, 0
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v2
}

// Two leaves of one comparison each get a shift, both computed where the comparison was.
// CHECK-LABEL: {{^[ +].*}}fn @shared_comparison{{[( ]}}
// CHECK: [[A:v[0-9]+]] = shr arg0, 64
// CHECK: [[B:v[0-9]+]] = shr arg0, 64
// CHECK: = or [[A]], arg1
// CHECK: = or {{v[0-9]+}}, [[B]]
fn @shared_comparison(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffffffffffff
    v1 = zext i1 v0 to i256
    v2 = zext i1 v0 to i256
    v3 = or v1, arg1
    v4 = or v3, v2
    v5 = ne v4, 0
    jumpi v5, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret arg0
}
