//@compile-flags: -Zmir-pipeline=lower-aggregates
//@filecheck:
@module LowerAggregates

// CHECK-LABEL: {{^[ +].*}}fn @storage_to_memory{{[( ]}}
// CHECK: {{^[ +].*}}[[OBJECT:v[0-9]+]] = inttoptr i256 arg1 to memorystruct
// CHECK: - storage_to_memory
// CHECK: + [[VALUE:v[0-9]+]] = sload arg0
// CHECK: + memory_object_store_field memorystruct<3>, [[OBJECT]], 0, [[VALUE]]
fn @storage_to_memory(arg0: i256, arg1: i256) {
  bb0:
    v0 = inttoptr i256 arg1 to memorystruct
    storage_to_memory struct<word, struct<word, word>, array<2, word>>, arg0, v0
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @memory_to_storage{{[( ]}}
// CHECK: {{^[ +].*}}[[OBJECT:v[0-9]+]] = inttoptr i256 arg0 to memorystruct
// CHECK: - memory_to_storage
// CHECK: + [[VALUE:v[0-9]+]] = memory_object_load_field memorystruct<3>, [[OBJECT]], 0
// CHECK: + sstore arg1, [[VALUE]]
fn @memory_to_storage(arg0: i256, arg1: i256) {
  bb0:
    v0 = inttoptr i256 arg0 to memorystruct
    memory_to_storage struct<word, struct<word, word>, array<2, word>>, v0, arg1
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @clear_storage{{[( ]}}
// CHECK: - clear_storage
// CHECK: + [[INDEX:v[0-9]+]] = phi
// CHECK: + {{v[0-9]+}} = lt [[INDEX]], 5
// CHECK: + [[SLOT:v[0-9]+]] = add arg0, [[INDEX]]
// CHECK: + sstore [[SLOT]], 0
fn @clear_storage(arg0: i256) {
  bb0:
    clear_storage struct<word, struct<word, word>, array<2, word>>, arg0
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @phi_successor{{[( ]}}
// CHECK: + jumpi {{(arg[0-9]+|v[0-9]+)}}, {{bb[0-9]+}}, [[CONTINUATION:bb[0-9]+]]
// CHECK: + [[CONTINUATION]]:
// CHECK-NEXT: {{^[ +].*}}jump bb3 !metadata(span=30..40, modifier_depth=1)
// CHECK: + {{v[0-9]+}} = phi {{\[}}[[CONTINUATION]]: 7], {{\[}}bb2: 9]
// CHECK: + [[SLOT:v[0-9]+]] = add arg1, {{v[0-9]+}} !metadata(span=10..20, modifier_depth=2)
// CHECK: + sstore [[SLOT]], 0 !metadata(storage=symbolic([[SLOT]]), span=10..20, modifier_depth=2)
fn @phi_successor(arg0: i1, arg1: i256) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    clear_storage array<2, word>, arg1 !metadata(span=10..20, modifier_depth=2)
    jump bb3 !metadata(span=30..40, modifier_depth=1)
  bb2:
    jump bb3
  bb3:
    v0 = phi [bb1: 7], [bb2: 9]
    ret v0
}
