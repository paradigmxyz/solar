@module LegacyShifts
; function shr8() external pure returns (uint256) [selector 0x97471385]
fn @shr8() -> i256 [selector=0x97471385, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = calldatasize
    v1 = make_calldata_slice ptr<calldata> 0, v0
    v2 = extract_value slice<calldata>, v1, 1
    v3 = shr v2, 8
    ret v3
}

