- // === ROOT/tests/ui/codegen/mir/lower-shifts/constant_shifts.mir (before lower-shifts) ===
+ // === ROOT/tests/ui/codegen/mir/lower-shifts/constant_shifts.mir (after lower-shifts) ===
  @module ConstantShifts
  fn @narrow(arg0: i256) -> i256 {
    bb0:
      v0 = shl arg0, 8
      v1 = shr arg0, 8
      v2 = add v0, v1
      ret v2
  }
  
  fn @wide(arg0: i256) -> i256 {
    bb0:
      v0 = shr arg0, 224
      ret v0
  }
  
  fn @overflow(arg0: i256) -> i256 {
    bb0:
      v0 = shl arg0, 256
      v1 = shr arg0, 300
      v2 = add v0, v1
      ret v2
  }
  
  fn @variable(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = shl arg0, arg1
      v1 = shr arg0, arg1
      v2 = sar arg0, 8
      v3 = add v0, v1
      v4 = add v3, v2
      ret v4
  }
  
