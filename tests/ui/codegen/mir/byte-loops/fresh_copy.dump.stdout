    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb8, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr v2, 224
    switch v3, default bb8, [0x6bd068d => bb2, 0x4dafe7dc => bb3, 0x6fe4703b => bb4, 0xbbbb2e8a => bb5, 0xbf352668 => bb6, 0xe0041396 => bb7]
  bb7:
    tail_call @slice
  bb6:
    tail_call @rest
  bb5:
    tail_call @whole
  bb4:
    tail_call @overlapWhole
  bb3:
    tail_call @overlapRest
  bb2:
    tail_call @lengthWordCovered
  bb8:
    revert 0, 0
}

fn @alloc(arg0: i256) -> i256 {
  bb0:
    v0 = mload 64 !metadata(memory=scratch, alloc_ptr)
    v2 = add v0, arg0 !metadata(alloc_ptr)
    v3 = lt v2, v0
    v4 = gt v2, 0xffffffffffffffff
    v5 = or v3, v4
    jumpi v5, bb1, bb2
  bb2:
    mstore 64, v2 !metadata(memory=scratch)
    ret v0
  bb1:
    mstore 32, 65 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
}
