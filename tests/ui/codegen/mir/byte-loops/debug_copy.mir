//@ revisions: gas size
//@ compile-flags: -Zmir-pipeline=byte-loops -Zdebugify=check
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
// Both objectives retain the zero-count skip. The bulk write inherits the one store it
// replaces, while setup and failure checks must not claim that the loop's body executed.
@module DebugCopy
fn @copy(arg0: ptr<memory>, arg1: ptr<memory>, arg2: i256) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v13]
    v1 = lt v0, arg2
    jumpi v1, bb2, bb3
  bb2:
    v2 = mload arg0
    v3 = lt v0, v2
    icall panic_if_zero<0x32>, v3
    v4 = ptradd arg0, v0
    v5 = ptradd v4, 32
    v6 = mload v5
    v7 = byte 0, v6
    v8 = mload arg1
    v9 = lt v0, v8
    icall panic_if_zero<0x32>, v9
    v10 = ptradd arg1, v0
    v11 = ptradd v10, 32
    mstore8 v11, v7 !metadata(span=10..20)
    v13 = checked_add uint256, v0, 1
    jump bb1
  bb3:
    ret !metadata(span=70..80)
}
