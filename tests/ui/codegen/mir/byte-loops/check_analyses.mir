//@ revisions: off on
//@[off] compile-flags: -Ogas -Zmir-pipeline=byte-loops
//@[off] filecheck: --check-prefixes=CHECK,OFF
//@[on] compile-flags: -Ogas -Zmir-pipeline=byte-loops -Zcheck-analyses=true
//@[on] filecheck: --check-prefixes=CHECK,ON
@module ByteLoopsRecords

// A copy into a fresh allocation whose checks compare with the length its allocation stored,
// which load forwarding gives them. With `-Zcheck-analyses`, the replacement reads the length word
// again where it starts and records it equal to that length: the loop's own records, such as the
// forwarding's, go with its body. The source's checks reload its length, which the replacement
// reads once itself, so it needs no record. Without the flag the pass adds nothing.
// CHECK-LABEL: {{^[ +].*}}fn @stored_length{{[( ]}}
// CHECK: {{^ +}}[[LEN:v[0-9]+]] = mload arg0
// CHECK: {{^- +}}[[DEST:v[0-9]+]] = alloc zeroed checked
// ON: + [[REREAD:v[0-9]+]] = mload [[DEST]]
// ON-NEXT: + assume eq byte_loops, [[LEN]], [[REREAD]]
// ON-NOT: assume
// OFF-NOT: assume
// CHECK: + mcopy
fn @stored_length(arg0: ptr<memory>) -> ptr<memory> {
  bb0:
    v0 = mload arg0
    v1 = add v0, 31
    v3 = and v1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v4 = add v3, 32
    v2 = lt v4, v0
    icall panic_if<0x41>, v2
    v5 = alloc zeroed checked v4
    mstore v5, v0
    jump bb1
  bb1:
    mstore v5, v0
    jump bb2
  bb2:
    jump bb3
  bb3:
    v6 = phi [bb2: 0], [bb4: v18]
    v7 = lt v6, v0
    jumpi v7, bb4, bb5
  bb4:
    v8 = mload arg0
    v9 = lt v6, v8
    icall panic_if_zero<0x32>, v9
    v10 = ptradd arg0, v6
    v11 = ptradd v10, 32
    v12 = mload v11
    v13 = byte 0, v12
    v15 = lt v6, v0
    icall panic_if_zero<0x32>, v15
    v16 = ptradd v5, v6
    v17 = ptradd v16, 32
    mstore8 v17, v13
    v18 = checked_add uint256, v6, 1
    jump bb3
  bb5:
    v19 = ptrtoint ptr<memory> v5 to i256
    v20 = add v19, 32
    v21 = add v20, v0
    mstore v21, 0
    ret v5
}
