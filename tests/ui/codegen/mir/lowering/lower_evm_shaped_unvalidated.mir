//@ compile-flags: -Zvalidate-ir=false -Zmir-pipeline=lower-evm-shaped
//~? ERROR: storage slot instruction `storage_array_data_slot` survives the `lowered` phase boundary
@module LowerEvmShapedUnvalidated

// Without full IR validation, the lowering gate must still reject a semantic instruction.
fn @entry() [entry] {
  bb0:
    v0 = storage_array_data_slot 7
    v1 = sload v0
    mstore 128, v1
    returndata 128, 32
}
