- // === ROOT/tests/ui/codegen/mir/lowering/terminator_metadata.mir (before lower-abi-encode) ===
+ // === ROOT/tests/ui/codegen/mir/lowering/terminator_metadata.mir (after lower-abi-encode) ===
  @module TerminatorMetadata
  @phase abi
  fn @identity() [selector=0xac37eebb] {
    bb0:
      v0 = calldatasize
      v1 = lt v0, 36
      jumpi v1, bb2, bb3
    bb3:
      jump bb1
    bb1:
      mstore 128, arg0 !metadata(span=30..40)
      v2 = add 128, 32 !metadata(span=30..40)
      v3 = sub v2, 128 !metadata(span=30..40)
      returndata 128, v3 !metadata(span=30..40)
    bb2:
      revert 0, 0
  }
  
  fn @bubble() {
    bb0:
      v0 = returndatasize !metadata(spans=[50..60, 70..80], modifier_depth=2)
      returndatacopy 0, 0, v0 !metadata(memory=abi_return, spans=[50..60, 70..80], modifier_depth=2)
      v1 = returndatasize !metadata(spans=[50..60, 70..80], modifier_depth=2)
      revert 0, v1 !metadata(spans=[50..60, 70..80], modifier_depth=2)
  }
  
