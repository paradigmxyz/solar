- ; === ROOT/tests/ui/codegen/mir/lowering/lower_extcalls.mir (before none) ===
+ ; === ROOT/tests/ui/codegen/mir/lowering/lower_extcalls.mir (after none) ===
  @module ExtCalls
  fn @default_call(arg0: i160, arg1: ptr<memory>) -> i256 {
    bb0:
      v0 = extcall create arg0, arg1 !metadata(span=10..20, modifier_depth=2)
      v1 = zext i1 v0 to i256
      ret v1
  }
  
  fn @explicit_zero(arg0: i160, arg1: ptr<memory>, arg2: i256) -> ptr<memory> {
    bb0:
      v0 = extcall create arg0, arg1, gas arg2, value 0
      v1 = icall returndata_bytes<> !metadata(span=30..40, modifier_depth=3)
      ret v1
  }
  
  fn @delegate(arg0: i160, arg1: ptr<memory>) -> i256 {
    bb0:
      v0 = extcall delegate create arg0, arg1, gas 0x186a0
      v1 = zext i1 v0 to i256
      ret v1
  }
  
  fn @zero_value(arg0: i160, arg1: ptr<memory>) -> i256 {
    bb0:
      v0 = extcall create arg0, arg1, value 0
      v1 = zext i1 v0 to i256
      ret v1
  }
  
