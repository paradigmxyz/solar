contract DynamicOffsetBounds {
    function bytesLen(bytes calldata data) external pure returns (uint256) {
        return data.length;
    }

    function arrayLen(uint256[] calldata values) external pure returns (uint256) {
        return values.length;
    }

    function nested(bytes[] memory items) external pure returns (uint256) {
        return items[0].length;
    }
}
