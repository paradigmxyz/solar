- // === ROOT/tests/ui/codegen/mir/lowering/lower_dispatch_library.mir (before lower-dispatch) ===
+ // === ROOT/tests/ui/codegen/mir/lowering/lower_dispatch_library.mir (after lower-dispatch) ===
  @module DispatchLibrary
  @library
  @immutables
