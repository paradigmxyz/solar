+ ; runtime dispatch entry
+ fn @entry() [entry] {
+   bb0:
+     jump bb1
+   bb1:  ; preds = bb0
+     v0 = calldataload 0
+     v1 = shr v0, 224
+     switch v1, default bb4, [1 => bb2, 2 => bb3]
+   bb3:  ; preds = bb1
+     v2 = loadimmutable library_deploy_address
+     v3 = address
+     v4 = eq v2, v3
