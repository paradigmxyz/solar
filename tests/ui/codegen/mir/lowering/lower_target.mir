//@ revisions: homestead cancun
//@[homestead] compile-flags: --evm-version homestead -Zmir-pipeline=lower-target
//@[homestead] filecheck: --check-prefix=HOMESTEAD
//@[cancun] compile-flags: --evm-version cancun -Zmir-pipeline=lower-target
//@[cancun] filecheck: --check-prefix=CANCUN
@module LowerTarget
@library
@phase intrinsics-lowered

// HOMESTEAD-LABEL: after lower-target
// HOMESTEAD: + @phase target-lowered
// HOMESTEAD: -     {{v[0-9]+}} = alloc
// HOMESTEAD: -     memory_zero
// HOMESTEAD: -     mcopy
// HOMESTEAD: +     calldatacopy
// CANCUN-LABEL: after lower-target
// CANCUN: + @phase target-lowered
// CANCUN: -     {{v[0-9]+}} = alloc
// CANCUN: -     memory_zero
// CANCUN-NOT: -     mcopy
// CANCUN: +     calldatacopy
fn @combined() -> memptr {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    memory_zero v0, 32
    mcopy 0, 0, 0
    ret v0
}
