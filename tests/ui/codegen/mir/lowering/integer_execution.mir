  bb0:
    v0 = calldataload 0
    v1 = calldataload 32
    v2 = trunc i256 v0 to i8
    v3 = trunc i256 v1 to i8
    v4 = add v2, v3
    v5 = zext i8 v4 to i256
    mstore 0, v5
    v6 = sdiv v2, v3
    v7 = zext i8 v6 to i256
    mstore 32, v7
    v8 = trunc i256 v0 to i13
    v9 = trunc i256 v1 to i13
    v10 = sar v9, v8
    v11 = zext i13 v10 to i256
    mstore 64, v11
    v12 = trunc i256 v0 to i24
    v13 = trunc i256 v1 to i24
    v14 = shl v13, v12
    v15 = zext i24 v14 to i256
    mstore 96, v15
    v16 = sext i13 v8 to i255
    v17 = zext i255 v16 to i256
    mstore 128, v17
    v18 = trunc i256 v0 to i160
    v19 = trunc i256 v1 to i160
    v20 = mul v18, v19
    v21 = zext i160 v20 to i256
    mstore 160, v21
    v22 = trunc i256 v0 to i255
    v23 = clz v22
    v24 = zext i255 v23 to i256
    mstore 192, v24
    v25 = trunc i256 v0 to i1
    v26 = not v25
    v27 = zext i1 v26 to i256
    mstore 224, v27
    v28 = inttoptr i256 v0 to memptr
