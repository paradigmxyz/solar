//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=lower-abi
//@[size] compile-flags: -Osize -Zmir-pipeline=lower-abi
//@[gas] filecheck: --check-prefix=GAS
//@[size] filecheck: --check-prefix=SIZE
@module LowerAbiScratchReturn
types:
  struct0: {i256, i256}
  struct1: {i256, i256, i256}

// Gas builds stage a static return of up to two words in the scratch words,
// which nothing reads once the call ends and which expand memory the least.
// Size builds keep the heap-start buffer.
// GAS-LABEL: {{^[ +].*}}fn @pair{{[( ]}}
// GAS: + mstore 0, arg0
// GAS: + mstore 32, {{v[0-9]+}}
// GAS: + returndata 0, {{v[0-9]+}}
// SIZE-LABEL: {{^[ +].*}}fn @pair{{[( ]}}
// SIZE: + mstore 128, arg0
// SIZE: + returndata 128, {{v[0-9]+}}
fn @pair(arg0: i256) -> struct0 [return_abi=[i256, i256], selector=0x1f6a26ff, abi_returns=[word, word]] {
  bb0:
    v1 = add arg0, 1
    ret arg0, v1
}

// A third word would reach the free-memory pointer, so the return keeps the
// heap-start buffer.
// GAS-LABEL: {{^[ +].*}}fn @triple{{[( ]}}
// GAS: + mstore 128, arg0
// GAS: + returndata 128, {{v[0-9]+}}
fn @triple(arg0: i256) -> struct1 [return_abi=[i256, i256, i256], selector=0x01020304, abi_returns=[word, word, word]] {
  bb0:
    v1 = add arg0, 1
    v2 = add arg0, 2
    ret arg0, v1, v2
}
