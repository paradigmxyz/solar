//@compile-flags: -O gas -Zmir-pipeline=element-cleanup,lower-builtins,lower-abi
// A returned memory aggregate whose layout validates every narrow word is
// encoded without a cleaned copy: the encoder cleans each word it reads. A
// proved canonical array also drops the per-element validator.
@module LowerAbiValidatedReturn
fn @canonicalAddresses() -> ptr<memory> {
  bb0:
    v0 = alloc checked 96
    v1 = add 2, 0
    v6 = ptrtoint ptr<memory> v0 to i256
    mstore v6, v1
    jump bb1
  bb1:
    v2 = phi [bb0: 0], [bb2: v5]
    v3 = lt v2, v1
    jumpi v3, bb2, bb3
  bb2:
    v4 = and v2, 0xffffffffffffffffffffffffffffffffffffffff
    v112 = shl v2, 5
    v9001 = ptradd v0, 32
    v9002 = ptradd v9001, v112
    mstore v9002, v4
    v5 = add v2, 1
    jump bb1
  bb3:
    ret v0
}

fn @givesAddresses() -> ptr<memory> [selector=0x0dead002, abi_returns=[memory_array<word<uint160>>], abi_return_params=[array<_, address>]] {
  bb0:
    v0 = icall @canonicalAddresses
    ret v0
}

fn @dirtyAddressArrays() -> ptr<memory> {
  bb0:
    v0 = alloc checked 64
    v1 = add 1, 0
    v7 = ptrtoint ptr<memory> v0 to i256
    mstore v7, v1
    jump bb1
  bb1:
    v2 = phi [bb0: 0], [bb2: v5]
    v3 = lt v2, v1
    jumpi v3, bb2, bb3
  bb2:
    v4 = icall @canonicalAddresses
    v9001 = ptradd v4, 32
    mstore v9001, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v6 = ptrtoint ptr<memory> v4 to i256
    v114 = shl v2, 5
    v9002 = ptradd v0, 32
    v9003 = ptradd v9002, v114
    mstore v9003, v6
    v5 = add v2, 1
    jump bb1
  bb3:
    ret v0
}

fn @givesDirtyAddressArrays() -> ptr<memory> [selector=0x0dead003, abi_returns=[memory_array<memory_array<word<uint160>>>], abi_return_params=[array<_, array<_, address>>]] {
  bb0:
    v0 = icall @dirtyAddressArrays
    ret v0
}

fn @givesZeroedThenDirtyTuple() -> ptr<memory> [selector=0x0dead004, abi_returns=[tuple<word<uint8>>], abi_return_params=[tuple<uint8>]] {
  bb0:
    v0 = alloc checked 32
    v1 = ptrtoint ptr<memory> v0 to i256
    memory_zero v1, 32
    mstore v0, 256
    ret v0
}

fn @nativeCleanTuple(arg0: i128) -> ptr<memory> [selector=0x0dead005, abi_params=[uint128], abi_returns=[tuple<word<uint128>>], abi_return_params=[tuple<uint128>]] {
  bb0:
    v0 = alloc checked 32
    v1 = zext i128 arg0 to i256
    mstore v0, v1
    ret v0
}

fn @canonicalStorageAddresses(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = load_storage_array uint160, arg0
    ret v0
}

fn @givesStorageAddresses() -> ptr<memory> [selector=0x0dead006, abi_returns=[memory_array<word<uint160>>], abi_return_params=[array<_, address>]] {
  bb0:
    v0 = icall @canonicalStorageAddresses, 0
    ret v0
}
