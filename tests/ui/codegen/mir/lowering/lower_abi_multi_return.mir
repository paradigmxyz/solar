//@compile-flags: -Zmir-pipeline=lower-abi
//@filecheck:
// Static multi-return wrappers must encode every return word, not just the
// first call result.
@module LowerAbiMultiReturn
types:
  struct0: {i256, i256}


immutables:
  owner: address
// CHECK-LABEL: {{^[ +].*}}fn @pair{{[( ]}}
// CHECK: + mstore 0, arg0
// CHECK: + mstore 32, {{v[0-9]+}}
// CHECK: + returndata 0, {{v[0-9]+}}
fn @pair(arg0: i256) -> struct0 [return_abi=[i256, i256], selector=0x1f6a26ff, abi_returns=[word, word]] {
  bb0:
    v1 = add arg0, 1
    ret arg0, v1
}

// CHECK-LABEL: {{^[ +].*}}fn @owner{{[( ]}}
// CHECK: [[OWNER:v[0-9]+]] = loadimmutable owner
// CHECK: [[WORD:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} [[OWNER]]
// CHECK-NOT: {{^[ +].*}}= and
// CHECK: + mstore 0, [[WORD]]
fn @owner() -> i256 [selector=0x8da5cb5b, abi_returns=[word], abi_return_params=[address]] {
  bb0:
    v0 = loadimmutable owner
    v1 = zext i160 v0 to i256
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @unreachable_cycle{{[( ]}}
// CHECK: + returndata
fn @unreachable_cycle() -> struct0 [selector=0x01020304, abi_params=[], abi_returns=[word, word]] {
  bb0:
    ret undef struct0
  bb1:
    v0 = insert_value struct0, v0, 0, 1
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @typed_address
// CHECK: + {{v[0-9]+}} = trunc i256 arg0 to i160
fn @typed_address(arg0: i160, arg1: i256) -> i160 [selector=0x01020305, abi_params=[address, bool], abi_returns=[word<u160>], abi_return_params=[address]] {
  bb0:
    ret arg0
}
