//@compile-flags: -Zmir-pipeline=lower-abi
//@filecheck:
// Static multi-return wrappers must encode every return word, not just the
// first call result.
@module LowerAbiMultiReturn
immutables:
  owner: address
// CHECK-LABEL: {{^[ +].*}}fn @pair{{[( ]}}
// CHECK: + mstore 128, arg0
// CHECK: + [[SECOND:v[0-9]+]] = add 128, 32
// CHECK: + mstore [[SECOND]], {{v[0-9]+}}
// CHECK: + returndata 128, {{v[0-9]+}}
fn @pair(arg0: u256) -> (u256, u256) [selector=0x1f6a26ff, abi_returns=[word, word]] {
  bb0:
    v1 = add arg0, 1
    ret arg0, v1
}

// CHECK-LABEL: {{^[ +].*}}fn @owner{{[( ]}}
// CHECK: [[OWNER:v[0-9]+]] = loadimmutable owner
// CHECK: + mstore 128, [[OWNER]]
fn @owner() -> address [selector=0x8da5cb5b, abi_returns=[word], abi_return_params=[address]] {
  bb0:
    v0 = loadimmutable owner
    ret v0
}
