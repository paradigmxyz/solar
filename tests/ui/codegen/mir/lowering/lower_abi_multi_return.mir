//@compile-flags: -Zmir-pipeline=lower-abi
//@filecheck:
// Static multi-return wrappers must encode every return word, not just the
// first call result.
@module LowerAbiMultiReturn
// CHECK-LABEL: {{^[ +].*}}fn @pair{{[( ]}}
// CHECK: [[SECOND:v[0-9]+]] = add arg0, 1
// CHECK: + [[ENCODED:v[0-9]+]] = abi_encode [word, word], args arg0, [[SECOND]]
// CHECK: + [[PTR:v[0-9]+]] = slice_ptr [[ENCODED]]
// CHECK: + [[LEN:v[0-9]+]] = slice_len [[ENCODED]]
// CHECK: + returndata [[PTR]], [[LEN]]
fn @pair(arg0: u256) -> (u256, u256) [selector=0x1f6a26ff, abi_returns=[word, word]] {
  bb0:
    v1 = add arg0, 1
    ret arg0, v1
}
