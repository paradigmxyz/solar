//@ revisions: semantic expanded
//@[semantic] compile-flags: -Zmir-pipeline=none
//@[expanded] compile-flags: -Zmir-pipeline=lower-builtins
@module StorageBytes

fn @header(arg0: u256) -> u256 {
  bb0:
    v0 = sload arg0
    validate_storage_bytes v0 !metadata(span=10..20, modifier_depth=1)
    ret v0
}

fn @load(arg0: u256) -> memorybytes {
  bb0:
    v0 = load_storage_bytes arg0 !metadata(span=20..30, modifier_depth=2)
    ret v0
}

fn @edge(arg0: bool, arg1: u256, arg2: memorybytes) -> memorybytes {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = load_storage_bytes arg1
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: v0], [bb2: arg2]
    ret v1
}

fn @clear(arg0: bool, arg1: u256, arg2: u256, arg3: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    clear_storage_words arg1, arg2, arg3 !metadata(span=30..40, modifier_depth=3)
    jump bb3
  bb2:
    jump bb3
  bb3:
    v0 = phi [bb1: 1], [bb2: 2]
    ret v0
}

fn @store(arg0: bool, arg1: u256, arg2: memorybytes) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    store_storage_bytes arg1, arg2 !metadata(span=40..50, modifier_depth=4)
    jump bb3
  bb2:
    jump bb3
  bb3:
    v0 = phi [bb1: 1], [bb2: 2]
    ret v0
}

fn @store_literal(arg0: bool, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    store_storage_bytes_literal arg1, hex"61" !metadata(span=50..60, modifier_depth=5)
    jump bb3
  bb2:
    store_storage_bytes_literal arg1, hex"6162636465666768696a6b6c6d6e6f707172737475767778797a3031323334353637"
    store_storage_bytes_literal arg1, hex""
    jump bb3
  bb3:
    v0 = phi [bb1: 1], [bb2: 2]
    ret v0
}
