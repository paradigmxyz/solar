//@compile-flags: -Zmir-pipeline=default -Zprint-after-stage
//@filecheck:
// A parsed ABI checkpoint must retain the calldata-slice type so intrinsic
// lowering expands the hidden external argument before the EVM boundary.
// CHECK-LABEL: checkpoint=mir.intrinsics
// CHECK: fn @bytesLen() [selector=0x12345678, arg_types=(u256)]
// CHECK-NOT: slice_len
// CHECK-LABEL: checkpoint=mir.evm-shaped
// CHECK: @phase evm-shaped
@module PhaseDynamicArgResume
@phase abi
fn @bytesLen() [selector=0x12345678, arg_types=(calldataslice)] {
  bb0:
    v0 = slice_len arg0
    mstore 128, v0
    returndata 128, 32
}
