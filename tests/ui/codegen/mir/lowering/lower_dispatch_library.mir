//@ compile-flags: -Zmir-pipeline=lower-dispatch
//@ filecheck:
// A library entry never checks `callvalue`: a `DELEGATECALL` sees the caller's
// value. Its non-view routes reject direct calls instead, each comparing the
// deployment address staged by the creation code against `address()` in its
// own case, so nothing is live across the switch for view routes to observe.
@module DispatchLibrary
@phase semantic
@library
immutables:
  library_deploy_address: address

// CHECK-LABEL: {{^[ +].*}}after lower-dispatch
// CHECK: + fn @entry{{[( ]}}
// CHECK-NOT: callvalue
// CHECK-NOT: loadimmutable
// CHECK: + switch {{.*}}[1 => [[VIEW:bb[0-9]+]], 2 => [[WRITE:bb[0-9]+]]]
// CHECK: + [[WRITE]]:
// CHECK-NEXT: + [[OWN:v[0-9]+]] = loadimmutable library_deploy_address
// CHECK-NEXT: + [[THIS:v[0-9]+]] = address
// CHECK-NEXT: + [[DIRECT:v[0-9]+]] = eq [[OWN]], [[THIS]]
// CHECK-NEXT: + jumpi [[DIRECT]], [[REVERT:bb[0-9]+]], [[GO:bb[0-9]+]]
// CHECK: + [[GO]]:
// CHECK-NEXT: + tail_call @write
// CHECK: + [[REVERT]]:
// CHECK-NEXT: + revert 0, 0
// CHECK: + [[VIEW]]:
// CHECK-NEXT: + tail_call @view
fn @view() [selector=0x00000001, view, abi_wrapper] {
  bb0:
    stop
}
fn @write() [selector=0x00000002, abi_wrapper] {
  bb0:
    stop
}
