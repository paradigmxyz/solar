//@ compile-flags: -Zmir-pipeline=lower-immutables
//@ filecheck:
@module LowerImmutables
immutables:
  first: u8
  second: bytes20

// CHECK-LABEL: @staged
// CHECK: -     storeimmutable first, arg0
// CHECK-NEXT: -     storeimmutable second, arg1
// CHECK-NEXT: +     mstore 192, arg0 !metadata(compiler_memory)
// CHECK-NEXT: +     mstore 224, arg1 !metadata(compiler_memory)
// CHECK-NEXT:       [[LOAD:v[0-9]+]] = loadimmutable first
// CHECK-NEXT:       ret [[LOAD]]
fn @staged(arg0: u8, arg1: bytes20) -> u8 {
  bb0:
    storeimmutable first, arg0
    storeimmutable second, arg1
    v0 = loadimmutable first
    ret v0
}

// CHECK-LABEL: fn @runtime
// CHECK: storeimmutable first, 1
fn @runtime() [selector=1] {
  bb0:
    storeimmutable first, 1
    stop
}

// CHECK-LABEL: fn @entry
// CHECK: -     storeimmutable first, 2
// CHECK: +     mstore 192, 2 !metadata(compiler_memory)
fn @entry() {
  bb0:
    storeimmutable first, 2
    stop
}

// CHECK-LABEL: fn @router
// CHECK: storeimmutable first, 3
fn @router() [entry] {
  bb0:
    storeimmutable first, 3
    stop
}

// CHECK-LABEL: + fn @constructor(arg0: u8, arg1: bytes20) -> (u8, bytes20)
// CHECK-NOT: + {{.*}}storeimmutable
// CHECK: + {{.*}}phi
// CHECK: + {{.*}}ret
fn @constructor(arg0: u8, arg1: bytes20) [unrestricted_memory] {
  bb0:
    v0 = loadimmutable first
    sstore 0, v0
    v1 = iszero arg0
    jumpi v1, bb1, bb2
  bb1:
    tail_call @panic_chain
  bb2:
    v2 = eq arg0, 1
    jumpi v2, bb3, bb4
  bb3:
    storeimmutable first, arg0
    storeimmutable second, arg1
    jump bb5
  bb4:
    storeimmutable first, 2
    storeimmutable second, arg1
    jump bb5
  bb5:
    v3 = icall @reader, 1
    sstore 1, v3
    v4 = eq arg0, 3
    jumpi v4, bb6, bb7
  bb6:
    storeimmutable first, arg0
    jump bb5
  bb7:
    v5 = eq arg0, 4
    jumpi v5, bb8, bb9
  bb8:
    stop
  bb9:
    storeimmutable first, 4
    stop
  bb10:
    jump bb5
}

fn @reader() -> u8 {
  bb0:
    v0 = loadimmutable first
    ret v0
}

fn @panic_chain() {
  bb0:
    tail_call @panic
}

fn @panic() {
  bb0:
    revert 0, 0
}
