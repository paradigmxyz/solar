//@ revisions: mapping frame alloc
//@ compile-flags: -Zdebugify=check
//@[mapping] compile-flags: -Zmir-pipeline=lower-mapping-slots
//@[frame] compile-flags: -Zmir-pipeline=lower-frame-slots
//@[alloc] compile-flags: -Zmir-pipeline=lower-alloc
// Every operation has its own context. Expansions must inherit that operation's source,
// including allocations that split the block, without carrying the previous operation's span.
@module DebugExpansions
fn @slot(arg0: i256) -> i256 {
  bb0:
    v0 = mapping_slot arg0, 7 !metadata(span=10..20)
    v1 = mapping_slot arg0, 9 !metadata(span=20..30)
    v2 = add v0, v1
    ret v2 !metadata(span=70..80)
}
fn @frame(arg0: i256) -> i256 {
  bb0:
    frame_store scratch, word, 0, arg0 !metadata(span=30..40)
    v0 = frame_load scratch, word, 0 !metadata(span=40..50)
    ret v0 !metadata(span=70..80)
}
fn @allocate(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = alloc zeroed checked arg0 !metadata(span=50..60, preserves_fmp)
    ret v0 !metadata(span=70..80)
}
