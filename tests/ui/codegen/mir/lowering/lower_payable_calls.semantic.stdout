- // === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (before none) ===
+ // === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (after none) ===
  @module PayableCalls
  fn @send_value(arg0: address, arg1: u256) -> u256 {
    bb0:
      v0 = send arg0, arg1 !metadata(span=10..20, modifier_depth=2)
      ret v0
  }
  
  fn @transfer_value(arg0: bool, arg1: address, arg2: u256) -> u256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      transfer arg1, arg2 !metadata(span=30..40, modifier_depth=3)
      v0 = send arg1, 0
      transfer arg1, 1
      jump bb3
    bb3:
      v1 = phi [bb1: v0], [bb2: 0]
      ret v1
  }
  
