- ; === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (before none) ===
+ ; === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (after none) ===
  @module PayableCalls
  fn @send_value(arg0: i160, arg1: i256) -> i256 {
    bb0:
      v0 = address_call<> arg0, gas 0x8fc, value arg1 !metadata(span=10..20, modifier_depth=2)
      v1 = zext i1 v0 to i256
      ret v1
  }
  
  fn @transfer_value(arg0: i1, arg1: i160, arg2: i256) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:                                            ; preds = bb0
      jump bb3
    bb1:                                            ; preds = bb0
      address_call<revert> arg1, gas 0x8fc, value arg2 !metadata(span=30..40, modifier_depth=3)
      v0 = address_call<> arg1, gas 0x8fc, value 0
      v1 = zext i1 v0 to i256
      address_call<revert> arg1, gas 0, value 1
      jump bb3
    bb3:                                            ; preds = bb1, bb2
      v2 = phi [bb1: v1], [bb2: 0]
      ret v2
  }
  
