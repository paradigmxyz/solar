- // === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (before none) ===
+ // === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (after none) ===
  @module PayableCalls
  fn @send_value(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = icall send<>, arg0, arg1 !metadata(span=10..20, modifier_depth=2)
      ret v0
  }
  
  fn @transfer_value(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      icall transfer<>, arg1, arg2 !metadata(span=30..40, modifier_depth=3)
      v0 = icall send<>, arg1, 0
      icall transfer<>, arg1, 1
      jump bb3
    bb3:
      v1 = phi [bb1: v0], [bb2: 0]
      ret v1
  }
  
