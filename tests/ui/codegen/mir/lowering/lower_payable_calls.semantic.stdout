- ; === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (before none) ===
+ ; === ROOT/tests/ui/codegen/mir/lowering/lower_payable_calls.mir (after none) ===
  @module PayableCalls
  fn @send_value(arg0: i160, arg1: i256) -> i256 {
    bb0:
      v0 = extcall arg0, gas 0x8fc, value arg1 !metadata(span=10..20, modifier_depth=2)
      v1 = zext i1 v0 to i256
      ret v1
  }
  
  fn @transfer_value(arg0: i1, arg1: i160, arg2: i256) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:                                            ; preds = bb0
      jump bb3
    bb1:                                            ; preds = bb0
      v0 = extcall arg1, gas 0x8fc, value arg2 !metadata(span=30..40, modifier_depth=3)
      v1 = extcall arg1, gas 0x8fc, value 0
      v2 = zext i1 v1 to i256
      v3 = extcall arg1, gas 0, value 1
      jump bb3
    bb3:                                            ; preds = bb1, bb2
      v4 = phi [bb1: v2], [bb2: 0]
      ret v4
  }
  
