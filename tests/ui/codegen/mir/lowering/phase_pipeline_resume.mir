//@ revisions: default fold
//@[default] compile-flags: -Zmir-pipeline=default
//@[default] filecheck: --check-prefix=DEFAULT
//@[fold] compile-flags: -Zmir-pipeline=const-fold,branch-simplify,dce
//@[fold] filecheck: --check-prefix=FOLD
// DEFAULT: @module PhasePipelineResume
// DEFAULT-NEXT: @phase lowered
// The canonical pipeline resumes progressive lowering when the input has
// already passed the optimization phase.
@module PhasePipelineResume
@phase semantic
fn @ping() [selector=0x5c36b186, abi_wrapper] {
  bb0:
    stop
}

// FOLD-LABEL: {{^[ +].*}}fn @constants
// FOLD: - {{v[0-9]+}} = sub arg0, arg0
// FOLD: - {{v[0-9]+}} = eq {{v[0-9]+}}, 0
// FOLD: {{^[ +].*}}[[ALIAS:v[0-9]+]] = add arg0, 0
// FOLD-NEXT: {{^[ +].*}}[[PRODUCT:v[0-9]+]] = mul [[ALIAS]], 8
// FOLD: + sstore 0, 0
// FOLD: + jumpi true, bb1, bb2
fn @constants(arg0: i256) -> i256 {
  bb0:
    v1 = sub arg0, arg0
    v2 = eq v1, 0
    v3 = add arg0, 0
    v4 = mul v3, 8
    sstore 0, v1
    jumpi v2, bb1, bb2
  bb1:
    ret v4
  bb2:
    ret 999
}

// FOLD-LABEL: {{^[ +].*}}fn @constant_phi
// FOLD: - {{v[0-9]+}} = phi [bb1: 42], [bb2: 42]
// FOLD: + ret 42
fn @constant_phi(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v0 = phi [bb1: 42], [bb2: 42]
    ret v0
}

// FOLD-LABEL: {{^[ +].*}}fn @pointer_constant
// FOLD: + ret memptr 7
fn @pointer_constant() -> memptr {
  bb0:
    v0 = inttoptr i256 7 to memptr
    ret v0
}

// FOLD-LABEL: {{^[ +].*}}fn @low_bit_constant
// FOLD: + ret false
fn @low_bit_constant() -> i1 {
  bb0:
    v0 = trunc i256 2 to i1
    ret v0
}

// FOLD-LABEL: {{^[ +].*}}fn @sign_extended_constant
// FOLD: + ret i160 0xffffffffffffffffffffffffffffffffffffffff
fn @sign_extended_constant() -> i160 {
  bb0:
    v0 = sext i1 1 to i160
    ret v0
}
