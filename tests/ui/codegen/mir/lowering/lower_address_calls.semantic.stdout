- // === ROOT/tests/ui/codegen/mir/lowering/lower_address_calls.mir (before none) ===
+ // === ROOT/tests/ui/codegen/mir/lowering/lower_address_calls.mir (after none) ===
  @module AddressCalls
  fn @default_call(arg0: i256, arg1: memorybytes) -> i256 {
    bb0:
      v0 = address_call arg0, arg1 !metadata(span=10..20, modifier_depth=2)
      v1 = zext i1 v0 to i256
      ret v1
  }
  
  fn @explicit_zero(arg0: i256, arg1: memorybytes, arg2: i256) -> memorybytes {
    bb0:
      v0 = address_call arg0, arg1, gas arg2, value 0
      v1 = icall returndata_bytes<> !metadata(span=30..40, modifier_depth=3)
      ret v1
  }
  
  fn @delegate(arg0: i256, arg1: memorybytes) -> i256 {
    bb0:
      v0 = address_delegatecall arg0, arg1, gas 0x186a0
      v1 = zext i1 v0 to i256
      ret v1
  }
  
  fn @zero_value(arg0: i256, arg1: memorybytes) -> i256 {
    bb0:
      v0 = address_call arg0, arg1, value 0
      v1 = zext i1 v0 to i256
      ret v1
  }
  
