//@compile-flags: -Zmir-pipeline=lower-abi
//@filecheck:

// CHECK: + @phase abi
// CHECK: + fn @constructor(arg0: u256, arg1: u256, arg2: u256, arg3: u256, arg4: u256)
// CHECK-NOT: abi_args
// CHECK-NOT: abi_params
// CHECK: + [[BASE:v[0-9]+]] = constructor_args_base
// CHECK: + [[END:v[0-9]+]] = constructor_args_end
// CHECK: + [[REQUIRED:v[0-9]+]] = add [[BASE]], 160
// CHECK: + {{v[0-9]+}} = gt [[REQUIRED]], [[END]]
// CHECK: + {{v[0-9]+}} = add {{v[0-9]+}}, arg4
// CHECK: + [[OUTER:v[0-9]+]] = alloc memoryfixedarray<2, 1>
// CHECK: + [[FIRST:v[0-9]+]] = alloc memoryfixedarray<2, 1>
// CHECK: + memory_object_store_element memoryfixedarray<2, 1>, [[FIRST]], 0, arg0
// CHECK: + memory_object_store_element memoryfixedarray<2, 1>, [[FIRST]], 1, arg1
// CHECK: + memory_object_store_element memoryfixedarray<2, 1>, [[OUTER]], 0, [[FIRST]]
// CHECK: + [[SECOND:v[0-9]+]] = alloc memoryfixedarray<2, 1>
// CHECK: + memory_object_store_element memoryfixedarray<2, 1>, [[SECOND]], 0, arg2
// CHECK: + memory_object_store_element memoryfixedarray<2, 1>, [[SECOND]], 1, arg3
// CHECK: + memory_object_store_element memoryfixedarray<2, 1>, [[OUTER]], 1, [[SECOND]]
@module LowerAbiConstructorParams

fn @constructor(arg0: memoryfixedarray, arg1: u256) [abi_args=lazy, abi_params=[array<2, array<2, u256>>, u256]] {
  bb0:
    v0 = memory_object_load_element memoryfixedarray<2, 1>, arg0, 1
    v1 = memory_object_load_element memoryfixedarray<2, 1>, v0, 0
    v2 = add v1, arg1
    mstore 0, v2
    stop
}
