//@compile-flags: -Zmir-pipeline=lower-abi
//@filecheck:

// CHECK: + fn @constructor(arg0: i256, arg1: i256, arg2: i256, arg3: i256, arg4: i256)
// CHECK-NOT: abi_params
// CHECK: + [[VALUE:v[0-9]+]] = callvalue
// CHECK: + [[CONDITION:v[0-9]+]] = ne [[VALUE]], 0
// CHECK: + jumpi [[CONDITION]],
// CHECK: + [[BASE:v[0-9]+]] = constructor_args_base
// CHECK: + [[END:v[0-9]+]] = constructor_args_end
// CHECK: + [[REQUIRED:v[0-9]+]] = add [[BASE]], 160
// CHECK: + {{v[0-9]+}} = gt [[REQUIRED]], [[END]]
// CHECK: + [[OUTER:v[0-9]+]] = alloc memoryfixedarray<2, 1>
// CHECK: + [[OUTER_INDEX:v[0-9]+]] = phi
// CHECK: + {{v[0-9]+}} = lt [[OUTER_INDEX]], 2
// CHECK: + {{v[0-9]+}} = add {{v[0-9]+}}, arg4
// CHECK: + {{v[0-9]+}} = mul [[OUTER_INDEX]], 64
// CHECK: + [[INNER:v[0-9]+]] = alloc memoryfixedarray<2, 1>
// CHECK: + [[INNER_INDEX:v[0-9]+]] = phi
// CHECK: + {{v[0-9]+}} = lt [[INNER_INDEX]], 2
// CHECK: + [[OUTER_VIEW:v[0-9]+]] = make_memory_slice [[OUTER]], 2
// CHECK-NEXT: + [[OFF1:v[0-9]+]] = shl 5, [[OUTER_INDEX]]
// CHECK-NEXT: + [[INNER_PTR:v[0-9]+]] = ptrtoint memptr [[INNER]] to i256
// CHECK-NEXT: + slice_store_word [[OUTER_VIEW]], [[OFF1]], [[INNER_PTR]]
// CHECK: + {{v[0-9]+}} = mul [[INNER_INDEX]], 32
// CHECK: + [[WORD:v[0-9]+]] = mload
// CHECK-NEXT: + [[INNER_VIEW:v[0-9]+]] = make_memory_slice [[INNER]], 2
// CHECK-NEXT: + [[OFF2:v[0-9]+]] = shl 5, [[INNER_INDEX]]
// CHECK-NEXT: + slice_store_word [[INNER_VIEW]], [[OFF2]], [[WORD]]
@module LowerAbiConstructorParams

fn @constructor(arg0: memptr, arg1: i256) [abi_params=[array<2, array<2, u256>>, u256]] {
  bb0:
    v4 = make_memory_slice arg0, 2
    v0 = slice_load_word v4, 32
    v3 = inttoptr i256 v0 to memptr
    v5 = make_memory_slice v3, 2
    v1 = slice_load_word v5, 0
    v2 = add v1, arg1
    mstore 0, v2
    stop
}
