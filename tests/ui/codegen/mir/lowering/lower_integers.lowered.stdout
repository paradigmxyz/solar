      v0 = and arg0, 255
      v1 = eq arg0, v0
      jumpi v1, bb1, bb2
    bb2:
      ret 0
    bb1:
      ret arg0
  }
  
  fn @guarded_effect_mask(arg0: i256) -> i256 {
    bb0:
