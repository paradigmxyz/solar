      jumpi v0, bb2, bb1
    bb1:
      v3 = sub arg0, arg1
      v1 = and v3, 255
      ret v1
    bb2:
      v4 = sub arg0, arg1
      v2 = and v4, 255
      ret v2
  }
  
  fn @signed_immutable() -> i256 {
    bb0:
      v2: i256 = loadimmutable signed
      v0 = and v2, 0xffffffffffffffff
      ret v0
  }
  
