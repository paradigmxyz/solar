//@compile-flags: -Zmir-pipeline=lower-evm-shaped
//@filecheck: --match-full-lines
// CHECK:   @phase intrinsics-lowered
// CHECK-NOT: + @phase evm-shaped
@module LowerEvmShapedRequiresAlloc
@phase intrinsics-lowered

// CHECK-LABEL:   fn @entry{{.*}}
// CHECK:     v0 = fmp
// CHECK-NEXT:     stop
fn @entry() [entry] {
  bb0:
    v0 = fmp
    stop
}
