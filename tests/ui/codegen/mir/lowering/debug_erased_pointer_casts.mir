//@ compile-flags: -Zmir-pipeline=lower-alloc,lower-evm-shaped -Zdebugify=report
// Representation lowering erases pointer casts. A cast's origin moves onto the word it passes
// through when the spans nest, and is dropped when they are unrelated.
@module DebugErasedPointerCasts
fn @enclosing() -> i256 {
  bb0:
    v0 = alloc 32 !metadata(span=12..14, preserves_fmp)
    v1 = ptrtoint ptr<memory> v0 to i256 !metadata(span=10..20)
    ret v1 !metadata(span=100..110)
}
fn @unrelated() -> i256 {
  bb0:
    v0 = alloc 32 !metadata(span=52..54, preserves_fmp)
    v1 = ptrtoint ptr<memory> v0 to i256 !metadata(span=60..70)
    ret v1 !metadata(span=100..110)
}
