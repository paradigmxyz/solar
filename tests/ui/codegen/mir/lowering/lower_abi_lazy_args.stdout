- // === ROOT/tests/ui/codegen/mir/lowering/lower_abi_lazy_args.mir (before lower-abi) ===
+ // === ROOT/tests/ui/codegen/mir/lowering/lower_abi_lazy_args.mir (after lower-abi) ===
  @module LowerAbiLazyArgs
- fn @flag(arg0: bool) -> bool [abi_args=lazy, abi_returns=[word]] {
+ @phase abi
+ fn @flag() {
    bb0:
-     ret arg0
+     v0 = calldatasize
+     v1 = lt v0, 36
+     jumpi v1, bb2, bb3
+   bb1:
+     v7 = iszero arg0
+     v8 = iszero v7
+     mstore 128, v8
+     v9 = add 128, 32
+     v10 = sub v9, 128
+     returndata 128, v10
+   bb2:
+     revert 0, 0
+   bb3:
+     v2 = make_calldata_slice 4, 32
+     v3 = calldata_slice_load_word calldata, v2, 0
+     v4 = iszero v3
+     v5 = iszero v4
+     v6 = eq v3, v5
+     jumpi v6, bb4, bb2
+   bb4:
+     jump bb1
  }
  
