//@ compile-flags: -Zmir-pipeline=lower-dispatch
//@ filecheck:
// Textual MIR does not record source variables, so a contract's own immutable
// named like the library deployment address must not turn its non-view routes
// into guarded library entries: only a `@library` module carries the guard.
@module NamedImmutable
@phase abi
immutables:
  library_deploy_address: address

// CHECK-LABEL: {{^[ +].*}}after lower-dispatch
// CHECK: + fn @entry{{[( ]}}
// CHECK: + [[VALUE:v[0-9]+]] = callvalue
// CHECK: + jumpi [[VALUE]]
// CHECK-NOT: loadimmutable
// CHECK-NOT: address
// CHECK: + tail_call @write
fn @write() [selector=0x00000002] {
  bb0:
    stop
}
