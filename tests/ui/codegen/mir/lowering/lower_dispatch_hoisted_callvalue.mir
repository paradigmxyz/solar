//@compile-flags: -Zmir-pipeline=lower-dispatch
//@filecheck:
// When every external entry rejects value, the callvalue check is hoisted to
// the top of `entry` once instead of being repeated per case. No
// receive/fallback: empty calldata and unknown selectors both revert.
@module DispatchHoisted
@phase semantic
// CHECK-LABEL: {{^[ +].*}}after lower-dispatch
// CHECK: + fn @entry{{[( ]}}
// CHECK: + [[VALUE:v[0-9]+]] = callvalue
// CHECK: + [[CONDITION:v[0-9]+]] = ne [[VALUE]], 0
// CHECK: + jumpi [[CONDITION]]
// CHECK-NOT: calldatasize
// CHECK: + switch {{.*}}[1 => {{.*}}2 =>
// CHECK: + tail_call @b
// CHECK: + tail_call @a
fn @a() [selector=0x00000001, abi_wrapper] {
  bb0:
    stop
}
fn @b() [selector=0x00000002, abi_wrapper] {
  bb0:
    stop
}
