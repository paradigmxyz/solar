//@compile-flags: -Zmir-pipeline=lower-intrinsics
//@filecheck:
@module LowerIntrinsics
@library
@phase dispatch

// CHECK-LABEL: after lower-intrinsics
// CHECK: + @phase intrinsics-lowered
// CHECK: -     v0 = mapping_slot
// CHECK: -     v1 = abi_encode
// CHECK: -     v2 = slice_ptr
// CHECK: +     {{v[0-9]+}} = keccak256
fn @combined(arg0: u256) -> u256 {
  bb0:
    v0 = mapping_slot arg0, 7
    v1 = abi_encode [word], args arg0
    v2 = slice_ptr v1
    v3 = mload v2
    v4 = add v0, v3
    ret v4
}
