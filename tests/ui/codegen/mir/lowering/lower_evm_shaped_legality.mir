//@revisions: blocked lowered
//@[blocked] compile-flags: -Zmir-pipeline=lower-evm-shaped
//@[lowered] compile-flags: -Zmir-pipeline=lower-mapping-slots,lower-integers,lower-evm-shaped
//~[blocked]? ERROR: storage slot instruction `storage_array_data_slot` survives the `lowered` phase boundary
//@[lowered] filecheck: --check-prefix=LOWERED
@module LowerEvmShapedLegality

// The phase gate must consult the operation schema: a semantic slot operation
// is not ready for the EVM backend until its lowering pass has consumed it.
// LOWERED: + @phase lowered
fn @entry() [entry] {
  bb0:
    v0 = storage_array_data_slot 7
    v1 = sload v0
    mstore 128, v1
    returndata 128, 32
}

//~[blocked]? ERROR: narrow integer arithmetic instruction `add` survives the `lowered` phase boundary
//~[blocked]? ERROR: narrow integer arithmetic instruction `slt` survives the `lowered` phase boundary
fn @boolean_arithmetic(arg0: i1, arg1: i1) -> i1 {
  bb0:
    v0 = add arg0, arg1
    v1 = slt v0, arg1
    ret v1
}
