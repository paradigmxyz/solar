//@compile-flags: -Zmir-pipeline=lower-abi
//@filecheck:

// CHECK: + fn @read()
// CHECK: + v{{[0-9]+}} = calldatasize
@module LowerAbiParams

fn @read(arg0: ptr<memory>, arg1: i256) -> i256 [selector=0x12345678, abi_params=[array<3, uint256>, uint256], abi_returns=[word]] {
  bb0:
    ret arg1
}

// CHECK: + fn @read_words()
// CHECK: + {{v[0-9]+}} = calldataload
// CHECK: + [[TUPLE:v[0-9]+]] = alloc 96
// CHECK: + [[ARR:v[0-9]+]] = alloc
// CHECK: + mstore [[ARR]],
// CHECK: + [[DATA:v[0-9]+]] = ptradd [[ARR]], 32
// CHECK: + calldatacopy [[DATA]],
// CHECK-NEXT: + [[ARR_WORD:v[0-9]+]] = ptrtoint ptr<memory> [[ARR]] to i256
// CHECK-NEXT: + mstore [[TUPLE]], [[ARR_WORD]]
fn @read_words(arg0: ptr<memory>) -> i256 [selector=0x12345679, abi_params=[tuple<array<_, uint256>, uint256>], abi_returns=[word]] {
  bb0:
    v1 = mload arg0
    v6 = inttoptr i256 v1 to ptr<memory>
    v2 = mload v6
    v3 = ptradd arg0, 32
    v4 = mload v3
    v5 = add v2, v4
    ret v5
}

// The address follows three physical head words, so its proof belongs to arg3.
// CHECK: + fn @read_address()
// CHECK: + [[RAW:v[0-9]+]] = calldataload 100
// CHECK: + [[HIGH:v[0-9]+]] = shr [[RAW]], 160
// CHECK: + {{v[0-9]+}} = ne [[HIGH]], 0
// CHECK-NOT: {{^[ +].*}}= zext
// CHECK: + mstore 0, arg3
fn @read_address(arg0: ptr<memory>, arg1: i256) -> i256 [selector=0x12345680, abi_params=[array<3, uint256>, address], abi_returns=[word]] {
  bb0:
    v0 = trunc i256 arg1 to i160
    v1 = zext i160 v0 to i256
    ret v1
}

// A word behind the largest static array loads directly instead of taking a
// lazy argument for every head word before it.
// CHECK: + fn @read_after_huge()
// CHECK: + [[WORD:v[0-9]+]] = calldataload 0xffffffe4
// CHECK: + mstore 0, [[WORD]]
fn @read_after_huge(arg0: ptr<memory>, arg1: i256) -> i256 [selector=0x12345686, abi_params=[array<134217727, uint256>, uint256], abi_returns=[word]] {
  bb0:
    ret arg1
}

// CHECK: + fn @address_is_zero()
// CHECK: + {{v[0-9]+}} = calldataload 4
// CHECK: = eq arg0, 0
fn @address_is_zero(arg0: i256) -> i1 [selector=0x12345681, abi_params=[address], abi_returns=[word]] {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = eq v0, i160 0
    ret v1
}

// An unconstrained ABI word does not supply an address-width proof.
// CHECK: + fn @dirty_address()
// CHECK: = trunc i256 arg0 to i160
// CHECK: = zext i160
fn @dirty_address(arg0: i256) -> i256 [selector=0x12345682, abi_params=[uint256], abi_returns=[word]] {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    ret v1
}

fn @validated_forward(arg0: i256) -> i256 [selector=0x12345683, abi_params=[address], abi_returns=[word]] {
  bb0:
    v0 = icall @validated_leaf, arg0
    ret v0
}

// A freshly generated ABI guard proves the argument through an internal call.
// CHECK-LABEL: fn @validated_leaf
// CHECK-NOT: {{^[ +].*}}= zext
// CHECK: + ret arg0
fn @validated_leaf(arg0: i256) -> i256 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    ret v1
}

fn @validated_mixed(arg0: i256) -> i256 [selector=0x12345684, abi_params=[address], abi_returns=[word]] {
  bb0:
    v0 = icall @mixed_leaf, arg0
    ret v0
}

fn @unvalidated_mixed(arg0: i256) -> i256 [selector=0x12345685, abi_params=[uint256], abi_returns=[word]] {
  bb0:
    v0 = icall @mixed_leaf, arg0
    ret v0
}

// Every caller must prove the bound; the raw-word wrapper prevents removal.
// CHECK-LABEL: fn @mixed_leaf
// CHECK: = trunc i256 arg0 to i160
// CHECK: = zext i160
fn @mixed_leaf(arg0: i256) -> i256 {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    ret v1
}
