//@ compile-flags: -Zmir-pipeline=lower-abi
// An empty static array has an empty head, but like solc the decoder still requires a word
// where it starts. A decoder that static slice inputs share takes the whole slice when the
// layout holds an empty array, since the head size alone no longer bounds the input.
@module LowerAbiDecodeEmptyArray

fn @inline(arg0: memptr) {
  bb0:
    v0 = abi_decode [u256, array<0, u256>], arg0
    stop
}

fn @shared(arg0: i256, arg1: i256) {
  bb0:
    v0 = make_memory_slice arg0, arg1
    v1 = abi_decode [array<0, u256>], v0
    v2 = make_memory_slice arg1, arg0
    v3 = abi_decode [array<0, u256>], v2
    stop
}
