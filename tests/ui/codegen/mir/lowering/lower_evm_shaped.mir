//@compile-flags: -Zmir-pipeline=lower-evm-shaped
//@filecheck:
// A resultless internal call to a callee that never returns (no `ret`, no
// `stop` — it ends in `returndata`) models a returning edge that does not
// exist. The evm-shaped phase rewrites it into a `tail_call` — arguments
// included — and drops the dead remainder of the block. The rewrite only
// applies to callees the backend statically frames: `@spin` cannot return
// either, but it is recursive, so its call stays an ordinary `icall`.
// `@entry` is present so the module satisfies the memory-lowered phase contract.
@module LowerEvmShaped
@phase memory-lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v2 = shr 224, v0
    switch v2, default bb2, [7 => bb1]
  bb1:
    tail_call fn1
  bb2:
    revert 0, 0
}
// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: - icall @fused
// CHECK: + tail_call @fused, {{v[0-9]+}} !metadata(span=10..20, modifier_depth=1)
fn @caller() [selector=0x00000007] {
  bb0:
    v0 = calldataload 4
    icall fn2, 0, v0 !metadata(span=10..20, modifier_depth=1)
    stop !metadata(span=30..40, modifier_depth=2)
}
fn @fused(arg0: u256) {
  bb0:
    mstore 128, arg0
    returndata 128, 32
  bb1:
    stop
}
// CHECK-LABEL: {{^[ +].*}}fn @spin{{[( ]}}
// CHECK: {{^[ +].*}}icall @spin
fn @spin(arg0: u256) {
  bb0:
    icall fn3, 0, arg0
    revert 0, 0
}

// A backedge phi copy must not overwrite the previous value used on the exit edge.
// CHECK-LABEL: {{^[ +].*}}fn @live_on_sibling{{[( ]}}
// CHECK: + [[LOOP_VALUE:v[0-9]+]] = phi {{\[}}bb0: 0], {{\[}}[[LIVE_EDGE:bb[0-9]+]]: [[NEXT_VALUE:v[0-9]+]]]
// CHECK: + jumpi arg0, [[LIVE_EDGE]], bb3
// CHECK: + [[LIVE_EDGE]]:
// CHECK-NEXT: + jump bb1
fn @live_on_sibling(arg0: bool) -> u256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v2]
    v2 = add v1, 1
    jumpi v2, bb2, bb3
  bb2:
    jumpi arg0, bb1, bb3
  bb3:
    ret v1
}

// A phi destination used by the branch itself must also survive until the edge is selected.
// CHECK-LABEL: {{^[ +].*}}fn @used_by_terminator{{[( ]}}
// CHECK: + [[CONDITION:v[0-9]+]] = phi {{\[}}bb0: 1], {{\[}}[[CONDITION_EDGE:bb[0-9]+]]: {{v[0-9]+}}]
// CHECK: + jumpi [[CONDITION]], [[CONDITION_EDGE]], bb3
fn @used_by_terminator() -> u256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 1], [bb2: v2]
    v2 = sub v1, 1
    jump bb2
  bb2:
    jumpi v1, bb1, bb3
  bb3:
    ret 7
}

// The same rule applies to a switch edge, including duplicate cases for one logical edge.
// CHECK-LABEL: {{^[ +].*}}fn @switch_edge{{[( ]}}
// CHECK: + {{v[0-9]+}} = phi {{\[}}bb0: 0], {{\[}}[[SWITCH_EDGE:bb[0-9]+]]: {{v[0-9]+}}]
// CHECK: + switch arg0, default [[SWITCH_EDGE]], {{\[}}1 => [[SWITCH_EDGE]], 2 => bb3]
fn @switch_edge(arg0: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v2]
    v2 = add v1, 1
    jump bb2
  bb2:
    switch arg0, default bb1, [1 => bb1, 2 => bb3]
  bb3:
    ret v1
}

// Keep the original edge when its phi destination is dead on every sibling path.
// CHECK-LABEL: {{^[ +].*}}fn @dead_on_sibling{{[( ]}}
// CHECK-NOT: + bb
fn @dead_on_sibling(arg0: bool) -> u256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: 1]
    jump bb2
  bb2:
    jumpi arg0, bb1, bb3
  bb3:
    ret 7
}
