//@ revisions: semantic lowered
//@[semantic] compile-flags: -Zmir-pipeline=none
//@[lowered] compile-flags: -Zmir-pipeline=lower-abi
// An empty tuple decodes no values, so the instruction has no result and lowers to the
// tuple size check alone, which rejects a length with the sign bit set like any other
// decode shorter than its head.
@module LowerAbiDecodeEmpty

fn @empty(arg0: memptr) {
  bb0:
    abi_decode [], arg0
    stop
}

fn @word(arg0: memptr) -> i256 {
  bb0:
    v0 = abi_decode [u256], arg0
    ret v0
}
