@module PhasePipelineResume
@phase lowered
fn @ping() [selector=0x5c36b186, abi_wrapper] {
  bb0:
    stop
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb3, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb3, [0x5c36b186 => bb2]
  bb2:
