// A dynamic array repeated inside a struct decodes through one shared helper, which takes the
// base of the enclosing struct, instead of inline at every field, in calldata entries and in
// memory `abi.decode`. Each field's offset and length are still checked against the input.

// CHECK-LABEL: fn @sum
// CHECK: icall @[[ARRAY:decode_calldata_type[.0-9]*]], {{v[0-9]+}}, [[BASE:v[0-9]+]]
// CHECK: icall @[[ARRAY]], {{v[0-9]+}}, [[BASE]]
// CHECK-LABEL: fn @sumDecoded
// CHECK: icall @[[MEMORY:decode_memory_type[.0-9]*]], {{v[0-9]+}}, [[BASE:v[0-9]+]], {{v[0-9]+}}
// CHECK: icall @[[MEMORY]], {{v[0-9]+}}, [[BASE]], {{v[0-9]+}}
// CHECK: fn @[[ARRAY]]
// CHECK: fn @[[MEMORY]]

struct Pair {
    uint256[] first;
    uint256[] second;
}

struct Narrow {
    uint8[] first;
    uint8[] second;
}

struct Grid {
    uint256[][] first;
    uint256[][] second;
}

contract SharedNestedArrays {
    function sum(Pair memory pair) external pure returns (uint256 total) {
        for (uint256 i; i < pair.first.length; ++i) total += pair.first[i];
        for (uint256 i; i < pair.second.length; ++i) total += pair.second[i];
    }

    function sumDecoded(bytes memory data) external pure returns (uint256 total) {
        Pair memory pair = abi.decode(data, (Pair));
        for (uint256 i; i < pair.first.length; ++i) total += pair.first[i];
        for (uint256 i; i < pair.second.length; ++i) total += pair.second[i];
    }

    function narrow(Narrow memory n) external pure returns (uint256 total) {
        for (uint256 i; i < n.first.length; ++i) total += n.first[i];
        for (uint256 i; i < n.second.length; ++i) total += n.second[i];
    }

    function grid(Grid memory g) external pure returns (uint256 total) {
        for (uint256 i; i < g.first.length; ++i) {
            for (uint256 j; j < g.first[i].length; ++j) total += g.first[i][j];
        }
        for (uint256 i; i < g.second.length; ++i) {
            for (uint256 j; j < g.second[i].length; ++j) total += g.second[i][j];
        }
    }
}
