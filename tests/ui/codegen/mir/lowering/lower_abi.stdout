      v0 = add arg0, arg1
      mstore 128, v0
      returndata 128, 32
+   bb2:
+     revert 0, 0
+   bb3:
+     jump bb1
  }
  
- fn @flag(arg0: bool) [selector=0x0d2020dd] {
+ fn @flag() [selector=0x0d2020dd] {
    bb0:
+     v0 = calldatasize
