//@ compile-flags: -Ogas -Zmir-pipeline=loop-idioms
//@ filecheck:
@module ZeroCountLoop
@phase lowered

// CHECK-LABEL: {{^[ +].*}}fn @count_zero{{[( ]}}
// CHECK: + [[FULL:v[0-9]+]] = and {{v[0-9]+}}, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
// CHECK: + [[INDEX:v[0-9]+]] = phi
// CHECK-NEXT: + [[COUNT:v[0-9]+]] = phi
// CHECK: + ret [[COUNT]]
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, 0x7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f
// CHECK: + {{v[0-9]+}} = mul {{v[0-9]+}}, 0x1010101010101010101010101010101
fn @count_zero(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v12]
    v1 = phi [bb0: 0], [bb5: v13]
    v2 = mload arg0
    v3 = lt v1, v2
    jumpi v3, bb2, bb6
  bb2:
    v4 = add arg0, 32
    v5 = add v4, v1
    v6 = mload v5
    v7 = byte 0, v6
    v8 = shl 248, v7
    v14 = ne v8, 0
    jumpi v14, bb5, bb3
  bb3:
    v9 = add v0, 1
    v15 = ne v9, 0
    jumpi v15, bb5, bb4
  bb4:
    revert 0, 0
  bb5:
    v12 = phi [bb3: v9], [bb2: v0]
    v13 = add v1, 1
    jump bb1
  bb6:
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @count_zero_calldata{{[( ]}}
// CHECK: + {{v[0-9]+}} = calldataload {{v[0-9]+}}
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, 0x7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f
// CHECK: + {{v[0-9]+}} = mul {{v[0-9]+}}, 0x101010101010101010101010101010101010101010101010101010101010101
fn @count_zero_calldata(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v10]
    v1 = phi [bb0: 0], [bb5: v11]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb6
  bb2:
    v3 = add arg0, v1
    v4 = calldataload v3
    v5 = byte 0, v4
    v12 = ne v5, 0
    jumpi v12, bb5, bb3
  bb3:
    v6 = add v0, 1
    v13 = ne v6, 0
    jumpi v13, bb5, bb4
  bb4:
    revert 0, 0
  bb5:
    v10 = phi [bb3: v6], [bb2: v0]
    v11 = add v1, 1
    jump bb1
  bb6:
    ret v0
}

// Inlining into an ABI wrapper forwards the decoded memory payload pointer
// and length directly. This shape must not depend on finding an `mload` of the
// object length.
// CHECK-LABEL: {{^[ +].*}}fn @count_zero_memory_data{{[( ]}}
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, 0x7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f
// CHECK: + {{v[0-9]+}} = mul {{v[0-9]+}}, 0x1010101010101010101010101010101
fn @count_zero_memory_data(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v10]
    v1 = phi [bb0: 0], [bb5: v11]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb6
  bb2:
    v3 = add arg0, v1
    v4 = mload v3
    v5 = byte 0, v4
    v12 = eq v5, 0
    jumpi v12, bb3, bb5
  bb3:
    v6 = add v0, 1
    v13 = eq v6, 0
    jumpi v13, bb4, bb5
  bb4:
    revert 0, 0
  bb5:
    v10 = phi [bb3: v6], [bb2: v0]
    v11 = add v1, 1
    jump bb1
  bb6:
    ret v0
}

// SCCP can keep the source spelling `byte == 0`, placing the increment on the
// true edge, and express checked-add success as `incremented != 0`'s inverse.
// The idiom is independent of those branch polarities.
// CHECK-LABEL: {{^[ +].*}}fn @count_zero_eq{{[( ]}}
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, 0x7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f
// CHECK: + {{v[0-9]+}} = mul {{v[0-9]+}}, 0x1010101010101010101010101010101
fn @count_zero_eq(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v12]
    v1 = phi [bb0: 0], [bb5: v13]
    v2 = mload arg0
    v3 = lt v1, v2
    jumpi v3, bb2, bb6
  bb2:
    v4 = add arg0, 32
    v5 = add v4, v1
    v6 = mload v5
    v7 = byte 0, v6
    v14 = eq v7, 0
    jumpi v14, bb3, bb5
  bb3:
    v9 = add v0, 1
    v15 = eq v9, 0
    jumpi v15, bb4, bb5
  bb4:
    revert 0, 0
  bb5:
    v12 = phi [bb3: v9], [bb2: v0]
    v13 = add v1, 1
    jump bb1
  bb6:
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @count_zero_calldata_eq{{[( ]}}
// CHECK: + {{v[0-9]+}} = calldataload {{v[0-9]+}}
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, 0x7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f
// CHECK: + {{v[0-9]+}} = mul {{v[0-9]+}}, 0x101010101010101010101010101010101010101010101010101010101010101
fn @count_zero_calldata_eq(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v10]
    v1 = phi [bb0: 0], [bb5: v11]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb6
  bb2:
    v3 = add arg0, v1
    v4 = calldataload v3
    v5 = byte 0, v4
    v12 = eq v5, 0
    jumpi v12, bb3, bb5
  bb3:
    v6 = add v0, 1
    v13 = eq v6, 0
    jumpi v13, bb4, bb5
  bb4:
    revert 0, 0
  bb5:
    v10 = phi [bb3: v6], [bb2: v0]
    v11 = add v1, 1
    jump bb1
  bb6:
    ret v0
}

// The scan inlined into a larger function leaves to a block that goes on
// with its count and its index. That block is reached from a merge block
// carrying the result now, and reads it in place of the count and the length
// in place of the index, which is where the scan stopped.
// CHECK-LABEL: {{^[ +].*}}fn @count_zero_then_use{{[( ]}}
// CHECK: {{^ +}}[[PTR:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK-NEXT: {{^ +}}[[LEN:v[0-9]+]] = mload [[PTR]]
// CHECK: + [[RESULT:v[0-9]+]] = phi [bb{{[0-9]+}}: 0], [bb{{[0-9]+}}: v{{[0-9]+}}], [bb{{[0-9]+}}: v{{[0-9]+}}], [bb{{[0-9]+}}: v{{[0-9]+}}]
// CHECK-NEXT: {{^ +}}jump [[EXIT:bb[0-9]+]]
// CHECK-NEXT: + [[EXIT]]:
// CHECK-NEXT: + {{v[0-9]+}} = add [[RESULT]], [[RESULT]]
// CHECK-NEXT: + {{v[0-9]+}} = add {{v[0-9]+}}, [[LEN]]
fn @count_zero_then_use(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    v21 = ptrtoint memptr arg0 to i256
    v2 = mload v21
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v12]
    v1 = phi [bb0: 0], [bb5: v13]
    v3 = lt v1, v2
    jumpi v3, bb2, bb6
  bb2:
    v4 = add v21, 32
    v5 = add v4, v1
    v6 = mload v5
    v7 = byte 0, v6
    v8 = shl 248, v7
    v17 = ne v8, 0
    jumpi v17, bb5, bb3
  bb3:
    v9 = add v0, 1
    v18 = ne v9, 0
    jumpi v18, bb5, bb4
  bb4:
    revert 0, 0
  bb5:
    v12 = phi [bb3: v9], [bb2: v0]
    v13 = add v1, 1
    jump bb1
  bb6:
    v14 = add v0, v0
    v15 = add v14, v1
    v16 = add v15, arg1
    ret v16
}

// The header's condition is read after the loop, so the loop stays.
// CHECK-LABEL: {{^[ +].*}}fn @count_zero_condition_escapes{{[( ]}}
// CHECK-NOT: 0x7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f
fn @count_zero_condition_escapes(arg0: memptr) -> i256 {
  bb0:
    v22 = ptrtoint memptr arg0 to i256
    v2 = mload v22
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v12]
    v1 = phi [bb0: 0], [bb5: v13]
    v3 = lt v1, v2
    jumpi v3, bb2, bb6
  bb2:
    v4 = add v22, 32
    v5 = add v4, v1
    v6 = mload v5
    v7 = byte 0, v6
    v8 = shl 248, v7
    v19 = ne v8, 0
    jumpi v19, bb5, bb3
  bb3:
    v9 = add v0, 1
    v20 = ne v9, 0
    jumpi v20, bb5, bb4
  bb4:
    revert 0, 0
  bb5:
    v12 = phi [bb3: v9], [bb2: v0]
    v13 = add v1, 1
    jump bb1
  bb6:
    v21 = zext i1 v3 to i256
    v14 = add v0, v21
    ret v14
}
