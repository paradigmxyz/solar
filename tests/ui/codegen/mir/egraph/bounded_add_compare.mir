//@ compile-flags: -Zmir-pipeline=egraph
@module BoundedAddCompare
data:
  child_0: deferred creation 0

fn @masked(arg0: i256) -> i1 {
  bb0:
    v0 = and arg0, 255
    v1 = add v0, 32
    v2 = lt v1, v0
    ret v2
}

fn @data_size(arg0: i256) -> i1 {
  bb0:
    v0 = data_size child_0, 32
    v1 = add v0, 31
    v2 = lt v1, v0
    ret v2
}

fn @unbounded(arg0: i256) -> i1 {
  bb0:
    v0 = add arg0, 32
    v1 = lt v0, arg0
    ret v1
}

fn @addend_can_wrap(arg0: i256) -> i1 {
  bb0:
    v0 = and arg0, 255
    v1 = add v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v2 = lt v1, v0
    ret v2
}
