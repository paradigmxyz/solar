//@compile-flags: -Zmir-pipeline=egraph
@module AlternativeNumbering

fn @rewrite_then_original(arg0: word, arg1: word) -> word {
  bb0:
    v0 = sub arg0, arg1
    v1 = eq v0, 0
    v2 = eq arg0, arg1
    v4 = word_cast v1
    v5 = word_cast v2
    v3 = add v4, v5
    ret v3
}

fn @sibling_scope(arg0: bool, arg1: word, arg2: word) -> word {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = sub arg1, arg2
    v1 = eq v0, 0
    jump bb3
  bb2:
    v2 = xor arg1, arg2
    v3 = eq v2, 0
    jump bb3
  bb3:
    v4 = phi [bb1: v1], [bb2: v3]
    v5 = word_cast v4
    ret v5
}
