//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=egraph
//@[size] compile-flags: -Osize -Zmir-pipeline=egraph
@module ColdPricing

// A checked product by a constant is `x == 0 | x * c / x == c`, or `x < MAX / c + 1`. The second
// form costs fewer gas and a 32-byte push. Code that runs on a successful call takes it under
// `-Ogas`; code that only reverts keeps the smaller test, as a size build does.
fn @hot(arg0: i256) -> i1 {
  bb0:
    v0 = mul arg0, 54
    v1 = div v0, arg0
    v2 = eq v1, 54
    v3 = eq arg0, 0
    v4 = or v3, v2
    ret v4
}

// Only the block that reverts is cold.
fn @cold_block(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = mul arg0, 54
    v1 = div v0, arg0
    v2 = eq v1, 54
    v3 = eq arg0, 0
    v4 = or v3, v2
    jumpi v4, bb3, bb4
  bb2:
    v5 = mul arg0, 54
    v6 = div v5, arg0
    v7 = eq v6, 54
    v8 = eq arg0, 0
    v9 = or v8, v7
    v10 = zext i1 v9 to i256
    ret v10
  bb3:
    revert 0, 0
  bb4:
    revert 0, 0
}

// Every exit of a cold function reverts.
fn @cold_function(arg0: i256) -> i256 {
  bb0:
    v0 = mul arg0, 54
    v1 = div v0, arg0
    v2 = eq v1, 54
    v3 = eq arg0, 0
    v4 = or v3, v2
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    revert 0, 0
}
