//@compile-flags: -Zmir-pipeline=egraph,dce
//@filecheck:
@module MemoryObjectIdentityProjections

// CHECK-LABEL: {{^[ +].*}}fn @fold_identity_projections{{[( ]}}
// CHECK: - {{.*}}memory_object_data
// CHECK: - {{.*}}memory_object_field_addr
// CHECK: - {{.*}}memory_object_element_addr
// CHECK: {{^[ +].*}}[[LEFT:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} arg0
// CHECK: {{^[ +].*}}[[RIGHT:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} arg1
// CHECK: {{^[ +].*}}[[SAME:v[0-9]+]] = eq [[LEFT]], [[RIGHT]]
// CHECK: {{^[ +].*}}[[SAME_WORD:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} [[SAME]]
// CHECK: {{^[ +].*}}add [[SAME_WORD]], 1
fn @fold_identity_projections(arg0: memorystruct, arg1: memoryfixedarray) -> i256 {
  bb0:
    v10 = memory_object_data memorystruct, arg0
    v2 = ptrtoint memptr v10 to i256
    v11 = memory_object_field_addr memorystruct<2>, arg0, 0
    v3 = ptrtoint memptr v11 to i256
    v12 = memory_object_element_addr memoryfixedarray<4, 1>, arg1, 0
    v4 = ptrtoint memptr v12 to i256
    v5 = eq v2, v3
    v6 = eq v3, v4
    v8 = zext i1 v5 to i256
    v9 = zext i1 v6 to i256
    v7 = add v8, v9
    ret v7
}
