//@ compile-flags: -Zmir-pipeline=egraph,dce
@module Cancellation

// Cancellation is modulo 2^256; no no-overflow fact is needed.
fn @arithmetic(arg0: u256, arg1: u256) -> (u256, u256, u256, u256) {
  bb0:
    v2 = sub arg0, arg1
    v3 = add v2, arg1
    v4 = add arg1, v2
    v5 = add arg0, arg1
    v6 = sub v5, arg1
    v7 = sub v5, arg0
    ret v3, v4, v6, v7
}

// Zero-testing a difference and XOR both become equality.
fn @equality(arg0: u256, arg1: u256) -> (bool, bool) {
  bb0:
    v2 = sub arg0, arg1
    v3 = iszero v2
    v4 = xor arg0, arg1
    v5 = iszero v4
    ret v3, v5
}

// Rewrites must leave a difference that has another use available.
fn @shared_difference(arg0: u256, arg1: u256) -> (u256, bool) {
  bb0:
    v2 = sub arg0, arg1
    v3 = iszero v2
    ret v2, v3
}

fn @absorption(arg0: u256, arg1: u256) -> (u256, u256, u256, u256) {
  bb0:
    v2 = or arg0, arg1
    v3 = and arg0, v2
    v4 = and v2, arg1
    v5 = and arg0, arg1
    v6 = or arg0, v5
    v7 = or v5, arg1
    ret v3, v4, v6, v7
}

fn @xor_cancel(arg0: u256, arg1: u256) -> (u256, u256, u256, u256) {
  bb0:
    v2 = xor arg0, arg1
    v3 = xor arg0, v2
    v4 = xor arg1, v2
    v5 = xor v2, arg0
    v6 = xor v2, arg1
    ret v3, v4, v5, v6
}

// Similar shapes without the repeated operand must keep their computation.
fn @distinct_operands(arg0: u256, arg1: u256, arg2: u256) -> (u256, u256) {
  bb0:
    v3 = sub arg0, arg1
    v4 = add v3, arg2
    v5 = xor arg0, arg1
    v6 = xor v5, arg2
    ret v4, v6
}
