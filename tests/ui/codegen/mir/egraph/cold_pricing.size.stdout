- // === ROOT/tests/ui/codegen/mir/egraph/cold_pricing.mir (before egraph) ===
+ // === ROOT/tests/ui/codegen/mir/egraph/cold_pricing.mir (after egraph) ===
  @module ColdPricing
  fn @hot(arg0: i256) -> i1 {
    bb0:
      v0 = mul arg0, 54
      v1 = div v0, arg0
      v2 = eq v1, 54
      v3 = eq arg0, 0
      v4 = or v3, v2
      ret v4
  }
  
  fn @cold_block(arg0: i256, arg1: i1) -> i256 {
    bb0:
      jumpi arg1, bb1, bb2
    bb2:
      v5 = mul arg0, 54
      v6 = div v5, arg0
      v7 = eq v6, 54
      v8 = eq arg0, 0
      v9 = or v8, v7
      v10 = zext i1 v9 to i256
      ret v10
    bb1 [cold]:
      v0 = mul arg0, 54
      v1 = div v0, arg0
      v2 = eq v1, 54
      v3 = eq arg0, 0
      v4 = or v3, v2
      jumpi v4, bb3, bb4
    bb4 [cold]:
      revert 0, 0
    bb3 [cold]:
      revert 0, 0
  }
  
  fn @cold_function(arg0: i256) -> i256 [cold] {
    bb0 [cold]:
      v0 = mul arg0, 54
      v1 = div v0, arg0
      v2 = eq v1, 54
      v3 = eq arg0, 0
      v4 = or v3, v2
      jumpi v4, bb1, bb2
    bb2 [cold]:
      revert 0, 0
    bb1 [cold]:
      revert 0, 0
  }
  
