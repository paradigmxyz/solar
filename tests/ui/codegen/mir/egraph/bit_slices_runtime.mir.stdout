@module BitSlices
fn @repeated(arg0: u256, arg1: u256) -> u256 [selector=0x6196485c, pure, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    v0 = signextend arg1, arg0
    v1 = signextend arg1, v0
    ret v1
}

