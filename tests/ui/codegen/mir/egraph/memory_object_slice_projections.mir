//@ revisions: baseline optimized
//@[baseline] compile-flags: -Zmir-pipeline=lower-memory-objects,lower-slices,egraph,dce
//@[optimized] compile-flags: -Zmir-pipeline=egraph,lower-memory-objects,lower-slices,egraph,dce
//@ filecheck:

// CHECK-LABEL: (after dce)
@module MemoryObjectSliceProjections

// CHECK-LABEL: fn @dynamic_payload(arg0: i256
// CHECK: ret arg0
fn @dynamic_payload(arg0: memoryslice) -> i256 {
  bb0:
    v2 = slice_ptr arg0
    v4 = inttoptr i256 v2 to memptr
    v1 = ptrtoint memptr v4 to i256
    ret v1
}

// CHECK-LABEL: fn @memory_field(arg0: i256
// CHECK: [[MEM:v[0-9]+]] = load arg0
// CHECK: ret [[MEM]]
fn @memory_field(arg0: memoryslice) -> i256 {
  bb0:
    v9001 = slice_ptr arg0
    v2 = load v9001
    ret v2
}

// CHECK-LABEL: fn @calldata_field(arg0: i256
// CHECK: [[CALLDATA:v[0-9]+]] = load calldata arg0
// CHECK: ret [[CALLDATA]]
fn @calldata_field(arg0: calldataslice) -> i256 {
  bb0:
    v1 = slice_ptr arg0
    v2 = load calldata v1
    ret v2
}
