//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=egraph
//@[size] compile-flags: -Osize -Zmir-pipeline=egraph
@module SeededWords

fn @rule_0(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = add arg0, arg1
    v1 = and arg0, arg1
    v2 = sub v0, v1
    ret v2
}

fn @rule_1(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = add arg0, arg1
    v1 = and arg1, arg0
    v2 = sub v0, v1
    ret v2
}

fn @rule_2(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = add arg0, arg1
    v1 = or arg0, arg1
    v2 = sub v0, v1
    ret v2
}

fn @rule_3(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = add arg0, arg1
    v1 = or arg1, arg0
    v2 = sub v0, v1
    ret v2
}

fn @rule_4(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = or arg0, arg1
    v1 = and arg0, arg1
    v2 = sub v0, v1
    ret v2
}

fn @rule_5(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = or arg0, arg1
    v1 = and arg1, arg0
    v2 = sub v0, v1
    ret v2
}

fn @rule_6(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = or arg0, arg1
    v1 = xor arg0, arg1
    v2 = sub v0, v1
    ret v2
}

fn @rule_7(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = or arg0, arg1
    v1 = xor arg1, arg0
    v2 = sub v0, v1
    ret v2
}

fn @rule_8(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = not arg1
    v1 = add v0, arg0
    v2 = not v1
    ret v2
}

fn @rule_9(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = not arg1
    v1 = add arg0, v0
    v2 = not v1
    ret v2
}

fn @rule_10(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = not arg0
    v1 = sub v0, arg1
    v2 = not v1
    ret v2
}
