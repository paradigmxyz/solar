- ; === ROOT/tests/ui/codegen/mir/egraph/debugify.mir (before egraph) ===
+ ; === ROOT/tests/ui/codegen/mir/egraph/debugify.mir (after egraph) ===
  @module Debugify
  fn @folded_operand(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 1 !metadata(span=12..16)
-     v1 = add v0, 2 !metadata(span=10..20)
+     v1 = add arg0, 3 !metadata(spans=[10..20, 12..16])
      ret v1 !metadata(span=30..40)
  }
  
  fn @inverted_branch(arg0: i256, arg1: i256) -> i256 {
    bb0:
-     v0 = gt arg0, arg1 !metadata(span=52..60)
+     v0 = lt arg1, arg0 !metadata(span=52..60)
      v1 = eq v0, false !metadata(span=50..61)
-     jumpi v1, bb1, bb2 !metadata(span=45..70)
-   bb2:                                            ; preds = bb0
-     ret 2 !metadata(span=100..110)
+     jumpi v0, bb2, bb1 !metadata(spans=[45..70, 50..61])
    bb1:                                            ; preds = bb0
      ret 1 !metadata(span=80..90)
+   bb2:                                            ; preds = bb0
+     ret 2 !metadata(span=100..110)
  }
  
  fn @effect_between(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 1 !metadata(span=112..116)
      sstore 0, arg0 !metadata(span=120..130)
-     v1 = add v0, 2 !metadata(span=110..140)
+     v1 = add arg0, 3 !metadata(span=110..140)
      ret v1 !metadata(span=150..160)
  }
  
  fn @flipped_check(arg0: i256, arg1: i256) -> i256 {
    bb0:
-     v0 = gt arg0, arg1 !metadata(span=212..220)
+     v0 = lt arg1, arg0 !metadata(span=212..220)
      v1 = eq v0, false !metadata(span=210..221)
-     icall panic_if<0x1>, v1 !metadata(span=205..230)
+     icall panic_if_zero<0x1>, v0 !metadata(spans=[205..230, 210..221])
      ret arg0 !metadata(span=240..250)
  }
  
  fn @other_block(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = add arg0, 1 !metadata(span=312..316)
      v1 = ne arg1, 0 !metadata(span=306..308)
      jumpi v1, bb1, bb2 !metadata(span=305..309)
    bb2:                                            ; preds = bb0
      ret 0 !metadata(span=350..360)
    bb1:                                            ; preds = bb0
-     v2 = add v0, 2 !metadata(span=310..320)
+     v2 = add arg0, 3 !metadata(span=310..320)
      ret v2 !metadata(span=330..340)
  }
  
  fn @unrelated_span(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 1 !metadata(span=412..416)
-     v1 = add v0, 2 !metadata(span=420..430)
+     v1 = add arg0, 3 !metadata(span=420..430)
      ret v1 !metadata(span=440..450)
  }
  
