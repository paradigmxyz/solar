//@ compile-flags: -Zmir-pipeline=egraph,dce
@module BitSlices

// Constant shift chains saturate at 256, including addition overflow.
@types
  struct0: {i256, i256, i256}
  struct1: {i256, i256}
  struct2: {i256, i256, i256, i256}

fn @shift_chains(arg0: i256) -> struct0 [return_abi=[i256, i256, i256]] {
  bb0:
    v1 = shl arg0, 8
    v2 = shl v1, 16
    v3 = shr arg0, 8
    v4 = shr v3, 16
    v5 = sar arg0, 8
    v6 = sar v5, 16
    ret v2, v4, v6
}

fn @shift_overflow(arg0: i256) -> struct0 [return_abi=[i256, i256, i256]] {
  bb0:
    v1 = shl arg0, 1
    v2 = shl v1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v3 = shr arg0, 255
    v4 = shr v3, 1
    v5 = sar arg0, 1
    v6 = sar v5, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    ret v2, v4, v6
}

// Opposite logical shifts stay intact to avoid expensive mask materialization.
fn @low_byte(arg0: i256) -> i256 {
  bb0:
    v1 = shl arg0, 248
    v2 = shr v1, 248
    ret v2
}

fn @high_bits(arg0: i256) -> i256 {
  bb0:
    v1 = shr arg0, 8
    v2 = shl v1, 8
    ret v2
}

// Arithmetic shift pairs must preserve the sign, not zero extend.
fn @signed_byte(arg0: i256) -> i256 {
  bb0:
    v1 = shl arg0, 248
    v2 = sar v1, 248
    ret v2
}

fn @unaligned_signed_bits(arg0: i256) -> i256 {
  bb0:
    v1 = shl arg0, 249
    v2 = sar v1, 249
    ret v2
}

fn @nested_sign_extension(arg0: i256) -> struct1 [return_abi=[i256, i256]] {
  bb0:
    v1 = signextend 0, arg0
    v2 = signextend 2, v1
    v3 = signextend 2, arg0
    v4 = signextend 0, v3
    ret v2, v4
}

fn @unbounded_sign_extension(arg0: i256) -> i256 {
  bb0:
    v1 = signextend 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, arg0
    v2 = signextend 31, v1
    ret v2
}

// Dynamic counts and unequal opposite shifts are not fused.
fn @dynamic_shifts(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = shl arg0, arg1
    v3 = shl v2, arg1
    ret v3
}

fn @unequal_shifts(arg0: i256) -> i256 {
  bb0:
    v1 = shl arg0, 248
    v2 = shr v1, 249
    ret v2
}

// Repeating the same dynamic extension is also idempotent, even when its
// index is above 30 and both operations are identities.
fn @repeated_dynamic_extension(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = signextend arg1, arg0
    v3 = signextend arg1, v2
    ret v3
}

// Every AND/OR operand order must match through the constant-right view.
fn @constant_left_shift_masks(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> struct2 [return_abi=[i256, i256, i256, i256]] {
  bb0:
    v4 = shl arg0, 8
    v5 = or v4, 3
    v6 = and v5, 255
    v7 = shl arg1, 8
    v8 = or 3, v7
    v9 = and v8, 255
    v10 = shl arg2, 8
    v11 = or v10, 3
    v12 = and 255, v11
    v13 = shl arg3, 8
    v14 = or 3, v13
    v15 = and 255, v14
    ret v6, v9, v12, v15
}

fn @constant_right_shift_masks(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> struct2 [return_abi=[i256, i256, i256, i256]] {
  bb0:
    v4 = shr arg0, 248
    v5 = or v4, 256
    v6 = and v5, 65280
    v7 = shr arg1, 248
    v8 = or 256, v7
    v9 = and v8, 65280
    v10 = shr arg2, 248
    v11 = or v10, 256
    v12 = and 65280, v11
    v13 = shr arg3, 248
    v14 = or 256, v13
    v15 = and 65280, v14
    ret v6, v9, v12, v15
}
