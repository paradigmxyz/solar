//@ compile-flags: -Zmir-pipeline=egraph,dce
@module Division
@types
  struct0: {i1, i1}
  struct1: {i1, i1, i1}
  struct2: {i256, i256}

// Division rules whose proofs need integer reasoning; bit-blasting times out on them.
// A checked product by a constant wraps exactly when its factor exceeds MAX / c.
fn @checked_product(arg0: i256) -> i1 {
  bb0:
    v0 = mul arg0, 1000000000000000000
    v1 = div v0, 1000000000000000000
    v2 = eq v1, arg0
    ret v2
}

// Solidity tests `c * x` by dividing by the variable factor.
fn @checked_product_left(arg0: i256) -> i1 {
  bb0:
    v0 = mul arg0, 997
    v1 = eq arg0, 0
    v2 = div v0, arg0
    v3 = eq v2, 997
    v4 = or v1, v3
    ret v4
}

// A different divisor is not an overflow test.
fn @other_divisor(arg0: i256) -> i1 {
  bb0:
    v0 = mul arg0, 10
    v1 = div v0, 5
    v2 = eq v1, arg0
    ret v2
}

// A quotient compares with a constant through the dividend.
fn @quotient_below(arg0: i256) -> i1 {
  bb0:
    v0 = div arg0, 1000
    v1 = lt v0, 7
    ret v1
}

fn @quotient_above(arg0: i256) -> i1 {
  bb0:
    v0 = div arg0, 1000
    v1 = gt v0, 7
    ret v1
}

fn @quotient_zero(arg0: i256) -> i1 {
  bb0:
    v0 = div arg0, 1000
    v1 = eq v0, 0
    ret v1
}

fn @quotient_nonzero(arg0: i256) -> i1 {
  bb0:
    v0 = div arg0, 3600
    v1 = ne v0, 0
    ret v1
}

// A quotient that other comparisons still need stays: rewriting one use would add
// stack traffic without removing the division.
fn @shared_quotient(arg0: i256) -> struct0 [return_abi=[i1, i1]] {
  bb0:
    v0 = div arg0, 1000
    v1 = lt v0, 7
    v2 = gt v0, 7
    ret v1, v2
}

// No quotient by 10^30 reaches 1.5 * 10^47 > MAX / 10^30, and none by 3 exceeds MAX / 3;
// the significant-bit bounds of the quotients prove neither.
fn @quotient_bounds(arg0: i256) -> struct1 [return_abi=[i1, i1, i1]] {
  bb0:
    v0 = div arg0, 1000000000000000000000000000000
    v1 = lt v0, 150000000000000000000000000000000000000000000000
    v2 = gt v0, 150000000000000000000000000000000000000000000000
    v3 = div arg0, 3
    v4 = gt v3, 0x5555555555555555555555555555555555555555555555555555555555555555
    ret v1, v2, v4
}

// Nested quotients divide once by the product, or vanish when it exceeds MAX.
fn @nested_quotient(arg0: i256) -> struct2 [return_abi=[i256, i256]] {
  bb0:
    v0 = div arg0, 1000000000
    v1 = div v0, 1000000000
    v2 = div arg0, 100000000000000000000000000000000000000
    v3 = div v2, 1200000000000000000000000000000000000000
    ret v1, v3
}

fn @split(arg0: i256) -> struct2 [return_abi=[i256, i256]] {
  bb0:
    v0 = div arg0, 86400
    v1 = mul v0, 86400
    v2 = mod arg0, 86400
    v3 = add v1, v2
    v4 = add v2, v1
    ret v3, v4
}

// A zero divisor makes the remainder zero too, so the split needs a constant one.
fn @split_variable(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = div arg0, arg1
    v1 = mul v0, arg1
    v2 = mod arg0, arg1
    v3 = add v1, v2
    ret v3
}

// Rounding down to a multiple never exceeds the dividend or wraps, for any divisor.
fn @rounding(arg0: i256, arg1: i256) -> struct1 [return_abi=[i1, i1, i1]] {
  bb0:
    v0 = div arg0, 86400
    v1 = mul v0, 86400
    v2 = lt arg0, v1
    v3 = div arg0, arg1
    v4 = mul v3, arg1
    v5 = gt v4, arg0
    v6 = div v4, arg1
    v7 = eq v6, v3
    ret v2, v5, v7
}
