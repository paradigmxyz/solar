  bb0:
    v4 = select arg0, arg1, arg2
    v5 = select arg0, v4, arg3
    ret v5
}

fn @equal_select_0(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = eq arg0, arg1
    v3 = select v2, arg0, arg1
