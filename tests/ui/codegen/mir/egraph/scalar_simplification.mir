fn @bit_test_select_0(arg0: i256) -> i256 {
  bb0:
    v1 = and arg0, 255
    v2 = eq v1, 0
    v3 = and arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00
    v4 = select v2, v3, arg0
    ret v4
}

fn @bit_test_select_1(arg0: i256) -> i256 {
  bb0:
    v1 = and arg0, 255
    v2 = eq v1, 0
    v3 = and arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00
    v4 = select v2, arg0, v3
    ret v4
}

fn @bit_test_select_2(arg0: i256) -> i256 {
  bb0:
    v1 = and arg0, 255
    v2 = eq v1, 0
    v3 = and arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00
