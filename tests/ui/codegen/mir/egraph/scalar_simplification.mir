    ret v4
}

fn @bit_test_select_distinct_mask(arg0: i256) -> i256 {
  bb0:
    v1 = and arg0, 255
    v2 = eq v1, 0
    v3 = and arg0, 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeff00
    v4 = select v2, v3, arg0
    ret v4
}

