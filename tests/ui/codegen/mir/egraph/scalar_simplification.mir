// CHECK-LABEL: fn @cross_block_address_cast
// CHECK: {{^[ +].*}}[[CLEAN:v[0-9]+]] = zext i160
// CHECK: {{^[ +].*}}{{v[0-9]+}} = call 100, [[CLEAN]], 0, 0, 0, 0, 0
