//@ compile-flags: -Zmir-pipeline=egraph,dce
@module SubAddCancel

// ABI encoding computes `end - data` from a pointer plus a length: the
// pointer sum is shared, the length reaches the result.
@types
  struct0: {i256, i256}

fn @shared_start(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    v2 = shl arg1, 5
    v3 = add arg0, v2
    v4 = add v3, 32
    v5 = add arg0, 32
    v6 = sub v4, v5
    ret v5, v6
}

fn @length_first(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = shl arg1, 5
    v3 = add v2, arg0
    v4 = add v3, 32
    v5 = add arg0, 32
    v6 = sub v4, v5
    ret v6
}

// The element count reads the length directly.
fn @element_count(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = shl arg1, 5
    v3 = add arg0, v2
    v4 = add v3, 32
    v5 = add arg0, 32
    v6 = sub v4, v5
    v7 = shr v6, 5
    ret v7
}

// The start pointer sits in another block.
fn @other_block(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = add arg0, 32
    jump bb1
  bb1:
    v3 = shl arg1, 5
    v4 = add arg0, v3
    v5 = add v4, 32
    v6 = sub v5, v2
    ret v6
}

// A sum with another user must stay.
fn @shared_sum(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    v2 = shl arg1, 5
    v3 = add arg0, v2
    v4 = add v3, 32
    v5 = add arg0, 32
    v6 = sub v4, v5
    ret v3, v6
}

fn @shared_outer(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    v2 = shl arg1, 5
    v3 = add arg0, v2
    v4 = add v3, 32
    v5 = add arg0, 32
    v6 = sub v4, v5
    ret v4, v6
}

// Different constants fold to a constant offset instead.
fn @different_constants(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = shl arg1, 5
    v3 = add arg0, v2
    v4 = add v3, 64
    v5 = add arg0, 32
    v6 = sub v4, v5
    ret v6
}
