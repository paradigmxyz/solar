    v0 = sext i160 arg0 to i256
    v1 = ne v0, 0
    ret v1
}

fn @boolean_sext_zero(arg0: i1) -> i1 {
  bb0:
    v0 = sext i1 arg0 to i256
    v1 = eq v0, 0
    ret v1
}

fn @narrow_zero_keeps_legal_word_compare(arg0: i8) -> i1 {
  bb0:
    v0 = zext i8 arg0 to i256
    v1 = eq v0, 0
    ret v1
}

fn @and_inequality(arg0: i256, arg1: i256) -> i1 {
  bb0:
    v0 = lt arg0, arg1
    v1 = ne arg1, arg0
    v2 = and v1, v0
    ret v2
}

fn @or_inequality(arg0: i256, arg1: i256) -> i1 {
  bb0:
    v0 = sgt arg0, arg1
    v1 = ne arg1, arg0
    v2 = or v1, v0
    ret v2
}

fn @xor_inequality(arg0: i256, arg1: i256) -> i1 {
