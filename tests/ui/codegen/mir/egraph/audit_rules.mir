    v0 = add arg1, 32
    v1 = sub arg0, v0
    v2 = add v1, 64
    ret v2
}

fn @undo_header(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = sub 32, arg1
    v1 = sub arg0, v0
    v2 = add v1, 64
    ret v2
}

