    v0 = slt arg0, arg1
    v1 = ne arg0, arg1
    v2 = xor v1, v0
    ret v2
}

fn @inclusive_gt(arg0: i256, arg1: i256) -> i1 {
  bb0:
    v0 = gt arg0, arg1
    v1 = eq arg1, arg0
    v2 = or v1, v0
    ret v2
}

fn @signed_inclusive_gt(arg0: i256, arg1: i256) -> i1 {
