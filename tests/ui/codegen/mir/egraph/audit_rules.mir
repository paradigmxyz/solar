  bb0:
    v0 = zext i1 arg0 to i256
    v1 = zext i1 arg1 to i256
    v2 = or v0, v1
    v3 = eq v2, 0
    ret v3
}

fn @widened_xor_zero(arg0: i1, arg1: i1) -> i1 {
  bb0:
    v0 = zext i1 arg0 to i256
    v1 = zext i1 arg1 to i256
    v2 = xor v0, v1
    v3 = eq v2, 0
    ret v3
}

fn @address_zext_eq_zero(arg0: i160) -> i1 {
