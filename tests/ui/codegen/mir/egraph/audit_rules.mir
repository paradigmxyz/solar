fn @capacity_add(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = sub 100, arg0
    v1 = sub v0, arg1
    v2 = add v1, 7
    ret v2
}

fn @capacity_sub(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = sub 100, arg0
    v1 = sub v0, arg1
    v2 = sub v1, 7
    ret v2
}

fn @span_header(arg0: i256, arg1: i256) -> i256 {
