}

fn @digest(arg0: i160, arg1: i256) -> i256 {
  bb0:
    v0 = alloc 64
    v1 = zext i160 arg0 to i256
    mstore v0, v1
    v2 = ptradd v0, 32
    mstore v2, arg1
    v3 = abi_encode [tuple<word<uint160>, word>], scratch, args v0
    v4 = extract_value slice<memory>, v3, 0
    v5 = extract_value slice<memory>, v3, 1
    v6 = keccak256 v4, v5
