    struct1: {bool, bool}
    struct2: {word, bool}
    struct3: {word, word}
  
  fn @arithmetic(arg0: word, arg1: word) -> struct0 [return_abi=[word, word, word, word]] {
    bb0:
      v0 = sub arg0, arg1
-     v1 = add v0, arg1
-     v2 = add arg1, v0
      v3 = add arg0, arg1
-     v4 = sub v3, arg1
-     v5 = sub v3, arg0
-     ret v1, v2, v4, v5
+     ret arg0, arg0, arg0, arg1
  }
  
  fn @equality(arg0: word, arg1: word) -> struct1 [return_abi=[bool, bool]] {
    bb0:
      v0 = sub arg0, arg1
-     v1 = eq v0, 0
+     v1 = eq arg0, arg1
      v2 = xor arg0, arg1
-     v3 = eq v2, 0
-     ret v1, v3
+     ret v1, v1
  }
  
  fn @shared_difference(arg0: word, arg1: word) -> struct2 [return_abi=[word, bool]] {
    bb0:
      v0 = sub arg0, arg1
      v1 = eq v0, 0
      ret v0, v1
  }
  
  fn @absorption(arg0: word, arg1: word) -> struct0 [return_abi=[word, word, word, word]] {
    bb0:
      v0 = or arg0, arg1
-     v1 = and arg0, v0
-     v2 = and v0, arg1
      v3 = and arg0, arg1
-     v4 = or arg0, v3
-     v5 = or v3, arg1
-     ret v1, v2, v4, v5
+     ret arg0, arg1, arg0, arg1
  }
  
  fn @xor_cancel(arg0: word, arg1: word) -> struct0 [return_abi=[word, word, word, word]] {
    bb0:
      v0 = xor arg0, arg1
-     v1 = xor arg0, v0
-     v2 = xor arg1, v0
-     v3 = xor v0, arg0
-     v4 = xor v0, arg1
-     ret v1, v2, v3, v4
+     ret arg1, arg0, arg1, arg0
  }
  
  fn @distinct_operands(arg0: word, arg1: word, arg2: word) -> struct3 [return_abi=[word, word]] {
    bb0:
      v0 = sub arg0, arg1
      v1 = add v0, arg2
      v2 = xor arg0, arg1
      v3 = xor v2, arg2
      ret v1, v3
  }
  
