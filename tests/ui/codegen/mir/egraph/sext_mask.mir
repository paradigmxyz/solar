//@compile-flags: -Zmir-pipeline=egraph
//@filecheck:
@module SextMask

// A low mask at least as wide as the sign-extended bytes is dead: `signextend` reads only those
// bytes. A mask of exactly that width, a wider one, and a duplicate of an earlier result all go.
// CHECK-LABEL: {{^[ +].*}}fn @drops_wide_masks{{[( ]}}
// CHECK: {{^[ +].*}}[[A:v[0-9]+]] = signextend 0, arg0
// CHECK: {{^[ +].*}}[[B:v[0-9]+]] = signextend 2, arg0
// CHECK: {{^[ +].*}}[[C:v[0-9]+]] = signextend 15, arg0
// CHECK: {{^[ +].*}}ret [[A]], [[B]], [[C]], [[B]]
@types
  struct0: {i256, i256, i256, i256}
  struct1: {i256, i256}

fn @drops_wide_masks(arg0: i256) -> struct0 [return_abi=[i256, i256, i256, i256]] {
  bb0:
    v1 = and arg0, 0xff
    v2 = signextend 0, v1
    v3 = and arg0, 0xffffff
    v4 = signextend 2, v3
    v5 = and arg0, 0xffffffffffffffffffffffffffffffff
    v6 = signextend 15, v5
    v7 = and arg0, 0xffffffff
    v8 = signextend 2, v7
    ret v2, v4, v6, v8
}

// The mask must cover the sign byte: byte 30 reads 248 bits, so a 248-bit mask goes. A 240-bit
// mask is narrower than the sign byte, so it stays and the sign bit is known clear.
// CHECK-LABEL: {{^[ +].*}}fn @byte_30_width{{[( ]}}
// CHECK: {{^[ +].*}}[[A:v[0-9]+]] = signextend 30, arg0
// CHECK: {{^[ +].*}}[[N:v[0-9]+]] = and arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// CHECK: {{^[ +].*}}ret [[A]], [[N]]
fn @byte_30_width(arg0: i256) -> struct1 [return_abi=[i256, i256]] {
  bb0:
    v1 = and arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v2 = signextend 30, v1
    v3 = and arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v4 = signextend 30, v3
    ret v2, v4
}

// A mask with a hole changes the result and stays.
// CHECK-LABEL: {{^[ +].*}}fn @keeps_holed_masks{{[( ]}}
// CHECK: {{^[ +].*}}[[M1:v[0-9]+]] = and arg0, 0xff00ff
// CHECK: {{^[ +].*}}= signextend 2, [[M1]]
// CHECK: {{^[ +].*}}[[M2:v[0-9]+]] = and arg0, 0xffff00
// CHECK: {{^[ +].*}}= signextend 2, [[M2]]
fn @keeps_holed_masks(arg0: i256) -> struct1 [return_abi=[i256, i256]] {
  bb0:
    v1 = and arg0, 0xff00ff
    v2 = signextend 2, v1
    v3 = and arg0, 0xffff00
    v4 = signextend 2, v3
    ret v2, v4
}

// A mask that another user also needs stays shared; the cost model keeps it.
// CHECK-LABEL: {{^[ +].*}}fn @keeps_shared_mask{{[( ]}}
// CHECK: {{^[ +].*}}[[S:v[0-9]+]] = and arg0, 0xffffff
// CHECK: {{^[ +].*}}= signextend 2, [[S]]
fn @keeps_shared_mask(arg0: i256) -> struct1 [return_abi=[i256, i256]] {
  bb0:
    v1 = and arg0, 0xffffff
    v2 = signextend 2, v1
    ret v1, v2
}
