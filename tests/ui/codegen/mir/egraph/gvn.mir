//@compile-flags: -Zmir-pipeline=egraph
//@filecheck:
@module Gvn

// Transitive congruence: v3 joins v2's class, so v5 and v4 key identically
// over classes and v5 folds onto v4 in the same run.
// CHECK-LABEL: {{^[ +].*}}fn @transitive_congruence{{[( ]}}
// CHECK: - {{v[0-9]+}} = add arg0, arg1
// CHECK: + {{v[0-9]+}} = add [[VALUE:v[0-9]+]], [[VALUE]]
fn @transitive_congruence(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = add arg0, arg1
    v3 = add arg0, arg1
    v4 = mul v2, 2
    v5 = mul v3, 2
    v6 = add v4, v5
    ret v6
}

// The two `16` literals are distinct value-table entries; equal immediates
// share a class, and commutative operands sort by class.
// CHECK-LABEL: {{^[ +].*}}fn @equal_immediates_unify{{[( ]}}
// CHECK: - {{v[0-9]+}} = add 16, arg0
// CHECK: + {{v[0-9]+}} = add [[IMMEDIATE:v[0-9]+]], [[IMMEDIATE]]
fn @equal_immediates_unify(arg0: i256) -> i256 {
  bb0:
    v1 = add arg0, 16
    v2 = add 16, arg0
    v3 = add v1, v2
    ret v3
}

// `gt arg1, arg0` keys as `lt arg0, arg1`, so the selects over the two
// comparisons become congruent as well.
// CHECK-LABEL: {{^[ +].*}}fn @swapped_comparison_feeds_arithmetic{{[( ]}}
// CHECK: - {{v[0-9]+}} = gt arg1, arg0
// CHECK: + {{v[0-9]+}} = add [[SELECT:v[0-9]+]], [[SELECT]]
fn @swapped_comparison_feeds_arithmetic(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = lt arg0, arg1
    v3 = gt arg1, arg0
    v4 = select v2, arg0, arg1
    v5 = select v3, arg0, arg1
    v6 = add v4, v5
    ret v6
}

// Negative: storage, balance, and keccak reads never merge here even with
// identical operands; only CSE may unify those under its clobber tracking.
// CHECK-LABEL: {{^[ +].*}}fn @keep_state_dependent_reads{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload arg0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = sload arg0
fn @keep_state_dependent_reads(arg0: i256) -> i256 {
  bb0:
    v1 = sload arg0
    v2 = sload arg0
    v3 = balance arg0
    v4 = balance arg0
    v5 = keccak256 0, 32
    v6 = keccak256 0, 32
    v7 = add v1, v2
    v8 = add v3, v4
    v9 = add v5, v6
    v10 = add v7, v8
    v11 = add v10, v9
    ret v11
}

// Diamond: the sibling adds and muls share classes, and the phi-of-same joins
// the mul class, but no member dominates bb3 so nothing is replaced.
// CHECK-LABEL: {{^[ +].*}}fn @no_replacement_across_siblings{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add arg0, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add arg0, 1
fn @no_replacement_across_siblings(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v2 = add arg0, 1
    v3 = mul v2, 3
    jump bb3
  bb2:
    v4 = add arg0, 1
    v5 = mul v4, 3
    jump bb3
  bb3:
    v6 = phi [bb1: v3], [bb2: v5]
    ret v6
}

// Fresh decoded keys stay below scratch; the failure branch does not return.
// CHECK-LABEL: {{^[ +].*}}fn @fresh_mapping_entry{{[( ]}}
// CHECK-DAG: - {{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK-DAG: + {{v[0-9]+}} = add [[MAPPING:v[0-9]+]], [[MAPPING]]
fn @fresh_mapping_entry(arg0: memorybytes) -> i256 [selector=0x10000001, abi_params=[bytes], abi_returns=[word]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v2 = sload v1
    v3 = eq v2, 0
    jumpi v3, bb1, bb2
  bb1:
    v4 = mapping_slot_memory arg0, 0
    v5 = add v1, v4
    ret v5
  bb2:
    icall require<custom_error []>, false, 0
    invalid
}

// CHECK-LABEL: {{^[ +].*}}fn @mapping_internal_target{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_internal_target(arg0: memorybytes) -> i256 [selector=0x10000002, abi_params=[bytes], abi_returns=[word]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v2 = mapping_slot_memory arg0, 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @mapping_tail_target{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_tail_target(arg0: memorybytes) -> i256 [selector=0x10000003, abi_params=[bytes], abi_returns=[word]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v2 = mapping_slot_memory arg0, 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @mapping_fmp_reset{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_fmp_reset(arg0: memorybytes) -> i256 [selector=0x10000004, abi_params=[bytes], abi_returns=[word]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    set_fmp 0
    v2 = mapping_slot_memory arg0, 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @mapping_raw_read{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_raw_read(arg0: memorybytes) -> i256 [selector=0x10000005, abi_params=[bytes], abi_returns=[word]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v4 = mload 128
    v2 = mapping_slot_memory arg0, 0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @mapping_size_observer{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_size_observer(arg0: memorybytes) -> i256 [selector=0x10000006, abi_params=[bytes], abi_returns=[word]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v4 = msize
    v2 = mapping_slot_memory arg0, 0
    v3 = add v1, v2
    ret v3
}

fn @call_mapping_entry(arg0: memorybytes) -> i256 {
  bb0:
    v1 = icall @mapping_internal_target, arg0
    ret v1
}

fn @tailcall_mapping_entry(arg0: memorybytes) -> i256 {
  bb0:
    tail_call @mapping_tail_target, arg0
}

// Return encoding can read memory even when the body has no explicit load.
// CHECK-LABEL: {{^[ +].*}}fn @mapping_dynamic_return{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_dynamic_return(arg0: memorybytes) -> memorybytes [selector=0x10000007, abi_params=[bytes], abi_returns=[memory_bytes]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v2 = mapping_slot_memory arg0, 0
    ret arg0
}

// A terminal require can read memory while encoding its payload.
// CHECK-LABEL: {{^[ +].*}}fn @mapping_payload_require{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mapping_slot_memory arg0, 0
fn @mapping_payload_require(arg0: memorybytes) [selector=0x10000008, abi_params=[bytes], abi_returns=[]] {
  bb0:
    v1 = mapping_slot_memory arg0, 0
    v2 = mapping_slot_memory arg0, 0
    icall require<custom_error [memory_bytes]>, false, 0, arg0
    invalid
}
