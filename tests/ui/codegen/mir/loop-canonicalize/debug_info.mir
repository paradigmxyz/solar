//@compile-flags: -Zmir-pipeline=loop-canonicalize
//@filecheck:
@module DebugInfo

// CHECK-LABEL: {{^[ +].*}}fn @insert_preheader{{[( ]}}
// CHECK: + [[ENTRY:v[0-9]+]] = phi [bb1: 10], [bb2: 20]
// CHECK: + {{v[0-9]+}} = phi [bb4: 30], [bb6: [[ENTRY]]] !metadata(span=10..20)
fn @insert_preheader(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 10], [bb2: 20], [bb4: 30] !metadata(span=10..20)
    jumpi true, bb4, bb5
  bb4:
    jump bb3
  bb5:
    ret v1
}
