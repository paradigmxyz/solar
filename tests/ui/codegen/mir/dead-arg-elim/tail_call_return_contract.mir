//@ compile-flags: -Zmir-pipeline=dead-arg-elim -Osize
//@ filecheck:
@module TailCallReturnContract

// A discarded tail-caller must keep its return contract while its tail callee
// still delivers a result: clearing only the caller side would leave its call
// sites adopting a phantom value from the callee's intact return protocol.

// CHECK-LABEL: fn @keep() -> i256
// CHECK: ret v0
fn @keep() -> i256 {
  bb0:
    v0 = add 1, 2
    ret v0
}

// The display hides return types on tail-call-only bodies; the retained
// one-result call site in `@entry` is the contract assertion.
// CHECK-LABEL: fn @forward()
// CHECK: tail_call @keep
fn @forward() -> i256 {
  bb0:
    tail_call fn0
}

// The stored result is a material use that keeps `@keep`'s return live.
// CHECK-LABEL: fn @user()
// CHECK: v0 = icall @keep
// CHECK: mstore 0, v0
fn @user() -> i256 {
  bb0:
    v0 = icall fn0
    mstore 0, v0
    ret 7
}

// CHECK-LABEL: fn @entry()
// CHECK: v0 = icall @forward
// CHECK: icall @user
fn @entry() [selector=0x01020304] {
  bb0:
    v0 = icall fn1
    v1 = icall fn2
    ret
}

// `@cold` never returns, since it calls an aborting helper first, but it still
// reaches a `ret`, so the same contract holds for tail calls to it.
fn @abort() {
  bb0:
    revert 0, 0
}

fn @cold() -> i256 {
  bb0:
    icall @abort
    ret 7
}

// CHECK-LABEL: fn @forward_cold()
// CHECK: tail_call @cold
fn @forward_cold() -> i256 {
  bb0:
    tail_call @cold
}

// CHECK-LABEL: fn @entry_cold()
// CHECK: v0 = icall @forward_cold
// CHECK: v1 = icall @cold
fn @entry_cold() [selector=0x05060708] {
  bb0:
    v0 = icall @forward_cold
    v1 = icall @cold
    mstore 0, v1
    ret
}
