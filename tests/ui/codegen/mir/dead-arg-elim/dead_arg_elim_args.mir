//@ compile-flags: -Zmir-pipeline=dead-arg-elim
//@ filecheck:
@module DeadArgElimArgs

// Argument pruning runs under every objective; result pruning is size-only and
// is covered by `dead_arg_elim_returns.mir`.

// CHECK-LABEL: fn @leaf(arg0: u256, arg1: u256) -> u256
fn @leaf(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = add arg0, arg2
    ret v0
}

// CHECK-LABEL: fn @forward(arg0: u256, arg1: u256) -> u256
// CHECK: internal_call @leaf, 1, arg0, arg1
fn @forward(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = internal_call fn0, 1, arg0, arg1, arg2
    ret v0
}

// `arg2` is only forwarded around the recursive cycle and is transitively dead.
// CHECK-LABEL: fn @recursive(arg0: bool, arg1: u256) -> u256
// CHECK: internal_call @recursive, 1, 0, arg1
fn @recursive(arg0: bool, arg1: u256, arg2: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = internal_call fn2, 1, false, arg1, arg2
    ret v0
  bb2:
    ret arg1
}

// External ABI signatures are not rewritten, even when an argument is unused.
// CHECK-LABEL: fn @external_keeps_abi(arg0: u256, arg1: u256) -> u256
fn @external_keeps_abi(arg0: u256, arg1: u256) -> u256 [selector=0x01020304] {
  bb0:
    ret arg0
}

// CHECK-LABEL: fn @entry() -> u256
// CHECK: internal_call @forward, 1, 1, 3
// CHECK: internal_call @recursive, 1, 0, 7
fn @entry() -> u256 [selector=0x01020305] {
  bb0:
    v0 = internal_call fn1, 1, 1, 2, 3
    v1 = internal_call fn2, 1, false, 7, 9
    v2 = add v0, v1
    ret v2
}

// CHECK-LABEL: fn @tail_sink(arg0: u256)
fn @tail_sink(arg0: u256, arg1: u256) {
  bb0:
    sstore 0, arg0
    stop
}

// Tail-call operands participate in the same transitive argument liveness.
// CHECK-LABEL: fn @tail_forward(arg0: u256)
// CHECK: tail_call @tail_sink, arg0
fn @tail_forward(arg0: u256, arg1: u256) {
  bb0:
    tail_call fn5, arg0, arg1
}

// CHECK-LABEL: fn @tail_entry()
// CHECK: tail_call @tail_forward, 4
fn @tail_entry() [selector=0x01020306] {
  bb0:
    tail_call fn6, 4, 5
}
