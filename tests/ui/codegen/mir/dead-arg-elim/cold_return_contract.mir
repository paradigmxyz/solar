//@ compile-flags: -Zmir-pipeline=dead-arg-elim -Osize
@module ColdReturnContract

// `@cold` never returns, since it calls an aborting helper first, but it still
// reaches a `ret`, so the validator checks the result arity of tail calls to
// it. `@forward`'s result goes unread, yet it must keep its `i256` result while
// the direct call keeps `@cold`'s result live.

fn @abort() {
  bb0:
    revert 0, 0
}
fn @cold() -> i256 {
  bb0:
    icall @abort
    ret 7
}
fn @forward() -> i256 {
  bb0:
    tail_call @cold
}
fn @entry() [selector=0x01020304] {
  bb0:
    v0 = icall @forward
    v1 = icall @cold
    mstore 0, v1
    ret
}
