//@ compile-flags: -Zmir-pipeline=dead-arg-elim -Osize
//@ filecheck:
@module EffectfulDependencies

// A discarded result must retain a read in its dependency slice. A later DCE pass could otherwise
// remove the `mload`, changing memory expansion as observed by a caller's `msize`.
// CHECK-LABEL: fn @read() -> u256
// CHECK: v0 = mload 0x10000
// CHECK-NEXT: ret v0
fn @read() -> u256 {
  bb0:
    v0 = mload 65536 !metadata(effect=pure)
    ret v0
}

// CHECK-LABEL: fn @read_entry()
// CHECK: v0 = icall @read, 1
fn @read_entry() [selector=0x01020304] {
  bb0:
    v0 = icall fn0, 1
    ret
}

// Removing an unused argument must not expose an effectful actual operand to DCE either.
// CHECK-LABEL: fn @unused(arg0: u256)
fn @unused(arg0: u256) {
  bb0:
    ret
}

// CHECK-LABEL: fn @argument_entry()
// CHECK: v0 = mload 0x10000
// CHECK-NEXT: icall @unused, 0, v0
fn @argument_entry() [selector=0x05060708] {
  bb0:
    v0 = mload 65536
    icall fn2, 0, v0
    ret
}

// Mapping slots expand to scratch-memory writes and a hash after dead-argument elimination. Keep
// that dependency slice when its returned value is discarded so a later `msize` remains stable.
// CHECK-LABEL: fn @mapping_slot() -> bytes32
// CHECK: v0 = mapping_slot 1, 2
// CHECK-NEXT: ret v0
fn @mapping_slot() -> bytes32 {
  bb0:
    v0 = mapping_slot 1, 2
    ret v0
}

// CHECK-LABEL: fn @mapping_entry()
// CHECK: v0 = icall @mapping_slot, 1
fn @mapping_entry() [selector=0x090a0b0c] {
  bb0:
    v0 = icall fn4, 1
    ret
}
