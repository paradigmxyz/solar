//@ compile-flags: -Zmir-pipeline=dead-arg-elim
//@ filecheck:
@module CalldataArgs

// Every call passes `scan` the same calldata words, a wrapper's lazy argument
// and a load at a constant offset, and `scan` keeps both across its loop: it
// reads them from calldata itself and both parameters go.
// CHECK-LABEL: fn @scan() -> i256
// CHECK: [[BOUND:v[0-9]+]] = calldataload 4
// CHECK-NEXT: [[BIAS:v[0-9]+]] = calldataload 36
// CHECK: lt {{v[0-9]+}}, [[BOUND]]
// CHECK: add {{v[0-9]+}}, [[BIAS]]
fn @scan(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    v3 = add v0, arg1
    ret v3
}

// Two calls pass different words for the bound, which stays a parameter; the
// bias still comes from the same word.
// CHECK-LABEL: fn @scan_mixed(arg0: i256) -> i256
// CHECK: [[BIAS:v[0-9]+]] = calldataload 36
// CHECK: lt {{v[0-9]+}}, arg0
fn @scan_mixed(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    v3 = add v0, arg1
    ret v3
}

// Parameters no loop carries already travel on the stack.
// CHECK-LABEL: fn @straight(arg0: i256, arg1: i256) -> i256
// CHECK-NOT: calldataload
fn @straight(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    ret v0
}

// CHECK-LABEL: fn @first()
// CHECK: icall @scan{{$}}
// CHECK: icall @scan_mixed, {{v[0-9]+}}{{$}}
// CHECK: icall @straight, {{v[0-9]+}}, arg1
fn @first() [selector=0x01020304, abi_wrapper] {
  bb0:
    v0 = calldataload 4
    v1 = icall fn0, v0, arg1
    v2 = icall fn1, v0, arg1
    v3 = icall fn2, v0, arg1
    v4 = add v1, v2
    v5 = add v4, v3
    mstore 0, v5
    returndata 0, 32
}

// CHECK-LABEL: fn @second()
// CHECK: icall @scan{{$}}
// CHECK: icall @scan_mixed, {{v[0-9]+}}{{$}}
fn @second() [selector=0x05060708, abi_wrapper] {
  bb0:
    v0 = calldataload 4
    v1 = calldataload 68
    v2 = icall fn0, v0, arg1
    v3 = icall fn1, v1, arg1
    v4 = add v2, v3
    mstore 0, v4
    returndata 0, 32
}
