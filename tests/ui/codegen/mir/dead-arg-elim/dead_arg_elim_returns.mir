//@ compile-flags: -Zmir-pipeline=dead-arg-elim -Osize
//@ filecheck:
@module DeadArgElimReturns

// Result pruning runs only under `-Osize`; it removes a discarded one-word
// result together with the call-result protocol, jointly with argument pruning.

// CHECK-LABEL: fn @discarded(arg0: u256)
// CHECK: ret
fn @discarded(arg0: u256) -> u256 {
  bb0:
    sstore 0, arg0
    ret arg0
}

// A returned call result is not effect-free, so the recursive call protocol remains intact.
// CHECK-LABEL: fn @recursive(arg0: bool, arg1: u256) -> u256
// CHECK: v0 = icall @recursive, 1, 0, arg1
// CHECK: ret v0
fn @recursive(arg0: bool, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = icall fn1, 1, false, arg1
    ret v0
  bb2:
    sstore 1, arg1
    ret arg1
}

// CHECK-LABEL: fn @kept(arg0: u256) -> u256
fn @kept(arg0: u256) -> u256 {
  bb0:
    ret arg0
}

// CHECK-LABEL: fn @entry() -> u256
// CHECK: icall @discarded, 0, 7
// CHECK: v0 = icall @recursive, 1, 1, 8
// CHECK: icall @kept, 1, 9
fn @entry() -> u256 [selector=0x01020304] {
  bb0:
    v0 = icall fn0, 1, 7
    v1 = icall fn1, 1, true, 8
    v2 = icall fn2, 1, 9
    ret v2
}

// External signatures are never rewritten.
// CHECK-LABEL: fn @external_keeps_abi(arg0: u256) -> u256
fn @external_keeps_abi(arg0: u256) -> u256 [selector=0x01020305] {
  bb0:
    ret arg0
}
