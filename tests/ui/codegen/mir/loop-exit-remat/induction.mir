//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=loop-exit-remat
//@[size] compile-flags: -Osize -Zmir-pipeline=loop-exit-remat
@module Induction

fn @exit_old(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v1]
    v1 = add v0, 32
    v2 = mload v1
    v3 = gt v2, arg1
    jumpi v3, bb2, bb3
  bb2:
    jump bb1
  bb3:
    v4 = mload v0
    ret v4
}

fn @subtract(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb1: v1]
    v1 = sub v0, 1
    v2 = ne v1, 0
    jumpi v2, bb1, bb2
  bb2:
    ret v0
}

// An unknown step stays unchanged.
fn @variable_step(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb1: v1]
    v1 = add v0, arg1
    v2 = ne v1, 0
    jumpi v2, bb1, bb2
  bb2:
    ret v0
}

// Reconstruction is also valid when an enclosing loop reenters the header.
fn @nested(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb1: v1], [bb2: v1]
    v1 = add v0, 32
    v3 = ne v1, 0
    jumpi v3, bb1, bb2
  bb2:
    v2 = add v0, 1
    jumpi arg1, bb1, bb3
  bb3:
    ret v2
}
