//@compile-flags: -Zmir-pipeline=cfg-simplify
//@filecheck:
@module CfgSimplify
// CHECK-LABEL: {{^[ +].*}}fn @sequential{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add arg0, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add {{v[0-9]+}}, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add {{v[0-9]+}}, 1
// CHECK: {{^[ +].*}}ret {{v[0-9]+}}
fn @sequential(arg0: u256) -> u256 {
  bb0:
    v1 = add arg0, 1
    jump bb1
  bb1:
    v2 = add v1, 1
    jump bb2
  bb2:
    v3 = add v2, 1
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @branch_forwarder_preserves_successor_order{{[( ]}}
// CHECK: - jump bb3
fn @branch_forwarder_preserves_successor_order(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    ret 1
  bb2:
    jump bb3
  bb3:
    ret 2
}

// CHECK-LABEL: {{^[ +].*}}fn @degenerate_branch_refreshes_successors{{[( ]}}
// CHECK: - jumpi arg0, bb1, bb1
fn @degenerate_branch_refreshes_successors(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb1
  bb1:
    ret 1
}

// An earlier dynamic case may equal 5 and must keep shadowing the later
// constant case, even though it routes to the default.
// CHECK-LABEL: {{^[ +].*}}fn @ordered_switch{{[( ]}}
// CHECK: {{^[ +].*}}switch 5, default bb1, [arg0 => bb1, 5 => bb2]
fn @ordered_switch(arg0: u256) -> u256 {
  bb0:
    switch 5, default bb1, [arg0 => bb1, 5 => bb2]
  bb1:
    ret 1
  bb2:
    ret 2
}

// CHECK-LABEL: {{^[ +].*}}fn @degenerate_switch_refreshes_successors{{[( ]}}
// CHECK: - switch arg0, default bb1, [0 => bb1, 1 => bb1]
fn @degenerate_switch_refreshes_successors(arg0: u256) -> u256 {
  bb0:
    switch arg0, default bb1, [0 => bb1, 1 => bb1]
  bb1:
    ret 1
}

// CHECK-LABEL: {{^[ +].*}}fn @constant_false_branch{{[( ]}}
// CHECK: - {{.*}}jumpi false
// CHECK: {{^[ +].*}}ret 2
fn @constant_false_branch() -> u256 {
  bb0:
    jumpi false, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret 2
}

// CHECK-LABEL: {{^[ +].*}}fn @constant_nonzero_branch{{[( ]}}
// CHECK: - {{.*}}jumpi 2
// CHECK: {{^[ +].*}}ret 1
fn @constant_nonzero_branch() -> u256 {
  bb0:
    jumpi 2, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret 2
}

fn @known_edges_keep_stores(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    sstore 0, 7
    jumpi arg0, bb3, bb4
  bb2:
    sstore 0, 8
    jumpi arg0, bb4, bb3
  bb3:
    v0 = phi [bb1: 7], [bb2: 8]
    ret v0
  bb4:
    v1 = phi [bb1: 9], [bb2: 10]
    ret v1
}

fn @multiple_incoming_edges(arg0: bool, arg1: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    sstore 0, 7
    jump bb3
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    sstore 0, 8
    jumpi arg0, bb4, bb5
  bb4:
    ret 1
  bb5:
    ret 2
}

fn @same_incoming_arms(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb1
  bb1:
    sstore 0, 7
    jumpi arg0, bb2, bb3
  bb2:
    ret 1
  bb3:
    ret 2
}
