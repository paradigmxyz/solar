//@compile-flags: -Zmir-pipeline=cfg-simplify
//@filecheck:
@module CfgDedupTerminalBlocks

// Two structurally identical panic blocks collapse into one shared block.
// CHECK-LABEL: {{^[ +].*}}fn @dedup_identical_panics{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, [[PANIC:bb[0-9]+]], {{bb[0-9]+}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
// CHECK: + jumpi {{(arg[0-9]+|v[0-9]+)}}, [[PANIC]], {{bb[0-9]+}}
fn @dedup_identical_panics(arg0: i256, arg1: i256) {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    v1 = ne arg1, 0
    jumpi v1, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb4:
    stop
}

// Panic blocks with different panic codes must NOT merge.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_panic_codes{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
fn @keep_distinct_panic_codes(arg0: i256, arg1: i256) {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    v1 = ne arg1, 0
    jumpi v1, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 18
    revert 0, 36
  bb4:
    stop
}

// Identical instructions but different terminator operands must NOT merge.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_revert_sizes{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
fn @keep_distinct_revert_sizes(arg0: i256, arg1: i256) {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    v1 = ne arg1, 0
    jumpi v1, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 32
  bb4:
    stop
}

// Block-local values compare by definition position, so alpha-equivalent
// computations merge.
// CHECK-LABEL: {{^[ +].*}}fn @dedup_local_computations{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, [[COMPUTATION:bb[0-9]+]], {{bb[0-9]+}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
// CHECK: + jumpi {{(arg[0-9]+|v[0-9]+)}}, [[COMPUTATION]], {{bb[0-9]+}}
fn @dedup_local_computations(arg0: i256, arg1: i256) {
  bb0:
    v21 = ne arg0, 0
    jumpi v21, bb1, bb2
  bb1:
    v10 = add arg0, 1
    mstore 0, v10
    revert 0, 32
  bb2:
    v22 = ne arg1, 0
    jumpi v22, bb3, bb4
  bb3:
    v20 = add arg0, 1
    mstore 0, v20
    revert 0, 32
  bb4:
    stop
}

// Blocks reading different outside values must NOT merge.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_outside_operands{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
fn @keep_distinct_outside_operands(arg0: i256, arg1: i256) {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, arg0
    revert 0, 32
  bb2:
    v1 = ne arg1, 0
    jumpi v1, bb3, bb4
  bb3:
    mstore 0, arg1
    revert 0, 32
  bb4:
    stop
}

// Semantic memory layouts are payload, not operands, so blocks using different
// fields must stay separate.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_memory_fields{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
fn @keep_distinct_memory_fields(arg0: i256, arg1: i256, arg2: memorystruct) {
  bb0:
    v2 = ne arg0, 0
    jumpi v2, bb1, bb2
  bb1:
    v0 = memory_object_load_field memorystruct<2>, arg2, 0
    mstore 0, v0
    revert 0, 32
  bb2:
    v3 = ne arg1, 0
    jumpi v3, bb3, bb4
  bb3:
    v1 = memory_object_load_field memorystruct<2>, arg2, 1
    mstore 0, v1
    revert 0, 32
  bb4:
    stop
}

// Packed literals are part of the operation, even though they are not SSA operands.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_packed_literals{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb1, bb2
// CHECK-DAG: {{^[ +].*}}keccak256_packed (data hex"61")
// CHECK-DAG: {{^[ +].*}}keccak256_packed (data hex"62")
fn @keep_distinct_packed_literals(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = keccak256_packed (data hex"61")
    mstore 0, v0
    returndata 0, 32
  bb2:
    v1 = keccak256_packed (data hex"62")
    mstore 0, v1
    returndata 0, 32
}

// Enum bounds remain distinct even when the array type and slot are identical.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_enum_bounds{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb1, bb2
// CHECK: {{^[ +].*}}load_storage_array enum<3>, arg1
// CHECK: {{^[ +].*}}load_storage_array enum<2>, arg1
fn @keep_distinct_enum_bounds(arg0: i1, arg1: i256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = load_storage_array enum<2>, arg1
    icall @consume_array, v0
    stop
  bb2:
    v1 = load_storage_array enum<3>, arg1
    icall @consume_array, v1
    stop
}

fn @consume_array(arg0: memoryarray) {
  bb0:
    ret
}

// Identical payloads still allow alpha-equivalent terminal blocks to merge.
// CHECK-LABEL: {{^[ +].*}}fn @merge_equal_packed_literals{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb1, bb2
// CHECK: {{^[ +].*}}keccak256_packed (data hex"61")
fn @merge_equal_packed_literals(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = keccak256_packed (data hex"61")
    mstore 0, v0
    returndata 0, 32
  bb2:
    v1 = keccak256_packed (data hex"61")
    mstore 0, v1
    returndata 0, 32
}

// Internal returns stay separate, so a loop's exit branch keeps a target of its own.
// CHECK-LABEL: {{^[ +].*}}fn @keep_internal_returns{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, bb1, bb2
// CHECK: {{^[ +].*}}bb2:
// CHECK-NEXT: {{^[ +].*}}ret 0
// CHECK: {{^[ +].*}}bb1:
// CHECK-NEXT: {{^[ +].*}}ret 0
fn @keep_internal_returns(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    ret 0
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_storage_literals{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb1, bb2
// CHECK-DAG: {{^[ +].*}}store_storage_bytes_literal arg1, hex"61"
// CHECK-DAG: {{^[ +].*}}store_storage_bytes_literal arg1, hex"62"
fn @keep_distinct_storage_literals(arg0: i1, arg1: i256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    store_storage_bytes_literal arg1, hex"61"
    stop
  bb2:
    store_storage_bytes_literal arg1, hex"62"
    stop
}

// Library addresses carry distinct relocation identities.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_libraries{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, bb1, bb2
// CHECK: library_address "B.sol":"L"
// CHECK: library_address "A.sol":"L"
fn @keep_distinct_libraries(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = library_address "A.sol":"L"
    v2 = zext i160 v0 to i256
    mstore 0, v2
    returndata 0, 32
  bb2:
    v1 = library_address "B.sol":"L"
    v3 = zext i160 v1 to i256
    mstore 0, v3
    returndata 0, 32
}
