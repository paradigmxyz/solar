//@compile-flags: --pass cfg-simplify
//@filecheck:
@module CfgDedupTerminalBlocks

// Two structurally identical panic blocks collapse into one shared block.
// CHECK-LABEL: {{^[ +].*}}fn @dedup_identical_panics{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, [[PANIC:bb[0-9]+]], {{bb[0-9]+}}
// CHECK: - jumpi arg1, bb3, bb4
// CHECK: + jumpi arg1, [[PANIC]], {{bb[0-9]+}}
fn @dedup_identical_panics(arg0: u256, arg1: u256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb4:
    stop
}

// Panic blocks with different panic codes must NOT merge.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_panic_codes{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg1, bb3, bb4
fn @keep_distinct_panic_codes(arg0: u256, arg1: u256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 18
    revert 0, 36
  bb4:
    stop
}

// Identical instructions but different terminator operands must NOT merge.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_revert_sizes{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg1, bb3, bb4
fn @keep_distinct_revert_sizes(arg0: u256, arg1: u256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 32
  bb4:
    stop
}

// Block-local values compare by definition position, so alpha-equivalent
// computations merge.
// CHECK-LABEL: {{^[ +].*}}fn @dedup_local_computations{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, [[COMPUTATION:bb[0-9]+]], {{bb[0-9]+}}
// CHECK: - jumpi arg1, bb3, bb4
// CHECK: + jumpi arg1, [[COMPUTATION]], {{bb[0-9]+}}
fn @dedup_local_computations(arg0: u256, arg1: u256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v10 = add arg0, 1
    mstore 0, v10
    revert 0, 32
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    v20 = add arg0, 1
    mstore 0, v20
    revert 0, 32
  bb4:
    stop
}

// Blocks reading different outside values must NOT merge.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_outside_operands{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg1, bb3, bb4
fn @keep_distinct_outside_operands(arg0: u256, arg1: u256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, arg0
    revert 0, 32
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    mstore 0, arg1
    revert 0, 32
  bb4:
    stop
}

// Immutable offsets are semantic instruction payloads, not operands.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_immutable_offsets{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, bb1, bb2
// CHECK: {{^[ +].*}}{{v[0-9]+}} = loadimmutable 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = loadimmutable 32
fn @keep_distinct_immutable_offsets(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v1 = loadimmutable 0
    ret v1
  bb2:
    v2 = loadimmutable 32
    ret v2
}

fn @tail_callee_a() {
  bb0:
    stop
}

fn @tail_callee_b() {
  bb0:
    stop
}

// The callee is semantic terminator payload, not an operand.
// CHECK-LABEL: {{^[ +].*}}fn @keep_distinct_tail_callees{{[( ]}}
// CHECK: {{^[ +].*}}jumpi arg0, bb1, bb2
// CHECK: {{^[ +].*}}tail_call @tail_callee_a
// CHECK: {{^[ +].*}}tail_call @tail_callee_b
fn @keep_distinct_tail_callees(arg0: bool) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    tail_call fn6
  bb2:
    tail_call fn7
}
