//@compile-flags: --pass cfg-simplify
//@filecheck: --enable-var-scope
@module CfgSimplifyPhiRewrites

// CHECK-LABEL: @empty_forwarder
// CHECK:       [[ENTRY:bb[0-9]+]]:
// CHECK: -     jumpi arg0, [[OTHER_BLOCK:bb[0-9]+]], [[REMOVED_BLOCK:bb[0-9]+]]
// CHECK: +     jumpi arg0, [[MERGE:bb[0-9]+]], [[OTHER_BLOCK]]
// CHECK:       [[OTHER_BLOCK]]:
// CHECK: -     jump [[OLD_MERGE:bb[0-9]+]]
// CHECK: -     [[REMOVED_BLOCK]]:
// CHECK:       [[OTHER:v[0-9]+]] = add 7, 42
// CHECK: -     jump [[OLD_MERGE]]
// CHECK: -     [[OLD_MERGE]]:
// CHECK: +     jump [[MERGE]]
// CHECK: +     [[MERGE]]:
// CHECK:       [[PHI:v[0-9]+]] = phi [[[ENTRY]]: 42], [[[OTHER_BLOCK]]: [[OTHER]]]
// CHECK:       ret [[PHI]]
fn @empty_forwarder(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    v1 = add 7, 42
    jump bb3
  bb3:
    v2 = phi [bb1: 42], [bb2: v1]
    ret v2
}

// CHECK-LABEL: @block_merge
// CHECK:       {{bb[0-9]+}}:
// CHECK: -     jumpi arg0, [[LEFT_BLOCK:bb[0-9]+]], [[OLD_RIGHT:bb[0-9]+]]
// CHECK: +     jumpi arg0, [[LEFT_BLOCK]], [[RIGHT_BLOCK:bb[0-9]+]]
// CHECK:       [[LEFT_BLOCK]]:
// CHECK: -     jump [[OLD_LEFT:bb[0-9]+]]
// CHECK: -     [[OLD_LEFT]]:
// CHECK:       [[LEFT:v[0-9]+]] = add 1, 2
// CHECK: -     jump [[OLD_MERGE:bb[0-9]+]]
// CHECK: -     [[OLD_RIGHT]]:
// CHECK: +     jump [[MERGE:bb[0-9]+]]
// CHECK: +     [[RIGHT_BLOCK]]:
// CHECK:       [[RIGHT:v[0-9]+]] = add 3, 4
// CHECK: -     jump [[OLD_MERGE]]
// CHECK: -     [[OLD_MERGE]]:
// CHECK: +     jump [[MERGE]]
// CHECK: +     [[MERGE]]:
// CHECK:       [[PHI:v[0-9]+]] = phi [[[LEFT_BLOCK]]: [[LEFT]]], [[[RIGHT_BLOCK]]: [[RIGHT]]]
// CHECK:       ret [[PHI]]
fn @block_merge(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb3
  bb1:
    jump bb2
  bb2:
    v1 = add 1, 2
    jump bb4
  bb3:
    v2 = add 3, 4
    jump bb4
  bb4:
    v3 = phi [bb2: v1], [bb3: v2]
    ret v3
}

// CHECK-LABEL: @expand_forwarder
// CHECK: +     switch arg0, default [[LEFT:bb[0-9]+]], [1 => [[RIGHT:bb[0-9]+]], 2 => [[OTHER:bb[0-9]+]]]
// CHECK:       [[LEFT]]:
// CHECK:       add 10, 1
// CHECK: +     jump [[JOIN:bb[0-9]+]]
// CHECK:       [[RIGHT]]:
// CHECK:       add 20, 2
// CHECK: +     jump [[JOIN]]
// CHECK:       [[OTHER]]:
// CHECK:       [[OTHER_VALUE:v[0-9]+]] = add 30, 3
// CHECK: +     jump [[JOIN]]
// CHECK: +     [[JOIN]]:
// CHECK: +     [[PHI:v[0-9]+]] = phi [[[LEFT]]: 42], [[[RIGHT]]: 42], [[[OTHER]]: [[OTHER_VALUE]]]
// CHECK:       ret [[PHI]]
fn @expand_forwarder(arg0: u256) -> u256 {
  bb0:
    switch arg0, default bb1, [1 => bb2, 2 => bb4]
  bb1:
    v0 = add 10, 1
    jump bb3
  bb2:
    v1 = add 20, 2
    jump bb3
  bb3:
    jump bb5
  bb4:
    v2 = add 30, 3
    jump bb5
  bb5:
    v3 = phi [bb3: 42], [bb4: v2]
    ret v3
}
