-     jumpi arg0, bb3, bb4
-   bb4:
-     v1 = phi [bb1: 9], [bb2: 10]
-     ret v1
+     jump bb3
    bb3:
      v0 = phi [bb1: 7], [bb2: 8]
      ret v0
  }
  
  fn @multiple_incoming_edges(arg0: bool, arg1: bool) -> u256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:
      jumpi arg1, bb3, bb4
