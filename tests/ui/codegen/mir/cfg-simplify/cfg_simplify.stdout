      v0 = add arg0, 1
-     jump bb1
-   bb1:
      v1 = add v0, 1
-     jump bb2
-   bb2:
      v2 = add v1, 1
      ret v2
  }
  
  fn @branch_forwarder_preserves_successor_order(arg0: bool) -> u256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:
-     jump bb3
-   bb3:
      ret 2
    bb1:
      ret 1
  }
  
  fn @degenerate_branch_refreshes_successors(arg0: bool) -> u256 {
    bb0:
-     jumpi arg0, bb1, bb1
-   bb1:
      ret 1
  }
  
  fn @ordered_switch(arg0: u256) -> u256 {
    bb0:
      switch 5, default bb1, [arg0 => bb1, 5 => bb2]
    bb2:
      ret 2
    bb1:
      ret 1
  }
  
  fn @degenerate_switch_refreshes_successors(arg0: u256) -> u256 {
    bb0:
-     switch arg0, default bb1, [0 => bb1, 1 => bb1]
-   bb1:
      ret 1
  }
  
  fn @constant_false_branch() -> u256 {
    bb0:
-     jumpi false, bb1, bb2
-   bb2:
      ret 2
-   bb1:
-     ret 1
  }
  
  fn @constant_nonzero_branch() -> u256 {
    bb0:
-     jumpi 2, bb1, bb2
-   bb2:
-     ret 2
-   bb1:
      ret 1
  }
  
