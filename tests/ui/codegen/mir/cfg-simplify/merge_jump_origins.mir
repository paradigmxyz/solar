//@ revisions: ir check
//@ compile-flags: -Zmir-pipeline=cfg-simplify
//@[ir] filecheck:
//@[check] compile-flags: -Zdebugify=check
//~[check]? ERROR: debugify: MIR pass `cfg-simplify` lost 2 source origins
// A removed jump hands its origin to the operation that now runs in its place, unless that
// operation is located already. A second span would unmap a located instruction in the legacy
// source map.
@module MergeJumpOrigins

// The merged block's first instruction has no origin.
// CHECK-LABEL: {{^[ +].*}}fn @first_unlocated{{[( ]}}
// CHECK: + {{v[0-9]+}} = add arg0, 1 !metadata(span=10..20)
// CHECK: ret {{v[0-9]+}} !metadata(span=30..40)
fn @first_unlocated(arg0: i256) -> i256 {
  bb0:
    jump bb1 !metadata(span=10..20)
  bb1:
    v0 = add arg0, 1
    ret v0 !metadata(span=30..40)
}

// Without instructions, the merged block's terminator takes it.
// CHECK-LABEL: {{^[ +].*}}fn @terminator_unlocated{{[( ]}}
// CHECK: + ret arg0 !metadata(span=50..60)
fn @terminator_unlocated(arg0: i256) -> i256 {
  bb0:
    jump bb1 !metadata(span=50..60)
  bb1:
    ret arg0
}

// The merged block's first operation is located, so the jump's origin goes to the pure
// instruction before it.
// CHECK-LABEL: {{^[ +].*}}fn @prefix_unlocated{{[( ]}}
// CHECK: + {{v[0-9]+}} = add arg0, 1 !metadata(span=70..80)
// CHECK: {{v[0-9]+}} = mul {{v[0-9]+}}, 2 !metadata(span=90..100)
fn @prefix_unlocated(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1
    jump bb1 !metadata(span=70..80)
  bb1:
    v1 = mul v0, 2 !metadata(span=90..100)
    ret v1 !metadata(span=110..120)
}

// Both carriers are located, and a side-effecting last instruction is never chosen: the jump's
// origin is dropped, which the debugify revision counts.
fn @both_located(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1 !metadata(span=130..140)
    jump bb1 !metadata(span=150..160)
  bb1:
    v1 = mul v0, 2 !metadata(span=170..180)
    ret v1 !metadata(span=190..200)
}

// A side-effecting last instruction never takes the jump's origin.
fn @prefix_side_effect(arg0: i256) {
  bb0:
    sstore arg0, arg0
    jump bb1 !metadata(span=210..220)
  bb1:
    v0 = add arg0, 1 !metadata(span=230..240)
    ret !metadata(span=250..260)
}

// A forwarder that is its target's only predecessor, with one predecessor, hands its origin to
// the target's first operation.
// CHECK-LABEL: {{^[ +].*}}fn @forwarder_unlocated{{[( ]}}
// CHECK: + {{v[0-9]+}} = add arg0, 1 !metadata(span=270..280)
fn @forwarder_unlocated(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb3 !metadata(span=262..266)
  bb1:
    jump bb2 !metadata(span=270..280)
  bb2:
    v0 = add arg0, 1
    ret v0 !metadata(span=290..300)
  bb3:
    ret arg0 !metadata(span=310..320)
}
