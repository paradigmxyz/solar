- ; === ROOT/tests/ui/codegen/mir/check-elim/reduced_conditions.mir (before check-elim) ===
+ ; === ROOT/tests/ui/codegen/mir/check-elim/reduced_conditions.mir (after check-elim) ===
  @module ReducedConditions
  fn @nonzero_factor(arg0: i256) -> i256 {
    bb0:
      jump bb1
    bb1:                                            ; preds = bb0, bb3
      v0 = phi [bb0: 2], [bb3: v8]
      v1 = phi [bb0: 1], [bb3: v3]
      v2 = lt arg0, v0
      jumpi v2, bb5, bb2
    bb2:                                            ; preds = bb1
      v3 = mul v1, v0
      v4 = eq v0, 0
      v5 = div v3, v0
      v6 = eq v5, v1
      v7 = or v4, v6
-     jumpi v7, bb3, bb4
+     jumpi v6, bb3, bb4
    bb4 [cold]:                                     ; preds = bb2
      revert 0, 0
    bb3:                                            ; preds = bb2
      v8 = add v0, 1
      jump bb1
    bb5:                                            ; preds = bb1
      ret v1
  }
  
  fn @nested_and(arg0: i256, arg1: i256) -> i256 {
    bb0:
      jump bb1
    bb1:                                            ; preds = bb0, bb3
      v0 = phi [bb0: 0], [bb3: v7]
      v1 = lt v0, 100
      jumpi v1, bb2, bb5
    bb5:                                            ; preds = bb1
      ret v0
    bb2:                                            ; preds = bb1
      v2 = lt v0, 100
      v3 = lt v0, 200
      v4 = lt v0, arg1
      v5 = and v2, v4
      v6 = and v5, v3
-     jumpi v6, bb3, bb4
+     jumpi v4, bb3, bb4
    bb4 [cold]:                                     ; preds = bb2
      revert 0, 0
    bb3:                                            ; preds = bb2
      v7 = add v0, 1
      jump bb1
  }
  
  fn @undecided(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = eq arg0, 0
      v1 = eq arg1, 0
      v2 = or v0, v1
      jumpi v2, bb1, bb2
    bb2:                                            ; preds = bb0
      ret arg0
    bb1 [cold]:                                     ; preds = bb0
      revert 0, 0
  }
  
