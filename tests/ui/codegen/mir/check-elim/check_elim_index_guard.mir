//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module CheckElimIndexGuard

// A dominating `i < 3` guard proves the array bounds check `lt i, 3`
// (the shape emitted for `if (i < 3) { x[i] }` on a fixed-size array), so
// the check folds to the continue edge and the Panic(0x32) block dies.
// CHECK-LABEL: {{^[ +].*}}fn @fold_const_len_check{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb2
// CHECK: + jump bb3
fn @fold_const_len_check(arg0: i256) -> i256 {
  bb0:
    v1 = lt arg0, 3
    jumpi v1, bb1, bb4
  bb1:
    v2 = lt arg0, 3
    jumpi v2, bb3, bb2
  bb2:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 50
    revert 0, 36
  bb3:
    v3 = shl 5, arg0
    v4 = mload v3
    ret v4
  bb4:
    ret 0
}

// A dominating `i < len` guard on the same SSA length value proves the
// bounds check for a dynamic array (`if (i < x.length) { x[i] }` once load
// CSE merges the two length loads), so the check folds.
// CHECK-LABEL: {{^[ +].*}}fn @fold_dyn_len_check{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb2
// CHECK: + jump bb3
fn @fold_dyn_len_check(arg0: i256) -> i256 {
  bb0:
    v1 = sload 0
    v2 = lt arg0, v1
    jumpi v2, bb1, bb4
  bb1:
    v3 = lt arg0, v1
    jumpi v3, bb3, bb2
  bb2:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 50
    revert 0, 36
  bb3:
    v4 = add arg0, 100
    v5 = sload v4
    ret v5
  bb4:
    ret 0
}

// The guard checks a different bound (`i < 2` does prove `i < 3`, but
// `i < 5` does not), so the bounds check must stay.
// CHECK-LABEL: {{^[ +].*}}fn @keep_weaker_guard{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb2
fn @keep_weaker_guard(arg0: i256) -> i256 {
  bb0:
    v1 = lt arg0, 5
    jumpi v1, bb1, bb4
  bb1:
    v2 = lt arg0, 3
    jumpi v2, bb3, bb2
  bb2:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 50
    revert 0, 36
  bb3:
    v3 = shl 5, arg0
    v4 = mload v3
    ret v4
  bb4:
    ret 0
}

// CHECK-LABEL: fn @semantic_guards
// CHECK: icall revert_if_zero<empty>, arg0
// CHECK: - icall panic_if_zero<0x1>, arg0
// CHECK: - icall panic_if_zero<0x32>, v0
fn @semantic_guards(arg0: i1, arg1: i256) {
  bb0:
    icall revert_if_zero<empty>, arg0
    icall panic_if_zero<0x1>, arg0
    v0 = lt arg1, 4
    icall revert_if_zero<empty>, v0
    icall panic_if_zero<0x32>, v0
    ret
}

// CHECK-LABEL: fn @conditional_guard
// CHECK-DAG: icall panic_if_zero<0x1>, arg1{{$}}
// CHECK-DAG: - icall panic_if_zero<0x32>, arg1
// CHECK-DAG: icall panic_if_zero<0x12>, arg1
fn @conditional_guard(arg0: i1, arg1: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    icall panic_if_zero<0x1>, arg1
    icall panic_if_zero<0x32>, arg1
    jump bb3
  bb2:
    icall panic_if_zero<0x12>, arg1
    jump bb3
  bb3:
    ret
}
