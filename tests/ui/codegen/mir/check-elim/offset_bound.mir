//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module OffsetBound

// The header runs the loop while `i + 3 < n`, and the counter's literal
// start and step keep `i + 3` from wrapping: the lookahead guard `i + 1 < n`
// and the plain bound `i < n` follow and fold, while `i + 5 < n` does not
// follow and keeps its branch.
// CHECK-LABEL: {{^[ +].*}}fn @lookahead{{[( ]}}
// CHECK: - jumpi v4, bb3, bb7
// CHECK: + jump bb3
// CHECK: - jumpi v5, bb4, bb7
// CHECK: + jump bb4
// CHECK: {{^ +}}jumpi v7, bb5, bb7
fn @lookahead(arg0: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb7: v9]
    v1 = add v0, 3
    v2 = lt v1, arg0
    jumpi v2, bb2, bb5
  bb2:
    v3 = add v0, 1
    v4 = lt v3, arg0
    jumpi v4, bb3, bb6
  bb3:
    v5 = lt v0, arg0
    jumpi v5, bb4, bb6
  bb4:
    v6 = add v0, 5
    v7 = lt v6, arg0
    jumpi v7, bb7, bb6
  bb7:
    v9 = add v0, 4
    jump bb1
  bb5:
    ret v0
  bb6:
    revert 0, 0
}
