- // === ROOT/tests/ui/codegen/mir/check-elim/object_length_assembly.mir (before check-elim) ===
+ // === ROOT/tests/ui/codegen/mir/check-elim/object_length_assembly.mir (after check-elim) ===
  @module CheckElimAssemblyLengths
  @inline_assembly
  fn @sum_of_lengths(arg0: memoryarray, arg1: memorybytes) -> i256 {
    bb0:
      v0 = memory_object_len memoryarray, arg0
      v1 = memory_object_len memorybytes, arg1
      v2 = add v0, v1
      v3 = lt v2, v0
      jumpi v3, bb1, bb2
    bb2:
      ret v2
    bb1:
      revert 0, 0
  }
  
