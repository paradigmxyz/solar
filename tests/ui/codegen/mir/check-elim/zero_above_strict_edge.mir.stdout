; === ROOT/tests/ui/codegen/mir/check-elim/zero_above_strict_edge.sol:C ===
@module C
; function f(uint256 x) public pure returns (uint256) [selector 0xb3de648b]
fn @f(arg0: i256) -> i256 [selector=0xb3de648b, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = checked_div uint256, arg0, 2
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v1 = phi [bb0: arg0], [bb3: v3]
    v2 = phi [bb0: 0], [bb3: v2]
    v3 = phi [bb0: v0], [bb3: v6]
    v4 = lt v3, v1
    jumpi v4, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v1
  bb4:                                            ; preds = bb1
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v5 = checked_div uint256, 1, v3
    v6 = checked_add uint256, v3, v5
    jump bb1
}
