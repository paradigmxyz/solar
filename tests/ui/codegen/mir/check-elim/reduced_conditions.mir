//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module ReducedConditions

// A checked product tests `i == 0 || p / i == r`; a counter that starts at two
// is never zero, so the branch reads the quotient test alone.
// CHECK-LABEL: {{^[ +].*}}fn @nonzero_factor{{[( ]}}
// CHECK: [[QUOTIENT:v[0-9]+]] = eq {{v[0-9]+}}, {{v[0-9]+}}
// CHECK: - jumpi {{v[0-9]+}}, bb3, bb4
// CHECK-NEXT: + jumpi [[QUOTIENT]], bb3, bb4
fn @nonzero_factor(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 2], [bb3: v8]
    v1 = phi [bb0: 1], [bb3: v3]
    v2 = gt v0, arg0
    jumpi v2, bb5, bb2
  bb2:
    v3 = mul v1, v0
    v4 = eq v0, 0
    v5 = div v3, v0
    v6 = eq v5, v1
    v7 = or v4, v6
    jumpi v7, bb3, bb4
  bb3:
    v8 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A conjunction drops an operand that holds, here a bound the loop test
// established, and reduction repeats through nested conditions.
// CHECK-LABEL: {{^[ +].*}}fn @nested_and{{[( ]}}
// CHECK: [[BOUND:v[0-9]+]] = gt arg1, {{v[0-9]+}}
// CHECK: - jumpi {{v[0-9]+}}, bb3, bb4
// CHECK-NEXT: + jumpi [[BOUND]], bb3, bb4
fn @nested_and(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v9]
    v1 = lt v0, 100
    jumpi v1, bb2, bb5
  bb2:
    v3 = lt v0, 100
    v4 = lt v0, 200
    v5 = gt arg1, v0
    v6 = and v3, v5
    v8 = and v6, v4
    jumpi v8, bb3, bb4
  bb3:
    v9 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v0
}

// Neither operand is decided: the condition stays.
// CHECK-LABEL: {{^[ +].*}}fn @undecided{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @undecided(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = eq arg0, 0
    v1 = eq arg1, 0
    v2 = or v0, v1
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret arg0
}
