//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module ShiftedProducts

// A checked product by 32, as a calldata element offset `i * 32`, tests that
// `(i << 5) >> 5` gives `i` back. A counter that starts at a constant and
// steps by one keeps far below `2^251`, so the shift keeps every bit.
// CHECK-LABEL: {{^[ +].*}}fn @counter_offset{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb4, bb3
// CHECK: + jump bb3
fn @counter_offset(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v8]
    v1 = phi [bb0: 0], [bb3: v7]
    v2 = lt v0, arg1
    jumpi v2, bb2, bb5
  bb2:
    v3 = shl 5, v0
    v4 = shr 5, v3
    v5 = ne v4, v0
    jumpi v5, bb4, bb3
  bb3:
    v6 = add arg0, v3
    v7 = calldataload v6
    v8 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// An index the caller chooses may have its top bits set, so the check stays.
// CHECK-LABEL: {{^[ +].*}}fn @unbounded_index{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb2, bb1
fn @unbounded_index(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = shl 5, arg1
    v1 = shr 5, v0
    v2 = ne v1, arg1
    jumpi v2, bb2, bb1
  bb1:
    v3 = add arg0, v0
    v4 = calldataload v3
    ret v4
  bb2:
    revert 0, 0
}

// Shifting back by a different amount is not the product's round trip.
// CHECK-LABEL: {{^[ +].*}}fn @mismatched_shift{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb4, bb3
fn @mismatched_shift(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v6]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb5
  bb2:
    v2 = shl 5, v0
    v3 = shr 4, v2
    v4 = ne v3, v0
    jumpi v4, bb4, bb3
  bb3:
    v6 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v0
}
