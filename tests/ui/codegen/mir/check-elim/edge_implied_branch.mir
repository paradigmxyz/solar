//@ revisions: runs200 runs10000
//@ compile-flags: -Zmir-pipeline=check-elim
//@[runs10000] compile-flags: --optimize-runs 10000
//@[runs200] filecheck: --check-prefixes=CHECK,RUNS200
//@[runs10000] filecheck: --check-prefixes=CHECK,RUNS10000
@module EdgeImpliedBranch

// Sequential tests over exclusive ranges: after `x < 9` neither later test can
// hold, and after `8 < x < 17` the last cannot. Each arm jumps past the joins
// whose branch it decides, and the phis of the join it enters take the values
// the skipped join's phis would have passed on. The arm of the last test reads
// a phi of its join, which still dominates it. Each redirect may add a jump, so
// only a build for 10,000 runs, where the tests it skips repay the deposit,
// takes them.
// CHECK-LABEL: {{^[ +].*}}fn @chain{{[( ]}}
// RUNS200-NOT: {{^[-+]}}
// RUNS10000: bb3:
// RUNS10000-NEXT: v6 = shr arg1, 3
// RUNS10000-NEXT: + jump bb6
// RUNS10000-NEXT: + bb1:
// RUNS10000-NEXT: + v1 = and arg1, 255
// RUNS10000-NEXT: jump bb4
// RUNS10000: + v7 = phi [bb2: v2], [bb1: v1]
// RUNS10000: + v10 = phi [bb5: v9], [bb4: v7], [bb3: v6]
// RUNS10000-NEXT: + v11 = phi [bb5: 1], [bb4: arg1], [bb3: arg1]
fn @chain(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = lt arg0, 9
    jumpi v0, bb1, bb2
  bb1:
    v1 = and arg1, 255
    jump bb2
  bb2:
    v2 = phi [bb1: v1], [bb0: 0]
    v3 = gt arg0, 8
    v4 = lt arg0, 17
    v5 = and v3, v4
    jumpi v5, bb3, bb4
  bb3:
    v6 = shr arg1, 3
    jump bb4
  bb4:
    v7 = phi [bb3: v6], [bb2: v2]
    v8 = gt arg0, 16
    jumpi v8, bb5, bb6
  bb5:
    v9 = add v7, 7
    jump bb6
  bb6:
    v10 = phi [bb5: v9], [bb4: v7]
    v11 = phi [bb5: 1], [bb4: arg1]
    v12 = add v10, v11
    ret v12
}

// Each edge of a branch decides the next test too: the false edge enters the
// second arm directly, and the join is left without predecessors. Its code
// pays for both jumps, so every build takes them.
// CHECK-LABEL: {{^[ +].*}}fn @branch_edge{{[( ]}}
// CHECK: + jumpi v0, bb1, bb3
// CHECK: + v5 = phi [bb3: v4], [bb2: v2], [bb1: v1]
fn @branch_edge(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 192
    jumpi v0, bb1, bb2
  bb1:
    v1 = sub arg0, 48
    jump bb2
  bb2:
    v2 = phi [bb1: v1], [bb0: 0]
    v3 = gt arg0, 191
    jumpi v3, bb3, bb4
  bb3:
    v4 = add arg0, 88
    jump bb4
  bb4:
    v5 = phi [bb3: v4], [bb2: v2]
    ret v5
}

// `x < 20` does not decide `x > 8`, and the other edge into the join states
// nothing about `x`.
// CHECK-LABEL: {{^[ +].*}}fn @undecided{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @undecided(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = lt arg0, 20
    jumpi v0, bb3, bb4
  bb3:
    jump bb2
  bb4:
    ret 2
  bb2:
    v1 = gt arg0, 8
    jumpi v1, bb5, bb6
  bb5:
    ret 1
  bb6:
    ret 0
}

// The latch knows the header test holds, but the header dominates it: the
// edge stays a backedge.
// CHECK-LABEL: {{^[ +].*}}fn @latch{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @latch(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = lt arg0, 10
    jumpi v0, bb2, bb3
  bb2:
    jumpi arg1, bb4, bb3
  bb4:
    jump bb1
  bb3:
    ret 0
}

// The join computes a value that the decided successor reads, so the edge from
// `bb1` cannot skip it.
// CHECK-LABEL: {{^[ +].*}}fn @escaping_result{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @escaping_result(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = lt arg0, 9
    jumpi v0, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v1 = gt arg0, 16
    v2 = add arg1, 1
    jumpi v1, bb3, bb4
  bb3:
    ret 0
  bb4:
    ret v2
}

// Threads out of a join and into it share an edge: `bb3`'s true edge skips
// `bb4`, while `bb1` skips `bb3` into `bb4`. Either order reads the inputs
// before any edge moves. At 200 runs only the edges into `bb3`, which they
// leave without predecessors, move.
// CHECK-LABEL: {{^[ +].*}}fn @order{{[( ]}}
// RUNS200: + v3 = phi [bb3: v1], [bb4: 7], [bb1: 1]
// RUNS10000: + v3 = phi [bb4: 7], [bb1: 1]
// RUNS10000: + v5 = phi [bb5: v3], [bb3: v1]
fn @order(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 5
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 1], [bb2: 2]
    v2 = lt arg0, 5
    jumpi v2, bb4, bb5
  bb5:
    jump bb4
  bb4:
    v3 = phi [bb3: v1], [bb5: 7]
    v4 = lt arg0, 100
    jumpi v4, bb6, bb7
  bb6:
    v5 = phi [bb4: v3]
    ret v5
  bb7:
    ret 0
}

// The true edge of `bb1` decides that `bb2` goes to `bb3`, which the other arm
// of `bb1` enters already: the edge stays.
// CHECK-LABEL: {{^[ +].*}}fn @other_arm{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @other_arm(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = lt arg0, 9
    jumpi v0, bb2, bb3
  bb2:
    v1 = lt arg0, 10
    jumpi v1, bb3, bb4
  bb3:
    ret 1
  bb4:
    ret 0
}

// The join stores, so no edge may skip it.
// CHECK-LABEL: {{^[ +].*}}fn @impure_join{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @impure_join(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 9
    jumpi v0, bb1, bb2
  bb1:
    jump bb2
  bb2:
    mstore 0, arg0
    v1 = gt arg0, 16
    jumpi v1, bb3, bb4
  bb3:
    ret 1
  bb4:
    ret 0
}
