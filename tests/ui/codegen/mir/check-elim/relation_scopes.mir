//@compile-flags: -Zmir-pipeline=check-elim
@module RelationScopes

// Facts learned in one arm must not leak into its sibling or the join.
fn @siblings(arg0: bool, arg1: u256, arg2: u256, arg3: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb4
  bb1:
    v0 = lt arg1, arg2
    jumpi v0, bb2, bb7
  bb2:
    v1 = lt arg2, arg3
    jumpi v1, bb3, bb7
  bb3:
    v2 = lt arg1, arg3
    jumpi v2, bb6, bb7
  bb4:
    v3 = lt arg1, arg3
    jumpi v3, bb5, bb7
  bb5:
    v5 = lt arg2, arg3
    jumpi v5, bb6, bb7
  bb6:
    v4 = lt arg1, arg2
    jumpi v4, bb8, bb7
  bb7:
    ret 0
  bb8:
    ret 1
}

// Equality edges work both ways, but a non-strict path cannot imply strictness.
fn @mixed_edges(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = eq arg1, arg0
    jumpi v0, bb1, bb5
  bb1:
    v1 = gt arg1, arg2
    jumpi v1, bb5, bb2
  bb2:
    v2 = gt arg0, arg2
    jumpi v2, bb5, bb3
  bb3:
    v3 = lt arg0, arg2
    jumpi v3, bb4, bb5
  bb4:
    ret 1
  bb5:
    ret 0
}

// Disequality supplies no transitive path: a != b and b != c allow a == c.
fn @disequality(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = eq arg0, arg1
    jumpi v0, bb4, bb1
  bb1:
    v1 = eq arg1, arg2
    jumpi v1, bb4, bb2
  bb2:
    v2 = eq arg0, arg2
    jumpi v2, bb3, bb4
  bb3:
    ret 1
  bb4:
    ret 0
}
