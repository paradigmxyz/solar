    jump bb3
  bb1:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v5 = phi [bb1: v3], [bb2: i8 128]
    v6 = slt v5, i8 0
    v7 = eq v6, false
    v8 = eq v7, false
    icall revert_if<empty>, v8
    ret v5
}

