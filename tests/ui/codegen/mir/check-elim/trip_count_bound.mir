//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module TripCountBound

// A counter that starts at a constant and grows by a constant step cannot
// reach the top of the word within any affordable number of iterations, so
// `i + 2` never wraps even though `i < n` alone leaves `i + 2` unbounded.
// CHECK-LABEL: {{^[ +].*}}fn @constant_start_and_step{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb4, bb3
// CHECK: + jump bb3
fn @constant_start_and_step(arg0: memptr) -> i256 {
  bb0:
    v10 = memory_slice arg0
    v0 = slice_len v10
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v6]
    v2 = lt v1, v0
    jumpi v2, bb2, bb5
  bb2:
    v3 = add v1, 2
    v4 = lt v3, v1
    jumpi v4, bb4, bb3
  bb3:
    v6 = add v1, 4
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A counter that starts at an arbitrary word may already sit near the top,
// so the same check stays.
// CHECK-LABEL: {{^[ +].*}}fn @unknown_start{{[( ]}}
// CHECK: {{^ +}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb4, bb3
fn @unknown_start(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    v10 = memory_slice arg0
    v0 = slice_len v10
    jump bb1
  bb1:
    v1 = phi [bb0: arg1], [bb3: v6]
    v2 = lt v1, v0
    jumpi v2, bb2, bb5
  bb2:
    v3 = add v1, 2
    v4 = lt v3, v1
    jumpi v4, bb4, bb3
  bb3:
    v6 = add v1, 4
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A counter that only some iterations advance, `if (c) ++count`, moves at most
// its largest step per iteration, so its increment never wraps either.
// CHECK-LABEL: {{^[ +].*}}fn @conditional_counter{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb6, bb4
// CHECK: + jump bb4
fn @conditional_counter(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v9]
    v1 = phi [bb0: 0], [bb5: v6]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb7
  bb2:
    v3 = and arg1, v0
    v4 = ne v3, 0
    jumpi v4, bb3, bb4
  bb3:
    v5 = add v1, 1
    v8 = eq v5, 0
    jumpi v8, bb6, bb4
  bb4:
    v6 = phi [bb2: v1], [bb3: v5]
    jump bb5
  bb5:
    v9 = add v0, 1
    jump bb1
  bb6:
    revert 0, 0
  bb7:
    ret v1
}

// Counters that select between two steps take the larger one.
// CHECK-LABEL: {{^[ +].*}}fn @selected_steps{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb4, bb3
// CHECK: + jump bb3
fn @selected_steps(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v9]
    v1 = phi [bb0: 5], [bb3: v6]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v3 = add v1, 3
    v4 = add v1, 7
    v5 = select arg1, v3, v4
    v7 = lt v4, v1
    jumpi v7, bb4, bb3
  bb3:
    v6 = phi [bb2: v5]
    v9 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A counter an inner loop advances moves more than one step per outer
// iteration, so its check stays.
// CHECK-LABEL: {{^[ +].*}}fn @inner_loop_counter{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @inner_loop_counter(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v9]
    v1 = phi [bb0: 0], [bb5: v4]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb7
  bb2:
    jump bb3
  bb3:
    v3 = phi [bb2: 0], [bb4: v8]
    v4 = phi [bb2: v1], [bb4: v5]
    v6 = lt v3, arg1
    jumpi v6, bb4, bb5
  bb4:
    v5 = add v4, 1
    v7 = eq v5, 0
    v8 = add v3, 1
    jumpi v7, bb6, bb3
  bb5:
    v9 = add v0, 1
    jump bb1
  bb6:
    revert 0, 0
  bb7:
    ret v1
}

// A counter that also doubles has no additive bound: its check stays.
// CHECK-LABEL: {{^[ +].*}}fn @doubling_counter{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @doubling_counter(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v9]
    v1 = phi [bb0: 1], [bb3: v6]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v3 = add v1, 1
    v4 = add v1, v1
    v5 = select arg1, v3, v4
    v7 = eq v3, 0
    jumpi v7, bb4, bb3
  bb3:
    v6 = phi [bb2: v5]
    v9 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}
