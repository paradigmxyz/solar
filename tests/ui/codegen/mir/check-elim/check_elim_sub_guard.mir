//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module CheckElimSubGuard

// The `require(b <= a)` guard lowers to a revert on `gt b, a` through an
// iszero chain. On the surviving edge `a >= b` holds, so the checked
// subtraction's underflow test `lt a, b` is constant false.
// CHECK-LABEL: {{^[ +].*}}fn @fold_sub_after_ge_guard{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
// CHECK: + jump bb4
fn @fold_sub_after_ge_guard(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v1 = gt arg1, arg0
    v2 = eq v1, false
    v3 = eq v2, false
    jumpi v3, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v4 = sub arg0, arg1
    v5 = lt arg0, arg1
    jumpi v5, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    ret v4
}

// Without a dominating guard the underflow check must stay.
// CHECK-LABEL: {{^[ +].*}}fn @keep_sub_without_guard{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb1, bb2
fn @keep_sub_without_guard(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v1 = sub arg0, arg1
    v2 = lt arg0, arg1
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v1
}

// The guarded values are arg0/arg1, but the checked subtraction uses a new
// SSA value derived from a fresh load: no fact transfers, the check stays.
// CHECK-LABEL: {{^[ +].*}}fn @keep_sub_on_other_value{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
fn @keep_sub_on_other_value(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v1 = gt arg1, arg0
    jumpi v1, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v2 = mload 0
    v3 = sub v2, arg1
    v4 = lt v2, arg1
    jumpi v4, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    ret v3
}

// On the edge where `b <= a`, `a - b` cannot wrap even though `b` is an
// unbounded word, so the difference stays below `a < 2^192` and the checked
// sum `(a - b) + a` folds.
// CHECK-LABEL: {{^[ +].*}}fn @fold_sum_of_ordered_difference{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb4
// CHECK: + jump bb4
fn @fold_sum_of_ordered_difference(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = shr 64, arg0
    v1 = gt arg1, v0
    jumpi v1, bb1, bb2
  bb1:
    ret 0
  bb2:
    v2 = sub v0, arg1
    v3 = add v2, v0
    v4 = lt v3, v2
    jumpi v4, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    ret v3
}

// Without the ordering the difference may wrap to any word: the check stays.
// CHECK-LABEL: {{^[ +].*}}fn @keep_sum_of_unordered_difference{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb1, bb2
fn @keep_sum_of_unordered_difference(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = shr 64, arg0
    v2 = sub v0, arg1
    v3 = add v2, v0
    v4 = lt v3, v2
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v3
}
