//@ compile-flags: -Zmir-pipeline=check-elim
//@ filecheck:
@module PaddedSize

// The overflow test of a bytes object's allocation size, `((x + 31) & ~31) + 32 < x`, holds exactly
// when `x + 63` wraps, so a length that leaves room for 63 passes it.
// CHECK-LABEL: fn @bounded
// CHECK: - jumpi {{v[0-9]+}}, bb1, bb2
// CHECK: + jump bb2
fn @bounded(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 0xffffffff
    v1 = add v0, 31
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v3 = add v2, 32
    v5 = lt v3, v0
    jumpi v5, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret v3
}

// The same test on the `(x + 63) & ~31` spelling of the size.
// CHECK-LABEL: fn @bounded_sum
// CHECK: - jumpi {{v[0-9]+}}, bb1, bb2
// CHECK: + jump bb2
fn @bounded_sum(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 0xffffffff
    v1 = add v0, 63
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v4 = lt v2, v0
    jumpi v4, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret v2
}

// A length that may be any word can wrap, so the test stays.
// CHECK-LABEL: fn @unbounded
// CHECK: jumpi
fn @unbounded(arg0: i256) -> i256 {
  bb0:
    v1 = add arg0, 31
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v3 = add v2, 32
    v5 = lt v3, arg0
    jumpi v5, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret v3
}
