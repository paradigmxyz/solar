- // === ROOT/tests/ui/codegen/mir/check-elim/redundant_cleanup.mir (before check-elim) ===
+ // === ROOT/tests/ui/codegen/mir/check-elim/redundant_cleanup.mir (after check-elim) ===
  @module RedundantCleanup
  fn @mask(arg0: i256) -> i256 {
    bb0:
      v0 = lt arg0, 0x10000000000000000000000000000000000
      jumpi v0, bb1, bb2
    bb2:
      revert 0, 0
    bb1:
      v1 = and arg0, 0xffffffffffffffffffffffffffffffffff
-     ret v1
+     ret arg0
  }
  
  fn @sign(arg0: i256) -> i256 {
    bb0:
      v0 = lt arg0, 0x8000000000000000000000000000
      jumpi v0, bb1, bb2
    bb2:
      revert 0, 0
    bb1:
      v1 = signextend 13, arg0
-     ret v1
+     ret arg0
  }
  
  fn @after_failing_call(arg0: i256) -> i256 {
    bb0:
      v0 = lt arg0, 0x10000000000000000000000000000000000
      jumpi v0, bb2, bb1
    bb1:
      icall @fail
      jump bb2
    bb2:
      v1 = and arg0, 0xffffffffffffffffffffffffffffffffff
-     ret v1
+     ret arg0
  }
  
  fn @after_returning_call(arg0: i256) -> i256 {
    bb0:
      v0 = lt arg0, 0x10000000000000000000000000000000000
      jumpi v0, bb2, bb1
    bb1:
      icall @log
      jump bb2
    bb2:
      v1 = and arg0, 0xffffffffffffffffffffffffffffffffff
      ret v1
  }
  
  fn @wider(arg0: i256) -> i256 {
    bb0:
      v0 = lt arg0, 0x20000000000000000000000000000000000
      jumpi v0, bb1, bb2
    bb2:
      revert 0, 0
    bb1:
      v1 = and arg0, 0xffffffffffffffffffffffffffffffffff
      ret v1
  }
  
  fn @fail() {
    bb0:
      revert 0, 0
  }
  
  fn @log() {
    bb0:
      sstore 0, 1
      ret
  }
  
