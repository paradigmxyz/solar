}

; function pick(uint256[] calldata values, uint256 i) external pure returns (uint256) [selector 0x9d6a1cd3]
fn @pick(arg0: slice<calldata>, arg1: i256) -> i256 [selector=0x9d6a1cd3, pure, abi_params=[array<_, uint256>, uint256], abi_returns=[word], abi_return_params=[uint256]] {
