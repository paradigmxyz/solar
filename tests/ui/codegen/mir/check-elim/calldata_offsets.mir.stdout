    v1 = lt arg1, v0
    v2 = eq v1, false
    icall panic_if<0x32>, v2
    v3 = extract_value slice<calldata>, arg0, 0
    v4 = mul arg1, 32
    v5 = eq 32, 0
    v6 = div v4, 32
    v7 = eq v6, arg1
    v8 = or v5, v7
    v9 = zext i1 v8 to i256
    v10 = eq v9, 0
    icall panic_if<0x41>, v10
    v11 = ptrtoint ptr<calldata> v3 to i256
    v12 = add v11, v4
    v13 = calldataload v12
    ret v13
}
