    v7 = eq v6, false
    icall panic_if<0x32>, v7
    v8 = extract_value slice<calldata>, v0, 0
    v9 = mul v2, 32
    v10 = gt v2, 0x7ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    icall panic_if<0x41>, v10
