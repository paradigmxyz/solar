  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v20]
    v1 = phi [bb0: 0], [bb3: v19]
    v2 = phi [bb0: arg0], [bb3: v2]
    v3 = extract_value slice<calldata>, v2, 1
    v4 = lt v0, v3
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v1
  bb4:
    v5 = extract_value slice<calldata>, v2, 1
    v6 = lt v0, v5
    v7 = eq v6, false
    icall panic_if<0x32>, v7
    v8 = extract_value slice<calldata>, v2, 0
    v9 = mul v0, 32
    v10 = eq 32, 0
    v11 = div v9, 32
    v12 = eq v11, v0
    v13 = or v10, v12
    v14 = zext i1 v13 to i256
    v15 = eq v14, 0
    icall panic_if<0x41>, v15
    v16 = ptrtoint ptr<calldata> v8 to i256
    v17 = add v16, v9
    v18 = calldataload v17
    v19 = checked_add u256, v1, v18
    jump bb6
  bb6:
    jump bb3
  bb3:
    v20 = checked_add u256, v0, 1
    jump bb1
}

fn @pick(arg0: slice<calldata>, arg1: i256) -> i256 [selector=0x9d6a1cd3, pure, abi_params=[array<_, u256>, u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
