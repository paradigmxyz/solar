//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module FreshLength

// A copy writes `out[i]` while `i < a.length`, rereading both lengths. The
// copy's length is the one stored at its allocation, `a.length`, and nothing
// else stores a length: the store's bound check folds.
// CHECK-LABEL: {{^[ +].*}}fn @copy{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb3, bb4
// CHECK: + jump bb4
fn @copy(arg0: memoryarray) -> memoryarray {
  bb0:
    v0 = memory_object_len memoryarray, arg0
    v1 = shl 5, v0
    v2 = alloc memoryarray, exact, zeroed, panic, v1
    set_memory_object_len memoryarray, v2, v0
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb4: v9]
    v4 = memory_object_len memoryarray, arg0
    v5 = lt v3, v4
    jumpi v5, bb2, bb5
  bb2:
    v6 = memory_object_len memoryarray, v2
    v7 = lt v3, v6
    v8 = eq v7, false
    jumpi v8, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    memory_object_store_element memoryarray, v2, v3, 1
    v9 = add v3, 1
    jump bb1
  bb5:
    ret v2
}

// Shortening the copy inside the loop changes the length the check reads.
// CHECK-LABEL: {{^[ +].*}}fn @keep_shortened{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb3, bb4
fn @keep_shortened(arg0: memoryarray) -> memoryarray {
  bb0:
    v0 = memory_object_len memoryarray, arg0
    v1 = shl 5, v0
    v2 = alloc memoryarray, exact, zeroed, panic, v1
    set_memory_object_len memoryarray, v2, v0
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb4: v9]
    v4 = memory_object_len memoryarray, arg0
    v5 = lt v3, v4
    jumpi v5, bb2, bb5
  bb2:
    v6 = memory_object_len memoryarray, v2
    v7 = lt v3, v6
    v8 = eq v7, false
    jumpi v8, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    memory_object_store_element memoryarray, v2, v3, 1
    set_memory_object_len memoryarray, v2, v3
    v9 = add v3, 1
    jump bb1
  bb5:
    ret v2
}

// A reread of a fresh object's length takes the bounds of the length stored at
// its allocation: where `n > 31`, `n + 32` is at least 64, so the bound check
// of a word written at offset 31 folds.
// CHECK-LABEL: {{^[ +].*}}fn @anchored_range{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb2, bb3
// CHECK: + jump bb3
fn @anchored_range(arg0: i256) -> memorybytes {
  bb0:
    v0 = and arg0, 255
    v1 = add v0, 32
    v2 = alloc memorybytes, exact, zeroed, panic, v1
    set_memory_object_len memorybytes, v2, v1
    v3 = gt v0, 31
    jumpi v3, bb1, bb3
  bb1:
    v4 = memory_object_len memorybytes, v2
    v5 = lt v4, 63
    jumpi v5, bb2, bb3
  bb2:
    revert 0, 0
  bb3:
    ret v2
}

// Without `n > 31` the stored length can be as short as 32.
// CHECK-LABEL: {{^[ +].*}}fn @keep_short_anchor{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb1, bb2
fn @keep_short_anchor(arg0: i256) -> memorybytes {
  bb0:
    v0 = and arg0, 255
    v1 = add v0, 32
    v2 = alloc memorybytes, exact, zeroed, panic, v1
    set_memory_object_len memorybytes, v2, v1
    v3 = memory_object_len memorybytes, v2
    v4 = lt v3, 63
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v2
}
