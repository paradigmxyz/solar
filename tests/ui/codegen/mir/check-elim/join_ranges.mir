//@compile-flags: -Zmir-pipeline=check-elim
@module JoinRanges

fn @bounded_phi(arg0: i1, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = lt arg1, 100
    jumpi v0, bb3, bb6
  bb2:
    v1 = lt arg2, 80
    jumpi v1, bb4, bb6
  bb3:
    jump bb5
  bb4:
    jump bb5
  bb5:
    v2 = phi [bb3: arg1], [bb4: arg2]
    v3 = lt v2, 100
    jumpi v3, bb7, bb6
  bb6:
    revert 0, 0
  bb7:
    ret v2
}

fn @bounded_induction(arg0: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, 100
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    v3 = gt v0, 100
    jumpi v3, bb4, bb5
  bb4:
    revert 0, 0
  bb5:
    ret v0
}

fn @unbounded_loop(arg0: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v1]
    v1 = add v0, 1
    jumpi arg0, bb2, bb3
  bb2:
    jump bb1
  bb3:
    v2 = gt v0, 100
    jumpi v2, bb4, bb5
  bb4:
    revert 0, 0
  bb5:
    ret v0
}

fn @transitive_order(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = lt arg0, arg1
    jumpi v0, bb1, bb4
  bb1:
    v1 = gt arg1, arg2
    jumpi v1, bb4, bb2
  bb2:
    v2 = lt arg0, arg2
    jumpi v2, bb3, bb4
  bb3:
    ret 1
  bb4:
    ret 0
}

fn @signed_join(arg0: i1, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = slt arg1, 0
    jumpi v0, bb3, bb6
  bb2:
    v1 = sgt 0, arg2
    jumpi v1, bb4, bb6
  bb3:
    jump bb5
  bb4:
    jump bb5
  bb5:
    v2 = phi [bb3: arg1], [bb4: arg2]
    v3 = slt v2, 1
    jumpi v3, bb7, bb6
  bb6:
    revert 0, 0
  bb7:
    ret v2
}

fn @signed_positive(arg0: i256) -> i256 {
  bb0:
    v0 = slt arg0, 0
    jumpi v0, bb4, bb1
  bb1:
    v1 = sgt arg0, 99
    jumpi v1, bb4, bb2
  bb2:
    v2 = lt arg0, 100
    jumpi v2, bb3, bb4
  bb3:
    ret arg0
  bb4:
    revert 0, 0
}

fn @keep_cross_sign(arg0: i256) -> i256 {
  bb0:
    v0 = slt arg0, 100
    jumpi v0, bb1, bb3
  bb1:
    v1 = lt arg0, 100
    jumpi v1, bb2, bb3
  bb2:
    ret arg0
  bb3:
    revert 0, 0
}

fn @signed_negative(arg0: i256) -> i256 {
  bb0:
    v0 = slt arg0, 0
    jumpi v0, bb1, bb4
  bb1:
    v1 = slt arg0, 115792089237316195423570985008687907853269984665640564039457584007913129639836
    jumpi v1, bb4, bb2
  bb2:
    v2 = lt arg0, 115792089237316195423570985008687907853269984665640564039457584007913129639836
    jumpi v2, bb4, bb3
  bb3:
    ret arg0
  bb4:
    revert 0, 0
}
