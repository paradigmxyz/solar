//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module CheckElimAddBounds

// `arg0 < 2^256 - 2` bounds `arg0` at `2^256 - 3`, so `arg0 + 2` tops out at
// exactly `2^256 - 1` and cannot wrap: the check folds.
// CHECK-LABEL: {{^[ +].*}}fn @fold_exact_boundary{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb3, bb4
// CHECK: + jump bb4
fn @fold_exact_boundary(arg0: u256) -> u256 {
  bb0:
    v1 = lt arg0, 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe
    jumpi v1, bb1, bb2
  bb1:
    v2 = add arg0, 2
    v3 = lt v2, arg0
    jumpi v3, bb3, bb4
  bb2:
    ret 0
  bb3:
    revert 0, 0
  bb4:
    ret v2
}

// `arg0 < 2^256 - 1` only bounds `arg0` at `2^256 - 2`, so `arg0 + 2` can
// still wrap: the check must stay.
// CHECK-LABEL: {{^[ +].*}}fn @keep_wrappable_boundary{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{v[0-9]+}}, bb3, bb4
fn @keep_wrappable_boundary(arg0: u256) -> u256 {
  bb0:
    v1 = lt arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    jumpi v1, bb1, bb2
  bb1:
    v2 = add arg0, 2
    v3 = lt v2, arg0
    jumpi v3, bb3, bb4
  bb2:
    ret 0
  bb3:
    revert 0, 0
  bb4:
    ret v2
}

// A known-safe term folds even when the combined check can still fail.
// CHECK-LABEL: {{^[ +].*}}fn @combined{{[( ]}}
// CHECK: - [[SAFE:v[0-9]+]] = lt {{v[0-9]+}}, arg0
// CHECK: + {{v[0-9]+}} = or false, {{v[0-9]+}}
fn @combined(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v1 = lt arg0, 100
    jumpi v1, bb1, bb2
  bb1:
    v2 = add arg0, 2
    v3 = lt v2, arg0
    v4 = add v2, arg1
    v5 = lt v4, v2
    v6 = or v3, v5
    jumpi v6, bb3, bb4
  bb2:
    ret 0
  bb3:
    revert 0, 0
  bb4:
    ret v4
}
