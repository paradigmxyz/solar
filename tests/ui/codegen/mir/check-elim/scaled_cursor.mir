//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module ScaledCursor

// An output cursor advances by three bytes while the sibling input cursor
// advances by one. The checked allocation reserves exactly three bytes per
// input byte, so the write-end, overflow, and scalar-index checks all fold.
// CHECK-LABEL: {{^[ +].*}}fn @bounded_writer{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb7, bb3
// CHECK: + jump bb3
// CHECK: - jumpi {{v[0-9]+}}, bb7, bb4
// CHECK: + jump bb4
// CHECK: - jumpi {{v[0-9]+}}, bb5, bb7
// CHECK: + jump bb5
fn @bounded_writer(arg0: memorybytes) -> memorybytes {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = checked_mul u256, v0, 3
    v2 = alloc memorybytes, exact, zeroed, panic, v1
    set_memory_object_len memorybytes, v2, v1
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb6: v14]
    v4 = phi [bb0: 0], [bb6: v13]
    v5 = memory_object_len memorybytes, arg0
    v6 = lt v3, v5
    jumpi v6, bb2, bb8
  bb2:
    v7 = add v4, 3
    v8 = lt v7, v4
    jumpi v8, bb7, bb3
  bb3:
    v9 = memory_object_len memorybytes, v2
    v10 = gt v7, v9
    jumpi v10, bb7, bb4
  bb4:
    v11 = lt v4, v9
    jumpi v11, bb5, bb7
  bb5:
    memory_object_store_byte memorybytes, v2, v4, 1
    jump bb6
  bb6:
    v13 = add v4, 3
    v14 = add v3, 1
    jump bb1
  bb7:
    revert 0, 0
  bb8:
    ret v2
}

// Reserving two bytes per input cannot justify a three-byte cursor step.
// CHECK-LABEL: {{^[ +].*}}fn @keep_too_wide_write{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb5, bb3
fn @keep_too_wide_write(arg0: memorybytes) -> memorybytes {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = checked_mul u256, v0, 2
    v2 = alloc memorybytes, exact, zeroed, panic, v1
    set_memory_object_len memorybytes, v2, v1
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb4: v11]
    v4 = phi [bb0: 0], [bb4: v10]
    v5 = memory_object_len memorybytes, arg0
    v6 = lt v3, v5
    jumpi v6, bb2, bb6
  bb2:
    v7 = add v4, 3
    v8 = memory_object_len memorybytes, v2
    v9 = gt v7, v8
    jumpi v9, bb5, bb3
  bb3:
    memory_object_store_byte memorybytes, v2, v4, 1
    jump bb4
  bb4:
    v10 = add v4, 3
    v11 = add v3, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v2
}

// A loop-local logical-length mutation invalidates the reserved-capacity
// invariant, even when the mutation happens to store the original value.
// CHECK-LABEL: {{^[ +].*}}fn @keep_mutated_length{{[( ]}}
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb5, bb3
fn @keep_mutated_length(arg0: memorybytes) -> memorybytes {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = checked_mul u256, v0, 3
    v2 = alloc memorybytes, exact, zeroed, panic, v1
    set_memory_object_len memorybytes, v2, v1
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb4: v11]
    v4 = phi [bb0: 0], [bb4: v10]
    v5 = memory_object_len memorybytes, arg0
    v6 = lt v3, v5
    jumpi v6, bb2, bb6
  bb2:
    set_memory_object_len memorybytes, v2, v1
    v7 = add v4, 3
    v8 = memory_object_len memorybytes, v2
    v9 = gt v7, v8
    jumpi v9, bb5, bb3
  bb3:
    memory_object_store_byte memorybytes, v2, v4, 1
    jump bb4
  bb4:
    v10 = add v4, 3
    v11 = add v3, 1
    jump bb1
  bb5:
    revert 0, 0
  bb6:
    ret v2
}
