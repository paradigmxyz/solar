- // === ROOT/tests/ui/codegen/mir/check-elim/width_tests.mir (before check-elim) ===
+ // === ROOT/tests/ui/codegen/mir/check-elim/width_tests.mir (after check-elim) ===
  @module WidthTests
  fn @shift_then_comparison(arg0: i256) -> i256 {
    bb0:
      v0 = shr arg0, 8
      v1 = ne v0, 0
      jumpi v1, bb3, bb1
    bb1:
      v2 = lt arg0, 0x10000
-     jumpi v2, bb2, bb3
+     jump bb2
    bb2:
      ret arg0
    bb3:
      revert 0, 0
  }
  
  fn @comparison_then_shift(arg0: i256) -> i256 {
    bb0:
      v0 = gt arg0, 255
      jumpi v0, bb3, bb1
    bb1:
      v1 = shr arg0, 16
      v2 = ne v1, 0
-     jumpi v2, bb3, bb2
+     jump bb2
    bb2:
      ret arg0
    bb3:
      revert 0, 0
  }
  
  fn @fit_shift_then_exceeding_comparison(arg0: i256) -> i256 {
    bb0:
      v0 = shr arg0, 8
      v1 = eq v0, 0
      jumpi v1, bb1, bb3
    bb1:
      v2 = gt arg0, 0xffff
-     jumpi v2, bb2, bb3
+     jump bb3
    bb3:
      revert 0, 0
    bb2:
      ret arg0
  }
  
  fn @narrower_test_stays(arg0: i256) -> i256 {
    bb0:
      v0 = shr arg0, 16
      v1 = ne v0, 0
      jumpi v1, bb3, bb1
    bb1:
      v2 = shr arg0, 8
      v3 = ne v2, 0
      jumpi v3, bb3, bb2
    bb2:
      ret arg0
    bb3:
      revert 0, 0
  }
  
