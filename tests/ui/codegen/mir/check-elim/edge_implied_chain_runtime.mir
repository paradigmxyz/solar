//@ compile-flags: -Zmir-pipeline=check-elim --optimize-runs 10000
//@ filecheck:
//@ run-call: order(uint256)(uint256) 0 => 1
//@ run-call: order(uint256)(uint256) 4 => 1
//@ run-call: order(uint256)(uint256) 5 => 7
//@ run-call: order(uint256)(uint256) 99 => 7
//@ run-call: order(uint256)(uint256) 100 => 0
//@ run-call: order(uint256)(uint256) 200 => 0
// Two threads share an edge: `bb1` skips `bb3` into `bb4`, and `bb3`'s true edge skips
// `bb4` into `bb6`. Both read their phi inputs before either edge moves; `bb3` then has no
// predecessors and goes. The code still returns 1 below 5, 7 below 100, and 0 above.
@module EdgeImpliedChain
@phase lowered

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb2, [0x21603f43 => bb1]
  bb1:
    tail_call @order
  bb2:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @order{{[( ]}}
// CHECK: + {{v[0-9]+}} = phi [bb4: 7], [bb1: 1]
// CHECK: bb3 [cold]:
// CHECK-NEXT: invalid
fn @order() {
  bb0:
    v9 = calldataload 4
    v0 = lt v9, 5
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 1], [bb2: 2]
    v2 = lt v9, 5
    jumpi v2, bb4, bb5
  bb5:
    jump bb4
  bb4:
    v3 = phi [bb3: v1], [bb5: 7]
    v4 = lt v9, 100
    jumpi v4, bb6, bb7
  bb6:
    v5 = phi [bb4: v3]
    mstore 0, v5
    returndata 0, 32
  bb7:
    mstore 0, 0
    returndata 0, 32
}
