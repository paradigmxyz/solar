//@ compile-flags: -Zmir-pipeline=check-elim
@module ConsumedPredicates

// Discarding the single-use predicate chain must retain the bound on arg0.
fn @operands(arg0: u256) -> u256 {
  bb0:
    v0 = lt arg0, 8
    v1 = iszero v0
    jumpi v1, bb3, bb1
  bb1:
    v2 = mul arg0, 4
    v3 = lt v2, 32
    jumpi v3, bb2, bb3
  bb2:
    ret v2
  bb3:
    ret 0
}

// An opaque word reused by a later branch still needs its scoped range.
fn @reused(arg0: u256) -> u256 {
  bb0:
    v0 = calldataload arg0
    jumpi v0, bb1, bb3
  bb1:
    jumpi v0, bb2, bb3
  bb2:
    ret 1
  bb3:
    ret 0
}

// Phi users count too: each edge supplies a value proven to be one.
fn @phi_user(arg0: u256) -> u256 {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: v0], [bb2: 1]
    jumpi v1, bb4, bb5
  bb4:
    ret 1
  bb5:
    ret 0
}
