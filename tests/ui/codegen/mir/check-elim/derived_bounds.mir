//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module DerivedBounds

// `i < length >> 1` puts `i` below `length` too, and `length` above `i`,
// so it is nonzero: the mirrored-index reversal loop keeps none of its four
// checks. The remaining branches are the loop test and the loop exit.
// CHECK-LABEL: {{^[ +].*}}fn @reverse_pairs{{[( ]}}
// CHECK: - jumpi arg1, bb4, bb5
// CHECK: + jump bb4
// CHECK: - jumpi {{v[0-9]+}}, bb5, bb6
// CHECK: + jump bb6
// CHECK: - jumpi {{v[0-9]+}}, bb7, bb8
// CHECK: + jump bb7
// CHECK: - jumpi {{v[0-9]+}}, bb9, bb8
// CHECK: + jump bb9
fn @reverse_pairs(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb9: v12]
    v1 = shr 1, arg1
    v2 = lt v0, v1
    jumpi v2, bb3, bb2
  bb2:
    ret v0
  bb3:
    v3 = sub arg1, 1
    jumpi arg1, bb4, bb5
  bb4:
    v4 = sub v3, v0
    v5 = lt v3, v0
    jumpi v5, bb5, bb6
  bb5:
    revert 0, 0
  bb6:
    v6 = lt v4, arg1
    jumpi v6, bb7, bb8
  bb7:
    v7 = shl 5, v4
    v8 = add arg0, v7
    v9 = mload v8
    v10 = lt v0, arg1
    jumpi v10, bb9, bb8
  bb8:
    revert 0, 36
  bb9:
    v11 = shl 5, v0
    v13 = add arg0, v11
    mstore v13, v9
    v12 = add v0, 1
    jump bb1
}

// A division by a constant never grows either, while a masked value bounds
// only what it was masked from: `i < n & 15` says nothing about `m`.
// CHECK-LABEL: {{^[ +].*}}fn @divided_and_masked{{[( ]}}
// CHECK: - jumpi {{v[0-9]+}}, bb2, bb5
// CHECK: + jump bb2
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb3, bb5
// CHECK: {{^ +}}jumpi {{v[0-9]+}}, bb4, bb5
fn @divided_and_masked(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = div arg1, 3
    v1 = lt arg0, v0
    jumpi v1, bb1, bb3
  bb1:
    v2 = lt arg0, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = and arg1, 15
    v4 = lt arg0, v3
    jumpi v4, bb5, bb3
  bb5:
    v5 = lt arg0, arg2
    jumpi v5, bb4, bb3
  bb4:
    ret arg0
  bb3:
    revert 0, 0
}
