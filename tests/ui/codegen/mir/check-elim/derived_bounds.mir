//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module DerivedBounds

// `i < length >> 1` puts `i` below `length` too, and `length` above `i`,
// so it is nonzero: the mirrored-index reversal loop keeps none of its four
// checks. The remaining branches are the loop test and the loop exit.
// CHECK-LABEL: {{^[ +].*}}fn @reverse_pairs{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb4, bb5
// CHECK: + jump bb4
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb5, bb6
// CHECK: + jump bb6
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb7, bb8
// CHECK: + jump bb7
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb9, bb8
// CHECK: + jump bb9
fn @reverse_pairs(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb9: v12]
    v1 = shr 1, arg1
    v2 = lt v0, v1
    jumpi v2, bb3, bb2
  bb2:
    ret v0
  bb3:
    v3 = sub arg1, 1
    v14 = ne arg1, 0
    jumpi v14, bb4, bb5
  bb4:
    v4 = sub v3, v0
    v5 = lt v3, v0
    jumpi v5, bb5, bb6
  bb5:
    revert 0, 0
  bb6:
    v6 = lt v4, arg1
    jumpi v6, bb7, bb8
  bb7:
    v7 = shl 5, v4
    v8 = add arg0, v7
    v9 = mload v8
    v10 = lt v0, arg1
    jumpi v10, bb9, bb8
  bb8:
    revert 0, 36
  bb9:
    v11 = shl 5, v0
    v13 = add arg0, v11
    mstore v13, v9
    v12 = add v0, 1
    jump bb1
}

// A division by a constant never grows either, while a masked value bounds
// only what it was masked from: `i < n & 15` says nothing about `m`.
// CHECK-LABEL: {{^[ +].*}}fn @divided_and_masked{{[( ]}}
// CHECK: - jumpi {{(arg[0-9]+|v[0-9]+)}}, bb2, bb5
// CHECK: + jump bb2
// CHECK: {{^ +}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb3, bb5
// CHECK: {{^ +}}jumpi {{(arg[0-9]+|v[0-9]+)}}, bb4, bb5
fn @divided_and_masked(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = div arg1, 3
    v1 = lt arg0, v0
    jumpi v1, bb1, bb3
  bb1:
    v2 = lt arg0, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = and arg1, 15
    v4 = lt arg0, v3
    jumpi v4, bb5, bb3
  bb5:
    v5 = lt arg0, arg2
    jumpi v5, bb4, bb3
  bb4:
    ret arg0
  bb3:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @cast_bound{{[( ]}}
// CHECK: - jumpi v4, bb2, bb3
// CHECK: + jump bb2
fn @cast_bound(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 128
    jumpi v0, bb1, bb4
  bb1:
    v1 = trunc i256 arg0 to i160
    v2 = zext i160 v1 to i256
    v3 = sext i160 v1 to i256
    v4 = lt v2, 128
    jumpi v4, bb2, bb3
  bb2:
    v5 = lt v3, 128
    jumpi v5, bb5, bb3
  bb3:
    ret 2
  bb4:
    ret 3
  bb5:
    ret 1
}

// Truncation that can wrap must not retain the source lower bound.
fn @keep_lossy_cast(arg0: i256) -> i256 {
  bb0:
    v0 = gt arg0, 255
    jumpi v0, bb1, bb4
  bb1:
    v1 = trunc i256 arg0 to i8
    v2 = zext i8 v1 to i256
    v3 = gt v2, 0
    jumpi v3, bb2, bb3
  bb2:
    ret 1
  bb3:
    ret 0
  bb4:
    ret 2
}

// Sign extension must not reuse a positive unsigned bound for a negative value.
fn @keep_negative_sext(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 256
    jumpi v0, bb1, bb4
  bb1:
    v1 = trunc i256 arg0 to i8
    v2 = sext i8 v1 to i256
    v3 = lt v2, 256
    jumpi v3, bb2, bb3
  bb2:
    ret 1
  bb3:
    ret 0
  bb4:
    ret 2
}

// An i8 doubling can wrap even though its operands fit in an EVM word.
// CHECK-LABEL: fn @narrow_double_roundtrip
// CHECK: jumpi
fn @narrow_double_roundtrip(arg0: i8) -> i256 {
  bb0:
    v0 = add arg0, arg0
    v1 = shr i8 1, v0
    v2 = eq v1, arg0
    jumpi v2, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret 0
}

// CHECK-LABEL: fn @narrow_double_comparison
// CHECK: jumpi
// CHECK: jumpi
fn @narrow_double_comparison(arg0: i8, arg1: i8) -> i256 {
  bb0:
    v0 = lt arg0, arg1
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, arg0
    v2 = add arg1, arg1
    v3 = lt v1, v2
    jumpi v3, bb3, bb2
  bb2:
    ret 0
  bb3:
    ret 1
}
