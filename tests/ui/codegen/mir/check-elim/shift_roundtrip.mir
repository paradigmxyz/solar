//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module CheckElimShiftRoundTrip

// Scaling a bounded length to words, `(n + 1) << 5`, loses no bits, so the
// allocation size's round-trip check folds.
// CHECK-LABEL: @scaled_allocation
// CHECK: {{^ +}}{{v[0-9]+}} = ne
// CHECK-NEXT: -     jumpi
// CHECK: +     jump
fn @scaled_allocation(arg0: memoryarray) -> i256 {
  bb0:
    v0 = memory_object_len memoryarray, arg0
    v1 = add v0, 1
    v2 = shl 5, v1
    v3 = shr 5, v2
    v4 = ne v3, v1
    jumpi v4, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v2
}

// An arbitrary word can lose its top bits.
// CHECK-LABEL: @keep_word
// CHECK: {{^ +}}{{v[0-9]+}} = ne
// CHECK-NEXT: {{^ +}}jumpi
fn @keep_word(arg0: i256) -> i256 {
  bb0:
    v0 = shl 5, arg0
    v1 = shr 5, v0
    v2 = ne v1, arg0
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v0
}

// Shifting back by a different amount is not a round trip.
// CHECK-LABEL: @keep_mismatched_shift
// CHECK: {{^ +}}{{v[0-9]+}} = ne
// CHECK-NEXT: {{^ +}}jumpi
fn @keep_mismatched_shift(arg0: memoryarray) -> i256 {
  bb0:
    v0 = memory_object_len memoryarray, arg0
    v1 = shl 5, v0
    v2 = shr 4, v1
    v3 = ne v2, v0
    jumpi v3, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v1
}
