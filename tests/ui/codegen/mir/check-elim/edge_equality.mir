//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module EdgeEquality

// The true edge of `eq x, C` proves `x == C` in the block it enters.
// CHECK-LABEL: {{^[ +].*}}fn @eq_true_edge{{[( ]}}
// CHECK: - v1 = add arg0, 1
// CHECK-NEXT: + v1 = add 32, 1
fn @eq_true_edge(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 32
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, 1
    ret v1
  bb2:
    ret 0
}

// The false edge of `ne x, C` proves it too, with the constant on either side.
// CHECK-LABEL: {{^[ +].*}}fn @ne_false_edge{{[( ]}}
// CHECK: - v1 = sub 64, arg0
// CHECK-NEXT: + v1 = sub 64, 64
fn @ne_false_edge(arg0: i256) -> i256 {
  bb0:
    v0 = ne 64, arg0
    jumpi v0, bb2, bb1
  bb1:
    v1 = sub 64, arg0
    ret v1
  bb2:
    ret 0
}

// The other edge proves only inequality, so its uses stay. Uses in blocks the
// edge dominates, however far, are replaced; the join reads either path and stays.
// CHECK-LABEL: {{^[ +].*}}fn @dominated_only{{[( ]}}
// CHECK: - v3 = mul arg0, 3
// CHECK-NEXT: + v3 = mul 7, 3
// CHECK: - v2 = add arg0, 2
// CHECK-NEXT: + v2 = add 7, 2
// CHECK-NOT: {{^[-+]}}
fn @dominated_only(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = eq arg0, 7
    jumpi v0, bb1, bb2
  bb1:
    jumpi arg1, bb3, bb4
  bb2:
    v1 = add arg0, 1
    jump bb5
  bb3:
    v2 = add arg0, 2
    jump bb5
  bb4:
    v3 = mul arg0, 3
    jump bb5
  bb5:
    v4 = phi [bb2: v1], [bb3: v2], [bb4: v3]
    v5 = add v4, arg0
    ret v5
}

// A block with two predecessors learns nothing from either branch.
// CHECK-LABEL: {{^[ +].*}}fn @shared_target{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @shared_target(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = eq arg0, 7
    jumpi v0, bb1, bb2
  bb1:
    jumpi arg1, bb3, bb2
  bb2:
    v1 = add arg0, 1
    ret v1
  bb3:
    ret 0
}

// A phi operand is read on its incoming edge, not in the block, so it keeps the
// value even where the block is dominated; the block's own uses change.
// CHECK-LABEL: {{^[ +].*}}fn @phi_operand{{[( ]}}
// CHECK: - v1 = add arg0, 1
// CHECK-NEXT: + v1 = add 9, 1
// CHECK-NOT: {{^[-+]}}
fn @phi_operand(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = eq arg0, 9
    jumpi v0, bb1, bb4
  bb1:
    jumpi arg1, bb2, bb3
  bb2:
    jump bb4
  bb3:
    v2 = add arg0, 1
    jump bb4
  bb4:
    v3 = phi [bb0: arg0], [bb2: arg0], [bb3: v2]
    ret v3
}

// A constant that folds nothing replaces a value only when the value is read at least
// twice below the edge; a single read stays, as the constant would only change which
// code looks alike to later sharing.
// CHECK-LABEL: {{^[ +].*}}fn @single_read{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @single_read(arg0: i256) {
  bb0:
    v0 = eq arg0, 5
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, arg0
    returndata 0, 32
  bb2:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @repeated_reads{{[( ]}}
// CHECK: - mstore 0, arg0
// CHECK-NEXT: - mstore 32, arg0
// CHECK-NEXT: + mstore 0, 5
// CHECK-NEXT: + mstore 32, 5
fn @repeated_reads(arg0: i256) {
  bb0:
    v0 = eq arg0, 5
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, arg0
    mstore 32, arg0
    returndata 0, 64
  bb2:
    revert 0, 0
}

// An inner edge that contradicts an outer one is dead, and its constant must not
// leak to the live blocks that follow it.
// CHECK-LABEL: {{^[ +].*}}fn @contradiction{{[( ]}}
// CHECK: - v2 = add arg0, 1
// CHECK-NEXT: - v3 = add arg0, 2
// CHECK-NEXT: + v2 = add 5, 1
// CHECK-NEXT: + v3 = add 5, 2
fn @contradiction(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 5
    jumpi v0, bb1, bb4
  bb1:
    v1 = eq arg0, 6
    jumpi v1, bb3, bb2
  bb2:
    v2 = add arg0, 1
    v3 = add arg0, 2
    v4 = add v2, v3
    ret v4
  bb3:
    v5 = add arg0, arg0
    ret v5
  bb4:
    ret 0
}

// A constant that costs more than a `DUP` to read stays out of the code, however
// often the value is read.
// CHECK-LABEL: {{^[ +].*}}fn @wide_constant{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @wide_constant(arg0: i256) {
  bb0:
    v0 = eq arg0, 0x1234567890123456789012345678901234567890
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, arg0
    mstore 32, arg0
    mstore 64, arg0
    returndata 0, 96
  bb2:
    revert 0, 0
}

// A checked operation that the edge proves cannot fail becomes a plain one that
// still reads the constant.
// CHECK-LABEL: {{^[ +].*}}fn @unfailing{{[( ]}}
// CHECK: - v1 = checked_add uint256, arg0, 1
// CHECK-NEXT: + v1 = add 5, 1
fn @unfailing(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 5
    jumpi v0, bb1, bb2
  bb1:
    v1 = checked_add uint256, arg0, 1
    ret v1
  bb2:
    ret 0
}

// Raw memory addresses and sizes stay symbolic, however often they are read: frame and
// heap layout treat constant ones as fixed images. A stored value takes the constant.
// CHECK-LABEL: {{^[ +].*}}fn @raw_memory{{[( ]}}
// CHECK: - mstore 0, arg0
// CHECK-NEXT: - mstore 32, arg0
// CHECK-NEXT: + mstore 0, 64
// CHECK-NEXT: + mstore 32, 64
// CHECK-NOT: {{^[-+]}}
fn @raw_memory(arg0: i256, arg1: i256) {
  bb0:
    v0 = eq arg0, 64
    jumpi v0, bb1, bb2
  bb1:
    mstore arg0, arg1
    mstore arg0, arg1
    calldatacopy arg1, arg1, arg0
    calldatacopy arg1, arg1, arg0
    mstore 0, arg0
    mstore 32, arg0
    returndata 0, 64
  bb2:
    revert 0, 0
}
