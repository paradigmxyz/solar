fn @sibling(arg0: i1, arg1: i256, arg2: i256, arg3: i256) -> i256 [selector=0x9446c675, pure, abi_params=[bool, u256, u256, u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    jumpi arg0, bb1, bb2
  bb2:
    v6 = lt arg1, arg3
    v7 = eq v6, false
    jumpi v7, bb5, bb4
  bb4:
    v8 = lt arg2, arg3
    v9 = eq v8, false
    jump bb6
  bb5:
    jump bb6
  bb6:
    v10 = phi [bb4: v9], [bb5: true]
    jumpi v10, bb7, bb8
  bb8:
    jump bb9
  bb9:
    jump bb3
  bb7:
    ret 0
  bb1:
    v0 = lt arg1, arg2
    v1 = eq v0, false
    icall revert_if<empty>, v1
    v2 = lt arg2, arg3
    v3 = eq v2, false
    icall revert_if<empty>, v3
    v4 = lt arg1, arg3
    v5 = eq v4, false
    icall revert_if<empty>, v5
    jump bb3
  bb3:
    v11 = lt arg1, arg2
    jumpi v11, bb10, bb11
  bb11:
    jump bb12
  bb10:
    jump bb12
  bb12:
    v12 = phi [bb10: i8 1], [bb11: i8 0]
    v13 = zext i8 v12 to i256
    ret v13
}
