//@compile-flags: -Zmir-pipeline=check-elim
//@filecheck:
@module ShiftedBound

// A word written at `j` into a buffer allocated with 29 bytes of slack:
// after the guard `j + 3 <= n` and the allocation's own passing check on
// `n + 29`, the write's bound `j + 32 <= n + 29` follows and its branch
// folds. `j + 33 <= n + 29` does not follow and keeps its branch, and
// neither does `j + 32 <= n + 29` without the allocation's check, since
// `n + 29` could wrap.
// CHECK-LABEL: {{^[ +].*}}fn @slack{{[( ]}}
// CHECK: - jumpi v6, bb6, bb4
// CHECK: + jump bb4
// CHECK: {{^ +}}jumpi v8, bb6, bb5
fn @slack(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = add arg1, 29
    v1 = lt v0, arg1
    jumpi v1, bb6, bb1
  bb1:
    v2 = add arg0, 3
    v3 = lt v2, arg0
    jumpi v3, bb6, bb2
  bb2:
    v4 = gt v2, arg1
    jumpi v4, bb7, bb3
  bb3:
    v7 = add arg0, 32
    v8 = gt v7, v0
    jumpi v8, bb6, bb4
  bb4:
    v9 = add arg0, 33
    v10 = gt v9, v0
    jumpi v10, bb6, bb5
  bb5:
    ret v7
  bb6:
    revert 0, 0
  bb7:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @unchecked_sum{{[( ]}}
// CHECK: {{^ +}}jumpi v5, bb4, bb3
fn @unchecked_sum(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = add arg1, 29
    v1 = add arg0, 3
    v2 = lt v1, arg0
    jumpi v2, bb4, bb1
  bb1:
    v3 = gt v1, arg1
    jumpi v3, bb5, bb2
  bb2:
    v5 = add arg0, 32
    v6 = gt v5, v0
    jumpi v6, bb4, bb3
  bb3:
    ret v5
  bb4:
    revert 0, 0
  bb5:
    ret 0
}
