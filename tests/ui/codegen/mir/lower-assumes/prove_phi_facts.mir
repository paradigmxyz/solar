//@ compile-flags: -Zmir-pipeline=lower-assumes -Zprove-analyses=- --emit=bin-runtime
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
// Inside a join's predecessor context, the facts about a phi's incoming value
// from below the phi's dominators hold only in the disjunct that selects it:
// here `v4 == v0` must not bound `v0` on the executions through bb4.
@module ProvePhiFacts
@phase lowered
// CHECK-LABEL: ; query: ProvePhiFacts-f0-bb6-v0-sccp-1.smt2
// CHECK: (or false (and true (= [[PHI:j6_1_v[0-9]+]] [[IN:j6_1_in[0-9_]+]]) (= [[IN]] v0)) (= [[PHI]] v0))
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = lt v0, 0x10000000000000000
    jumpi v1, bb1, bb2
  bb1:
    jump bb5
  bb2:
    v2 = calldatasize
    v3 = eq v0, v2
    jumpi v3, bb3, bb4
  bb3:
    v4 = calldatasize
    assume eq cse, v4, v0
    jump bb6
  bb4:
    jump bb6
  bb6:
    v5 = phi [bb3: v4], [bb4: v0]
    jump bb5
  bb5:
    assume ult sccp, v0, 0x10000000000000000
    mstore 0, v0
    returndata 0, 32
}
