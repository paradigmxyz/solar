// === ROOT/tests/ui/codegen/mir/lower-mapping-slots/runtime.sol:SlotHashRuntime ===
@module SlotHashRuntime
fn @words(arg0: i256) -> i256 [selector=0x884fc838, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = mapping_slot 17, 0
    sstore v0, 7 !metadata(storage=symbolic(v0))
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v8]
    v2 = phi [bb0: 0], [bb3: v7]
    v3 = phi [bb0: arg0], [bb3: v3]
    v4 = lt v1, v3
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v2
  bb4:
    v5 = mapping_slot 17, 0
    v6 = sload v5 !metadata(storage=symbolic(v5))
    v7 = checked_add u256, v2, v6
    jump bb6
  bb6:
    jump bb3
  bb3:
    v8 = checked_add u256, v1, 1
    jump bb1
}

fn @bits(arg0: i8, arg1: i8) -> i256 [selector=0x3fbe8cdc, pure, abi_params=[u8, u8], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = xor arg0, arg1
    v1 = zext i8 v0 to i256
    ret v1
}
