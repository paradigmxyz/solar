//@ revisions: petersburg istanbul
//@[petersburg] compile-flags: --evm-version petersburg -Zmir-pipeline=inst-simplify
//@[petersburg] filecheck: --check-prefix=PETERSBURG
//@[istanbul] compile-flags: --evm-version istanbul -Zmir-pipeline=inst-simplify
//@[istanbul] filecheck: --check-prefix=ISTANBUL
@module InstSimplifySelfBalance

// PETERSBURG-LABEL: {{^[ +].*}}fn @own_balance{{[( ]}}
// PETERSBURG: v0 = address
// PETERSBURG: v1 = balance v0
// PETERSBURG: ret v1
// ISTANBUL-LABEL: {{^[ +].*}}fn @own_balance{{[( ]}}
// ISTANBUL: - v1 = balance v0
// ISTANBUL: + v1 = selfbalance
// ISTANBUL: ret v1
fn @own_balance() -> u256 {
  bb0:
    v0 = address
    v1 = balance v0
    ret v1
}
