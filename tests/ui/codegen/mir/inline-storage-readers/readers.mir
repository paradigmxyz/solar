//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=inline-storage-readers
//@[size] compile-flags: -Osize -Zmir-pipeline=inline-storage-readers
@module StorageReaders
@types
  struct0: {i256, i256}

fn @after(arg0: i256) -> i256 [selector=1] {
  bb0:
    v0 = icall @reader, arg0
    v1 = sload 3
    v2 = add v0, v1
    ret v2
}

fn @before(arg0: i256) -> i256 [selector=2] {
  bb0:
    v0 = sload 3
    v1 = icall @reader, arg0
    v2 = add v0, v1
    ret v2
}

fn @reader(arg0: i256) -> i256 {
  bb0:
    v0 = sload 3
    v1 = add v0, arg0
    v2 = icall @scale, v1
    ret v2
}

fn @scale(arg0: i256) -> i256 {
  bb0:
    v0 = mul arg0, 7
    ret v0
}

fn @different_slot(arg0: i256) -> i256 [selector=3] {
  bb0:
    v0 = icall @reader, arg0
    v1 = sload 4
    v2 = add v0, v1
    ret v2
}

fn @writing_call(arg0: i256) -> i256 [selector=4] {
  bb0:
    v0 = sload 3
    v1 = icall @writer, arg0
    v2 = add v0, v1
    ret v2
}

fn @writer(arg0: i256) -> i256 {
  bb0:
    icall @store, arg0
    v0 = sload 3
    ret v0
}

fn @store(arg0: i256) {
  bb0:
    sstore 3, arg0
    ret
}

fn @gas_call() -> i256 [selector=5] {
  bb0:
    v0 = icall @observer
    v1 = sload 3
    v2 = add v0, v1
    ret v2
}

fn @observer() -> i256 {
  bb0:
    v0 = gas
    v1 = sload 3
    v2 = add v0, v1
    ret v2
}

fn @indirect_reader(arg0: i256) -> i256 [selector=6] {
  bb0:
    v0 = sload 3
    v1 = icall @wrapper, arg0
    v2 = add v0, v1
    ret v2
}

fn @wrapper(arg0: i256) -> i256 {
  bb0:
    v0 = icall @reader, arg0
    ret v0
}

fn @multiple_returns(arg0: i256) -> i256 [selector=7] {
  bb0:
    v0 = sload 3
    v1 = icall @pair, arg0
    v2 = add v0, v1
    ret v2
}

fn @pair(arg0: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    v0 = sload 3
    ret v0, arg0
}
