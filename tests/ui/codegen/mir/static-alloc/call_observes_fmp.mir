//@compile-flags: -Zmir-pipeline=storage-promotion,static-alloc
//@filecheck: --match-full-lines
@module StaticAllocCallObservesFmp

// A callee that reads the free-memory pointer and observes the pointer's
// numeric value can derive aliases from where the object lies relative to the
// heap, so the allocation it receives must stay dynamic.
// CHECK-LABEL: + // === {{.*}} (after storage-promotion) ===
// CHECK:   fn @observing_caller{{.*}}
// CHECK-NEXT:     bb0:
// CHECK-NEXT:       v0 = alloc raw, exact, uninitialized, infallible, 32
fn @observing_caller() -> i1 [selector=0x01020304] {
  bb0:
    v6 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v6 to i256
    mstore v0, 7
    v1 = icall fn4, v0
    v2 = ne v1, false
    ret v2
}

// The observation is interprocedural: a callee that only forwards the pointer
// to an observing callee blocks placement too.
// CHECK:   fn @forwarding_caller{{.*}}
// CHECK-NEXT:     bb0:
// CHECK-NEXT:       v0 = alloc raw, exact, uninitialized, infallible, 32
fn @forwarding_caller() -> i1 [selector=0x01020305] {
  bb0:
    v7 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v7 to i256
    mstore v0, 7
    v1 = icall fn5, v0
    v2 = ne v1, false
    ret v2
}

// Returning the free-memory pointer observes the removed bump even if the
// pointer argument is only dereferenced.
// CHECK:   fn @dereferencing_caller{{.*}}
// CHECK-NEXT:     bb0:
// CHECK-NEXT:       v0 = alloc raw, exact, uninitialized, infallible, 32
fn @dereferencing_caller() -> i256 [selector=0x01020306] {
  bb0:
    v8 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v8 to i256
    mstore v0, 7
    v1 = icall fn6, v0
    ret v1
}

// `msize` sees the elided bump whatever the callee does with the pointer.
// CHECK:   fn @msize_caller{{.*}}
// CHECK-NEXT:     bb0:
// CHECK-NEXT:       v0 = alloc raw, exact, uninitialized, infallible, 32
fn @msize_caller() -> i256 [selector=0x01020307] {
  bb0:
    v9 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v9 to i256
    mstore v0, 7
    v1 = icall fn7, v0
    ret v1
}

fn @observes(arg0: i256) -> i1 {
  bb0:
    v0 = mload 64
    v1 = lt arg0, v0
    ret v1
}

fn @forwards(arg0: i256) -> i1 {
  bb0:
    v0 = icall fn4, arg0
    v1 = ne v0, false
    ret v1
}

fn @dereferences(arg0: i256) -> i256 {
  bb0:
    v0 = mload 64
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

fn @measures(arg0: i256) -> i256 {
  bb0:
    v0 = msize
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// Storage promotion gives another entry a 32-byte frame, providing the shadow
// region used by the explicit static-allocation pass.
fn @reserve_frame() [selector=0x01020308] {
  bb0:
    sstore 0, 1
    jump bb1
  bb1:
    jumpi true, bb2, bb4
  bb2:
    v0 = sload 0
    v1 = add v0, 1
    sstore 0, v1
    jump bb3
  bb3:
    jump bb1
  bb4:
    stop
}

// A callee that reads the free-memory pointer for scratch still observes the
// removed bump through the memory it writes, so the placement is dropped.
// CHECK:   fn @iterating_caller{{.*}}
// CHECK-NEXT:     bb0:
// CHECK-NEXT:       v0 = alloc raw, exact, uninitialized, infallible, 32
fn @iterating_caller() -> i256 [selector=0x01020309] {
  bb0:
    v10 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v10 to i256
    mstore v0, 7
    v1 = icall fn10, v0
    ret v1
}

fn @iterates(arg0: i256) -> i256 {
  bb0:
    v0 = mload 64
    mstore v0, 1
    v1 = add arg0, 32
    v2 = lt arg0, v1
    v3 = mload arg0
    v5 = zext i1 v2 to i256
    v4 = add v5, v3
    ret v4
}
