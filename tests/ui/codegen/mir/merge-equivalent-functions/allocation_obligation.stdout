- // === ROOT/tests/ui/codegen/mir/merge-equivalent-functions/allocation_obligation.mir (before merge-equivalent-functions) ===
+ // === ROOT/tests/ui/codegen/mir/merge-equivalent-functions/allocation_obligation.mir (after merge-equivalent-functions) ===
  @module AllocationObligation
  fn @movable() -> word {
    bb0:
      v0 = alloc raw, exact, uninitialized, infallible, 64
      ret v0
  }
  
  fn @reserved() -> word {
    bb0:
      v0 = alloc raw, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
      ret v0
  }
  
  fn @entry() [selector=0x01020304] {
    bb0:
      v0 = icall @movable
      v1 = icall @reserved
      mstore v0, 42
      mstore v1, 7
      returndata v1, 32
  }
  
