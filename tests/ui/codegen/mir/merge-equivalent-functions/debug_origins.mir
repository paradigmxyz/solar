//@ compile-flags: -Zmir-pipeline=merge-equivalent-functions
//@ filecheck:
@module SharedOrigins

// CHECK-LABEL: {{^[ +].*}}fn @first{{[( ]}}
// CHECK: + v0 = add arg0, 1 !metadata(spans=[10..20, 50..60])
// CHECK: + ret v0 !metadata(spans=[30..40, 70..80])
fn @first(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1 !metadata(span=10..20)
    ret v0 !metadata(span=30..40)
}

fn @second(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1 !metadata(span=50..60)
    ret v0 !metadata(span=70..80)
}

// CHECK-LABEL: {{^[ +].*}}fn @entry{{[( ]}}
// CHECK: + v1 = icall @first, 1, arg0
fn @entry(arg0: u256) -> u256 [selector=0x01020304] {
  bb0:
    v0 = icall @first, 1, arg0
    v1 = icall @second, 1, arg0
    v2 = add v0, v1
    ret v2
}
