//@ compile-flags: -Zmir-pipeline=merge-equivalent-functions
//@ filecheck:
@module MergeColdHintBlocks

// Functions whose blocks differ in `cold_hint` are not equivalent: the survivor's hints would
// apply to both.
// CHECK-LABEL: fn @caller
// CHECK: icall @plain
// CHECK: icall @hinted
fn @caller(arg0: i1) -> i256 {
  bb0:
    v0 = icall @plain, arg0
    v1 = icall @hinted, arg0
    v2 = add v0, v1
    ret v2
}

fn @plain(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    ret 1
  bb2:
    ret 2
}

fn @hinted(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    ret 1
  bb2 [cold_hint]:
    ret 2
}
