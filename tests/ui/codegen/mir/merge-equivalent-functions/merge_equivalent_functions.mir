//@ compile-flags: -Zmir-pipeline=merge-equivalent-functions
//@ filecheck:
@module MergeEquivalentFunctions

// CHECK-LABEL: fn @leaf_a(arg0: u256) -> u256
fn @leaf_a(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}

// CHECK-LABEL: fn @leaf_b(arg0: u256) -> u256
fn @leaf_b(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}

// CHECK-LABEL: fn @wrap_a(arg0: u256) -> u256
fn @wrap_a(arg0: u256) -> u256 {
  bb0:
    v0 = icall fn0, arg0
    ret v0
}

// Merging the leaves exposes these wrappers as equivalent on the next wave.
// CHECK-LABEL: fn @wrap_b(arg0: u256) -> u256
// CHECK: {{^\+.*}}icall @leaf_a, arg0
fn @wrap_b(arg0: u256) -> u256 {
  bb0:
    v0 = icall fn1, arg0
    ret v0
}

// A different immediate must prevent folding.
// CHECK-LABEL: fn @different(arg0: u256) -> u256
fn @different(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 2
    ret v0
}

// CHECK-LABEL: fn @entry() -> u256
// CHECK: icall @wrap_a, 1
// CHECK: icall @wrap_a, 2
// CHECK: icall @different, 3
fn @entry() -> u256 [selector=0x01020304] {
  bb0:
    v0 = icall fn2, 1
    v1 = icall fn3, 2
    v2 = icall fn4, 3
    v3 = add v0, v1
    v4 = add v3, v2
    ret v4
}

// Direct self-recursion is alpha-equivalent across function IDs.
// CHECK-LABEL: fn @recursive_a(arg0: bool, arg1: u256) -> u256
fn @recursive_a(arg0: bool, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = icall fn6, false, arg1
    ret v0
  bb2:
    ret arg1
}

// CHECK-LABEL: fn @recursive_b(arg0: bool, arg1: u256) -> u256
// CHECK: {{^\+.*}}icall @recursive_a, false, arg1
fn @recursive_b(arg0: bool, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = icall fn7, false, arg1
    ret v0
  bb2:
    ret arg1
}

// CHECK-LABEL: fn @recursive_entry()
// CHECK: icall @recursive_a, true, 1
// CHECK: {{^\+.*}}icall @recursive_a, true, 2
fn @recursive_entry() [selector=0x01020306] {
  bb0:
    v0 = icall fn6, true, 1
    v1 = icall fn7, true, 2
    stop
}

// CHECK-LABEL: fn @mutual_a(
// CHECK: + {{v[0-9]+}} = icall @mutual_a, {{v[0-9]+}} !metadata(spans=[100..110, 120..130])
fn @mutual_a(arg0: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    jumpi v0, bb1, bb2
  bb1:
    ret 7
  bb2:
    v1 = sub arg0, 1
    v2 = icall fn10, v1 !metadata(span=100..110)
    ret v2
}

// CHECK-LABEL: fn @mutual_b(
fn @mutual_b(arg0: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    jumpi v0, bb1, bb2
  bb1:
    ret 7
  bb2:
    v1 = sub arg0, 1
    v2 = icall fn9, v1 !metadata(span=120..130)
    ret v2
}

// CHECK-LABEL: fn @mutual_entry(
// CHECK: + {{v[0-9]+}} = icall @mutual_a, 2
fn @mutual_entry() -> u256 [selector=0x01020307] {
  bb0:
    v0 = icall fn10, 2
    ret v0
}

// CHECK-LABEL: fn @different_mutual_a(
// CHECK: {{^ +}}{{v[0-9]+}} = icall @different_mutual_b,
fn @different_mutual_a(arg0: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    jumpi v0, bb1, bb2
  bb1:
    ret 17
  bb2:
    v1 = sub arg0, 1
    v2 = icall fn13, v1
    ret v2
}

// CHECK-LABEL: fn @different_mutual_b(
// CHECK: {{^ +}}{{v[0-9]+}} = icall @different_mutual_a,
fn @different_mutual_b(arg0: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    jumpi v0, bb1, bb2
  bb1:
    ret 18
  bb2:
    v1 = sub arg0, 1
    v2 = icall fn12, v1
    ret v2
}

// CHECK-LABEL: fn @mutual_tail_a(
// CHECK: + tail_call @mutual_tail_a,
fn @mutual_tail_a(arg0: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    jumpi v0, bb1, bb2
  bb1:
    ret 23
  bb2:
    v1 = sub arg0, 1
    tail_call fn15, v1
}

// CHECK-LABEL: fn @mutual_tail_b(
fn @mutual_tail_b(arg0: u256) -> u256 {
  bb0:
    v0 = iszero arg0
    jumpi v0, bb1, bb2
  bb1:
    ret 23
  bb2:
    v1 = sub arg0, 1
    tail_call fn14, v1
}
