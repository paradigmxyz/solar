- // === ROOT/tests/ui/codegen/mir/merge-equivalent-functions/cold_hint_blocks.mir (before merge-equivalent-functions) ===
+ // === ROOT/tests/ui/codegen/mir/merge-equivalent-functions/cold_hint_blocks.mir (after merge-equivalent-functions) ===
  @module MergeColdHintBlocks
  fn @caller(arg0: i1) -> i256 {
    bb0:
      v0 = icall @plain, arg0
      v1 = icall @hinted, arg0
      v2 = add v0, v1
      ret v2
  }
  
  fn @plain(arg0: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:  ; preds = bb0
      ret 2
    bb1:  ; preds = bb0
      ret 1
  }
  
  fn @hinted(arg0: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2 [cold, cold_hint]:  ; preds = bb0
      ret 2
    bb1:  ; preds = bb0
      ret 1
  }
  
