- // === ROOT/tests/ui/codegen/mir/sroa/control_flow.mir (before dce) ===
+ // === ROOT/tests/ui/codegen/mir/sroa/control_flow.mir (after dce) ===
  @module SroaControlFlow
  fn @diamond(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = alloc 32
      jumpi arg0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      jump bb3
    bb3:
      v2 = phi [bb1: arg1], [bb2: arg2]
      ret v2
  }
  
  fn @loop(arg0: i256) -> i256 {
    bb0:
      v0 = alloc 32
      jump bb1
    bb1:
      v5 = phi [bb0: 0], [bb2: v4]
      v3 = lt v5, arg0
      jumpi v3, bb2, bb3
    bb3:
      ret v5
    bb2:
      v4 = add v5, 1
      jump bb1
  }
  
  fn @missing_definition(arg0: i1) -> i256 {
    bb0:
      v0 = alloc 32
      jumpi arg0, bb1, bb2
    bb1:
      mstore v0, 7
      jump bb2
    bb2:
      v1 = mload v0
      ret v1
  }
  
  fn @cross_field_phi(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = alloc 64
      jumpi arg0, bb1, bb2
    bb1:
      jump bb2
    bb2:
      v6 = phi [bb0: 0], [bb1: arg1]
      ret v6
  }
  
  fn @outside_object() -> i256 {
    bb0:
      v0 = alloc 32
      v1 = ptrtoint ptr<memory> v0 to i256
      memory_zero v1, 32
      v2 = ptradd v0, 32
      v3 = mload v2
      ret v3
  }
  
