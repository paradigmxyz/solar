  @module SroaControlFlow
  fn @diamond(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
      jumpi arg0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      jump bb3
    bb3:
      v4 = phi [bb1: arg1], [bb2: arg2]
      ret v4
  }
  
  fn @loop(arg0: i256) -> i256 {
    bb0:
      v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
      jump bb1
    bb1:
      v6 = phi [bb0: 0], [bb2: v5]
      v4 = lt v6, arg0
      jumpi v4, bb2, bb3
    bb3:
      ret v6
    bb2:
      v5 = add v6, 1
      jump bb1
  }
  
  fn @missing_definition(arg0: i1) -> i256 {
    bb0:
      v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
      v1 = memory_object_field_addr memorystruct<1>, v0, 0
