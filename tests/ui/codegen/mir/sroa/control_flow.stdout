      jumpi arg0, bb1, bb2
    bb1:
      mstore v2, 7
      jump bb2
    bb2:
      v3 = mload v2
      ret v3
  }
  
  fn @cross_field_phi(arg0: i1, arg1: i256) -> i256 {
    bb0:
      v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
      jumpi arg0, bb1, bb2
    bb1:
      jump bb2
    bb2:
      v7 = phi [bb0: 0], [bb1: arg1]
      ret v7
  }
  
  fn @observe_size() -> i256 {
    bb0:
      v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
      memory_zero v0, 32
      v1 = memory_object_field_addr memorystruct<1>, v0, 0
      v2 = ptrtoint memptr v1 to i256
      mstore v2, 7
      v3 = msize
      ret v3
  }
  
