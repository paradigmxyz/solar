//@compile-flags: -Zmir-pipeline=sroa,dce
//@filecheck:
@module Sroa

// CHECK-LABEL: after sroa
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorystruct<2>, exact, uninitialized, infallible, 64
// CHECK: - mstore {{v[0-9]+}}, arg0
// CHECK: - mstore {{v[0-9]+}}, arg1
// CHECK: + {{v[0-9]+}} = add arg0, arg1
// CHECK: {{^[ +].*}}fn @local_struct_observe_fmp{{[( ]}}
// CHECK: {{^[ +].*}}mstore v1, arg0
// CHECK: {{^[ +].*}}v4 = mload v3
// CHECK: {{^[ +].*}}v8 = fmp
// CHECK: {{^[ +].*}}fn @zeroed_array{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memoryfixedarray<4, 1>, exact, uninitialized, infallible, 128
// CHECK: - memory_zero
// CHECK: - {{.*}}mload
// CHECK: + ret 0
// CHECK: {{^[ +].*}}fn @return_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero v0, 64
// CHECK: {{^[ +].*}}returndata v0, 64
// CHECK: {{^[ +].*}}fn @revert_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero v0, 64
// CHECK: {{^[ +].*}}revert v0, 64
// CHECK: {{^[ +].*}}fn @return_field{{[( ]}}
// CHECK: {{^[ +].*}}mstore v1, arg0
// CHECK: {{^[ +].*}}returndata v1, 32
// CHECK: {{^[ +].*}}fn @revert_field_successor{{[( ]}}
// CHECK: {{^[ +].*}}mstore v1, arg0
// CHECK: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}revert v1, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorystruct<2>, exact, uninitialized, infallible, 64
fn @local_struct(arg0: word, arg1: word) -> word {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
    v1 = memory_object_field_addr memorystruct<2>, v0, 0
    mstore v1, arg0
    v2 = memory_object_field_addr memorystruct<2>, v0, 1
    mstore v2, arg1
    v3 = memory_object_field_addr memorystruct<2>, v0, 0
    v4 = mload v3
    v5 = memory_object_field_addr memorystruct<2>, v0, 1
    v6 = mload v5
    v7 = add v4, v6
    ret v7
}

// Raw FMP reads may observe the allocated range; keep this case conservative.
fn @local_struct_observe_fmp(arg0: word, arg1: word) -> word {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v1 = memory_object_field_addr memorystruct<2>, v0, 0
    mstore v1, arg0
    v2 = memory_object_field_addr memorystruct<2>, v0, 1
    mstore v2, arg1
    v3 = memory_object_field_addr memorystruct<2>, v0, 0
    v4 = mload v3
    v5 = memory_object_field_addr memorystruct<2>, v0, 1
    v6 = mload v5
    v7 = add v4, v6
    v8 = fmp
    v9 = add v7, v8
    ret v9
}

fn @zeroed_array() -> word {
  bb0:
    v0 = alloc memoryfixedarray<4, 1>, exact, uninitialized, infallible, 128
    memory_zero v0, 128
    v1 = memory_object_element_addr memoryfixedarray<4, 1>, v0, 3
    v2 = mload v1
    ret v2
}

fn @return_zeroed_object() {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    memory_zero v0, 64
    returndata v0, 64
}

fn @revert_zeroed_object() {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    memory_zero v0, 64
    revert v0, 64
}

fn @return_field(arg0: word) {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v1 = memory_object_field_addr memorystruct<2>, v0, 1
    mstore v1, arg0
    returndata v1, 32
}

fn @revert_field_successor(arg0: word) {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v1 = memory_object_element_addr memoryfixedarray<2, 1>, v0, 1
    mstore v1, arg0
    jump bb1
  bb1:
    revert v1, 32
}
