//@compile-flags: -Zmir-pipeline=sroa,dce
//@filecheck:
@module Sroa

// CHECK-LABEL: after sroa
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorystruct<2>, exact, uninitialized, infallible, 64
// CHECK: - slice_store_element {{v[0-9]+}}, 0, arg0
// CHECK: - slice_store_element {{v[0-9]+}}, 1, arg1
// CHECK: + {{v[0-9]+}} = add arg0, arg1
// CHECK: {{^[ +].*}}fn @local_struct_observe_fmp{{[( ]}}
// CHECK: {{^[ +].*}}[[FIELDS:v[0-9]+]] = make_memory_slice {{v[0-9]+}}, 2
// CHECK: {{^[ +].*}}slice_store_element [[FIELDS]], 0, arg0
// CHECK: {{^[ +].*}}slice_store_element [[FIELDS]], 1, arg1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = slice_load_element [[FIELDS]], 0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = fmp
// CHECK: {{^[ +].*}}fn @zeroed_array{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memoryfixedarray<4, 1>, exact, uninitialized, infallible, 128
// CHECK: - memory_zero
// CHECK: - {{.*}}slice_load_element
// CHECK: + ret 0
// CHECK: {{^[ +].*}}fn @return_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero [[RETURN_PTR:v[0-9]+]], 64
// CHECK: {{^[ +].*}}returndata [[RETURN_PTR]], 64
// CHECK: {{^[ +].*}}fn @revert_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero [[REVERT_PTR:v[0-9]+]], 64
// CHECK: {{^[ +].*}}revert [[REVERT_PTR]], 64
// CHECK: {{^[ +].*}}fn @return_field{{[( ]}}
// CHECK: {{^[ +].*}}slice_store_element {{v[0-9]+}}, 1, arg0
// CHECK: {{^[ +].*}}returndata [[FIELD:v[0-9]+]], 32
// CHECK: {{^[ +].*}}fn @revert_field_successor{{[( ]}}
// CHECK: {{^[ +].*}}slice_store_element {{v[0-9]+}}, 1, arg0
// CHECK: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}revert {{v[0-9]+}}, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorystruct<2>, exact, uninitialized, infallible, 64
fn @local_struct(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
    v1 = make_memory_slice v0, 2
    slice_store_element v1, 0, arg0
    slice_store_element v1, 1, arg1
    v4 = slice_load_element v1, 0
    v6 = slice_load_element v1, 1
    v7 = add v4, v6
    ret v7
}

// Raw FMP reads may observe the allocated range; keep this case conservative.
fn @local_struct_observe_fmp(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v1 = make_memory_slice v0, 2
    slice_store_element v1, 0, arg0
    slice_store_element v1, 1, arg1
    v4 = slice_load_element v1, 0
    v6 = slice_load_element v1, 1
    v7 = add v4, v6
    v18 = fmp
    v8 = ptrtoint memptr v18 to i256
    v9 = add v7, v8
    ret v9
}

fn @zeroed_array() -> i256 {
  bb0:
    v0 = alloc memoryfixedarray<4, 1>, exact, uninitialized, infallible, 128
    v30 = ptrtoint memptr v0 to i256
    memory_zero v30, 128
    v1 = make_memory_slice v0, 4
    v2 = slice_load_element v1, 3
    ret v2
}

fn @return_zeroed_object() {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v30 = ptrtoint memptr v0 to i256
    memory_zero v30, 64
    returndata v30, 64
}

fn @revert_zeroed_object() {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v30 = ptrtoint memptr v0 to i256
    memory_zero v30, 64
    revert v30, 64
}

fn @return_field(arg0: i256) {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v1 = make_memory_slice v0, 2
    slice_store_element v1, 1, arg0
    v2 = ptrtoint memptr v0 to i256
    v3 = add v2, 32
    returndata v3, 32
}

fn @revert_field_successor(arg0: i256) {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v1 = make_memory_slice v0, 2
    slice_store_element v1, 1, arg0
    v2 = ptrtoint memptr v0 to i256
    v3 = add v2, 32
    jump bb1
  bb1:
    revert v3, 32
}

// CHECK-LABEL: fn @zeroed_through_word
// CHECK: {{^[ +].*}}ret 0
fn @zeroed_through_word() -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v2 = ptrtoint memptr v0 to i256
    memory_zero v2, 32
    v3 = make_memory_slice v0, 1
    v5 = slice_load_element v3, 0
    ret v5
}

// CHECK-LABEL: fn @truncated_pointer_escapes
// CHECK: {{^[ +].*}}memory_zero
// CHECK: {{^[ +].*}}{{v[0-9]+}} = trunc i256
// CHECK: {{^[ +].*}}{{v[0-9]+}} = slice_load_element
fn @truncated_pointer_escapes() -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v0 to i256
    memory_zero v1, 32
    v2 = trunc i256 v1 to i160
    v3 = zext i160 v2 to i256
    mstore v3, 7
    v4 = make_memory_slice v0, 1
    v6 = slice_load_element v4, 0
    ret v6
}
