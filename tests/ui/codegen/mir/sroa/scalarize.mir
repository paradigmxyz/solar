//@compile-flags: -Zmir-pipeline=sroa,dce
//@filecheck:
@module Sroa

// CHECK-LABEL: after sroa
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorystruct<2>, exact, uninitialized, infallible, 64
// CHECK: - mstore {{v[0-9]+}}, arg0
// CHECK: - mstore {{v[0-9]+}}, arg1
// CHECK: + {{v[0-9]+}} = add arg0, arg1
// CHECK: {{^[ +].*}}fn @local_struct_observe_fmp{{[( ]}}
// CHECK: {{^[ +].*}}[[FIELD:v[0-9]+]] = ptrtoint memptr {{v[0-9]+}} to i256
// CHECK: {{^[ +].*}}mstore [[FIELD]], arg0
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, arg1
// CHECK: {{^[ +].*}}[[LOAD_PTR:v[0-9]+]] = ptrtoint memptr {{v[0-9]+}} to i256
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload [[LOAD_PTR]]
// CHECK: {{^[ +].*}}{{v[0-9]+}} = fmp
// CHECK: {{^[ +].*}}fn @zeroed_array{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memoryfixedarray<4, 1>, exact, uninitialized, infallible, 128
// CHECK: - memory_zero
// CHECK: - {{.*}}mload
// CHECK: + ret 0
// CHECK: {{^[ +].*}}fn @return_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero [[RETURN_PTR:v[0-9]+]], 64
// CHECK: {{^[ +].*}}returndata [[RETURN_PTR]], 64
// CHECK: {{^[ +].*}}fn @revert_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero [[REVERT_PTR:v[0-9]+]], 64
// CHECK: {{^[ +].*}}revert [[REVERT_PTR]], 64
// CHECK: {{^[ +].*}}fn @return_field{{[( ]}}
// CHECK: {{^[ +].*}}[[FIELD:v[0-9]+]] = ptrtoint memptr {{v[0-9]+}} to i256
// CHECK: {{^[ +].*}}mstore [[FIELD]], arg0
// CHECK: {{^[ +].*}}returndata [[FIELD]], 32
// CHECK: {{^[ +].*}}fn @revert_field_successor{{[( ]}}
// CHECK: {{^[ +].*}}[[FIELD:v[0-9]+]] = ptrtoint memptr {{v[0-9]+}} to i256
// CHECK: {{^[ +].*}}mstore [[FIELD]], arg0
// CHECK: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}revert [[FIELD]], 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorystruct<2>, exact, uninitialized, infallible, 64
fn @local_struct(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
    v10 = memory_object_field_addr memorystruct<2>, v0, 0
    v1 = ptrtoint memptr v10 to i256
    mstore v1, arg0
    v11 = memory_object_field_addr memorystruct<2>, v0, 1
    v2 = ptrtoint memptr v11 to i256
    mstore v2, arg1
    v12 = memory_object_field_addr memorystruct<2>, v0, 0
    v3 = ptrtoint memptr v12 to i256
    v4 = mload v3
    v13 = memory_object_field_addr memorystruct<2>, v0, 1
    v5 = ptrtoint memptr v13 to i256
    v6 = mload v5
    v7 = add v4, v6
    ret v7
}

// Raw FMP reads may observe the allocated range; keep this case conservative.
fn @local_struct_observe_fmp(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v14 = memory_object_field_addr memorystruct<2>, v0, 0
    v1 = ptrtoint memptr v14 to i256
    mstore v1, arg0
    v15 = memory_object_field_addr memorystruct<2>, v0, 1
    v2 = ptrtoint memptr v15 to i256
    mstore v2, arg1
    v16 = memory_object_field_addr memorystruct<2>, v0, 0
    v3 = ptrtoint memptr v16 to i256
    v4 = mload v3
    v17 = memory_object_field_addr memorystruct<2>, v0, 1
    v5 = ptrtoint memptr v17 to i256
    v6 = mload v5
    v7 = add v4, v6
    v18 = fmp
    v8 = ptrtoint memptr v18 to i256
    v9 = add v7, v8
    ret v9
}

fn @zeroed_array() -> i256 {
  bb0:
    v0 = alloc memoryfixedarray<4, 1>, exact, uninitialized, infallible, 128
    v30 = ptrtoint memoryfixedarray v0 to i256
    memory_zero v30, 128
    v19 = memory_object_element_addr memoryfixedarray<4, 1>, v0, 3
    v1 = ptrtoint memptr v19 to i256
    v2 = mload v1
    ret v2
}

fn @return_zeroed_object() {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v30 = ptrtoint memorystruct v0 to i256
    memory_zero v30, 64
    returndata v30, 64
}

fn @revert_zeroed_object() {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v30 = ptrtoint memoryfixedarray v0 to i256
    memory_zero v30, 64
    revert v30, 64
}

fn @return_field(arg0: i256) {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v20 = memory_object_field_addr memorystruct<2>, v0, 1
    v1 = ptrtoint memptr v20 to i256
    mstore v1, arg0
    returndata v1, 32
}

fn @revert_field_successor(arg0: i256) {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v21 = memory_object_element_addr memoryfixedarray<2, 1>, v0, 1
    v1 = ptrtoint memptr v21 to i256
    mstore v1, arg0
    jump bb1
  bb1:
    revert v1, 32
}

// CHECK-LABEL: fn @zeroed_through_bitcast
// CHECK: {{^[ +].*}}ret 0
fn @zeroed_through_bitcast() -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v1 = bitcast memorystruct v0 to memptr
    v2 = ptrtoint memptr v1 to i256
    memory_zero v2, 32
    v3 = memory_object_field_addr memorystruct<1>, v0, 0
    v4 = ptrtoint memptr v3 to i256
    v5 = mload v4
    ret v5
}

// CHECK-LABEL: fn @truncated_pointer_escapes
// CHECK: {{^[ +].*}}memory_zero
// CHECK: {{^[ +].*}}{{v[0-9]+}} = trunc i256
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload
fn @truncated_pointer_escapes() -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v1 = ptrtoint memorystruct v0 to i256
    memory_zero v1, 32
    v2 = trunc i256 v1 to i160
    v3 = zext i160 v2 to i256
    mstore v3, 7
    v4 = memory_object_field_addr memorystruct<1>, v0, 0
    v5 = ptrtoint memptr v4 to i256
    v6 = mload v5
    ret v6
}
