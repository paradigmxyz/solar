//@compile-flags: -Zmir-pipeline=sroa,dce
//@filecheck:
@module Sroa

// CHECK-LABEL: after sroa
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc 64
// CHECK: - mstore {{v[0-9]+}}, arg0
// CHECK: - mstore {{v[0-9]+}}, arg1
// CHECK: + {{v[0-9]+}} = add arg0, arg1
// CHECK: {{^[ +].*}}fn @local_struct_observe_fmp{{[( ]}}
// CHECK: {{^[ +].*}}[[OBJECT:v[0-9]+]] = alloc 64
// CHECK-NEXT: {{^[ +].*}}mstore [[OBJECT]], arg0
// CHECK-NEXT: {{^[ +].*}}[[FIELD1:v[0-9]+]] = ptradd [[OBJECT]], 32
// CHECK-NEXT: {{^[ +].*}}mstore [[FIELD1]], arg1
// CHECK-NEXT: {{^[ +].*}}{{v[0-9]+}} = mload [[OBJECT]]
// CHECK: {{^[ +].*}}{{v[0-9]+}} = fmp
// CHECK: {{^[ +].*}}fn @zeroed_array{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc 128
// CHECK: - memory_zero
// CHECK: - {{v[0-9]+}} = mload
// CHECK: + ret 0
// CHECK: {{^[ +].*}}fn @return_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero [[RETURN_PTR:v[0-9]+]], 64
// CHECK: {{^[ +].*}}returndata [[RETURN_PTR]], 64
// CHECK: {{^[ +].*}}fn @revert_zeroed_object{{[( ]}}
// CHECK: {{^[ +].*}}memory_zero [[REVERT_PTR:v[0-9]+]], 64
// CHECK: {{^[ +].*}}revert [[REVERT_PTR]], 64
// CHECK: {{^[ +].*}}fn @return_field{{[( ]}}
// CHECK: {{^[ +].*}}[[RETURN_FIELD:v[0-9]+]] = ptradd {{v[0-9]+}}, 32
// CHECK-NEXT: {{^[ +].*}}mstore [[RETURN_FIELD]], arg0
// CHECK: {{^[ +].*}}returndata [[FIELD:v[0-9]+]], 32
// CHECK: {{^[ +].*}}fn @revert_field_successor{{[( ]}}
// CHECK: {{^[ +].*}}[[REVERT_FIELD:v[0-9]+]] = ptradd {{v[0-9]+}}, 32
// CHECK-NEXT: {{^[ +].*}}mstore [[REVERT_FIELD]], arg0
// CHECK: {{^[ +].*}}bb1 [cold]:
// CHECK: {{^[ +].*}}revert {{v[0-9]+}}, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @local_struct{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc 64
fn @local_struct(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc 64 !metadata(preserves_fmp)
    mstore v0, arg0
    v1 = ptradd v0, 32
    mstore v1, arg1
    v4 = mload v0
    v3 = ptradd v0, 32
    v6 = mload v3
    v7 = add v4, v6
    ret v7
}

// Raw FMP reads may observe the allocated range; keep this case conservative.
fn @local_struct_observe_fmp(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc 64
    mstore v0, arg0
    v1 = ptradd v0, 32
    mstore v1, arg1
    v4 = mload v0
    v3 = ptradd v0, 32
    v6 = mload v3
    v7 = add v4, v6
    v18 = fmp
    v8 = ptrtoint ptr<memory> v18 to i256
    v9 = add v7, v8
    ret v9
}

fn @zeroed_array() -> i256 {
  bb0:
    v0 = alloc 128
    v30 = ptrtoint ptr<memory> v0 to i256
    memory_zero v30, 128
    v1 = ptradd v0, 96
    v2 = mload v1
    ret v2
}

fn @return_zeroed_object() {
  bb0:
    v0 = alloc 64
    v30 = ptrtoint ptr<memory> v0 to i256
    memory_zero v30, 64
    returndata v30, 64
}

fn @revert_zeroed_object() {
  bb0:
    v0 = alloc 64
    v30 = ptrtoint ptr<memory> v0 to i256
    memory_zero v30, 64
    revert v30, 64
}

fn @return_field(arg0: i256) {
  bb0:
    v0 = alloc 64
    v1 = ptradd v0, 32
    mstore v1, arg0
    v2 = ptrtoint ptr<memory> v0 to i256
    v3 = add v2, 32
    returndata v3, 32
}

fn @revert_field_successor(arg0: i256) {
  bb0:
    v0 = alloc 64
    v1 = ptradd v0, 32
    mstore v1, arg0
    v2 = ptrtoint ptr<memory> v0 to i256
    v3 = add v2, 32
    jump bb1
  bb1:
    revert v3, 32
}

// CHECK-LABEL: fn @zeroed_through_word
// CHECK: {{^[ +].*}}ret 0
fn @zeroed_through_word() -> i256 {
  bb0:
    v0 = alloc 32
    v2 = ptrtoint ptr<memory> v0 to i256
    memory_zero v2, 32
    v5 = mload v0
    ret v5
}

// CHECK-LABEL: fn @truncated_pointer_escapes
// CHECK: {{^[ +].*}}memory_zero
// CHECK: {{^[ +].*}}{{v[0-9]+}} = trunc i256
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload v0
fn @truncated_pointer_escapes() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    memory_zero v1, 32
    v2 = trunc i256 v1 to i160
    v3 = zext i160 v2 to i256
    mstore v3, 7
    v6 = mload v0
    ret v6
}
