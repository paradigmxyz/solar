//@compile-flags: -Zmir-pipeline=sroa
//@filecheck:
@module SroaMsizeCaller

// `msize` only promises a lower bound, the free-memory pointer and every byte written before it,
// and the object lies below that bound, so a caller that reads `msize` does not keep the object's
// store alive.
// CHECK-LABEL: fn @touch{{[( ]}}
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK-NOT: {{^[ +]+}}mload
// CHECK: {{^[ +]+}}ret arg0
fn @touch(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 32
    mstore v0, arg0
    v1 = mload v0
    ret v1
}

fn @caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @touch, arg0
    v1 = msize
    v2 = add v0, v1
    ret v2
}

// A callee that reads `msize` does not keep the object either.
// CHECK-LABEL: fn @touch_then_measure{{[( ]}}
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK-NOT: {{^[ +]+}}mload
// CHECK: {{^[ +]+(v[0-9]+ = )?}}icall @measure
fn @touch_then_measure(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 32
    mstore v0, arg0
    v1 = mload v0
    v2 = icall @measure
    v3 = add v1, v2
    ret v3
}

fn @measure() -> i256 {
  bb0:
    v0 = msize
    ret v0
}

// `msize` in the function itself does not keep the object's writes.
// CHECK-LABEL: fn @observe_size{{[( ]}}
// CHECK-NOT: {{^[ +]+}}memory_zero
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK: {{^[ +]+(v[0-9]+ = )?}}msize
fn @observe_size() -> i256 {
  bb0:
    v0 = alloc 32
    v12 = ptrtoint ptr<memory> v0 to i256
    memory_zero v12, 32
    mstore v0, 7
    v2 = msize
    ret v2
}
