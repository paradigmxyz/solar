//@compile-flags: -Zmir-pipeline=sroa,dce
@module SroaControlFlow

fn @diamond(arg0: i1, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v1 = make_memory_slice v0, 1
    jumpi arg0, bb1, bb2
  bb1:
    slice_store_element v1, 0, arg1
    jump bb3
  bb2:
    slice_store_element v1, 0, arg2
    jump bb3
  bb3:
    v2 = slice_load_element v1, 0
    ret v2
}

fn @loop(arg0: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v12 = ptrtoint memptr v0 to i256
    memory_zero v12, 32
    v1 = make_memory_slice v0, 1
    jump bb1
  bb1:
    v2 = slice_load_element v1, 0
    v3 = lt v2, arg0
    jumpi v3, bb2, bb3
  bb2:
    v4 = add v2, 1
    slice_store_element v1, 0, v4
    jump bb1
  bb3:
    ret v2
}

fn @missing_definition(arg0: i1) -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v1 = make_memory_slice v0, 1
    jumpi arg0, bb1, bb2
  bb1:
    slice_store_element v1, 0, 7
    jump bb2
  bb2:
    v2 = slice_load_element v1, 0
    ret v2
}

fn @cross_field_phi(arg0: i1, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v12 = ptrtoint memptr v0 to i256
    memory_zero v12, 64
    v1 = make_memory_slice v0, 2
    jumpi arg0, bb1, bb2
  bb1:
    slice_store_element v1, 0, arg1
    v3 = slice_load_element v1, 0
    slice_store_element v1, 1, v3
    jump bb2
  bb2:
    v4 = slice_load_element v1, 1
    ret v4
}

fn @observe_size() -> i256 {
  bb0:
    v0 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v12 = ptrtoint memptr v0 to i256
    memory_zero v12, 32
    v1 = make_memory_slice v0, 1
    slice_store_element v1, 0, 7
    v2 = msize
    ret v2
}

fn @outside_object() -> i256 {
  bb0:
    v0 = alloc memoryfixedarray<1, 1>, exact, uninitialized, infallible, 32
    v12 = ptrtoint memptr v0 to i256
    memory_zero v12, 32
    v1 = make_memory_slice v0, 1
    v2 = slice_load_element v1, 1
    ret v2
}
