- ; === ROOT/tests/ui/codegen/mir/sroa/check_analyses.mir (before dce) ===
+ ; === ROOT/tests/ui/codegen/mir/sroa/check_analyses.mir (after dce) ===
  @module SroaCheckAnalyses
  fn @diamond(arg0: i1, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = alloc 32
      jumpi arg0, bb1, bb2
    bb2:                                            ; preds = bb0
      mstore v0, arg2
      jump bb3
    bb1:                                            ; preds = bb0
      mstore v0, arg1
      jump bb3
    bb3:                                            ; preds = bb1, bb2
      v2 = phi [bb1: arg1], [bb2: arg2]
      v1 = mload v0
      assume eq sroa, v1, v2
      ret v2
  }
  
  fn @zero_and_pointer(arg0: i256) -> i256 {
    bb0:
      v0 = alloc 64
      v1 = ptrtoint ptr<memory> v0 to i256
      memory_zero v1, 64
      v2 = ptradd v0, 32
      v3 = mload v2
      mstore v0, arg0
      v7 = mload v0
      v4 = inttoptr i256 arg0 to ptr<memory>
      v5 = ptrtoint ptr<memory> v4 to i256
      v6 = add v5, 0
      assume eq sroa, v7, arg0
      assume eq sroa, v3, 0
      ret v6
  }
  
