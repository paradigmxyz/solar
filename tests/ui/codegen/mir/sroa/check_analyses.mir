//@ revisions: off on
//@[off] compile-flags: -Zmir-pipeline=sroa,dce
//@[off] filecheck: --check-prefixes=CHECK,OFF
//@[on] compile-flags: -Zmir-pipeline=sroa,dce,sroa -Zcheck-analyses=true
//@[on] filecheck: --check-prefixes=CHECK,ON
@module SroaCheckAnalyses

// With `-Zcheck-analyses`, a scalarized object keeps its stores, zero fills and address
// derivations, and each field load stays as the evidence that the field holds the value that
// replaced it. A second run leaves the evidence alone. Without the flag the field traffic goes.
// CHECK-LABEL: {{^[ +].*}}fn @diamond{{[( ]}}
// OFF: - mstore v0, arg1
// ON: {{^ .*}}mstore v0, arg1
// CHECK: + [[FIELD:v[0-9]+]] = phi [bb1: arg1], [bb2: arg2]
// ON: {{^ .*}}[[LOAD:v[0-9]+]] = mload v0
// ON: + assume eq sroa, [[LOAD]], [[FIELD]]
// OFF-NOT: assume
fn @diamond(arg0: i1, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = alloc 32
    jumpi arg0, bb1, bb2
  bb1:
    mstore v0, arg1
    jump bb3
  bb2:
    mstore v0, arg2
    jump bb3
  bb3:
    v2 = mload v0
    ret v2
}

// A zero fill defines every field and stays; a pointer read back from a field becomes a cast,
// and the field is read again as a word for the record.
// CHECK-LABEL: {{^[ +].*}}fn @zero_and_pointer{{[( ]}}
// OFF: - memory_zero
// ON: {{^ .*}}memory_zero
// ON: {{^ .*}}[[ZERO:v[0-9]+]] = mload
// ON: + [[WORD:v[0-9]+]] = mload v0
// ON-NEXT: + {{v[0-9]+}} = inttoptr i256 arg0 to ptr<memory>
// ON: + assume eq sroa, [[WORD]], arg0
// ON-NEXT: + assume eq sroa, [[ZERO]], 0
// OFF-NOT: assume
// ON: (after dce)
// ON-NOT: {{^[+-] +[^ ;]}}
fn @zero_and_pointer(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 64
    v1 = ptrtoint ptr<memory> v0 to i256
    memory_zero v1, 64
    v2 = ptradd v0, 32
    v3 = mload v2
    mstore v0, arg0
    v4 = mload v0, ptr<memory>
    v5 = ptrtoint ptr<memory> v4 to i256
    v6 = add v3, v5
    ret v6
}
