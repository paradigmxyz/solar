//@ revisions: baseline gas size
//@[baseline] compile-flags: -Zmir-pipeline=lower-memory-objects,cse
//@[gas] compile-flags: -Ogas -Zmir-pipeline=lower-memory-objects,cse,late-check-elim
//@[size] compile-flags: -Osize -Zmir-pipeline=lower-memory-objects,cse,late-check-elim

@module LateMemoryConditions
@phase dispatch

// Memory lowering makes both lengths the same load. The second check is redundant.
fn @same_length(arg0: memptr, arg1: u256) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = lt arg1, v0
    jumpi v1, bb1, bb2
  bb1:
    v2 = mload arg0
    v3 = lt arg1, v2
    jumpi v3, bb3, bb2
  bb2:
    revert 0, 0
  bb3:
    ret arg1
}

// A write to the header invalidates the first length, even with the same address.
fn @changed_length(arg0: memptr, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = lt arg1, v0
    jumpi v1, bb1, bb2
  bb1:
    mstore arg0, arg2
    v2 = mload arg0
    v3 = lt arg1, v2
    jumpi v3, bb3, bb2
  bb2:
    revert 0, 0
  bb3:
    ret arg1
}

// The loop header proves the in-body bound, including the zero-iteration case.
fn @loop_length(arg0: memptr) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = memory_object_len memorybytes, arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb4
  bb2:
    v3 = mload arg0
    v4 = lt v0, v3
    jumpi v4, bb3, bb5
  bb3:
    v5 = add v0, 1
    jump bb1
  bb4:
    ret v0
  bb5:
    revert 0, 0
}

// Preserve ordinary loop exits in gas mode, even when their edge is redundant.
fn @loop_exit(arg0: memptr) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = memory_object_len memorybytes, arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb4
  bb2:
    v3 = mload arg0
    v4 = lt v0, v3
    jumpi v4, bb3, bb5
  bb3:
    v5 = add v0, 1
    jump bb1
  bb4:
    ret v0
  bb5:
    ret 0
}

// An outlined failure helper has the same profitability as a direct revert.
fn @outlined_failure(arg0: memptr) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = memory_object_len memorybytes, arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb4
  bb2:
    v3 = mload arg0
    v4 = lt v0, v3
    jumpi v4, bb3, bb5
  bb3:
    v5 = add v0, 1
    jump bb1
  bb4:
    ret v0
  bb5:
    tail_call @failure
}

fn @failure() {
  bb0:
    revert 0, 0
}
