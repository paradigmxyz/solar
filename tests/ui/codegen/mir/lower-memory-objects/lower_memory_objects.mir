//@compile-flags: -Zmir-pipeline=lower-memory-objects
//@filecheck:
@module LowerMemoryObjects
@phase semantic

// Object allocations become raw, and each `ptradd` becomes an integer `add`
// that the stores then take as their address.
// CHECK-LABEL: {{^[ +].*}}fn @objects{{[( ]}}
// CHECK: + [[OBJECT_PTR:v[0-9]+]] = alloc raw
// CHECK: [[OBJECT:v[0-9]+]] = ptrtoint memptr [[OBJECT_PTR]] to i256
// CHECK: store [[OBJECT]], 3
// CHECK: + [[LOAD:v[0-9]+]] = ptrtoint memptr [[OBJECT_PTR]] to i256
// CHECK: + [[LEN:v[0-9]+]] = load [[LOAD]]
// CHECK: + [[DATA:v[0-9]+]] = ptrtoint memptr [[OBJECT_PTR]] to i256
// CHECK: + {{v[0-9]+}} = add [[DATA]], 32
// CHECK: + [[FIELD_BASE:v[0-9]+]] = ptrtoint memptr arg2 to i256
// CHECK-NEXT: + [[FIELD:v[0-9]+]] = add [[FIELD_BASE]], 32
// CHECK-NEXT: + {{v[0-9]+}} = inttoptr i256 [[FIELD]] to memptr
// CHECK-NEXT: + store [[FIELD]], [[LEN]]
// CHECK: + [[ARRAY_BASE:v[0-9]+]] = ptrtoint memptr arg1 to i256
// CHECK-NEXT: + [[ARRAY_DATA:v[0-9]+]] = add [[ARRAY_BASE]], 32
// CHECK-NEXT: + {{v[0-9]+}} = inttoptr i256 [[ARRAY_DATA]] to memptr
// CHECK-NEXT: + [[ELEMENT:v[0-9]+]] = add [[ARRAY_DATA]], {{v[0-9]+}}
// CHECK-NEXT: + {{v[0-9]+}} = inttoptr i256 [[ELEMENT]] to memptr
// CHECK-NEXT: + store [[ELEMENT]], [[LEN]]
// CHECK: + [[FIXED_BASE:v[0-9]+]] = ptrtoint memptr arg3 to i256
// CHECK-NEXT: + [[FIXED:v[0-9]+]] = add [[FIXED_BASE]], {{v[0-9]+}}
// CHECK-NEXT: + {{v[0-9]+}} = inttoptr i256 [[FIXED]] to memptr
// CHECK-NEXT: + store [[FIXED]], [[LEN]]
fn @objects(arg0: memptr, arg1: memptr, arg2: memptr, arg3: memptr) {
  bb0:
    v4 = alloc memorybytes, exact, zeroed, panic, 96
    v14 = ptrtoint memptr v4 to i256
    store v14, 3
    v5 = load v4
    v15 = ptradd v4, 32
    v6 = ptrtoint memptr v15 to i256
    store8 v6, v5
    v11 = ptradd arg2, 32
    store v11, v5
    v115 = shl 5, v5
    v12 = ptradd arg1, 32
    v17 = ptradd v12, v115
    store v17, v5
    v116 = shl 5, v5
    v13 = ptradd arg3, v116
    store v13, v5
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_from_slice{{[( ]}}
// CHECK: + copy [[DEST1:v[0-9]+]], [[MEMORY_PTR:v[0-9]+]], [[MEMORY_LEN:v[0-9]+]]
// CHECK: + copy calldata [[DEST2:v[0-9]+]], [[CALLDATA_PTR:v[0-9]+]], [[CALLDATA_LEN:v[0-9]+]]
// CHECK: + copy returndata [[DEST3:v[0-9]+]], [[RETURNDATA_PTR:v[0-9]+]], [[RETURNDATA_LEN:v[0-9]+]]
fn @copy_from_slice(arg0: memptr, arg1: memoryslice, arg2: calldataslice, arg3: returndataslice) {
  bb0:
    v0 = ptradd arg0, 32
    v1 = slice_ptr arg1
    v2 = slice_len arg1
    copy v0, v1, v2
    v3 = ptradd arg0, 32
    v4 = slice_ptr arg2
    v5 = slice_len arg2
    copy calldata v3, v4, v5
    v6 = ptradd arg0, 32
    v7 = slice_ptr arg3
    v8 = slice_len arg3
    copy returndata v6, v7, v8
    stop
}

// A copy between object payloads reads no length word.
// CHECK-LABEL: {{^[ +].*}}fn @copy_object{{[( ]}}
// CHECK-NOT: load
// CHECK: + [[DEST_WORD:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK-NEXT: + [[OBJECT_DEST:v[0-9]+]] = add [[DEST_WORD]], 32
// CHECK: + [[SOURCE_WORD:v[0-9]+]] = ptrtoint memptr arg1 to i256
// CHECK-NEXT: + [[OBJECT_SOURCE:v[0-9]+]] = add [[SOURCE_WORD]], 32
// CHECK: copy [[OBJECT_DEST]], [[OBJECT_SOURCE]], arg2
fn @copy_object(arg0: memptr, arg1: memptr, arg2: i256) {
  bb0:
    v0 = ptradd arg0, 32
    v1 = ptrtoint memptr v0 to i256
    v2 = ptradd arg1, 32
    v3 = ptrtoint memptr v2 to i256
    copy v1, v3, arg2
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @word_carrier{{[( ]}}
// CHECK: {{^[ +].*}}[[POINTER:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} arg0
// CHECK: {{^[ +].*}}[[OBJECT_POINTER:v[0-9]+]] = inttoptr i256 [[POINTER]] to memptr
// CHECK-NOT: + {{.*}}ptrtoint
// CHECK: + {{v[0-9]+}} = load [[POINTER]]
fn @word_carrier(arg0: memptr) -> i256 {
  bb0:
    v0 = ptrtoint memptr arg0 to i256
    v2 = inttoptr i256 v0 to memptr
    v1 = load v2
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @unreachable_cast_cycle{{[( ]}}
// CHECK: ret 0
// CHECK: {{v[0-9]+}} = inttoptr
fn @unreachable_cast_cycle() -> i256 {
  bb0:
    ret 0
  bb1:
    v0 = inttoptr i256 v1 to memptr
    v1 = ptrtoint memptr v0 to i256
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @merged_allocations{{[( ]}}
// CHECK: + [[BASE_PTR:v[0-9]+]] = alloc raw, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
// CHECK: [[BASE:v[0-9]+]] = ptrtoint memptr [[BASE_PTR]] to i256
// CHECK: store [[BASE]], 0
// CHECK: + [[OFFSET_BASE:v[0-9]+]] = ptrtoint memptr [[BASE_PTR]] to i256
// CHECK: + [[NEXT:v[0-9]+]] = add [[OFFSET_BASE]], 32{{$}}
fn @merged_allocations() -> memptr {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v2 = ptrtoint memptr v0 to i256
    store v2, 0
    v1 = alloc memorybytes, exact, uninitialized, infallible, 32 !metadata(preserves_fmp)
    v3 = ptrtoint memptr v1 to i256
    store v3, 0
    ret v1
}
