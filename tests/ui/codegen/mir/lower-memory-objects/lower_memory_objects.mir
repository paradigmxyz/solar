//@compile-flags: -Zmir-pipeline=lower-memory-objects
//@filecheck:
@module LowerMemoryObjects
@phase semantic

// Each `ptradd` becomes an integer `add` that the stores then take as their
// address.
// CHECK-LABEL: {{^[ +].*}}fn @objects{{[( ]}}
// CHECK: [[OBJECT_PTR:v[0-9]+]] = alloc zeroed checked 96
// CHECK: [[OBJECT:v[0-9]+]] = ptrtoint ptr<memory> [[OBJECT_PTR]] to i256
// CHECK: mstore [[OBJECT]], 3
// CHECK: + [[LOAD:v[0-9]+]] = ptrtoint ptr<memory> [[OBJECT_PTR]] to i256
// CHECK: + [[LEN:v[0-9]+]] = mload [[LOAD]]
// CHECK: + [[DATA:v[0-9]+]] = ptrtoint ptr<memory> [[OBJECT_PTR]] to i256
// CHECK-NEXT: + [[BYTE:v[0-9]+]] = add [[DATA]], 32
// CHECK-NEXT: + mstore8 [[BYTE]], [[LEN]]
// CHECK: + [[FIELD_BASE:v[0-9]+]] = ptrtoint ptr<memory> arg2 to i256
// CHECK-NEXT: + [[FIELD:v[0-9]+]] = add [[FIELD_BASE]], 32
// CHECK-NEXT: + mstore [[FIELD]], [[LEN]]
// CHECK: + [[ARRAY_BASE:v[0-9]+]] = ptrtoint ptr<memory> arg1 to i256
// CHECK-NEXT: + [[ARRAY_DATA:v[0-9]+]] = add [[ARRAY_BASE]], 32
// CHECK-NEXT: + [[ELEMENT:v[0-9]+]] = add [[ARRAY_DATA]], {{v[0-9]+}}
// CHECK-NEXT: + mstore [[ELEMENT]], [[LEN]]
// CHECK: + [[FIXED_BASE:v[0-9]+]] = ptrtoint ptr<memory> arg3 to i256
// CHECK-NEXT: + [[FIXED:v[0-9]+]] = add [[FIXED_BASE]], {{v[0-9]+}}
// CHECK-NEXT: + mstore [[FIXED]], [[LEN]]
fn @objects(arg0: ptr<memory>, arg1: ptr<memory>, arg2: ptr<memory>, arg3: ptr<memory>) {
  bb0:
    v4 = alloc zeroed checked 96
    v14 = ptrtoint ptr<memory> v4 to i256
    mstore v14, 3
    v5 = mload v4
    v15 = ptradd v4, 32
    v6 = ptrtoint ptr<memory> v15 to i256
    mstore8 v6, v5
    v11 = ptradd arg2, 32
    mstore v11, v5
    v115 = shl 5, v5
    v12 = ptradd arg1, 32
    v17 = ptradd v12, v115
    mstore v17, v5
    v116 = shl 5, v5
    v13 = ptradd arg3, v116
    mstore v13, v5
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_from_slice{{[( ]}}
// CHECK: + mcopy [[DEST1:v[0-9]+]], [[MEMORY_PTR:v[0-9]+]], [[MEMORY_LEN:v[0-9]+]]
// CHECK: + calldatacopy [[DEST2:v[0-9]+]], [[CALLDATA_PTR:v[0-9]+]], [[CALLDATA_LEN:v[0-9]+]]
// CHECK: + returndatacopy [[DEST3:v[0-9]+]], [[RETURNDATA_PTR:v[0-9]+]], [[RETURNDATA_LEN:v[0-9]+]]
fn @copy_from_slice(arg0: ptr<memory>, arg1: slice<memory>, arg2: slice<calldata>, arg3: slice<returndata>) {
  bb0:
    v0 = ptradd arg0, 32
    v1 = extract_value slice<memory>, arg1, 0
    v2 = extract_value slice<memory>, arg1, 1
    mcopy v0, v1, v2
    v3 = ptradd arg0, 32
    v4 = extract_value slice<calldata>, arg2, 0
    v5 = extract_value slice<calldata>, arg2, 1
    calldatacopy v3, v4, v5
    v6 = ptradd arg0, 32
    v7 = extract_value slice<returndata>, arg3, 0
    v8 = extract_value slice<returndata>, arg3, 1
    returndatacopy v6, v7, v8
    stop
}

// A copy between object payloads reads no length word.
// CHECK-LABEL: {{^[ +].*}}fn @copy_object{{[( ]}}
// CHECK-NOT: mload
// CHECK: + [[DEST_WORD:v[0-9]+]] = ptrtoint ptr<memory> arg0 to i256
// CHECK-NEXT: + [[OBJECT_DEST:v[0-9]+]] = add [[DEST_WORD]], 32
// CHECK: + [[SOURCE_WORD:v[0-9]+]] = ptrtoint ptr<memory> arg1 to i256
// CHECK-NEXT: + [[OBJECT_SOURCE:v[0-9]+]] = add [[SOURCE_WORD]], 32
// CHECK: mcopy [[OBJECT_DEST]], [[OBJECT_SOURCE]], arg2
fn @copy_object(arg0: ptr<memory>, arg1: ptr<memory>, arg2: i256) {
  bb0:
    v0 = ptradd arg0, 32
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = ptradd arg1, 32
    v3 = ptrtoint ptr<memory> v2 to i256
    mcopy v1, v3, arg2
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @word_carrier{{[( ]}}
// CHECK: {{^[ +].*}}[[POINTER:v[0-9]+]] = {{(zext|ptrtoint)}} {{[^ ]+}} arg0
// CHECK-NOT: + {{.*}}{{ptrtoint|inttoptr}}
// CHECK: + {{v[0-9]+}} = mload [[POINTER]]
fn @word_carrier(arg0: ptr<memory>) -> i256 {
  bb0:
    v0 = ptrtoint ptr<memory> arg0 to i256
    v2 = inttoptr i256 v0 to ptr<memory>
    v1 = mload v2
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @unreachable_cast_cycle{{[( ]}}
// CHECK: ret 0
// CHECK: {{v[0-9]+}} = inttoptr
fn @unreachable_cast_cycle() -> i256 {
  bb0:
    ret 0
  bb1:
    v0 = inttoptr i256 v1 to ptr<memory>
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}
