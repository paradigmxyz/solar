//@ compile-flags: -Zmir-pipeline=lower-structs,lower-slices
//@ filecheck:
@module EmptyStructArg

@types
  struct0: {}

// lower-structs drops the zero-field parameter, so the old argument value indexes past the
// parameters. lower-slices looks only at the values the body still uses.
// CHECK-LABEL: (after lower-slices)
// CHECK: fn @f() -> i256 {
// CHECK: ret 1
fn @f(arg0: struct0) -> i256 {
  bb0:
    ret 1
}
