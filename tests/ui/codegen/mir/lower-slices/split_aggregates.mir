//@compile-flags: -Zmir-pipeline=lower-slices
//@filecheck:
@module SplitAggregates

// CHECK-LABEL: {{^[ +].*}}fn @select_slice{{[( ]}}
// CHECK: + [[PTR0:v[0-9]+]] = inttoptr i256 arg0 to ptr<calldata>
// CHECK: + [[PTR1:v[0-9]+]] = inttoptr i256 arg2 to ptr<calldata>
// CHECK: + {{v[0-9]+}} = select arg4, [[PTR0]], [[PTR1]]
// CHECK: + [[LENGTH:v[0-9]+]] = select arg4, arg1, arg3
// CHECK: + ret [[LENGTH]]
fn @select_slice(arg0: slice<calldata>, arg1: slice<calldata>, arg2: i1) -> i256 {
  bb0:
    v3 = select arg2, arg0, arg1
    v4 = extract_value slice<calldata>, v3, 1
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @phi_slice{{[( ]}}
// CHECK-DAG: + [[PTR0:v[0-9]+]] = inttoptr i256 arg0 to ptr<calldata>
// CHECK-DAG: + [[PTR1:v[0-9]+]] = inttoptr i256 arg2 to ptr<calldata>
// CHECK: + {{v[0-9]+}} = phi [bb1: [[PTR0]]], [bb2: [[PTR1]]]
// CHECK: + [[LENGTH:v[0-9]+]] = phi [bb1: arg1], [bb2: arg3]
// CHECK: + ret [[LENGTH]]
fn @phi_slice(arg0: slice<calldata>, arg1: slice<calldata>, arg2: i1) -> i256 {
  bb0:
    jumpi arg2, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v3 = phi [bb1: arg0], [bb2: arg1]
    v4 = extract_value slice<calldata>, v3, 1
    ret v4
}
