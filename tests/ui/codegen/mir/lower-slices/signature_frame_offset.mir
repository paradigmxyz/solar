//@ compile-flags: -Zmir-pipeline=lower-slices
//@ filecheck:

@module SignatureFrameOffset

// CHECK-LABEL: fn @signature_slot(arg0: memoryslice, arg1: u256)
// CHECK: v0 = internal_frame_addr 96
