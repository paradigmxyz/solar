//@ compile-flags: -Zmir-pipeline=lower-slices
//@ filecheck:

@module SignatureFrameOffset

// CHECK-LABEL: fn @signature_slot(arg0: memoryslice, arg1: i256)
// CHECK: v0 = internal_frame_addr 96
// CHECK: stop
fn @signature_slot(arg0: memoryslice, arg1: i256) {
  bb0:
    v1 = internal_frame_addr 96
    v0 = ptrtoint memptr v1 to i256
    stop
}
