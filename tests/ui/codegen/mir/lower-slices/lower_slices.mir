//@compile-flags: -Zmir-pipeline=lower-abi,lower-slices
//@filecheck:
@module LowerSlices
// CHECK: + fn @entry()
fn @entry(arg0: slice<calldata>) [selector=0x12345678] {
  bb0:
    v1 = icall @len, arg0
    store 128, v1
    returndata 128, 32
}

// CHECK-LABEL: {{^[ +].*}}after lower-slices
// CHECK: {{^[ +].*}}fn @len{{[( ]}}
// CHECK: + [[HEAD:v[0-9]+]] = add arg0, 4
// CHECK: + [[LENGTH:v[0-9]+]] = load calldata [[HEAD]]
// CHECK: + ret [[LENGTH]]
fn @len(arg0: slice<calldata>) -> i256 {
  bb0:
    v1 = extract_value slice<calldata>, arg0, 1
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @tail{{[( ]}}
// CHECK: + [[POINTER:v[0-9]+]] = add arg0, arg2
// CHECK: + [[LENGTH:v[0-9]+]] = sub arg1, arg2
// CHECK: + {{v[0-9]+}} = icall @pair_len, [[POINTER]], [[LENGTH]]
fn @tail(arg0: slice<calldata>, arg1: i256) -> i256 {
  bb0:
    v2 = extract_value slice<calldata>, arg0, 0
    v3 = extract_value slice<calldata>, arg0, 1
    v4 = add v2, arg1
    v5 = sub v3, arg1
    v6 = make_calldata_slice v4, v5
    v7 = icall @pair_len, v6
    ret v7
}

// CHECK-LABEL: {{^[ +].*}}fn @pair_len{{[( ]}}
// CHECK: + ret arg1
fn @pair_len(arg0: slice<calldata>) -> i256 {
  bb0:
    v1 = extract_value slice<calldata>, arg0, 1
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @memory{{[( ]}}
// CHECK: + [[END:v[0-9]+]] = add arg0, arg1
// CHECK: {{^[ +].*}}ret [[END]]
fn @memory(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = make_memory_slice arg0, arg1
    v3 = extract_value slice<memory>, v2, 0
    v4 = extract_value slice<memory>, v2, 1
    v5 = add v3, v4
    ret v5
}
