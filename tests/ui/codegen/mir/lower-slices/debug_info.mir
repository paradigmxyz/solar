//@compile-flags: -Zmir-pipeline=lower-slices
//@filecheck:
@module DebugInfo

// CHECK-LABEL: {{^[ +].*}}fn @select_slice{{[( ]}}
// CHECK: + [[PTR0:v[0-9]+]] = inttoptr i256 arg0 to ptr<calldata>
// CHECK: + [[PTR1:v[0-9]+]] = inttoptr i256 arg2 to ptr<calldata>
// CHECK: + {{v[0-9]+}} = select arg4, [[PTR0]], [[PTR1]]
// CHECK: + [[LENGTH:v[0-9]+]] = select arg4, arg1, arg3
// CHECK: + ret [[LENGTH]]
fn @select_slice(arg0: slice<calldata>, arg1: slice<calldata>, arg2: i1) -> i256 {
  bb0:
    v3 = select arg2, arg0, arg1 !metadata(span=10..20)
    v4 = extract_value slice<calldata>, v3, 1 !metadata(span=20..30)
    ret v4
}

// A folded projection whose span nests with nothing in its replacement's definition keeps its
// origin dropped: the length definition keeps its own span alone.
// CHECK-LABEL: {{^[ +].*}}fn @unrelated{{[( ]}}
// CHECK: {{v[0-9]+}} = add arg1, 1 !metadata(span=52..54){{$}}
fn @unrelated(arg0: ptr<calldata>, arg1: i256) -> i256 {
  bb0:
    v0 = add arg1, 1 !metadata(span=52..54)
    v1 = make_calldata_slice arg0, v0 !metadata(span=60..70)
    v2 = extract_value slice<calldata>, v1, 1 !metadata(span=60..70)
    ret v2
}
