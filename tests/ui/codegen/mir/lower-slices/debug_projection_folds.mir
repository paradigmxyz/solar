//@ compile-flags: -Zmir-pipeline=lower-slices -Zdebugify=report
// A slice built from a pointer and a length, and its projections, fold into those words. Their
// origins move onto the definitions of the words when the spans nest, and are dropped when they
// are unrelated.
@module DebugProjectionFolds
fn @enclosing(arg0: ptr<calldata>, arg1: i256) -> i256 {
  bb0:
    v0 = add arg1, 1 !metadata(span=12..14)
    v1 = make_calldata_slice arg0, v0 !metadata(span=10..20)
    v2 = extract_value slice<calldata>, v1, 1 !metadata(span=10..20)
    ret v2 !metadata(span=100..110)
}
fn @inside(arg0: ptr<calldata>, arg1: i256) -> i256 {
  bb0:
    v0 = add arg1, 1 !metadata(span=32..38)
    v1 = make_calldata_slice arg0, v0 !metadata(span=34..36)
    v2 = extract_value slice<calldata>, v1, 1 !metadata(span=34..36)
    ret v2 !metadata(span=100..110)
}
fn @unrelated(arg0: ptr<calldata>, arg1: i256) -> i256 {
  bb0:
    v0 = add arg1, 1 !metadata(span=52..54)
    v1 = make_calldata_slice arg0, v0 !metadata(span=60..70)
    v2 = extract_value slice<calldata>, v1, 1 !metadata(span=60..70)
    ret v2 !metadata(span=100..110)
}
