//@ compile-flags: -Zmir-pipeline=lower-slices,lower-builtins
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
@module BuiltinObjects

// Object inputs lose no slice length, so their builtins may still lower after lower-slices.
// CHECK-LABEL: (after lower-builtins)
// CHECK: fn @sha_object(arg0: ptr<memory>)
// CHECK: [[DATA:v[0-9]+]] = ptradd arg0, 32
// CHECK: [[LEN:v[0-9]+]] = mload arg0
// CHECK: staticcall {{v[0-9]+}}, 2, [[DATA]], [[LEN]], 0, 32
fn @sha_object(arg0: ptr<memory>) -> i1 {
  bb0:
    v0 = extcall static word i160 2, arg0
    ret v0
}

// CHECK-LABEL: fn @ripemd_object(arg0: ptr<memory>)
// CHECK: staticcall {{v[0-9]+}}, 3,
fn @ripemd_object(arg0: ptr<memory>) -> i1 {
  bb0:
    v0 = extcall static word i160 3, arg0
    ret v0
}
