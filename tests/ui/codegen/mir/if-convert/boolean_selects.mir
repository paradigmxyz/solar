//@compile-flags: -Zmir-pipeline=if-convert
//@filecheck:
@module BooleanSelects

// The last join of `a == 1 || a == 2` merges `true` with the second test, so
// it becomes one `or` instead of `e + c * (true - e)`.
// CHECK-LABEL: {{^[ +].*}}fn @short_circuit_or{{[( ]}}
// CHECK: - jumpi
// CHECK: + {{v[0-9]+}} = or [[C:v[0-9]+]], [[E:v[0-9]+]]
// CHECK-NOT: {{^[ +].*}}mul
// CHECK-NOT: {{^[ +].*}}phi
fn @short_circuit_or(arg0: i256) -> i1 {
  bb0:
    v0 = eq arg0, 1
    jumpi v0, bb2, bb1
  bb1:
    v1 = eq arg0, 2
    jump bb2
  bb2:
    v2 = phi [bb0: true], [bb1: v1]
    ret v2
}

// `true` on the edge where the condition fails negates the condition first.
// CHECK-LABEL: {{^[ +].*}}fn @true_on_else{{[( ]}}
// CHECK: - jumpi
// CHECK: + [[N:v[0-9]+]] = eq {{v[0-9]+}}, false
// CHECK: + {{v[0-9]+}} = or [[N]], {{v[0-9]+}}
// CHECK-NOT: {{^[ +].*}}mul
fn @true_on_else(arg0: i256) -> i1 {
  bb0:
    v0 = lt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    v1 = gt arg0, 3
    jump bb2
  bb2:
    v2 = phi [bb0: true], [bb1: v1]
    ret v2
}

// `a < 10 && a > 3` keeps its product shape but needs no multiplication.
// CHECK-LABEL: {{^[ +].*}}fn @short_circuit_and{{[( ]}}
// CHECK: - jumpi
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NOT: {{^[ +].*}}mul
// CHECK-NOT: {{^[ +].*}}phi
fn @short_circuit_and(arg0: i256) -> i1 {
  bb0:
    v0 = lt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    v1 = gt arg0, 3
    jump bb2
  bb2:
    v2 = phi [bb0: false], [bb1: v1]
    ret v2
}
