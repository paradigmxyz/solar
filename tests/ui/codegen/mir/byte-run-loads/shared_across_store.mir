//@ compile-flags: -Ogas -Zmir-pipeline=byte-run-loads
//@ filecheck:
@module SharedAcrossStore

// The first word is read before the store but its byte is extracted after it. The second read
// sees the stored byte, so its extraction must not reuse the first word.
// CHECK-LABEL: fn @stored(
// CHECK: [[BEFORE:v[0-9]+]] = mload arg0
// CHECK: mstore8
// CHECK: byte 0, [[BEFORE]]
// CHECK: [[AFTER:v[0-9]+]] = mload
// CHECK: byte 0, [[AFTER]]
fn @stored(arg0: i256) -> i256 {
  bb0:
    v1 = mload arg0
    v2 = add arg0, 1
    mstore8 v2, 0x4a
    v3 = byte 0, v1
    v4 = mload v2
    v5 = byte 0, v4
    v6 = shl v3, 8
    v7 = or v6, v5
    ret v7
}
