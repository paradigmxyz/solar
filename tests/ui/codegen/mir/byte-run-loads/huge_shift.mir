//@ compile-flags: -Ogas -Zmir-pipeline=byte-run-loads
//@ filecheck:
@module HugeShift

// The two shifts add up to 2^64 + 8, which shifts the first byte out, so the result is the
// second byte alone. The accumulated shift must not wrap into a run of two.
// CHECK-LABEL: fn @wrapping_shift(
// CHECK-NOT: shr
fn @wrapping_shift(arg0: i256) -> i256 {
  bb0:
    v1 = mload arg0
    v2 = add arg0, 1
    v3 = mload v2
    v4 = byte 0, v1
    v5 = byte 0, v3
    v6 = shl v4, 18446744073709551608
    v7 = shl v6, 16
    v8 = or v7, v5
    ret v8
}

// Both reads sit at the largest constant offset, so the offset of a second byte after them
// does not fit in 64 bits. The run must be left alone.
// CHECK-LABEL: fn @offset_overflow(
// CHECK-NOT: shr
fn @offset_overflow(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 0xffffffffffffffff
    v1 = mload v0
    v2 = mload v0
    v3 = byte 0, v1
    v4 = byte 0, v2
    v5 = shl v3, 8
    v6 = or v5, v4
    ret v6
}
