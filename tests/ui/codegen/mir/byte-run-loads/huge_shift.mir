//@ compile-flags: -Ogas -Zmir-pipeline=byte-run-loads
//@ filecheck:
@module HugeShift

// The two shifts add up to 2^64 + 8, which shifts the first byte out, so the result is the
// second byte alone. The accumulated shift must not wrap into a run of two.
// CHECK-LABEL: fn @wrapping_shift(
// CHECK-NOT: shr
fn @wrapping_shift(arg0: i256) -> i256 {
  bb0:
    v1 = mload arg0
    v2 = add arg0, 1
    v3 = mload v2
    v4 = byte 0, v1
    v5 = byte 0, v3
    v6 = shl v4, 18446744073709551608
    v7 = shl v6, 16
    v8 = or v7, v5
    ret v8
}
