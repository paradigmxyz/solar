- ; === ROOT/tests/ui/codegen/mir/byte-run-loads/across_gas.mir (before byte-run-loads) ===
+ ; === ROOT/tests/ui/codegen/mir/byte-run-loads/across_gas.mir (after byte-run-loads) ===
  @module AcrossGas
  fn @fused(arg0: i256) -> i256 {
    bb0:
      v0 = mload arg0
      v1 = gas
      v2 = add arg0, 1
      v3 = mload v2
      v4 = byte 0, v0
      v5 = byte 0, v3
      v6 = shl v4, 8
      v7 = or v6, v5
      v8 = add v7, v1
      ret v8
  }
  
  fn @shared(arg0: i256) -> i256 {
    bb0:
      v0 = mload arg0
      v1 = byte 0, v0
      v2 = gas
      v3 = add arg0, 1
      v4 = mload v3
      v5 = byte 0, v4
      v6 = add v1, v5
      v7 = add v6, v2
      ret v7
  }
  
