//@compile-flags: -Zmir-pipeline=byte-run-loads
//@filecheck:
// An unused read still expands memory, which the callee observes through `msize`.
@module MsizeCallee
// CHECK-LABEL: fn @caller{{[( ]}}
// CHECK: {{^ .*}}= mload arg0
fn @caller(arg0: i256) -> i256 {
  bb0:
    v0 = mload arg0
    v1 = icall @size
    ret v1
}

fn @size() -> i256 {
  bb0:
    v0 = msize
    ret v0
}
