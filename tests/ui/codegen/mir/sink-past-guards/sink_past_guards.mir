//@compile-flags: -Zmir-pipeline=sink-past-guards
//@filecheck:
@module SinkPastGuards
@phase lowered

// The product and the calldata word it reads are used only after the guard, so both follow it
// instead of being carried across the branch.
// CHECK-LABEL: {{^[ +].*}}after sink-past-guards
// CHECK-LABEL: fn @sinks(
// CHECK: - [[WORD:v[0-9]+]] = calldataload 36
// CHECK: - [[PRODUCT:v[0-9]+]] = mul [[WORD]], 3
// CHECK: jumpi
// CHECK: bb1:
// CHECK: + [[WORD]] = calldataload 36
// CHECK: + [[PRODUCT]] = mul [[WORD]], 3
fn @sinks(arg0: i256) {
  bb0:
    v0 = calldataload 36
    v1 = mul v0, 3
    v2 = lt arg0, 10
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, v1
    mstore 32, v0
    stop
  bb2:
    revert 0, 0
}

// A computation on the products moves with them, in order.
// CHECK-LABEL: fn @chain(
// CHECK: - [[WORD:v[0-9]+]] = calldataload 4
// CHECK: - [[DOUBLE:v[0-9]+]] = mul [[WORD]], 2
// CHECK: - [[PLUS:v[0-9]+]] = add [[DOUBLE]], 1
// CHECK: jumpi
// CHECK: bb1:
// CHECK: + [[WORD]] = calldataload 4
// CHECK: + [[DOUBLE]] = mul [[WORD]], 2
// CHECK: + [[PLUS]] = add [[DOUBLE]], 1
fn @chain(arg0: i256) {
  bb0:
    v0 = calldataload 4
    v1 = mul v0, 2
    v2 = add v1, 1
    v3 = lt arg0, 10
    jumpi v3, bb1, bb2
  bb1:
    mstore 0, v2
    stop
  bb2:
    revert 0, 0
}

// An operand that lives on after the guard, such as an argument, is reached there at the cost of
// carrying the sum, so the sum stays.
// CHECK-LABEL: fn @on_an_argument(
// CHECK-NOT: {{^[+-] }}
fn @on_an_argument(arg0: i256, arg1: i256) {
  bb0:
    v0 = add arg0, 32
    v1 = lt arg1, 10
    jumpi v1, bb1, bb2
  bb1:
    mstore 0, v0
    mstore 32, arg0
    stop
  bb2:
    revert 0, 0
}

// The guard reads the word, so the product that reads it is not closed over the instructions
// that move.
// CHECK-LABEL: fn @word_before(
// CHECK-NOT: {{^[+-] }}
fn @word_before(arg0: i256) {
  bb0:
    v0 = calldataload 36
    v1 = mul v0, 3
    v2 = lt v0, 10
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, v1
    stop
  bb2:
    revert 0, 0
}

// A reader in the reverting block keeps the product: that path needs the value.
// CHECK-LABEL: fn @read_when_reverting(
// CHECK-NOT: {{^[+-] }}
fn @read_when_reverting(arg0: i256) {
  bb0:
    v0 = calldataload 36
    v1 = mul v0, 3
    v2 = lt arg0, 10
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, v1
    stop
  bb2:
    mstore 0, v1
    revert 0, 32
}

// The continuing block is a loop header, entered again from the loop: moving the product there
// would compute it on every iteration.
// CHECK-LABEL: fn @loop_header(
// CHECK-NOT: {{^[+-] }}
fn @loop_header(arg0: i256) {
  bb0:
    v0 = calldataload 36
    v1 = mul v0, 3
    v2 = lt arg0, 10
    jumpi v2, bb1, bb2
  bb1:
    v3 = phi [bb0: 0], [bb3: v5]
    v4 = lt v3, v1
    jumpi v4, bb3, bb4
  bb3:
    v5 = add v3, 1
    jump bb1
  bb4:
    stop
  bb2:
    revert 0, 0
}

// A read of storage is not pure, so it stays.
// CHECK-LABEL: fn @impure(
// CHECK-NOT: {{^[+-] }}
fn @impure(arg0: i256) {
  bb0:
    v0 = sload 0
    v1 = mul v0, 3
    v2 = lt arg0, 10
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, v1
    stop
  bb2:
    revert 0, 0
}
