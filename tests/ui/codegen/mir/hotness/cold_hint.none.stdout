- // === ROOT/tests/ui/codegen/mir/hotness/cold_hint.mir (before none) ===
+ // === ROOT/tests/ui/codegen/mir/hotness/cold_hint.mir (after none) ===
  @module ColdHint
  fn @slow(arg0: i1) -> i256 [cold_hint] {
    bb0 [cold]:
      jumpi arg0, bb1, bb2
    bb2 [cold]:
      ret 2
    bb1 [cold]:
      ret 1
  }
  
  fn @always(arg0: i1) -> i256 {
    bb0:
      jump bb1
    bb1:
      v0 = icall @slow, arg0
      jump bb2
    bb2:
      ret v0
  }
  
  fn @region(arg0: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb3
    bb1:
      v0 = icall @slow, arg0
      jump bb2
    bb2:
      jump bb3
    bb3:
      ret 2
  }
  
  fn @nested(arg0: i1, arg1: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb4
    bb1:
      jumpi arg1, bb2, bb4
    bb2:
      v0 = icall @slow, arg0
      jump bb3
    bb3:
      jump bb4
    bb4:
      ret 2
  }
  
  fn @loop_body(arg0: i1, arg1: i1) -> i256 {
    bb0:
      jump bb1
    bb1:
      jumpi arg0, bb2, bb5
    bb5:
      ret 2
    bb2:
      jumpi arg1, bb3, bb4
    bb3:
      v0 = icall @slow, arg0
      jump bb4
    bb4:
      jump bb1
  }
  
  fn @loop_then_call(arg0: i1) -> i256 {
    bb0:
      jump bb1
    bb1:
      jumpi arg0, bb2, bb3
    bb3:
      v0 = icall @slow, arg0
      jump bb4
    bb4:
      ret v0
    bb2:
      jump bb1
  }
  
  fn @failure_loop(arg0: i1, arg1: i1, arg2: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb4
    bb4:
      jumpi arg2, bb6, bb7
    bb7:
      ret 1
    bb6:
      v0 = icall @slow, arg0
      ret v0
    bb1:
      jumpi arg1, bb2, bb3
    bb3:
      jump bb5
    bb5 [cold]:
      revert 0, 0
    bb2:
      jump bb1
  }
  
  fn @abort_or_call(arg0: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2:
      v0 = icall @slow, arg0
      ret v0
    bb1 [cold]:
      revert 0, 0
  }
  
