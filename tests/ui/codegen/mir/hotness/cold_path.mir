//@ revisions: gas size none
//@[gas] compile-flags: -Zmir-pipeline=none -Ogas
//@[size] compile-flags: -Zmir-pipeline=none -Osize
//@[none] compile-flags: -Zmir-pipeline=none -O none
@module ColdPath

// A block holding `cold_path` starts a rarely run region, as a catch clause does: the branch into
// it is the cold edge, and the blocks only it reaches are cold. The test, the success path, and
// the join stay hot.
fn @bare(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    cold_path
    jump bb3
  bb3:
    ret 1
}

// A catch clause that returns on its own ends in a cold block, as the success path does in a hot
// one.
fn @returns(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    ret 1
  bb2:
    cold_path
    ret 0
}

// A catch body with a loop is cold from the marker to the join, the loop included.
fn @loop_body(arg0: i1, arg1: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb6
  bb2:
    cold_path
    jump bb3
  bb3:
    jumpi arg1, bb4, bb5
  bb4:
    jump bb3
  bb5:
    jump bb6
  bb6:
    ret 1
}

// Typed clauses test the returndata in the marked block, so the whole chain is cold.
fn @typed(arg0: i1, arg1: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jump bb6
  bb2:
    cold_path
    jumpi arg1, bb3, bb4
  bb3:
    jump bb6
  bb4:
    jump bb5
  bb5:
    revert 0, 0
  bb6:
    ret 1
}

// The marker on the only path leaves every block hot, as a call to a `cold_hint` function does.
fn @only_path(arg0: i1) -> i256 {
  bb0:
    jump bb1
  bb1:
    cold_path
    jump bb2
  bb2:
    ret 1
}

// A marker never aborts: a block that holds it and returns is not cold, and neither is the
// function.
fn @not_abort(arg0: i1) -> i256 {
  bb0:
    cold_path
    ret 1
}
