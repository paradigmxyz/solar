// === ROOT/tests/ui/codegen/mir/hotness/cold_hint_returns.sol:C ===
@module C
; function bump(uint256 x) internal returns (uint256)
fn @bump(arg0: i256) -> i256 [cold_hint, cold_hint] {
  bb0:
    jump bb1
  bb1:  ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v6]
    v3 = lt v2, v0
    jumpi v3, bb4, bb5
  bb5:  ; preds = bb1
    jump bb2
  bb2:  ; preds = bb5
    v7 = sload 0 !metadata(storage=slot(0))
    v8 = checked_mul uint256, v7, 2
    ret v8
  bb4:  ; preds = bb1
    v4 = sload 0 !metadata(storage=slot(0))
    v5 = checked_add uint256, v4, 1
    sstore 0, v5 !metadata(storage=slot(0))
    jump bb6
  bb6:  ; preds = bb4
    jump bb3
  bb3:  ; preds = bb6
    v6 = checked_add uint256, v2, 1
    jump bb1
}

; function straight(uint256 x) public returns (uint256) [selector 0x80dc868b]
fn @straight(arg0: i256) -> i256 [selector=0x80dc868b, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @bump, arg0
    v1 = checked_add uint256, v0, arg0
    ret v1
}

; function choose(uint256 a, uint256 b) internal returns (uint256)
fn @choose(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg0, 5
    jumpi v0, bb1, bb2
  bb2:  ; preds = bb0
    jump bb3
  bb3:  ; preds = bb2
    v2 = gt arg1, 5
    jumpi v2, bb4, bb5
  bb5:  ; preds = bb3
    jump bb6
  bb6:  ; preds = bb5
    ret 3
  bb4:  ; preds = bb3
    v3 = icall @bump, arg0
    ret 2
  bb1:  ; preds = bb0
    v1 = icall @bump, arg0
    ret 1
}

; function pair(uint256 a, uint256 b) public returns (uint256) [selector 0x9280bddf]
fn @pair(arg0: i256, arg1: i256) -> i256 [selector=0x9280bddf, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @choose, arg0, arg1
    v1 = checked_add uint256, v0, 10
    ret v1
}
