//@ revisions: gas size none
//@[gas] compile-flags: -Zmir-pipeline=none -Ogas
//@[size] compile-flags: -Zmir-pipeline=none -Osize
//@[none] compile-flags: -Zmir-pipeline=none -O none
@module Hotness

// A function whose only exit reverts is cold, and so are its blocks. The analysis recomputes
// every attribute, so `cold` survives a parse only where it is true.
fn @fail() [cold] {
  bb0 [cold]:
    revert 0, 0
}

// The analysis clears a `cold` function and block that return.
fn @wrong(arg0: i1) -> i256 [cold] {
  bb0:
    jumpi arg0, bb1, bb2
  bb1 [cold]:
    ret 1
  bb2:
    ret 2
}

// A call to a cold function aborts, so its block is cold.
fn @calls(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    icall @fail
    stop
  bb2:
    ret 2
}

// A block that only reaches a revert is cold in a build that propagates, and a loop with no path
// to a normal exit is cold only when the objective marks failure paths cold.
fn @failure_loop(arg0: i1, arg1: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb4
  bb1:
    jumpi arg1, bb2, bb3
  bb2:
    jump bb1
  bb3:
    jump bb5
  bb4:
    ret 1
  bb5:
    revert 0, 0
}
