+ ; === ROOT/tests/ui/codegen/mir/hotness/cold_hint_block.mir (after none) ===
  @module ColdHintBlock
  fn @bare(arg0: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2 [cold, cold_hint]:                          ; preds = bb0
      jump bb3
    bb1:                                            ; preds = bb0
      jump bb3
    bb3:                                            ; preds = bb1, bb2
      ret 1
  }
  
  fn @returns(arg0: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2 [cold, cold_hint]:                          ; preds = bb0
      ret 0
    bb1:                                            ; preds = bb0
      ret 1
  }
  
  fn @loop_body(arg0: i1, arg1: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2 [cold, cold_hint]:                          ; preds = bb0
      jump bb3
    bb3:                                            ; preds = bb2, bb4
      jumpi arg1, bb4, bb5
    bb5:                                            ; preds = bb3
      jump bb6
    bb4:                                            ; preds = bb3
      jump bb3
    bb1:                                            ; preds = bb0
      jump bb6
    bb6:                                            ; preds = bb1, bb5
      ret 1
  }
  
  fn @typed(arg0: i1, arg1: i1) -> i256 {
    bb0:
      jumpi arg0, bb1, bb2
    bb2 [cold, cold_hint]:                          ; preds = bb0
      jumpi arg1, bb3, bb4
    bb4 [cold, cold_hint]:                          ; preds = bb2
      jump bb5
    bb5 [cold]:                                     ; preds = bb4
      revert 0, 0
    bb3 [cold, cold_hint]:                          ; preds = bb2
      jump bb6
    bb1:                                            ; preds = bb0
      jump bb6
    bb6:                                            ; preds = bb1, bb3
      ret 1
  }
  
  fn @only_path(arg0: i1) -> i256 {
    bb0:
      jump bb1
    bb1 [cold, cold_hint]:                          ; preds = bb0
      jump bb2
    bb2:                                            ; preds = bb1
      ret 1
  }
  
