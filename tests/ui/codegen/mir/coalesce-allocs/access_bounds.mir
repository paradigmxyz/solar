//@compile-flags: -Zmir-pipeline=coalesce-allocs
//@filecheck:
@module CoalesceAccessBounds

// Computing the offset before the access does not invalidate the later proof: by the time the
// offset is used, the base has been accessed successfully and cannot be near the word limit.
// CHECK-LABEL: fn @access_before_use
// CHECK: + v0 = alloc 64
// CHECK: mstore v1, 1
// CHECK: mstore v2, 2
fn @access_before_use() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = add v1, 64
    mstore v1, 1
    mstore v2, 2
    v3 = alloc 32
    v4 = ptrtoint ptr<memory> v3 to i256
    ret v4
}

// The address may wrap onto the FMP before any successful access has bounded its base. An access
// after this store cannot justify moving the second allocation before the store.
// CHECK-LABEL: fn @access_after_use
// CHECK-NOT: +
fn @access_after_use() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = add v1, 64
    mstore v2, 2
    mstore v1, 1
    v3 = alloc 32
    v4 = ptrtoint ptr<memory> v3 to i256
    ret v4
}

// A zero-length access ignores its address and cannot prove that an offset will not wrap.
// CHECK-LABEL: fn @empty_access
// CHECK-NOT: +
fn @empty_access() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = add v1, 64
    calldatacopy v1, 0, 0
    mstore v2, 2
    v3 = alloc 32
    v4 = ptrtoint ptr<memory> v3 to i256
    ret v4
}

// Accessing a group member bounds later members too: only constant allocations advance the
// frontier, so their first access may initialize a field before initializing the first word.
// CHECK-LABEL: fn @later_member_field
// CHECK: + v0 = alloc 160
// CHECK: mstore v4, 2
// CHECK: - v5 = alloc 32
fn @later_member_field() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 1
    v2 = alloc 96
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 64
    mstore v4, 2
    v5 = alloc 32
    v6 = ptrtoint ptr<memory> v5 to i256
    ret v6
}

// An access to a later member cannot bound an earlier member: the bump between them could have
// wrapped. Keep the last allocation after the possibly wrapped store through the earlier member.
// CHECK-LABEL: fn @earlier_member_field
// CHECK: + v0 = alloc 128
// CHECK: mstore v4, 2
// CHECK: v5 = alloc 32
fn @earlier_member_field() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = alloc 96
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, 1
    v4 = add v1, 64
    mstore v4, 2
    v5 = alloc 32
    v6 = ptrtoint ptr<memory> v5 to i256
    ret v6
}

// A zero-length access cannot bound either its own base or a later allocation's base.
// CHECK-LABEL: fn @empty_access_before_later_member
// CHECK: + v0 = alloc 128
// CHECK: mstore v4, 2
// CHECK: v5 = alloc 32
fn @empty_access_before_later_member() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    calldatacopy v1, 0, 0
    v2 = alloc 96
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 64
    mstore v4, 2
    v5 = alloc 32
    v6 = ptrtoint ptr<memory> v5 to i256
    ret v6
}

// A safe later-member field still ends the group when rebasing its offset would require a wider
// immediate. Retain the compact initialization shape rather than extending the new proof.
// CHECK-LABEL: fn @keep_compact_field_offset
// CHECK: + v0 = alloc 480
// CHECK: mstore v4, 2
// CHECK: v5 = alloc 32
fn @keep_compact_field_offset() -> i256 {
  bb0:
    v0 = alloc 384
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 1
    v2 = alloc 96
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 64
    mstore v4, 2
    v5 = alloc 32
    v6 = ptrtoint ptr<memory> v5 to i256
    ret v6
}

// Publishing a member pointer outside the current group stops the additional forward proof.
// Existing members still coalesce, but do not extend that pointer's lifetime across the field.
// CHECK-LABEL: fn @published_member
// CHECK: + v0 = alloc 128
// CHECK: mstore 0, v1
// CHECK: mstore v4, 2
// CHECK: v5 = alloc 32
fn @published_member() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 1
    mstore 0, v1
    v2 = alloc 96
    v3 = ptrtoint ptr<memory> v2 to i256
    v4 = add v3, 64
    mstore v4, 2
    v5 = alloc 32
    v6 = ptrtoint ptr<memory> v5 to i256
    ret v6
}
