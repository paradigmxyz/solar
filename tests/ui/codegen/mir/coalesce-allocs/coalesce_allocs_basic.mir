//@compile-flags: -Zmir-pipeline=coalesce-allocs
//@filecheck:
@module CoalesceAllocsBasic
immutables:
  stored: u256

// Three consecutive constant-size allocations fuse into one bump of the
// summed size; later members become constant offsets from the fused base.
// Interleaved stores through heap pointers do not break the group.
// CHECK-LABEL: fn @fuse_consecutive
// CHECK: + v0 = alloc raw, exact, uninitialized, infallible, 160
// CHECK: + [[BASE64:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK: + [[OFFSET64:v[0-9]+]] = add [[BASE64]], 64
// CHECK: + [[POINTER64:v[0-9]+]] = inttoptr i256 [[OFFSET64]] to memptr
// CHECK: + [[BASE96:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK: + {{v[0-9]+}} = add [[BASE96]], 96
fn @fuse_consecutive() -> i256 {
  bb0:
    v4 = alloc raw, exact, uninitialized, infallible, 64
    v0 = ptrtoint memptr v4 to i256
    mstore v0, 1
    v5 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v5 to i256
    v6 = alloc raw, exact, uninitialized, infallible, 64
    v2 = ptrtoint memptr v6 to i256
    mstore v1, 2
    mstore v2, 3
    v3 = mload v1
    ret v3
}

// A fused zeroed group reserves the complete range once, but preserves each member's zeroing at
// its original program point. Checked allocations remain separate.
// CHECK-LABEL: fn @fuse_zeroed
// CHECK: + v0 = alloc raw, exact, uninitialized, infallible, 96
// CHECK-NEXT: + [[ZERO64:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK-NEXT: + memory_zero [[ZERO64]], 64
// CHECK: + [[BASE64:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK: + [[OFFSET64:v[0-9]+]] = add [[BASE64]], 64
// CHECK: + [[POINTER64:v[0-9]+]] = inttoptr i256 [[OFFSET64]] to memptr
// CHECK-NEXT: + [[ZERO_TAIL64:v[0-9]+]] = ptrtoint memptr [[POINTER64]] to i256
// CHECK-NEXT: + memory_zero [[ZERO_TAIL64]], 32
fn @fuse_zeroed() -> i256 {
  bb0:
    v7 = alloc raw, exact, zeroed, infallible, 64
    v0 = ptrtoint memptr v7 to i256
    v8 = alloc raw, exact, zeroed, infallible, 32
    v1 = ptrtoint memptr v8 to i256
    v2 = mload v1
    ret v2
}

// A write into a later member's future range must be erased by the zero initialization at that
// member's original allocation point, not survive an early whole-group zero.
// CHECK-LABEL: fn @preserve_zero_timing
// CHECK: + v0 = alloc raw, exact, uninitialized, infallible, 64
// CHECK-NEXT: + [[ZERO32:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK-NEXT: + memory_zero [[ZERO32]], 32
// CHECK: mstore 160, 7
// CHECK: + [[BASE32:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK: + [[OFFSET32:v[0-9]+]] = add [[BASE32]], 32
// CHECK: + [[POINTER32:v[0-9]+]] = inttoptr i256 [[OFFSET32]] to memptr
// CHECK-NEXT: + [[ZERO_TAIL32:v[0-9]+]] = ptrtoint memptr [[POINTER32]] to i256
// CHECK-NEXT: + memory_zero [[ZERO_TAIL32]], 32
fn @preserve_zero_timing() -> i256 {
  bb0:
    v9 = alloc raw, exact, zeroed, infallible, 32
    v0 = ptrtoint memptr v9 to i256
    mstore 160, 7
    v10 = alloc raw, exact, zeroed, infallible, 32
    v1 = ptrtoint memptr v10 to i256
    v2 = mload v1
    ret v2
}

// An arbitrary integer add containing a heap pointer can wrap to the FMP slot. It is not a proven
// heap address, so the write ends the allocation group and the second allocation observes it.
// CHECK-LABEL: fn @keep_across_wrapped_fmp
// CHECK-NOT: +
fn @keep_across_wrapped_fmp() -> i256 {
  bb0:
    v11 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v11 to i256
    v1 = sub 64, v0
    v2 = add v0, v1
    mstore v2, 65536
    v12 = alloc raw, exact, uninitialized, infallible, 32
    v3 = ptrtoint memptr v12 to i256
    ret v3
}

// Reading the free-memory pointer between two allocations observes the
// intermediate frontier, so the allocations on either side stay separate.
// A call may allocate in the callee, which is the same barrier.
// CHECK-LABEL: fn @keep_across_fmp
// CHECK-NOT: +
fn @keep_across_fmp() -> i256 {
  bb0:
    v13 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v13 to i256
    v14 = fmp
    v1 = ptrtoint memptr v14 to i256
    v15 = alloc raw, exact, uninitialized, infallible, 32
    v2 = ptrtoint memptr v15 to i256
    mstore v0, 1
    mstore v2, 2
    ret v1
}

// A store through the constant free-memory-pointer slot moves the frontier,
// so the second allocation must observe it and the group ends.
// CHECK-LABEL: fn @keep_across_constant_fmp_store
// CHECK-NOT: +
fn @keep_across_constant_fmp_store() -> i256 {
  bb0:
    v16 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v16 to i256
    mstore 64, 65536
    v17 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v17 to i256
    mstore v1, 4
    ret v1
}

// An explicit frontier update between two allocations is the same barrier.
// CHECK-LABEL: fn @keep_across_set_fmp
// CHECK-NOT: +
fn @keep_across_set_fmp() -> i256 {
  bb0:
    v18 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v18 to i256
    v100 = inttoptr i256 65536 to memptr
    set_fmp v100
    v19 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v19 to i256
    mstore v1, 5
    ret v1
}

// Checked zeroing and later allocation checks keep their original order.
// CHECK-LABEL: fn @keep_checked_zeroed
// CHECK-NOT: +
fn @keep_checked_zeroed() -> i256 {
  bb0:
    v20 = alloc raw, exact, zeroed, panic, 64
    v0 = ptrtoint memptr v20 to i256
    v21 = alloc raw, exact, zeroed, panic, 32
    v1 = ptrtoint memptr v21 to i256
    ret v1
}

// An infallible bump must not acquire a later member's panic check.
// CHECK-LABEL: fn @keep_mixed_failures
// CHECK-NOT: +
fn @keep_mixed_failures() -> i256 {
  bb0:
    v22 = alloc raw, exact, uninitialized, infallible, 64
    v0 = ptrtoint memptr v22 to i256
    v23 = alloc raw, exact, uninitialized, panic, 32
    v1 = ptrtoint memptr v23 to i256
    ret v1
}

// Control effects end a group even when the instruction has no memory effect.
// CHECK-LABEL: fn @keep_across_check
// CHECK-NOT: +
fn @keep_across_check(arg0: i256) -> i256 {
  bb0:
    v24 = alloc raw, exact, uninitialized, infallible, 64
    v0 = ptrtoint memptr v24 to i256
    v1 = checked_add u256, arg0, 1
    v25 = alloc raw, exact, uninitialized, infallible, 32
    v2 = ptrtoint memptr v25 to i256
    ret v1
}

// Immutable initialization does not move or observe the allocation frontier.
// CHECK-LABEL: fn @across_immutable
// CHECK: + v0 = alloc raw, exact, uninitialized, infallible, 64
// CHECK: storeimmutable stored, 7
// CHECK: + [[BASE32:v[0-9]+]] = ptrtoint memptr v0 to i256
// CHECK: + [[OFFSET32:v[0-9]+]] = add [[BASE32]], 32
// CHECK: + [[POINTER32:v[0-9]+]] = inttoptr i256 [[OFFSET32]] to memptr
fn @across_immutable() -> i256 {
  bb0:
    v26 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v26 to i256
    mstore v0, 42
    storeimmutable stored, 7
    v27 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v27 to i256
    ret v1
}
