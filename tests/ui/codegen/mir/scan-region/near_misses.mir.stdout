; function toUint(bool b) internal pure returns (uint256 u)
fn @toUint(arg0: i1) -> i256 [pure] {
  bb0:
    v0 = zext i1 arg0 to i256
    v1 = eq v0, 0
    v2 = zext i1 v1 to i256
    v3 = eq v2, 0
    v4 = zext i1 v3 to i256
    ret v4
}

