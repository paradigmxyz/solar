      revert v0, 32
  }
  
  fn @calls_lower(arg0: i256) [abi_wrapper] {
    bb0:
      icall @lower, arg0
      mstore 0, 1
      v0 = mload 64
      revert v0, 32
  }
  
  fn @shared() {
    bb0:
      mstore 0, 1
      v0 = mload 64
      revert v0, 32
  }
  
  fn @untrusted_caller(arg0: i256) [abi_wrapper] {
    bb0:
      mstore 64, arg0
      tail_call @shared
  }
  
  fn @trusted_caller() [abi_wrapper] {
    bb0:
      tail_call @shared
  }
  
  fn @trusted_only() {
