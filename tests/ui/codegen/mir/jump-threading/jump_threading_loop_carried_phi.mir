//@compile-flags: -Zmir-pipeline=jump-threading
//@filecheck:
@module JumpThreadingLoopCarriedPhi
// A loop header whose own phi carries one of its results around the back edge
// keeps its entry edge: entering the body directly would reach the latch
// without defining the carried value.
// CHECK-LABEL: {{^[ +].*}}fn @carried_header_result{{[( ]}}
// CHECK: {{^ +}}bb0:
// CHECK-NEXT: {{^ +jump bb1$}}
fn @carried_header_result(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v3]
    v2 = eq v1, 0
    jumpi v2, bb2, bb4
  bb2:
    jump bb3
  bb3:
    v3 = add 0, 1
    jump bb1
  bb4:
    ret 0
}
