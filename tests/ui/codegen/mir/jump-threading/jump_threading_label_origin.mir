//@ compile-flags: -Zmir-pipeline=jump-threading
//@ filecheck:
@module ThreadingLabelOrigin

// The edge into the empty `for` exit label now enters the target directly. The target was entered
// only through that forwarder, so its label takes the forwarder's origin, the `for`, and not the
// code it was inlined from.
// CHECK-LABEL: {{^[ +].*}}fn @only_entry{{[( ]}}
// CHECK: jumpi arg0, bb1, bb3
// CHECK: + bb3 !metadata(span=10..20):
fn @only_entry(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    ret 1
  bb2 !metadata(span=10..20):
    jump bb3
  bb3 !metadata(span=100..110):
    ret 2
}

// The target has another entry, which still runs the code the target was inlined from, so its
// label becomes the union of both origins.
// CHECK-LABEL: {{^[ +].*}}fn @other_entry{{[( ]}}
// CHECK: + bb3 !metadata(spans=[100..110, 10..20])
fn @other_entry(arg0: i1, arg1: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jumpi arg1, bb3, bb4
  bb2 !metadata(span=10..20):
    jump bb3
  bb3 !metadata(span=100..110):
    ret 2
  bb4:
    ret 3
}
