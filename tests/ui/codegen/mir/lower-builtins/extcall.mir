//@ revisions: cancun spuriousDragon homestead
//@[cancun] compile-flags: --evm-version cancun -Zmir-pipeline=lower-builtins
//@[spuriousDragon] compile-flags: --evm-version spuriousDragon -Zmir-pipeline=lower-builtins
//@[homestead] compile-flags: --evm-version homestead -Zmir-pipeline=lower-builtins
//@[cancun] filecheck: --check-prefixes=CHECK,CANCUN
//@[spuriousDragon] filecheck: --check-prefixes=CHECK,SPURIOUS
//@[homestead] filecheck: --check-prefixes=CHECK,HOMESTEAD
@module AddressCallExpansion

// A precompile reads a bytes object at its payload and lands its word in scratch memory. A failure
// forwards the returndata.
// CHECK-LABEL: fn @hash_object
// CHECK: [[DATA:v[0-9]+]] = ptradd arg0, 32
// CHECK: [[LEN:v[0-9]+]] = mload arg0
// CANCUN: [[GAS:v[0-9]+]] = gas
// CANCUN: [[OK:v[0-9]+]] = staticcall [[GAS]], 2, [[DATA]], [[LEN]], 0, 32
// SPURIOUS: [[GAS:v[0-9]+]] = gas
// SPURIOUS: [[OK:v[0-9]+]] = call [[GAS]], 2, 0, [[DATA]], [[LEN]], 0, 32
// HOMESTEAD: [[GAS:v[0-9]+]] = gas
// HOMESTEAD: [[RESERVED:v[0-9]+]] = sub [[GAS]], 0x61da
// HOMESTEAD: [[OK:v[0-9]+]] = call [[RESERVED]], 2, 0, [[DATA]], [[LEN]], 0, 32
// CHECK: jumpi [[OK]], bb2, bb1
// CHECK: bb1 [cold]:
// CHECK-NEXT: revert_returndata
// CHECK: bb2:
// CHECK-NEXT: [[WORD:v[0-9]+]] = mload 0
// CHECK-NEXT: ret [[WORD]]
fn @hash_object(arg0: ptr<memory>) -> i256 {
  bb0:
    v0 = extstaticcall<scratch, revert, create> i160 2, arg0
    ret v0
}

// A slice is read where it lies, with its own pointer and length.
// CHECK-LABEL: fn @hash_slice
// CHECK: [[PTR:v[0-9]+]] = extract_value slice<memory>, arg0, 0
// CHECK-NEXT: [[SIZE:v[0-9]+]] = extract_value slice<memory>, arg0, 1
// CHECK: {{call|staticcall}} {{v[0-9]+}}, 3, {{(0, )?}}[[PTR]], [[SIZE]], 0, 32
// CHECK: mload 0
fn @hash_slice(arg0: slice<memory>) -> i256 {
  bb0:
    v0 = extstaticcall<scratch, revert, create> i160 3, arg0
    ret v0
}

// A call that a failed callee leaves without data clears the output word before it, and the
// clear precedes the gas read.
// CHECK-LABEL: fn @recover
// CHECK: mstore 0, 0
// CHECK-NEXT: = gas
// CHECK: {{call|staticcall}} {{v[0-9]+}}, 1, {{(0, )?}}{{v[0-9]+}}, {{v[0-9]+}}, 0, 32
// CHECK: mload 0
fn @recover(arg0: slice<memory>) -> i256 {
  bb0:
    v0 = extstaticcall<scratch_clear, revert, create> i160 1, arg0
    ret v0
}

// A send has no bytes and no output, and returns the success flag.
// CHECK-LABEL: fn @send
// CHECK: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// CHECK-NEXT: [[SENT:v[0-9]+]] = call arg2, [[ADDRESS]], arg1, 0, 0, 0, 0
// CHECK-NEXT: ret [[SENT]]
fn @send(arg0: i160, arg1: i256, arg2: i256) -> i1 {
  bb0:
    v0 = extcall<> arg0, gas arg2, value arg1
    ret v0
}

// A transfer forwards the returndata of a failed call.
// CHECK-LABEL: fn @transfer
// CHECK: [[OK:v[0-9]+]] = call arg2, {{v[0-9]+}}, arg1, 0, 0, 0, 0
// CHECK-NEXT: jumpi [[OK]], bb2, bb1
// CHECK: bb1 [cold]:
// CHECK-NEXT: revert_returndata
fn @transfer(arg0: i160, arg1: i256, arg2: i256) {
  bb0:
    extcall<revert> arg0, gas arg2, value arg1
    ret
}

// Before EIP-150 a low-level call withholds the cost of the call, of the value it sends, and of
// creating the callee's account, which no code check guards.
// CHECK-LABEL: fn @bare_with_value
// CANCUN: [[GAS:v[0-9]+]] = gas
// CANCUN-NEXT: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// CANCUN-NEXT: call [[GAS]], [[ADDRESS]], arg2,
// SPURIOUS: [[GAS:v[0-9]+]] = gas
// SPURIOUS-NEXT: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// SPURIOUS-NEXT: call [[GAS]], [[ADDRESS]], arg2,
// HOMESTEAD: [[GAS:v[0-9]+]] = gas
// HOMESTEAD-NEXT: [[RESERVED:v[0-9]+]] = sub [[GAS]], 0x8502
// HOMESTEAD-NEXT: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// HOMESTEAD-NEXT: call [[RESERVED]], [[ADDRESS]], arg2,
fn @bare_with_value(arg0: i160, arg1: ptr<memory>, arg2: i256) -> i1 {
  bb0:
    v0 = extcall<create> arg0, arg1, value arg2
    ret v0
}

// A delegatecall sends no value, so it withholds the cost of the call and of account creation.
// CHECK-LABEL: fn @bare_delegate
// CANCUN: [[GAS:v[0-9]+]] = gas
// CANCUN-NEXT: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// CANCUN-NEXT: delegatecall [[GAS]], [[ADDRESS]],
// SPURIOUS: [[GAS:v[0-9]+]] = gas
// SPURIOUS-NEXT: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// SPURIOUS-NEXT: delegatecall [[GAS]], [[ADDRESS]],
// HOMESTEAD: [[GAS:v[0-9]+]] = gas
// HOMESTEAD-NEXT: [[RESERVED:v[0-9]+]] = sub [[GAS]], 0x61da
// HOMESTEAD-NEXT: [[ADDRESS:v[0-9]+]] = zext i160 arg0 to i256
// HOMESTEAD-NEXT: delegatecall [[RESERVED]], [[ADDRESS]],
fn @bare_delegate(arg0: i160, arg1: ptr<memory>) -> i1 {
  bb0:
    v0 = extdelegatecall<create> arg0, arg1
    ret v0
}
