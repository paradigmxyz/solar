//@ compile-flags: -Zmir-pipeline=lower-builtins
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
@module PrecompileMemorySlice

// The existing object and slice accessors project a headerless hash input directly.
// CHECK-LABEL: fn @sha(
// CHECK-NOT: alloc
// CHECK: extract_value slice<memory>, arg0, 0
// CHECK: extract_value slice<memory>, arg0, 1
// CHECK: staticcall {{v[0-9]+}}, 2, {{v[0-9]+}}, {{v[0-9]+}}, 0, 32
fn @sha(arg0: slice<memory>) -> i256 {
  bb0:
    v0 = extcall static word revert i160 2, arg0
    ret v0
}

// CHECK-LABEL: fn @ripemd(
// CHECK-NOT: alloc
// CHECK: staticcall {{v[0-9]+}}, 3, {{v[0-9]+}}, {{v[0-9]+}}, 0, 32
fn @ripemd(arg0: slice<memory>) -> i256 {
  bb0:
    v0 = extcall static word revert i160 3, arg0
    ret v0
}
