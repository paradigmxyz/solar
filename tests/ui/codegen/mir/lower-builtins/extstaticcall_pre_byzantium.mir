//@ compile-flags: --evm-version homestead -Zmir-pipeline=lower-builtins
@module StaticCallWithoutStaticCall

// Only a call of a precompile, whose callee keeps no state, can fall back to `CALL`.
//~? ERROR: `extstaticcall` of a callee that is not a precompile needs `STATICCALL`
fn @arbitrary(arg0: i160, arg1: ptr<memory>) -> i256 {
  bb0:
    v0 = extstaticcall<scratch, revert, create> arg0, arg1
    ret v0
}
