- // === ROOT/tests/ui/codegen/mir/inline-immutable-leaves/leaves.mir (before inline-immutable-leaves) ===
+ // === ROOT/tests/ui/codegen/mir/inline-immutable-leaves/leaves.mir (after inline-immutable-leaves) ===
  @module ImmutableLeaves
  immutables:
    start: u64
    duration: u64
    initial: u256
  
  fn @entry() -> i256 [selector=0x00000001] {
    bb0:
      v0 = icall @end
      v1 = icall @memory
      v2 = icall @ordinary
      v3 = icall @argument, v0
      v4 = add v0, v1
      v5 = add v2, v3
      v6 = add v4, v5
      ret v6
  }
  
  fn @constructor(arg0: i256, arg1: i256) [constructor] {
    bb0:
      v0 = trunc i256 arg0 to i64
      storeimmutable start, v0
      v1 = trunc i256 arg1 to i64
      storeimmutable duration, v1
      v2 = icall @end
      storeimmutable initial, v2
      stop
  }
  
  fn @end() -> i256 {
    bb0:
      v0 = loadimmutable start
      v1 = zext i64 v0 to i256
      v2 = loadimmutable duration
      v3 = zext i64 v2 to i256
      v4 = add v1, v3
      ret v4
  }
  
  fn @memory() -> i256 {
    bb0:
      v0 = mload 0
      v1 = loadimmutable start
      v2 = zext i64 v1 to i256
      v3 = add v0, v2
      ret v3
  }
  
  fn @ordinary() -> i256 {
    bb0:
      v0 = add 1, 2
      ret v0
  }
  
  fn @argument(arg0: i256) -> i256 {
    bb0:
      v0 = loadimmutable start
      v1 = zext i64 v0 to i256
      v2 = add v1, arg0
      ret v2
  }
  
