  @module ImmutableLeaves
  immutables:
    start: u64
    duration: u64
    initial: u256
  
  fn @entry() -> u256 [selector=0x00000001] {
    bb0:
      v7 = loadimmutable start
      v8 = loadimmutable duration
      v9 = add v7, v8
      v1 = icall @memory, 1
      v2 = icall @ordinary, 1
      v3 = icall @argument, 1, v9
      v4 = add v9, v1
      v5 = add v2, v3
      v6 = add v4, v5
      ret v6
  }
  
  fn @constructor(arg0: u64, arg1: u64) [constructor] {
    bb0:
      storeimmutable start, arg0
      storeimmutable duration, arg1
      v1 = loadimmutable start
      v2 = loadimmutable duration
      v3 = add v1, v2
      storeimmutable initial, v3
      stop
  }
  
  fn @end() -> u256 {
    bb0:
      v0 = loadimmutable start
      v1 = loadimmutable duration
      v2 = add v0, v1
      ret v2
  }
  
  fn @memory() -> u256 {
    bb0:
      v0 = mload 0
      v1 = loadimmutable start
      v2 = add v0, v1
      ret v2
  }
  
  fn @ordinary() -> u256 {
    bb0:
      v0 = add 1, 2
      ret v0
  }
  
  fn @argument(arg0: u256) -> u256 {
    bb0:
      v0 = loadimmutable start
      v1 = add v0, arg0
      ret v1
