//@ run-call: copy(uint256)(uint256) 5 => 5
//@ run-call: copy(uint256)(uint256) 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff => 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// An `assign` copies its operand: an immediate, which nothing folds, and a calldata word.
@module Assign
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb2, [0x8370392c => bb1]
  bb1:
    tail_call @copy
  bb2:
    revert 0, 0
}

fn @copy() {
  bb0:
    v0 = calldataload 4
    v1 = assign v0
    v2 = assign 0
    v3 = add v1, v2
    mstore 0, v3
    returndata 0, 32
}
