//@ revisions: none gas size
//@ compile-flags: --evm-version=osaka
//@[none] compile-flags: -Onone
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@ run-call: identity(uint256)(uint256) 0 => 0
//@ run-call: identity(uint256)(uint256) 123 => 123
//@ run-call: identity(uint256)(uint256) 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff => 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// The graph-construction plugin emits this shape. Native loading is checked by integration
// tests; this fixture checks the helpers through both MIR interpretation and assembled bytecode.
@module PluginHelpers
@phase lowered

fn @entry() [entry] {
  bb0:
    v0 = calldataload 4
    jump bb1
  bb1:
    v1 = icall @helper, v0
    mstore 0, v1
    returndata 0, 32
}

fn @helper(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: arg0], [bb2: arg0]
    v2 = icall @leaf, v1
    jump bb4
  bb4:
    ret v2
}

fn @leaf(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, 2
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    ret arg0
}
