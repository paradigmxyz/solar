//@ revisions: none gas size
//@[none] compile-flags: -O none
//@[gas] compile-flags: -O gas
//@[size] compile-flags: -O size
//@ run-call: divmod(uint256,uint256)(uint256,uint256) 17, 5 => 3, 2
//@ run-call: allocation()(uint256) => 1
// The dispatch entry comes last here, but final MIR prints it first. The backend memory records
// must name functions as the dump prints them, so they stay with their functions when the dump
// is parsed back.
@module FunctionOrder
@phase lowered

fn @quot_rem(arg0: i256, arg1: i256) [return_abi=[i256, i256]] {
  bb0:
    v0 = div arg0, arg1
    v1 = mod arg0, arg1
    ret v0, v1
}

fn @divmod() {
  bb0:
    v900 = calldataload 4
    v901 = calldataload 36
    v0 = icall @quot_rem, v900, v901
    v1 = mload 32
    v2 = add v1, 32
    v3 = mload v2
    mstore 0, v0
    mstore 32, v3
    returndata 0, 64
}

fn @allocation() {
  bb0:
    v0 = alloc 64 !metadata(deferred_alloc)
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = lt v1, 0x100000
    v3 = zext i1 v2 to i256
    mstore 0, v3
    returndata 0, 32
}

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb3, [0x8efe1b6c => bb1, 0x88a17bde => bb2]
  bb1:
    tail_call @divmod
  bb2:
    tail_call @allocation
  bb3:
    revert 0, 0
}
