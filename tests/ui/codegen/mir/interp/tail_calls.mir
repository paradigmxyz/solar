//@ revisions: none gas size
//@[none] compile-flags: -O none
//@[gas] compile-flags: -O gas
//@[size] compile-flags: -O size
//@ run-call: twice(uint256)(uint256) 21 => 84
//@ run-call: divmod(uint256,uint256)(uint256,uint256,uint256,uint256) 17, 5 => 3, 2, 17, 5
//@ run-call: factorial(uint256)(uint256) 10 => 3628800
// Returning tail calls forward results and discard unused arguments.
@module TailCalls
@phase lowered
@types
  struct0: {i256, i256, i256, i256}

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb4, [0x3cf3bbf4 => bb1, 0x8efe1b6c => bb2, 0x83714834 => bb3]
  bb1:
    tail_call @twice
  bb2:
    tail_call @divmod
  bb3:
    tail_call @factorial
  bb4:
    revert 0, 0
}

fn @twice() [selector=0x3cf3bbf4, abi_wrapper] {
  bb0:
    v0 = icall @drop_args, arg0, 11, 22, 33
    mstore 0, v0
    returndata 0, 32
}

fn @drop_args(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> i256 {
  bb0:
    tail_call @chains, arg0
}

fn @chains(arg0: i256) -> i256 {
  bb0:
    v0 = icall @double, arg0
    tail_call @forwards, v0
}

fn @forwards(arg0: i256) -> i256 {
  bb0:
    tail_call @double, arg0
}

fn @double(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, arg0
    ret v0
}

fn @divmod() [selector=0x8efe1b6c, abi_wrapper] {
  bb0:
    v0 = icall @forward_four, arg0, arg1
    v1 = mload 32
    v2 = add v1, 32
    v3 = mload v2
    v4 = add v1, 64
    v5 = mload v4
    v6 = add v1, 96
    v7 = mload v6
    mstore 0, v0
    mstore 32, v3
    mstore 64, v5
    mstore 96, v7
    returndata 0, 128
}

fn @forward_four(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256, i256, i256]] {
  bb0:
    tail_call @four, arg0, arg1
}

fn @four(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256, i256, i256]] {
  bb0:
    v0 = div arg0, arg1
    v1 = mod arg0, arg1
    ret v0, v1, arg0, arg1
}

fn @factorial() [selector=0x83714834, abi_wrapper] {
  bb0:
    v0 = icall @fact_route, arg0
    mstore 0, v0
    returndata 0, 32
}

fn @fact_route(arg0: i256) -> i256 {
  bb0:
    tail_call @fact, arg0
}

fn @fact(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    ret 1
  bb2:
    v1 = sub arg0, 1
    v2 = icall @fact, v1
    v3 = mul arg0, v2
    ret v3
}
