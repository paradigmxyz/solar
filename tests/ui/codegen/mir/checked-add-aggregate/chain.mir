//@ compile-flags: -Zmir-pipeline=outline-reverts,checked-add-aggregate
//@ filecheck:
@module CheckedAddAggregate

// CHECK-LABEL: after checked-add-aggregate
// CHECK-LABEL: {{^[ +].*}}fn @across_blocks{{[( ]}}
// CHECK: - jumpi [[CARRY1:v[0-9]+]], bb1, bb2
// CHECK: + jump bb2
// CHECK: + [[ANY:v[0-9]+]] = or [[CARRY1]], [[CARRY2:v[0-9]+]]
// CHECK: + jumpi [[ANY]], bb3, bb4
fn @across_blocks(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v3 = add arg0, arg1
    v4 = lt v3, arg0
    jumpi v4, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    v5 = add v3, arg2
    v6 = lt v5, v3
    jumpi v6, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb4:
    ret v5
}

// A non-add instruction between checks is an effect barrier for this initial pass.
// CHECK-LABEL: {{^[ +].*}}fn @keep_effect_boundary{{[( ]}}
// CHECK: {{^[ +].*}}jumpi {{v[0-9]+}}, bb1, bb2
fn @keep_effect_boundary(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v3 = add arg0, arg1
    v4 = lt v3, arg0
    jumpi v4, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    mstore 0, v3
    v5 = add v3, arg2
    v6 = lt v5, v3
    jumpi v6, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb4:
    ret v5
}

// Matching arithmetic and control flow must not be aggregated when the shared
// target is not the canonical arithmetic panic.
fn @keep_non_panic_target(arg0: u256, arg1: u256, arg2: u256) -> u256 {
  bb0:
    v3 = add arg0, arg1
    v4 = lt v3, arg0
    jumpi v4, bb1, bb2
  bb1:
    ret 7
  bb2:
    v5 = add v3, arg2
    v6 = lt v5, v3
    jumpi v6, bb1, bb3
  bb3:
    ret v5
}
