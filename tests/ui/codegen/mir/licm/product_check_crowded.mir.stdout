    jump bb2
  bb2:
    v18 = checked_add uint256, v0, v7
    v19 = checked_add uint256, v18, v2
    v20 = checked_add uint256, v19, v3
    v21 = checked_add uint256, v20, v4
    ret v21
  bb4:
    v10 = checked_mul uint256, v0, v1
    v11 = checked_add uint256, v10, 1
    v12 = xor v2, v8
    v13 = checked_add uint256, v7, v12
    v14 = checked_add uint256, v3, v8
