@module ProductCheckCrowded
fn @crowded(arg0: i256, arg1: i256, arg2: i256, arg3: i256, arg4: i256, arg5: i256) -> i256 [selector=0xf6f9e3a3, pure, abi_params=[uint256, uint256, uint256, uint256, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v11]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: arg2], [bb3: v14]
    v3 = phi [bb0: arg3], [bb3: v15]
    v4 = phi [bb0: arg4], [bb3: v16]
    v5 = phi [bb0: arg5], [bb3: v5]
    v6 = phi [bb0: 0], [bb3: v6]
    v7 = phi [bb0: 0], [bb3: v13]
    v8 = phi [bb0: 0], [bb3: v17]
