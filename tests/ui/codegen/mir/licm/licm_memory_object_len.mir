//@compile-flags: -Zmir-pipeline=licm
//@filecheck:
@module LicmMemoryObjectLen

// An unbounded element index can wrap into the length word. Keep its load in the loop.
// CHECK-LABEL: @keep_len_over_element_stores
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload arg0
fn @keep_len_over_element_stores(arg0: ptr<memory>) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = mload arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    v109 = shl v0, 5
    v9001 = ptradd arg0, 32
    v9002 = ptradd v9001, v109
    mstore v9002, v0
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// Byte indices can wrap too when assembly forges the length.
// CHECK-LABEL: @keep_len_over_byte_stores
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload arg0
fn @keep_len_over_byte_stores(arg0: ptr<memory>) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = mload arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    v9001 = ptradd arg0, 32
    v9002 = ptradd v9001, v0
    mstore8 v9002, 65
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// Resizing the object inside the loop rewrites the header word.
// CHECK-LABEL: @keep_len_when_loop_resizes
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload arg0
fn @keep_len_when_loop_resizes(arg0: ptr<memory>) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = mload arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    v5 = ptrtoint ptr<memory> arg0 to i256
    mstore v5, v0
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// A raw store to an unknown address may reach the header word.
// CHECK-LABEL: @keep_len_under_unknown_store
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload arg0
fn @keep_len_under_unknown_store(arg0: ptr<memory>, arg1: i256) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = mload arg0
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    mstore arg1, v0
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// A store to a fresh allocation may overwrite a fabricated argument header.
// CHECK-LABEL: @hoist_len_over_pure_call
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload arg0
fn @hoist_len_over_pure_call(arg0: ptr<memory>) -> ptr<memory> {
  bb0:
    v0 = alloc 64
    v9 = ptrtoint ptr<memory> v0 to i256
    mstore v9, 32
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v7]
    v2 = mload arg0
    v3 = lt v1, v2
    jumpi v3, bb2, bb3
  bb2:
    v9001 = ptradd arg0, 32
    v9002 = ptradd v9001, v1
    v9003 = mload v9002
    v4 = byte 0, v9003
    v5 = icall @mask_low, v4
    v9004 = ptradd v0, 32
    v9005 = ptradd v9004, v1
    mstore8 v9005, v5
    v7 = add v1, 1
    jump bb1
  bb3:
    ret v0
}
fn @mask_low(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 31
    ret v0
}

// A zero-trip loop must not read an arbitrary nominal object's header.
// CHECK-LABEL: @keep_unexecuted_header
// CHECK: {{^ +}}bb2:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = mload arg0
fn @keep_unexecuted_header(arg0: ptr<memory>, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v2]
    v4 = lt v0, arg1
    jumpi v4, bb2, bb3
  bb2:
    v2 = mload arg0
    v3 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// The helper observes memory before the guaranteed header read in each iteration.
// CHECK-LABEL: @keep_header_after_size_call
// CHECK: {{^ +}}bb1:
// CHECK: {{^ +}}v1 = icall @observe_size
// CHECK-NEXT: {{^ +}}v2 = mload arg0
fn @keep_header_after_size_call(arg0: ptr<memory>, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb1: v4]
    v1 = icall @observe_size
    v2 = mload arg0
    v3 = add v1, v2
    v4 = add v0, 1
    v5 = lt v4, arg1
    jumpi v5, bb1, bb2
  bb2:
    ret v3
}

fn @observe_size() -> i256 {
  bb0:
    v0 = msize
    ret v0
}
