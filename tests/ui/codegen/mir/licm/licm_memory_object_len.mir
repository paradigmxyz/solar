//@compile-flags: -Zmir-pipeline=licm
//@filecheck:
@module LicmMemoryObjectLen

// Element stores with a runtime index address the payload after the length
// word, so the length read is loop-invariant and moves to the preheader.
// CHECK-LABEL: @hoist_len_over_element_stores
// CHECK: +     [[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT: +     [[LEN:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT: {{^ +}}jump [[HEADER:bb[0-9]+]]
// CHECK: {{^ +}}[[HEADER]]:
// CHECK: -     [[VIEW]] = memory_slice arg0
// CHECK-NEXT: -     [[LEN]] = slice_len [[VIEW]]
fn @hoist_len_over_element_stores(arg0: memptr) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v4 = memory_slice arg0
    v1 = slice_len v4
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    slice_store_element v4, v0, v0
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// Byte stores also stay inside the payload of a bytes object.
// CHECK-LABEL: @hoist_len_over_byte_stores
// CHECK: +     [[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT: +     [[LEN:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT: {{^ +}}jump [[HEADER:bb[0-9]+]]
// CHECK: {{^ +}}[[HEADER]]:
// CHECK: -     [[VIEW]] = memory_slice arg0
// CHECK-NEXT: -     [[LEN]] = slice_len [[VIEW]]
fn @hoist_len_over_byte_stores(arg0: memptr) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v4 = memory_slice arg0
    v1 = slice_len v4
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    slice_store_byte v4, v0, 65
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// Resizing the object inside the loop rewrites the header word.
// CHECK-LABEL: @keep_len_when_loop_resizes
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}[[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = slice_len [[VIEW]]
fn @keep_len_when_loop_resizes(arg0: memptr) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v4 = memory_slice arg0
    v1 = slice_len v4
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    v5 = ptrtoint memptr arg0 to i256
    mstore v5, v0
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// A raw store to an unknown address may reach the header word.
// CHECK-LABEL: @keep_len_under_unknown_store
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}[[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = slice_len [[VIEW]]
fn @keep_len_under_unknown_store(arg0: memptr, arg1: i256) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v4 = memory_slice arg0
    v1 = slice_len v4
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    mstore arg1, v0
    v3 = add v0, 1
    jump bb1
  bb3:
    stop
}

// A store to a fresh allocation may overwrite a fabricated argument header.
// CHECK-LABEL: @hoist_len_over_pure_call
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = phi
// CHECK-NEXT: {{^ +}}[[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = slice_len [[VIEW]]
fn @hoist_len_over_pure_call(arg0: memptr) -> memptr {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v9 = ptrtoint memptr v0 to i256
    mstore v9, 32
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v7]
    v8 = memory_slice arg0
    v2 = slice_len v8
    v3 = lt v1, v2
    jumpi v3, bb2, bb3
  bb2:
    v4 = slice_load_byte v8, v1
    v5 = icall @mask_low, v4
    v6 = memory_slice v0
    slice_store_byte v6, v1, v5
    v7 = add v1, 1
    jump bb1
  bb3:
    ret v0
}
fn @mask_low(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 31
    ret v0
}

// A zero-trip loop must not read an arbitrary nominal object's header.
// CHECK-LABEL: @keep_unexecuted_header
// CHECK: {{^ +}}bb2:
// CHECK-NEXT: {{^ +}}[[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = slice_len [[VIEW]]
fn @keep_unexecuted_header(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v2]
    v4 = lt v0, arg1
    jumpi v4, bb2, bb3
  bb2:
    v5 = memory_slice arg0
    v2 = slice_len v5
    v3 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// The helper observes memory before the guaranteed header read in each iteration.
// CHECK-LABEL: @keep_header_after_size_call
// CHECK: {{^ +}}bb1:
// CHECK: {{^ +}}v1 = icall @observe_size
// CHECK-NEXT: {{^ +}}v2 = memory_slice arg0
// CHECK-NEXT: {{^ +}}v3 = slice_len v2
fn @keep_header_after_size_call(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb1: v4]
    v1 = icall @observe_size
    v6 = memory_slice arg0
    v2 = slice_len v6
    v3 = add v1, v2
    v4 = add v0, 1
    v5 = lt v4, arg1
    jumpi v5, bb1, bb2
  bb2:
    ret v3
}

fn @observe_size() -> i256 {
  bb0:
    v0 = msize
    ret v0
}
