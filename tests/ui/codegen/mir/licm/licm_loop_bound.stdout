- // === ROOT/tests/ui/codegen/mir/licm/licm_loop_bound.mir (before licm) ===
+ // === ROOT/tests/ui/codegen/mir/licm/licm_loop_bound.mir (after licm) ===
  @module LicmLoopBound
  fn @keep_mload_non_exiting_bound() -> u256 {
    bb0:
      jump bb1
    bb1:
      v0 = phi [bb0: 0], [bb4: v3]
      v1 = phi [bb0: 0], [bb4: v6]
      v2 = eq v1, 100
      jumpi v2, bb5, bb2
    bb2:
      v3 = mload 64
      v4 = mul v1, 32
      mstore v4, 1
      v5 = lt v1, 2
      jumpi v5, bb3, bb4
    bb3:
      jump bb4
    bb4:
      v6 = add v1, 1
      jump bb1
    bb5:
      ret v0
  }
  
  fn @keep_mload_inner_branch_bound() -> u256 {
    bb0:
      jump bb1
    bb1:
      v0 = phi [bb0: 0], [bb4: v3]
      v1 = phi [bb0: 0], [bb4: v6]
      v2 = lt v1, 100
      jumpi v2, bb2, bb5
    bb5:
      ret v0
    bb2:
      v3 = mload 64
      v4 = mul v1, 32
      mstore v4, 1
      v5 = lt v1, 2
      jumpi v5, bb3, bb4
    bb3:
      jump bb4
    bb4:
      v6 = add v1, 1
      jump bb1
  }
  
