//@compile-flags: -Ogas -Zmir-pipeline=licm
//@filecheck: --enable-var-scope
@module LicmInvariantOffsets

// An element address `(base + (i << 5)) + 32` at an index no affine recurrence
// describes becomes `t + (i << 5)`, with `t = base + 32` computed once before
// the loop. Both the loop's read and the write after it use `t`, so `base` is
// read nowhere else and `t` takes over its word.
// CHECK-LABEL: @element_offsets
// CHECK: {{^ +}}[[BASE:v[0-9]+]] = mload 64
// CHECK: +     [[T:v[0-9]+]] = add [[BASE]], 32
// CHECK: -     {{v[0-9]+}} = add [[BASE]], {{v[0-9]+}}
// CHECK: -     [[ADDR:v[0-9]+]] = add {{v[0-9]+}}, 32
// CHECK: +     [[ADDR]] = add [[T]], {{v[0-9]+}}
// CHECK: -     [[LAST:v[0-9]+]] = add {{v[0-9]+}}, 32
// CHECK: +     [[LAST]] = add [[T]], {{v[0-9]+}}
fn @element_offsets(arg0: i256) {
  bb0:
    v0 = mload 64
    jump bb1
  bb1:
    v1 = phi [bb0: 1], [bb2: v8]
    v2 = lt v1, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl v1, 5
    v4 = add v0, v3
    v5 = add v4, 32
    v6 = mload v5
    v7 = shl v1, 1
    v8 = or v7, v6
    jump bb1
  bb3:
    v9 = shl v1, 5
    v10 = add v0, v9
    v11 = add v10, 32
    mstore v11, 0
    stop
}

// A base read after the loop stays live through it, so `t` would make the loop
// carry one more word: the sums stay.
// CHECK-LABEL: @base_read_later
// CHECK-NOT: +
// CHECK-LABEL: @end
fn @base_read_later(arg0: i256) {
  bb0:
    v0 = mload 64
    jump bb1
  bb1:
    v1 = phi [bb0: 1], [bb2: v8]
    v2 = lt v1, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl v1, 5
    v4 = add v0, v3
    v5 = add v4, 32
    v6 = mload v5
    v7 = shl v1, 1
    v8 = or v7, v6
    jump bb1
  bb3:
    mstore v0, v1
    stop
}

fn @end() {
  bb0:
    stop
}
