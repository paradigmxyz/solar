//@compile-flags: -Zmir-pipeline=licm
//@filecheck:
@module LicmZeroTrip

// The bound is unknown, so the loop may run zero times: speculating the sload
// into the always-executed preheader is a pure gas pessimization.
// CHECK-LABEL: {{^[ +].*}}fn @keep_sload_zero_trip{{[( ]}}
// CHECK: {{^[ +].*}}jumpi
// CHECK: + [[LOAD:v[0-9]+]] = sload 5
fn @keep_sload_zero_trip() -> u256 {
  bb0:
    v0 = calldatasize
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v2 = lt v1, v0
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload 5
    v9 = add v1, 1
    jump bb1
  bb3:
    ret v10
}

// Hoisting the mload would unconditionally expand memory to 0x1000000 even
// when the loop runs zero times (out-of-gas risk).
// CHECK-LABEL: {{^[ +].*}}fn @keep_mload_zero_trip{{[( ]}}
// CHECK: {{^[ +].*}}jumpi
// CHECK: {{^[ +].*}}mload 0x1000000
fn @keep_mload_zero_trip() -> u256 {
  bb0:
    v0 = calldatasize
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v2 = lt v1, v0
    jumpi v2, bb2, bb3
  bb2:
    v3 = mload 0x1000000
    v9 = add v1, 1
    jump bb1
  bb3:
    ret v10
}

// A verified trip count of 10 guarantees the body executes, so the sload is
// still hoisted.
// CHECK-LABEL: {{^[ +].*}}fn @hoist_sload_known_trip{{[( ]}}
// CHECK: + [[LOAD:v[0-9]+]] = sload 5
// CHECK: - [[LOAD]] = sload 5
fn @hoist_sload_known_trip() -> u256 {
  bb0:
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v2 = lt v1, 10
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload 5
    v9 = add v1, 1
    jump bb1
  bb3:
    ret v10
}

// Do-while shape: the mload's block dominates the loop exit, so it executes
// whenever the loop is entered and may be hoisted despite the unknown bound.
// CHECK-LABEL: {{^[ +].*}}fn @hoist_mload_dominates_exits{{[( ]}}
// CHECK: {{^[ +].*}}[[LOAD:v[0-9]+]] = mload 64
// CHECK: + jump bb1
fn @hoist_mload_dominates_exits() -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = mload 64
    v1 = calldataload 0
    v2 = lt v0, v1
    jumpi v2, bb1, bb2
  bb2:
    ret v0
}

// The msize after the loop makes any early memory expansion observable;
// keep the mload in place even though the trip count is known.
// CHECK-LABEL: {{^[ +].*}}fn @keep_mload_msize_in_function{{[( ]}}
// CHECK: {{^[ +].*}}msize
// CHECK: {{^[ +].*}}mload 64
fn @keep_mload_msize_in_function() -> u256 {
  bb0:
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v2 = lt v1, 10
    jumpi v2, bb2, bb3
  bb2:
    v3 = mload 64
    v9 = add v1, 1
    jump bb1
  bb3:
    v5 = msize
    v6 = add v10, v5
    ret v6
}

// A checked recurrence gives the same trip bound on successful iterations. The load
// runs before the update, so its execution guarantee does not skip an arithmetic check.
// CHECK-LABEL: {{^[ +].*}}fn @hoist_sload_checked_trip{{[( ]}}
// CHECK: + [[LOAD:v[0-9]+]] = sload 5
// CHECK: - [[LOAD]] = sload 5
// CHECK: {{^[ +].*}}checked_add u256,
fn @hoist_sload_checked_trip() -> u256 {
  bb0:
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v2 = lt v1, 10
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload 5
    v9 = checked_add u256, v1, 1
    jump bb1
  bb3:
    ret v10
}

// A semantic check before the load can exit within the block. A positive loop bound
// alone does not let the load cross that check.
// CHECK-LABEL: {{^[ +].*}}fn @keep_sload_after_semantic_check{{[( ]}}
// CHECK: {{^[ +].*}}checked_add u256, arg0, 1
// CHECK: {{^[ +].*}}sload 5
fn @keep_sload_after_semantic_check(arg0: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v2 = lt v1, 10
    jumpi v2, bb2, bb3
  bb2:
    v4 = checked_add u256, arg0, 1
    v3 = sload 5
    v9 = checked_add u256, v1, 1
    jump bb1
  bb3:
    ret v10
}

// The header check can also exit before the load's block, despite the constant bound.
// CHECK-LABEL: {{^[ +].*}}fn @keep_sload_after_header_check{{[( ]}}
// CHECK: {{^[ +].*}}checked_add u256, arg0, 1
// CHECK: {{^[ +].*}}sload 5
fn @keep_sload_after_header_check(arg0: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v9]
    v4 = checked_add u256, arg0, 1
    v2 = lt v1, 10
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload 5
    v9 = checked_add u256, v1, 1
    jump bb1
  bb3:
    ret v10
}
