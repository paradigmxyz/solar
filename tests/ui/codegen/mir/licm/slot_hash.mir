//@ compile-flags: -Zmir-pipeline=licm
//@ filecheck:
@module SlotHashHoisting

// CHECK-LABEL: fn @private_scratch
// CHECK: + [[HASH:v[0-9]+]] = mapping_slot arg1, 3
// CHECK: - [[HASH]] = mapping_slot arg1, 3
fn @private_scratch(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb1: v4]
    v1 = mapping_slot arg1, 3
    v2 = sload v1
    v4 = add v0, 1
    v5 = lt v4, arg0
    jumpi v5, bb1, bb2
  bb2:
    ret v2
}

// Reading scratch before the hash observes the previous iteration's writes.
// CHECK-LABEL: fn @observed_scratch
// CHECK-NOT: + {{.*}}mapping_slot
// CHECK: {{^ +}}{{v[0-9]+}} = mapping_slot arg1, 3
fn @observed_scratch(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb1: v4]
    v6 = mload 0
    v1 = mapping_slot arg1, 3
    v2 = sload v1
    v4 = add v0, 1
    v5 = lt v4, arg0
    jumpi v5, bb1, bb2
  bb2:
    ret v6
}

// Revert data outside scratch does not observe the hash.
// CHECK-LABEL: fn @revert_outside_scratch
// CHECK: + [[HASH:v[0-9]+]] = mapping_slot arg1, 3
// CHECK: - [[HASH]] = mapping_slot arg1, 3
fn @revert_outside_scratch(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v4]
    v1 = mapping_slot arg1, 3
    v2 = sload v1
    v3 = eq v2, 0
    jumpi v3, bb4, bb3
  bb3:
    v4 = add v0, 1
    v5 = lt v4, arg0
    jumpi v5, bb1, bb2
  bb2:
    ret v2
  bb4:
    revert 128, 4
}

// Like a revert of scratch, a tail call whose callee reads scratch keeps the hash in the loop.
// CHECK-LABEL: fn @tail_call_reads_scratch
// CHECK-NOT: + {{.*}}mapping_slot
// CHECK: {{^ +}}{{v[0-9]+}} = mapping_slot arg1, 3
fn @tail_call_reads_scratch(arg0: i256, arg1: i256) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb1: v4]
    v1 = mapping_slot arg1, 3
    v2 = sload v1
    v4 = add v0, 1
    v5 = lt v4, arg0
    jumpi v5, bb1, bb2
  bb2:
    tail_call @reads_scratch
}

fn @reads_scratch() {
  bb0:
    revert 0, 64
}

// A store at an address that is not a constant, here into a fresh object, keeps the hash in the
// loop: only constant ranges are known to miss the scratch words, so every range a hoist relies on
// is decided by its constant, and `-Zcheck-analyses` has no run-time fact to record for it.
// CHECK-LABEL: fn @heap_store_keeps_hash
// CHECK-NOT: + {{.*}}mapping_slot
// CHECK: {{^ +}}{{v[0-9]+}} = mapping_slot arg1, 3
fn @heap_store_keeps_hash(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc 64
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb1: v4]
    v2 = mapping_slot arg1, 3
    v3 = sload v2
    mstore v0, v3
    v4 = add v1, 1
    v5 = lt v4, arg0
    jumpi v5, bb1, bb2
  bb2:
    ret v3
}
