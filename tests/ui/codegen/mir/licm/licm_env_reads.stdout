  @module LicmEnvReads
  fn @keep_balance_with_call() -> u256 {
    bb0:
      jump bb1
    bb1:
      v0 = phi [bb0: 0], [bb2: v2]
      jumpi 1, bb2, bb3
    bb3:
      ret v0
    bb2:
      v1 = balance 0xbeef
      v2 = mul v1, 3
      v3 = call 0x3e8, 0xbeef, 1, 0, 0, 0, 0
      jump bb1
  }
  
