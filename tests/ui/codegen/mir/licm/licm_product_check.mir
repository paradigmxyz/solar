//@compile-flags: -Zmir-pipeline=licm
//@filecheck: --enable-var-scope
@module LicmProductCheck

// A product by a factor defined before the loop checks `x <= MAX / y - (y == 0)`, with the
// bound computed once in the preheader instead of dividing on every iteration.
// CHECK-LABEL: @invariant_factor
// CHECK: +     [[ZERO:v[0-9]+]] = eq arg1, 0
// CHECK-NEXT: +     [[QUOTIENT:v[0-9]+]] = div 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, arg1
// CHECK-NEXT: +     [[WIDE:v[0-9]+]] = zext i1 [[ZERO]] to i256
// CHECK-NEXT: +     [[LIMIT:v[0-9]+]] = sub [[QUOTIENT]], [[WIDE]]
// CHECK: -     [[CHECK:v[0-9]+]] = or
// CHECK-NEXT: +     [[OVER:v[0-9]+]] = gt v1, [[LIMIT]]
// CHECK-NEXT: +     [[CHECK]] = eq [[OVER]], false
// CHECK-NEXT: {{^ +}}jumpi [[CHECK]], bb3, bb4
fn @invariant_factor(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v8]
    v1 = phi [bb0: arg0], [bb3: v3]
    v2 = lt v0, arg2
    jumpi v2, bb2, bb5
  bb2:
    v3 = mul v1, arg1
    v4 = eq arg1, 0
    v5 = div v3, arg1
    v6 = eq v5, v1
    v7 = or v4, v6
    jumpi v7, bb3, bb4
  bb3:
    v8 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// The check divides by the factor the loop changes when the other one, defined before the
// loop, comes first; overflow does not depend on the order, so the bound uses the invariant.
// CHECK-LABEL: @invariant_left
// CHECK: +     [[ZERO:v[0-9]+]] = eq arg1, 0
// CHECK-NEXT: +     [[QUOTIENT:v[0-9]+]] = div 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, arg1
// CHECK-NEXT: +     [[WIDE:v[0-9]+]] = zext i1 [[ZERO]] to i256
// CHECK-NEXT: +     [[LIMIT:v[0-9]+]] = sub [[QUOTIENT]], [[WIDE]]
// CHECK: -     [[CHECK:v[0-9]+]] = or
// CHECK-NEXT: +     [[OVER:v[0-9]+]] = gt v1, [[LIMIT]]
// CHECK-NEXT: +     [[CHECK]] = eq [[OVER]], false
fn @invariant_left(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v8]
    v1 = phi [bb0: arg0], [bb3: v3]
    v2 = lt v0, arg2
    jumpi v2, bb2, bb5
  bb2:
    v3 = mul arg1, v1
    v4 = eq v1, 0
    v5 = div v3, v1
    v6 = eq v5, arg1
    v7 = or v4, v6
    jumpi v7, bb3, bb4
  bb3:
    v8 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A factor that changes inside the loop keeps the division.
// CHECK-LABEL: @varying_factor
// CHECK-NOT: = gt
// CHECK: {{^ +}}ret
fn @varying_factor(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 1], [bb3: v8]
    v1 = phi [bb0: arg0], [bb3: v3]
    v2 = lt v0, arg1
    jumpi v2, bb2, bb5
  bb2:
    v3 = mul v1, v0
    v4 = eq v0, 0
    v5 = div v3, v0
    v6 = eq v5, v1
    v7 = or v4, v6
    jumpi v7, bb3, bb4
  bb3:
    v8 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A signed product divides with `sdiv`, which this bound does not describe.
// CHECK-LABEL: @signed_factor
// CHECK-NOT: = gt
// CHECK: {{^ +}}ret
fn @signed_factor(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v8]
    v1 = phi [bb0: arg0], [bb3: v3]
    v2 = lt v0, arg2
    jumpi v2, bb2, bb5
  bb2:
    v3 = mul v1, arg1
    v4 = eq arg1, 0
    v5 = sdiv v3, arg1
    v6 = eq v5, v1
    v7 = or v4, v6
    jumpi v7, bb3, bb4
  bb3:
    v8 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}
