//@compile-flags: -Zmir-pipeline=specialize,dead-arg-elim
//@filecheck:
@module SingleCallerSpecialization

// A helper the inliners keep shared (it returns a memory object) still folds
// the mode flag its only caller passes as a literal: the flag parameter and
// the branch on it disappear in place.
// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: + {{v[0-9]+}} = icall @fill, arg0
// CHECK-LABEL: {{^[ +].*}}fn @fill(arg0: i256)
// CHECK-NOT: jumpi
// CHECK: {{^[ +].*}}store8 {{v[0-9]+}}, 45
// CHECK-NOT: store8 {{v[0-9]+}}, 95
fn @caller(arg0: i256) -> memptr [selector=0x00000001] {
  bb0:
    v0 = icall @fill, arg0, 0
    ret v0
}

fn @fill(arg0: i256, arg1: i256) -> memptr {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v2 = ptrtoint memptr v0 to i256
    store v2, arg0
    v1 = ne arg1, 0
    jumpi v1, bb1, bb2
  bb1:
    v3 = ptradd v0, 32
    store8 v3, 95
    ret v0
  bb2:
    v4 = ptradd v0, 32
    store8 v4, 45
    ret v0
}
