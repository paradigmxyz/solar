//@compile-flags: -Zmir-pipeline=specialize,dead-arg-elim
//@filecheck:
@module SingleCallerSpecialization

// A helper the inliners keep shared (it returns a memory object) still folds
// the mode flag its only caller passes as a literal: the flag parameter and
// the branch on it disappear in place.
// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: + {{v[0-9]+}} = icall @fill, 1, arg0
// CHECK-LABEL: {{^[ +].*}}fn @fill(arg0: u256)
// CHECK-NOT: jumpi
// CHECK: {{^[ +].*}}memory_object_store_byte memorybytes, {{v[0-9]+}}, 0, 45
// CHECK-NOT: memory_object_store_byte memorybytes, {{v[0-9]+}}, 0, 95
fn @caller(arg0: u256) -> memorybytes [selector=0x00000001] {
  bb0:
    v0 = icall @fill, 1, arg0, 0
    ret v0
}

fn @fill(arg0: u256, arg1: u256) -> memorybytes {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    set_memory_object_len memorybytes, v0, arg0
    jumpi arg1, bb1, bb2
  bb1:
    memory_object_store_byte memorybytes, v0, 0, 95
    ret v0
  bb2:
    memory_object_store_byte memorybytes, v0, 0, 45
    ret v0
}
