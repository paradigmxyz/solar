//@compile-flags: -Zmir-pipeline=specialize,dead-arg-elim
@module SharedSpecialization

fn @first(arg0: u256) -> u256 [selector=0x00000001] {
  bb0:
    v0 = icall @helper, 1, 0, arg0
    ret v0
}

fn @second(arg0: u256) -> u256 [selector=0x00000002] {
  bb0:
    v0 = icall @helper, 1, 0, arg0
    ret v0
}

fn @helper(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = mul arg1, arg1
    v1 = mul v0, v0
    ret v1
  bb2:
    v2 = add arg1, 7
    ret v2
}

fn @specialized_a(arg0: u256) -> u256 {
  bb0:
    v0 = icall @mixed_helper, 1, 0, arg0
    ret v0
}

fn @specialized_b(arg0: u256) -> u256 {
  bb0:
    v0 = icall @mixed_helper, 1, 0, arg0
    ret v0
}

fn @generic(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v0 = icall @mixed_helper, 1, arg0, arg1
    ret v0
}

fn @mixed_helper(arg0: u256, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = mul arg1, arg1
    v1 = mul v0, v0
    ret v1
  bb2:
    v2 = add arg1, 7
    ret v2
}
