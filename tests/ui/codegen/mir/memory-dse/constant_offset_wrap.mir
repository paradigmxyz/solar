//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module ConstantOffsetWrap

// Writing the high 24 bytes preserves the heap floor but makes the actual free memory pointer
// wrap to zero when the offset is added. Adding that offset to the heap floor still fits in u64.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_read{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^[ +].*}}returndata 128, 32
fn @wrapped_read() {
  bb0:
    mstore 64, 1024
    mstore 0, 7
    mstore 56, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v0 = mload 64
    v1 = add v0, 18446744073709550592
    v2 = mload v1
    mstore 128, v2
    returndata 128, 32
}

// The same read keeps the scratch store when the constant is the first operand.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_commuted_read{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^[ +].*}}returndata 128, 32
fn @wrapped_commuted_read() {
  bb0:
    mstore 64, 1024
    mstore 0, 7
    mstore 56, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v0 = mload 64
    v1 = add 18446744073709550592, v0
    v2 = mload v1
    mstore 128, v2
    returndata 128, 32
}

// Canonicalizing the copy's source to a base and offset must preserve the possibility of wrap.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_copy{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^[ +].*}}returndata 128, 32
fn @wrapped_copy() {
  bb0:
    mstore 64, 1024
    mstore 0, 7
    mstore 56, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v0 = mload 64
    v1 = add v0, 18446744073709550592
    mcopy 128, v1, 32
    returndata 128, 32
}

// The maximum selected operand proves that this addition cannot wrap, so its read cannot
// observe the scratch store.
// CHECK-LABEL: {{^[ +].*}}fn @bounded_add{{[( ]}}
// CHECK: - mstore 0, 7
// CHECK: {{^[ +].*}}returndata 128, 32
fn @bounded_add(arg0: i1) {
  bb0:
    mstore 0, 7
    v0 = select arg0, 128, 256
    v1 = add v0, 32
    v2 = mload v1
    mstore 128, v2
    returndata 128, 32
}

// An in-bounds pointer offset into an allocation also keeps the read above the scratch words.
// CHECK-LABEL: {{^[ +].*}}fn @bounded_ptradd{{[( ]}}
// CHECK: - mstore 0, 7
// CHECK: {{^[ +].*}}returndata 128, 32
fn @bounded_ptradd() {
  bb0:
    mstore 0, 7
    v0 = alloc 64
    v1 = ptradd v0, 32
    v2 = ptrtoint ptr<memory> v1 to i256
    v3 = mload v2
    mstore 128, v3
    returndata 128, 32
}
