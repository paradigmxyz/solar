//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemoryDseEqualStore

// A memory observer can read the first store but does not mutate memory, so the
// second equal store is redundant.
// CHECK-LABEL: {{^[ +].*}}fn @remove_equal_store_after_keccak{{[( ]}}
// CHECK: {{^[ +].*}}store 128, arg0
// CHECK: {{^[ +].*}}keccak256
// CHECK: - store 128, arg0
fn @remove_equal_store_after_keccak(arg0: i256) -> i256 {
  bb0:
    store 128, arg0
    v2 = keccak256 128, 32
    store 128, arg0
    ret v2
}

// A memory mutator can change the address, so the equal-looking store after it
// must be kept.
// CHECK-LABEL: {{^[ +].*}}fn @keep_equal_store_after_copy{{[( ]}}
// CHECK: {{^[ +].*}}copy calldata
// CHECK: {{^[ +].*}}store 128, arg0
// CHECK: + ret arg0
fn @keep_equal_store_after_copy(arg0: i256, arg1: i256) -> i256 {
  bb0:
    store 128, arg0
    copy calldata 128, arg1, 32
    store 128, arg0
    v4 = load 128
    ret v4
}

// An unaligned word store overlaps and partially clobbers the remembered word.
// The later equal store is a required restore, including across unique edges.
// CHECK-LABEL: {{^[ +].*}}fn @keep_restore_after_overlapping_store{{[( ]}}
// CHECK: {{^[ +].*}}store 128, 0x1234
// CHECK: {{^[ +].*}}store 129, 0
// CHECK: {{^[ +].*}}store 128, 0x1234
fn @keep_restore_after_overlapping_store() -> i256 {
  bb0:
    store 128, 4660
    jump bb1
  bb1:
    store 129, 0
    jump bb2
  bb2:
    store 128, 4660
    jump bb3
  bb3:
    v3 = load 128
    ret v3
}

// An unknown value at a known overlapping address also invalidates the word.
// CHECK-LABEL: {{^[ +].*}}fn @keep_restore_after_dynamic_overlapping_store{{[( ]}}
// CHECK: {{^[ +].*}}store 128, 0x1234
// CHECK: {{^[ +].*}}store 129, arg0
// CHECK: {{^[ +].*}}store 128, 0x1234
fn @keep_restore_after_dynamic_overlapping_store(arg0: i256) -> i256 {
  bb0:
    store 128, 0x1234
    jump bb1
  bb1:
    store 129, arg0
    jump bb2
  bb2:
    store 128, 0x1234
    jump bb3
  bb3:
    v3 = load 128
    ret v3
}
