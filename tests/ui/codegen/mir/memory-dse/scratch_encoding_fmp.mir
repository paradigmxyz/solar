//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module ScratchEncodingFmp

// Scratch encoding borrows the current free-memory pointer without reserving its output.
// Its destination still depends on the preceding store to that slot.
// CHECK-LABEL: {{^[ +].*}}fn @scratch{{[( ]}}
// CHECK: {{^ +}}mstore 64, 256
// CHECK: {{^ +}}v0 = abi_encode [word], scratch, args 42
// CHECK: {{^[ +].*}}returndata v1, 32
fn @scratch() {
  bb0:
    mstore 64, 256
    v0 = abi_encode [word], scratch, args 42
    v1 = extract_value slice<memory>, v0, 0
    returndata v1, 32
}

// Calldata payloads do not read memory themselves, but their scratch destination does.
// CHECK-LABEL: {{^[ +].*}}fn @dynamic_scratch{{[( ]}}
// CHECK: {{^ +}}mstore 64, 256
// CHECK: {{^ +}}v0 = abi_encode [calldata_bytes], scratch, args arg0
// CHECK: {{^[ +].*}}returndata v1, v2
fn @dynamic_scratch(arg0: slice<calldata>) {
  bb0:
    mstore 64, 256
    v0 = abi_encode [calldata_bytes], scratch, args arg0
    v1 = extract_value slice<memory>, v0, 0
    v2 = extract_value slice<memory>, v0, 1
    returndata v1, v2
}
