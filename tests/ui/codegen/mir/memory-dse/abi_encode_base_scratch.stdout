- ; === ROOT/tests/ui/codegen/mir/memory-dse/abi_encode_base_scratch.mir (before memory-dse) ===
+ ; === ROOT/tests/ui/codegen/mir/memory-dse/abi_encode_base_scratch.mir (after memory-dse) ===
  @module AbiEncodeBaseScratch
  fn @scratch_base() {
    bb0:
      v0 = inttoptr i256 32 to ptr<memory>
      v1 = abi_encode [word], scratch, base v0, args 7
      mstore 32, 42
      v2 = extract_value slice<memory>, v1, 0
      returndata v2, 32
  }
  
