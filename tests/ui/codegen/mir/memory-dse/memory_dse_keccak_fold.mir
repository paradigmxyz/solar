//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemoryDseKeccakFold
// CHECK-LABEL: {{^[ +].*}}fn @fold_constant_scratch_keccak{{[( ]}}
// CHECK: + ret 0xeddb6698d7c569ff62ff64f1f1492bf14a54594835ba0faac91f84b4f5d81460
fn @fold_constant_scratch_keccak() -> i256 {
  bb0:
    store 0, 7
    store 32, 5
    v2 = keccak256 0, 64
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_dynamic_word{{[( ]}}
// CHECK: {{^[ +].*}}store 0, arg0
// CHECK: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_dynamic_word(arg0: i256) -> i256 {
  bb0:
    store 0, arg0
    store 32, 5
    v2 = keccak256 0, 64
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_after_memory_clobber{{[( ]}}
// CHECK: {{^[ +].*}}copy calldata
// CHECK: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_after_memory_clobber() -> i256 {
  bb0:
    store 0, 7
    store 32, 5
    copy calldata 0, 0, 32
    v3 = keccak256 0, 64
    ret v3
}
