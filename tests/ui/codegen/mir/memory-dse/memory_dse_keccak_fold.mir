//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=memory-dse
//@[size] compile-flags: -Osize -Zmir-pipeline=memory-dse
//@[gas] filecheck: --check-prefix=GAS
//@[size] filecheck: --check-prefix=SIZE
@module MemoryDseKeccakFold

// A hash of constant stores is an immediate when that takes fewer bytes: two stores of
// 32-byte words that nothing else reads cost more than the hash.
// GAS-LABEL: {{^[ +].*}}fn @fold_dead_words{{[( ]}}
// GAS-NOT: {{^[ +].*}}mstore
// GAS: + sstore 0, 0x
// SIZE-LABEL: {{^[ +].*}}fn @fold_dead_words{{[( ]}}
// SIZE-NOT: {{^[ +].*}}mstore
// SIZE: + sstore 0, 0x
fn @fold_dead_words() {
  bb0:
    mstore 0, 0x36b6384b5eca791c62761152d0c79bb0604c104a5fb6f4eb0703f3154bb3db0
    mstore 32, 0x290decd9548b62a8d60345a988386fc84ba6bc95484008f6362f93160ef3e563
    v2 = keccak256 0, 64
    sstore 0, v2
    stop
}

// Small words that stay live because the function returns cost fewer bytes than the hash.
// GAS-LABEL: {{^[ +].*}}fn @keep_small_live_words{{[( ]}}
// GAS: {{^[ +].*}}mstore 0, 7
// GAS: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
// SIZE-LABEL: {{^[ +].*}}fn @keep_small_live_words{{[( ]}}
// SIZE: {{^[ +].*}}mstore 0, 7
// SIZE: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_small_live_words() -> i256 {
  bb0:
    mstore 0, 7
    mstore 32, 5
    v2 = keccak256 0, 64
    ret v2
}

// Full words that the return keeps alive are not credited to the fold, and the hash costs
// more bytes than the instruction.
// GAS-LABEL: {{^[ +].*}}fn @keep_big_live_words{{[( ]}}
// GAS: {{^[ +].*}}mstore 0, 0x36b6384b5eca791c62761152d0c79bb0604c104a5fb6f4eb0703f3154bb3db0
// GAS: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
// SIZE-LABEL: {{^[ +].*}}fn @keep_big_live_words{{[( ]}}
// SIZE: {{^[ +].*}}mstore 0, 0x36b6384b5eca791c62761152d0c79bb0604c104a5fb6f4eb0703f3154bb3db0
// SIZE: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_big_live_words() -> i256 {
  bb0:
    mstore 0, 0x36b6384b5eca791c62761152d0c79bb0604c104a5fb6f4eb0703f3154bb3db0
    mstore 32, 0x290decd9548b62a8d60345a988386fc84ba6bc95484008f6362f93160ef3e563
    v2 = keccak256 0, 64
    ret v2
}

// Each use of the folded hash pushes it again, so two uses outweigh the two dead stores.
// GAS-LABEL: {{^[ +].*}}fn @keep_many_uses{{[( ]}}
// GAS: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
// SIZE-LABEL: {{^[ +].*}}fn @keep_many_uses{{[( ]}}
// SIZE: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_many_uses() {
  bb0:
    mstore 0, 0x36b6384b5eca791c62761152d0c79bb0604c104a5fb6f4eb0703f3154bb3db0
    mstore 32, 5
    v2 = keccak256 0, 64
    sstore 0, v2
    sstore 1, v2
    sstore 2, v2
    stop
}

// In a loop the gas of the iterations repays the bytes of the hash, but only when optimizing
// for gas.
// GAS-LABEL: {{^[ +].*}}fn @loop_hash{{[( ]}}
// GAS-NOT: {{^[ +].*}}keccak256
// GAS: + {{v[0-9]+}} = add {{v[0-9]+}}, 0x
// SIZE-LABEL: {{^[ +].*}}fn @loop_hash{{[( ]}}
// SIZE: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @loop_hash(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb1: v4]
    v1 = phi [bb0: 0], [bb1: v3]
    mstore 0, 7
    mstore 32, 5
    v2 = keccak256 0, 64
    v3 = add v1, v2
    v4 = add v0, 1
    v5 = lt v4, arg0
    jumpi v5, bb1, bb2
  bb2:
    ret v3
}

// A word the hash reads is not constant after a store of a dynamic value.
// GAS-LABEL: {{^[ +].*}}fn @keep_dynamic_word{{[( ]}}
// GAS: {{^[ +].*}}mstore 0, arg0
// GAS: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
// SIZE-LABEL: {{^[ +].*}}fn @keep_dynamic_word{{[( ]}}
// SIZE: {{^[ +].*}}mstore 0, arg0
// SIZE: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_dynamic_word(arg0: i256) -> i256 {
  bb0:
    mstore 0, arg0
    mstore 32, 5
    v2 = keccak256 0, 64
    ret v2
}

// GAS-LABEL: {{^[ +].*}}fn @keep_after_memory_clobber{{[( ]}}
// GAS: {{^[ +].*}}calldatacopy
// GAS: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
// SIZE-LABEL: {{^[ +].*}}fn @keep_after_memory_clobber{{[( ]}}
// SIZE: {{^[ +].*}}calldatacopy
// SIZE: {{^[ +].*}}{{v[0-9]+}} = keccak256 0, 64
fn @keep_after_memory_clobber() -> i256 {
  bb0:
    mstore 0, 7
    mstore 32, 5
    calldatacopy 0, 0, 32
    v3 = keccak256 0, 64
    ret v3
}
