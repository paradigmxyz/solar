//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module ExactCopyRanges

// Both exits observe exactly the bytes overwritten by the copy. The pointer and count may
// be arbitrary words, so this does not rely on their being heap addresses or on no-wrap bounds.
// CHECK-LABEL: {{^[ +].*}}fn @copied_diamond{{[( ]}}
// CHECK: - mstore 64, 512
// CHECK: {{^ +}}calldatacopy arg0, 0, arg1
fn @copied_diamond(arg0: i256, arg1: i256, arg2: i1) {
  bb0:
    mstore 64, 512
    calldatacopy arg0, 0, arg1
    jumpi arg2, bb1, bb2
  bb1:
    returndata arg0, arg1
  bb2:
    revert arg0, arg1
}

// A proxy's returndata copy must still perform its source bounds check, but its destination
// fully defines the subsequent return range and makes the earlier FMP bump unobservable.
// The typed return pointer and the raw revert pointer still name exactly the same bytes.
// CHECK-LABEL: {{^[ +].*}}fn @returndata_diamond{{[( ]}}
// CHECK: - mstore 64, {{v[0-9]+}}
// CHECK: {{^ +}}returndatacopy {{v[0-9]+}}, 0, {{v[0-9]+}}
fn @returndata_diamond(arg0: i1) {
  bb0:
    v0 = returndatasize
    v1 = mload 64 !metadata(alloc_ptr)
    v2 = add v1, v0 !metadata(alloc_ptr)
    mstore 64, v2
    v3 = add v1, 32
    returndatacopy v3, 0, v0
    v4 = inttoptr i256 v3 to ptr<memory>
    jumpi arg0, bb1, bb2
  bb1:
    returndata v4, v0
  bb2:
    revert v3, v0
}

// A different count leaves part of the observed range potentially untouched.
// CHECK-LABEL: {{^[ +].*}}fn @different_size{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @different_size(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    mstore 64, 512
    calldatacopy arg0, 0, arg1
    returndata arg0, arg2
}

// Equal counts do not prove that different pointers name the same range.
// CHECK-LABEL: {{^[ +].*}}fn @different_address{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @different_address(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    mstore 64, 512
    calldatacopy arg0, 0, arg1
    returndata arg2, arg1
}

// A byte store is not a full overwrite of an unknown extent.
// CHECK-LABEL: {{^[ +].*}}fn @partial_write{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @partial_write(arg0: i256, arg1: i256) {
  bb0:
    mstore 64, 512
    mstore8 arg0, 0
    returndata arg0, arg1
}

// An intervening read observes the old contents before the exact overwrite.
// CHECK-LABEL: {{^[ +].*}}fn @read_before_copy{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @read_before_copy(arg0: i256, arg1: i256) {
  bb0:
    mstore 64, 512
    v0 = keccak256 arg0, arg1
    calldatacopy arg0, 0, arg1
    mstore 0, v0
    returndata 0, 32
}

// Copying from memory reads its source before overwriting the destination.
// CHECK-LABEL: {{^[ +].*}}fn @memory_copy_reads_source{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @memory_copy_reads_source(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    mstore 64, 512
    mcopy arg0, arg2, arg1
    returndata arg0, arg1
}

// Exact writes cannot erase observations of memory expansion or its gas cost.
// CHECK-LABEL: {{^[ +].*}}fn @gas_barrier{{[( ]}}
// CHECK: {{^ +}}mstore 0x1000, 42
fn @gas_barrier(arg0: i256, arg1: i256) {
  bb0:
    mstore 4096, 42
    v0 = gas
    calldatacopy arg0, 0, arg1
    mstore 0, v0
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @msize_barrier{{[( ]}}
// CHECK: {{^ +}}mstore 0x1000, 42
fn @msize_barrier(arg0: i256, arg1: i256) {
  bb0:
    mstore 4096, 42
    v0 = msize
    calldatacopy arg0, 0, arg1
    mstore 0, v0
    returndata 0, 32
}

// The phi denotes a different address on each iteration. A copy in the previous iteration
// cannot satisfy a read through the new phi, and the loop may also exit before any copy.
// CHECK-LABEL: {{^[ +].*}}fn @loop_carried_range{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @loop_carried_range(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    mstore 64, 512
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v2]
    v1 = eq v0, arg2
    jumpi v1, bb3, bb2
  bb2:
    calldatacopy v0, 0, arg1
    v2 = add v0, 32
    jump bb1
  bb3:
    returndata v0, arg1
}

// Caller-local value IDs must not become ranges in the callee's liveness. Its arguments
// are unrelated to the caller's arguments, despite having the same printed names.
// CHECK-LABEL: {{^[ +].*}}fn @summary_writer{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
fn @summary_writer(arg0: i256, arg1: i256) {
  bb0:
    mstore 64, 512
    calldatacopy arg0, 0, arg1
    ret
}

fn @summary_caller(arg0: i256, arg1: i256) {
  bb0:
    icall @summary_writer, 0, 0
    returndata arg0, arg1
}

// A call's output buffer names only the maximum write extent. Empty returndata leaves the
// whole range untouched, even when the later read uses precisely the same pointer and count.
// CHECK-LABEL: {{^[ +].*}}fn @partial_call_output{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
// CHECK: {{^ +}}{{v[0-9]+}} = staticcall 100, 4, 0, 0, arg0, arg1
fn @partial_call_output(arg0: i256, arg1: i256) {
  bb0:
    mstore 64, 512
    v0 = staticcall 100, 4, 0, 0, arg0, arg1
    returndata arg0, arg1
}
