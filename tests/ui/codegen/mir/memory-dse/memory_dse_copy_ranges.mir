//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemoryDseCopyRanges

// A full-word copy write to the same range makes the prior store dead.
// CHECK-LABEL: {{^[ +].*}}fn @remove_store_overwritten_by_codecopy{{[( ]}}
// CHECK: - store 0, 1
// CHECK: {{^[ +].*}}codecopy 0, 0, 64
fn @remove_store_overwritten_by_codecopy() -> i256 {
  bb0:
    store 0, 1
    codecopy 0, 0, 64
    ret 0
}

// A partial disjoint copy range must not kill the store read from the next word.
// CHECK-LABEL: {{^[ +].*}}fn @keep_store_after_partial_copy{{[( ]}}
// CHECK: {{^[ +].*}}store 32, 1
// CHECK: {{^[ +].*}}codecopy 0, 0, 32
// CHECK: + ret 1
fn @keep_store_after_partial_copy() -> i256 {
  bb0:
    store 32, 1
    codecopy 0, 0, 32
    v2 = load 32
    ret v2
}

// A raw FMP read does not prove that the object header avoids the FMP slot.
// Retain the header load across an update to that slot.
// CHECK-LABEL: {{^[ +].*}}fn @keep_unproven_array_length{{[( ]}}
// CHECK: {{^[ +].*}}copy calldata
// CHECK: {{^[ +].*}}[[LENGTH:v[0-9]+]] = load {{v[0-9]+}}
// CHECK-NEXT: {{^[ +].*}}ret [[LENGTH]]
fn @keep_unproven_array_length() -> i256 {
  bb0:
    v0 = load 64
    store v0, 3
    v1 = add v0, 128
    store 64, v1
    v2 = add v0, 32
    copy calldata v2, 0, 96
    v3 = load v0
    ret v3
}

// A call's return copy can be shorter than the requested output range, so the
// sentinel must survive when a failed call returns no data.
// CHECK-LABEL: {{^[ +].*}}fn @keep_store_before_partial_call_output{{[( ]}}
// CHECK: {{^[ +].*}}store 32, arg0
// CHECK: {{^[ +].*}}staticcall 0x3e8, 0xbeef, 0, 0, 32, 32
fn @keep_store_before_partial_call_output(arg0: i256) -> i256 {
  bb0:
    store 32, arg0
    v1 = staticcall 1000, 0xbeef, 0, 0, 32, 32
    v2 = load 32
    ret v2
}
