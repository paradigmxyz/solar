//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemorySliceReads

// CHECK-LABEL: {{^[ +].*}}fn @copy_reads_slice_range{{[( ]}}
// CHECK: -     mstore 0, 7
// CHECK: {{^ .*}}slice_copy
// CHECK: {{^ .*}}mstore 0, 8
fn @copy_reads_slice_range(arg0: memptr) {
  bb0:
    v0 = make_memory_slice 128, 32
    mstore 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    v3 = make_memory_slice v2, 32
    slice_copy v3, 0, v0
    mstore 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_at_reads_slice_range{{[( ]}}
// CHECK: -     mstore 0, 7
// CHECK: {{^ .*}}slice_copy {{v[0-9]+}}, arg1,
// CHECK: {{^ .*}}mstore 0, 8
fn @copy_at_reads_slice_range(arg0: memptr, arg1: i256) {
  bb0:
    v0 = make_memory_slice 128, 32
    mstore 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    v3 = make_memory_slice v2, 32
    slice_copy v3, arg1, v0
    mstore 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_keeps_read_store{{[( ]}}
// CHECK: {{^ .*}}mstore 0, 7
// CHECK: {{^ .*}}slice_copy
fn @copy_keeps_read_store(arg0: memptr) {
  bb0:
    v0 = make_memory_slice 0, 32
    mstore 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    v3 = make_memory_slice v2, 32
    slice_copy v3, 0, v0
    mstore 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_unknown_slice{{[( ]}}
// CHECK: {{^ .*}}mstore 0, 7
// CHECK: {{^ .*}}slice_copy
fn @copy_unknown_slice(arg0: memptr, arg1: memoryslice) {
  bb0:
    mstore 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    v3 = slice_len arg1
    v4 = make_memory_slice v2, v3
    slice_copy v4, 0, arg1
    mstore 0, 8
    stop
}
