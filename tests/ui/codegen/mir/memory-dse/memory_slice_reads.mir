//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemorySliceReads

// CHECK-LABEL: {{^[ +].*}}fn @copy_reads_slice_range{{[( ]}}
// CHECK: -     mstore 0, 7
// CHECK: {{^ .*}}mcopy {{v[0-9]+}}, 128, 32
// CHECK: {{^ .*}}mstore 0, 8
fn @copy_reads_slice_range(arg0: ptr<memory>) {
  bb0:
    mstore 0, 7
    v1 = ptrtoint ptr<memory> arg0 to i256
    v2 = add v1, 32
    mcopy v2, 128, 32
    mstore 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_at_reads_slice_range{{[( ]}}
// CHECK: -     mstore 0, 7
// CHECK: {{^ .*}}[[DEST:v[0-9]+]] = add {{v[0-9]+}}, arg1
// CHECK-NEXT: {{^ .*}}mcopy [[DEST]], 128, 32
// CHECK: {{^ .*}}mstore 0, 8
fn @copy_at_reads_slice_range(arg0: ptr<memory>, arg1: i256) {
  bb0:
    mstore 0, 7
    v1 = ptrtoint ptr<memory> arg0 to i256
    v2 = add v1, 32
    v3 = add v2, arg1
    mcopy v3, 128, 32
    mstore 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_keeps_read_store{{[( ]}}
// CHECK: {{^ .*}}mstore 0, 7
// CHECK: {{^ .*}}mcopy {{v[0-9]+}}, 0, 32
fn @copy_keeps_read_store(arg0: ptr<memory>) {
  bb0:
    mstore 0, 7
    v1 = ptrtoint ptr<memory> arg0 to i256
    v2 = add v1, 32
    mcopy v2, 0, 32
    mstore 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_unknown_slice{{[( ]}}
// CHECK: {{^ .*}}mstore 0, 7
// CHECK: {{^ .*}}[[SOURCE:v[0-9]+]] = extract_value slice<memory>, arg1, 0
// CHECK-NEXT: {{^ .*}}[[LEN:v[0-9]+]] = extract_value slice<memory>, arg1, 1
// CHECK-NEXT: {{^ .*}}mcopy {{v[0-9]+}}, [[SOURCE]], [[LEN]]
fn @copy_unknown_slice(arg0: ptr<memory>, arg1: slice<memory>) {
  bb0:
    mstore 0, 7
    v1 = ptrtoint ptr<memory> arg0 to i256
    v2 = add v1, 32
    v3 = extract_value slice<memory>, arg1, 0
    v4 = extract_value slice<memory>, arg1, 1
    mcopy v2, v3, v4
    mstore 0, 8
    stop
}
