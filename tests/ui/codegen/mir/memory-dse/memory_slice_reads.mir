//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemorySliceReads

// CHECK-LABEL: {{^[ +].*}}fn @copy_reads_slice_range{{[( ]}}
// CHECK: -     store 0, 7
// CHECK: {{^ .*}}copy {{v[0-9]+}}, 128, 32
// CHECK: {{^ .*}}store 0, 8
fn @copy_reads_slice_range(arg0: memptr) {
  bb0:
    store 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    copy v2, 128, 32
    store 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_at_reads_slice_range{{[( ]}}
// CHECK: -     store 0, 7
// CHECK: {{^ .*}}[[DEST:v[0-9]+]] = add {{v[0-9]+}}, arg1
// CHECK-NEXT: {{^ .*}}copy [[DEST]], 128, 32
// CHECK: {{^ .*}}store 0, 8
fn @copy_at_reads_slice_range(arg0: memptr, arg1: i256) {
  bb0:
    store 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    v3 = add v2, arg1
    copy v3, 128, 32
    store 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_keeps_read_store{{[( ]}}
// CHECK: {{^ .*}}store 0, 7
// CHECK: {{^ .*}}copy {{v[0-9]+}}, 0, 32
fn @copy_keeps_read_store(arg0: memptr) {
  bb0:
    store 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    copy v2, 0, 32
    store 0, 8
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @copy_unknown_slice{{[( ]}}
// CHECK: {{^ .*}}store 0, 7
// CHECK: {{^ .*}}[[SOURCE:v[0-9]+]] = extract_value memoryslice, arg1, 0
// CHECK-NEXT: {{^ .*}}[[LEN:v[0-9]+]] = extract_value memoryslice, arg1, 1
// CHECK-NEXT: {{^ .*}}copy {{v[0-9]+}}, [[SOURCE]], [[LEN]]
fn @copy_unknown_slice(arg0: memptr, arg1: memoryslice) {
  bb0:
    store 0, 7
    v1 = ptrtoint memptr arg0 to i256
    v2 = add v1, 32
    v3 = extract_value memoryslice, arg1, 0
    v4 = extract_value memoryslice, arg1, 1
    copy v2, v3, v4
    store 0, 8
    stop
}
