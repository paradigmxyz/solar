    v3 = phi [bb0: 0], [bb3: v8]
    v4 = lt v3, v0
    v5 = zext i1 v4 to i256
    v6 = ne v5, 0
    jumpi v6, bb4, bb5
  bb5:
    jump bb2
  bb2:
    returndata v2, 32
  bb4:
    calldatacopy v2, 4, 32
    v7 = add v2, 32
    jump bb6
  bb6:
    jump bb3
  bb3:
