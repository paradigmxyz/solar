; === ROOT/tests/ui/codegen/mir/memory-dse/exact_copy_ranges.sol:Test ===
@module Test
@types
  struct0: {i256, i256}

; function copied(uint256 base, uint256, uint256 count) external pure returns (uint256) [selector 0xc8ef3ab5]
fn @copied(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0xc8ef3ab5, pure, abi_params=[uint256, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = add arg0, 32
    mstore 0, 7 !metadata(memory=scratch)
    calldatacopy v0, 36, arg2
    returndata v0, 32
}

; function zeroCopy(uint256 count) external pure returns (uint256) [selector 0xf16e8c2d]
fn @zeroCopy(arg0: i256) -> i256 [selector=0xf16e8c2d, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    calldatacopy 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, arg0
    mstore 0, 17 !metadata(memory=scratch)
    returndata 0, 32
}

; function unmatchedCount(uint256 count) external pure returns (uint256) [selector 0x747ce2e2]
fn @unmatchedCount(arg0: i256) -> i256 [selector=0x747ce2e2, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    calldatacopy 0, 4, arg0 !metadata(memory=scratch)
    returndata 0, 32
}

; function beforeCopy(uint256) external pure returns (uint256 oldValue, uint256 newValue) [selector 0xdc08924e]
fn @beforeCopy(arg0: i256) -> struct0 [selector=0xdc08924e, pure, abi_params=[uint256], abi_returns=[word, word], abi_return_params=[uint256, uint256]] {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    v0 = mload 0 !metadata(memory=scratch)
    calldatacopy 0, 4, 32 !metadata(memory=scratch)
    v1 = mload 0 !metadata(memory=scratch)
    v2 = insert_value struct0, undef struct0, 0, v0
    v3 = insert_value struct0, v2, 1, v1
    ret v3
}

; function partialCopy(uint256 value) external pure returns (uint256) [selector 0x2acedaf0]
fn @partialCopy(arg0: i256) -> i256 [selector=0x2acedaf0, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    mstore 0, 263 !metadata(memory=scratch)
    mstore8 31, arg0 !metadata(memory=scratch)
    returndata 0, 32
}

; function fromMemory(uint256 destination) external pure returns (uint256) [selector 0x934a1496]
fn @fromMemory(arg0: i256) -> i256 [selector=0x934a1496, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    mcopy arg0, 0, 32
    returndata arg0, 32
}

; function throughHelper(uint256 pointer) external pure returns (uint256) [selector 0x793709d6]
fn @throughHelper(arg0: i256) -> i256 [selector=0x793709d6, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    icall @writeAndCopy, 0, 0
    returndata arg0, 32
}

; function loopRead(uint256 count) external pure returns (uint256) [selector 0xe24ad65f]
fn @loopRead(arg0: i256) -> i256 [selector=0xe24ad65f, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    mstore 32, 7 !metadata(memory=scratch)
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v7]
    v3 = phi [bb0: 0], [bb3: v8]
    v4 = lt v3, v0
    v5 = zext i1 v4 to i256
    v6 = ne v5, 0
    jumpi v6, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    returndata v2, 32
  bb4:                                            ; preds = bb1
    calldatacopy v2, 4, 32
    v7 = add v2, 32
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v8 = add v3, 1
    jump bb1
}

; function proxy(uint256 value, bool fail) external view returns (uint256) [selector 0xe05fde19]
fn @proxy(arg0: i256, arg1: i1) -> i256 [selector=0xe05fde19, view, abi_params=[uint256, bool], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = address
    v1 = gas
    v2 = zext i1 arg1 to i256
    v3 = abi_encode [word, word<bool>], object, selector 0x387a04f900000000000000000000000000000000000000000000000000000000, args arg0, v2
    v4 = address_staticcall v0, v3, gas v1
    v5 = icall returndata_bytes<>
    v6 = ptrtoint ptr<memory> v5 to i256
    v7 = add v6, 32
    v8 = ptrtoint ptr<memory> v5 to i256
    v9 = mload v5
    v10 = zext i1 v4 to i256
    switch v10, default bb3, [0 => bb2]
  bb2:                                            ; preds = bb0
    revert v7, v9
  bb3:                                            ; preds = bb0
    returndata v7, v9
  bb1:
    ret 0
}

; function echo(uint256 value, bool fail) external pure returns (uint256) [selector 0x387a04f9]
fn @echo(arg0: i256, arg1: i1) -> i256 [selector=0x387a04f9, pure, abi_params=[uint256, bool], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jumpi arg1, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    ret arg0
  bb1:                                            ; preds = bb0
    mstore 0, arg0 !metadata(memory=scratch)
    revert 0, 32
}

; function writeAndCopy(uint256 pointer, uint256 count) private pure
fn @writeAndCopy(arg0: i256, arg1: i256) [pure] {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    calldatacopy arg0, 0, arg1
    ret
}
