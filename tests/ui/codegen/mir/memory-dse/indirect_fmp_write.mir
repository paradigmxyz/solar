//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module IndirectFmpWrite

// A write through a wrapped address can replace the free memory pointer itself, so its later
// load cannot reuse the pointer read before the write.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_write{{[( ]}}
// CHECK: {{^[ +].*}}[[ADDRESS:v[0-9]+]] = add
// CHECK: {{^ +}}mstore [[ADDRESS]], 768
// CHECK: {{^[ +].*}}[[RELOADED:v[0-9]+]] = mload 64
// CHECK: {{^[ +].*}}mstore 128, [[RELOADED]]
fn @wrapped_write() {
  bb0:
    mstore 64, 1024
    mstore 56, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v0 = mload 64
    v1 = add v0, 18446744073709550656
    mstore v1, 768
    v2 = mload 64
    mstore 128, v2
    returndata 128, 32
}

// An indirect store can lower the slot below the heap, invalidating the module's FMP bound.
// CHECK-LABEL: {{^[ +].*}}fn @unknown_write{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^ +}}mstore arg0, 0
fn @unknown_write(arg0: i256) {
  bb0:
    mstore 0, 7
    mstore arg0, 0
    v0 = mload 64
    v1 = mload v0
    mstore 128, v1
    returndata 128, 32
}
