//@ compile-flags: -Zmir-pipeline=memory-dse
//@ filecheck:
@module Zeroing

// Every byte is written before the hash reads any, so no zeroing is needed.
// CHECK-LABEL: {{^[ +].*}}fn @full{{[( ]}}
// CHECK: - {{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 96
// CHECK: + {{v[0-9]+}} = alloc memorybytes, exact, uninitialized, panic, 96
fn @full(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, zeroed, panic, 96
    set_memory_object_len memorybytes, v0, 64
    v1 = memory_object_len memorybytes, v0
    memory_object_store_word memorybytes, v0, 0, arg0
    memory_object_store_word memorybytes, v0, 32, arg1
    v2 = keccak256_bytes v0
    ret v2
}

// Raw stores count as well.
// CHECK-LABEL: {{^[ +].*}}fn @raw{{[( ]}}
// CHECK: + {{v[0-9]+}} = alloc raw, exact, uninitialized, infallible, 64
fn @raw(arg0: i256) -> i256 {
  bb0:
    v0 = alloc raw, exact, zeroed, infallible, 64
    v1 = ptrtoint memptr v0 to i256
    mstore v1, arg0
    v2 = add v1, 32
    mstore v2, arg0
    v3 = keccak256 v1, 64
    ret v3
}

// The hash reads the second data word, which nothing wrote.
// CHECK-LABEL: {{^[ +].*}}fn @partial{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK: ret
fn @partial(arg0: i256) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, zeroed, panic, 96
    set_memory_object_len memorybytes, v0, 64
    memory_object_store_word memorybytes, v0, 0, arg0
    v1 = keccak256_bytes v0
    ret v1
}

// A read of a word before it is written sees the zeroing.
// CHECK-LABEL: {{^[ +].*}}fn @read_first{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK: ret
fn @read_first(arg0: i256) -> i256 {
  bb0:
    v0 = alloc raw, exact, zeroed, infallible, 32
    v1 = ptrtoint memptr v0 to i256
    v2 = mload v1
    mstore v1, arg0
    ret v2
}

// Gas observations keep the zeroing they would measure.
// CHECK-LABEL: {{^[ +].*}}fn @gas{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK: ret
fn @gas(arg0: i256) -> i256 {
  bb0:
    v0 = alloc raw, exact, zeroed, infallible, 32
    v1 = gas
    v2 = ptrtoint memptr v0 to i256
    mstore v2, arg0
    ret v1
}

// A write through a pointer that a phi merges may reach an earlier instance
// of the loop's allocation, not the new one.
// CHECK-LABEL: {{^[ +].*}}fn @loop_merge{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK: ret
fn @loop_merge(arg0: i256) {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: undef memptr], [bb2: v3]
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = alloc raw, exact, zeroed, infallible, 32
    v4 = ptrtoint memptr v0 to i256
    mstore v4, 7
    v5 = add v1, 1
    jump bb1
  bb3:
    ret
}

// A loop's allocation that no phi carries is new in every write.
// CHECK-LABEL: {{^[ +].*}}fn @loop_fresh{{[( ]}}
// CHECK: + {{v[0-9]+}} = alloc raw, exact, uninitialized, infallible, 32
fn @loop_fresh(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v5]
    v1 = phi [bb0: 0], [bb2: v6]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = alloc raw, exact, zeroed, infallible, 32
    v4 = ptrtoint memptr v3 to i256
    mstore v4, v0
    v6 = keccak256 v4, 32
    v5 = add v0, 1
    jump bb1
  bb3:
    ret v1
}
