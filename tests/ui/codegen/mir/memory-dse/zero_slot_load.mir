//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module ZeroSlotLoad

// The zero slot holds zero, so a load of it folds while nothing in the module may write it.
// CHECK-LABEL: {{^[ +].*}}fn @folds{{[( ]}}
// CHECK: + ret 0
fn @folds() -> i256 {
  bb0:
    mstore 0, 7
    v0 = mload 96
    ret v0
}
