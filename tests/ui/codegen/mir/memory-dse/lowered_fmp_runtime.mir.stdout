  bb0:
    mstore 64, arg0 !metadata(memory=scratch)
    ret
}

fn @f(arg0: i256) [selector=0xb3de648b, pure, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
