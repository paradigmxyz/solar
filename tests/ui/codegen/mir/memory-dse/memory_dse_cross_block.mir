//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemoryDseCrossBlock

// CHECK-LABEL: {{^[ +].*}}fn @remove_store_overwritten_on_unique_edge{{[( ]}}
// CHECK: - mstore 128, 1
// CHECK: + ret 2
fn @remove_store_overwritten_on_unique_edge() -> i256 {
  bb0:
    mstore 128, 1
    jump bb1
  bb1:
    mstore 128, 2
    v3 = mload 128
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_store_read_before_successor_overwrite{{[( ]}}
// CHECK: {{^[ +].*}}mstore 128, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload 128
fn @keep_store_read_before_successor_overwrite() -> i256 {
  bb0:
    mstore 128, 1
    jump bb1
  bb1:
    v2 = mload 128
    mstore 128, 2
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_store_into_multi_pred_successor{{[( ]}}
// CHECK: {{^[ +].*}}mstore 128, 1
// CHECK: + ret 2
fn @keep_store_into_multi_pred_successor(arg0: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 128, 1
    jump bb3
  bb2:
    jump bb3
  bb3:
    mstore 128, 2
    v4 = mload 128
    ret v4
}

// A halt discards memory without reading it, so a store that reaches only a
// `stop` or an overwrite is dead.
// CHECK-LABEL: {{^[ +].*}}fn @remove_store_before_stop{{[( ]}}
// CHECK: - mstore 0, 1
// CHECK: {{^[ +].*}}mstore 0, 2
fn @remove_store_before_stop(arg0: i1) {
  bb0:
    mstore 0, 1
    jumpi arg0, bb1, bb2
  bb1:
    stop
  bb2:
    mstore 0, 2
    revert 0, 32
}

// A word load that ends at the top of the 64-bit address space walks its last slot without
// overflowing the slot cursor; the store it cannot reach stays dead.
// CHECK-LABEL: {{^[ +].*}}fn @read_at_address_space_end{{[( ]}}
// CHECK: - mstore 128, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = mload 0xffffffffffffffde
fn @read_at_address_space_end() {
  bb0:
    mstore 128, 1
    jump bb1
  bb1:
    v3 = mload 0xffffffffffffffde
    mstore 128, 2
    sstore 0, v3
    stop
}
