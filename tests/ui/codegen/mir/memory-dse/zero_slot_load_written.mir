//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module ZeroSlotLoadWritten

// A store that may reach the zero slot, here in another function, keeps every load of it.
// CHECK-LABEL: {{^[ +].*}}fn @keeps{{[( ]}}
// CHECK: {{^ .*}}mload 96
fn @keeps() -> i256 {
  bb0:
    v0 = mload 96
    mstore 0, v0
    ret v0
}

fn @writes(arg0: i256) {
  bb0:
    mstore arg0, 7
    ret
}
