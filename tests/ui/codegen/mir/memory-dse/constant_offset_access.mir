//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module ConstantOffsetAccess

// A successful word read bounds its address before the constant addition executes, so the
// later read cannot wrap to the scratch word. Keep the first read live through the result.
// CHECK-LABEL: {{^[ +].*}}fn @after_word_read{{[( ]}}
// CHECK: - mstore 0, 7
// CHECK: {{^[ +].*}}returndata 128, 32
fn @after_word_read() {
  bb0:
    mstore 0, 7
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = mload v0
    v2 = add v0, 32
    v3 = mload v2
    v4 = add v1, v3
    mstore 128, v4
    returndata 128, 32
}

// A preceding word write provides the same bound. Preserve that proof when canonicalizing
// the copy's source, including when the addition has the constant as its first operand.
// CHECK-LABEL: {{^[ +].*}}fn @after_word_store_copy{{[( ]}}
// CHECK: - mstore 0, 7
// CHECK: {{^[ +].*}}mcopy 128,
// CHECK: {{^[ +].*}}returndata {{v[0-9]+}}, 64
fn @after_word_store_copy() {
  bb0:
    mstore 0, 7
    v0 = mload 64 !metadata(alloc_ptr)
    mstore v0, 9
    v1 = add 32, v0
    mcopy 128, v1, 32
    returndata v0, 64
}

// A zero-length access ignores its address, so the copy's source can still wrap to scratch.
// CHECK-LABEL: {{^[ +].*}}fn @after_zero_length_access{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^[ +].*}}mcopy 128,
fn @after_zero_length_access() {
  bb0:
    mstore 0, 7
    v0 = mload 64 !metadata(alloc_ptr)
    calldatacopy v0, 0, 0
    v1 = add v0, 32
    mcopy 128, v1, 32
    returndata 128, 32
}

// An access after the copy cannot prove its source did not wrap when the copy ran.
// CHECK-LABEL: {{^[ +].*}}fn @access_after_copy{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^[ +].*}}mcopy 128,
fn @access_after_copy() {
  bb0:
    mstore 0, 7
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 32
    mcopy 128, v1, 32
    v2 = mload v0
    mstore 160, v2
    returndata 128, 64
}

// An access in one diamond arm does not bound the base on the path through the other arm.
// CHECK-LABEL: {{^[ +].*}}fn @access_on_other_arm{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK: {{^[ +].*}}mcopy 128,
fn @access_on_other_arm(arg0: i1) {
  bb0:
    mstore 0, 7
    v0 = mload 64 !metadata(alloc_ptr)
    jumpi arg0, bb1, bb2
  bb1:
    v1 = mload v0
    mstore 160, v1
    jump bb3
  bb2:
    jump bb3
  bb3:
    v2 = add v0, 32
    mcopy 128, v2, 32
    returndata 128, 64
}

// With a heap base, a wrapped offset of 32 lands below 32. A word store there ends before
// slot 64, so it cannot change the free memory pointer even without a no-wrap proof.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_store_below_fmp{{[( ]}}
// CHECK: - {{v[0-9]+}} = mload 64
// CHECK: + ret 512
fn @wrapped_store_below_fmp() -> i256 {
  bb0:
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 32
    mstore 64, 512
    mstore v1, 7
    v2 = mload 64
    ret v2
}

// A wrapped offset of 64 can put part of a word in the FMP slot, so its reload must remain.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_store_overlaps_fmp{{[( ]}}
// CHECK: {{^ +}}mstore {{v[0-9]+}}, 7
// CHECK: {{^ +}}[[RELOAD:v[0-9]+]] = mload 64
// CHECK-NEXT: ret [[RELOAD]]
fn @wrapped_store_overlaps_fmp() -> i256 {
  bb0:
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 64
    mstore 64, 512
    mstore v1, 7
    v2 = mload 64
    ret v2
}

// A word read at base + 32 can touch [0, 64) after wrapping or [160, infinity) without
// wrapping. Only the complete words in the gap are dead.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_read_gap{{[( ]}}
// CHECK: {{^ +}}mstore 0, 7
// CHECK-NEXT: mstore 32, 8
// CHECK-NEXT: - mstore 64, 512
// CHECK-NEXT: - mstore 128, 9
// CHECK-NEXT: mstore 160, 10
fn @wrapped_read_gap() {
  bb0:
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 32
    mstore 0, 7
    mstore 32, 8
    mstore 64, 512
    mstore 128, 9
    mstore 160, 10
    returndata v1, 32
}

// Moving the read one byte further can expose the first byte of the FMP slot after wrapping.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_read_gap_boundary{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
// CHECK-NEXT: returndata
fn @wrapped_read_gap_boundary() {
  bb0:
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 33
    mstore 64, 512
    returndata v1, 32
}

// An unknown read size can extend the wrapped range into the gap.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_read_unknown_size{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
// CHECK-NEXT: returndata
fn @wrapped_read_unknown_size(arg0: i256) {
  bb0:
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 32
    mstore 64, 512
    returndata v1, arg0
}

// Overflow while computing the wrapped range's end must not discard live words.
// CHECK-LABEL: {{^[ +].*}}fn @wrapped_read_range_overflow{{[( ]}}
// CHECK: {{^ +}}mstore 64, 512
// CHECK-NEXT: returndata
fn @wrapped_read_range_overflow() {
  bb0:
    v0 = mload 64 !metadata(alloc_ptr)
    v1 = add v0, 18446744073709551615
    mstore 64, 512
    returndata v1, 32
}
