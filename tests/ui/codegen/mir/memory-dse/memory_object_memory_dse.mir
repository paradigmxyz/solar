//@compile-flags: -Zmir-pipeline=memory-dse,dce
//@filecheck:
@module MemoryObjectMemoryDse

// CHECK-LABEL: {{^[ +].*}}fn @forward_length{{[( ]}}
// CHECK: + ret 39
fn @forward_length(arg0: memorybytes) -> u256 {
  bb0:
    set_memory_object_len memorybytes, arg0, 39
    v1 = memory_object_len memorybytes, arg0
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_length_after_clobber{{[( ]}}
// CHECK: {{^[ +].*}}mstore arg1, 7
// CHECK: {{^[ +].*}}{{v[0-9]+}} = memory_object_len
fn @keep_length_after_clobber(arg0: memorybytes, arg1: u256) -> u256 {
  bb0:
    set_memory_object_len memorybytes, arg0, 39
    mstore arg1, 7
    v2 = memory_object_len memorybytes, arg0
    ret v2
}

// CHECK-LABEL: fn @store_bytes_reads_memory
// CHECK: {{^[ +].*}}set_memory_object_len memorybytes, arg1, 32
// CHECK: {{^[ +].*}}memory_object_store_word memorybytes, arg1, 0, 7
// CHECK: {{^[ +].*}}store_storage_bytes arg0, arg1
fn @store_bytes_reads_memory(arg0: u256, arg1: memorybytes) {
  bb0:
    set_memory_object_len memorybytes, arg1, 32
    memory_object_store_word memorybytes, arg1, 0, 7
    store_storage_bytes arg0, arg1
    ret
}
