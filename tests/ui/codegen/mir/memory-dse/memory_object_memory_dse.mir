//@compile-flags: -Zmir-pipeline=memory-dse,dce
//@filecheck:
@module MemoryObjectMemoryDse

// CHECK-LABEL: {{^[ +].*}}fn @forward_length{{[( ]}}
// CHECK: + ret 39
fn @forward_length(arg0: ptr<memory>) -> i256 {
  bb0:
    v0 = ptrtoint ptr<memory> arg0 to i256
    store v0, 39
    v1 = load arg0
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_length_after_clobber{{[( ]}}
// CHECK: {{^[ +].*}}store arg1, 7
// CHECK: {{^[ +].*}}{{v[0-9]+}} = load arg0
fn @keep_length_after_clobber(arg0: ptr<memory>, arg1: i256) -> i256 {
  bb0:
    v0 = ptrtoint ptr<memory> arg0 to i256
    store v0, 39
    store arg1, 7
    v2 = load arg0
    ret v2
}

// CHECK-LABEL: fn @store_bytes_reads_memory
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 32
// CHECK: {{^[ +].*}}[[DATA:v[0-9]+]] = ptradd arg1, 32
// CHECK-NEXT: {{^[ +].*}}store [[DATA]], 7
// CHECK: {{^[ +].*}}store_storage_bytes arg0, arg1
fn @store_bytes_reads_memory(arg0: i256, arg1: ptr<memory>) {
  bb0:
    v0 = ptrtoint ptr<memory> arg1 to i256
    store v0, 32
    v1 = ptradd arg1, 32
    store v1, 7
    store_storage_bytes arg0, arg1
    ret
}

// CHECK-LABEL: fn @acyclic_shared_exit
// CHECK: + ret 39
fn @acyclic_shared_exit(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v3 = ne arg0, 0
    jumpi v3, bb3, bb1
  bb1:
    v0 = alloc 64
    v6 = ptrtoint ptr<memory> v0 to i256
    store v6, 39
    v7 = ptradd v0, 32
    v1 = ptrtoint ptr<memory> v7 to i256
    store v1, 7
    v2 = load v6
    v4 = ne arg1, 0
    jumpi v4, bb3, bb2
  bb2:
    ret v2
  bb3:
    ret 0
}
