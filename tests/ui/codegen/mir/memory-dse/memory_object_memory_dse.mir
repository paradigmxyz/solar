//@compile-flags: -Zmir-pipeline=memory-dse,dce
//@filecheck:
@module MemoryObjectMemoryDse

// A length read goes through a `memory_slice` view, which memory DSE does
// not forward a stored header word into.
// CHECK-LABEL: {{^[ +].*}}fn @forward_length{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 39
// CHECK: {{^[ +].*}}[[S:v[0-9]+]] = memory_slice arg0
// CHECK: {{^[ +].*}}[[L:v[0-9]+]] = slice_len [[S]]
// CHECK: {{^[ +].*}}ret [[L]]
fn @forward_length(arg0: memptr) -> i256 {
  bb0:
    v0 = ptrtoint memptr arg0 to i256
    mstore v0, 39
    v2 = memory_slice arg0
    v1 = slice_len v2
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_length_after_clobber{{[( ]}}
// CHECK: {{^[ +].*}}mstore arg1, 7
// CHECK: {{^[ +].*}}{{v[0-9]+}} = memory_slice
// CHECK: {{^[ +].*}}{{v[0-9]+}} = slice_len
fn @keep_length_after_clobber(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    v0 = ptrtoint memptr arg0 to i256
    mstore v0, 39
    mstore arg1, 7
    v3 = memory_slice arg0
    v2 = slice_len v3
    ret v2
}

// CHECK-LABEL: fn @store_bytes_reads_memory
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 32
// CHECK: {{^[ +].*}}slice_store_word {{v[0-9]+}}, 0, 7
// CHECK: {{^[ +].*}}store_storage_bytes arg0, arg1
fn @store_bytes_reads_memory(arg0: i256, arg1: memptr) {
  bb0:
    v0 = ptrtoint memptr arg1 to i256
    mstore v0, 32
    v1 = memory_slice arg1
    slice_store_word v1, 0, 7
    store_storage_bytes arg0, arg1
    ret
}

// CHECK-LABEL: fn @acyclic_shared_exit
// CHECK: + ret 39
fn @acyclic_shared_exit(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v3 = ne arg0, 0
    jumpi v3, bb3, bb1
  bb1:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v6 = ptrtoint memptr v0 to i256
    mstore v6, 39
    v7 = memory_slice v0
    v1 = slice_ptr v7
    mstore v1, 7
    v2 = mload v6
    v4 = ne arg1, 0
    jumpi v4, bb3, bb2
  bb2:
    ret v2
  bb3:
    ret 0
}
