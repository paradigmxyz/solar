- // === ROOT/tests/ui/codegen/mir/memory-dse/scratch_encoding_fmp.mir (before memory-dse) ===
+ // === ROOT/tests/ui/codegen/mir/memory-dse/scratch_encoding_fmp.mir (after memory-dse) ===
  @module ScratchEncodingFmp
  fn @scratch() {
    bb0:
      mstore 64, 256
      v0 = abi_encode [word], scratch, args 42
      v1 = extract_value slice<memory>, v0, 0
      returndata v1, 32
  }
  
  fn @dynamic_scratch(arg0: slice<calldata>) {
    bb0:
      mstore 64, 256
      v0 = abi_encode [calldata_bytes], scratch, args arg0
      v1 = extract_value slice<memory>, v0, 0
      v2 = extract_value slice<memory>, v0, 1
      returndata v1, v2
  }
  
