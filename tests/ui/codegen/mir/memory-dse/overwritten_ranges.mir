//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module OverwrittenRanges

// CHECK-LABEL: @remove_allocation_fill
// CHECK: - memory_zero v0, 64
// CHECK: {{^[ +].*}}mstore v0, 7
// CHECK: {{^[ +].*}}mstore v1, 9
fn @remove_allocation_fill() -> ptr<memory> {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    mstore v0, 7
    v1 = ptradd v0, 32
    mstore v1, 9
    ret v0
}

// CHECK-LABEL: @remove_unaligned_copy
// CHECK: - calldatacopy 257, 0, 64
// CHECK: {{^[ +].*}}mstore 289, 9
fn @remove_unaligned_copy() {
  bb0:
    calldatacopy 257, 0, 64
    mstore 257, 7
    mstore 289, 9
    returndata 257, 64
}

// CHECK-LABEL: @keep_partial_overwrite
// CHECK: {{^[ +].*}}calldatacopy 256, 0, 64
fn @keep_partial_overwrite() {
  bb0:
    calldatacopy 256, 0, 64
    mstore 256, 7
    returndata 256, 64
}

// CHECK-LABEL: @keep_dynamic_length
// CHECK: {{^[ +].*}}calldatacopy 256, 0, arg0
fn @keep_dynamic_length(arg0: i256) {
  bb0:
    calldatacopy 256, 0, arg0
    mstore 256, 7
    mstore 288, 9
    returndata 256, 64
}

// CHECK-LABEL: @keep_read_fill
// CHECK: {{^[ +].*}}calldatacopy 256, 0, 64
// CHECK: {{^[ +].*}}v0 = keccak256 287, 2
fn @keep_read_fill() -> i256 {
  bb0:
    calldatacopy 256, 0, 64
    v0 = keccak256 287, 2
    mstore 256, 7
    mstore 288, 9
    ret v0
}

// CHECK-LABEL: @keep_gas_observer
// CHECK: {{^[ +].*}}memory_zero 256, 64
// CHECK: {{^[ +].*}}v0 = gas
fn @keep_gas_observer() -> i256 {
  bb0:
    memory_zero 256, 64
    mstore 256, 7
    v0 = gas
    mstore 288, 9
    ret v0
}

// CHECK-LABEL: @keep_expansion_observer
// CHECK: {{^[ +].*}}calldatacopy 256, 0, 64
// CHECK: {{^[ +].*}}v0 = msize
fn @keep_expansion_observer() -> i256 {
  bb0:
    calldatacopy 256, 0, 64
    mstore 256, 7
    v0 = msize
    mstore 288, 9
    ret v0
}

// CHECK-LABEL: @keep_returndata_bounds_check
// CHECK: {{^[ +].*}}returndatacopy 256, 0, 64
fn @keep_returndata_bounds_check() {
  bb0:
    returndatacopy 256, 0, 64
    mstore 256, 7
    mstore 288, 9
    returndata 256, 64
}

// An empty copy still charges gas, even though no memory word needs overwriting.
// CHECK-LABEL: @keep_empty_copy_before_gas
// CHECK: {{^[ +].*}}calldatacopy 256, 0, 0
// CHECK: {{^[ +].*}}v0 = gas
fn @keep_empty_copy_before_gas() -> i256 {
  bb0:
    calldatacopy 256, 0, 0
    v0 = gas
    mstore 256, 7
    ret v0
}
