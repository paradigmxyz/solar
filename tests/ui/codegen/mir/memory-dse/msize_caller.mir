//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module MemoryDseMsizeCaller

// No instruction of `@frame` reads its frame slot, and the slot lies below the free-memory pointer,
// the lower bound `msize` promises, so the store goes even though the caller reads `msize`.
// CHECK-LABEL: fn @frame{{[( ]}}
// CHECK-NOT: {{^[ +]+}}mstore
// CHECK: {{^[ +]+}}ret arg0
fn @frame(arg0: i256) -> i256 {
  bb0:
    v0 = internal_frame_addr 128
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    ret arg0
}

fn @caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @frame, arg0
    v1 = msize
    v2 = add v0, v1
    ret v2
}

// A callee that reads `msize` is a barrier for block-local store elimination.
// CHECK-LABEL: @icall_msize_barrier
// CHECK: {{^ +}}mstore 0x1000, 42
// CHECK: {{^ +}}{{v[0-9]+}} = icall @observe_msize
// CHECK: {{^ +}}mstore 0x1000, 0
fn @icall_msize_barrier() -> i256 {
  bb0:
    mstore 4096, 42
    v0 = icall @observe_msize
    mstore 4096, 0
    ret v0
}

fn @observe_msize() -> i256 {
  bb0:
    v0 = msize
    ret v0
}
