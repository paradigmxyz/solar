//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module WriteOnlyAllocations

// A deferred allocation whose pointer only addresses stores holds words
// nothing reads, so its stores go and the allocation stays for placement.
// CHECK-LABEL: {{^[ +].*}}fn @write_only{{[( ]}}
// CHECK: alloc 64 !metadata(deferred_alloc)
// CHECK-NEXT: - mstore
// CHECK: - mstore
// CHECK: {{^[ +].*}}returndata
fn @write_only(arg0: i256, arg1: i256) {
  bb0:
    v0 = alloc 64 !metadata(deferred_alloc)
    mstore v0, arg0
    v1 = ptradd v0, 32
    mstore v1, arg1
    mstore 128, arg0
    returndata 128, 32
}

// A read through the pointer keeps the stores.
// CHECK-LABEL: {{^[ +].*}}fn @read_back{{[( ]}}
// CHECK-NOT: {{^-}} mstore
// CHECK-LABEL: {{^[ +].*}}fn @escapes{{[( ]}}
fn @read_back(arg0: i256, arg1: i1) {
  bb0:
    v0 = alloc 32 !metadata(deferred_alloc)
    mstore v0, arg0
    jumpi arg1, bb1, bb2
  bb1:
    v1 = mload v0
    mstore 128, v1
    returndata 128, 32
  bb2:
    stop
}

// Storing the pointer as data lets other code reach the object.
// CHECK-NOT: {{^-}} mstore
// CHECK-LABEL: {{^[ +].*}}fn @observes_msize{{[( ]}}
fn @escapes(arg0: i256) {
  bb0:
    v0 = alloc 32 !metadata(deferred_alloc)
    mstore v0, arg0
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore 128, v1
    returndata 128, 32
}

// The allocation lies below the free-memory pointer, so `msize` does not keep its stores.
// CHECK: alloc 32 !metadata(deferred_alloc)
// CHECK-NEXT: - mstore
// CHECK-LABEL: {{^[ +].*}}fn @heap_allocation{{[( ]}}
fn @observes_msize(arg0: i256) {
  bb0:
    v0 = alloc 32 !metadata(deferred_alloc)
    mstore v0, arg0
    v1 = msize
    mstore 128, v1
    returndata 128, 32
}

// A read that may alias the allocation, such as `returndata 128, 32`, keeps its stores.
// CHECK-NOT: {{^-}} mstore
fn @heap_allocation(arg0: i256) {
  bb0:
    v0 = alloc 32
    mstore v0, arg0
    mstore 128, arg0
    returndata 128, 32
}

// Copies and fills into the object are writes too, but a failing `returndatacopy` stays.
// CHECK-LABEL: {{^[ +].*}}fn @copies{{[( ]}}
// CHECK: alloc 64 !metadata(deferred_alloc)
// CHECK-NEXT: {{^ .*}}v1 = ptradd v0, 32
// CHECK-NEXT: - calldatacopy
// CHECK-NEXT: - memory_zero
// CHECK-NEXT: {{^ .*}}returndatacopy
fn @copies() {
  bb0:
    v0 = alloc 64 !metadata(deferred_alloc)
    v1 = ptradd v0, 32
    calldatacopy v1, 4, 32
    memory_zero v0, 32
    returndatacopy v1, 0, 32
    stop
}

// Placement does not prove copies unread: a read that may alias the object keeps them.
// CHECK-LABEL: {{^[ +].*}}fn @copy_with_aliasing_read{{[( ]}}
// CHECK: {{^ .*}}calldatacopy
fn @copy_with_aliasing_read() {
  bb0:
    v0 = alloc 64 !metadata(deferred_alloc)
    calldatacopy v0, 4, 32
    returndata 128, 32
}
