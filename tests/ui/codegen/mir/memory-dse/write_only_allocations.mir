//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module WriteOnlyAllocations

// A deferred allocation whose pointer only addresses stores holds words
// nothing reads, so its stores go and the allocation stays for placement.
// CHECK-LABEL: {{^[ +].*}}fn @write_only{{[( ]}}
// CHECK: alloc 64 !metadata(deferred_alloc)
// CHECK-NEXT: - mstore
// CHECK: - mstore
// CHECK: {{^[ +].*}}returndata
fn @write_only(arg0: i256, arg1: i256) {
  bb0:
    v0 = alloc 64 !metadata(deferred_alloc)
    mstore v0, arg0
    v1 = ptradd v0, 32
    mstore v1, arg1
    mstore 128, arg0
    returndata 128, 32
}

// A read through the pointer keeps the stores.
// CHECK-LABEL: {{^[ +].*}}fn @read_back{{[( ]}}
// CHECK-NOT: {{^-}} mstore
// CHECK-LABEL: {{^[ +].*}}fn @escapes{{[( ]}}
fn @read_back(arg0: i256, arg1: i1) {
  bb0:
    v0 = alloc 32 !metadata(deferred_alloc)
    mstore v0, arg0
    jumpi arg1, bb1, bb2
  bb1:
    v1 = mload v0
    mstore 128, v1
    returndata 128, 32
  bb2:
    stop
}

// Storing the pointer as data lets other code reach the object.
// CHECK-NOT: {{^-}} mstore
// CHECK-LABEL: {{^[ +].*}}fn @observes_msize{{[( ]}}
fn @escapes(arg0: i256) {
  bb0:
    v0 = alloc 32 !metadata(deferred_alloc)
    mstore v0, arg0
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore 128, v1
    returndata 128, 32
}

// Fewer writes can mean less memory expansion, which `msize` reports.
// CHECK-NOT: {{^-}} mstore
// CHECK-LABEL: {{^[ +].*}}fn @heap_allocation{{[( ]}}
fn @observes_msize(arg0: i256) {
  bb0:
    v0 = alloc 32 !metadata(deferred_alloc)
    mstore v0, arg0
    v1 = msize
    mstore 128, v1
    returndata 128, 32
}

// A heap allocation may be reached from the free-memory pointer.
// CHECK-NOT: {{^-}} mstore
fn @heap_allocation(arg0: i256) {
  bb0:
    v0 = alloc 32
    mstore v0, arg0
    mstore 128, arg0
    returndata 128, 32
}
