//@compile-flags: -Zmir-pipeline=memory-dse
//@filecheck:
@module AbiEncodeMemoryEffects

// CHECK-LABEL: {{^[ +].*}}fn @encode{{[( ]}}
// CHECK: {{^[ +].*}}mstore arg0, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = abi_encode
fn @encode(arg0: i256) -> slice<memory> {
  bb0:
    mstore arg0, 1
    v1 = inttoptr i256 arg0 to ptr<memory>
    v0 = abi_encode [memory_bytes], args v1
    ret v0
}

// CHECK-LABEL: fn @require_reads_message
// CHECK: {{^[ +].*}}mstore arg1, 1
// CHECK: {{^[ +].*}}icall require<error_string>, arg0, {{v[0-9]+}}
fn @require_reads_message(arg0: i1, arg1: i256) {
  bb0:
    mstore arg1, 1
    v0 = inttoptr i256 arg1 to ptr<memory>
    icall require<error_string>, arg0, v0
    ret
}

// CHECK-LABEL: fn @require_reads_children
// CHECK: {{^[ +].*}}[[CHILD:v[0-9]+]] = ptrtoint ptr<memory> {{v[0-9]+}} to i256
// CHECK: {{^[ +].*}}mstore [[CHILD]], 7
// CHECK: {{^[ +].*}}icall require<custom_error
fn @require_reads_children(arg0: i1) {
  bb0:
    v3 = alloc 32
    v0 = ptrtoint ptr<memory> v3 to i256
    v4 = alloc 32
    v1 = ptrtoint ptr<memory> v4 to i256
    mstore v0, 7
    mstore v1, v0
    v5 = inttoptr i256 v1 to ptr<memory>
    icall require<custom_error [array<1, memory_bytes>]>, arg0, 0, v5
    ret
}

// CHECK-LABEL: fn @packed_reads_children
// CHECK: {{^[ +].*}}[[CHILD:v[0-9]+]] = ptrtoint ptr<memory> {{v[0-9]+}} to i256
// CHECK: {{^[ +].*}}mstore [[CHILD]], 7
// CHECK: {{^[ +].*}}abi_encode_packed
fn @packed_reads_children() -> ptr<memory> {
  bb0:
    v5 = alloc 32
    v0 = ptrtoint ptr<memory> v5 to i256
    v6 = alloc 32
    v1 = ptrtoint ptr<memory> v6 to i256
    mstore v0, 7
    mstore v1, v0
    v7 = inttoptr i256 v1 to ptr<memory>
    v2 = abi_encode_packed (array<array<1, word>> memoryfixedarray<1, 1> v7)
    ret v2
}

// An encoding's allocation ID is not an explicit `alloc`. Reading beyond its slice can
// observe a later object's store, and must not index the explicit-allocation position map.
// CHECK-LABEL: {{^[ +].*}}fn @encoded_slice_reads_next_object{{[( ]}}
// CHECK: {{^ +}}mstore v2, arg0
// CHECK: {{^ +}}v4 = mload v3
fn @encoded_slice_reads_next_object(arg0: i256) -> i256 {
  bb0:
    v0 = abi_encode [word], args 1
    v1 = extract_value slice<memory>, v0, 0
    v2 = alloc 32
    mstore v2, arg0
    v3 = ptradd v1, 32
    v4 = mload v3
    ret v4
}

// Terminator reads of semantic allocations need the same conservative fallback across blocks.
// CHECK-LABEL: {{^[ +].*}}fn @encoded_slice_returns_next_object{{[( ]}}
// CHECK: {{^ +}}mstore v2, arg0
// CHECK: {{^ +}}returndata v1, 64
fn @encoded_slice_returns_next_object(arg0: i256) {
  bb0:
    v0 = abi_encode [word], args 1
    v1 = extract_value slice<memory>, v0, 0
    jump bb1
  bb1:
    v2 = alloc 32
    mstore v2, arg0
    jump bb2
  bb2:
    returndata v1, 64
}
