  fn @cancelled_word(arg0: i256) -> i256 {
    bb0:
      v0 = alloc 32
      v1 = ptrtoint ptr<memory> v0 to i256
      v2 = alloc 32
      v3 = ptrtoint ptr<memory> v2 to i256
      store v3, 7
      v4 = add v1, 32
      v5 = sub v4, arg0
      v6 = add arg0, v5
      store v6, 9
      v7 = load v3
      ret v7
  }
  
  fn @crossing_word(arg0: i256) -> i256 {
    bb0:
