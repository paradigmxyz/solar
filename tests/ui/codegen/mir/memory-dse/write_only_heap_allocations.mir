//@compile-flags: -Zmir-pipeline=memory-dse,dce
//@filecheck:
@module WriteOnlyHeapAllocations

// An object filled by a copy but never read loses the copy. The allocation's
// own free-memory-pointer read happens before the object exists, so it does
// not read it. The checked allocation remains because its failure and FMP
// bump are observable.
// CHECK-LABEL: after memory-dse
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc zeroed checked 64
// CHECK: - calldatacopy {{v[0-9]+}}, 4, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc zeroed checked 64
fn @unread(arg0: i256) -> i256 {
  bb0:
    v0 = alloc zeroed checked 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint ptr<memory> v9001 to i256
    calldatacopy v1, 4, 32
    ret arg0
}

// A read of the allocation keeps every write.
// CHECK-LABEL: {{^[ +].*}}fn @read{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc 64
// CHECK: {{^[ +].*}}calldatacopy {{v[0-9]+}}, 4, 32
fn @read(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint ptr<memory> v9001 to i256
    calldatacopy v1, 4, 32
    v2 = mload v1
    ret v2
}

// A read through a non-derived alias may observe the allocation.
// CHECK-LABEL: {{^[ +].*}}fn @absolute_alias{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @absolute_alias() -> i256 {
  bb0:
    v0 = alloc 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint ptr<memory> v9001 to i256
    mstore v1, 7
    v2 = mload 128
    ret v2
}

// Storing a derived pointer byte lets later code reconstruct an alias.
// CHECK-LABEL: {{^[ +].*}}fn @mstore8_escape{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 9
fn @mstore8_escape() -> i256 {
  bb0:
    v0 = alloc 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint ptr<memory> v9001 to i256
    mstore v1, 9
    mstore8 0, v1
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @zero_sized_write{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @zero_sized_write() -> i256 {
  bb0:
    v8 = alloc 0
    v0 = ptrtoint ptr<memory> v8 to i256
    mstore v0, 7
    v9 = fmp
    v1 = ptrtoint ptr<memory> v9 to i256
    v2 = mload v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @write_past_allocation{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @write_past_allocation() -> i256 {
  bb0:
    v10 = alloc 32
    v0 = ptrtoint ptr<memory> v10 to i256
    v11 = alloc 32
    v1 = ptrtoint ptr<memory> v11 to i256
    v2 = add v0, 32
    mstore v2, 7
    v3 = mload v1
    ret v3
}

// An indexed store whose loop guard bounds the index stays inside the object.
// CHECK-LABEL: {{^[ +].*}}fn @guarded_loop{{[( ]}}
// CHECK: alloc 64
// CHECK-NOT: mstore
// CHECK: ret 0
fn @guarded_loop() -> i256 {
  bb0:
    v0 = alloc 64
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v1, 2
    jumpi v2, bb2, bb3
  bb2:
    v111 = shl v1, 5
    v9001 = ptradd v0, v111
    mstore v9001, 7
    v3 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @guarded_overrun{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @guarded_overrun(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 64
    v1 = lt arg0, 3
    jumpi v1, bb1, bb2
  bb1:
    v112 = shl arg0, 5
    v9001 = ptradd v0, v112
    mstore v9001, 7
    jump bb2
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @unguarded_join{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @unguarded_join(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 64
    v1 = lt arg0, 2
    jumpi v1, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v113 = shl arg0, 5
    v9001 = ptradd v0, v113
    mstore v9001, 7
    ret 0
}

// An allocation in a loop reads the free-memory pointer again on the next
// iteration, after the previous instance's writes, so they stay.
// CHECK-LABEL: {{^[ +].*}}fn @loop_allocation{{[( ]}}
// CHECK: {{^[ +].*}}alloc 64
// CHECK-NEXT: {{^ .*}}mstore {{v[0-9]+}}, 7
fn @loop_allocation(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v1, arg0
    jumpi v2, bb2, bb3
  bb2:
    v0 = alloc 64
    mstore v0, 7
    v3 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// `returndatacopy` past the end of the return data reverts, so it stays even
// though nothing reads the object.
// CHECK-LABEL: {{^[ +].*}}fn @returndata_trap{{[( ]}}
// CHECK: {{^ .*}}returndatacopy
fn @returndata_trap() -> i256 {
  bb0:
    v0 = alloc 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint ptr<memory> v9001 to i256
    returndatacopy v1, 0, 32
    ret 7
}
