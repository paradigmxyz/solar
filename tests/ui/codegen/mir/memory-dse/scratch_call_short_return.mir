//@ compile-flags: -Zmir-pipeline=memory-dse
//@ filecheck:
@module ScratchCallShortReturn

// A callee can return less than a word, so a call that does not clear its scratch word reads the
// word it finds there, and the store before it stays.
// CHECK-LABEL: fn @keeps_store
// CHECK: {{^[ +].*}}mstore 0, 7
// CHECK: extcall static scratch revert create
fn @keeps_store(arg0: i160) -> i256 {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    v0 = extcall static scratch revert create arg0, gas 50000
    mstore 0, 9 !metadata(memory=scratch)
    ret v0
}

// The clearing call writes the whole word itself, so the store before it is dead.
// CHECK-LABEL: fn @drops_store
// CHECK-NOT: {{^[ +].*}}mstore 0, 7
// CHECK: extcall static scratch_clear revert create
fn @drops_store(arg0: i160) -> i256 {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    v0 = extcall static scratch_clear revert create arg0, gas 50000
    mstore 0, 9 !metadata(memory=scratch)
    ret v0
}
