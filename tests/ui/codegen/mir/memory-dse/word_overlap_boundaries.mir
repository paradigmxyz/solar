//@ revisions: raw optimized
//@[raw] compile-flags: -Zmir-pipeline=none
//@[raw] filecheck: --check-prefixes=RAW,CHECK
//@[optimized] compile-flags: -Zmir-pipeline=memory-dse
//@[optimized] filecheck: --check-prefixes=OPT,CHECK
@module MemoryDseWordOverlap

// Disjoint full-word writes at offsets128 and96.
// CHECK-LABEL: fn @before_32_constant
// CHECK: {{^[ +].*}}log0 128, 32
// CHECK: {{^[ +].*}}mstore 96, 0
// CHECK: {{^[ +].*}}log0 96, 32
// RAW: mstore 128, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// OPT-NOT: {{^[ +].*}}mstore 128,
// CHECK: {{^[ +].*}}returndata 128, 32
fn @before_32_constant() {
  bb0:
    mstore 128, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    log0 128, 32
    mstore 96, 0
    log0 96, 32
    mstore 128, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    returndata 128, 32
}

// Disjoint full-word writes at offsets128 and96.
// CHECK-LABEL: fn @before_32_unknown
// CHECK: {{^[ +].*}}log0 128, 32
// CHECK: {{^[ +].*}}mstore 96, arg0
// CHECK: {{^[ +].*}}log0 96, 32
// RAW: mstore 128, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// OPT-NOT: {{^[ +].*}}mstore 128,
// CHECK: {{^[ +].*}}returndata 128, 32
fn @before_32_unknown(arg0: u256) {
  bb0:
    mstore 128, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    log0 128, 32
    mstore 96, arg0
    log0 96, 32
    mstore 128, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    returndata 128, 32
}

