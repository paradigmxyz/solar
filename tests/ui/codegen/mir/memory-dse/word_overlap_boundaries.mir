// Equal contents at the exact address still make the repeated store dead.
// CHECK-LABEL: fn @equal_store
// CHECK: {{^[ +].*}}mstore 128, 1
// CHECK: {{^[ +].*}}log0 128, 32
// RAW: mstore 128, 1
// OPT-NOT: {{^[ +].*}}mstore 128,
// CHECK: {{^[ +].*}}returndata 128, 32
fn @equal_store() {
  bb0:
    mstore 128, 1
    log0 128, 32
    mstore 128, 1
    returndata 128, 32
}
// A single-predecessor successor inherits the predecessor's known words.
// Its runtime-valued overlapping write must invalidate the inherited fact.
// CHECK-LABEL: fn @inherited_unknown
// CHECK: {{^[ +].*}}log0 128, 32
// CHECK: {{^[ +].*}}jump bb1
// CHECK: {{^[ +].*}}mstore 129, arg0
// CHECK: {{^[ +].*}}mstore 128, 1
// CHECK: {{^[ +].*}}returndata 128, 32
fn @inherited_unknown(arg0: u256) {
  bb0:
    mstore 128, 1
    log0 128, 32
    jump bb1
  bb1:
    mstore 129, arg0
    mstore 128, 1
    returndata 128, 32
}
