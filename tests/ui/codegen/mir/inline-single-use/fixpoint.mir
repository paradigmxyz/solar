//@ compile-flags: -Ogas -Zmir-pipeline=inline-single-use
//@ filecheck:
@module InlineFixpoint

// Removing the sole caller exposes the leaf's single remaining call on the next round.
// CHECK-LABEL: fn @entry
// CHECK-NOT: {{^[ +].*}}icall
// CHECK: + {{v[0-9]+}} = add arg0, 1
fn @entry(arg0: i256) -> i256 [selector=0x00000001] {
  bb0:
    v0 = icall @wrapper, arg0
    ret v0
}

fn @wrapper(arg0: i256) -> i256 {
  bb0:
    v0 = icall @leaf, arg0
    ret v0
}

fn @leaf(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}
