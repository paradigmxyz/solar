//@ compile-flags: -Ogas -Zmir-pipeline=inline-single-use
@module ScalarSingleUse
fn @entry(arg0: i256) -> i256 {
  bb0:
    v0 = icall @once, arg0
    v1 = icall @shared, v0
    v2 = icall @shared, v1
    ret v2
}

// Multiple scalar returns are merged in the caller; this body has exactly one call site.
fn @once(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, 7
    ret v1
  bb2:
    v2 = sub arg0, 3
    ret v2
}

// Shared helpers retain their calls.
fn @shared(arg0: i256) -> i256 {
  bb0:
    v0 = mul arg0, 3
    ret v0
}

fn @reference_caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @reference, arg0
    ret v0
}

// Reference returns retain their allocation/call convention.
fn @reference(arg0: i256) -> i256 {
  bb0:
    ret arg0
}

fn @tail_caller(arg0: i256) -> i256 {
  bb0:
    tail_call @tail_shared, arg0
}

fn @call_caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @tail_shared, arg0
    ret v0
}

// Tail calls count as call sites, so this body has two and retains its ordinary call.
fn @tail_shared(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, 7
    ret v1
  bb2:
    v2 = sub arg0, 3
    ret v2
}

fn @guarded_caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @guarded, arg0
    ret v0
}

// `outline-reverts` leaves failure paths as tail calls to shared revert helpers. Such a jump
// ends the message wherever it is cloned, so this body inlines.
fn @guarded(arg0: i256) -> i256 {
  bb0:
    v0 = gt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    tail_call @panic
  bb2:
    v1 = add arg0, 7
    ret v1
}

fn @panic() {
  bb0:
    mstore 32, 17
    mstore 0, 0x4e487b71
    revert 28, 36
}

fn @forward_caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @forward, arg0
    ret v0
}

// A tail call to a function that returns would return from the caller once cloned, so this
// body keeps its call.
fn @forward(arg0: i256) -> i256 {
  bb0:
    v0 = gt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    tail_call @returning, arg0
  bb2:
    ret arg0
}

fn @returning(arg0: i256) -> i256 {
  bb0:
    v0 = sub arg0, 10
    ret v0
}
