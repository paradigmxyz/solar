//@ compile-flags: -Ogas -Zmir-pipeline=inline-single-use
@module ScalarSingleUse
fn @entry(arg0: u256) -> u256 {
  bb0:
    v0 = icall @once, 1, arg0
    v1 = icall @shared, 1, v0
    v2 = icall @shared, 1, v1
    ret v2
}

// Multiple scalar returns are merged in the caller; this body has exactly one call site.
fn @once(arg0: u256) -> u256 {
  bb0:
    v0 = lt arg0, 10
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, 7
    ret v1
  bb2:
    v2 = sub arg0, 3
    ret v2
}

// Shared helpers retain their calls.
fn @shared(arg0: u256) -> u256 {
  bb0:
    v0 = mul arg0, 3
    ret v0
}

fn @reference_caller(arg0: memptr) -> memptr {
  bb0:
    v0 = icall @reference, 1, arg0
    ret v0
}

// Reference returns retain their allocation/call convention.
fn @reference(arg0: memptr) -> memptr {
  bb0:
    ret arg0
}
