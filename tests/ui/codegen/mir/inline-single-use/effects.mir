//@ compile-flags: -Ogas -Zmir-pipeline=inline-single-use
//@ filecheck:
@module SingleUseEffects

// A branchy helper that writes memory fits the stack budget at its one call
// site, so it is consumed.
// CHECK-LABEL: fn @store_caller
// CHECK-NOT: {{^[ +].*}}icall @store_max
// CHECK: + mstore arg0, arg1
fn @store_caller(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = icall @store_max, arg0, arg1
    ret v0
}

fn @store_max(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg1, 10
    jumpi v0, bb1, bb2
  bb1:
    mstore arg0, arg1
    jump bb3
  bb2:
    mstore arg0, 10
    jump bb3
  bb3:
    v1 = phi [bb1: arg1], [bb2: 10]
    ret v1
}

// A loop that writes memory would carry the caller's live words through every
// iteration, so it keeps its call.
// CHECK-LABEL: fn @fill_caller
// CHECK: {{^[ +].*}}icall @fill
fn @fill_caller(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = icall @fill, arg0, arg1
    ret v0
}

fn @fill(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg1
    jumpi v1, bb2, bb3
  bb2:
    v3 = add arg0, v0
    mstore v3, v0
    v2 = add v0, 32
    jump bb1
  bb3:
    ret v0
}
