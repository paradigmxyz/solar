    bb0:
      mstore 128, 1
      mstore8 159, arg0
      v0 = keccak256 128, 32
      ret v0
  }
  
  fn @unknown_alias(arg0: i256) -> i256 {
    bb0:
      mstore 128, 1
      mstore8 arg0, 9
      v0 = keccak256 128, 32
      ret v0
  }
  
  fn @partial() -> i256 {
    bb0:
      mstore8 128, 1
      v0 = keccak256 128, 32
      ret v0
  }
  
  fn @copy(arg0: i256) -> i256 {
    bb0:
      mstore 128, 1
      mcopy 128, arg0, 32
      v0 = keccak256 128, 32
      ret v0
  }
  
  fn @join(arg0: i1) -> i256 {
