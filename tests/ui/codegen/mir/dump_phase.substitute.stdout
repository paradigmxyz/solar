@module DumpPhase
fn @f(arg0: u256) -> u256 [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = add arg0, 0
    v4 = lt v3, arg0
    jumpi v4, bb3, bb4
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 17 !metadata(memory=scratch)
    revert 0, 36
  bb4:
    ret v3
}

