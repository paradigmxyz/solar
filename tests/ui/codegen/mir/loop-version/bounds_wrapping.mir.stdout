// === ROOT/tests/ui/codegen/mir/loop-version/bounds_wrapping.sol:BoundsWrapping ===
@module BoundsWrapping
; function empty(uint256 count) external pure returns (uint256) [selector 0xf3a3e4fe]
fn @empty(arg0: i256) -> i256 [selector=0xf3a3e4fe, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:  ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v1]
    v2 = phi [bb0: 0x10000000000000000], [bb3: v2]
    v3 = phi [bb0: 0], [bb3: v12]
    v4 = lt v3, v0
    jumpi v4, bb4, bb5
  bb5:  ; preds = bb1
    jump bb2
  bb2:  ; preds = bb5
    ret 7
  bb4:  ; preds = bb1
    v5 = mload v2
    v6 = lt v3, v5
    v7 = eq v6, false
    icall panic_if<0x32>, v7
    v8 = shl v3, 5
    v9 = inttoptr i256 v2 to ptr<memory>
    v10 = ptradd v9, v8
    v11 = ptradd v10, 32
    mstore v11, 0
    jump bb6
  bb6:  ; preds = bb4
    jump bb3
  bb3:  ; preds = bb6
    v12 = checked_add uint256, v3, 1
    jump bb1
}

; function wrapped(uint256 start, uint256 end) external pure returns (uint256) [selector 0x08a7c76d]
fn @wrapped(arg0: i256, arg1: i256) -> i256 [selector=0x08a7c76d, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = alloc zeroed checked 64
    mstore v0, 1
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v2 = icall @_write, v0, arg0, arg1
    ret v2
}

; function _write(uint256[] memory a, uint256 start, uint256 end) private pure returns (uint256 length)
fn @_write(arg0: ptr<memory>, arg1: i256, arg2: i256) -> i256 [pure] {
  bb0:
    v0 = mload arg0
    jump bb1
  bb1:  ; preds = bb0, bb3
    v1 = phi [bb0: arg0], [bb3: v1]
    v2 = phi [bb0: arg1], [bb3: v2]
    v3 = phi [bb0: arg2], [bb3: v3]
    v4 = phi [bb0: v0], [bb3: v4]
    v5 = phi [bb0: arg1], [bb3: v13]
    v6 = lt v5, v3
    jumpi v6, bb4, bb5
  bb5:  ; preds = bb1
    jump bb2
  bb2:  ; preds = bb5
    ret v4
  bb4:  ; preds = bb1
    v7 = mload v1
    v8 = lt v5, v7
    v9 = eq v8, false
    icall panic_if<0x32>, v9
    v10 = shl v5, 5
    v11 = ptradd v1, v10
    v12 = ptradd v11, 32
    mstore v12, 0
    jump bb6
  bb6:  ; preds = bb4
    jump bb3
  bb3:  ; preds = bb6
    v13 = checked_add uint256, v5, 1
    jump bb1
}
