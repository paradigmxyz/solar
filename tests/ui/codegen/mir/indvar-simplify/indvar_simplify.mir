//@compile-flags: -Zmir-pipeline=indvar-simplify
//@filecheck:
@module IndVarSimplify
// Two shifted address computations share one pointer phi. The raw word base
// may wrap, so the original counter still controls the loop.
// CHECK-LABEL: {{^[ +].*}}fn @strength_reduce_shifted_address{{[( ]}}
// CHECK: {{^ +}}[[INDEX:v[0-9]+]] = phi [bb0: 0], [bb2: {{v[0-9]+}}]
// CHECK: + [[ADDRESS:v[0-9]+]] = phi [bb0: arg0], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: {{^ +}}{{v[0-9]+}} = lt [[INDEX]], 4
// CHECK: + {{v[0-9]+}} = mload [[ADDRESS]]
// CHECK: + mstore [[ADDRESS]], {{v[0-9]+}}
// CHECK: + [[NEXT]] = add [[ADDRESS]], 32
fn @strength_reduce_shifted_address(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v6]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add arg0, v3
    v5 = mload v4
    v7 = shl 5, v1
    v8 = add arg0, v7
    v9 = add v5, 1
    mstore v8, v9
    v6 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// One shifted address saves only its shift and add per iteration, which
// does not pay for the latch update plus a second loop-carried word.
// CHECK-LABEL: {{^[ +].*}}fn @keep_shifted_address_single_use{{[( ]}}
// CHECK-NOT: + {{v[0-9]+}} = phi
// CHECK: {{^ +}}{{v[0-9]+}} = add arg0, {{v[0-9]+}}
// CHECK-NEXT: {{^ +}}mstore
fn @keep_shifted_address_single_use(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v6]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add arg0, v3
    mstore v4, v1
    v6 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @strength_reduce_scaled_address_with_offset{{[( ]}}
// CHECK: + [[START:v[0-9]+]] = add arg0, 4
// CHECK: + [[ADDRESS:v[0-9]+]] = phi [bb0: [[START]]], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: + mstore [[ADDRESS]], {{v[0-9]+}}
// CHECK: + [[NEXT]] = add [[ADDRESS]], 32
fn @strength_reduce_scaled_address_with_offset(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v7]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = mul v1, 32
    v4 = add arg0, v3
    v5 = add v4, 4
    mstore v5, v1
    v7 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// A lone `base + iv` at one site would trade an add for an add plus a carried
// pointer word, so it stays in place; scaled or offset addresses reduce above.
// CHECK-LABEL: {{^[ +].*}}fn @keep_scale_one_single_use{{[( ]}}
// CHECK-NOT: + {{v[0-9]+}} = phi
// CHECK: {{^ +}}{{v[0-9]+}} = add arg0, {{v[0-9]+}}
// CHECK-NEXT: {{^ +}}mstore8
fn @keep_scale_one_single_use(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = add arg0, v1
    mstore8 v3, v1
    v5 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// Checked recurrences and address expressions expose their successful values; their
// arithmetic still executes so strength reduction cannot discard a failure check.
// Two address uses pay for carrying the extra pointer under the stack cost model.
// CHECK-LABEL: {{^[ +].*}}fn @strength_reduce_checked_address{{[( ]}}
// CHECK: + [[ADDRESS:v[0-9]+]] = phi [bb0: arg0], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: {{^[ +].*}}checked_mul u256,
// CHECK: + mstore [[ADDRESS]], {{v[0-9]+}}
// CHECK: {{^[ +].*}}checked_add u256,
// CHECK: + [[NEXT]] = add [[ADDRESS]], 32
fn @strength_reduce_checked_address(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v6]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = checked_mul u256, v1, 32
    v4 = add arg0, v3
    mstore v4, v1
    v7 = add arg0, v3
    mstore v7, v1
    v6 = checked_add u256, v1, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @strength_reduce_commuted_checked_step{{[( ]}}
// CHECK: + [[ADDRESS:v[0-9]+]] = phi [bb0: arg0], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: + mstore [[ADDRESS]], {{v[0-9]+}}
// CHECK: {{^[ +].*}}checked_add u256, 1,
// CHECK: + [[NEXT]] = add [[ADDRESS]], 32
fn @strength_reduce_commuted_checked_step(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add arg0, v3
    mstore v4, v1
    v7 = add arg0, v3
    mstore v7, v1
    v5 = checked_add u256, 1, v1
    jump bb1
  bb3:
    ret 0
}

// Descending recurrences remain outside this transform's positive-stride contract.
// CHECK-LABEL: {{^[ +].*}}fn @keep_checked_descending_address{{[( ]}}
// CHECK: {{^[ +].*}}shl 5,
// CHECK: {{^[ +].*}}add arg0,
// CHECK: {{^[ +].*}}mstore
// CHECK: {{^[ +].*}}checked_sub u256,
fn @keep_checked_descending_address(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 4], [bb2: v6]
    v2 = gt v1, 0
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add arg0, v3
    mstore v4, v1
    v6 = checked_sub u256, v1, 1
    jump bb1
  bb3:
    ret 0
}

// Keep one shared address expression instead of maintaining a counter for each field.
// CHECK-LABEL: {{^[ +].*}}fn @keep_shared_field_addresses{{[( ]}}
// CHECK-NOT: + {{.*}}phi
// CHECK: {{^[ +].*}}shl 5,
// CHECK: {{^[ +].*}}mstore
// CHECK: {{^[ +].*}}mstore
fn @keep_shared_field_addresses(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v6]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add arg0, v3
    v5 = add v4, 16
    mstore v4, v1
    mstore v5, v1
    v6 = checked_add u256, v1, 1
    jump bb1
  bb3:
    ret 0
}

// The checked update must remain; another counter would only replace one add with another.
// CHECK-LABEL: {{^[ +].*}}fn @keep_checked_scale_one_address{{[( ]}}
// CHECK-NOT: + {{.*}}phi
// CHECK: {{^[ +].*}}add arg0,
// CHECK: {{^[ +].*}}mstore8
// CHECK: {{^[ +].*}}checked_add u256,
fn @keep_checked_scale_one_address(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = add arg0, v1
    mstore8 v3, v1
    v5 = checked_add u256, v1, 1
    jump bb1
  bb3:
    ret 0
}

// A counter that only one arm advances reaches its header phi through the
// arms' merge phi. The pointer mirrors that shape: a phi beside the merge and
// an add beside the update. The base is a memory pointer, so the exit test
// compares the pointer with its end and the counter, its merge and its update
// die; the address the exit block builds from the final counter is the
// pointer as well.
// CHECK-LABEL: {{^[ +].*}}fn @reduce_conditional_step{{[( ]}}
// CHECK: {{^ +}}[[BASE:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK: + [[SCALED:v[0-9]+]] = shl 5, arg1
// CHECK: + [[END:v[0-9]+]] = add [[BASE]], [[SCALED]]
// CHECK: - [[COUNTER:v[0-9]+]] = phi [bb0: 0], [bb4: {{v[0-9]+}}]
// CHECK-NEXT: - {{v[0-9]+}} = lt [[COUNTER]], arg1
// CHECK-NEXT: + [[PTR:v[0-9]+]] = phi [bb0: [[BASE]]], [bb4: [[NEXT:v[0-9]+]]]
// CHECK-NEXT: + {{v[0-9]+}} = lt [[PTR]], [[END]]
// CHECK: + mstore [[PTR]], 0
// CHECK: + {{v[0-9]+}} = mload [[PTR]]
// CHECK: + [[STEP:v[0-9]+]] = add [[PTR]], 32
// CHECK: + [[NEXT]] = phi [bb3: [[STEP]]], [bb2: [[PTR]]]
fn @reduce_conditional_step(arg0: memptr, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v14 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb4: v9]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb5
  bb2:
    v3 = shl 5, v1
    v4 = add v14, v3
    v5 = mload v4
    v6 = lt v5, arg2
    jumpi v6, bb3, bb4
  bb3:
    v7 = add v1, 1
    jump bb4
  bb4:
    v9 = phi [bb3: v7], [bb2: v1]
    mstore 0, v5
    jump bb1
  bb5:
    v10 = shl 5, v1
    v11 = add v14, v10
    mstore v11, 0
    ret 0
}

// A merge phi that is not built from the counter alone is not a step of it,
// so nothing is reduced.
// CHECK-LABEL: {{^[ +].*}}fn @keep_counter_reset_in_arm{{[( ]}}
// CHECK-NOT: + {{.*}}phi
fn @keep_counter_reset_in_arm(arg0: memptr, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v15 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb4: v9]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb5
  bb2:
    v3 = shl 5, v1
    v4 = add v15, v3
    v5 = mload v4
    v6 = lt v5, arg2
    jumpi v6, bb3, bb4
  bb3:
    v7 = add v1, 1
    jump bb4
  bb4:
    v9 = phi [bb3: v7], [bb2: arg2]
    mstore 0, v5
    jump bb1
  bb5:
    ret 0
}

// An if-converted arm steps the counter by its condition, `i += (u < v)`, a
// one-bit value: the pointer steps by the condition scaled to the stride.
// CHECK-LABEL: {{^[ +].*}}fn @reduce_condition_step{{[( ]}}
// CHECK: {{^ +}}[[BASE2:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK: + [[PTR:v[0-9]+]] = phi [bb0: [[BASE2]]], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: + {{v[0-9]+}} = mload [[PTR]]
// CHECK: [[COND:v[0-9]+]] = lt {{v[0-9]+}}, arg2
// CHECK: {{^[ +].*}}[[WIDE:v[0-9]+]] = zext i1 [[COND]] to i256
// CHECK: + [[SCALED:v[0-9]+]] = shl 5, [[WIDE]]
// CHECK: + [[NEXT]] = add [[PTR]], [[SCALED]]
fn @reduce_condition_step(arg0: memptr, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v16 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v7]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add v16, v3
    v5 = mload v4
    v6 = lt v5, arg2
    v17 = zext i1 v6 to i256
    v7 = add v1, v17
    mstore 0, v5
    jump bb1
  bb3:
    ret 0
}

// A step of unknown width could carry the counter around the word, so an
// update by a full word is not a step and the counter is left alone.
// CHECK-LABEL: {{^[ +].*}}fn @keep_word_step{{[( ]}}
// CHECK-NOT: + {{.*}}phi
fn @keep_word_step(arg0: memptr, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v17 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v7]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = shl 5, v1
    v4 = add v17, v3
    v5 = mload v4
    v7 = add v1, v5
    mstore 0, v5
    jump bb1
  bb3:
    ret 0
}

// An insertion sort's inner loop walks `j` down while `j > lo`, moving
// `a[j - 1]` to `a[j]`, and writes `a[j]` once more after it. The exit test
// is a `gt`, the two offsets share one descending pointer, and the write
// after the loop reads that pointer, so the counter dies.
// CHECK-LABEL: {{^[ +].*}}fn @reduce_descending_gt{{[( ]}}
// CHECK: {{^ +}}[[BASE3:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK: + [[START:v[0-9]+]] = add [[BASE3]], {{v[0-9]+}}
// CHECK: + [[END:v[0-9]+]] = add [[BASE3]], {{v[0-9]+}}
// CHECK: - {{v[0-9]+}} = phi [bb0: arg2], [bb2: {{v[0-9]+}}]
// CHECK: + [[PTR:v[0-9]+]] = phi [bb0: [[START]]], [bb2: [[NEXT:v[0-9]+]]]
// CHECK: + {{v[0-9]+}} = gt [[PTR]], [[END]]
// CHECK: + mstore [[PTR]], arg3
// CHECK: + [[PREV:v[0-9]+]] = sub [[PTR]], 32
// CHECK: {{^[ +].*}} = mload [[PREV]]
// CHECK: + mstore [[PTR]],
// CHECK: + [[NEXT]] = sub [[PTR]], 32
fn @reduce_descending_gt(arg0: memptr, arg1: i256, arg2: i256, arg3: i256) -> i256 {
  bb0:
    v18 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: arg2], [bb2: v9]
    v2 = gt v1, arg1
    jumpi v2, bb2, bb3
  bb2:
    v4 = sub v1, 1
    v5 = shl 5, v4
    v6 = add v18, v5
    v7 = mload v6
    v10 = shl 5, v1
    v11 = add v18, v10
    mstore v11, v7
    v9 = sub v1, 1
    jump bb1
  bb3:
    v12 = shl 5, v1
    v13 = add v18, v12
    mstore v13, arg3
    ret 0
}

// A merge phi may be an inner loop's header, which leaves the counter alone
// around its own back edge; the mirror phi cycles through that latch too.
// CHECK-LABEL: {{^[ +].*}}fn @reduce_through_inner_header{{[( ]}}
// CHECK: {{^ +}}[[BASE4:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK: + [[PTR:v[0-9]+]] = phi [bb0: [[BASE4]]], [bb5: [[INNER:v[0-9]+]]]
// CHECK: + {{v[0-9]+}} = mload [[PTR]]
// CHECK: + [[STEP:v[0-9]+]] = add [[PTR]], 32
// CHECK: + [[INNER]] = phi [bb2: [[STEP]]], [bb4: [[INNER]]]
fn @reduce_through_inner_header(arg0: memptr, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v19 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb5: v9]
    v2 = lt v1, arg1
    jumpi v2, bb2, bb6
  bb2:
    v3 = shl 5, v1
    v4 = add v19, v3
    v5 = mload v4
    v7 = add v1, 1
    jump bb3
  bb3:
    v9 = phi [bb2: v7], [bb4: v9]
    v10 = mload 0
    v11 = lt v10, arg2
    jumpi v11, bb4, bb5
  bb4:
    mstore 0, v5
    jump bb3
  bb5:
    mstore 32, v5
    jump bb1
  bb6:
    ret 0
}

// A codec loop tests its update, `i + 4 <= n`, rather than the counter. The
// update's mirror sits beside it in the header, so the test compares that
// mirror with the pointer's end and the counter still dies.
// CHECK-LABEL: {{^[ +].*}}fn @reduce_tested_update{{[( ]}}
// CHECK: {{^ +}}[[BASE5:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK: + [[START:v[0-9]+]] = add [[BASE5]], 32
// CHECK: + [[END:v[0-9]+]] = add {{v[0-9]+}}, 32
// CHECK: - [[COUNTER:v[0-9]+]] = phi [bb0: 0], [bb2: [[UPDATE:v[0-9]+]]]
// CHECK-NEXT: - [[UPDATE]] = add [[COUNTER]], 4
// CHECK-NEXT: - {{v[0-9]+}} = gt [[UPDATE]], arg1
// CHECK-NEXT: + [[PTR:v[0-9]+]] = phi [bb0: [[START]]], [bb2: [[NEXT:v[0-9]+]]]
// CHECK-NEXT: + [[NEXT]] = add [[PTR]], 4
// CHECK-NEXT: + {{v[0-9]+}} = gt [[NEXT]], [[END]]
// CHECK: + {{v[0-9]+}} = mload [[PTR]]
fn @reduce_tested_update(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    v20 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v2]
    v2 = add v1, 4
    v3 = gt v2, arg1
    jumpi v3, bb3, bb2
  bb2:
    v4 = add v20, 32
    v5 = add v4, v1
    v6 = mload v5
    v7 = shr 224, v6
    mstore 0, v7
    jump bb1
  bb3:
    ret 0
}

// The arms of a conditional store each jump back to the header, so the loop
// has two latches. Both pass the same update, so the pointer's phi takes its
// mirror from both, and the update in the header being the tested value
// puts that mirror beside it.
// CHECK-LABEL: {{^[ +].*}}fn @reduce_two_latches{{[( ]}}
// CHECK: {{^ +}}[[BASE6:v[0-9]+]] = ptrtoint memptr arg0 to i256
// CHECK: + [[PTR:v[0-9]+]] = phi [bb0: [[BASE6]]], [bb4: [[NEXT:v[0-9]+]]], [bb3: [[NEXT]]]
// CHECK-NEXT: + [[NEXT]] = add [[PTR]], 32
// CHECK-NEXT: + {{v[0-9]+}} = gt [[NEXT]],
// CHECK: + mstore [[PTR]], 1
// CHECK: + mstore [[PTR]], 0
fn @reduce_two_latches(arg0: memptr, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v21 = ptrtoint memptr arg0 to i256
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v7], [bb4: v7]
    v7 = add v1, 1
    v2 = gt v7, arg1
    jumpi v2, bb5, bb2
  bb2:
    v3 = shl 5, v1
    v4 = add v21, v3
    v5 = mload v4
    v6 = lt v5, arg2
    jumpi v6, bb3, bb4
  bb3:
    mstore v4, 0
    jump bb1
  bb4:
    mstore v4, 1
    jump bb1
  bb5:
    ret 0
}
