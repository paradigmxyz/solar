//@ compile-flags: -Zmir-pipeline=indvar-simplify
//@ filecheck:
@module NestedExitRead

// The table loop's pointer takes over its exit test, and the counter is read again
// inside a scan that the search enters after leaving the table loop. The counter is
// rebuilt once in the scan's preheader, not on every iteration of the scan.
// CHECK-LABEL: {{^[ +].*}}fn @find{{[( ]}}
// CHECK: + [[PTR:v[0-9]+]] = phi [bb0: arg0], [bb3: {{v[0-9]+}}]
// CHECK: bb5:
// CHECK-NEXT: + [[DELTA:v[0-9]+]] = sub [[PTR]], arg0
// CHECK-NEXT: + [[INDEX:v[0-9]+]] = shr [[DELTA]], 5
// CHECK-NEXT: jump bb6
// CHECK: bb7:
// CHECK-NOT: sub
// CHECK: = eq {{v[0-9]+}}, [[INDEX]]

fn @find(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = lt v1, 16
    jumpi v2, bb2, bb5
  bb2:
    v3 = shl v1, 5
    v5 = add arg0, v3
    v6 = mload v5
    v7 = eq v6, arg1
    jumpi v7, bb6, bb3
  bb3:
    v4 = add v1, 1
    jump bb1
  bb5:
    ret 0
  bb6:
    jump bb7
  bb7:
    v10 = phi [bb6: 0], [bb10: v13]
    v11 = lt v10, arg1
    jumpi v11, bb8, bb11
  bb8:
    v12 = add arg2, v10
    v14 = mload v12
    v15 = eq v14, v1
    jumpi v15, bb9, bb10
  bb10:
    v13 = add v10, 1
    jump bb7
  bb9:
    ret v10
  bb11:
    ret 0
}

// The scan's own phi reads the counter from its latch: that rebuild also moves to the
// scan's preheader, where it is shared with the read in the scan's body.
// CHECK-LABEL: {{^[ +].*}}fn @find_last{{[( ]}}
// CHECK: bb5:
// CHECK-NEXT: + [[DELTA:v[0-9]+]] = sub {{v[0-9]+}}, arg0
// CHECK-NEXT: + [[INDEX:v[0-9]+]] = shr [[DELTA]], 5
// CHECK-NEXT: jump bb6
// CHECK: bb6:
// CHECK: phi [bb5: 0], [bb8: [[INDEX]]]
// CHECK-NOT: sub
// CHECK: = eq {{v[0-9]+}}, [[INDEX]]
fn @find_last(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = lt v1, 16
    jumpi v2, bb2, bb5
  bb2:
    v3 = shl v1, 5
    v5 = add arg0, v3
    v6 = mload v5
    v7 = eq v6, arg1
    jumpi v7, bb6, bb3
  bb3:
    v4 = add v1, 1
    jump bb1
  bb5:
    ret 0
  bb6:
    jump bb7
  bb7:
    v10 = phi [bb6: 0], [bb10: v13]
    v16 = phi [bb6: 0], [bb10: v1]
    v11 = lt v10, arg1
    jumpi v11, bb8, bb11
  bb8:
    v12 = add arg2, v10
    v14 = mload v12
    v15 = eq v14, v1
    jumpi v15, bb9, bb10
  bb10:
    v13 = add v10, 1
    jump bb7
  bb9:
    ret v10
  bb11:
    ret v16
}
