//@ revisions: gas size
//@ compile-flags: -Zmir-pipeline=indvar-simplify
//@[gas] compile-flags: --optimize-runs 10000
//@[gas] filecheck: --check-prefix=GAS
//@[size] compile-flags: -O size
//@[size] filecheck: --check-prefix=SIZE
@module CriticalExitRead

// A byte scan in a loop that carries more than four words, where only the counter's word pays
// for the pointer, and which leaves early to a join whose phi reads the counter over a critical
// edge. The rebuild there costs as much before the edge is split as after it, so a size build,
// which the rebuild tips, neither takes over the test nor splits the edge.
// GAS-LABEL: {{^[ +].*}}fn @scan{{[( ]}}
// GAS: + {{v[0-9]+}} = ne
// GAS: + bb{{[0-9]+}}:
// SIZE-LABEL: {{^[ +].*}}fn @scan{{[( ]}}
// SIZE-NOT: + {{v[0-9]+}} = phi
// SIZE-NOT: + bb{{[0-9]+}}:
// SIZE: = lt {{v[0-9]+}}, arg1

fn @scan(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v15]
    v1 = phi [bb0: 0], [bb5: v9]
    v2 = phi [bb0: 0], [bb5: v10]
    v3 = phi [bb0: 0], [bb5: v11]
    v4 = phi [bb0: 0], [bb5: v12]
    v5 = phi [bb0: 0], [bb5: v13]
    v6 = phi [bb0: 0], [bb5: v14]
    v7 = lt v0, arg1
    jumpi v7, bb2, bb3
  bb2:
    v16 = add arg0, v0
    v17 = mload v16
    v18 = add arg0, v0
    v19 = mload v18
    v30 = eq v17, 0
    jumpi v30, bb3, bb5
  bb5:
    v9 = mul v1, v17
    v10 = mul v2, v19
    v11 = mul v3, v17
    v12 = mul v4, v19
    v13 = mul v5, v17
    v14 = mul v6, v19
    v15 = add v0, 1
    jump bb1
  bb3:
    v31 = phi [bb1: arg1], [bb2: v0]
    v20 = add v1, v2
    v21 = add v20, v3
    v22 = add v21, v4
    v23 = add v22, v5
    v24 = add v23, v6
    v25 = add v24, v31
    ret v25
}
