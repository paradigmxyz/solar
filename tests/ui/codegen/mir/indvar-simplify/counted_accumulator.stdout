- ; === ROOT/tests/ui/codegen/mir/indvar-simplify/counted_accumulator.mir (before indvar-simplify) ===
+ ; === ROOT/tests/ui/codegen/mir/indvar-simplify/counted_accumulator.mir (after indvar-simplify) ===
  @module CountedAccumulator
  fn @scan(arg0: i256, arg1: i256, arg2: i256) -> i256 {
    bb0:
      v0 = add arg0, 560
      jump bb1
    bb1:                                            ; preds = bb0, bb6
      v1 = phi [bb0: 0], [bb6: v12]
      v2 = phi [bb0: 0], [bb6: v13]
      v3 = phi [bb0: 0], [bb6: v7]
      v4 = lt v2, 8
      jumpi v4, bb3, bb2
    bb2:                                            ; preds = bb1
      ret v3
    bb3:                                            ; preds = bb1
      v5 = add v0, v2
      v6 = mload v5
      v7 = add v6, v3
      v8 = shr v6, 248
      v9 = eq v8, arg1
      jumpi v9, bb4, bb6
    bb4:                                            ; preds = bb3
      v10 = eq arg2, v1
      jumpi v10, bb7, bb5
    bb5:                                            ; preds = bb4
      v11 = add v1, 1
      jump bb6
    bb6:                                            ; preds = bb3, bb5
      v12 = phi [bb5: v11], [bb3: v1]
      v13 = add v2, 1
      jump bb1
    bb7:                                            ; preds = bb4
      ret v2
  }
  
