//@ compile-flags: -Zmir-pipeline=indvar-simplify --optimize-runs 10000
//@ filecheck:
@module DeepByteScan

// A byte scan that returns the position of the `arg3`-th byte equal to `arg2`, in a loop that
// carries more than four words. The pointer that takes over the exit test carries the
// counter's word, so it pays for itself although a byte pointer beside a counter would not. Its
// end adds bytes, which a build for 10,000 runs repays in gas and one for 200 does not.
// CHECK-LABEL: {{^[ +].*}}fn @scan{{[( ]}}
// CHECK: + [[PTR:v[0-9]+]] = phi [bb0: [[START:v[0-9]+]]], [bb6: {{v[0-9]+}}]
// CHECK: + {{v[0-9]+}} = mload [[PTR]]
// CHECK: + {{v[0-9]+}} = sub [[PTR]], [[START]]

fn @scan(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> i256 {
  bb0:
    v34 = add arg0, 560
    jump bb7
  bb7:
    v44 = phi [bb0: 0], [bb11: v60]
    v46 = phi [bb0: 0], [bb11: v61]
    v47 = lt v46, arg1
    jumpi v47, bb9, bb8
  bb8:
    ret 0
  bb9:
    v50 = add v34, v46
    v51 = mload v50
    v52 = shr v51, 248
    v53 = eq v52, arg2
    jumpi v53, bb10, bb11
  bb10:
    v56 = eq arg3, v44
    jumpi v56, bb12, bb13
  bb13:
    v59 = add v44, 1
    jump bb11
  bb11:
    v60 = phi [bb13: v59], [bb9: v44]
    v61 = add v46, 1
    jump bb7
  bb12:
    ret v46
}
