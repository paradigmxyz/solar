//@ compile-flags: -Zmir-pipeline=prune-unused-returns
//@ filecheck:
@module PruneUnusedReturns

// CHECK-LABEL: fn @discarded(arg0: u256)
// CHECK: ret
fn @discarded(arg0: u256) -> u256 {
  bb0:
    sstore 0, arg0
    ret arg0
}

// The discarded result propagates through a self-recursive call and return.
// CHECK-LABEL: fn @recursive(arg0: bool, arg1: u256)
// CHECK: internal_call @recursive, 0, 0, arg1
// CHECK: ret
fn @recursive(arg0: bool, arg1: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = internal_call fn1, 1, false, arg1
    ret v0
  bb2:
    sstore 1, arg1
    ret arg1
}

// CHECK-LABEL: fn @kept(arg0: u256) -> u256
fn @kept(arg0: u256) -> u256 {
  bb0:
    ret arg0
}

// CHECK-LABEL: fn @entry() -> u256
// CHECK: internal_call @discarded, 0, 7
// CHECK: internal_call @recursive, 0, 1, 8
// CHECK: internal_call @kept, 1, 9
fn @entry() -> u256 [selector=0x01020304] {
  bb0:
    v0 = internal_call fn0, 1, 7
    v1 = internal_call fn1, 1, true, 8
    v2 = internal_call fn2, 1, 9
    ret v2
}

// External signatures are never rewritten.
// CHECK-LABEL: fn @external_keeps_abi(arg0: u256) -> u256
fn @external_keeps_abi(arg0: u256) -> u256 [selector=0x01020305] {
  bb0:
    ret arg0
}
