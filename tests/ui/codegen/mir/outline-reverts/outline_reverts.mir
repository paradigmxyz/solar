//@compile-flags: -Zmir-pipeline=outline-reverts
//@filecheck:
// Two functions carry the same constant panic block; it is outlined into one
// shared no-return helper and each site becomes an argless `tail_call` — a
// bare jump in the backend. The distinct panic in `@third` stays inline: a
// shape must occur at least twice to pay for the helper.

@module OutlineReverts

// CHECK-LABEL: {{^[ +].*}}fn @first{{[( ]}}
// CHECK: + tail_call @[[STUB:revert_stub[.0-9]*]]
fn @first(arg0: i256) {
  bb0:
    v1 = add arg0, 1
    v2 = lt v1, arg0
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    mstore 128, v1
    returndata 128, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @second{{[( ]}}
// CHECK: + tail_call @[[STUB]]
fn @second(arg0: i256) {
  bb0:
    v1 = mul arg0, 2
    v2 = lt v1, arg0
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
  bb2:
    mstore 128, v1
    returndata 128, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @third{{[( ]}}
// CHECK: {{^[ +].*}}mstore 4, 18
// CHECK: {{^[ +].*}}revert 0, 36
fn @third(arg0: i256) {
  bb0:
    v1 = sub arg0, 1
    v2 = gt v1, arg0
    jumpi v2, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 18
    revert 0, 36
  bb2:
    mstore 128, v1
    returndata 128, 32
}

// An 8-byte shape at four sites pays for its helper under the target model:
// four 4-byte jumps plus one landed copy take 25 bytes against 32 inline.
// CHECK-LABEL: {{^[ +].*}}fn @small_a{{[( ]}}
// CHECK: + tail_call @[[SMALL:revert_stub[.0-9]*]]
fn @small_a(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 1
    revert 0, 32
  bb2:
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @small_b{{[( ]}}
// CHECK: + tail_call @[[SMALL]]
fn @small_b(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 1
    revert 0, 32
  bb2:
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @small_c{{[( ]}}
// CHECK: + tail_call @[[SMALL]]
fn @small_c(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 1
    revert 0, 32
  bb2:
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @small_d{{[( ]}}
// CHECK: + tail_call @[[SMALL]]
fn @small_d(arg0: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    mstore 0, 1
    revert 0, 32
  bb2:
    stop
}

// CHECK-LABEL: + fn @revert_stub{{.*}}
// CHECK: + mstore 4, 17
// CHECK: {{^[ +].*}}revert 0, 36

// CHECK: + fn @[[SMALL]]()
// CHECK: + mstore 0, 1
// CHECK: {{^[ +].*}}revert 0, 32
