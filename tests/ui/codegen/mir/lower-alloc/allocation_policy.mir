//@compile-flags: -Zmir-pipeline=lower-alloc
//@filecheck: --match-full-lines
// CHECK-LABEL:   fn @checked(arg0: i256) -> memorybytes {
// CHECK: +     [[POINTER:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// CHECK: +     [[OBJECT:v[0-9]+]] = inttoptr i256 [[POINTER]] to memorybytes !metadata(memory=scratch)
// CHECK: +     jumpi {{v[0-9]+}}, bb2, bb1
// CHECK: +     [[ZERO_PTR:v[0-9]+]] = ptrtoint memorybytes [[OBJECT]] to i256
// CHECK-NEXT: +     memory_zero [[ZERO_PTR]], {{v[0-9]+}}
// CHECK: +     revert 28, 36
// CHECK-LABEL:   fn @internal() -> i256 {
// CHECK: +     [[WORD:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// CHECK: +     [[PTR:v[0-9]+]] = inttoptr i256 [[WORD]] to memptr !metadata(memory=scratch, span=10..20)
// CHECK: +     [[BASE:v[0-9]+]] = ptrtoint memptr [[PTR]] to i256
// CHECK: +     [[END:v[0-9]+]] = add [[BASE]], 32
// CHECK: +     mstore 64, [[END]] !metadata(memory=scratch)
@module AllocationPolicy

fn @checked(arg0: i256) -> memorybytes {
  bb0:
    v1 = alloc memorybytes, word, zeroed, panic, arg0 !metadata(preserves_fmp, effect=memory_write)
    ret v1
}

fn @internal() -> i256 {
  bb0:
    v2 = alloc raw, exact, uninitialized, infallible, 32 !metadata(span=10..20, preserves_fmp, effect=memory_write)
    v0 = ptrtoint memptr v2 to i256
    ret v0
}
