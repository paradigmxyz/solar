//@compile-flags: -Zmir-pipeline=lower-alloc
//@filecheck: --match-full-lines
// CHECK-LABEL:   fn @checked(arg0: i256) -> ptr<memory> {
// CHECK: +     [[POINTER:v[0-9]+]] = load 64 !metadata(memory=scratch)
// CHECK: +     [[OBJECT:v[0-9]+]] = inttoptr i256 [[POINTER]] to ptr<memory> !metadata(memory=scratch)
// CHECK: +     jumpi {{v[0-9]+}}, bb2, bb1
// CHECK-NOT: +     {{.*}}ptrtoint
// CHECK: +     memory_zero [[OBJECT]], arg0
// CHECK: +     revert 28, 36
// CHECK-LABEL:   fn @internal() -> i256 {
// CHECK: +     [[WORD:v[0-9]+]] = load 64 !metadata(memory=scratch)
// CHECK: +     [[PTR:v[0-9]+]] = inttoptr i256 [[WORD]] to ptr<memory> !metadata(memory=scratch, span=10..20)
// CHECK-NOT: +     {{.*}}ptrtoint
// CHECK: +     [[END:v[0-9]+]] = add [[WORD]], 32
// CHECK: +     store 64, [[END]] !metadata(memory=scratch)
@module AllocationPolicy

fn @checked(arg0: i256) -> ptr<memory> {
  bb0:
    v1 = alloc zeroed checked arg0 !metadata(preserves_fmp, effect=memory_write)
    ret v1
}

fn @internal() -> i256 {
  bb0:
    v2 = alloc 32 !metadata(span=10..20, preserves_fmp, effect=memory_write)
    v0 = ptrtoint ptr<memory> v2 to i256
    ret v0
}
