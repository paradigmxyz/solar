//@ revisions: gas size
//@ compile-flags: -Zmir-pipeline=lower-alloc
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@[gas] filecheck: --match-full-lines --check-prefixes=CHECK,GAS
//@[size] filecheck: --match-full-lines --check-prefixes=CHECK,SIZE
// Size builds share one checked `alloc` helper among the checked allocations; gas builds check
// each allocation inline, since the helper's call protocol costs more gas than the check.
// CHECK-LABEL:   fn @checked(arg0: i256) -> ptr<memory> {
// SIZE: +     [[OBJECT:v[0-9]+]] = icall @alloc, arg0
// GAS: +     [[WORD:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// GAS: +     [[OBJECT:v[0-9]+]] = inttoptr i256 [[WORD]] to ptr<memory> !metadata(memory=scratch)
// GAS: +     jumpi {{v[0-9]+}}, {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK-NOT: +     {{.*}}ptrtoint
// CHECK: +     memory_zero [[OBJECT]], arg0
// CHECK-LABEL:   fn @also_checked(arg0: i256) -> ptr<memory> {
// SIZE: +     [[OBJECT:v[0-9]+]] = icall @alloc, arg0
// GAS: +     [[WORD:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// GAS: +     [[OBJECT:v[0-9]+]] = inttoptr i256 [[WORD]] to ptr<memory> !metadata(memory=scratch)
// CHECK-NOT: +     {{.*}}ptrtoint
// CHECK: +     memory_zero [[OBJECT]], arg0
// CHECK-LABEL:   fn @internal() -> i256 {
// CHECK: +     [[WORD:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// CHECK: +     [[PTR:v[0-9]+]] = inttoptr i256 [[WORD]] to ptr<memory> !metadata(memory=scratch, span=10..20)
// CHECK-NOT: +     {{.*}}ptrtoint
// CHECK: +     [[END:v[0-9]+]] = add [[WORD]], 32
// CHECK: +     mstore 64, [[END]] !metadata(memory=scratch)
// SIZE-LABEL: + fn @alloc(arg0: i256) -> ptr<memory> {
// SIZE: +     [[POINTER:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// SIZE: +     [[OBJECT:v[0-9]+]] = inttoptr i256 [[POINTER]] to ptr<memory>
// SIZE: +     jumpi {{v[0-9]+}}, {{bb[0-9]+}}, {{bb[0-9]+}}
// SIZE: +     revert 28, 36
// GAS-NOT: fn @alloc(
@module AllocationPolicy

fn @checked(arg0: i256) -> ptr<memory> {
  bb0:
    v1 = alloc zeroed checked arg0 !metadata(preserves_fmp, effect=memory_write)
    ret v1
}

fn @also_checked(arg0: i256) -> ptr<memory> {
  bb0:
    v1 = alloc zeroed checked arg0 !metadata(preserves_fmp, effect=memory_write)
    ret v1
}

fn @internal() -> i256 {
  bb0:
    v2 = alloc 32 !metadata(span=10..20, preserves_fmp, effect=memory_write)
    v0 = ptrtoint ptr<memory> v2 to i256
    ret v0
}
