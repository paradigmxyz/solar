//@compile-flags: -Zmir-pipeline=lower-alloc
//@filecheck: --match-full-lines
// CHECK-LABEL:   fn @checked(arg0: word) -> memorybytes {
// CHECK: +     [[POINTER:v[0-9]+]] = mload 64 !metadata(memory=scratch)
// CHECK: +     [[OBJECT:v[0-9]+]] = memory_object_from_ptr memorybytes, [[POINTER]] !metadata(memory=scratch)
// CHECK: +     jumpi {{v[0-9]+}}, bb2, bb1
// CHECK: +     memory_zero [[OBJECT]], {{v[0-9]+}}
// CHECK: +     revert 28, 36
// CHECK-LABEL:   fn @internal() -> word {
// CHECK: +     v0 = mload 64 !metadata(memory=scratch, span=10..20)
// CHECK: +     mstore 64, v1 !metadata(memory=scratch)
@module AllocationPolicy

fn @checked(arg0: word) -> memorybytes {
  bb0:
    v1 = alloc memorybytes, word, zeroed, panic, arg0 !metadata(preserves_fmp, effect=memory_write)
    ret v1
}

fn @internal() -> word {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32 !metadata(span=10..20, preserves_fmp, effect=memory_write)
    ret v0
}
