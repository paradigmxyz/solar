//@compile-flags: -Zmir-pipeline=lower-alloc,fmp-cse
//@filecheck:
@module LowerAlloc

// CHECK-LABEL: {{^[ +].*}}fn @operations{{[( ]}}
// CHECK: + {{v[0-9]+}} = mload 64
// CHECK: + [[NEXT:v[0-9]+]] = add {{v[0-9]+}}, 64
// CHECK: + mstore 64, [[NEXT]]
fn @operations(arg0: i256) -> i256 {
  bb0:
    v4 = fmp
    v1 = ptrtoint ptr<memory> v4 to i256
    set_fmp v4 !metadata(preserves_fmp, effect=memory_write)
    v5 = alloc 64
    v2 = ptrtoint ptr<memory> v5 to i256
    mstore v2, arg0
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @deferred{{[( ]}}
// CHECK: {{^[ +].*}}alloc 32 !metadata(deferred_alloc)
fn @deferred() {
  bb0:
    v6 = alloc 32 !metadata(deferred_alloc)
    v0 = ptrtoint ptr<memory> v6 to i256
    mstore v0, 1
    stop
}

// CHECK-LABEL: {{.*}}(after fmp-cse)
// CHECK-LABEL: @forward_load_store
// CHECK: - {{v[0-9]+}} = mload 64
// CHECK: + [[SUM:v[0-9]+]] = add [[PTR:v[0-9]+]], [[PTR]]
// CHECK: - {{v[0-9]+}} = mload 64
// CHECK: + ret [[SUM]]
fn @forward_load_store() -> i256 {
  bb0:
    v0 = mload 64
    v1 = mload 64
    v2 = add v0, v1
    mstore 64, v2
    v3 = mload 64
    ret v3
}

// CHECK-LABEL: @byte_clobber
// CHECK: {{^ +}}mstore8 65, arg0
// CHECK-NEXT: {{^ +}}[[BYTE:v[0-9]+]] = mload 64
// CHECK-NEXT: {{^ +}}ret [[BYTE]]
fn @byte_clobber(arg0: i256) -> i256 {
  bb0:
    mstore 64, 128
    mstore8 65, arg0
    v1 = mload 64
    ret v1
}

// CHECK-LABEL: @unknown_clobber
// CHECK: {{^ +}}mstore arg0, 256
// CHECK-NEXT: {{^ +}}[[UNKNOWN:v[0-9]+]] = mload 64
// CHECK-NEXT: {{^ +}}ret [[UNKNOWN]]
fn @unknown_clobber(arg0: i256) -> i256 {
  bb0:
    mstore 64, 128
    mstore arg0, 256
    v1 = mload 64
    ret v1
}

// CHECK-LABEL: @call_clobber
// CHECK: {{^ +}}icall @write_fmp
// CHECK-NEXT: {{^ +}}[[CALL:v[0-9]+]] = mload 64
// CHECK-NEXT: {{^ +}}ret [[CALL]]
fn @call_clobber() -> i256 {
  bb0:
    mstore 64, 128
    icall @write_fmp
    v0 = mload 64
    ret v0
}

fn @write_fmp() {
  bb0:
    mstore 64, 256
    ret
}

// CHECK-LABEL: @across_edge
// CHECK: {{^ +}}bb1:
// CHECK-NEXT: {{^ +}}[[EDGE:v[0-9]+]] = mload 64
// CHECK-NEXT: {{^ +}}ret [[EDGE]]
fn @across_edge() -> i256 {
  bb0:
    mstore 64, 128
    jump bb1
  bb1:
    v0 = mload 64
    ret v0
}

// CHECK-LABEL: @forwarded_address
// CHECK: - {{v[0-9]+}} = mload 64
// CHECK: - {{v[0-9]+}} = mload {{v[0-9]+}}
// CHECK: + ret 64
fn @forwarded_address() -> i256 {
  bb0:
    mstore 64, 64
    v0 = mload 64
    v1 = mload v0
    ret v1
}

// A write through a heap pointer, a copy into it, and a call with an empty output range cannot
// reach the word, so the stored word survives them.
// CHECK-LABEL: @heap_writes_keep_word
// CHECK: - {{v[0-9]+}} = mload 64
// CHECK: + ret [[BUMP:v[0-9]+]]
fn @heap_writes_keep_word(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = mload 64
    v1 = add v0, arg1
    mstore 64, v1
    mstore v0, arg1
    v2 = add v0, 32
    calldatacopy v2, arg0, arg1
    v3 = delegatecall arg0, arg1, v2, arg1, 0, 0
    v4 = mload 64
    ret v4
}

// A copy whose destination is not a heap pointer may overwrite the word.
// CHECK-LABEL: @low_copy_clobbers_word
// CHECK: {{^ +}}calldatacopy arg0, 0, 32
// CHECK-NEXT: {{^ +}}[[LOW:v[0-9]+]] = mload 64
// CHECK-NEXT: {{^ +}}ret [[LOW]]
fn @low_copy_clobbers_word(arg0: i256) -> i256 {
  bb0:
    mstore 64, 128
    calldatacopy arg0, 0, 32
    v0 = mload 64
    ret v0
}
