//@ compile-flags: -Zmir-pipeline=lower-alloc
//@ filecheck:
@module AllocationCheck

// The check compares the end with the limit, a width test that the late spelling pass chooses
// how to write.
// CHECK-LABEL: fn @checked
// CHECK: + [[OVER:v[0-9]+]] = gt {{v[0-9]+}}, 0xffffffffffffffff
// CHECK-NEXT: + [[INVALID:v[0-9]+]] = or {{v[0-9]+}}, [[OVER]]
// CHECK: + jumpi [[INVALID]]
fn @checked(arg0: i256) -> ptr<memory> {
  bb0:
    v1 = alloc zeroed checked arg0 !metadata(preserves_fmp, effect=memory_write)
    ret v1
}
