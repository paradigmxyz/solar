//@compile-flags: -Zmir-pipeline=lower-alloc
//@filecheck:
@module UntouchedHeap

// Memory above the free memory pointer is zero until something writes there, so the zero fill of
// an allocation made before any such write is dead, and the fill of a range of it that nothing
// wrote since too.
// CHECK-LABEL: {{^[ +].*}}fn @entry_zeroed{{[( ]}}
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @entry_zeroed() -> i256 {
  bb0:
    v900 = calldataload 4
    v2 = and v900, 4095
    v0 = alloc zeroed checked v2 !metadata(preserves_fmp, effect=memory_write)
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// A fill of memory that a huge size could not expand stays: the fill is what makes the
// allocation fail.
// CHECK-LABEL: {{^[ +].*}}fn @unbounded_size{{[( ]}}
// CHECK: {{^[ +] +}}memory_zero {{v[0-9]+}}, v0
fn @unbounded_size() -> i256 {
  bb0:
    v900 = calldataload 4
    v0 = alloc zeroed checked v900 !metadata(preserves_fmp, effect=memory_write)
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @entry_struct{{[( ]}}
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @entry_struct() -> i256 {
  bb0:
    v0 = alloc 128
    memory_zero v0, 128
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// A write into the object keeps the fill of the bytes it may write, not the fill of other bytes.
// CHECK-LABEL: {{^[ +].*}}fn @written_object{{[( ]}}
// CHECK: mstore {{v[0-9]+}}, 1
// CHECK-NEXT: {{^ +}}memory_zero {{v[0-9]+}}, 32
// CHECK-NOT: {{^[ +] +}}memory_zero
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 128
fn @written_object() -> i256 {
  bb0:
    v0 = alloc 128
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 1
    memory_zero v0, 32
    v2 = add v1, 64
    v3 = inttoptr i256 v2 to ptr<memory>
    memory_zero v3, 64
    memory_zero v0, 128
    ret v1
}

// A write at the pointer, as an encoder stages data, keeps every later fill.
// CHECK-LABEL: {{^[ +].*}}fn @after_staging{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @after_staging() -> i256 {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 1
    v2 = alloc 64
    memory_zero v2, 64
    v3 = ptrtoint ptr<memory> v2 to i256
    ret v3
}

// A write through an address the analysis cannot place does too.
// CHECK-LABEL: {{^[ +].*}}fn @after_unknown_store{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @after_unknown_store() -> i256 {
  bb0:
    v900 = calldataload 4
    mstore v900, 1
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// A write over the pointer's slot does.
// CHECK-LABEL: {{^[ +].*}}fn @after_slot_store{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @after_slot_store() -> i256 {
  bb0:
    mstore 64, 1024
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// A write below the heap keeps the memory zero.
// CHECK-LABEL: {{^[ +].*}}fn @after_scratch{{[( ]}}
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @after_scratch() -> i256 {
  bb0:
    mstore 0, 7
    mstore 32, 9
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// An event stages its data at the pointer.
// CHECK-LABEL: {{^[ +].*}}fn @after_log{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @after_log() -> i256 {
  bb0:
    v900 = calldataload 4
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, v900
    log v1, 32, 0x1234
    v2 = alloc 64
    memory_zero v2, 64
    v3 = ptrtoint ptr<memory> v2 to i256
    ret v3
}

// Each iteration allocates over the data the one before staged.
// CHECK-LABEL: {{^[ +].*}}fn @loop_staging{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @loop_staging() {
  bb0:
    v900 = calldataload 4
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v5]
    v1 = lt v0, v900
    jumpi v1, bb2, bb3
  bb2:
    v2 = alloc 64
    memory_zero v2, 64
    v3 = fmp
    v4 = ptrtoint ptr<memory> v3 to i256
    mstore v4, 1
    v5 = add v0, 1
    jump bb1
  bb3:
    stop
}

// A loop whose body only allocates keeps the memory zero.
// CHECK-LABEL: {{^[ +].*}}fn @loop_allocating{{[( ]}}
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @loop_allocating() {
  bb0:
    v900 = calldataload 4
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v5]
    v1 = lt v0, v900
    jumpi v1, bb2, bb3
  bb2:
    v2 = alloc 64
    memory_zero v2, 64
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, v0
    v5 = add v0, 1
    jump bb1
  bb3:
    stop
}

// A callee that stages data above the pointer keeps the fills after the call; one that only
// allocates does not.
// CHECK-LABEL: {{^[ +].*}}fn @stager{{[( ]}}
fn @stager(arg0: i256) {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    ret
}

// CHECK-LABEL: {{^[ +].*}}fn @allocator{{[( ]}}
fn @allocator() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 3
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @after_stager{{[( ]}}
// CHECK: icall @stager
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @after_stager() -> i256 {
  bb0:
    icall @stager, 5
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @after_allocator{{[( ]}}
// CHECK: icall @allocator
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @after_allocator() -> i256 {
  bb0:
    v0 = icall @allocator
    v1 = alloc 64
    memory_zero v1, 64
    v2 = ptrtoint ptr<memory> v1 to i256
    v3 = add v0, v2
    ret v3
}

// A function that observes gas keeps its fills, which pay for the memory they expand.
// CHECK-LABEL: {{^[ +].*}}fn @observes_gas{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @observes_gas() -> i256 {
  bb0:
    v0 = gas
    v1 = alloc 64
    memory_zero v1, 64
    v2 = ptrtoint ptr<memory> v1 to i256
    v3 = add v0, v2
    ret v3
}

// A function that another function calls after a write keeps its fills.
// CHECK-LABEL: {{^[ +].*}}fn @shared_callee{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @shared_callee() -> i256 {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @calls_shared_clean{{[( ]}}
fn @calls_shared_clean() -> i256 {
  bb0:
    v0 = icall @shared_callee
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @calls_shared_dirty{{[( ]}}
fn @calls_shared_dirty() -> i256 {
  bb0:
    v900 = calldataload 4
    mstore v900, 1
    v0 = icall @shared_callee
    ret v0
}

// The padding after copied bytes is zero in untouched memory, and not after the copy had a
// neighbor write there.
// CHECK-LABEL: {{^[ +].*}}fn @bytes_tail{{[( ]}}
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @bytes_tail() {
  bb0:
    v900 = calldataload 4
    v901 = calldataload 36
    v0 = alloc checked v901
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, v900
    v2 = add v1, 32
    calldatacopy v2, 4, v900
    v3 = add v2, v900
    v4 = inttoptr i256 v3 to ptr<memory>
    v5 = sub 0, v900
    v6 = and v5, 31
    memory_zero v4, v6
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @bytes_tail_written{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, {{v[0-9]+}}
fn @bytes_tail_written() {
  bb0:
    v900 = calldataload 4
    v901 = calldataload 36
    v0 = alloc checked v901
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, v900
    v2 = add v1, 32
    calldatacopy v2, 4, v900
    v3 = add v2, v900
    mstore v3, 1
    v4 = inttoptr i256 v3 to ptr<memory>
    v5 = sub 0, v900
    v6 = and v5, 31
    memory_zero v4, v6
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @bytes_tail_dirty{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, {{v[0-9]+}}
fn @bytes_tail_dirty() {
  bb0:
    v900 = calldataload 4
    v901 = calldataload 36
    v7 = fmp
    v8 = ptrtoint ptr<memory> v7 to i256
    mstore v8, 1
    v0 = alloc checked v901
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, v900
    v2 = add v1, 32
    calldatacopy v2, 4, v900
    v3 = add v2, v900
    v4 = inttoptr i256 v3 to ptr<memory>
    v5 = sub 0, v900
    v6 = and v5, 31
    memory_zero v4, v6
    stop
}

// A fill that a branch or a loop of writes may precede keeps what they may write.
// CHECK-LABEL: {{^[ +].*}}fn @branch_fill{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @branch_fill() {
  bb0:
    v900 = calldataload 4
    v0 = alloc 64
    v1 = ptrtoint ptr<memory> v0 to i256
    v9 = ne v900, 0
    jumpi v9, bb1, bb2
  bb1:
    mstore v1, 1
    jump bb2
  bb2:
    memory_zero v0, 64
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @loop_fill{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @loop_fill() {
  bb0:
    v900 = calldataload 4
    v0 = alloc 64
    v1 = ptrtoint ptr<memory> v0 to i256
    jump bb1
  bb1:
    v2 = phi [bb0: 0], [bb2: v5]
    v3 = lt v2, v900
    jumpi v3, bb2, bb3
  bb2:
    memory_zero v0, 64
    mstore v1, v2
    v5 = add v2, 1
    jump bb1
  bb3:
    stop
}

// A callee that may write through the pointer it gets keeps the fill after the call.
// CHECK-LABEL: {{^[ +].*}}fn @writer{{[( ]}}
fn @writer(arg0: ptr<memory>) {
  bb0:
    v0 = ptrtoint ptr<memory> arg0 to i256
    mstore v0, 1
    ret
}

// CHECK-LABEL: {{^[ +].*}}fn @call_fill{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @call_fill() {
  bb0:
    v0 = alloc 64
    icall @writer, v0
    memory_zero v0, 64
    stop
}

// A zero word store into fresh memory is dead, and one after a write to the word is not.
// CHECK-LABEL: {{^[ +].*}}fn @zero_store_fill{{[( ]}}
// CHECK-NOT: {{^[ +] +}}mstore {{v[0-9]+}}, 0
fn @zero_store_fill() {
  bb0:
    v0 = alloc 64
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 0
    v2 = add v1, 32
    mstore v2, 0
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @zero_store_written{{[( ]}}
// CHECK: {{^ +}}mstore {{v[0-9]+}}, 0
fn @zero_store_written() {
  bb0:
    v900 = calldataload 4
    v0 = alloc 64
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, v900
    mstore v1, 0
    stop
}

// A recursive function is never entered with zero memory.
// CHECK-LABEL: {{^[ +].*}}fn @recursive{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @recursive(arg0: i256) -> i256 {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    v9 = ne arg0, 0
    jumpi v9, bb1, bb2
  bb1:
    v1 = sub arg0, 1
    v2 = icall @recursive, v1
    ret v2
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @calls_recursive{{[( ]}}
fn @calls_recursive() -> i256 {
  bb0:
    v900 = calldataload 4
    v0 = icall @recursive, v900
    ret v0
}

// A tail call to a callee that writes ends the memory's zeroness for the code after a call of
// its caller.
// CHECK-LABEL: {{^[ +].*}}fn @tail_stager{{[( ]}}
fn @tail_stager(arg0: i256) {
  bb0:
    tail_call @stager, arg0
}

// CHECK-LABEL: {{^[ +].*}}fn @after_tail_stager{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @after_tail_stager() -> i256 {
  bb0:
    icall @tail_stager, 5
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// A function that calls a gas-observing caller's callee keeps its fills: the caller may measure
// the gas of the call.
// CHECK-LABEL: {{^[ +].*}}fn @measured{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @measured() -> i256 {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @measures{{[( ]}}
fn @measures() -> i256 {
  bb0:
    v0 = gas
    v1 = icall @measured
    v2 = gas
    v3 = sub v0, v2
    ret v3
}

// A copy of bytes ends where the padding fill starts, and a loop of copies does not: the
// padding may lie where an earlier, longer copy wrote.
// CHECK-LABEL: {{^[ +].*}}fn @tail_in_loop{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 31
fn @tail_in_loop() {
  bb0:
    v900 = calldataload 4
    v901 = calldataload 36
    v0 = alloc 4096
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = add v1, 32
    jump bb1
  bb1:
    v3 = phi [bb0: 0], [bb2: v9]
    v4 = lt v3, v900
    jumpi v4, bb2, bb3
  bb2:
    v5 = sub v901, v3
    calldatacopy v2, 4, v5
    v6 = add v2, v5
    v7 = inttoptr i256 v6 to ptr<memory>
    memory_zero v7, 31
    v9 = add v3, 1
    jump bb1
  bb3:
    stop
}

// A tail call to a function that reads gas observes it too.
// CHECK-LABEL: {{^[ +].*}}fn @observer{{[( ]}}
fn @observer() {
  bb0:
    v0 = gas
    mstore 0, v0
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @tail_observes{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @tail_observes() {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    tail_call @observer
}

// The dispatch entry's tail calls observe nothing: an entry that reads gas does not make its
// sibling keep its fill.
fn @dispatch() -> i256 [entry] {
  bb0:
    v0 = calldatasize
    v1 = ne v0, 0
    jumpi v1, bb1, bb2
  bb1:
    tail_call @sibling_fills
  bb2:
    v2 = calldataload 0
    v3 = shr v2, 224
    switch v3, default bb3, [0x30000001 => bb4, 0x3000001f => bb5, 0x30000002 => bb6, 0x30000003 => bb7, 0x30000004 => bb8, 0x30000005 => bb9, 0x30000006 => bb10, 0x30000007 => bb11, 0x30000008 => bb12, 0x30000009 => bb13, 0x3000000a => bb14, 0x3000000b => bb15, 0x3000000c => bb16, 0x3000000d => bb17, 0x3000000e => bb18, 0x3000000f => bb19, 0x30000010 => bb20, 0x30000011 => bb21, 0x30000012 => bb22, 0x30000013 => bb23, 0x30000014 => bb24, 0x30000015 => bb25, 0x30000016 => bb26, 0x30000017 => bb27, 0x30000018 => bb28, 0x30000019 => bb29, 0x3000001a => bb30, 0x3000001b => bb31, 0x3000001c => bb32, 0x3000001d => bb33, 0x3000001e => bb34, 0x30000022 => bb35]
  bb3:
    tail_call @sibling_reads_gas
  bb4:
    tail_call @entry_zeroed
  bb5:
    tail_call @unbounded_size
  bb6:
    tail_call @entry_struct
  bb7:
    tail_call @written_object
  bb8:
    tail_call @after_staging
  bb9:
    tail_call @after_unknown_store
  bb10:
    tail_call @after_slot_store
  bb11:
    tail_call @after_scratch
  bb12:
    tail_call @after_log
  bb13:
    tail_call @loop_staging
  bb14:
    tail_call @loop_allocating
  bb15:
    tail_call @after_stager
  bb16:
    tail_call @after_allocator
  bb17:
    tail_call @observes_gas
  bb18:
    tail_call @calls_shared_clean
  bb19:
    tail_call @calls_shared_dirty
  bb20:
    tail_call @bytes_tail
  bb21:
    tail_call @bytes_tail_written
  bb22:
    tail_call @bytes_tail_dirty
  bb23:
    tail_call @branch_fill
  bb24:
    tail_call @loop_fill
  bb25:
    tail_call @call_fill
  bb26:
    tail_call @zero_store_fill
  bb27:
    tail_call @zero_store_written
  bb28:
    tail_call @calls_recursive
  bb29:
    tail_call @after_tail_stager
  bb30:
    tail_call @measures
  bb31:
    tail_call @tail_in_loop
  bb32:
    tail_call @tail_observes
  bb33:
    tail_call @sibling_fills
  bb34:
    tail_call @sibling_reads_gas
  bb35:
    tail_call @tail_after_allocator
}

// CHECK-LABEL: {{^[ +].*}}fn @sibling_fills{{[( ]}}
// CHECK-NOT: {{^[ +] +}}memory_zero
fn @sibling_fills() {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @sibling_reads_gas{{[( ]}}
fn @sibling_reads_gas() {
  bb0:
    v0 = gas
    mstore 0, v0
    stop
}

// A callee that allocates and writes after the fill's allocation may write where a fill that
// follows a copy of unknown length lands, so the fill stays.
// CHECK-LABEL: {{^[ +].*}}fn @tail_after_allocator{{[( ]}}
// CHECK: {{^ +}}mstore {{v[0-9]+}}, 0
fn @tail_after_allocator() -> i256 {
  bb0:
    v900 = calldataload 4
    v0 = alloc 32
    v1 = ptrtoint ptr<memory> v0 to i256
    calldatacopy v1, 4, v900
    v2 = icall @allocator
    v3 = add v1, v900
    mstore v3, 0
    ret v2
}
