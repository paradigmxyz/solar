//@compile-flags: -Zmir-pipeline=lower-alloc
//@filecheck:
@module ReservedEncoding

// An encoder reads the pointer, writes at and above it, and reserves those
// bytes with a preserving allocation, which reuses the word it read.
// CHECK-LABEL: {{^[ +].*}}fn @reserve{{[( ]}}
// CHECK: + [[WORD:v[0-9]+]] = mload 64
// CHECK-NOT: mload 64
// CHECK: + {{v[0-9]+}} = inttoptr i256 [[WORD]] to ptr<memory>
// CHECK: + [[NEXT:v[0-9]+]] = add [[WORD]], 64
// CHECK: + mstore 64, [[NEXT]]
fn @reserve(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    v2 = add v1, 32
    calldatacopy v2, arg1, 32
    v3 = alloc 64 !metadata(preserves_fmp)
    v4 = ptrtoint ptr<memory> v3 to i256
    ret v4
}

// A write that is not addressed from the read word may move the pointer, so
// the reservation loads it again.
// CHECK-LABEL: {{^[ +].*}}fn @foreign_store{{[( ]}}
// CHECK: + {{v[0-9]+}} = mload 64
// CHECK: + {{v[0-9]+}} = mload 64
fn @foreign_store(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    mstore arg1, 0
    v3 = alloc 64 !metadata(preserves_fmp)
    v4 = ptrtoint ptr<memory> v3 to i256
    ret v4
}

// The backend may bump the pointer for a deferred allocation, so a reservation
// after one loads the pointer again.
// CHECK-LABEL: {{^[ +].*}}fn @after_deferred{{[( ]}}
// CHECK: + {{v[0-9]+}} = mload 64
// CHECK: alloc 32 !metadata(deferred_alloc)
// CHECK: + {{v[0-9]+}} = mload 64
fn @after_deferred(arg0: i256) -> i256 {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    v2 = alloc 32 !metadata(deferred_alloc)
    v3 = alloc 64 !metadata(preserves_fmp)
    v4 = ptrtoint ptr<memory> v3 to i256
    v5 = ptrtoint ptr<memory> v2 to i256
    v6 = add v4, v5
    ret v6
}

// Ordinary allocations keep their own pointer load.
// CHECK-LABEL: {{^[ +].*}}fn @plain{{[( ]}}
// CHECK: + {{v[0-9]+}} = mload 64
// CHECK: + {{v[0-9]+}} = mload 64
fn @plain(arg0: i256) -> i256 {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, arg0
    v3 = alloc 64
    v4 = ptrtoint ptr<memory> v3 to i256
    ret v4
}
