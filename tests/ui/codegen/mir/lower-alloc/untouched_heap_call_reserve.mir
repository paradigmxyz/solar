//@compile-flags: -Zmir-pipeline=lower-alloc
//@filecheck:
@module UntouchedHeapCallReserve

// A module with a call that withholds a pre-EIP-150 reserve from the gas left keeps every fill:
// the call pays its own memory expansion out of the few gas the reserve leaves, so a dropped fill
// can make it run out of gas.
// CHECK-LABEL: {{^[ +].*}}fn @allocates{{[( ]}}
// CHECK: {{^ +}}memory_zero {{v[0-9]+}}, 64
fn @allocates() -> i256 [selector=0x30000020] {
  bb0:
    v0 = alloc 64
    memory_zero v0, 64
    v1 = ptrtoint ptr<memory> v0 to i256
    ret v1
}

fn @calls() -> i1 [selector=0x30000021] {
  bb0:
    v0 = gas
    v1 = sub v0, 50
    v2 = call v1, 1, 0, 0, 0, 0, 0
    ret v2
}
