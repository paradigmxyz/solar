//@ compile-flags: -Zmir-pipeline=storage-load-cse -Zdataflow-optimizations
//@ filecheck:
@module IndirectCallback

fn @helper(arg0: i256) {
  bb0:
    v0 = call 100000, arg0, 0, 0, 0, 0, 0
    ret
}

// Both loads must remain: the helper's external call can reenter writer.
// CHECK-LABEL: fn @read_across_helper(
// CHECK: + {{v[0-9]+}} = sload 0
// CHECK: icall @helper
// CHECK: + {{v[0-9]+}} = sload 0
fn @read_across_helper(arg0: i256) -> i256 [selector=0x00000001] {
  bb0:
    v0 = sload 0
    icall @helper, arg0
    v1 = sload 0
    v2 = add v0, v1
    ret v2
}

fn @writer() [selector=0x00000002] {
  bb0:
    sstore 0, 7
    ret
}
