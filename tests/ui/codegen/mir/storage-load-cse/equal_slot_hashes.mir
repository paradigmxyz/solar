//@compile-flags: -Zmir-pipeline=storage-load-cse
//@filecheck:
@module EqualSlotHashes

// Two hashes of the same key and parent slot name one slot, though CSE has not
// merged them, and their constant operands are separate values.
// CHECK-LABEL: {{^[ +].*}}fn @same_mapping_key{{[( ]}}
// CHECK: - {{v[0-9]+}} = sload
// CHECK: + {{v[0-9]+}} = add arg1, arg1
fn @same_mapping_key(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = mapping_slot arg0, 3
    sstore v0, arg1
    v1 = mapping_slot arg0, 3
    v2 = sload v1
    v3 = add v2, arg1
    ret v3
}

// An earlier load forwards to a later one through an equal hash too.
// CHECK-LABEL: {{^[ +].*}}fn @repeated_read{{[( ]}}
// CHECK: + [[LOAD:v[0-9]+]] = sload
// CHECK: + {{v[0-9]+}} = add [[LOAD]], [[LOAD]]
fn @repeated_read(arg0: i256) -> i256 {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0
    v2 = mapping_slot arg0, 0
    v3 = sload v2
    v4 = add v1, v3
    ret v4
}

// Nested mappings hash the parent's hash; equal chains name one slot, and a
// field keeps its offset from the shared base.
// CHECK-LABEL: {{^[ +].*}}fn @nested_field{{[( ]}}
// CHECK: + sstore {{v[0-9]+}}, arg2
// CHECK-NOT: + {{v[0-9]+}} = sload
// CHECK: + {{v[0-9]+}} = sload [[OTHER:v[0-9]+]]
// CHECK-NOT: + {{v[0-9]+}} = sload
// CHECK: + {{v[0-9]+}} = add arg2,
fn @nested_field(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = mapping_slot arg1, v0
    v2 = add v1, 1
    sstore v2, arg2
    v3 = mapping_slot arg0, 0
    v4 = mapping_slot arg1, v3
    v5 = add v4, 2
    v6 = sload v5
    v7 = add v4, 1
    v8 = sload v7
    v9 = add v8, v6
    ret v9
}

// Storage-array hashes name their slots the same way, by every operand and
// the element stride. A store through another symbolic slot still invalidates
// the data slot's word, as for any two hashes.
// CHECK-LABEL: {{^[ +].*}}fn @array_slots{{[( ]}}
// CHECK: + sstore {{v[0-9]+}}, 5
// CHECK: + sstore {{v[0-9]+}}, 6
// CHECK: + [[STRIDE:v[0-9]+]] = sload
// CHECK-NOT: {{^[ +].*}}= sload
// CHECK: + {{v[0-9]+}} = add 5, 6
fn @array_slots(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = storage_array_data_slot arg0
    sstore v0, 5
    v1 = storage_array_data_slot arg0
    v2 = sload v1
    v3 = storage_array_element_slot arg0, arg1, 2
    sstore v3, 6
    v4 = storage_array_element_slot arg0, arg1, 1
    v5 = sload v4
    v6 = storage_array_element_slot arg0, arg1, 2
    v7 = sload v6
    v8 = add v2, v7
    v9 = add v8, v5
    ret v9
}

// Different keys hash to different slots, which a write through either may
// share, so the read stays.
// CHECK-LABEL: {{^[ +].*}}fn @different_keys{{[( ]}}
// CHECK: + sstore {{v[0-9]+}}, arg2
// CHECK: + sstore {{v[0-9]+}}, 7
// CHECK: + {{v[0-9]+}} = sload
fn @different_keys(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = mapping_slot arg0, 0
    sstore v0, arg2
    v1 = mapping_slot arg1, 0
    sstore v1, 7
    v2 = mapping_slot arg0, 0
    v3 = sload v2
    ret v3
}

// A block entered from one predecessor keeps its facts; a join does not.
// CHECK-LABEL: {{^[ +].*}}fn @edges{{[( ]}}
// CHECK: {{^[ +].*}}bb1:
// CHECK-NEXT: {{^[ +].*}} = mapping_slot arg0, 0
// CHECK-NOT: {{^[ +].*}}sload
// CHECK: {{^[ +].*}}jump bb3
// CHECK: {{^[ +].*}}bb3:
// CHECK: + {{v[0-9]+}} = phi [bb1: 9], [bb2: 0]
// CHECK: + {{v[0-9]+}} = sload
fn @edges(arg0: i256, arg1: i1) -> i256 {
  bb0:
    v0 = mapping_slot arg0, 0
    sstore v0, 9
    jumpi arg1, bb1, bb2
  bb1:
    v1 = mapping_slot arg0, 0
    v2 = sload v1
    jump bb3
  bb2:
    jump bb3
  bb3:
    v3 = phi [bb1: v2], [bb2: 0]
    v4 = mapping_slot arg0, 0
    v5 = sload v4
    v6 = add v3, v5
    ret v6
}

// A loop header starts without facts, so the hash a later iteration repeats
// with a new phi value never meets the word an earlier iteration stored. Within
// one iteration, the equal hash after the store reads the stored word.
// CHECK-LABEL: {{^[ +].*}}fn @loop_keys{{[( ]}}
// CHECK: + [[HEADER:v[0-9]+]] = sload
// CHECK: + sstore {{v[0-9]+}}, [[NEXT:v[0-9]+]]
// CHECK-NOT: {{^[ +].*}}= sload
// CHECK: + {{v[0-9]+}} = eq [[NEXT]], 0
fn @loop_keys(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v3]
    v1 = mapping_slot v0, 0
    v2 = sload v1
    jump bb2
  bb2:
    v3 = add v0, 1
    v4 = mapping_slot v0, 0
    sstore v4, v3
    v5 = mapping_slot v0, 0
    v6 = sload v5
    v7 = eq v6, 0
    jumpi v7, bb1, bb3
  bb3:
    ret v2
}
