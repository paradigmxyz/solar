//@compile-flags: -Zmir-pipeline=storage-dse
//@filecheck:
@module StorageDse
// CHECK-LABEL: {{^[ +].*}}fn @remove_overwritten_store{{[( ]}}
// CHECK: - sstore 0, arg0
// CHECK: + sstore 0, 7
fn @remove_overwritten_store(arg0: i256) {
  bb0:
    sstore 0, arg0
    sstore 0, 7
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_store_observed_by_load{{[( ]}}
// CHECK: + sstore 0, arg0
// CHECK: + {{v[0-9]+}} = sload 0
// CHECK: + sstore 0, 7
fn @keep_store_observed_by_load(arg0: i256) -> i256 {
  bb0:
    sstore 0, arg0
    v1 = sload 0
    sstore 0, 7
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @remove_equal_store_after_load{{[( ]}}
// CHECK: - sstore 0, arg0
// CHECK: - {{.*}}sload 0
// CHECK: - sstore 0, arg0
// CHECK: + sstore 0, arg0
// CHECK: + {{v[0-9]+}} = sload 0
fn @remove_equal_store_after_load(arg0: i256) -> i256 {
  bb0:
    sstore 0, arg0
    v1 = sload 0
    sstore 0, arg0
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_may_alias_symbolic_store{{[( ]}}
// CHECK: + sstore arg0, 1
// CHECK: + sstore arg1, 2
fn @keep_may_alias_symbolic_store(arg0: i256, arg1: i256) {
  bb0:
    sstore arg0, 1
    sstore arg1, 2
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @remove_disjoint_offset_overwrite{{[( ]}}
// CHECK: - sstore {{v[0-9]+}}, 1
// CHECK: + sstore {{v[0-9]+}}, 3
fn @remove_disjoint_offset_overwrite(arg0: i256) {
  bb0:
    v1 = add arg0, 1
    sstore v1, 1
    v2 = add arg0, 2
    sstore v2, 2
    v3 = add arg0, 1
    sstore v3, 3
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_across_call{{[( ]}}
// CHECK: + sstore 0, arg0
// CHECK: {{^[ +].*[ =]call[[:space:]]}}
// CHECK: + sstore 0, 7
fn @keep_across_call(arg0: i256, arg1: i256) {
  bb0:
    sstore 0, arg0
    v1 = call 100000, arg1, 0, 0, 0, 0, 0
    sstore 0, 7
    stop
}

// CHECK-LABEL: fn @header_observes_store
// CHECK: {{^[ +].*}}sstore arg0, 64
// CHECK: {{^[ +].*}}validate_storage_bytes {{v[0-9]+}}
// CHECK: {{^[ +].*}}sstore arg0, 0
fn @header_observes_store(arg0: i256) {
  bb0:
    sstore arg0, 64
    v0 = sload arg0
    validate_storage_bytes v0
    sstore arg0, 0
    ret
}

// CHECK-LABEL: fn @copy_observes_store
// CHECK: {{^[ +].*}}sstore arg0, 7
// CHECK: {{^[ +].*}}load_storage_bytes arg1
// CHECK: {{^[ +].*}}sstore arg0, 0
fn @copy_observes_store(arg0: i256, arg1: i256) -> memptr {
  bb0:
    sstore arg0, 7
    v0 = load_storage_bytes arg1
    sstore arg0, 0
    ret v0
}

// Remaining gas observes the first store even though the second overwrites it.
// CHECK-LABEL: {{^[ +].*}}fn @keep_store_observed_by_gas{{[( ]}}
// CHECK: + sstore 0, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = gas
// CHECK: + sstore 0, 2
fn @keep_store_observed_by_gas() -> i256 {
  bb0:
    v0 = gas
    sstore 0, 1
    v1 = gas
    sstore 0, 2
    v2 = sub v0, v1
    ret v2
}

// A gas observation in the successor also blocks all-path overwrite facts.
// CHECK-LABEL: {{^[ +].*}}fn @keep_cross_block_store_observed_by_gas{{[( ]}}
// CHECK: + sstore 0, 1
// CHECK: {{^[ +].*}}{{v[0-9]+}} = gas
// CHECK: + sstore 0, 2
fn @keep_cross_block_store_observed_by_gas() -> i256 {
  bb0:
    v0 = gas
    sstore 0, 1
    jump bb1
  bb1:
    v1 = gas
    sstore 0, 2
    v2 = sub v0, v1
    ret v2
}

// A transitive gas read observes the first store even when its call summary
// reports no reads or writes to storage.
// CHECK-LABEL: fn @keep_store_observed_by_callee
// CHECK: {{^[ +].*}}sstore 0, 1
// CHECK: icall @observe_indirect
// CHECK: {{^[ +].*}}sstore 0, 2
fn @keep_store_observed_by_callee() -> i256 {
  bb0:
    sstore 0, 1
    v0 = icall @observe_indirect
    sstore 0, 2
    ret v0
}

fn @observe_indirect() -> i256 {
  bb0:
    v0 = icall @observe_gas
    ret v0
}

fn @observe_gas() -> i256 {
  bb0:
    v0 = gas
    ret v0
}

// CHECK-LABEL: fn @keep_before_halt
// CHECK: + sstore 0, 1
// CHECK: icall @halt_indirect
// CHECK: + sstore 0, 2
fn @keep_before_halt(arg0: i1, arg1: i256) {
  bb0:
    sstore 0, 1
    icall @halt_indirect, arg0, arg1
    jump bb1
  bb1:
    sstore 0, 2
    ret
}

fn @halt_indirect(arg0: i1, arg1: i256) {
  bb0:
    icall @halt, arg0, arg1
    ret
}

fn @halt(arg0: i1, arg1: i256) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    switch arg1, default bb5, [0 => bb3, 1 => bb4]
  bb2:
    ret
  bb3:
    stop
  bb4:
    returndata 0, 0
  bb5:
    selfdestruct 0
}

// A returning, storage-free call still allows elimination.
// CHECK-LABEL: fn @remove_before_returning_call
// CHECK: - sstore 0, 1
// CHECK: icall @returning
// CHECK: + sstore 0, 2
fn @remove_before_returning_call() {
  bb0:
    sstore 0, 1
    icall @returning
    sstore 0, 2
    ret
}

fn @returning() {
  bb0:
    ret
}
