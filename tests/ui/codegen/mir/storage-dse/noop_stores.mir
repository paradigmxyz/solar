//@compile-flags: -Zmir-pipeline=storage-dse
//@filecheck:
@module NoopStores

// Writing back the word a load of the slot read changes nothing. A later DCE
// removes the load once the store is gone.
// CHECK-LABEL: {{^[ +].*}}fn @store_loaded_word{{[( ]}}
// CHECK: - sstore arg0, [[WORD:v[0-9]+]]
// CHECK-NOT: {{^[ +].*}}sstore
// CHECK: {{^[ +].*}}ret [[WORD]]
fn @store_loaded_word(arg0: i256) -> i256 {
  bb0:
    v0 = sload arg0
    sstore arg0, v0
    ret v0
}

// A store to a different constant slot leaves the word in place.
// CHECK-LABEL: {{^[ +].*}}fn @across_disjoint_store{{[( ]}}
// CHECK: + sstore 1, 5
// CHECK-NOT: {{^[ +].*}}sstore 0,
// CHECK: {{^[ +].*}}ret
fn @across_disjoint_store() -> i256 {
  bb0:
    v0 = sload 0
    sstore 1, 5
    sstore 0, v0
    ret v0
}

// A store that may share the slot, or a call that may write storage, may have
// changed the word.
// CHECK-LABEL: {{^[ +].*}}fn @across_clobbers{{[( ]}}
// CHECK: + sstore arg1, 5
// CHECK-NEXT: + sstore arg0, {{v[0-9]+}}
// CHECK: icall @writer
// CHECK: + sstore 0, {{v[0-9]+}}
fn @across_clobbers(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = sload arg0
    sstore arg1, 5
    sstore arg0, v0
    v1 = sload 0
    icall @writer
    sstore 0, v1
    v2 = add v0, v1
    ret v2
}

fn @writer() {
  bb0:
    sstore 0, 1
    ret
}

// A different word is a real write.
// CHECK-LABEL: {{^[ +].*}}fn @other_word{{[( ]}}
// CHECK: + sstore 0, {{v[0-9]+}}
fn @other_word() {
  bb0:
    v0 = sload 0
    v1 = add v0, 1
    sstore 0, v1
    ret
}

// A block entered from one predecessor knows the word its predecessor read,
// as when lowering splits a check off between the load and the store.
// CHECK-LABEL: {{^[ +].*}}fn @single_predecessor{{[( ]}}
// CHECK: - sstore 0,
// CHECK-NOT: {{^[ +].*}}sstore
// CHECK: {{^[ +].*}}ret
fn @single_predecessor(arg0: i1) -> i256 {
  bb0:
    v0 = sload 0
    jumpi arg0, bb1, bb2
  bb1:
    sstore 0, v0
    ret v0
  bb2:
    ret v0
}

// A join starts without the words its predecessors know.
// CHECK-LABEL: {{^[ +].*}}fn @join{{[( ]}}
// CHECK: + sstore 0, {{v[0-9]+}}
fn @join(arg0: i1) -> i256 {
  bb0:
    v0 = sload 0
    jumpi arg0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    sstore 0, v0
    ret v0
}

// After a gas read, storage accesses stay so that a later read observes their
// cost, here and in every block the read reaches.
// CHECK-LABEL: {{^[ +].*}}fn @after_gas{{[( ]}}
// CHECK: + sstore 0, {{v[0-9]+}}
// CHECK: + sstore 1, {{v[0-9]+}}
fn @after_gas(arg0: i1) -> i256 {
  bb0:
    v0 = gas
    v1 = sload 0
    sstore 0, v1
    jumpi arg0, bb1, bb2
  bb1:
    v2 = sload 1
    sstore 1, v2
    jump bb2
  bb2:
    v3 = gas
    v4 = sub v0, v3
    ret v4
}
