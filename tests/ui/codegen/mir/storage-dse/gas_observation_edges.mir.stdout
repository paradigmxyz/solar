; function raw(uint256 h) internal view returns (uint256 word)
fn @raw(arg0: i256) -> i256 [view] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    ret v1
}

; function readThenReturn() internal view
fn @readThenReturn() [view] {
  bb0:
    v0 = gas
    v1 = lt v0, 10
    v2 = zext i1 v1 to i256
    v3 = ne v2, 0
    jumpi v3, bb1, bb2
  bb2:  ; preds = bb0
    jump bb3
  bb3:  ; preds = bb2
    ret
  bb1:  ; preds = bb0
    revert 0, 0
}

; function readThenRevert(bool f) internal view
fn @readThenRevert(arg0: i1) [view] {
  bb0:
    jumpi arg0, bb1, bb2
  bb2:  ; preds = bb0
    jump bb3
  bb3:  ; preds = bb2
    ret
  bb1:  ; preds = bb0
    v0 = gas
    mstore 0, v0 !metadata(memory=scratch)
    revert 0, 32
}

; function outer() internal view
fn @outer() [view] {
  bb0:
    icall @readThenReturn
    ret
}

; function recurse(uint256 depth) internal view
fn @recurse(arg0: i256) [view] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:  ; preds = bb0
    v1 = checked_sub uint256, arg0, 1
    icall @recurse, v1
    jump bb3
  bb1:  ; preds = bb0
    icall @readThenReturn
    jump bb3
  bb3:  ; preds = bb1, bb2
    ret
}
