//@compile-flags: -Zmir-pipeline=storage-load-cse,storage-dse,egraph,dce
@module StorageDseControlFlow

fn @both_paths(arg0: bool) {
  bb0:
    sstore 0, 1
    jumpi arg0, bb1, bb2
  bb1:
    sstore 0, 2
    stop
  bb2:
    sstore 0, 3
    stop
}

fn @one_path_reads(arg0: bool) -> u256 {
  bb0:
    sstore 0, 1
    jumpi arg0, bb1, bb2
  bb1:
    v0 = sload 0
    sstore 0, 2
    ret v0
  bb2:
    sstore 0, 3
    ret 0
}

fn @loop_exit_observes(arg0: bool) {
  bb0:
    sstore 0, 1
    jump bb1
  bb1:
    jumpi arg0, bb2, bb3
  bb2:
    sstore 0, 2
    jump bb1
  bb3:
    stop
}

fn @packed(arg0: u256, arg1: u256) {
  bb0:
    v0 = sload 0
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00
    v2 = and arg0, 255
    v3 = or v1, v2
    sstore 0, v3
    v4 = sload 0
    v5 = and v4, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00ff
    v6 = and arg1, 255
    v7 = shl 8, v6
    v8 = or v5, v7
    sstore 0, v8
    stop
}

fn @call_observer(arg0: address) {
  bb0:
    sstore 0, 1
    jump bb1
  bb1:
    v0 = call 100000, arg0, 0, 0, 0, 0, 0
    jump bb2
  bb2:
    sstore 0, 2
    stop
}

fn @changing_loop_slot() {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    sstore v0, 1
    v1 = lt v0, 2
    jumpi v1, bb2, bb3
  bb2:
    sstore v0, 2
    v2 = add v0, 1
    jump bb1
  bb3:
    stop
}
