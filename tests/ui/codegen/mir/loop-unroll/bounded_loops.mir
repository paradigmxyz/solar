//@compile-flags: -Zmir-pipeline=loop-unroll --optimize-runs 10000
//@filecheck:
@module BoundedLoops

fn @three(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 3
    ret v0
}

fn @wide(arg0: i256) -> i256 {
  bb0:
    v0 = and arg0, 0xffff
    ret v0
}

// A bound that a call returns at most three can never admit the four
// iterations a main loop unrolled by four tests for, nor more than one group of
// two, so the loop stays rolled instead of paying a declined test per entry.
// CHECK-LABEL: {{^[ +].*}}fn @bounded{{[( ]}}
// CHECK-NOT: {{^\+}}
// CHECK-LABEL: {{^[ +].*}}fn @unbounded{{[( ]}}
fn @bounded(arg0: i256) -> i256 {
  bb0:
    v6 = icall @three, arg0
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, v6
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v3 = add v1, v5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A bound that may reach far past the estimate for uncounted loops unrolls as
// before.
// CHECK: + [[I:v[0-9]+]] = phi [bb0: 0], {{\[}}[[LATCH:bb[0-9]+]]: {{v[0-9]+}}]
// CHECK: + [[AHEAD:v[0-9]+]] = add [[I]], 3
// CHECK-NEXT: + {{v[0-9]+}} = lt [[AHEAD]], {{v[0-9]+}}
fn @unbounded(arg0: i256) -> i256 {
  bb0:
    v6 = icall @wide, arg0
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, v6
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v3 = add v1, v5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}
