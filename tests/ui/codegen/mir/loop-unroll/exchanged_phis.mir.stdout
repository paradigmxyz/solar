@module Swap
; function swaps(uint256 n, uint256 a, uint256 b) external pure returns (uint256) [selector 0xdb9a27fa]
fn @swaps(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0xdb9a27fa, pure, abi_params=[uint256, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
