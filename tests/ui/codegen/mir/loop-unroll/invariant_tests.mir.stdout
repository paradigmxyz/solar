  bb3:
    v10 = checked_add u256, v3, 1
    jump bb1
}

fn @keep(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0xdaef3dc2, pure, abi_params=[u256, u256, u256], abi_returns=[word], abi_return_params=[u256]] {
