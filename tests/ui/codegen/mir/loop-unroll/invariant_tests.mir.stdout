@module InvariantTests
fn @periodStarts(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0x2e930b8e, pure, abi_params=[u256, u256, u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
