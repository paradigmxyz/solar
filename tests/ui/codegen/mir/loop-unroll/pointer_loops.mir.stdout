    v13 = ptrtoint memptr v9 to i256
    v14 = eq v13, v11
    v15 = zext i1 v14 to i256
    v16 = eq v15, 0
    v17 = zext i1 v16 to i256
    v18 = ne v17, 0
    jumpi v18, bb3, bb4
  bb4:
    jump bb2
  bb2:
    mstore v8, 0
    v31 = add v8, 32
    mstore 64, v31 !metadata(memory=scratch)
    v32 = inttoptr i256 v12 to memptr
    ret v32
  bb3:
    v19 = ptrtoint memptr v9 to i256
    v20 = add v19, 1
    v21 = mload v20
    v22 = and v21, 15
    v23 = mload v22
    v24 = add v8, 1
    mstore8 v24, v23
    v25 = mload v20
    v26 = shr 4, v25
    v27 = and v26, 15
    v28 = mload v27
    mstore8 v8, v28
    v29 = add v8, 2
    jump bb5
  bb5:
    v30 = inttoptr i256 v20 to memptr
