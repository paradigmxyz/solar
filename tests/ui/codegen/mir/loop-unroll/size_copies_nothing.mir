//@ compile-flags: -Osize --optimize-runs 10000 -Zmir-pipeline=loop-unroll
@module SizeCopiesNothing

// Size mode copies no loop bodies, whatever the optimizer runs.
fn @counted(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v3 = add v1, v5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A loop that runs a literal number of times stays a loop.
fn @literal() -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, 3
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A counter that only counts iterations still counts up to zero.
fn @reversed(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, 5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}
