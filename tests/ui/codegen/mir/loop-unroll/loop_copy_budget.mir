//@ compile-flags: -Zmir-pipeline=loop-unroll --optimize-runs 10000
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
@module LoopCopyBudget

// The functions below are runtime entries whose code the target estimates at about 14.8 KB, so the
// copies of loops may add few bytes before the module reaches EIP-170's limit of 24,576 bytes once
// the estimate is scaled up. Every loop would unroll by two or four, and the copies take the
// loops that save the most gas per added byte first: the two smallest bodies unroll, and the
// larger two stay rolled.
//
// CHECK-LABEL: {{^[ +].*}}fn @loop1{{[( ]}}
// CHECK: + jumpi
// CHECK-LABEL: {{^[ +].*}}fn @loop2{{[( ]}}
// CHECK: + jumpi
// CHECK-LABEL: {{^[ +].*}}fn @loop4{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK-LABEL: {{^[ +].*}}fn @loop8{{[( ]}}
// CHECK-NOT: {{^[-+]}}
// CHECK-LABEL: {{^[ +].*}}fn @padding{{[( ]}}
// CHECK-NOT: {{^[-+]}}

fn @loop1(arg0: i256) -> i256 [selector=0x10000000] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v3 = add v1, v5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

fn @loop2(arg0: i256) -> i256 [selector=0x10000001] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v6 = mul v5, 3
    v3 = add v1, v6
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

fn @loop4(arg0: i256) -> i256 [selector=0x10000002] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v6 = mul v5, 3
    v7 = mul v6, 4
    v8 = mul v7, 5
    v3 = add v1, v8
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

fn @loop8(arg0: i256) -> i256 [selector=0x10000003] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v6 = mul v5, 3
    v7 = mul v6, 4
    v8 = mul v7, 5
    v9 = mul v8, 6
    v10 = mul v9, 7
    v11 = mul v10, 8
    v12 = mul v11, 9
    v3 = add v1, v12
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

