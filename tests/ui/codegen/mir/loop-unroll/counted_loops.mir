//@compile-flags: -Zmir-pipeline=loop-unroll --optimize-runs 10000
//@filecheck:
@module CountedLoops

// A counted loop runs its body four times per test of `i + 3 < n` in a main
// loop, which leaves the last iterations to the original loop with its state.
// CHECK-LABEL: {{^[ +].*}}fn @counted{{[( ]}}
// CHECK: - jump bb1
// CHECK-NEXT: + jump [[MAIN:bb[0-9]+]]
// CHECK-NEXT: + [[MAIN]]:
// CHECK-NEXT: + [[I:v[0-9]+]] = phi [bb0: 0], {{\[}}[[LATCH:bb[0-9]+]]: [[NEXT:v[0-9]+]]]
// CHECK-NEXT: + [[S:v[0-9]+]] = phi [bb0: 0], {{\[}}[[LATCH]]: [[SUM:v[0-9]+]]]
// CHECK: + [[AHEAD:v[0-9]+]] = add [[I]], 3
// CHECK-NEXT: + [[C:v[0-9]+]] = lt [[AHEAD]], arg0
// CHECK-NEXT: + jumpi [[C]], [[FIRST:bb[0-9]+]], bb1
// CHECK: + {{v[0-9]+}} = phi {{\[}}[[MAIN]]: [[I]]], [bb2: {{v[0-9]+}}]
// CHECK-NEXT: + {{v[0-9]+}} = phi {{\[}}[[MAIN]]: [[S]]], [bb2: {{v[0-9]+}}]
// CHECK: + [[FIRST]]:
// CHECK-NEXT: + [[P:v[0-9]+]] = mul [[I]], 3
// CHECK-NEXT: + {{v[0-9]+}} = add [[S]], [[P]]
// CHECK-NEXT: + {{v[0-9]+}} = add [[I]], 1
// CHECK-COUNT-2: = mul
// CHECK: + [[LATCH]]:
// CHECK-NEXT: + {{v[0-9]+}} = mul [[LAST:v[0-9]+]], 3
// CHECK-NEXT: + [[SUM]] = add {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NEXT: + [[NEXT]] = add [[LAST]], 1
// CHECK-NEXT: + jump [[MAIN]]
fn @counted(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mul v0, 3
    v3 = add v1, v5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

fn @panic() {
  bb0:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000
    mstore 4, 17
    revert 0, 36
}

// An overflow check that calls a panic helper leaves the body straight-line:
// each copy keeps its own call. No copy reads the counter, so the group
// advances it once.
// CHECK-LABEL: {{^[ +].*}}fn @checked{{[( ]}}
// CHECK: + [[I:v[0-9]+]] = phi [bb0: 5], {{\[}}[[LATCH:bb[0-9]+]]: {{v[0-9]+}}]
// CHECK: + [[AHEAD:v[0-9]+]] = add [[I]], 9
// CHECK-NEXT: + {{v[0-9]+}} = lt [[AHEAD]], arg0
// CHECK-COUNT-4: + icall @panic
// CHECK: + [[LATCH]]:
// CHECK-NEXT: + {{v[0-9]+}} = add [[I]], 12
// CHECK-NEXT: + jump
fn @checked(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 5], [bb3: v6]
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v4 = add v1, arg1
    v5 = lt v4, v1
    jumpi v5, bb4, bb3
  bb3:
    v6 = add v0, 3
    jump bb1
  bb4:
    icall @panic
    jump bb3
  bb5:
    ret v1
}

// A reverting block that receives a body value through a phi gains an input
// from each copy.
// CHECK-LABEL: {{^[ +].*}}fn @revert_payload{{[( ]}}
// CHECK-COUNT-4: + jumpi {{v[0-9]+}}, bb4, {{bb[0-9]+}}
// CHECK: - v6 = phi [bb2: v3]
// CHECK-NEXT: + v6 = phi [bb2: v3], [{{bb[0-9]+}}: {{v[0-9]+}}], [{{bb[0-9]+}}: {{v[0-9]+}}], [{{bb[0-9]+}}: {{v[0-9]+}}], [{{bb[0-9]+}}: {{v[0-9]+}}]
fn @revert_payload(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = phi [bb0: 1], [bb3: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v3 = mul v1, 3
    v4 = gt v3, 1000
    jumpi v4, bb4, bb3
  bb3:
    v5 = add v0, 1
    jump bb1
  bb4:
    v6 = phi [bb2: v3]
    mstore 0, v6
    revert 0, 32
  bb5:
    ret v1
}

// A literal bound with many iterations left pays for the copies.
// CHECK-LABEL: {{^[ +].*}}fn @long_literal{{[( ]}}
// CHECK: + [[AHEAD:v[0-9]+]] = add {{v[0-9]+}}, 3
// CHECK-NEXT: + {{v[0-9]+}} = lt [[AHEAD]], 100
fn @long_literal() -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, 100
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A loop that runs three times becomes three copies of its body, each entered by a jump, and
// the header after the last copy leaves without testing.
// CHECK-LABEL: {{^[ +].*}}fn @short_literal{{[( ]}}
// CHECK: + {{v[0-9]+}} = phi [bb0: 0]
// CHECK: + [[FIRST:v[0-9]+]] = add {{v[0-9]+}}, 1
// CHECK: + {{v[0-9]+}} = phi {{\[}}{{bb[0-9]+}}: [[FIRST]]]
// CHECK: + [[SECOND:v[0-9]+]] = add {{v[0-9]+}}, 1
// CHECK: + {{v[0-9]+}} = phi {{\[}}{{bb[0-9]+}}: [[SECOND]]]
// CHECK: + [[THIRD:v[0-9]+]] = add {{v[0-9]+}}, 1
// CHECK: + v0 = phi {{\[}}{{bb[0-9]+}}: [[THIRD]]], [bb2: v4]
// CHECK: - jumpi v2, bb2, bb3
// CHECK-NEXT: + jump bb3
fn @short_literal() -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, 3
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A counter that starts within `2^64` steps of wrapping could wrap
// `i + 1`: the loop is kept.
// CHECK-LABEL: {{^[ +].*}}fn @wrapping_start{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @wrapping_start(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A reverting block that reads a body value would need a phi for the value
// of each copy, and the backend copies the phis of an aborting block through
// memory ahead of every branch to it: the loop is kept.
// CHECK-LABEL: {{^[ +].*}}fn @exit_use{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @exit_use(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = phi [bb0: 1], [bb3: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v3 = add v1, v0
    v4 = gt v3, 1000
    jumpi v4, bb4, bb3
  bb3:
    v5 = add v0, 1
    jump bb1
  bb4:
    mstore 0, v3
    revert 0, 32
  bb5:
    ret v1
}

// The stack scheduler reloads a word computed before the loop in every
// iteration, and the copies would double that traffic: the loop is kept.
// CHECK-LABEL: {{^[ +].*}}fn @hoisted{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @hoisted(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v6 = shl 3, arg1
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v7 = add v6, v0
    v3 = add v1, v7
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A body that only compares against a word computed before the loop, as the
// header compares the counter with its bound, unrolls: the stack scheduler keeps
// such a word beside the bound instead of reloading it.
// CHECK-LABEL: {{^[ +].*}}fn @hoisted_limit{{[( ]}}
// CHECK: + [[AHEAD:v[0-9]+]] = add {{v[0-9]+}}, 3
// CHECK-NEXT: + {{v[0-9]+}} = lt [[AHEAD]], arg0
// CHECK-COUNT-4: + {{v[0-9]+}} = gt {{v[0-9]+}}, v0
fn @hoisted_limit(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v6 = shl 3, arg1
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v4]
    v1 = phi [bb0: 0], [bb3: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb4
  bb2:
    v3 = add v1, v0
    v7 = gt v3, v6
    jumpi v7, bb5, bb3
  bb3:
    v4 = add v0, 1
    jump bb1
  bb4:
    ret v1
  bb5:
    revert 0, 0
}

// A body that branches on the counter is not straight-line: the loop is kept.
// CHECK-LABEL: {{^[ +].*}}fn @branchy{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @branchy(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v6]
    v1 = phi [bb0: 0], [bb4: v5]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v3 = and v0, 1
    v7 = ne v3, 0
    jumpi v7, bb3, bb4
  bb3:
    v4 = add v1, v0
    jump bb4
  bb4:
    v5 = phi [bb2: v1], [bb3: v4]
    v6 = add v0, 1
    jump bb1
  bb5:
    ret v1
}

// The original loop repeats its header for the iteration the main loop
// declined, so a header with effects keeps the loop.
// CHECK-LABEL: {{^[ +].*}}fn @effectful_header{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @effectful_header(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    mstore 128, v1
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// Only the inner loop is unrolled; the outer loop contains it.
// CHECK-LABEL: {{^[ +].*}}fn @nested{{[( ]}}
// CHECK: {{^ +}}jump bb1
// CHECK: - jump bb3
// CHECK-NEXT: + jump [[MAIN:bb[0-9]+]]
// CHECK-NEXT: + [[MAIN]]:
// CHECK-NEXT: + {{v[0-9]+}} = phi [bb2: 0], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}]
fn @nested(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v8]
    v1 = phi [bb0: 0], [bb5: v7]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb6
  bb2:
    jump bb3
  bb3:
    v3 = phi [bb2: 0], [bb4: v6]
    v4 = phi [bb2: v1], [bb4: v5]
    v9 = lt v3, arg1
    jumpi v9, bb4, bb5
  bb4:
    v5 = add v4, v3
    v6 = add v3, 1
    jump bb3
  bb5:
    v7 = add v4, v0
    v8 = add v0, 1
    jump bb1
  bb6:
    ret v1
}

// A counter that runs until it reaches its bound, here a pointer, peels one
// iteration when an odd number remain, and the original header then tests the
// bound once per two iterations. The check and the peeled copy both enter the
// loop through one block, so the header keeps one entry edge.
// CHECK-LABEL: {{^[ +].*}}fn @pointer_counter{{[( ]}}
// CHECK: + jump [[CHECK:bb[0-9]+]]
// CHECK-NEXT: + [[CHECK]]:
// CHECK: + [[WORD:v[0-9]+]] = ptrtoint memptr {{v[0-9]+}} to i256
// CHECK: + [[LEFT:v[0-9]+]] = sub v1, [[WORD]]
// CHECK-NEXT: + [[BIT:v[0-9]+]] = and [[LEFT]], 1
// CHECK-NEXT: + [[ODD:v[0-9]+]] = ne [[BIT]], 0
// CHECK-NEXT: + jumpi [[ODD]], [[PEEL:bb[0-9]+]], [[ENTER:bb[0-9]+]]
// CHECK-NEXT: + [[PEEL]]:
// CHECK: + jump [[ENTER]]
// CHECK-NEXT: + [[ENTER]]:
// CHECK-NEXT: + [[SUM:v[0-9]+]] = phi {{\[}}[[CHECK]]: {{v[0-9]+}}], {{\[}}[[PEEL]]: {{v[0-9]+}}]
// CHECK: - v2 = phi [bb0: 0], [bb3: v8]
// CHECK: + v2 = phi {{\[}}[[ENTER]]: [[SUM]]], {{\[}}[[SECOND:bb[0-9]+]]: {{v[0-9]+}}]{{$}}
// CHECK: + jump [[SECOND_HEADER:bb[0-9]+]]
// CHECK-NEXT: + [[SECOND_HEADER]]:
// CHECK: + [[SECOND]]:
fn @pointer_counter(arg0: memptr, arg1: i256) -> i256 {
  bb0:
    v0 = ptrtoint memptr arg0 to i256
    v1 = add v0, arg1
    jump bb1
  bb1:
    v2 = phi [bb0: 0], [bb3: v8]
    v3 = phi [bb0: arg0], [bb3: v9]
    v4 = ptrtoint memptr v3 to i256
    v5 = ne v4, v1
    jumpi v5, bb3, bb2
  bb2:
    ret v2
  bb3:
    v6 = add v4, 1
    v7 = mload v6
    v8 = add v2, v7
    v9 = inttoptr i256 v6 to memptr
    jump bb1
}

// A scan stepping by 32 reads the parity from bit 5 of the distance.
// CHECK-LABEL: {{^[ +].*}}fn @word_scan{{[( ]}}
// CHECK: + [[LEFT:v[0-9]+]] = sub arg1, {{v[0-9]+}}
// CHECK-NEXT: + [[COUNT:v[0-9]+]] = shr 5, [[LEFT]]
// CHECK-NEXT: + {{v[0-9]+}} = and [[COUNT]], 1
fn @word_scan(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = ne arg1, v0
    jumpi v2, bb2, bb3
  bb2:
    v5 = mload v0
    v3 = add v1, v5
    v4 = add v0, 32
    jump bb1
  bb3:
    ret v1
}

// An end built as the start plus a count shifted by five leaves that count to
// go on entry, so the parity is the count's lowest bit.
// CHECK-LABEL: {{^[ +].*}}fn @word_scan_to_end{{[( ]}}
// CHECK-NOT: = sub
// CHECK: + [[BIT:v[0-9]+]] = and arg1, 1
// CHECK-NEXT: + [[ODD:v[0-9]+]] = ne [[BIT]], 0
// CHECK-NEXT: + jumpi [[ODD]],
fn @word_scan_to_end(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v6 = shl 5, arg1
    v7 = add arg0, v6
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = ne v0, v7
    jumpi v2, bb2, bb3
  bb2:
    v5 = mload v0
    v3 = add v1, v5
    v4 = add v0, 32
    jump bb1
  bb3:
    ret v1
}

// A `<` test needs a literal start to rule out `i + s` wrapping: the loop is
// kept.
// CHECK-LABEL: {{^[ +].*}}fn @variable_start_below{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @variable_start_below(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg1
    jumpi v2, bb2, bb3
  bb2:
    v5 = mload v0
    v3 = add v1, v5
    v4 = add v0, 32
    jump bb1
  bb3:
    ret v1
}

// A loop that leaves once its counter passes the bound, `i <= n`, and steps
// by two tests `i + 6 > n` to leave the main loop.
// CHECK-LABEL: {{^[ +].*}}fn @at_most{{[( ]}}
// CHECK: + [[I:v[0-9]+]] = phi [bb0: 2], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}]
// CHECK: + [[AHEAD:v[0-9]+]] = add [[I]], 6
// CHECK-NEXT: + [[BEYOND:v[0-9]+]] = gt [[AHEAD]], arg0
// CHECK-NEXT: + jumpi [[BEYOND]], bb1, {{bb[0-9]+}}
fn @at_most(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 2], [bb2: v4]
    v1 = phi [bb0: 1], [bb2: v3]
    v2 = gt v0, arg0
    jumpi v2, bb3, bb2
  bb2:
    v3 = mul v1, v0
    v4 = add v0, 2
    jump bb1
  bb3:
    ret v1
}

// Leaving when the counter equals the bound is the `!=` loop with its branch
// reversed.
// CHECK-LABEL: {{^[ +].*}}fn @eq_exit{{[( ]}}
// CHECK: + [[LEFT:v[0-9]+]] = sub arg1, {{v[0-9]+}}
// CHECK-NEXT: + [[COUNT:v[0-9]+]] = shr 5, [[LEFT]]
// CHECK-NEXT: + {{v[0-9]+}} = and [[COUNT]], 1
fn @eq_exit(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = eq v0, arg1
    jumpi v2, bb3, bb2
  bb2:
    v5 = mload v0
    v3 = add v1, v5
    v4 = add v0, 32
    jump bb1
  bb3:
    ret v1
}

// A `<=` loop stepping by one tests `i < n` in its main loop, from any start:
// `i + 1` cannot wrap below `n`, and the copies keep the increment's overflow
// check.
// CHECK-LABEL: {{^[ +].*}}fn @up_to{{[( ]}}
// CHECK: + [[I:v[0-9]+]] = phi [bb0: arg0], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}]
// CHECK: + [[BELOW:v[0-9]+]] = lt [[I]], arg1
// CHECK-NEXT: + jumpi [[BELOW]], [[FIRST:bb[0-9]+]], bb1
// CHECK: + [[FIRST]]:
// CHECK: + jumpi {{v[0-9]+}}, bb4, {{bb[0-9]+}}
// CHECK: + jumpi {{v[0-9]+}}, bb4, {{bb[0-9]+}}
fn @up_to(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v5]
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = gt v0, arg1
    jumpi v2, bb2, bb3
  bb2:
    ret v1
  bb3:
    v4 = add v1, v0
    v5 = add v0, 1
    v6 = eq v5, 0
    jumpi v6, bb4, bb1
  bb4:
    revert 0, 0
}

// At these runs a larger body pays for four copies as well.
// CHECK-LABEL: {{^[ +].*}}fn @larger_body{{[( ]}}
// CHECK: + [[I:v[0-9]+]] = phi [bb0: 0], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}]
// CHECK: + [[AHEAD:v[0-9]+]] = add [[I]], 3
// CHECK-NEXT: + {{v[0-9]+}} = lt [[AHEAD]], arg0
// CHECK-COUNT-4: + {{v[0-9]+}} = xor
// CHECK-NOT: + {{v[0-9]+}} = xor
fn @larger_body(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v8]
    v1 = phi [bb0: 0], [bb2: v7]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = mul v1, 0x123456789abcdef
    v4 = xor v3, 0xfedcba987654321
    v5 = add v4, arg1
    v6 = and v5, 0x7fffffffffffffffffff
    v7 = add v6, v0
    v8 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A counter that counts down to zero reads its parity from its own low bit:
// with a step of `2^256 - 1`, `0 - i` and `i` agree there.
// CHECK-LABEL: {{^[ +].*}}fn @count_down{{[( ]}}
// CHECK: + jump [[CHECK:bb[0-9]+]]
// CHECK-NEXT: + [[CHECK]]:
// CHECK-NEXT: + [[I:v[0-9]+]] = phi [bb0: arg0]
// CHECK-NEXT: + {{v[0-9]+}} = phi [bb0: 0]
// CHECK: + [[BIT:v[0-9]+]] = and [[I]], 1
// CHECK-NEXT: + [[ODD:v[0-9]+]] = ne [[BIT]], 0
// CHECK-NEXT: + jumpi [[ODD]], {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK: = sub {{v[0-9]+}}, 1
fn @count_down(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = ne v0, 0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = sub v0, 1
    jump bb1
  bb3:
    ret v1
}

// A counter above zero has not reached it; stepping down by two, the parity
// comes from bit 1.
// CHECK-LABEL: {{^[ +].*}}fn @above_zero{{[( ]}}
// CHECK: + [[I:v[0-9]+]] = phi [bb0: arg0]
// CHECK: + [[COUNT:v[0-9]+]] = shr 1, [[I]]
// CHECK-NEXT: + {{v[0-9]+}} = and [[COUNT]], 1
fn @above_zero(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = gt v0, 0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = sub v0, 2
    jump bb1
  bb3:
    ret v1
}

// Counting down to a nonzero bound subtracts the counter from it.
// CHECK-LABEL: {{^[ +].*}}fn @count_down_to{{[( ]}}
// CHECK: + [[I:v[0-9]+]] = phi [bb0: arg0]
// CHECK: + [[LEFT:v[0-9]+]] = sub arg1, [[I]]
// CHECK-NEXT: + {{v[0-9]+}} = and [[LEFT]], 1
fn @count_down_to(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = ne v0, arg1
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = sub v0, 1
    jump bb1
  bb3:
    ret v1
}

// A `<` test bounds a counter that grows; one that shrinks keeps the loop.
// CHECK-LABEL: {{^[ +].*}}fn @shrinking_below{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @shrinking_below(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 100], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v0
    v4 = sub v0, 1
    jump bb1
  bb3:
    ret v1
}

// A body that aborts unless a word computed before the loop holds runs its
// first iteration in a copy that keeps the test; the loop after it jumps past
// the test, and a declined first iteration reaches the original header, which
// declines it as well. Both ways from the copy enter the loop through one
// block, so the loop keeps a preheader and unrolls next.
// CHECK-LABEL: {{^[ +].*}}fn @invariant_test{{[( ]}}
// CHECK: + jump [[FIRST:bb[0-9]+]]
// CHECK-NEXT: + [[FIRST]]:
// CHECK: + jumpi {{v[0-9]+}}, [[FIRST_BODY:bb[0-9]+]], [[ENTER:bb[0-9]+]]
// CHECK-NEXT: + [[FIRST_BODY]]:
// CHECK-NEXT: + jumpi [[NONZERO:v[0-9]+]], {{bb[0-9]+}}, bb4
// CHECK: + jump [[ENTER]]
// CHECK-NEXT: + [[ENTER]]:
// CHECK-NEXT: + {{v[0-9]+}} = phi {{\[}}[[FIRST]]: {{v[0-9]+}}], [{{bb[0-9]+}}: {{v[0-9]+}}]
// CHECK: + {{v[0-9]+}} = and {{v[0-9]+}}, 1
// CHECK: - jumpi [[NONZERO]], bb3, bb4
// CHECK-NEXT: - bb4:
// CHECK-NEXT: - revert 0, 0
// CHECK-NEXT: + jump bb3
fn @invariant_test(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v7 = ne arg1, 0
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    jumpi v7, bb3, bb4
  bb3:
    v3 = div v1, arg1
    v4 = add v1, v3
    v5 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A test the loop computes in each iteration is not decided by the first, so
// the loop is not peeled; reading a word computed before it, it is not
// unrolled either.
// CHECK-LABEL: {{^[ +].*}}fn @variant_test{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @variant_test(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v8 = shl 3, arg1
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v5]
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb5
  bb2:
    v7 = ne v1, arg1
    jumpi v7, bb3, bb4
  bb3:
    v3 = mload v0
    v4 = add v3, v8
    v5 = add v0, 1
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v1
}

// A header that reads the remaining gas could branch the other way when the
// original header repeats it after a peeled copy's header declined, and enter a
// body whose test the copy never ran: the loop is not peeled.
// CHECK-LABEL: {{^[ +].*}}fn @gas_header{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @gas_header(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v7 = ne arg1, 0
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v4]
    v1 = gas
    v2 = lt v1, 1000000
    jumpi v2, bb2, bb5
  bb2:
    jumpi v7, bb3, bb4
  bb3:
    v3 = div arg0, arg1
    v4 = add v0, v3
    jump bb1
  bb4:
    revert 0, 0
  bb5:
    ret v0
}

// A counter that only counts iterations counts from `-n` up to zero instead, so
// the header tests a word against zero and needs no bound. This loop reads a
// word computed before it and stays rolled.
// CHECK-LABEL: {{^[ +].*}}fn @reversed{{[( ]}}
// CHECK: + [[START:v[0-9]+]] = sub 0, arg0
// CHECK: + {{v[0-9]+}} = phi [bb0: [[START]]], [bb2: {{v[0-9]+}}]
// CHECK: + {{v[0-9]+}} = ne {{v[0-9]+}}, 0
fn @reversed(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v6 = shl 3, arg1
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, v6
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}

// A search that leaves at a match unrolls as well: its match exit reads the pointer through a
// phi, so the match edge of every copy brings that copy's pointer.
// CHECK-LABEL: {{^[ +].*}}fn @search_exit{{[( ]}}
// CHECK: - [[OLD:v[0-9]+]] = sub v0, arg0
// CHECK: + [[FOUND:v[0-9]+]] = phi [bb2: v0], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}]
// CHECK-NEXT: + [[OLD]] = sub [[FOUND]], arg0
fn @search_exit(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb4: v5]
    v1 = ne v0, arg1
    jumpi v1, bb2, bb5
  bb2:
    v2 = calldataload v0
    v3 = eq v2, arg2
    jumpi v3, bb3, bb4
  bb4:
    v5 = add v0, 32
    jump bb1
  bb3:
    v6 = sub v0, arg0
    jump bb6
  bb5:
    jump bb6
  bb6:
    v7 = phi [bb3: v6], [bb5: arg1]
    ret v7
}

// The same search returning at its match unrolls too: the returning block
// takes the pointer through a phi as well.
// CHECK-LABEL: {{^[ +].*}}fn @search_return{{[( ]}}
// CHECK: + [[FOUND:v[0-9]+]] = phi [bb2: v0], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}], {{\[}}{{bb[0-9]+}}: {{v[0-9]+}}]
// CHECK-NEXT: + {{v[0-9]+}} = sub [[FOUND]], arg0
fn @search_return(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb4: v5]
    v1 = ne v0, arg1
    jumpi v1, bb2, bb5
  bb2:
    v2 = calldataload v0
    v3 = eq v2, arg2
    jumpi v3, bb3, bb4
  bb4:
    v5 = add v0, 32
    jump bb1
  bb3:
    v6 = sub v0, arg0
    ret v6
  bb5:
    ret arg1
}
