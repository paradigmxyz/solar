; function get(uint256 i) external view returns (uint256) [selector 0x9507d39a]
fn @get(arg0: i256) -> i256 [selector=0x9507d39a, view, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = lt arg0, 8
    v1 = eq v0, false
    icall panic_if<0x32>, v1
