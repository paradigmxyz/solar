; function decode(bytes calldata data) external pure returns (uint32 a, uint16 b) [selector 0xe5c5e9a3]
fn @decode(arg0: slice<calldata>) -> struct2 [selector=0xe5c5e9a3, pure, abi_params=[bytes], abi_returns=[word<uint32>, word<uint16>], abi_return_params=[uint32, uint16]] {
  bb0:
    v0 = icall @u32, arg0, 0
