; function u32(bytes calldata data, uint256 start) internal pure returns (uint32 value, uint256 offset)
fn @u32(arg0: slice<calldata>, arg1: i256) -> struct0 [pure] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: i32 0], [bb3: v20]
    v3 = phi [bb0: arg1], [bb3: v21]
    v4 = phi [bb0: 0], [bb3: v22]
    v5 = lt v4, 4
    jumpi v5, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    v23 = insert_value struct0, undef struct0, 0, v2
    v24 = insert_value struct0, v23, 1, v3
    ret v24
  bb4:                                            ; preds = bb1
    v6 = shl v2, i32 8
    v7 = extract_value slice<calldata>, v0, 1
    v8 = lt v3, v7
    v9 = eq v8, false
    icall panic_if<0x32>, v9
    v10 = extract_value slice<calldata>, v0, 0
    v11 = extract_value slice<calldata>, v0, 0
    v12 = ptrtoint ptr<calldata> v11 to i256
    v13 = add v12, v3
    v14 = calldataload v13
    v15 = byte 0, v14
    v16 = shl v15, 248
    v17 = shr v16, 248
    v18 = trunc i256 v17 to i8
    v19 = zext i8 v18 to i32
    v20 = or v6, v19
    v21 = checked_add uint256, v3, 1
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v22 = checked_add uint256, v4, 1
    jump bb1
}

; function u16(bytes calldata data, uint256 start) internal pure returns (uint16 value, uint256 offset)
fn @u16(arg0: slice<calldata>, arg1: i256) -> struct1 [pure] {
  bb0:
