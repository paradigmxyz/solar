// === ROOT/tests/ui/codegen/mir/loop-unroll/complete_loops.sol:CompleteLoops ===
@module CompleteLoops
@types
  struct0: {i32, i256}
  struct1: {i16, i256}
  struct2: {i32, i16}

fn @u32(arg0: slice<calldata>, arg1: i256) -> struct0 [pure] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg1], [bb3: v21]
    v1 = phi [bb0: arg0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v22]
    v3 = phi [bb0: 0], [bb3: v23]
    v4 = phi [bb0: arg1], [bb3: v4]
    v5 = lt v2, 4
    jumpi v5, bb4, bb5
  bb5:
    jump bb2
  bb2:
    v24 = trunc i256 v3 to i32
    v25 = insert_value struct0, undef struct0, 0, v24
    v26 = insert_value struct0, v25, 1, v0
    ret v26
  bb4:
    v6 = trunc i256 v3 to i32
    v7 = shl i32 8, v6
    v8 = extract_value slice<calldata>, v1, 1
    v9 = lt v0, v8
    v10 = eq v9, false
    icall panic_if<0x32>, v10
    v11 = extract_value slice<calldata>, v1, 0
    v12 = extract_value slice<calldata>, v1, 0
    v13 = add v12, v0
    v14 = load calldata v13
    v15 = byte 0, v14
    v16 = shl 248, v15
    v17 = shr 248, v16
    v18 = trunc i256 v17 to i8
    v19 = zext i8 v18 to i32
    v20 = or v7, v19
    v21 = checked_add u256, v0, 1
    jump bb6
  bb6:
    jump bb3
  bb3:
    v22 = checked_add u256, v2, 1
    v23 = zext i32 v20 to i256
    jump bb1
}

fn @u16(arg0: slice<calldata>, arg1: i256) -> struct1 [pure] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v22]
    v2 = phi [bb0: 0], [bb3: v23]
    v3 = phi [bb0: arg1], [bb3: v3]
    v4 = phi [bb0: arg1], [bb3: v21]
    v5 = lt v1, 2
    jumpi v5, bb4, bb5
  bb5:
    jump bb2
  bb2:
    v24 = trunc i256 v2 to i16
    v25 = insert_value struct1, undef struct1, 0, v24
    v26 = insert_value struct1, v25, 1, v4
    ret v26
  bb4:
    v6 = trunc i256 v2 to i16
    v7 = shl i16 8, v6
    v8 = extract_value slice<calldata>, v0, 1
    v9 = lt v4, v8
    v10 = eq v9, false
    icall panic_if<0x32>, v10
    v11 = extract_value slice<calldata>, v0, 0
    v12 = extract_value slice<calldata>, v0, 0
    v13 = add v12, v4
    v14 = load calldata v13
    v15 = byte 0, v14
    v16 = shl 248, v15
    v17 = shr 248, v16
    v18 = trunc i256 v17 to i8
    v19 = zext i8 v18 to i16
    v20 = or v7, v19
    v21 = checked_add u256, v4, 1
    jump bb6
  bb6:
    jump bb3
  bb3:
    v22 = checked_add u256, v1, 1
    v23 = zext i16 v20 to i256
    jump bb1
}

fn @decode(arg0: slice<calldata>) -> struct2 [selector=0xe5c5e9a3, pure, abi_params=[bytes], abi_returns=[word<u32>, word<u16>], abi_return_params=[u32, u16]] {
  bb0:
    v0 = icall @u32, arg0, 0
    v1 = extract_value struct0, v0, 0
    v2 = extract_value struct0, v0, 1
    v3 = icall @u16, arg0, v2
    v4 = extract_value struct1, v3, 0
    v5 = extract_value struct1, v3, 1
    v6 = insert_value struct2, undef struct2, 0, v1
    v7 = insert_value struct2, v6, 1, v4
    ret v7
}

fn @sum4(arg0: slice<calldata>) -> i256 [selector=0x0540a714, pure, abi_params=[array<4, u256>], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v18]
    v2 = phi [bb0: 0], [bb3: v17]
    v3 = lt v1, 4
    jumpi v3, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v2
  bb4:
    v4 = extract_value slice<calldata>, v0, 1
    v5 = lt v1, v4
    v6 = eq v5, false
    icall panic_if<0x32>, v6
    v7 = extract_value slice<calldata>, v0, 0
    v8 = mul v1, 32
    v9 = eq 32, 0
    v10 = div v8, 32
    v11 = eq v10, v1
    v12 = or v9, v11
    v13 = zext i1 v12 to i256
    v14 = eq v13, 0
    icall panic_if<0x41>, v14
    v15 = add v7, v8
    v16 = load calldata v15
    v17 = checked_add u256, v2, v16
    jump bb6
  bb6:
    jump bb3
  bb3:
    v18 = checked_add u256, v1, 1
    jump bb1
}
