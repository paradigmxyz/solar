; function sum4(uint256[4] calldata values) external pure returns (uint256 total) [selector 0x0540a714]
fn @sum4(arg0: slice<calldata>) -> i256 [selector=0x0540a714, pure, abi_params=[array<4, uint256>], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
