//@compile-flags: -Zmir-pipeline=pre
//@filecheck:
@module DebugInfo

// CHECK-LABEL: {{^[ +].*}}fn @insert_missing_predecessor{{[( ]}}
// CHECK: + [[INSERTED:v[0-9]+]] = add arg0, 7 !metadata(span=30..40)
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @insert_missing_predecessor(arg0: u256, arg1: u256) -> u256 {
  bb0:
    switch arg1, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v2 = add arg0, 7 !metadata(span=10..20)
    jump bb4
  bb2:
    v3 = add 7, arg0 !metadata(span=20..30)
    jump bb4
  bb3:
    jump bb4
  bb4:
    v4 = add arg0, 7 !metadata(span=30..40)
    ret v4
}
