//@compile-flags: -Zmir-pipeline=pre
//@filecheck:
@module Pre
// CHECK-LABEL: {{^[ +].*}}fn @insert_missing_predecessor{{[( ]}}
// CHECK: + [[INSERTED:v[0-9]+]] = add arg0, 7
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @insert_missing_predecessor(arg0: i256, arg1: i256) -> i256 {
  bb0:
    switch arg1, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v2 = add arg0, 7
    jump bb4
  bb2:
    v3 = add 7, arg0
    jump bb4
  bb3:
    jump bb4
  bb4:
    v4 = add arg0, 7
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @translate_join_phi{{[( ]}}
// CHECK: + [[INSERTED:v[0-9]+]] = add arg2, 1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @translate_join_phi(arg0: i256, arg1: i256, arg2: i256, arg3: i256) -> i256 {
  bb0:
    switch arg3, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v4 = add arg0, 1
    jump bb4
  bb2:
    v5 = add arg1, 1
    jump bb4
  bb3:
    jump bb4
  bb4:
    v6 = phi [bb1: arg0], [bb2: arg1], [bb3: arg2]
    v7 = add v6, 1
    ret v7
}

// CHECK-LABEL: {{^[ +].*}}fn @two_way_join{{[( ]}}
// CHECK: + [[INSERTED:v[0-9]+]] = add arg0, 1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: [[INSERTED]]]
fn @two_way_join(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v2 = add arg0, 1
    jump bb3
  bb2:
    jump bb3
  bb3:
    v3 = add arg0, 1
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @split_branch_terminated_pred{{[( ]}}
// CHECK: + jumpi {{(arg[0-9]+|v[0-9]+)}}, bb5, bb4
// CHECK: + [[INSERTED:v[0-9]+]] = add arg0, 1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb5: [[INSERTED]]]
fn @split_branch_terminated_pred(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v2 = add arg0, 1
    jump bb3
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    v3 = add arg0, 1
    ret v3
  bb4:
    ret arg0
}

// CHECK-LABEL: fn @swapped_eq_predecessors
// CHECK: + [[INSERTED:v[0-9]+]] = eq arg0, arg1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @swapped_eq_predecessors(arg0: i256, arg1: i256, arg2: i256) -> i1 {
  bb0:
    switch arg2, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v0 = eq arg0, arg1
    jump bb4
  bb2:
    v1 = eq arg1, arg0
    jump bb4
  bb3:
    jump bb4
  bb4:
    v2 = eq arg0, arg1
    ret v2
}

// CHECK-LABEL: fn @swapped_ne_predecessors
// CHECK: + [[INSERTED:v[0-9]+]] = ne arg0, arg1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @swapped_ne_predecessors(arg0: i256, arg1: i256, arg2: i256) -> i1 {
  bb0:
    switch arg2, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v0 = ne arg0, arg1
    jump bb4
  bb2:
    v1 = ne arg1, arg0
    jump bb4
  bb3:
    jump bb4
  bb4:
    v2 = ne arg0, arg1
    ret v2
}

// CHECK-LABEL: fn @swapped_lt_gt_predecessors
// CHECK: + [[INSERTED:v[0-9]+]] = lt arg0, arg1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @swapped_lt_gt_predecessors(arg0: i256, arg1: i256, arg2: i256) -> i1 {
  bb0:
    switch arg2, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v0 = lt arg0, arg1
    jump bb4
  bb2:
    v1 = gt arg1, arg0
    jump bb4
  bb3:
    jump bb4
  bb4:
    v2 = lt arg0, arg1
    ret v2
}

// CHECK-LABEL: fn @swapped_slt_sgt_predecessors
// CHECK: + [[INSERTED:v[0-9]+]] = slt arg0, arg1
// CHECK: + {{v[0-9]+}} = phi [bb1: {{v[0-9]+}}], [bb2: {{v[0-9]+}}], [bb3: [[INSERTED]]]
fn @swapped_slt_sgt_predecessors(arg0: i256, arg1: i256, arg2: i256) -> i1 {
  bb0:
    switch arg2, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    v0 = slt arg0, arg1
    jump bb4
  bb2:
    v1 = sgt arg1, arg0
    jump bb4
  bb3:
    jump bb4
  bb4:
    v2 = slt arg0, arg1
    ret v2
}
