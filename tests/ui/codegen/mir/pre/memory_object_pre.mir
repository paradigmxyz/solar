//@compile-flags: -Zmir-pipeline=pre
//@filecheck:
@module MemoryObjectPre

// CHECK-LABEL: {{^[ +].*}}fn @hoist_projection{{[( ]}}
// CHECK: + [[INSERTED:v[0-9]+]] = add
// CHECK: + [[MERGE:v[0-9]+]] = phi [bb1: {{v[0-9]+}}], [bb2: [[INSERTED]]]
// CHECK: ret [[MERGE]]
fn @hoist_projection(arg0: memptr, arg1: i1) -> i256 {
  bb0:
    v0 = ptrtoint memptr arg0 to i256
    jumpi arg1, bb1, bb2
  bb1:
    v2 = add v0, 64
    jump bb3
  bb2:
    jump bb3
  bb3:
    v3 = add v0, 64
    ret v3
}
