- // === ROOT/tests/ui/codegen/mir/copy-runs/nested_floor_entry.mir (before copy-runs) ===
+ // === ROOT/tests/ui/codegen/mir/copy-runs/nested_floor_entry.mir (after copy-runs) ===
  @module NestedFloor
  fn @copy3(arg0: i256) {
    bb0:
      v0 = calldatasize
      v1 = sub v0, arg0
      v2 = lt v1, 96
      jumpi v2, bb2, bb1
    bb1:
      v3 = calldataload arg0
      mstore 128, v3
      v4 = add arg0, 32
      v5 = calldataload v4
      mstore 160, v5
      v6 = add arg0, 64
      v7 = calldataload v6
      mstore 192, v7
      stop
    bb2:
      revert 0, 0
  }
  
  fn @w() [selector=0x11111111] {
    bb0:
      v0 = calldataload 4
      v1 = calldatasize
      v2 = sub v1, 100
      v3 = gt v0, v2
      jumpi v3, bb2, bb1
    bb1:
      v4 = add v0, 4
      icall @copy3, v4
      stop
    bb2:
      revert 0, 0
  }
  
  fn @entry() [entry] {
    bb0:
      v0 = calldatasize
      v1 = lt v0, 0
      jumpi v1, bb2, bb1
    bb1:
      tail_call @w
    bb2:
      revert 0, 0
  }
  
  fn @g() {
    bb0:
      v0 = calldatasize
      v1 = lt v0, 100
      jumpi v1, bb2, bb1
    bb1:
      icall @entry
      stop
    bb2:
      revert 0, 0
  }
  
