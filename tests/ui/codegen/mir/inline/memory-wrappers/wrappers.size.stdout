    bb0:
      v0 = icall @wrap, arg0
      v1 = icall @wrap, v0
      v2 = icall @single, v1
      v3 = icall @effects, v2
      ret v3
  }
  
  fn @wrap(arg0: i256) -> i256 {
    bb0:
      v1 = mload arg0
      v2 = add v1, 2
      mstore arg0, v2
      ret arg0
  }
  
  fn @single(arg0: i256) -> i256 {
    bb0:
      v1 = mload arg0
      mstore arg0, v1
      ret arg0
  }
  
  fn @effects(arg0: i256) -> i256 {
    bb0:
      mstore arg0, 5
      sstore 0, 5
      ret arg0
  }
  
