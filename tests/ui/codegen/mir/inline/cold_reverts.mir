//@ revisions: general hot
//@ compile-flags: -Ogas
//@[general] compile-flags: -Zmir-pipeline=inline
//@[hot] compile-flags: -Zmir-pipeline=inline-hot-leaves
//@[general] filecheck: --check-prefixes=CHECK,GENERAL
//@[hot] filecheck: --check-prefix=CHECK
@module FailureEdges
// The successful path inlines while the failure payload stays shared.
// GENERAL-LABEL: fn @first
// GENERAL: - {{v[0-9]+}} = icall @checked
// GENERAL: + {{ *}}tail_call @failure
fn @first(arg0: i256) -> i256 [selector=0x01020304] {
  bb0:
    v0 = icall @checked, arg0
    v1 = add v0, 1
    ret v1
}
// GENERAL-LABEL: fn @second
// GENERAL: - {{v[0-9]+}} = icall @checked
// GENERAL: + {{ *}}tail_call @failure
fn @second(arg0: i256) -> i256 [selector=0x01020305] {
  bb0:
    v0 = icall @checked, arg0
    v1 = xor v0, 1
    ret v1
}
fn @checked(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 32
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, 7
    ret v1
  bb2:
    tail_call @failure
}
fn @failure() {
  bb0:
    mstore 0, 42
    revert 0, 32
}

// A returning tail call would bypass the inlined call's continuation.
// CHECK-LABEL: fn @returning_caller
// CHECK: {{^ +}}v0 = icall @returning_guard, arg0
fn @returning_caller(arg0: i256) -> i256 [selector=0x01020306] {
  bb0:
    v0 = icall @returning_guard, arg0
    v1 = add v0, 1
    ret v1
}
fn @returning_guard(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 32
    jumpi v0, bb1, bb2
  bb1:
    ret arg0
  bb2:
    tail_call @returns
}
fn @returns() -> i256 {
  bb0:
    ret 99
}

// Argument staging stays outside the bounded failure-edge policy.
// CHECK-LABEL: fn @argument_caller
// CHECK: {{^ +}}v0 = icall @argument_guard, arg0
fn @argument_caller(arg0: i256) -> i256 [selector=0x01020307] {
  bb0:
    v0 = icall @argument_guard, arg0
    ret v0
}
fn @argument_guard(arg0: i256) -> i256 {
  bb0:
    v0 = lt arg0, 32
    jumpi v0, bb1, bb2
  bb1:
    ret arg0
  bb2:
    tail_call @argument_failure, arg0
}
fn @argument_failure(arg0: i256) {
  bb0:
    mstore 0, arg0
    revert 0, 32
}

// A failure edge must not disqualify a checked leaf inside a loop either.
// CHECK-LABEL: fn @loop_caller
// CHECK: - {{v[0-9]+}} = icall @checked
// CHECK: + {{ *}}tail_call @failure
fn @loop_caller(arg0: i256) -> i256 [selector=0x01020308] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v4]
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v0, arg0
    jumpi v2, bb2, bb3
  bb2:
    v5 = icall @checked, v0
    v3 = add v1, v5
    v4 = add v0, 1
    jump bb1
  bb3:
    ret v1
}
