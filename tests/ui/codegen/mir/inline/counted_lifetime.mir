//@ revisions: one many size
//@ compile-flags: -Zmir-pipeline=inline
//@[one] compile-flags: -Ogas --optimize-runs=1
//@[many] compile-flags: -Ogas --optimize-runs=10000
//@[size] compile-flags: -Osize --optimize-runs=1
//@[one] filecheck:
@module CountedLifetime

// The hot call dominates the latch of a counted loop; the cold call executes
// once per invocation. The conditional call cannot receive the loop multiplier.
// CHECK-LABEL: fn @cold
// CHECK: {{^ +}}v0 = icall @helper
fn @cold(arg0: u256) -> u256 {
  bb0:
    v0 = icall fn3, 1, arg0
    ret v0
}
// CHECK-LABEL: fn @hot
// CHECK: - {{v[0-9]+}} = icall @helper
fn @hot(arg0: u256) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = lt v0, 1000
    jumpi v1, bb2, bb3
  bb2:
    v2 = icall fn3, 1, arg0
    mstore 128, v2
    v3 = add v0, 1
    jump bb1
  bb3:
    v4 = mload 128
    ret v4
}
// CHECK-LABEL: fn @conditional
// CHECK: {{^ +}}v2 = icall @helper
fn @conditional(arg0: u256, arg1: bool) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb4: v3]
    v1 = lt v0, 1000
    jumpi v1, bb2, bb5
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    v2 = icall fn3, 1, arg0
    mstore 128, v2
    jump bb4
  bb4:
    v3 = add v0, 1
    jump bb1
  bb5:
    v4 = mload 128
    ret v4
}
fn @helper(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1
    v1 = xor v0, 2
    v2 = add v1, 3
    v3 = xor v2, 4
    v4 = add v3, 5
    v5 = xor v4, 6
    v6 = add v5, 7
    v7 = xor v6, 8
    v8 = add v7, 9
    v9 = xor v8, 10
    v10 = add v9, 11
    v11 = xor v10, 12
    v12 = add v11, 13
    v13 = xor v12, 14
    v14 = add v13, 15
    v15 = xor v14, 16
    v16 = add v15, 17
    v17 = xor v16, 18
    v18 = add v17, 19
    v19 = xor v18, 20
    v20 = add v19, 21
    v21 = xor v20, 22
    v22 = add v21, 23
    v23 = xor v22, 24
    v24 = add v23, 25
    v25 = xor v24, 26
    v26 = add v25, 27
    v27 = xor v26, 28
    v28 = add v27, 29
    v29 = xor v28, 30
    v30 = add v29, 31
    v31 = xor v30, 32
    v32 = add v31, 33
    v33 = xor v32, 34
    v34 = add v33, 35
    v35 = xor v34, 36
    v36 = add v35, 37
    v37 = xor v36, 38
    v38 = add v37, 39
    v39 = xor v38, 40
    ret v39
}
