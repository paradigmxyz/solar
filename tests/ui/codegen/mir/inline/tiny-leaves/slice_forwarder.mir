//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=inline,cfg-simplify,dce
//@[size] compile-flags: -Osize -Zmir-pipeline=inline,cfg-simplify,dce
@module SliceForwarder

// Slice constructors and projections preserve the address space and the component words.
fn @caller(arg0: ptr<calldata>, arg1: i256) -> slice<calldata> {
  bb0:
    v0 = icall @construct, arg0, arg1
    ret v0
}

fn @construct(arg0: ptr<calldata>, arg1: i256) -> slice<calldata> {
  bb0:
    v0 = make_calldata_slice arg0, 0
    v1 = extract_value slice<calldata>, v0, 0
    v2 = make_calldata_slice v1, arg1
    ret v2
}

fn @memory_caller(arg0: ptr<memory>, arg1: i256) -> slice<memory> {
  bb0:
    v0 = icall @memory_construct, arg0, arg1
    ret v0
}

fn @memory_construct(arg0: ptr<memory>, arg1: i256) -> slice<memory> {
  bb0:
    v0 = make_memory_slice arg0, arg1
    ret v0
}

fn @returndata_caller(arg0: ptr<returndata>, arg1: i256) -> slice<returndata> {
  bb0:
    v0 = icall @returndata_construct, arg0, arg1
    ret v0
}

fn @returndata_construct(arg0: ptr<returndata>, arg1: i256) -> slice<returndata> {
  bb0:
    v0 = make_returndata_slice arg0, arg1
    ret v0
}

// A payload read is not a transparent slice operation.
fn @load_caller(arg0: ptr<memory>) -> slice<memory> {
  bb0:
    v0 = icall @load, arg0
    ret v0
}

fn @load(arg0: ptr<memory>) -> slice<memory> {
  bb0:
    v0 = mload arg0
    v1 = make_memory_slice arg0, v0
    ret v1
}
