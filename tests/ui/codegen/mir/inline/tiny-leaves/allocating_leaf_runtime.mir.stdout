; === ROOT/tests/ui/codegen/mir/inline/tiny-leaves/allocating_leaf_runtime.sol:AllocatingLeaf ===
@module AllocatingLeaf
@types
  struct0: {i256, i256}

; function pairA(uint256 x) external pure returns (uint256, uint256) [selector 0x40f7fec4]
fn @pairA(arg0: i256) -> struct0 [selector=0x40f7fec4, pure, abi_params=[uint256], abi_returns=[word, word], abi_return_params=[uint256, uint256]] {
  bb0:
    v0 = icall @newBuilder
    v1 = icall @newBuilder
    icall @writeWord, v0, arg0
    v2 = checked_add uint256, arg0, 1
    icall @writeWord, v1, v2
    v3 = icall @readWord, v0
    v4 = icall @readWord, v1
    v5 = insert_value struct0, undef struct0, 0, v3
    v6 = insert_value struct0, v5, 1, v4
    ret v6
}

; function pairB(uint256 x) external pure returns (uint256, uint256) [selector 0x9c7efff0]
fn @pairB(arg0: i256) -> struct0 [selector=0x9c7efff0, pure, abi_params=[uint256], abi_returns=[word, word], abi_return_params=[uint256, uint256]] {
  bb0:
    v0 = icall @newBuilder
    v1 = icall @newBuilder
    icall @writeWord, v0, arg0
    v2 = checked_add uint256, arg0, 1
    icall @writeWord, v1, v2
    v3 = icall @readWord, v0
    v4 = icall @readWord, v1
    v5 = insert_value struct0, undef struct0, 0, v3
    v6 = insert_value struct0, v5, 1, v4
    ret v6
}

; function lone(uint256 x) external pure returns (uint256) [selector 0x16595ead]
fn @lone(arg0: i256) -> i256 [selector=0x16595ead, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @singleBuilder
    icall @writeWord, v0, arg0
    v1 = icall @readWord, v0
    ret v1
}

; function newBuilder() pure returns (Builder b)
fn @newBuilder() -> i256 [pure] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    v1 = add v0, 32
    mstore 64, v1 !metadata(memory=scratch)
    ret v0
}

; function singleBuilder() pure returns (Builder b)
fn @singleBuilder() -> i256 [pure] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    v1 = add v0, 32
    mstore 64, v1 !metadata(memory=scratch)
    ret v0
}

; function writeWord(Builder b, uint256 value) pure
fn @writeWord(arg0: i256, arg1: i256) [pure] {
  bb0:
    mstore arg0, arg1
    ret
}

; function readWord(Builder b) pure returns (uint256 value)
fn @readWord(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = mload arg0
    ret v0
}
