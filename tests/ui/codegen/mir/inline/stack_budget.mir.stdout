  bb0:
    v0 = icall @branch, arg0, arg1
    v1 = add v0, arg1
    ret v1
}

fn @branch(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb2:
    v2 = xor arg1, 23
    jump bb3
