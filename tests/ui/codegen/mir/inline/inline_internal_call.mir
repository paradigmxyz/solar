//@compile-flags: --pass inline
//@filecheck:
@module InlineInternalCall
// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: - {{.*}}internal_call @callee
// CHECK: + {{v[0-9]+}} = phi [bb2: [[INLINED:v[0-9]+]]]
// CHECK: + [[INLINED]] = add arg0, 1
fn @caller(arg0: u256) -> u256 {
  bb0:
    v1 = internal_call @callee, 1, arg0
    ret v1
}

// CHECK-LABEL: {{^[ +].*}}fn @redirect_non_leading_phi{{[( ]}}
// CHECK: - {{v[0-9]+}} = phi [bb0:
// CHECK: + {{v[0-9]+}} = phi [[[CONT:bb[0-9]+]]: {{v[0-9]+}}], [bb2: {{v[0-9]+}}]
// CHECK: + [[CONT]]:
fn @redirect_non_leading_phi(arg0: u256, arg1: bool) -> u256 {
  bb0:
    v1 = internal_call @callee, 1, arg0
    jump bb1
  bb1:
    v2 = add arg0, 2
    v3 = phi [bb0: v1], [bb2: v4]
    jumpi arg1, bb2, bb3
  bb2:
    v4 = add v3, 1
    jump bb1
  bb3:
    ret v3
}

fn @callee(arg0: u256) -> u256 {
  bb0:
    v1 = add arg0, 1
    ret v1
}
