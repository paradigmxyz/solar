//@compile-flags: -Zmir-pipeline=inline
//@filecheck:
@module InlineICall
// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: - {{.*}}icall @callee
// CHECK: + [[INLINED:v[0-9]+]] = add arg0, 1
// CHECK: + {{v[0-9]+}} = phi [bb2: [[INLINED]]]
fn @caller(arg0: u256) -> u256 {
  bb0:
    v1 = icall fn1, 1, arg0
    ret v1
}

fn @callee(arg0: u256) -> u256 {
  bb0:
    v1 = add arg0, 1
    ret v1
}

// CHECK-LABEL: fn @source_context
// CHECK: icall @tuple, 2, arg0
// CHECK-NOT: + {{.*}}frame_store
fn @source_context(arg0: u256) -> u256 [selector=1] {
  bb0:
    v0 = icall @tuple, 2, arg0
    v1 = icall @source_memory, 1, v0
    ret v1
}

fn @tuple(arg0: u256) -> (u256, u256) {
  bb0:
    v0 = add arg0, 1
    ret arg0, v0
}

fn @source_memory(arg0: u256) -> u256 [unrestricted_memory] {
  bb0:
    mstore arg0, 0
    ret arg0
}
