//@ compile-flags: -Ogas -Zmir-pipeline=inline
//@ filecheck:
@module StackBudget

// A small acyclic helper fits beside the one word surviving its sole call.
// CHECK-LABEL: fn @low_pressure
// CHECK: - {{v[0-9]+}} = icall @choose
// CHECK: + {{v[0-9]+}} = phi
fn @low_pressure(arg0: i1, arg1: i256) -> i256 [selector=0x01020304] {
  bb0:
    v0 = icall @choose, arg0, arg1
    v1 = add arg1, v0
    ret v1
}
fn @choose(arg0: i1, arg1: i256) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = add arg1, 7
    jump bb3
  bb2:
    v1 = xor arg1, 23
    jump bb3
  bb3:
    v2 = phi [bb1: v0], [bb2: v1]
    ret v2
}

// The live arguments would exceed the inline stack budget.
// CHECK-LABEL: fn @high_pressure
// CHECK: {{^ +}}v0 = icall @wide_choose
fn @high_pressure(arg0: i1, arg1: i256, arg2: i256, arg3: i256, arg4: i256, arg5: i256, arg6: i256, arg7: i256, arg8: i256, arg9: i256, arg10: i256, arg11: i256, arg12: i256) -> i256 [selector=0x01020305] {
  bb0:
    v0 = icall @wide_choose, arg0, arg1
    v1 = add arg1, arg2
    v2 = add arg3, arg4
    v3 = add arg5, arg6
    v4 = add arg7, arg8
    v5 = add arg9, arg10
    v6 = add arg11, arg12
    v7 = add v0, v1
    v8 = add v2, v3
    v9 = add v4, v5
    v10 = add v6, v7
    v11 = add v8, v9
    v12 = add v10, v11
    ret v12
}
fn @wide_choose(arg0: i1, arg1: i256) -> i256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = add arg1, 7
    jump bb3
  bb2:
    v1 = xor arg1, 23
    jump bb3
  bb3:
    v2 = phi [bb1: v0], [bb2: v1]
    ret v2
}

// Backward liveness bounds a read-only loop helper too, so its sole call
// inlines with the loop-carried phi.
// CHECK-LABEL: fn @loop_caller
// CHECK: - {{v[0-9]+}} = icall @loop_body
// CHECK: + {{v[0-9]+}} = phi [{{bb[0-9]+}}: 0], [{{bb[0-9]+}}: {{v[0-9]+}}]
fn @loop_caller(arg0: i256) -> i256 [selector=0x01020306] {
  bb0:
    v0 = icall @loop_body, arg0
    ret v0
}
fn @loop_body(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    ret v0
}

// A single-block helper never reaches deeper than its call, which keeps the
// return address resident, so it inlines in a loop that holds more words
// across the call than the budget allows. A helper with several blocks still
// answers to the budget there.
// CHECK-LABEL: fn @straight_line_high_pressure
// CHECK: - {{v[0-9]+}} = icall @same_word
// CHECK: {{^ +}}v{{[0-9]+}} = icall @guarded_word
fn @straight_line_high_pressure(arg0: i256, arg1: i256, arg2: i256, arg3: i256, arg4: i256, arg5: i256, arg6: i256, arg7: i256, arg8: i256, arg9: i256, arg10: i256, arg11: i256, arg12: i256) -> i256 [selector=0x01020307] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v11]
    v1 = icall @same_word, v0, arg1
    v13 = icall @guarded_word, v0, arg2
    v14 = and v1, v13
    jumpi v14, bb3, bb2
  bb2:
    v2 = add v0, arg2
    v3 = add v2, arg3
    v4 = add v3, arg4
    v5 = add v4, arg5
    v6 = add v5, arg6
    v7 = add v6, arg7
    v8 = add v7, arg8
    v9 = add v8, arg9
    v10 = add v9, arg10
    v12 = add v10, arg11
    v11 = add v12, arg12
    jump bb1
  bb3:
    ret v0
}
fn @same_word(arg0: i256, arg1: i256) -> i1 {
  bb0:
    v0 = xor arg0, arg1
    v1 = and v0, 0xffffffffffffffffffffffff
    v2 = eq v1, 0
    ret v2
}
fn @guarded_word(arg0: i256, arg1: i256) -> i1 {
  bb0:
    v0 = gt arg0, arg1
    jumpi v0, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v1 = lt arg0, arg1
    ret v1
}
