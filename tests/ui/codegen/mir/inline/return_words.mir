//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=inline-tiny-leaves,cfg-simplify,dce
//@[size] compile-flags: -Osize -Zmir-pipeline=inline-tiny-leaves,cfg-simplify,dce
@module ReturnWords
types:
  struct0: {i256, i256}

fn @entry(arg0: i256, arg1: i256) -> i256 [selector=1] {
  bb0:
    v0 = icall @swap, arg0, arg1
    v1 = frame_load multi_return, word, 0
    v2 = add v1, 32
    v3 = mload v2
    v5 = bitcast i256 v0 to i256
    v4 = sub v5, v3
    ret v4
}
fn @swap(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    ret arg1, arg0
}
// A memory write prevents forwarding a subsequent buffer read.
fn @barrier(arg0: i256, arg1: i256) -> i256 [selector=2] {
  bb0:
    v0 = icall @swap, arg0, arg1
    v1 = frame_load multi_return, word, 0
    v2 = add v1, 32
    mstore v2, 99
    v3 = mload v2
    ret v3
}
