+ // === ROOT/tests/ui/codegen/mir/inline/all_sites_limits.mir (after inline) ===
  @module AllSitesLimits
  fn @phi_caller(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = icall @pick, arg0, arg1
      v1 = icall @pick, v0, arg1
      ret v1
  }
  
  fn @pick(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = lt arg0, arg1
      jumpi v0, bb1, bb2
    bb2:
      jump bb3
    bb1:
      jump bb3
    bb3:
      v1 = phi [bb1: arg0], [bb2: arg1]
      ret v1
  }
  
  fn @nine_caller(arg0: i256) -> i256 {
    bb0:
      v0 = icall @step, arg0
      v1 = icall @step, v0
      v2 = icall @step, v1
      v3 = icall @step, v2
      v4 = icall @step, v3
      v5 = icall @step, v4
      v6 = icall @step, v5
      v7 = icall @step, v6
      v8 = icall @step, v7
      ret v8
  }
  
  fn @step(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 3
      v1 = xor v0, arg0
      v2 = add v1, 7
      v3 = xor v2, v0
      v4 = add v3, 1
      ret v4
  }
  
