- ; === ROOT/tests/ui/codegen/mir/inline/all_sites_limits.mir (before inline) ===
+ ; === ROOT/tests/ui/codegen/mir/inline/all_sites_limits.mir (after inline) ===
  @module AllSitesLimits
  fn @phi_caller(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = icall @pick, arg0, arg1
      v1 = icall @pick, v0, arg1
      ret v1
  }
  
  fn @pick(arg0: i256, arg1: i256) -> i256 {
    bb0:
      v0 = lt arg0, arg1
      jumpi v0, bb1, bb2
    bb2:                                            ; preds = bb0
      jump bb3
    bb1:                                            ; preds = bb0
      jump bb3
    bb3:                                            ; preds = bb1, bb2
      v1 = phi [bb1: arg0], [bb2: arg1]
      ret v1
  }
  
  fn @nine_caller(arg0: i256) -> i256 {
    bb0:
      v0 = icall @step, arg0
      v1 = icall @step, v0
      v2 = icall @step, v1
      v3 = icall @step, v2
      v4 = icall @step, v3
      v5 = icall @step, v4
      v6 = icall @step, v5
      v7 = icall @step, v6
      v8 = icall @step, v7
      ret v8
  }
  
  fn @step(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 3
      v1 = xor v0, arg0
      v2 = add v1, 7
      v3 = xor v2, v0
      v4 = add v3, 1
      ret v4
  }
  
  fn @pressure_caller(arg0: i256, arg1: i256, arg2: i256, arg3: i256, arg4: i256, arg5: i256, arg6: i256, arg7: i256, arg8: i256, arg9: i256, arg10: i256, arg11: i256, arg12: i256) -> i256 {
    bb0:
      v0 = icall @churn, arg0
      v1 = icall @churn, v0
      v2 = add arg1, arg2
      v3 = add v2, arg3
      v4 = add v3, arg4
      v5 = add v4, arg5
      v6 = add v5, arg6
      v7 = add v6, arg7
      v8 = add v7, arg8
      v9 = add v8, arg9
      v10 = add v9, arg10
      v11 = add v10, arg11
      v12 = add v11, arg12
      v13 = add v12, v1
      ret v13
  }
  
  fn @churn(arg0: i256) -> i256 {
    bb0:
      v0 = add arg0, 3
      v1 = xor v0, arg0
      v2 = add v1, 7
      v3 = xor v2, v0
      v4 = add v3, 1
      ret v4
  }
  
