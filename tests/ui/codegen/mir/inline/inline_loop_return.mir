//@compile-flags: -Zmir-pipeline=inline
//@filecheck: --enable-var-scope
@module InlineLoopReturn

// The general pass leaves frame-backed loops to dedicated adapters.
// CHECK-LABEL: @caller
// CHECK: {{^ +}}{{v[0-9]+}} = icall @callee
fn @caller() -> i256 [selector=0x01020304] {
  bb0:
    v0 = icall @callee, 4
    v1 = add v0, 1
    ret v1
}

fn @callee(arg0: i256) -> i256 {
  bb0:
    v11 = internal_frame_addr 128
    v1 = ptrtoint memptr v11 to i256
    mstore v1, 0
    jump bb1
  bb1:
    v12 = internal_frame_addr 128
    v2 = ptrtoint memptr v12 to i256
    v3 = mload v2
    v4 = lt v3, arg0
    jumpi v4, bb2, bb3
  bb2:
    v13 = internal_frame_addr 128
    v5 = ptrtoint memptr v13 to i256
    v6 = mload v5
    v7 = add v6, 1
    v14 = internal_frame_addr 128
    v8 = ptrtoint memptr v14 to i256
    mstore v8, v7
    jump bb1
  bb3:
    v15 = internal_frame_addr 128
    v9 = ptrtoint memptr v15 to i256
    v10 = mload v9
    ret v10
}
