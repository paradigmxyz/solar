//@ compile-flags: -Ogas -Zmir-pipeline=inline,cfg-simplify,dce
//@ filecheck:
@module SharedCallee
@phase lowered

// Two cases reach `add`, so splicing would duplicate it: every route stays.
// CHECK-LABEL: {{^[ +].*}}fn @entry
// CHECK-DAG: tail_call @add
// CHECK-DAG: tail_call @sub
fn @add() {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = add v1, v2
    mstore 0, v0
    returndata 0, 32
}
fn @sub() {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = sub v1, v2
    mstore 0, v0
    returndata 0, 32
}
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb4, [1 => bb1, 2 => bb2, 3 => bb3]
  bb1:
    tail_call @add
  bb2:
    tail_call @add
  bb3:
    tail_call @sub
  bb4:
    revert 0, 0
}
