//@ compile-flags: -Ogas -Zmir-pipeline=inline,cfg-simplify,dce
//@ filecheck:
@module FewReaders
@phase lowered

// Two readers do not repay a longer live range, so the routes keep their boundary.
// CHECK-LABEL: {{^[ +].*}}fn @entry
// CHECK: tail_call @add
// CHECK: tail_call @sub
fn @add() {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = add v1, v2
    mstore 0, v0
    returndata 0, 32
}
fn @sub() {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = sub v1, v2
    mstore 0, v0
    returndata 0, 32
}
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    tail_call @add
  bb2:
    tail_call @sub
  bb3:
    revert 0, 0
}
