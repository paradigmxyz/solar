//@ compile-flags: -Ogas -Zmir-pipeline=inline,cfg-simplify,dce
//@ filecheck:
@module MemoryFreePointer
@phase lowered

// A route that reads the free memory pointer relies on the initialization that only a runtime
// entry receives, so the routes keep their boundary.
// CHECK-LABEL: {{^[ +].*}}fn @entry
// CHECK: tail_call @route
fn @one() {
  bb0:
    v1 = calldataload 4
    mstore 0, v1
    returndata 0, 32
}
fn @two() {
  bb0:
    v1 = calldataload 4
    v2 = add v1, 1
    mstore 0, v2
    returndata 0, 32
}
fn @route() {
  bb0:
    v1 = calldataload 4
    v2 = mload 64
    v3 = add v1, v2
    mstore 0, v3
    returndata 0, 32
}
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb4, [1 => bb1, 2 => bb2, 3 => bb3]
  bb1:
    tail_call @one
  bb2:
    tail_call @two
  bb3:
    tail_call @route
  bb4:
    revert 0, 0
}
