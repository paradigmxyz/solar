//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=inline,cfg-simplify,dce
//@[size] compile-flags: -Osize -Zmir-pipeline=inline,cfg-simplify,dce
//@ filecheck:
@module UnsharedRead
@phase lowered

// A route that reads no word leaves nothing to hoist above the switch, so no route moves.
// CHECK-LABEL: {{^[ +].*}}fn @entry
// CHECK: tail_call @add
// CHECK: tail_call @sub
// CHECK: tail_call @stop
fn @add() {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = add v1, v2
    mstore 0, v0
    returndata 0, 32
}
fn @sub() {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = sub v1, v2
    mstore 0, v0
    returndata 0, 32
}
fn @stop() {
  bb0:
    stop
}
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb4, [1 => bb1, 2 => bb2, 3 => bb3]
  bb1:
    tail_call @add
  bb2:
    tail_call @sub
  bb3:
    tail_call @stop
  bb4:
    revert 0, 0
}
