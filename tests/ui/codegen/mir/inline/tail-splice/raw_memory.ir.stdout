// === ROOT/tests/ui/codegen/mir/inline/tail-splice/raw_memory.sol:RawMemory ===
@module RawMemory
@phase lowered
fn @raw() {
  bb0:
    v0 = calldatasize
    v1 = lt v0, 36
    jumpi v1, bb1, bb2
  bb2:
    v2 = calldataload 4
    returndata v2, 32
  bb1:
    revert 0, 0
}

fn @sum() {
  bb0:
    v3 = calldatasize
    v4 = lt v3, 68
    jumpi v4, bb3, bb4
  bb4:
    v5 = calldataload 4
    v6 = calldataload 36
    v1 = add v5, v6
    v2 = lt v1, v5
    jumpi v2, bb1, bb2
  bb2:
    mstore 0, v1 !metadata(memory=scratch)
    returndata 0, 32
  bb1:
    mstore 32, 17 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
  bb3:
    revert 0, 0
}

fn @diff() {
  bb0:
    v3 = calldatasize
    v4 = lt v3, 68
    jumpi v4, bb3, bb4
  bb4:
    v5 = calldataload 4
    v6 = calldataload 36
    v1 = sub v5, v6
    v2 = lt v5, v6
    jumpi v2, bb1, bb2
  bb2:
    mstore 0, v1 !metadata(memory=scratch)
    returndata 0, 32
  bb1:
    mstore 32, 17 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
  bb3:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb5, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr v2, 224
    switch v3, default bb5, [0x302e678f => bb2, 0x8f5e514a => bb3, 0xcad0899b => bb4]
  bb4:
    tail_call @sum
  bb3:
    tail_call @diff
  bb2:
    tail_call @raw
  bb5:
    revert 0, 0
}

