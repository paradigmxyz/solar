- // === ROOT/tests/ui/codegen/mir/inline/tail-splice/memory_free_pointer.mir (before inline) ===
+ // === ROOT/tests/ui/codegen/mir/inline/tail-splice/memory_free_pointer.mir (after inline) ===
  @module MemoryFreePointer
  @phase lowered
  fn @one() {
    bb0:
      v0 = calldataload 4
      mstore 0, v0
      returndata 0, 32
  }
  
  fn @two() {
    bb0:
      v0 = calldataload 4
      v1 = add v0, 1
      mstore 0, v1
      returndata 0, 32
  }
  
  fn @route() {
    bb0:
      v0 = calldataload 4
      v1 = mload 64
      v2 = add v0, v1
      mstore 0, v2
      returndata 0, 32
  }
  
  fn @entry() [entry] {
    bb0:
      v0 = calldataload 0
      v1 = shr v0, 224
      switch v1, default bb4, [1 => bb1, 2 => bb2, 3 => bb3]
    bb3:
      tail_call @route
    bb2:
      tail_call @two
    bb1:
      tail_call @one
    bb4 [cold]:
      revert 0, 0
  }
  
