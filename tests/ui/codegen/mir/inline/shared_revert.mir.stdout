    v8 = add v5, v7
    v9 = add v0, v8
    jump bb6
  bb6:
    jump bb3
  bb3:
    v10 = add v2, 1
    jump bb1
}

fn @left(arg0: u256) -> u256 [pure] {
  bb0:
    v0 = lt arg0, 32
    v1 = iszero v0
    icall panic_if<0x1>, v1
    v2 = add arg0, 1
    ret v2
}

fn @right(arg0: u256) -> u256 [pure] {
