//@ compile-flags: -Ogas -Zmir-pipeline=inline
//@ filecheck: --enable-var-scope
@module InlineGlueOrigin
@types
  struct0: {i256, i256}

// The buffer stores for a multi-word return are glue the inliner creates, so they take the call's
// location.
// CHECK-LABEL: {{^[ +].*}}fn @buffer_stores{{[( ]}}
// CHECK: + {{v[0-9]+}} = internal_frame_addr {{[0-9]+}} !metadata(span=10..20)
// CHECK: + mstore {{.*}} !metadata(memory=internal_frame, span=10..20)
// CHECK: + frame_store multi_return, word, 0, {{.*}} !metadata(memory=scratch, span=10..20)
fn @buffer_stores(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = icall @swap, arg0, arg1 !metadata(span=10..20)
    ret v0 !metadata(span=30..40)
}
fn @swap(arg0: i256, arg1: i256) -> struct0 [return_abi=[i256, i256]] {
  bb0:
    ret arg1, arg0 !metadata(span=100..110)
}
