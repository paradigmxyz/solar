//@ compile-flags: -Ogas -Zmir-pipeline=inline
//@ filecheck:
@module SolarInline

// `always_inline`, which `@custom:solar-inline` sets, clones a callee into
// every caller although no cost test would: the body is large and each call
// runs at most once.
// CHECK-LABEL: fn @tagged
// CHECK: - {{v[0-9]+}} = icall @always
// CHECK: - {{v[0-9]+}} = icall @always
fn @tagged(arg0: i256, arg1: i1, arg2: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = icall fn2, arg0
    mstore 128, v0
    jump bb2
  bb2:
    jumpi arg2, bb3, bb4
  bb3:
    v1 = icall fn2, arg0
    mstore 160, v1
    jump bb4
  bb4:
    v2 = mload 128
    ret v2
}
// The same callee without the attribute stays shared.
// CHECK-LABEL: fn @untagged
// CHECK: {{^ +}}v0 = icall @shared
// CHECK: {{^ +}}v1 = icall @shared
fn @untagged(arg0: i256, arg1: i1, arg2: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = icall fn3, arg0
    mstore 128, v0
    jump bb2
  bb2:
    jumpi arg2, bb3, bb4
  bb3:
    v1 = icall fn3, arg0
    mstore 160, v1
    jump bb4
  bb4:
    v2 = mload 128
    ret v2
}
fn @always(arg0: i256) -> i256 [always_inline] {
  bb0:
    v0 = add arg0, 1
    v1 = xor v0, 2
    v2 = add v1, 3
    v3 = xor v2, 4
    v4 = add v3, 5
    v5 = xor v4, 6
    v6 = add v5, 7
    v7 = xor v6, 8
    v8 = add v7, 9
    v9 = xor v8, 10
    v10 = add v9, 11
    v11 = xor v10, 12
    v12 = add v11, 13
    v13 = xor v12, 14
    v14 = add v13, 15
    v15 = xor v14, 16
    v16 = add v15, 17
    v17 = xor v16, 18
    v18 = add v17, 19
    v19 = xor v18, 20
    v20 = add v19, 21
    v21 = xor v20, 22
    v22 = add v21, 23
    v23 = xor v22, 24
    v24 = add v23, 25
    v25 = xor v24, 26
    v26 = add v25, 27
    v27 = xor v26, 28
    v28 = add v27, 29
    v29 = xor v28, 30
    v30 = add v29, 31
    v31 = xor v30, 32
    v32 = add v31, 33
    v33 = xor v32, 34
    v34 = add v33, 35
    v35 = xor v34, 36
    v36 = add v35, 37
    v37 = xor v36, 38
    v38 = add v37, 39
    v39 = xor v38, 40
    ret v39
}
fn @shared(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1
    v1 = xor v0, 2
    v2 = add v1, 3
    v3 = xor v2, 4
    v4 = add v3, 5
    v5 = xor v4, 6
    v6 = add v5, 7
    v7 = xor v6, 8
    v8 = add v7, 9
    v9 = xor v8, 10
    v10 = add v9, 11
    v11 = xor v10, 12
    v12 = add v11, 13
    v13 = xor v12, 14
    v14 = add v13, 15
    v15 = xor v14, 16
    v16 = add v15, 17
    v17 = xor v16, 18
    v18 = add v17, 19
    v19 = xor v18, 20
    v20 = add v19, 21
    v21 = xor v20, 22
    v22 = add v21, 23
    v23 = xor v22, 24
    v24 = add v23, 25
    v25 = xor v24, 26
    v26 = add v25, 27
    v27 = xor v26, 28
    v28 = add v27, 29
    v29 = xor v28, 30
    v30 = add v29, 31
    v31 = xor v30, 32
    v32 = add v31, 33
    v33 = xor v32, 34
    v34 = add v33, 35
    v35 = xor v34, 36
    v36 = add v35, 37
    v37 = xor v36, 38
    v38 = add v37, 39
    v39 = xor v38, 40
    ret v39
}
