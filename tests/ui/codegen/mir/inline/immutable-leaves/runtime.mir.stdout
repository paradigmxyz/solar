; function vested(uint256 amount, uint64 timestamp) public view returns (uint256) [selector 0xcc71fadf]
fn @vested(arg0: i256, arg1: i64) -> i256 [selector=0xcc71fadf, view, abi_params=[uint256, uint64], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
