//@ revisions: cold warm
//@ compile-flags: -Zmir-pipeline=inline -Ogas --optimize-runs=200
//@[cold] compile-flags: -Zinline-profile=auxiliary/cold.json
//@[warm] compile-flags: -Zinline-profile=auxiliary/warm.json
@module ProfileLifetime

// One invocation cannot repay the duplicated body; a warm caller can.
// The profile counts replace optimizer runs instead of multiplying them.
fn @cold(arg0: i256) -> i256 [selector=0x01020304] {
  bb0:
    v0 = icall @helper, arg0
    ret v0
}
fn @conditional(arg0: i256) -> i256 [selector=0x01020305] {
  bb0:
    v0 = icall @helper, arg0
    ret v0
}
fn @helper(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1
    v1 = xor v0, 2
    v2 = add v1, 3
    v3 = xor v2, 4
    v4 = add v3, 5
    v5 = xor v4, 6
    v6 = add v5, 7
    v7 = xor v6, 8
    ret v7
}
