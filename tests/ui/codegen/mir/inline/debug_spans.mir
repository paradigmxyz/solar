//@ compile-flags: -Zmir-pipeline=inline
//@ filecheck:
@module InlineDebugSpans

// CHECK-LABEL: {{^[ +].*}}fn @caller{{[( ]}}
// CHECK: - {{.*}}icall @callee
// CHECK: + [[INLINED:v[0-9]+]] = add arg0, 1 !metadata(spans=[100..110, 130..140])
// CHECK: jump bb1 !metadata(spans=[110..120, 150..160])
// CHECK: + {{v[0-9]+}} = phi [bb2: [[INLINED]]]
fn @caller(arg0: u256) -> u256 {
  bb0:
    v0 = icall fn1, 1, arg0 !metadata(span=10..20)
    ret v0 !metadata(span=20..30)
}

fn @callee(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1 !metadata(spans=[100 .. 110, 130..140])
    ret v0 !metadata(spans=[110..120, 150..160])
}
