// === ROOT/tests/ui/codegen/mir/inline/guards/returning_guard.sol:ReturningGuard ===
@module ReturningGuard
fn @check(arg0: i256, arg1: i256) {
  bb0:
    v0 = eq arg0, arg1
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v1 = sload 0 !metadata(storage=slot(0))
    v2 = checked_add uint256, v1, 1
    sstore 0, v2 !metadata(storage=slot(0))
    mstore 0, arg0 !metadata(memory=scratch)
    mstore 32, arg1 !metadata(memory=scratch)
    log 0, 64, 0xb8ead7a4312aee6b04435df614582e3bfceaa60789e94048bd5ec0c5f0ddbecc
    ret
  bb1:
    ret
}

fn @run(arg0: i256) -> i256 [selector=0xa444f5e9, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v4]
    v3 = lt v2, 8
    jumpi v3, bb4, bb5
  bb5:
    jump bb2
  bb2:
    v5 = sload 0 !metadata(storage=slot(0))
    ret v5
  bb4:
    icall @check, v2, v0
    icall @check, v2, v2
    jump bb6
  bb6:
    jump bb3
  bb3:
    v4 = checked_add uint256, v2, 1
    jump bb1
}

fn @requireEqual(arg0: i256, arg1: i256) [pure] {
  bb0:
    v0 = eq arg0, arg1
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb3:
    icall revert_if<empty>, true
    invalid
  bb1:
    ret
}

fn @failing() [selector=0x1118b879, pure, abi_params=[], abi_returns=[], abi_return_params=[]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v2]
    v1 = lt v0, 8
    jumpi v1, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret
  bb4:
    icall @requireEqual, v0, 0
    jump bb6
  bb6:
    jump bb3
  bb3:
    v2 = checked_add uint256, v0, 1
    jump bb1
}
