- ; === ROOT/tests/ui/codegen/mir/inline/guards/returning_guard.mir (before inline) ===
+ ; === ROOT/tests/ui/codegen/mir/inline/guards/returning_guard.mir (after inline) ===
  @module ReturningGuard
  @phase lowered
  fn @check(arg0: i256, arg1: i256) {
    bb0:
      v0 = eq arg0, arg1
      jumpi v0, bb1, bb2
    bb2:                                            ; preds = bb0
      sstore 0, arg0
      ret
    bb1:                                            ; preds = bb0
      ret
  }
  
  fn @loop(arg0: i256) {
    bb0:
      jump bb1
-   bb1:                                            ; preds = bb0, bb2
-     v0 = phi [bb0: 0], [bb2: v2]
+   bb1:                                            ; preds = bb0, bb4
+     v0 = phi [bb0: 0], [bb4: v2]
      v1 = lt v0, 8
      jumpi v1, bb2, bb3
    bb3:                                            ; preds = bb1
      icall @check, 42, arg0
      ret
    bb2:                                            ; preds = bb1
+     v4 = eq v0, arg0
+     jumpi v4, bb6, bb7
+   bb7:                                            ; preds = bb2
      icall @check, v0, arg0
+     jump bb6
+   bb6:                                            ; preds = bb2, bb7
+     v3 = eq v0, v0
+     jumpi v3, bb4, bb5
+   bb5:                                            ; preds = bb6
      icall @check, v0, v0
+     jump bb4
+   bb4:                                            ; preds = bb6, bb5
      v2 = add v0, 1
      jump bb1
  }
  
  fn @reading(arg0: i256) {
    bb0:
      v0 = sload 0
      v1 = eq v0, arg0
      jumpi v1, bb1, bb2
    bb2:                                            ; preds = bb0
      sstore 0, arg0
      ret
    bb1:                                            ; preds = bb0
      ret
  }
  
  fn @keep_read(arg0: i256) {
    bb0:
      jump bb1
    bb1:                                            ; preds = bb0, bb1
      icall @reading, arg0
      v0 = ne arg0, 0
      jumpi v0, bb1, bb2
    bb2:                                            ; preds = bb1
      ret
  }
  
  fn @normalize(arg0: i1, arg1: i1) {
    bb0:
      v0 = eq arg0, false
      v1 = eq arg1, false
      v2 = eq v0, v1
      jumpi v2, bb1, bb2
    bb2:                                            ; preds = bb0
      sstore 1, 1
      ret
    bb1:                                            ; preds = bb0
      ret
  }
  
  fn @dirty(arg0: i1, arg1: i1) {
    bb0:
      jump bb1
-   bb1:                                            ; preds = bb0, bb1
+   bb1:                                            ; preds = bb0, bb3
+     v0 = eq arg0, false
+     v1 = eq arg1, false
+     v2 = eq v0, v1
+     jumpi v2, bb3, bb4
+   bb4:                                            ; preds = bb1
      icall @normalize, arg0, arg1
+     jump bb3
+   bb3:                                            ; preds = bb1, bb4
      jumpi arg0, bb1, bb2
-   bb2:                                            ; preds = bb1
+   bb2:                                            ; preds = bb3
      ret
  }
  
  fn @inverted(arg0: i256) {
    bb0:
      v0 = lt arg0, 8
      jumpi v0, bb1, bb2
    bb2:                                            ; preds = bb0
      ret
    bb1:                                            ; preds = bb0
      sstore 2, arg0
      ret
  }
  
  fn @false_edge(arg0: i256) {
    bb0:
      jump bb1
-   bb1:                                            ; preds = bb0, bb1
+   bb1:                                            ; preds = bb0, bb3
+     v1 = lt arg0, 8
+     jumpi v1, bb4, bb3
+   bb4:                                            ; preds = bb1
      icall @inverted, arg0
+     jump bb3
+   bb3:                                            ; preds = bb1, bb4
      v0 = ne arg0, 0
      jumpi v0, bb1, bb2
-   bb2:                                            ; preds = bb1
+   bb2:                                            ; preds = bb3
      ret
  }
  
  fn @opaque(arg0: i256) {
    bb0:
      v0 = eq arg0, 0 !metadata(effect=memory_read)
      jumpi v0, bb1, bb2
    bb2:                                            ; preds = bb0
      sstore 3, 1
      ret
    bb1:                                            ; preds = bb0
      ret
  }
  
  fn @keep_opaque(arg0: i256) {
    bb0:
      jump bb1
    bb1:                                            ; preds = bb0, bb1
      icall @opaque, arg0
      v0 = ne arg0, 0
      jumpi v0, bb1, bb2
    bb2:                                            ; preds = bb1
      ret
  }
  
  fn @outside(arg0: i256, arg1: i1, arg2: i1) {
    bb0:
      icall @reading, arg0
      icall @normalize, arg1, arg2
      icall @inverted, arg0
      icall @opaque, arg0
      ret
  }
  
