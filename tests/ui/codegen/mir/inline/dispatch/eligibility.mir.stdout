  bb0:
    v0 = extract_value slice<calldata>, arg0, 1
    v1 = extract_value slice<calldata>, arg0, 0
    v2 = mul v0, 32
    v3 = shr v0, 251
    v4 = ne v3, 0
    icall panic_if<0x41>, v4
    v5 = calldatasize
    v6 = ptrtoint ptr<calldata> v1 to i256
    v7 = sub v5, v6
    v8 = slt v7, v2
    icall revert_if<calldata_tail_too_short>, v8
    v9 = mul v0, 32
    v10 = shr v0, 251
    v11 = ne v10, 0
    icall panic_if<0x41>, v11
    v12 = add 32, v9
    v13 = lt v12, 32
    icall panic_if<0x41>, v13
    v14 = alloc v12
    mstore v14, v0
    v15 = make_calldata_slice v1, v9
    v16 = ptradd v14, 32
    v17 = extract_value slice<calldata>, v15, 0
    v18 = extract_value slice<calldata>, v15, 1
    calldatacopy v16, v17, v18
    ret v14
}

