; === ROOT/tests/ui/codegen/mir/inline/dispatch/eligibility.sol:WithDynamicInputs ===
@module WithDynamicInputs
; function a(uint256[] calldata x) external pure returns (uint256[] memory) [selector 0x1e3badd9]
fn @a(arg0: slice<calldata>) -> ptr<memory> [selector=0x1e3badd9, pure, abi_params=[array<_, uint256>], abi_returns=[memory_array<word>], abi_return_params=[array<_, uint256>]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 1
    v1 = extract_value slice<calldata>, arg0, 0
    v2 = mul v0, 32
    v3 = gt v0, 0x7ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    icall panic_if<0x41>, v3
    v4 = calldatasize
    v5 = ptrtoint ptr<calldata> v1 to i256
    v6 = sub v4, v5
    v7 = slt v6, v2
    icall revert_if<calldata_tail_too_short>, v7
    v8 = mul v0, 32
    v9 = gt v0, 0x7ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    icall panic_if<0x41>, v9
    v10 = add v8, 32
    v11 = lt v10, 32
    icall panic_if<0x41>, v11
    v12 = alloc v10
    mstore v12, v0
    v13 = make_calldata_slice v1, v8
    v14 = ptradd v12, 32
    v15 = extract_value slice<calldata>, v13, 0
    v16 = extract_value slice<calldata>, v13, 1
    calldatacopy v14, v15, v16
    ret v12
}

; function b(uint256 x) external pure returns (uint256) [selector 0xcd580ff3]
fn @b(arg0: i256) -> i256 [selector=0xcd580ff3, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = checked_mul uint256, arg0, 2
    ret v0
}

