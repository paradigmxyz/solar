//@ revisions: inline disabled
//@[inline] compile-flags: -Ogas -Zmir-pipeline=inline,cfg-simplify,dce
//@[disabled] compile-flags: -Onone -Zmir-pipeline=inline
//@[inline] filecheck:
@module ScalarDispatcher
@phase lowered

// CHECK-LABEL: {{^[ +].*}}fn @entry
// CHECK: switch
// CHECK: [[SUB_LEFT:v[0-9]+]] = calldataload 4
// CHECK-NEXT: [[SUB_RIGHT:v[0-9]+]] = calldataload 36
// CHECK-NEXT: sub [[SUB_LEFT]], [[SUB_RIGHT]]
// CHECK: [[ADD_LEFT:v[0-9]+]] = calldataload 4
// CHECK-NEXT: [[ADD_RIGHT:v[0-9]+]] = calldataload 36
// CHECK-NEXT: add [[ADD_LEFT]], [[ADD_RIGHT]]
// CHECK-NOT: tail_call
fn @add() [selector=0x00000001, pure, abi_wrapper] {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = add v1, v2
    mstore 128, v0
    returndata 128, 32
}
fn @sub() [selector=0x00000002, pure, abi_wrapper] {
  bb0:
    v1 = calldataload 4
    v2 = calldataload 36
    v0 = sub v1, v2
    mstore 128, v0
    returndata 128, 32
}
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb3, [1 => bb1, 2 => bb2]
  bb1:
    tail_call @add
  bb2:
    tail_call @sub
  bb3:
    revert 0, 0
}
