//@ compile-flags: -Zmir-pipeline=lower-frame-slots
//@ filecheck:
// A frame slot becomes a word access at a fixed address from the heap start in an external
// function and at an `internal_frame_addr` offset in an internal one. A function without frame
// slots keeps its body.
@module FrameSlotLowering
@phase semantic

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb4, [0x37a6096a => bb1, 0x645ee3c3 => bb2, 0x11546183 => bb3]
  bb1:
    tail_call @scratch
  bb2:
    tail_call @internal
  bb3:
    tail_call @plain
  bb4:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @scratch{{[( ]}}
// CHECK: - frame_store scratch, word, 0, {{v[0-9]+}}
// CHECK: - frame_store scratch, word, 32, 7
// CHECK: - {{v[0-9]+}} = frame_load scratch, word, 0
// CHECK: + mstore 128, {{v[0-9]+}}
// CHECK: + mstore 160, 7
// CHECK: + {{v[0-9]+}} = mload 128
fn @scratch() {
  bb0:
    v0 = calldataload 4
    frame_store scratch, word, 0, v0
    frame_store scratch, word, 32, 7
    v1 = frame_load scratch, word, 0
    v2 = frame_load scratch, word, 32
    v3 = add v1, v2
    mstore 0, v3
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @internal{{[( ]}}
// CHECK: icall @spill, {{v[0-9]+}}
fn @internal() {
  bb0:
    v0 = calldataload 4
    v1 = icall @spill, v0
    mstore 0, v1
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @spill{{[( ]}}
// CHECK: - frame_store internal_frame, word, 0, arg0
// CHECK: - {{v[0-9]+}} = frame_load internal_frame, word, 0
// CHECK: + [[ADDR:v[0-9]+]] = internal_frame_addr 128
// CHECK-NEXT: + mstore [[ADDR]], arg0
// CHECK: + {{v[0-9]+}} = internal_frame_addr 128
// CHECK-NEXT: + {{v[0-9]+}} = mload
fn @spill(arg0: i256) -> i256 {
  bb0:
    frame_store internal_frame, word, 0, arg0
    v0 = frame_load internal_frame, word, 0
    v1 = add v0, 12
    ret v1
}

// A slice slot holds a pointer and a length, stored and loaded as two words.
// CHECK-LABEL: {{^[ +].*}}fn @slice_slot{{[( ]}}
// CHECK: - frame_store internal_frame, calldata, 0, arg0
// CHECK: - {{v[0-9]+}} = frame_load internal_frame, calldata, 0
// CHECK: + {{v[0-9]+}} = extract_value slice<calldata>, arg0, 0
// CHECK: + {{v[0-9]+}} = extract_value slice<calldata>, arg0, 1
// CHECK: + {{v[0-9]+}} = make_calldata_slice
fn @slice_slot(arg0: slice<calldata>) -> slice<calldata> {
  bb0:
    frame_store internal_frame, calldata, 0, arg0
    v0 = frame_load internal_frame, calldata, 0
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @plain{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @plain() {
  bb0:
    v0 = calldataload 4
    v1 = add v0, 1
    mstore 0, v1
    returndata 0, 32
}
