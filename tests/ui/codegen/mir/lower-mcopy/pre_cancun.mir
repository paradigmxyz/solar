//@ revisions: homestead paris
//@[homestead] compile-flags: --evm-version homestead -Zmir-pipeline=lower-mcopy
//@[homestead] filecheck: --check-prefix=PRE
//@[paris] compile-flags: --evm-version paris -Zmir-pipeline=lower-mcopy
//@[paris] filecheck: --check-prefix=PRE
@module PreCancunMCopy

// `mcopy` lowers to overlap-safe word-copy loops plus a snapshotted byte tail,
// so exactly `len` bytes change without extra memory expansion. The identity
// precompile would be smaller, but a precompile call is observable by tooling
// that keys behavior on "the next call" (Foundry's `vm.prank` and
// `vm.expectRevert`), and a whole-word tail would clobber bytes past the copy.

// PRE-LABEL: {{^[ +].*}}fn @copy{{[( ]}}
// PRE: - mcopy arg0, arg1, arg2
// PRE: + [[FULL:v[0-9]+]] = and arg2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
// PRE: + [[BACKWARD:v[0-9]+]] = lt arg1, arg0
// PRE: + [[FORWARD_OFFSET:v[0-9]+]] = phi
// PRE: + [[FORWARD_BASE:v[0-9]+]] = select
// PRE: + [[FORWARD_WORD:v[0-9]+]] = mload [[FORWARD_BASE]]
// PRE: + {{v[0-9]+}} = shr [[FORWARD_WORD]], {{v[0-9]+}}
// PRE: + mstore8
// PRE: + [[FORWARD_SOURCE:v[0-9]+]] = add arg1, [[FORWARD_OFFSET]]
// PRE: + [[FORWARD_WORD:v[0-9]+]] = mload [[FORWARD_SOURCE]]
// PRE: + mstore {{v[0-9]+}}, [[FORWARD_WORD]]
// PRE: + [[FORWARD_NEXT:v[0-9]+]] = add [[FORWARD_OFFSET]], 32
// PRE: + {{v[0-9]+}} = lt [[FULL]], arg2
// PRE: + [[REVERSE_BASE:v[0-9]+]] = select
// PRE: + [[REVERSE_WORD:v[0-9]+]] = mload [[REVERSE_BASE]]
// PRE: + {{v[0-9]+}} = shr [[REVERSE_WORD]], {{v[0-9]+}}
// PRE: + [[REVERSE_OFFSET:v[0-9]+]] = phi [{{bb[0-9]+}}: [[FULL]]]
// PRE: + [[REVERSE_NEXT:v[0-9]+]] = sub [[REVERSE_OFFSET]], 32
// PRE: + [[REVERSE_SOURCE:v[0-9]+]] = add [[REVERSE_NEXT]], arg1
// PRE: + [[REVERSE_WORD:v[0-9]+]] = mload [[REVERSE_SOURCE]]
// PRE: + mstore {{v[0-9]+}}, [[REVERSE_WORD]]
// PRE: + mstore8
// PRE: {{^[ +].*}}ret arg0
fn @copy(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    mcopy arg0, arg1, arg2
    ret arg0
}

// A word array's byte length is a multiple of 32, so both directions copy
// whole words and skip the partial-tail loop.
// PRE-LABEL: {{^[ +].*}}fn @copy_words{{[( ]}}
// PRE: - mcopy arg0, arg1, v0
// PRE-NOT: {{^\+.*}} = xor
// PRE: {{^[ +].*}}ret arg0
fn @copy_words(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = shl arg2, 5
    mcopy arg0, arg1, v0
    ret arg0
}

// ABI encoding marks copies from its sources into its output `disjoint`, so
// they copy forward without a runtime direction check.
// PRE-LABEL: {{^[ +].*}}fn @copy_disjoint{{[( ]}}
// PRE: - mcopy arg0, arg1, arg2 !metadata(disjoint)
// PRE-NOT: {{^\+.*}} = lt arg1, arg0
// PRE-NOT: {{^\+.*}} = sub {{v[0-9]+}}, 32
// PRE: {{^[ +].*}}ret arg0
fn @copy_disjoint(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    mcopy arg0, arg1, arg2 !metadata(disjoint)
    ret arg0
}

// PRE-LABEL: {{^[ +].*}}fn @copy_byte{{[( ]}}
// PRE-NOT: {{^\+.*}} = lt arg1, arg0
// PRE-NOT: {{^\+.*}} = sub {{v[0-9]+}}, 32
// PRE: {{^[ +].*}}ret arg0
fn @copy_byte(arg0: i256, arg1: i256) -> i256 {
  bb0:
    mcopy arg0, arg1, 1
    ret arg0
}

// PRE-LABEL: {{^[ +].*}}fn @copy_partial{{[( ]}}
// PRE-NOT: {{^\+.*}} = lt arg1, arg0
// PRE-NOT: {{^\+.*}} = sub {{v[0-9]+}}, 32
// PRE: {{^[ +].*}}ret arg0
fn @copy_partial(arg0: i256, arg1: i256) -> i256 {
  bb0:
    mcopy arg0, arg1, 31
    ret arg0
}

// PRE-LABEL: {{^[ +].*}}fn @copy_word{{[( ]}}
// PRE-NOT: {{^\+.*}} = lt arg1, arg0
// PRE-NOT: {{^\+.*}} = sub {{v[0-9]+}}, 32
// PRE: {{^[ +].*}}ret arg0
fn @copy_word(arg0: i256, arg1: i256) -> i256 {
  bb0:
    mcopy arg0, arg1, 32
    ret arg0
}

// PRE-LABEL: {{^[ +].*}}fn @copy_word_and_byte{{[( ]}}
// PRE: + {{v[0-9]+}} = lt arg1, arg0
// PRE: + {{v[0-9]+}} = sub {{v[0-9]+}}, 32
// PRE: {{^[ +].*}}ret arg0
fn @copy_word_and_byte(arg0: i256, arg1: i256) -> i256 {
  bb0:
    mcopy arg0, arg1, 33
    ret arg0
}
