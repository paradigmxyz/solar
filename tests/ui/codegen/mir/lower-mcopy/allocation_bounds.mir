//@ compile-flags: --evm-version paris -Zmir-pipeline=lower-mcopy
//@ filecheck:
@module CopyAllocationBounds

// CHECK-LABEL: fn @cancelled_out_of_bounds
// CHECK: + {{v[0-9]+}} = lt v5, v3
fn @cancelled_out_of_bounds(arg0: i256) {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v0 to i256
    v2 = alloc raw, exact, uninitialized, infallible, 96
    v3 = ptrtoint memptr v2 to i256
    v4 = sub v1, arg0
    v5 = add arg0, v4
    mcopy v3, v5, 96
    ret
}

// CHECK-LABEL: fn @direct_out_of_bounds
// CHECK: + {{v[0-9]+}} = lt v1, v3
fn @direct_out_of_bounds() {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v0 to i256
    v2 = alloc raw, exact, uninitialized, infallible, 96
    v3 = ptrtoint memptr v2 to i256
    mcopy v3, v1, 96
    ret
}

// CHECK-LABEL: fn @dynamic_length
// CHECK: + {{v[0-9]+}} = lt v1, v3
fn @dynamic_length(arg0: i256) {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v0 to i256
    v2 = alloc raw, exact, uninitialized, infallible, 96
    v3 = ptrtoint memptr v2 to i256
    mcopy v3, v1, arg0
    ret
}

// CHECK-LABEL: fn @in_bounds
// CHECK-NOT: + {{v[0-9]+}} = lt v1, v3
// CHECK: {{^[ +].*}}ret
fn @in_bounds() {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 96
    v1 = ptrtoint memptr v0 to i256
    v2 = alloc raw, exact, uninitialized, infallible, 96
    v3 = ptrtoint memptr v2 to i256
    mcopy v3, v1, 96
    ret
}

// CHECK-LABEL: fn @same_base_reverse
// CHECK-NOT: + {{v[0-9]+}} = lt v1, v2
// CHECK: + {{v[0-9]+}} = sub {{v[0-9]+}}, 32
// CHECK: {{^[ +].*}}ret
fn @same_base_reverse() {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v0 to i256
    v2 = add v1, 32
    mcopy v2, v1, 96
    ret
}
