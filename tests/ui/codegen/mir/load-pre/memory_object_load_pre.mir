//@compile-flags: -Zmir-pipeline=load-pre
//@filecheck:
@module MemoryObjectLoadPre

// CHECK-LABEL: {{^[ +].*}}fn @forward_length_across_join{{[( ]}}
// CHECK:     bb3:
// CHECK-NEXT: -     {{v[0-9]+}} = load arg0
// CHECK: +     ret arg2
fn @forward_length_across_join(arg0: memptr, arg1: i1, arg2: i256) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = ptrtoint memptr arg0 to i256
    store v0, arg2
    jump bb3
  bb2:
    v1 = ptrtoint memptr arg0 to i256
    store v1, arg2
    jump bb3
  bb3:
    v3 = load arg0
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @allocation_fmp_update_keeps_length_load{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT: {{^ +}}[[LENGTH:v[0-9]+]] = load v0
// CHECK-NEXT: {{^ +}}ret [[LENGTH]]
fn @allocation_fmp_update_keeps_length_load(arg0: i1) -> i256 {
  bb0:
    v0 = alloc 64
    v5 = ptrtoint memptr v0 to i256
    store v5, 7
    v9001 = ptradd v0, 32
    v1 = ptrtoint memptr v9001 to i256
    store v1, 99
    v2 = load v0
    jumpi arg0, bb1, bb2
  bb1:
    v3 = alloc 32
    v6 = ptrtoint memptr v3 to i256
    store v6, 0
    jump bb2
  bb2:
    v4 = load v0
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_data_write_can_reset_fmp{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT: {{^ +}}[[LENGTH:v[0-9]+]] = load v0
// CHECK-NEXT: {{^ +}}ret [[LENGTH]]
fn @unknown_data_write_can_reset_fmp(arg0: i1, arg1: i256) -> i256 {
  bb0:
    v0 = alloc 64
    v7 = ptrtoint memptr v0 to i256
    store v7, 7
    v1 = inttoptr i256 arg1 to memptr
    v9001 = ptradd v1, 32
    v2 = ptrtoint memptr v9001 to i256
    v6 = ptrtoint memptr v0 to i256
    store v2, v6
    v3 = load v0
    jumpi arg0, bb1, bb2
  bb1:
    v4 = alloc 32
    v10 = ptrtoint memptr v4 to i256
    store v10, 0
    jump bb2
  bb2:
    v5 = load v0
    ret v5
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_local_length{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT: {{^ +}}[[LOCAL:v[0-9]+]] = load v0
// CHECK-NEXT: {{^ +}}ret [[LOCAL]]
fn @keep_local_length() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = load v0
    v3 = ne v1, 0
    jumpi v3, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v2 = load v0
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @reuse_live_length{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT: -     {{v[0-9]+}} = load v0
// CHECK: +     {{v[0-9]+}} = add [[LIVE:v[0-9]+]], [[LIVE]]
fn @reuse_live_length() -> i256 {
  bb0:
    v0 = alloc 32
    v1 = load v0
    v4 = ne v1, 0
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v2 = load v0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @forward_latest_store{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT: -     {{v[0-9]+}} = load v0
// CHECK: +     ret 9
fn @forward_latest_store() -> i256 {
  bb0:
    v0 = alloc 32
    v5 = ptrtoint memptr v0 to i256
    store v5, 7
    v1 = load v0
    store v5, 9
    v2 = load v0
    v4 = ne v2, 0
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v3 = load v0
    ret v3
}
