//@compile-flags: -Zmir-pipeline=load-pre
//@filecheck:
@module MemoryObjectLoadPre

// CHECK-LABEL: {{^[ +].*}}fn @forward_length_across_join{{[( ]}}
// CHECK: + ret arg2
fn @forward_length_across_join(arg0: memorybytes, arg1: i1, arg2: i256) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    set_memory_object_len memorybytes, arg0, arg2
    jump bb3
  bb2:
    set_memory_object_len memorybytes, arg0, arg2
    jump bb3
  bb3:
    v3 = memory_object_len memorybytes, arg0
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @allocation_fmp_update_keeps_length_load{{[( ]}}
// CHECK:     bb2:
// CHECK:       [[RETAINED:v[0-9]+]] = memory_object_len memorybytes, v0
// CHECK-NEXT:       ret [[RETAINED]]
fn @allocation_fmp_update_keeps_length_load(arg0: i1) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    set_memory_object_len memorybytes, v0, 7
    v7 = memory_object_data memorybytes, v0
    v1 = ptrtoint memptr v7 to i256
    mstore v1, 99
    v2 = memory_object_len memorybytes, v0
    jumpi arg0, bb1, bb2
  bb1:
    v3 = alloc memorybytes, exact, uninitialized, infallible, 32
    set_memory_object_len memorybytes, v3, 0
    jump bb2
  bb2:
    v4 = memory_object_len memorybytes, v0
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_data_write_can_reset_fmp{{[( ]}}
// CHECK:     bb2:
// CHECK:       [[LENGTH:v[0-9]+]] = memory_object_len memorybytes, v0
// CHECK-NEXT:       ret [[LENGTH]]
fn @unknown_data_write_can_reset_fmp(arg0: i1, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    set_memory_object_len memorybytes, v0, 7
    v1 = inttoptr i256 arg1 to memorybytes
    v8 = memory_object_data memorybytes, v1
    v2 = ptrtoint memptr v8 to i256
    v6 = ptrtoint memorybytes v0 to i256
    mstore v2, v6
    v3 = memory_object_len memorybytes, v0
    jumpi arg0, bb1, bb2
  bb1:
    v4 = alloc memorybytes, exact, uninitialized, infallible, 32
    set_memory_object_len memorybytes, v4, 0
    jump bb2
  bb2:
    v5 = memory_object_len memorybytes, v0
    ret v5
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_local_length{{[( ]}}
// CHECK:       bb2:
// CHECK-NEXT:       [[LOCAL:v[0-9]+]] = memory_object_len memorybytes,
// CHECK-NEXT:       ret [[LOCAL]]
fn @keep_local_length() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v1 = memory_object_len memorybytes, v0
    v3 = ne v1, 0
    jumpi v3, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v2 = memory_object_len memorybytes, v0
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @reuse_live_length{{[( ]}}
// CHECK: -     {{v[0-9]+}} = memory_object_len memorybytes,
// CHECK: +     {{v[0-9]+}} = add [[LIVE:v[0-9]+]], [[LIVE]]
fn @reuse_live_length() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v1 = memory_object_len memorybytes, v0
    v4 = ne v1, 0
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v2 = memory_object_len memorybytes, v0
    v3 = add v1, v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @forward_latest_store{{[( ]}}
// CHECK: -     {{v[0-9]+}} = memory_object_len memorybytes,
// CHECK: +     ret 9
fn @forward_latest_store() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    set_memory_object_len memorybytes, v0, 7
    v1 = memory_object_len memorybytes, v0
    set_memory_object_len memorybytes, v0, 9
    v2 = memory_object_len memorybytes, v0
    v4 = ne v2, 0
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v3 = memory_object_len memorybytes, v0
    ret v3
}
