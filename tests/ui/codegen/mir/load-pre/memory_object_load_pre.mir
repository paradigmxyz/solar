//@compile-flags: -Zmir-pipeline=load-pre
//@filecheck:
@module MemoryObjectLoadPre

// `load-pre` does not forward a length-word store to a `memory_slice` header
// read, so the read stays.
// CHECK-LABEL: {{^[ +].*}}fn @forward_length_across_join{{[( ]}}
// CHECK:     bb3:
// CHECK-NEXT:       [[VIEW:v[0-9]+]] = memory_slice arg0
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT:       ret [[LENGTH]]
fn @forward_length_across_join(arg0: memptr, arg1: i1, arg2: i256) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2
  bb1:
    v0 = ptrtoint memptr arg0 to i256
    mstore v0, arg2
    jump bb3
  bb2:
    v1 = ptrtoint memptr arg0 to i256
    mstore v1, arg2
    jump bb3
  bb3:
    v2 = memory_slice arg0
    v3 = slice_len v2
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @allocation_fmp_update_keeps_length_load{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT:       [[VIEW:v[0-9]+]] = memory_slice v0
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT:       ret [[LENGTH]]
fn @allocation_fmp_update_keeps_length_load(arg0: i1) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v5 = ptrtoint memptr v0 to i256
    mstore v5, 7
    v7 = memory_slice v0
    v1 = slice_ptr v7
    mstore v1, 99
    v8 = memory_slice v0
    v2 = slice_len v8
    jumpi arg0, bb1, bb2
  bb1:
    v3 = alloc memorybytes, exact, uninitialized, infallible, 32
    v6 = ptrtoint memptr v3 to i256
    mstore v6, 0
    jump bb2
  bb2:
    v9 = memory_slice v0
    v4 = slice_len v9
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @unknown_data_write_can_reset_fmp{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT:       [[VIEW:v[0-9]+]] = memory_slice v0
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT:       ret [[LENGTH]]
fn @unknown_data_write_can_reset_fmp(arg0: i1, arg1: i256) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v7 = ptrtoint memptr v0 to i256
    mstore v7, 7
    v1 = inttoptr i256 arg1 to memptr
    v8 = memory_slice v1
    v2 = slice_ptr v8
    v6 = ptrtoint memptr v0 to i256
    mstore v2, v6
    v9 = memory_slice v0
    v3 = slice_len v9
    jumpi arg0, bb1, bb2
  bb1:
    v4 = alloc memorybytes, exact, uninitialized, infallible, 32
    v10 = ptrtoint memptr v4 to i256
    mstore v10, 0
    jump bb2
  bb2:
    v11 = memory_slice v0
    v5 = slice_len v11
    ret v5
}

// CHECK-LABEL: {{^[ +].*}}fn @keep_local_length{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT:       [[VIEW:v[0-9]+]] = memory_slice v0
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT:       ret [[LENGTH]]
fn @keep_local_length() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v4 = memory_slice v0
    v1 = slice_len v4
    v3 = ne v1, 0
    jumpi v3, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v5 = memory_slice v0
    v2 = slice_len v5
    ret v2
}

// `load-pre` does not reuse an available `memory_slice` header read, so the
// second read stays.
// CHECK-LABEL: {{^[ +].*}}fn @reuse_live_length{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT:       [[VIEW:v[0-9]+]] = memory_slice v0
// CHECK-NEXT:       [[LATE:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT:       {{v[0-9]+}} = add {{v[0-9]+}}, [[LATE]]
fn @reuse_live_length() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v5 = memory_slice v0
    v1 = slice_len v5
    v4 = ne v1, 0
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v6 = memory_slice v0
    v2 = slice_len v6
    v3 = add v1, v2
    ret v3
}

// `load-pre` does not forward a length-word store to a `memory_slice` header
// read, so the read stays.
// CHECK-LABEL: {{^[ +].*}}fn @forward_latest_store{{[( ]}}
// CHECK:     bb2:
// CHECK-NEXT:       [[VIEW:v[0-9]+]] = memory_slice v0
// CHECK-NEXT:       [[LENGTH:v[0-9]+]] = slice_len [[VIEW]]
// CHECK-NEXT:       ret [[LENGTH]]
fn @forward_latest_store() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 32
    v5 = ptrtoint memptr v0 to i256
    mstore v5, 7
    v6 = memory_slice v0
    v1 = slice_len v6
    mstore v5, 9
    v7 = memory_slice v0
    v2 = slice_len v7
    v4 = ne v2, 0
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v8 = memory_slice v0
    v3 = slice_len v8
    ret v3
}
