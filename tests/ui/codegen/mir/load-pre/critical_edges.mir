//@ compile-flags: -Zmir-pipeline=load-pre
//@ filecheck:
@module CriticalLoadEdges

// CHECK-LABEL: fn @branch
// CHECK: + [[EDGE:bb[0-9]+]]:
// CHECK: + [[LOAD:v[0-9]+]] = sload 5
// CHECK: + {{v[0-9]+}} = phi [bb1: arg2], [[[EDGE]]: [[LOAD]]]
fn @branch(arg0: bool, arg1: bool, arg2: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    sstore 5, arg2
    jump bb3
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    v0 = phi [bb1: 3], [bb2: 7]
    v1 = sload 5
    v2 = add v0, v1
    ret v2
  bb4:
    ret 99
}

// CHECK-LABEL: fn @switch_edges
// CHECK: + [[LOAD:v[0-9]+]] = tload 5
// CHECK: + {{v[0-9]+}} = phi [bb1: arg2], [{{bb[0-9]+}}: [[LOAD]]]
fn @switch_edges(arg0: bool, arg1: u256, arg2: u256) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    tstore 5, arg2
    jump bb3
  bb2:
    switch arg1, default bb4, [1 => bb3, 2 => bb3]
  bb3:
    v1 = tload 5
    ret v1
  bb4:
    ret 99
}

// CHECK-LABEL: fn @gas_barrier
// CHECK-NOT: {{^[+-]}}
fn @gas_barrier(arg0: bool, arg1: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = sload 5
    jump bb3
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    v1 = gas
    v2 = sload 5
    v3 = add v1, v2
    ret v3
  bb4:
    ret 99
}

// CHECK-LABEL: fn @cheap_memory
// CHECK-NOT: {{^[+-]}}
fn @cheap_memory(arg0: bool, arg1: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = mload 128
    jump bb3
  bb2:
    jumpi arg1, bb3, bb4
  bb3:
    v1 = mload 128
    ret v1
  bb4:
    ret 99
}
