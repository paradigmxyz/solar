- // === ROOT/tests/ui/codegen/mir/inline-dispatch/scalar.mir (before inline-dispatch) ===
+ // === ROOT/tests/ui/codegen/mir/inline-dispatch/scalar.mir (after inline-dispatch) ===
  @module ScalarDispatcher
  @phase memory-lowered
  fn @add() [selector=0x00000001, pure] {
    bb0:
      v0 = add arg0, arg1
      mstore 128, v0
      returndata 128, 32
  }
  
  fn @sub() [selector=0x00000002, pure] {
    bb0:
      v0 = sub arg0, arg1
      mstore 128, v0
      returndata 128, 32
  }
  
  fn @entry() [entry] {
    bb0:
      v0 = calldataload 0
      v1 = shr 224, v0
      switch v1, default bb3, [1 => bb1, 2 => bb2]
    bb2:
      tail_call @sub
    bb1:
      tail_call @add
    bb3:
      revert 0, 0
  }
  
