// A struct decoded from calldata into memory, with a nested `bytes` object, is read only
// field by field. Forwarding leaves the struct, the nested object, and the pointers between
// them unread, and the `bytes` copy that the encoder reads is read from calldata instead.
// The encoding must stay exact.
struct Payload {
    uint256 key;
    uint8 kind;
    bytes ciphertext;
    uint128 amount;
}

contract DeadStructStaging {
    function encode(address who, uint256 salt, Payload calldata payload)
        external
        pure
        returns (bytes memory)
    {
        require(payload.ciphertext.length == 64);
        Payload memory staged = payload;
        return abi.encode(who, salt, staged.key, staged.kind, staged.ciphertext, staged.amount);
    }

    function digest(address who, uint256 salt, Payload calldata payload)
        external
        pure
        returns (bytes32)
    {
        require(payload.ciphertext.length == 64);
        Payload memory staged = payload;
        return keccak256(abi.encode(who, salt, staged.key, staged.kind, staged.ciphertext, staged.amount));
    }
}
