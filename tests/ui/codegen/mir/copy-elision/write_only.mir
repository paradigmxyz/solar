//@compile-flags: -Zmir-pipeline=copy-elision,dce
//@filecheck:
@module CopyElision

// An allocation filled by a copy but never read does not need the copy. The
// checked allocation remains because its failure and FMP bump are observable.
// CHECK-LABEL: after copy-elision
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 64
// CHECK: - calldatacopy {{v[0-9]+}}, 4, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 64
fn @unread(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, zeroed, panic, 64
    v1 = memory_object_data memorybytes, v0
    calldatacopy v1, 4, 32
    ret arg0
}

// A read of the allocation keeps every write.
// CHECK-LABEL: {{^[ +].*}}fn @read{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, uninitialized, infallible, 64
// CHECK: {{^[ +].*}}calldatacopy {{v[0-9]+}}, 4, 32
fn @read(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v1 = memory_object_data memorybytes, v0
    calldatacopy v1, 4, 32
    v2 = mload v1
    ret v2
}

// A read through a non-derived alias may observe the allocation.
// CHECK-LABEL: {{^[ +].*}}fn @absolute_alias{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @absolute_alias() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v1 = memory_object_data memorybytes, v0
    mstore v1, 7
    v2 = mload 128
    ret v2
}

// Storing a derived pointer byte lets later code reconstruct an alias.
// CHECK-LABEL: {{^[ +].*}}fn @mstore8_escape{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 9
fn @mstore8_escape() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v1 = memory_object_data memorybytes, v0
    mstore v1, 9
    mstore8 0, v1
    ret 0
}
