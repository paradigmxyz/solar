//@compile-flags: -Zmir-pipeline=copy-elision,dce
//@filecheck:
@module CopyElision

// An unused object can overlap reserved memory without an address proof.
// Keep its writes and the checked allocation's failure and FMP effects.
// CHECK-LABEL: after copy-elision
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 64
// CHECK: {{^[ +].*}}copy calldata {{v[0-9]+}}, 4, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 64
fn @unread(arg0: i256) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, zeroed, panic, 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint memptr v9001 to i256
    copy calldata v1, 4, 32
    ret arg0
}

// A read of the allocation keeps every write.
// CHECK-LABEL: {{^[ +].*}}fn @read{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, uninitialized, infallible, 64
// CHECK: {{^[ +].*}}copy calldata {{v[0-9]+}}, 4, 32
fn @read(arg0: i256) -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint memptr v9001 to i256
    copy calldata v1, 4, 32
    v2 = load v1
    ret v2
}

// A read through a non-derived alias may observe the allocation.
// CHECK-LABEL: {{^[ +].*}}fn @absolute_alias{{[( ]}}
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 7
fn @absolute_alias() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint memptr v9001 to i256
    store v1, 7
    v2 = load 128
    ret v2
}

// Storing a derived pointer byte lets later code reconstruct an alias.
// CHECK-LABEL: {{^[ +].*}}fn @mstore8_escape{{[( ]}}
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 9
fn @mstore8_escape() -> i256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v9001 = ptradd v0, 32
    v1 = ptrtoint memptr v9001 to i256
    store v1, 9
    store8 0, v1
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @zero_sized_write{{[( ]}}
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 7
fn @zero_sized_write() -> i256 {
  bb0:
    v8 = alloc raw, exact, uninitialized, infallible, 0
    v0 = ptrtoint memptr v8 to i256
    store v0, 7
    v9 = fmp
    v1 = ptrtoint memptr v9 to i256
    v2 = load v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @write_past_allocation{{[( ]}}
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 7
fn @write_past_allocation() -> i256 {
  bb0:
    v10 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v10 to i256
    v11 = alloc raw, exact, uninitialized, infallible, 32
    v1 = ptrtoint memptr v11 to i256
    v2 = add v0, 32
    store v2, 7
    v3 = load v1
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @guarded_loop{{[( ]}}
// CHECK: alloc memoryfixedarray<2, 1>
// CHECK: [[ELEM:v[0-9]+]] = ptradd
// CHECK-NEXT: store [[ELEM]], 7
fn @guarded_loop() -> i256 {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v1, 2
    jumpi v2, bb2, bb3
  bb2:
    v111 = shl 5, v1
    v9001 = ptradd v0, v111
    store v9001, 7
    v3 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @guarded_overrun{{[( ]}}
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 7
fn @guarded_overrun(arg0: i256) -> i256 {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v1 = lt arg0, 3
    jumpi v1, bb1, bb2
  bb1:
    v112 = shl 5, arg0
    v9001 = ptradd v0, v112
    store v9001, 7
    jump bb2
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @unguarded_join{{[( ]}}
// CHECK: {{^[ +].*}}store {{v[0-9]+}}, 7
fn @unguarded_join(arg0: i256) -> i256 {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v1 = lt arg0, 2
    jumpi v1, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v113 = shl 5, arg0
    v9001 = ptradd v0, v113
    store v9001, 7
    ret 0
}
