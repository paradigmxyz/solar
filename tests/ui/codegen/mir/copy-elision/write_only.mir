//@compile-flags: -Zmir-pipeline=copy-elision,dce
//@filecheck:
@module CopyElision

// An allocation filled by a copy but never read does not need the copy. The
// checked allocation remains because its failure and FMP bump are observable.
// CHECK-LABEL: after copy-elision
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 64
// CHECK: - calldatacopy {{v[0-9]+}}, 4, 32
// CHECK-LABEL: after dce
// CHECK: {{^[ +].*}}fn @unread{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, zeroed, panic, 64
fn @unread(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, zeroed, panic, 64
    v1 = memory_object_data memorybytes, v0
    calldatacopy v1, 4, 32
    ret arg0
}

// A read of the allocation keeps every write.
// CHECK-LABEL: {{^[ +].*}}fn @read{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = alloc memorybytes, exact, uninitialized, infallible, 64
// CHECK: {{^[ +].*}}calldatacopy {{v[0-9]+}}, 4, 32
fn @read(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v1 = memory_object_data memorybytes, v0
    calldatacopy v1, 4, 32
    v2 = mload v1
    ret v2
}

// A read through a non-derived alias may observe the allocation.
// CHECK-LABEL: {{^[ +].*}}fn @absolute_alias{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @absolute_alias() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v1 = memory_object_data memorybytes, v0
    mstore v1, 7
    v2 = mload 128
    ret v2
}

// Storing a derived pointer byte lets later code reconstruct an alias.
// CHECK-LABEL: {{^[ +].*}}fn @mstore8_escape{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 9
fn @mstore8_escape() -> u256 {
  bb0:
    v0 = alloc memorybytes, exact, uninitialized, infallible, 64
    v1 = memory_object_data memorybytes, v0
    mstore v1, 9
    mstore8 0, v1
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @zero_sized_write{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @zero_sized_write() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 0
    mstore v0, 7
    v1 = fmp
    v2 = mload v1
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @write_past_allocation{{[( ]}}
// CHECK: {{^[ +].*}}mstore {{v[0-9]+}}, 7
fn @write_past_allocation() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    v1 = alloc raw, exact, uninitialized, infallible, 32
    v2 = add v0, 32
    mstore v2, 7
    v3 = mload v1
    ret v3
}

// CHECK-LABEL: {{^[ +].*}}fn @guarded_loop{{[( ]}}
// CHECK: alloc memoryfixedarray<2, 1>
// CHECK-NOT: memory_object_store_element
fn @guarded_loop() -> u256 {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v3]
    v2 = lt v1, 2
    jumpi v2, bb2, bb3
  bb2:
    memory_object_store_element memoryfixedarray<2, 1>, v0, v1, 7
    v3 = add v1, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @guarded_overrun{{[( ]}}
// CHECK: {{^[ +].*}}memory_object_store_element
fn @guarded_overrun(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v1 = lt arg0, 3
    jumpi v1, bb1, bb2
  bb1:
    memory_object_store_element memoryfixedarray<2, 1>, v0, arg0, 7
    jump bb2
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @unguarded_join{{[( ]}}
// CHECK: {{^[ +].*}}memory_object_store_element
fn @unguarded_join(arg0: u256) -> u256 {
  bb0:
    v0 = alloc memoryfixedarray<2, 1>, exact, uninitialized, infallible, 64
    v1 = lt arg0, 2
    jumpi v1, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    memory_object_store_element memoryfixedarray<2, 1>, v0, arg0, 7
    ret 0
}
