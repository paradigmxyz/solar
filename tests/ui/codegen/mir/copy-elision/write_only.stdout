  }
  
  fn @read(arg0: i256) -> i256 {
    bb0:
      v0 = alloc 64
      v1 = ptradd v0, 32
      v2 = ptrtoint ptr<memory> v1 to i256
      copy calldata v2, 4, 32
      v3 = load v2
      ret v3
  }
  
  fn @absolute_alias() -> i256 {
    bb0:
      v0 = alloc 64
      v1 = ptradd v0, 32
      v2 = ptrtoint ptr<memory> v1 to i256
      store v2, 7
      v3 = load 128
      ret v3
  }
  
  fn @mstore8_escape() -> i256 {
    bb0:
      v0 = alloc 64
      v1 = ptradd v0, 32
      v2 = ptrtoint ptr<memory> v1 to i256
      store v2, 9
      store8 0, v2
      ret 0
  }
  
  fn @zero_sized_write() -> i256 {
    bb0:
      v0 = alloc 0
      v1 = ptrtoint ptr<memory> v0 to i256
      store v1, 7
      v2 = fmp
      v3 = ptrtoint ptr<memory> v2 to i256
      v4 = load v3
      ret v4
  }
  
  fn @write_past_allocation() -> i256 {
    bb0:
      v0 = alloc 32
      v1 = ptrtoint ptr<memory> v0 to i256
      v2 = alloc 32
      v3 = ptrtoint ptr<memory> v2 to i256
      v4 = add v1, 32
      store v4, 7
      v5 = load v3
      ret v5
  }
  
  fn @guarded_loop() -> i256 {
    bb0:
      v0 = alloc 64
      jump bb1
    bb1:
      v1 = phi [bb0: 0], [bb2: v5]
      v2 = lt v1, 2
      jumpi v2, bb2, bb3
    bb3:
      ret 0
    bb2:
      v3 = shl 5, v1
      v4 = ptradd v0, v3
      store v4, 7
      v5 = add v1, 1
      jump bb1
  }
  
  fn @guarded_overrun(arg0: i256) -> i256 {
    bb0:
      v0 = alloc 64
      v1 = lt arg0, 3
      jumpi v1, bb1, bb2
    bb1:
      v2 = shl 5, arg0
      v3 = ptradd v0, v2
      store v3, 7
      jump bb2
    bb2:
      ret 0
  }
  
  fn @unguarded_join(arg0: i256) -> i256 {
    bb0:
      v0 = alloc 64
      v1 = lt arg0, 2
      jumpi v1, bb1, bb2
    bb2:
      jump bb3
    bb1:
      jump bb3
    bb3:
      v2 = shl 5, arg0
      v3 = ptradd v0, v2
      store v3, 7
      ret 0
  }
  
