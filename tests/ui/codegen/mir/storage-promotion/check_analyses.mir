//@ revisions: off on
//@[off] compile-flags: -Zmir-pipeline=storage-promotion
//@[off] filecheck: --check-prefixes=CHECK,OFF --enable-var-scope
//@[on] compile-flags: -Zmir-pipeline=storage-promotion -Zcheck-analyses=true
//@[on] filecheck: --check-prefixes=CHECK,ON --enable-var-scope
@module StoragePromotionCheckAnalyses

// With `-Zcheck-analyses`, promotion records what it relied on: each promoted slot holds the
// same word in storage at the end of every block the loop can exit from as at the end of the
// preheader;
// each access it rewrote addresses the promoted slot; each other storage read it checked
// addresses another word; and the promoted slots differ. Without the flag it adds nothing.

// CHECK-LABEL: fn @recomputed_slot(
// CHECK:       [[SLOT:v[0-9]+]] = add arg0, 1
// ON:      +   [[BEFORE:v[0-9]+]] = sload [[SLOT]]
// CHECK:       bb1:
// ON:      +   [[AFTER:v[0-9]+]] = sload [[SLOT]]
// ON-NEXT: +   assume eq storage_promotion, [[BEFORE]], [[AFTER]]
// CHECK:       bb3:
// CHECK:   +   sstore [[SLOT]],
// CHECK:       bb2:
// CHECK-NEXT:  [[READ:v[0-9]+]] = add arg0, 1
// CHECK:       [[WRITE:v[0-9]+]] = add arg0, 1
// ON:      +   assume eq storage_promotion, [[READ]], [[SLOT]]
// ON-NEXT: +   assume eq storage_promotion, [[WRITE]], [[SLOT]]
// OFF-NOT:     assume
fn @recomputed_slot(arg0: i256) [selector=0x01020304] {
  bb0:
    v1 = add arg0, 1
    sstore v1, 1
    jump bb1
  bb1:
    v10 = phi [bb0: 0], [bb2: v9]
    v11 = lt v10, 4
    jumpi v11, bb2, bb3
  bb2:
    v2 = add arg0, 1
    v3 = sload v2
    v4 = mul v3, 2
    v5 = add arg0, 1
    sstore v5, v4
    v9 = add v10, 1
    jump bb1
  bb3:
    stop
}

// CHECK-LABEL: fn @other_slot(
// CHECK:       [[SLOT:v[0-9]+]] = add arg0, 1
// CHECK:       [[OTHER:v[0-9]+]] = add arg0, 2
// CHECK-NEXT:  sload [[OTHER]]
// ON:      +   assume ne storage_promotion, [[OTHER]], [[SLOT]]
// OFF-NOT:     assume
fn @other_slot(arg0: i256) [selector=0x01020305] {
  bb0:
    v0 = add arg0, 1
    sstore v0, 0
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload v0
    v7 = add arg0, 2
    v6 = sload v7
    v4 = add v3, v6
    sstore v0, v4
    v5 = add v1, 1
    jump bb1
  bb3:
    stop
}

// Constant slots are decided without an analysis, so only the exit records remain.
// CHECK-LABEL: fn @two_slots(
// ON:      +   [[ONE:v[0-9]+]] = sload 1
// ON-NEXT: +   [[TWO:v[0-9]+]] = sload 2
// ON:      +   assume eq storage_promotion, [[ONE]], {{v[0-9]+}}
// ON:      +   assume eq storage_promotion, [[TWO]], {{v[0-9]+}}
// CHECK-NOT:   assume
fn @two_slots(arg0: i256) [selector=0x01020306] {
  bb0:
    sstore 1, 0
    sstore 2, 0
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, arg0
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload 1
    v4 = add v3, v1
    sstore 1, v4
    sstore 2, v3
    v5 = add v1, 1
    jump bb1
  bb3:
    stop
}

// A lone slot the preheader does not store is flushed only when the loop stored it; the slot is
// read inside the loop, ahead of the dirty test, so the record holds whether or not the flush
// runs.
// CHECK-LABEL: fn @lone_slot(
// ON:      +   {{v[0-9]+}} = sload arg0
// ON:      +   [[BEFORE:v[0-9]+]] = sload arg0
// CHECK:       bb1:
// ON:      +   [[AFTER:v[0-9]+]] = sload arg0
// ON-NEXT: +   assume eq storage_promotion, [[BEFORE]], [[AFTER]]
// CHECK:   +   jumpi
// OFF-NOT:     assume
fn @lone_slot(arg0: i256) [selector=0x01020307] {
  bb0:
    jump bb1
  bb1:
    v1 = phi [bb0: 0], [bb2: v5]
    v2 = lt v1, 4
    jumpi v2, bb2, bb3
  bb2:
    v3 = sload arg0
    v4 = add v3, 1
    sstore arg0, v4
    v5 = add v1, 1
    jump bb1
  bb3:
    stop
}
