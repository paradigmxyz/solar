      jumpi arg0, bb2, bb3
    bb3:
      jump bb4
    bb4:
      v1 = icall @observe_memory_size
      v2 = sub v1, v0
      ret v2
    bb2:
      sstore 0, 2
      jump bb1
  }
  
  fn @observe_memory_size() -> i256 {
    bb0:
