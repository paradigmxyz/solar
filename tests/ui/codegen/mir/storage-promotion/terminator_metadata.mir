//@ compile-flags: -Zmir-pipeline=storage-promotion
//@ filecheck:
@module DirtyTerminatorMetadata

// The dirty check is generated code, not the later source-level return.
// CHECK-LABEL: {{^[ +].*}}fn @dirty{{[( ]}}
// CHECK: + [[DIRTY:v[0-9]+]] = mload {{[0-9]+}}{{$}}
// CHECK-NEXT: + jumpi [[DIRTY]], bb{{[0-9]+}}, bb{{[0-9]+}}{{$}}
// CHECK: ret arg0 !metadata(span=100..120, modifier_depth=2)
fn @dirty(arg0: u256) -> u256 [selector=0x01020304] {
  bb0:
    jump bb1
  bb1:
    jumpi true, bb2, bb4
  bb2:
    sstore 0, 7
    jump bb3
  bb3:
    jump bb1
  bb4:
    ret arg0 !metadata(span=100..120, modifier_depth=2)
}
