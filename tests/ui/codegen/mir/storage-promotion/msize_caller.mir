//@compile-flags: -Zmir-pipeline=storage-promotion
//@filecheck: --enable-var-scope
@module StoragePromotionMsize

// Before `lower-abi`, an external function can still have internal callers,
// and internal calls share memory, so `msize` in a caller observes the
// expansion of the promoted value's memory temporary.
// CHECK-LABEL: @called_externally
// CHECK-NOT: mstore
// CHECK: ret
fn @called_externally(arg0: i256) [selector=0x01020306] {
  bb0:
    sstore 0, 1
    jump bb1
  bb1:
    v0 = lt arg0, 3
    jumpi v0, bb2, bb3
  bb2:
    v1 = sload 0
    v2 = mul v1, 2
    sstore 0, v2
    jump bb1
  bb3:
    ret
}

fn @caller(arg0: i256) -> i256 [selector=0x01020307] {
  bb0:
    icall @called_externally, arg0
    v0 = msize
    ret v0
}

// CHECK-LABEL: @reject_memory_size_observers
// CHECK-NOT: mstore
// CHECK: sstore
// CHECK-NOT: mstore
// CHECK: ret
fn @reject_memory_size_observers(arg0: i1) -> i256 [selector=0x01020304] {
  bb0:
    v0 = msize
    sstore 0, 1
    jump bb1
  bb1:
    jumpi arg0, bb2, bb3
  bb2:
    sstore 0, 2
    jump bb1
  bb3:
    v1 = msize
    v2 = sub v1, v0
    ret v2
}

// CHECK-LABEL: @reject_callee_memory_size_observers
// CHECK-NOT: mstore
// CHECK: sstore
// CHECK-NOT: mstore
// CHECK: ret
fn @reject_callee_memory_size_observers(arg0: i1) -> i256 [selector=0x01020304] {
  bb0:
    v0 = icall @observe_memory_size
    sstore 0, 1
    jump bb1
  bb1:
    jumpi arg0, bb2, bb3
  bb2:
    sstore 0, 2
    jump bb1
  bb3:
    jump bb4
  bb4:
    v1 = icall @observe_memory_size
    v2 = sub v1, v0
    ret v2
}

fn @observe_memory_size() -> i256 {
  bb0:
    v0 = msize
    ret v0
}
