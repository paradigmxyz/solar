//@compile-flags: -Zmir-pipeline=dce
//@filecheck:
// A loop that only counts to its exit is skipped when its counter steps by one toward the test:
// up under `lt`, or either way under `ne`. Loops that write memory, step by another amount, step
// away from the bound, or whose counter is read after the exit stay.
@module DceDeadLoop
// CHECK-LABEL: {{^[ +].*}}fn @lt_up{{[( ]}}
// CHECK: - {{v[0-9]+}} = phi
// CHECK: - {{v[0-9]+}} = lt
// CHECK: {{^[ +].*}}ret arg0
fn @lt_up(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    ret arg0
}

// CHECK-LABEL: fn @ne_up_to_zero{{[( ]}}
// CHECK: - {{v[0-9]+}} = phi
// CHECK: - {{v[0-9]+}} = ne
// CHECK: {{^[ +].*}}ret arg0
fn @ne_up_to_zero(arg0: i256) -> i256 {
  bb0:
    v0 = sub 0, arg0
    jump bb1
  bb1:
    v1 = phi [bb0: v0], [bb2: v3]
    v2 = ne v1, 0
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v1, 1
    jump bb1
  bb3:
    ret arg0
}

// The loop and the load only it read go together, and the exit phi takes the preheader's value.
// CHECK-LABEL: fn @ne_down_with_phi{{[( ]}}
// CHECK: - {{v[0-9]+}} = phi [bb1: arg0], [bb3: {{v[0-9]+}}]
// CHECK: {{^[ +].*}}[[OUT:v[0-9]+]] = phi [bb0: 0], [bb1: arg0]
// CHECK: {{^[ +].*}}ret [[OUT]]
// CHECK: - {{v[0-9]+}} = calldataload
fn @ne_down_with_phi(arg0: i256) -> i256 {
  bb0:
    v5 = ne arg0, 0
    jumpi v5, bb4, bb3
  bb4:
    jump bb1
  bb1:
    v0 = phi [bb4: arg0], [bb2: v3]
    v1 = ne arg0, v0
    jumpi v1, bb2, bb3
  bb2:
    v2 = calldataload v0
    v3 = sub v0, 1
    jump bb1
  bb3:
    v4 = phi [bb0: 0], [bb1: arg0]
    ret v4
}

// An inner loop that does nothing leaves the outer loop with an empty body, so both go.
// CHECK-LABEL: fn @nested{{[( ]}}
// CHECK-NOT: {{^[ +].*}}phi
// CHECK: {{^[ +].*}}ret 0
fn @nested(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v5]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb6
  bb2:
    jump bb3
  bb3:
    v2 = phi [bb2: 0], [bb4: v4]
    v3 = lt v2, arg1
    jumpi v3, bb4, bb5
  bb4:
    v4 = add v2, 1
    jump bb3
  bb5:
    v5 = add v0, 1
    jump bb1
  bb6:
    ret 0
}

// CHECK-LABEL: fn @stores{{[( ]}}
// CHECK: {{^[ +].*}}phi
// CHECK: {{^[ +].*}}mstore
fn @stores(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    mstore 0, v0
    v2 = add v0, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: fn @step_two{{[( ]}}
// CHECK: {{^[ +].*}}phi
// CHECK: {{^[ +].*}}add {{v[0-9]+}}, 2
fn @step_two(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 2
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: fn @lt_down{{[( ]}}
// CHECK: {{^[ +].*}}phi
// CHECK: {{^[ +].*}}sub {{v[0-9]+}}, 1
fn @lt_down(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 5], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = sub v0, 1
    jump bb1
  bb3:
    ret 0
}

// CHECK-LABEL: fn @counter_escapes{{[( ]}}
// CHECK: {{^[ +].*}}phi
// CHECK: {{^[ +].*}}ret
fn @counter_escapes(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v2]
    v1 = lt v0, arg0
    jumpi v1, bb2, bb3
  bb2:
    v2 = add v0, 1
    jump bb1
  bb3:
    ret v0
}

// The bound changes in the loop, so the counter need not reach it.
// CHECK-LABEL: fn @moving_bound{{[( ]}}
// CHECK: {{^[ +].*}}phi
// CHECK: {{^[ +].*}}phi
fn @moving_bound(arg0: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: v3]
    v1 = phi [bb0: arg0], [bb2: v4]
    v2 = lt v0, v1
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v0, 1
    v4 = add v1, 1
    jump bb1
  bb3:
    ret 0
}
