; === ROOT/tests/ui/codegen/mir/dce/dead_loop_out_of_gas.sol:DeadLoopOutOfGas ===
@module DeadLoopOutOfGas
; function spin(uint256 n) external pure returns (uint256) [selector 0xa5b6ea8f]
fn @spin(arg0: i256) -> i256 [selector=0xa5b6ea8f, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v4]
    v3 = lt v2, v0
    jumpi v3, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret 1
  bb4:                                            ; preds = bb1
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v4 = add v2, 1
    jump bb1
}
