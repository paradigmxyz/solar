//@ revisions: report check
//@ compile-flags: -Zmir-pipeline=dce
//@[report] compile-flags: -Zdebugify=report
//@[check] compile-flags: -Zdebugify=check
//~[check]? ERROR: debugify: MIR pass `dce` lost 1 source origins
// Deleting a dead operation legitimately loses its last origin. Report it, and let focused
// preservation tests opt into rejecting that loss instead of retaining executable code.
@module Debugify
fn @test(arg0: i256) -> i256 {
  bb0:
    v0 = add arg0, 1 !metadata(span=10..20)
    ret arg0 !metadata(span=30..40)
}
