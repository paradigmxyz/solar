//@compile-flags: -Zmir-pipeline=dce
//@filecheck:
// Side-effect instructions must survive DCE even if their results are unused.
// sstore, log0, call all have side effects.
@module DceSideEffects
// CHECK-LABEL: {{^[ +].*}}fn @effects{{[( ]}}
// CHECK: {{^[ +].*}}sstore arg0, arg1
// CHECK: {{^[ +].*}}log0 0, 32
// CHECK: - {{v[0-9]+}} = add arg0, arg1
// CHECK: {{^[ +].*}}stop
fn @effects(arg0: u256, arg1: u256) {
  bb0:
    sstore arg0, arg1
    log0 0, 32
    v1 = add arg0, arg1
    stop
}

// CHECK-LABEL: fn @calls
// CHECK: - icall @empty
// CHECK: - {{v[0-9]+}} = icall @identity, arg0
// CHECK: icall @stops
// CHECK: icall @fails
// CHECK: icall @logs
// CHECK: icall @recursive
// CHECK: icall @looping
fn @calls(arg0: u256) {
  bb0:
    icall @empty
    v0 = icall @identity, arg0
    icall @stops
    icall @fails
    icall @logs
    icall @recursive
    icall @looping
    ret
}

fn @empty() {
  bb0:
    ret
}

fn @identity(arg0: u256) -> u256 {
  bb0:
    ret arg0
}

fn @fails() {
  bb0:
    revert 0, 0
}

fn @logs() {
  bb0:
    log0 0, 0
    ret
}

fn @recursive() {
  bb0:
    icall @recursive
    ret
}

fn @looping() {
  bb0:
    jump bb1
  bb1:
    jump bb1
}

// CHECK-LABEL: fn @memory_observer
// CHECK: {{^[ +].*}}icall @reads_memory
fn @memory_observer() -> u256 {
  bb0:
    icall @reads_memory
    v0 = msize
    ret v0
}

fn @reads_memory() -> u256 {
  bb0:
    v0 = mload 4096
    ret v0
}

// CHECK-LABEL: fn @callee_observes_memory
// CHECK: {{^[ +].*}}mload 0x1000
// CHECK: {{^[ +].*}}icall @observe_memory
fn @callee_observes_memory(arg0: bool) -> u256 {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    v0 = mload 4096
    jump bb2
  bb2:
    v1 = icall @observe_memory
    ret v1
}

fn @observe_memory() -> u256 {
  bb0:
    v0 = msize
    ret v0
}

// CHECK-LABEL: fn @abi_dependency
// CHECK: {{^[ +].*}}[[FIELD:v[0-9]+]] = memory_object_load_field memorystruct<1>, arg0, 0
// CHECK: {{^[ +].*}}validate_abi [[FIELD]]
fn @abi_dependency(arg0: memorystruct) {
  bb0:
    v0 = memory_object_load_field memorystruct<1>, arg0, 0
    validate_abi v0
    ret
}

fn @stops() {
  bb0:
    stop
}

// CHECK-LABEL: fn @unused_storage_reads
// CHECK: {{^[ +].*}}validate_storage_bytes {{v[0-9]+}}
// CHECK: {{^[ +].*}}load_storage_bytes arg0
fn @unused_storage_reads(arg0: u256) {
  bb0:
    v0 = sload arg0
    validate_storage_bytes v0
    v1 = load_storage_bytes arg0
    ret
}

// CHECK-LABEL: fn @storage_clear
// CHECK: {{^[ +].*}}clear_storage_words arg0, 1, arg1
fn @storage_clear(arg0: u256, arg1: u256) {
  bb0:
    clear_storage_words arg0, 1, arg1
    ret
}
