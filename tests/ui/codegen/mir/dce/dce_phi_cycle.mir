//@compile-flags: -Zmir-pipeline=dce
//@filecheck:
// Loop phis that only feed each other, and the add that only feeds them, are dead even though
// every one of them has a use. The live counter phi and its compare stay.
@module DcePhiCycle
// CHECK-LABEL: {{^[ +].*}}fn @swap_unused{{[( ]}}
// CHECK: - {{v[0-9]+}} = phi [bb0: arg0], [bb2: {{v[0-9]+}}]
// CHECK: - {{v[0-9]+}} = phi [bb0: arg1], [bb2: {{v[0-9]+}}]
// CHECK: {{^[ +].*}}[[COUNT:v[0-9]+]] = phi [bb0: 0], [bb2: {{v[0-9]+}}]
// CHECK: {{^[ +].*}}ret [[COUNT]]
// CHECK: - {{v[0-9]+}} = add arg0, arg1
fn @swap_unused(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb2: v1]
    v1 = phi [bb0: arg1], [bb2: v0]
    v2 = phi [bb0: 0], [bb2: v3]
    v4 = lt v2, 10
    jumpi v4, bb2, bb3
  bb2:
    v5 = add arg0, arg1
    v3 = add v2, 1
    jump bb1
  bb3:
    ret v2
}
