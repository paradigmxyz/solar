//@ compile-flags: -Zmir-pipeline=evm-inst-schedule
//@ filecheck:
@module EvmInstSchedule

// CHECK-LABEL: {{^[ +].*}}fn @binary_push_order{{[( ]}}
// CHECK: - [[ADD:v[0-9]+]] = add arg0, arg1
// CHECK-NEXT: [[MUL:v[0-9]+]] = mul arg2, arg3
// CHECK-NEXT: + [[ADD]] = add arg0, arg1
// CHECK-NEXT: {{v[0-9]+}} = sub [[ADD]], [[MUL]]
fn @binary_push_order(arg0: u256, arg1: u256, arg2: u256, arg3: u256) -> u256 {
  bb0:
    v4 = add arg0, arg1
    v5 = mul arg2, arg3
    v6 = sub v4, v5
    ret v6
}

// CHECK-LABEL: {{^[ +].*}}fn @read_order{{[( ]}}
// CHECK: - [[CALLDATA:v[0-9]+]] = calldataload arg0
// CHECK-NEXT: [[STORAGE:v[0-9]+]] = sload arg1
// CHECK-NEXT: + [[CALLDATA]] = calldataload arg0
// CHECK-NEXT: {{v[0-9]+}} = sub [[CALLDATA]], [[STORAGE]]
fn @read_order(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v2 = calldataload arg0
    v3 = sload arg1
    v4 = sub v2, v3
    ret v4
}

// CHECK-LABEL: {{^[ +].*}}fn @commutative_tree_order{{[( ]}}
// CHECK-NOT: {{^[+-]}}
// CHECK: [[ALIGNED:v[0-9]+]] = and {{v[0-9]+}},
// CHECK: [[ADDRESS:v[0-9]+]] = add {{v[0-9]+}}, {{v[0-9]+}}
// CHECK-NEXT: mstore [[ADDRESS]], 0
fn @commutative_tree_order(arg0: u256, arg1: u256) {
  bb0:
    v2 = add arg0, 31
    v3 = and v2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v4 = add arg1, 64
    v5 = sub v3, 32
    v6 = add v4, v5
    mstore v6, 0
    stop
}

// CHECK-LABEL: {{^[ +].*}}fn @shared_value_order{{[( ]}}
// CHECK-NOT: {{^[+-]}}
// CHECK: [[SHARED:v[0-9]+]] = and {{v[0-9]+}},
// CHECK: mstore {{v[0-9]+}}, 0
// CHECK-NEXT: {{v[0-9]+}} = add [[SHARED]], 64
fn @shared_value_order(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v2 = add arg0, 31
    v3 = and v2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v4 = add arg1, 64
    v5 = sub v3, 32
    v6 = add v4, v5
    mstore v6, 0
    v7 = add v3, 64
    ret v7
}

// CHECK-LABEL: {{^[ +].*}}fn @effect_barriers{{[( ]}}
// CHECK-NOT: {{^[+-]}}
// CHECK: [[BEFORE:v[0-9]+]] = add arg0, 1
// CHECK-NEXT: mstore 0, [[BEFORE]]
// CHECK-NEXT: [[AFTER:v[0-9]+]] = mul arg1, 2
// CHECK-NEXT: [[GAS:v[0-9]+]] = gas
// CHECK-NEXT: {{v[0-9]+}} = sub [[AFTER]], [[GAS]]
fn @effect_barriers(arg0: u256, arg1: u256) -> u256 {
  bb0:
    v2 = add arg0, 1
    mstore 0, v2
    v3 = mul arg1, 2
    v4 = gas
    v5 = sub v3, v4
    ret v5
}
