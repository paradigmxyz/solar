//@ compile-flags: -Zmir-pipeline=evm-inst-schedule
//@ filecheck:
@module SinkPastWrites

// A pure word read only after a memory write moves past the write to its reader:
// its operand is live there anyway, so the word no longer rides the stack across
// the write.
// CHECK-LABEL: {{^[ +].*}}fn @past_write{{[( ]}}
// CHECK: - [[STEP:v[0-9]+]] = add [[BASE:v[0-9]+]], 2
// CHECK-NEXT: mstore 0, [[BASE]]
// CHECK-NEXT: + [[STEP]] = add [[BASE]], 2
// CHECK-NEXT: mstore [[STEP]], arg1
fn @past_write(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = add v0, 2
    mstore 0, v0
    mstore v1, arg1
    ret v0
}

// The word stays when moving it would keep its operand alive past the write.
// CHECK-LABEL: {{^[ +].*}}fn @operand_dies{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @operand_dies(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = add v0, 2
    mstore 0, arg0
    mstore v1, arg1
    ret arg1
}

// A gas reading is a wall: work moved past it would change the gas it observes.
// CHECK-LABEL: {{^[ +].*}}fn @before_gas{{[( ]}}
// CHECK-NOT: {{^[-+]}}
fn @before_gas(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = add v0, 2
    v2 = gas
    v3 = add v1, v2
    v4 = add v3, v0
    ret v4
}

// A range check of an argument moves past the stores to the branch that reads it,
// rather than riding the stack, or a spill slot, across them.
// CHECK-LABEL: {{^[ +].*}}fn @range_check{{[( ]}}
// CHECK: - [[ABOVE:v[0-9]+]] = gt arg0, 0xffffffff
// CHECK-NEXT: mstore 0, arg1
// CHECK-NEXT: mstore 32, arg0
// CHECK-NEXT: + [[ABOVE]] = gt arg0, 0xffffffff
// CHECK-NEXT: jumpi [[ABOVE]], bb1, bb2
fn @range_check(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = gt arg0, 0xffffffff
    mstore 0, arg1
    mstore 32, arg0
    jumpi v0, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret arg1
}
