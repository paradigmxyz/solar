//@ compile-flags: -Zmir-pipeline=evm-inst-schedule
//@ filecheck:
@module EvmInstScheduleSink

// A search computes the index it would return before testing each element: the return block,
// which leaves the loop, alone reads it, so it moves there and out of every iteration. The
// loaded word it reads takes the index's place across the branch.
// CHECK-LABEL: {{^[ +].*}}fn @search_return{{[( ]}}
// CHECK: bb2:
// CHECK-NEXT: [[WORD:v[0-9]+]] = mload
// CHECK-NEXT: - [[INDEX:v[0-9]+]] = add [[WORD]], 1
// CHECK: bb3:
// CHECK-NEXT: + [[INDEX]] = add [[WORD]], 1
// CHECK-NEXT: ret [[INDEX]]
fn @search_return(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v3 = phi [bb0: arg1], [bb4: v9]
    v4 = phi [bb0: arg0], [bb4: v10]
    v5 = gt v3, 1
    jumpi v5, bb2, bb6
  bb2:
    v7 = mload v4
    v6 = add v7, 1
    v8 = eq v7, arg2
    jumpi v8, bb3, bb4
  bb3:
    ret v6
  bb4:
    v9 = sub v3, 2
    v10 = sub v4, 64
    jump bb1
  bb6:
    ret 0
}

// A chain whose last result only the reverting successor reads moves there as a whole, in
// its original order.
// CHECK-LABEL: {{^[ +].*}}fn @chain{{[( ]}}
// CHECK: bb0:
// CHECK-NEXT: - [[SHIFTED:v[0-9]+]] = shl arg0, 5
// CHECK-NEXT: - [[CODE:v[0-9]+]] = add [[SHIFTED]], 1
// CHECK: bb2:
// CHECK-NEXT: + [[SHIFTED]] = shl arg0, 5
// CHECK-NEXT: + [[CODE]] = add [[SHIFTED]], 1
// CHECK-NEXT: mstore 0, [[CODE]]
fn @chain(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = shl arg0, 5
    v3 = add v2, 1
    v4 = lt arg0, arg1
    jumpi v4, bb1, bb2
  bb1:
    ret arg0
  bb2:
    mstore 0, v3
    revert 0, 32
}

// Every operand stays live across the branch, so the branch keeps one word fewer, even on the
// way into the successor that runs more often.
// CHECK-LABEL: {{^[ +].*}}fn @fewer_words{{[( ]}}
// CHECK: bb0:
// CHECK-NEXT: - [[SIZE:v[0-9]+]] = shl arg0, 5
// CHECK: bb1:
// CHECK-NEXT: + [[SIZE]] = shl arg0, 5
fn @fewer_words(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v2 = shl arg0, 5
    v3 = gt arg0, arg1
    jumpi v3, bb2, bb1
  bb1:
    v4 = add v2, arg0
    ret v4
  bb2:
    revert 0, 0
}

// A loop-carried update that only the header's phi reads through the latch, which another
// operand would replace across the branch, stays above the branch; one whose operand the exit
// reads anyway moves into the latch.
// CHECK-LABEL: {{^[ +].*}}fn @latch_updates{{[( ]}}
// CHECK: bb2:
// CHECK-NEXT: [[WORD:v[0-9]+]] = mload
// CHECK-NEXT: [[MASKED:v[0-9]+]] = and [[WORD]],
// CHECK-NEXT: - [[NEXT:v[0-9]+]] = sub [[I:v[0-9]+]], 1
// CHECK: bb3:
// CHECK-NEXT: + [[NEXT]] = sub [[I]], 1
// CHECK-NEXT: jump bb1
fn @latch_updates(arg0: i256, arg1: i256) -> i256 {
  bb0:
    jump bb1
  bb1:
    v2 = phi [bb0: arg1], [bb3: v6]
    v3 = phi [bb0: 0], [bb3: v7]
    v4 = ne v2, 0
    jumpi v4, bb2, bb4
  bb2:
    v5 = mload v2
    v7 = and v5, 0xffffffffffffffffffffffffffffffffffffffff
    v6 = sub v2, 1
    v8 = gt v5, v3
    jumpi v8, bb4, bb3
  bb3:
    jump bb1
  bb4:
    v9 = add v2, v3
    ret v9
}

// Nothing moves into a successor with another predecessor, out of a value both successors
// read, past a branch that would keep two operands live in its place, or off a memory read.
// CHECK-LABEL: {{^[ +].*}}fn @kept{{[( ]}}
// CHECK-NOT: {{^[+-] }}
fn @kept(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v3 = add arg0, 1
    v4 = add arg0, arg1
    v5 = mul arg1, arg2
    v6 = mload arg2
    v7 = lt arg0, arg1
    jumpi v7, bb1, bb2
  bb1:
    v8 = add v4, v6
    ret v8
  bb2:
    v9 = add v4, v5
    v11 = ne v9, 0
    jumpi v11, bb3, bb4
  bb3:
    jump bb4
  bb4:
    v10 = add v3, v9
    ret v10
}
