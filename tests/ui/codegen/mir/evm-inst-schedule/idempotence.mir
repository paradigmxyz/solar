//@ compile-flags: -Zmir-pipeline=evm-inst-schedule,evm-inst-schedule
//@ filecheck:
@module EvmInstScheduleIdempotence

// The second run must preserve the first run's order.
// CHECK-LABEL: {{^[ +].*}}fn @idempotent{{[( ]}}
// CHECK: - [[ADD:v[0-9]+]] = add arg0, arg1
// CHECK-NEXT: [[MUL:v[0-9]+]] = mul arg2, arg3
// CHECK-NEXT: + [[ADD]] = add arg0, arg1
// CHECK-NEXT: {{v[0-9]+}} = sub [[ADD]], [[MUL]]
// CHECK-LABEL: {{^[ +].*}}fn @idempotent{{[( ]}}
// CHECK-NOT: {{^[+-]}}
// CHECK: [[MUL2:v[0-9]+]] = mul arg2, arg3
// CHECK-NEXT: [[ADD2:v[0-9]+]] = add arg0, arg1
// CHECK-NEXT: {{v[0-9]+}} = sub [[ADD2]], [[MUL2]]
fn @idempotent(arg0: u256, arg1: u256, arg2: u256, arg3: u256) -> u256 {
  bb0:
    v4 = add arg0, arg1
    v5 = mul arg2, arg3
    v6 = sub v4, v5
    ret v6
}
