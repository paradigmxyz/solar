//@ compile-flags: -Zmir-pipeline=evm-inst-schedule
//@ filecheck:
@module EvmInstScheduleLoopEntry

// A jump into a loop header hands the header's phis their inputs last, the
// first phi's input on top. The jump pushes the constant slot above the
// block's words, so the cursor's start moves below it, past the bound.
// CHECK-LABEL: {{^[ +].*}}fn @start_below_constant{{[( ]}}
// CHECK: - [[START:v[0-9]+]] = add arg0, 31
// CHECK-NEXT: {{v[0-9]+}} = add arg0, arg1
// CHECK-NEXT: + [[START]] = add arg0, 31
// CHECK-NEXT: jump bb1
fn @start_below_constant(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 31
    v1 = add arg0, arg1
    jump bb1
  bb1:
    v2 = phi [bb0: 7], [bb2: v5]
    v3 = phi [bb0: v0], [bb2: v6]
    v4 = lt v3, v1
    jumpi v4, bb2, bb3
  bb2:
    v5 = add v2, 1
    v6 = add v3, 32
    jump bb1
  bb3:
    ret v2
}

// An input handed to a phi before a constant one would end below that
// constant wherever the block leaves it, so the block keeps its order.
// CHECK-LABEL: {{^[ +].*}}fn @start_above_constant{{[( ]}}
// CHECK: {{^ +}}{{v[0-9]+}} = add arg0, 31
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = add arg0, arg1
// CHECK-NEXT: {{^ +}}jump bb1
fn @start_above_constant(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, 31
    v1 = add arg0, arg1
    jump bb1
  bb1:
    v3 = phi [bb0: v0], [bb2: v6]
    v2 = phi [bb0: 7], [bb2: v5]
    v4 = lt v3, v1
    jumpi v4, bb2, bb3
  bb2:
    v5 = add v2, 1
    v6 = add v3, 32
    jump bb1
  bb3:
    ret v2
}

// A jump to a join that no loop returns to keeps the block's order.
// CHECK-LABEL: {{^[ +].*}}fn @join_keeps_order{{[( ]}}
// CHECK: {{^ +}}{{v[0-9]+}} = add arg0, 31
// CHECK-NEXT: {{^ +}}{{v[0-9]+}} = add arg0, arg1
// CHECK-NEXT: {{^ +}}jump bb3
fn @join_keeps_order(arg0: i256, arg1: i256, arg2: i1) -> i256 {
  bb0:
    jumpi arg2, bb1, bb2
  bb1:
    v0 = add arg0, 31
    v1 = add arg0, arg1
    jump bb3
  bb2:
    jump bb3
  bb3:
    v2 = phi [bb1: v0], [bb2: 0]
    v3 = phi [bb1: v1], [bb2: 1]
    v4 = add v2, v3
    ret v4
}
