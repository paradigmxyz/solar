//@ revisions: homestead cancun
//@[homestead] compile-flags: --evm-version homestead -Zmir-pipeline=none
//@[cancun] compile-flags: --evm-version cancun -Zmir-pipeline=lower
//@[cancun] filecheck:
//~[homestead]? ERROR: target-dependent memory copy instruction `mcopy` survives the `target-lowered` phase boundary
@module ValidateTargetMcopy
@phase target-lowered

// CHECK: after lower
// CHECK: @phase evm-shaped
fn @entry() [entry] {
  bb0:
    mcopy 0, 0, 0
    stop
}
