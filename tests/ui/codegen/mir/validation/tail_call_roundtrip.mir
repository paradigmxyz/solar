//@compile-flags: -Zmir-pipeline=dce
//@filecheck:
// `tail_call` round-trips through the text format: control transfers to the
// callee and does not return, so the case block needs no trailing terminator.
// The arity is validated against the callee (one u256 argument here).
@module TailCallRoundtrip
@phase semantic
fn @wrapper(arg0: u256) {
  bb0:
    mstore 128, arg0
    returndata 128, 32
}
// CHECK-LABEL: {{^[ +].*}}fn @entry{{[( ]}}
// CHECK: {{^[ +].*}}[[ARG:v[0-9]+]] = calldataload 4
// CHECK: {{^[ +].*}}tail_call @wrapper, [[ARG]]
fn @entry() [entry] {
  bb0:
    v1 = calldataload 0
    v3 = shr 224, v1
    v4 = eq v3, 0x9507d39a
    jumpi v4, bb1, bb2
  bb1:
    v6 = calldataload 4
    tail_call fn0, v6
  bb2:
    revert 0, 0
}

// A nonreturning tail-call chain need not match its caller's return arity.
fn @revertCaller() -> u256 {
  bb0:
    tail_call @revertForward
}
fn @revertForward() {
  bb0:
    tail_call @revertEnd
}
fn @revertEnd() {
  bb0:
    revert 0, 0
}
fn @cycleCaller() -> u256 {
  bb0:
    tail_call @cycleA
}
fn @cycleA() {
  bb0:
    tail_call @cycleB
}
fn @cycleB() {
  bb0:
    tail_call @cycleA
}
