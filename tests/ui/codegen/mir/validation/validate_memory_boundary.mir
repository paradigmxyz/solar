//@compile-flags: -Zmir-pipeline=dce
//~? ERROR: [fn0] [bb0, inst0] slice instruction `make_memory_slice` survives the `evm-shaped` phase boundary
//~? ERROR: [fn0] [bb0, inst1] slice instruction `slice_len` survives the `evm-shaped` phase boundary
//~? ERROR: [fn1] [bb0, inst0] ABI encoding instruction `abi_encode` survives the `evm-shaped` phase boundary
//~? ERROR: [fn2] memory-object signature type `memorystruct` survives the `evm-shaped` phase boundary
//~? ERROR: [fn2] [bb0, inst0] aggregate instruction `storage_to_memory` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst0] abstract allocation instruction `fmp` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst1] abstract allocation instruction `set_fmp` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst2] abstract allocation instruction `alloc` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst3] storage slot instruction `mapping_slot` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst4] storage slot instruction `mapping_slot_memory` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst5] storage slot instruction `mapping_slot_calldata` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst6] storage slot instruction `storage_array_data_slot` survives the `evm-shaped` phase boundary
//~? ERROR: [fn3] [bb0, inst7] storage slot instruction `storage_array_element_slot` survives the `evm-shaped` phase boundary
// EVM-shaped MIR is the word-backend boundary. Semantic memory operations
// must be rejected here if their named lowering pass did not consume them.
@module ValidateMemoryBoundary
@phase evm-shaped
fn @slice(arg0: memptr, arg1: u256) -> u256 {
  bb0:
    v2 = make_memory_slice arg0, arg1
    v3 = slice_len v2
    ret v3
}
fn @abi(arg0: u256) -> memoryslice {
  bb0:
    v1 = abi_encode [word], args arg0
    ret v1
}
fn @aggregate(arg0: u256, arg1: memorystruct) {
  bb0:
    storage_to_memory struct<word>, arg0, arg1
    stop
}
fn @allocation() {
  bb0:
    v0 = fmp
    set_fmp v0
    v1 = alloc raw, exact, uninitialized, infallible, 32
    v2 = mapping_slot v0, v1
    v3 = mapping_slot_memory v0, v1
    v4 = mapping_slot_calldata v0, v1
    v5 = storage_array_data_slot v0
    v6 = storage_array_element_slot v0, v1, 1
    stop
}
