//@compile-flags: -Zmir-pipeline=dce
@module TailCallValidate

fn @callee(arg0: u256) {
  bb0:
    stop
}

//~? ERROR: [fn1] tail_call to `callee` passes 0 argument(s), expected 1
fn @wrongArity() {
  bb0:
    tail_call fn0
}

//~? ERROR: [fn2] tail_call targets nonexistent function fn9
fn @unknownTarget() {
  bb0:
    tail_call fn9
}

//~? ERROR: [fn3] icall targets nonexistent function fn9
fn @unknownInternalTarget() {
  bb0:
    icall fn9
    stop
}

//~? ERROR: [fn4] icall to `callee` produces a value but the callee returns no values
fn @voidResult() -> u256 {
  bb0:
    v0 = icall @callee, 42
    ret v0
}
