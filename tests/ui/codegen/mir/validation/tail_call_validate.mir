//@compile-flags: -Zmir-pipeline=dce
@module TailCallValidate
types:
  struct0: {u256, u256}

fn @callee(arg0: u256) {
  bb0:
    stop
}

//~? ERROR: [fn1] tail_call to `callee` passes 0 argument(s), expected 1
fn @wrongArity() {
  bb0:
    tail_call fn0
}

//~? ERROR: [fn2] tail_call targets nonexistent function fn99
fn @unknownTarget() {
  bb0:
    tail_call fn99
}

//~? ERROR: [fn3] icall targets nonexistent function fn99
fn @unknownInternalTarget() {
  bb0:
    icall fn99
    stop
}

//~? ERROR: [fn4] icall to `callee` produces a value but the callee returns no values
fn @voidResult() -> u256 {
  bb0:
    v0 = icall @callee, 42
    ret v0
}

//~? ERROR: [fn5] [bb0] tail-call results do not match the struct signature
fn @wrongForwardedReturn() -> u256 {
  bb0:
    tail_call @forward
}
fn @forward() -> struct0 {
  bb0:
    tail_call @pair
}
fn @pair() -> struct0 {
  bb0:
    ret undef struct0
}
//~? ERROR: [fn8] tail_call to `twoWords` returns 2 value(s), caller signature expects 1
fn @wrongForwardedArity() -> u256 {
  bb0:
    tail_call @twoWords
}
fn @twoWords() -> (u256, u256) {
  bb0:
    tail_call @twoWordReturn
}
fn @twoWordReturn() -> (u256, u256) {
  bb0:
    ret 1, 2
}

//~? ERROR: [fn11] [bb0] return has 0 value(s), signature expects 1
fn @missingReturn() -> u256 {
  bb0:
    ret
}
//~? ERROR: [fn12] [bb0] return has 1 value(s), signature expects 0
fn @extraReturn() {
  bb0:
    ret 42
}
//~? ERROR: [fn13] parameter 0 cannot have type `void`
fn @voidParameter(arg0: void) {
  bb0:
    stop
}
//~? ERROR: [fn14] return signature cannot contain `void`; use an empty return list
fn @voidSignature() -> void {
  bb0:
    stop
}
