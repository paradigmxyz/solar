// Backend projection metadata must independently match the MIR buffer read.
//~? ERROR: backend projection reads the wrong result word
@module BackendProjection
@phase lowered
@types
  struct0: {i256, i256}
// backend-memory-v1
// backend-stack 0 0 1,2,3 3
fn @entry() [entry] {
  bb0:
    v0 = icall @pair
    v1 = mload 32
    v2 = add v1, 64
    v3 = mload v2
    mstore 0, v3
    stop
}

fn @pair() -> struct0 [return_abi=[i256, i256]] {
  bb0:
    ret 7, 8
}
