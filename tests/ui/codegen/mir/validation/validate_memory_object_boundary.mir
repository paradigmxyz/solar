//@compile-flags: -Zmir-pipeline=dce
//~? ERROR: [fn0] [bb0, inst0] abstract allocation instruction `alloc` survives the `lowered` phase boundary
//~? ERROR: [fn0] [bb0, inst1] pointer arithmetic instruction `ptradd` survives the `lowered` phase boundary
//~? ERROR: [fn0] [bb0, inst2] slice instruction `slice_len` survives the `lowered` phase boundary
//~? ERROR: [fn0] non-word type `memoryslice` survives the `lowered` phase boundary
@module ValidateMemoryObjectBoundary
@phase lowered

fn @object(arg0: memptr, arg1: memoryslice) -> memptr {
  bb0:
    v1 = alloc memorystruct<1>, exact, uninitialized, infallible, 32
    v2 = ptradd arg0, 32
    v3 = slice_len arg1
    store v2, v3
    ret v1
}

//~? ERROR: [fn1] non-word type `i8` survives the `lowered` phase boundary
fn @syntax_only_integer(arg0: i8) -> i8 {
  bb0:
    ret arg0
}
