//@ compile-flags: -Zmir-pipeline=dce
//~? ERROR: module has an eligible non-returning call that is not a `tail_call`

@module ValidateEvmShape
@phase evm-shaped
fn @entry() [entry] {
  bb0:
    tail_call fn1
}
fn @caller() [selector=0x00000001] {
  bb0:
    internal_call fn2, 0
    stop
}
fn @fused() {
  bb0:
    returndata 0, 0
}
