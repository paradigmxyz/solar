//@ compile-flags: -Zmir-pipeline=none
//~? ERROR: [fn0] [bb0, inst0] instruction result or layout does not match its type contract
//~? ERROR: [fn1] [bb0, inst0] instruction result or layout does not match its type contract
@module InvalidPacked

fn @hash_array(arg0: memptr) -> i256 {
  bb0:
    v0 = keccak256_packed (array<word> memoryarray<1> arg0)
    ret v0
}

fn @dynamic_element(arg0: memptr) -> memptr {
  bb0:
    v0 = abi_encode_packed (array<memory_bytes> memoryarray<1> arg0)
    ret v0
}
