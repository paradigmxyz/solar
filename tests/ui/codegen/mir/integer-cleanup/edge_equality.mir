//@ compile-flags: -Ogas -Zmir-pipeline=integer-cleanup
//@ filecheck:
@module EdgeEquality

// After integer lowering unifies the length reads, a guard that proves the
// length leaves its round-up arithmetic constant.
// CHECK-LABEL: fn @padded
// CHECK: - v1 = add arg0, 31
// CHECK-NEXT: + v1 = add 64, 31
fn @padded(arg0: i256) -> i256 {
  bb0:
    v0 = ne arg0, 64
    jumpi v0, bb2, bb1
  bb1:
    v1 = add arg0, 31
    ret v1
  bb2:
    revert 0, 0
}

// An inner edge that contradicts an outer one is dead, and its constant must not
// leak to the live blocks after it; this pass keeps the dead branch.
// CHECK-LABEL: fn @contradiction
// CHECK: - v2 = add arg0, 1
// CHECK-NEXT: - v3 = add v2, arg0
// CHECK-NEXT: + v2 = add 5, 1
// CHECK-NEXT: + v3 = add v2, 5
fn @contradiction(arg0: i256) -> i256 {
  bb0:
    v0 = eq arg0, 5
    jumpi v0, bb1, bb4
  bb1:
    v1 = eq arg0, 6
    jumpi v1, bb3, bb2
  bb2:
    v3 = add arg0, 1
    v4 = add v3, arg0
    ret v4
  bb3:
    v5 = add arg0, arg0
    ret v5
  bb4:
    ret 0
}

// A mask that the edge makes redundant leaves its input, not the constant: the operand rules
// decide whether the input may become one.
// CHECK-LABEL: fn @mask
// CHECK: - mstore 0, v1
// CHECK: + mstore 0, arg0
fn @mask(arg0: i256) {
  bb0:
    v0 = eq arg0, 3
    jumpi v0, bb1, bb2
  bb1:
    v1 = and arg0, 0xff
    mstore 0, v1
    mstore 32, arg0
    returndata 0, 64
  bb2:
    revert 0, 0
}
