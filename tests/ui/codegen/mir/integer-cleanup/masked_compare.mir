//@ compile-flags: -Ogas -Zmir-pipeline=integer-cleanup
@module MaskedCompare

// A mask that stays keeps the low 160 bits of a word, and the compare of the masked word with a
// value below `2^160` holds exactly when the shifted difference of the words is zero. A branch
// reads the shifted word of an `ne` without a test.
fn @branch_ne() {
  bb0:
    v0: i256 = caller
    v1 = sload 0
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = ne v0, v2
    jumpi v3, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    stop
}

// An `eq` and a materialized boolean pay for their zero tests.
fn @value_eq() -> i1 {
  bb0:
    v0: i256 = caller
    v1 = sload 0
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = eq v0, v2
    ret v3
}

fn @value_ne() -> i1 {
  bb0:
    v0: i256 = caller
    v1 = sload 0
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = ne v0, v2
    ret v3
}

// The zero test of a mask needs no other value.
fn @zero_test() -> i1 {
  bb0:
    v0 = sload 0
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffff
    v2 = eq v1, 0
    ret v2
}

// Two masks go with the one compare of their words.
fn @two_masks() -> i1 {
  bb0:
    v0 = sload 0
    v1 = sload 1
    v2 = and v0, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v4 = eq v2, v3
    ret v4
}

// A branch that proved an argument below `2^160` makes it a value the mask keeps whole.
fn @guarded(arg0: i256) {
  bb0:
    v0 = shr arg0, 160
    v1 = ne v0, 0
    jumpi v1, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v2 = sload 0
    v3 = and v2, 0xffffffffffffffffffffffffffffffffffffffff
    v4 = eq arg0, v3
    jumpi v4, bb3, bb1
  bb3:
    stop
}

// An argument that no branch bounds may have bits above the mask, so the mask stays.
fn @unbounded(arg0: i256) -> i1 {
  bb0:
    v0 = sload 0
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffff
    v2 = eq arg0, v1
    ret v2
}

// A mask that something else reads stays, and the compare keeps it.
fn @shared_mask() -> i256 {
  bb0:
    v0: i256 = caller
    v1 = sload 0
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = eq v0, v2
    jumpi v3, bb1, bb2
  bb1:
    ret v2
  bb2:
    ret 0
}

// The mask of a narrow width costs no more than the shift, and a tie keeps the mask.
fn @narrow() -> i1 {
  bb0:
    v0 = sload 0
    v1 = and v0, 255
    v2 = eq v1, 3
    ret v2
}

// The backend reads a branch condition for free only in the branching block, so a compare defined
// in another block is a value.
fn @other_block() {
  bb0:
    v0: i256 = caller
    v1 = sload 0
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = eq v0, v2
    jump bb1
  bb1:
    jumpi v3, bb2, bb3
  bb2:
    stop
  bb3:
    revert 0, 0
}
