//@ revisions: gas size legacy
//@[gas] compile-flags: -Ogas --evm-version=osaka -Zmir-pipeline=immutable-check-elim
//@[size] compile-flags: -Osize --evm-version=osaka -Zmir-pipeline=immutable-check-elim
//@[legacy] compile-flags: -Ogas --evm-version=byzantium -Zmir-pipeline=immutable-check-elim
@module ImmutableBounds
immutables:
  small: u64
  signed: i64
  wide: u256
  clean_address: u256
  dirty_address: u256
  repeated: u256
  unknown: u256
  unwritten: u256
  called: u256
  narrow_scalar: u64
  narrow_address_width: u160
  narrow_three_bytes: u24

fn @runtime() -> i256 [selector=1] {
  bb0:
    v0 = icall @bounded
    icall @shared
    v2 = icall @signed_value
    v3 = icall @wide_value
    v4 = add v0, v2
    v5 = add v4, v3
    ret v5
}

// Modern targets encode unsigned runtime loads in eight-byte immediates.
// The legacy target uses a full word and cannot use this bound.
fn @bounded() -> i256 {
  bb0:
    v10000 = loadimmutable small
    v0 = zext i64 v10000 to i256
    v1 = add v0, 1
    v2 = lt v1, v0
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v1
}

// Constructor reachability crosses both calls and tail calls. Shared helpers
// must retain their checks because constructor loads read full staging words.
fn @constructor(arg0: i256) [constructor] {
  bb0:
    v10001 = trunc i256 arg0 to i64
    storeimmutable small, v10001
    icall @bridge
    stop
}

fn @bridge() {
  bb0:
    tail_call @shared
}

fn @shared() {
  bb0:
    v10002 = loadimmutable small
    v0 = zext i64 v10002 to i256
    v1 = add v0, 1
    v2 = lt v1, v0
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    stop
}

// Signed values can have every high bit set even with a short immediate.
fn @signed_value() -> i256 {
  bb0:
    v10003 = loadimmutable signed
    v0 = sext i64 v10003 to i256
    v1 = add v0, 1
    v2 = lt v1, v0
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v1
}

fn @wide_value() -> i256 {
  bb0:
    v0 = loadimmutable wide
    v1 = add v0, 1
    v2 = lt v1, v0
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v1
}

// A helper with no established runtime entry cannot acquire runtime facts.
fn @unrooted() -> i256 {
  bb0:
    v10004 = loadimmutable small
    v0 = zext i64 v10004 to i256
    v1 = add v0, 1
    v2 = lt v1, v0
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    ret v1
}

// Every assignment contributes to the encoding width, including helper calls.
fn @assign_widths(arg0: i256) [constructor] {
  bb0:
    v0 = address
    v1 = zext i160 v0 to i256
    storeimmutable clean_address, v1
    storeimmutable dirty_address, 0x10000000000000000000000000000000000000007
    storeimmutable repeated, 1
    storeimmutable repeated, 65536
    storeimmutable unknown, arg0
    icall @assign_called, 7
    icall @assign_called, 65535
    ret
}

fn @assign_called(arg0: i256) {
  bb0:
    storeimmutable called, arg0
    ret
}

fn @assign_narrow_scalars() [constructor] {
  bb0:
    storeimmutable narrow_three_bytes, i24 255
    storeimmutable narrow_scalar, i64 255
    storeimmutable narrow_address_width, i160 65535
    v0 = loadimmutable narrow_scalar
    v1 = add v0, i64 1
    v2 = zext i64 v1 to i256
    mstore 0, v2
    ret
}

fn @load_narrow_scalar() -> i64 [selector=2] {
  bb0:
    v0 = loadimmutable narrow_scalar
    v1 = add v0, i64 1
    ret v1
}

fn @load_narrow_address_width() -> i160 [selector=3] {
  bb0:
    v0 = loadimmutable narrow_address_width
    v1 = add v0, i160 1
    ret v1
}

fn @load_narrow_three_bytes() -> i24 [selector=4] {
  bb0:
    v0 = loadimmutable narrow_three_bytes
    v1 = add v0, i24 1
    ret v1
}

fn @load_narrow_word() -> i256 [selector=5] {
  bb0:
    v0 = loadimmutable called
    v1 = add v0, 1
    ret v1
}
