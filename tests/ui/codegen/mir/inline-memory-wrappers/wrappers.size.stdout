      ret v3
  }
  
  fn @wrap(arg0: i256) -> i256 {
    bb0:
      v0 = icall @base, arg0
      v1 = mload v0
      v2 = add v1, 2
      mstore v0, v2
      ret v0
  }
  
  fn @single(arg0: i256) -> i256 {
    bb0:
      v0 = icall @base, arg0
      v1 = mload v0
      mstore v0, v1
      ret v0
  }
  
  fn @effects(arg0: i256) -> i256 {
    bb0:
      v0 = icall @base, arg0
      mstore v0, 5
      sstore 0, 5
      ret v0
  }
  
  fn @base(arg0: i256) -> i256 {
    bb0:
      ret arg0
  }
  
  fn @pressure(arg0: i256, arg1: i256, arg2: i256, arg3: i256, arg4: i256, arg5: i256, arg6: i256, arg7: i256, arg8: i256, arg9: i256, arg10: i256, arg11: i256, arg12: i256) -> i256 [selector=0x00000002] {
