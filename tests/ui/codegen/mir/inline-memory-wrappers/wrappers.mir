//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zmir-pipeline=inline-memory-wrappers,cfg-simplify,dce
//@[size] compile-flags: -Osize -Zmir-pipeline=inline-memory-wrappers,cfg-simplify,dce
@module MemoryWrappers

// Clone the nested call and both potentially aliasing accesses in their original order.
fn @entry(arg0: memptr) -> memptr [selector=1] {
  bb0:
    v0 = icall @wrap, 1, arg0
    v1 = icall @wrap, 1, v0
    v2 = icall @single, 1, v1
    v3 = icall @effects, 1, v2
    ret v3
}

fn @wrap(arg0: memptr) -> memptr {
  bb0:
    v0 = icall @base, 1, arg0
    v1 = mload v0
    v2 = add v1, 2
    mstore v0, v2
    ret v0
}

// A single-use adapter also expands when its call and stack costs permit it.
fn @single(arg0: memptr) -> memptr {
  bb0:
    v0 = icall @base, 1, arg0
    v1 = mload v0
    mstore v0, v1
    ret v0
}

// Storage effects are outside this bounded adapter.
fn @effects(arg0: memptr) -> memptr {
  bb0:
    v0 = icall @base, 1, arg0
    mstore v0, 5
    sstore 0, 5
    ret v0
}

fn @base(arg0: memptr) -> memptr {
  bb0:
    ret arg0
}

// Keep the wrapper call when expansion would overlap too many caller words.
fn @pressure(arg0: memptr, arg1: u256, arg2: u256, arg3: u256, arg4: u256, arg5: u256, arg6: u256, arg7: u256, arg8: u256, arg9: u256, arg10: u256, arg11: u256, arg12: u256) -> u256 [selector=2] {
  bb0:
    v0 = icall @wrap, 1, arg0
    v1 = add arg1, arg2
    v2 = add arg3, arg4
    v3 = add arg5, arg6
    v4 = add arg7, arg8
    v5 = add arg9, arg10
    v6 = add arg11, arg12
    v7 = add v1, v2
    v8 = add v3, v4
    v9 = add v5, v6
    v10 = add v7, v8
    v11 = add v9, v10
    mstore v0, v11
    ret v11
}
