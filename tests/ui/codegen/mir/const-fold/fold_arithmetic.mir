//@ compile-flags: -Zmir-pipeline=const-fold
//@ filecheck:
//@ run-call: sum(uint256)(uint256) 5 => 61
//@ run-call: cancel(uint256)(uint256) 9 => 0
//@ run-call: keep(uint256)(uint256) 9 => 9
// An operation with only constant operands becomes a constant, and the constant reaches every
// later use, across blocks too. An identity that yields a constant folds as well. One that
// leaves a value of the argument stays for other passes.
@module FoldArithmetic
@phase lowered

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb4, [0x188b85b4 => bb1, 0x40e58ee5 => bb2, 0xbfc207cf => bb3]
  bb1:
    tail_call @sum
  bb2:
    tail_call @cancel
  bb3:
    tail_call @keep
  bb4:
    revert 0, 0
}

// CHECK-LABEL: {{^[ +].*}}fn @sum{{[( ]}}
// CHECK: - {{v[0-9]+}} = add 10, 20
// CHECK: - {{v[0-9]+}} = mul {{v[0-9]+}}, 2
// CHECK: - {{v[0-9]+}} = sub {{v[0-9]+}}, 4
// CHECK: + {{v[0-9]+}} = add {{v[0-9]+}}, 56
fn @sum() [selector=0x188b85b4, abi_wrapper] {
  bb0:
    v0 = calldataload 4
    v1 = add 10, 20
    v2 = mul v1, 2
    jump bb1
  bb1:
    v3 = sub v2, 4
    v4 = add v0, v3
    mstore 0, v4
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @cancel{{[( ]}}
// CHECK: - {{v[0-9]+}} = sub {{v[0-9]+}}, {{v[0-9]+}}
// CHECK: + mstore 0, 0
fn @cancel() [selector=0x40e58ee5, abi_wrapper] {
  bb0:
    v0 = calldataload 4
    v1 = sub v0, v0
    mstore 0, v1
    returndata 0, 32
}

// CHECK-LABEL: {{^[ +].*}}fn @keep{{[( ]}}
// CHECK: {{^ +}}{{v[0-9]+}} = add {{v[0-9]+}}, 0
// CHECK-NOT: {{^[-+]}}
fn @keep() [selector=0xbfc207cf, abi_wrapper] {
  bb0:
    v0 = calldataload 4
    v1 = add v0, 0
    mstore 0, v1
    returndata 0, 32
}
