//@ compile-flags: -Zcheck-analyses=true -Zmir-pipeline=const-fold
//@ filecheck:
//@ run-call: below(uint256)(uint256) 3 => 1
//@ run-call: below(uint256)(uint256) 0xffff => 1
// Late constant folding reuses the e-graph's rules: `a < 256` folds to true because
// `a & 255` is below 256, which it records like the e-graph does. `lower-assumes`
// turns the record into a test whose fact word names `ult` (3) and `const-fold` (9).
@module RecordedFolds
@phase lowered

fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb2, [0x8de62f33 => bb1]
  bb1:
    tail_call @below
  bb2:
    revert 0, 0
}

// CHECK-LABEL: fn @below(
// CHECK: [[A:v[0-9]+]] = and {{v[0-9]+}}, 255
// CHECK: mstore 0, 1
// CHECK: phi [{{.*}}: {{0x309[0-9a-f]+}}]
// CHECK: phi [{{.*}}: [[A]]]
// CHECK: phi [{{.*}}: 256]
fn @below() {
  bb0:
    v0 = calldataload 4
    v1 = and v0, 255
    v2 = lt v1, 256
    v3 = zext i1 v2 to i256
    mstore 0, v3
    returndata 0, 32
}
