//@compile-flags: -Zmir-pipeline=pure-eval
//@filecheck:
@module PureEvalLoop
// CHECK-LABEL: {{^[ +].*}}fn @bounded_loop{{[( ]}}
// CHECK: - jump bb1
// CHECK: + ret 3
fn @bounded_loop() -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb2: 3]
    v1 = lt v0, 3
    jumpi v1, bb2, bb3
  bb2:
    jump bb1
  bb3:
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @with_arg{{[( ]}}
// CHECK: {{^[ +].*}}{{v[0-9]+}} = add arg0, 1
fn @with_arg(arg0: u256) -> u256 {
  bb0:
    v0 = add arg0, 1
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @extended_evm_ops{{[( ]}}
// CHECK: + ret 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
fn @extended_evm_ops() -> u256 {
  bb0:
    v0 = sdiv 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff9, 2
    v1 = smod 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff9, 3
    v2 = addmod 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, 2, 3
    v3 = mulmod 0x100000000000000000000000000000000, 0x100000000000000000000000000000000, 7
    v4 = slt 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, 0
    v5 = sgt 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    v6 = signextend 0, 255
    ret v6
}

// CHECK-LABEL: {{^[ +].*}}fn @signed_return{{[( ]}}
// CHECK: + ret 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd
fn @signed_return() -> i256 {
  bb0:
    v0 = sdiv 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff9, 2
    ret v0
}

// CHECK-LABEL: {{^[ +].*}}fn @bool_return{{[( ]}}
// CHECK: + ret 1
fn @bool_return() -> bool {
  bb0:
    v0 = slt 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, 0
    ret v0
}

fn @unknown_case_precedes_match() -> u256 {
  bb0:
    v0 = address
    switch 1, default bb3, [v0 => bb1, 1 => bb2]
  bb1:
    ret 1
  bb2:
    ret 2
  bb3:
    ret 3
}
