//@ compile-flags: -Zmir-pipeline=readonly-eval
//@ filecheck:
@module KnownWords

// CHECK-LABEL: fn @known
// CHECK: ret 42
fn @known() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 64
    mstore v0, 1
    v1 = add v0, 32
    mstore v1, 41
    v2 = icall @choose, 1, v0
    ret v2
}

// CHECK-LABEL: fn @choose
fn @choose(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    jumpi v0, bb1, bb2
  bb1:
    v1 = add arg0, 32
    v2 = icall @read, 1, v1
    v3 = add v2, 1
    ret v3
  bb2:
    sstore 0, 1
    ret 7
}

fn @read(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    ret v0
}

// A taken write prevents folding even when the return value is constant.
// CHECK-LABEL: fn @writes
// CHECK: {{^[ +].*}}= icall @choose
fn @writes() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 64
    mstore v0, 0
    v1 = icall @choose, 1, v0
    ret v1
}

// A partial overwrite must kill the old full-word fact.
// CHECK-LABEL: fn @partial_write
// CHECK: {{^[ +].*}}= icall @read
fn @partial_write(arg0: u256) -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 42
    v1 = add v0, 1
    mstore8 v1, arg0
    v2 = icall @read, 1, v0
    ret v2
}

// Unknown call effects invalidate memory; the old initialization cannot survive.
// CHECK-LABEL: fn @clobbered
// CHECK: {{^[ +].*}}= icall @read
fn @clobbered(arg0: u256) -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 42
    icall @overwrite, 0, v0, arg0
    v1 = icall @read, 1, v0
    ret v1
}

fn @overwrite(arg0: memptr, arg1: u256) {
  bb0:
    mstore arg0, arg1
    ret
}

// A call reading an uninitialized word must not fold from adjacent data.
// CHECK-LABEL: fn @uninitialized
// CHECK: {{^[ +].*}}= icall @choose
fn @uninitialized() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 64
    mstore v0, 1
    v1 = icall @choose, 1, v0
    ret v1
}

// Fixed scratch words are deliberately outside the fresh-allocation model.
// CHECK-LABEL: fn @scratch
// CHECK: {{^[ +].*}}= icall @read
fn @scratch() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 1
    mstore 0, 42
    v1 = icall @read, 1, 0
    ret v1
}

// Both constants propagate through the chosen phi edge.
// CHECK-LABEL: fn @phi_caller
// CHECK: ret 42
fn @phi_caller() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 1
    v1 = icall @phi_callee, 1, v0
    ret v1
}

fn @phi_callee(arg0: memptr) -> u256 {
  bb0:
    v0 = mload arg0
    jumpi v0, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v1 = phi [bb1: 42], [bb2: 7]
    ret v1
}

// Recursive evaluation must stop without changing the original call.
// CHECK-LABEL: fn @recursive_caller
// CHECK: {{^[ +].*}}= icall @recursive
fn @recursive_caller() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 1
    v1 = icall @recursive, 1, v0
    ret v1
}

fn @recursive(arg0: memptr) -> u256 {
  bb0:
    v0 = icall @recursive, 1, arg0
    ret v0
}

// Gas observations are not pure arithmetic, even when memory is fully known.
// CHECK-LABEL: fn @observes_gas
// CHECK: {{^[ +].*}}= icall @gas_reader
fn @observes_gas() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 42
    v1 = icall @gas_reader, 1, v0
    ret v1
}

fn @gas_reader(arg0: memptr) -> u256 {
  bb0:
    v0 = gas
    v1 = mload arg0
    v2 = add v0, v1
    ret v2
}

// A loop allocation has multiple dynamic instances and is not a unique base.
// CHECK-LABEL: fn @loop_allocation
// CHECK: {{^[ +].*}}= icall @read
fn @loop_allocation(arg0: bool) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 42
    v1 = icall @read, 1, v0
    jumpi arg0, bb1, bb2
  bb2:
    ret v1
}

// Unknown addresses may overlap the initialized word.
// CHECK-LABEL: fn @unknown_alias
// CHECK: {{^[ +].*}}= icall @read
fn @unknown_alias(arg0: memptr) -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 42
    mstore arg0, 7
    v1 = icall @read, 1, v0
    ret v1
}

// Recycling the allocation frontier prevents unique-provenance assumptions.
// CHECK-LABEL: fn @recycled
// CHECK: {{^[ +].*}}= icall @read
fn @recycled(arg0: u256) -> u256 {
  bb0:
    set_fmp arg0
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 42
    v1 = icall @read, 1, v0
    ret v1
}

// An infinite concrete path exhausts fuel and keeps the call.
// CHECK-LABEL: fn @loop_caller
// CHECK: {{^[ +].*}}= icall @loop_callee
fn @loop_caller() -> u256 {
  bb0:
    v0 = alloc raw, exact, uninitialized, infallible, 32
    mstore v0, 1
    v1 = icall @loop_callee, 1, v0
    ret v1
}

fn @loop_callee(arg0: memptr) -> u256 {
  bb0:
    jump bb1
  bb1:
    v0 = mload arg0
    jumpi v0, bb1, bb2
  bb2:
    ret v0
}
