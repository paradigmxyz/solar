//@ compile-flags: -Zmir-pipeline=readonly-eval
//@ filecheck:
@module ClosedCalls

// Both the nested void guard and scalar result are known without an allocation.
// CHECK-LABEL: fn @closed
// CHECK: - {{v[0-9]+}} = icall @validated
// CHECK: - icall @guard
// CHECK: + ret 42
fn @closed() -> i256 {
  bb0:
    v0 = icall @validated, 42
    icall @guard, v0
    ret v0
}

fn @validated(arg0: i256) -> i256 {
  bb0:
    icall @guard, arg0
    ret arg0
}

fn @guard(arg0: i256) {
  bb0:
    v0 = eq arg0, 42
    jumpi v0, bb1, bb2
  bb1:
    ret
  bb2:
    mstore 0, 17
    revert 0, 32
}

// Evaluating a failure must preserve its original call and revert behavior.
// CHECK-LABEL: fn @failure
// CHECK: {{^ +}}icall @guard, 41
fn @failure() {
  bb0:
    icall @guard, 41
    ret
}

// Unknown caller arguments do not satisfy the concrete guard.
// CHECK-LABEL: fn @unknown
// CHECK: {{^ +}}icall @guard, arg0
fn @unknown(arg0: i256) {
  bb0:
    icall @guard, arg0
    ret
}

// Executed writes, environment reads, and unknown memory reads remain calls.
// CHECK-LABEL: fn @effects
// CHECK: {{^ +}}icall @write, 42
// CHECK: {{^ +}}icall @gas_reader
// CHECK: {{^ +}}icall @memory_reader
fn @effects() {
  bb0:
    icall @write, 42
    icall @gas_reader
    icall @memory_reader
    ret
}

fn @write(arg0: i256) {
  bb0:
    sstore 0, arg0
    ret
}

fn @gas_reader() {
  bb0:
    v0 = gas
    ret
}

fn @memory_reader() {
  bb0:
    v0 = mload 4096
    ret
}

// The recursive path cannot return within the existing shared fuel/depth limits.
// CHECK-LABEL: fn @recursive_caller
// CHECK: {{^ +}}icall @recursive, 42
fn @recursive_caller() {
  bb0:
    icall @recursive, 42
    ret
}
fn @recursive(arg0: i256) {
  bb0:
    icall @recursive, arg0
    ret
}

// A successful void guard does not invalidate the preceding initialized word.
// CHECK-LABEL: fn @known_memory
// CHECK: - icall @guard
// CHECK: - {{v[0-9]+}} = icall @read
// CHECK: + ret 19
fn @known_memory() -> i256 {
  bb0:
    v2 = alloc raw, exact, uninitialized, infallible, 32
    v0 = ptrtoint memptr v2 to i256
    mstore v0, 19
    icall @guard, 42
    v1 = icall @read, v0
    ret v1
}
fn @read(arg0: i256) -> i256 {
  bb0:
    v0 = mload arg0
    ret v0
}

// Constant references remain calls to avoid disrupting pointer induction.
// CHECK-LABEL: fn @reference_caller
// CHECK: {{^ +}}v0 = icall @reference
fn @reference_caller() -> memorybytes {
  bb0:
    v0 = icall @reference
    ret v0
}
fn @reference() -> memorybytes {
  bb0:
    ret memorybytes 5
}
