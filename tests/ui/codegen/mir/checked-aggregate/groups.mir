//@ compile-flags: -Ogas -Zmir-pipeline=lower-arithmetic,egraph,check-elim,cfg-simplify,checked-aggregate
@module CheckedAggregate

// Retain every carry, including earlier overflows whose wrapped result feeds later additions.
fn @chain(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = checked_add u256, v0, arg2
    v2 = checked_add u256, v1, arg0
    ret v2
}

// Independent operations can share the check; both results remain live.
fn @independent(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = checked_sub u256, arg0, arg1
    v2 = xor v0, v1
    ret v2
}

fn @mixed(arg0: i256, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = checked_mul u256, v0, arg2
    v2 = checked_sub u256, v1, arg0
    ret v2
}

fn @signed(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add i256, arg0, arg1
    v1 = checked_sub i256, v0, arg1
    v2 = checked_mul i256, v1, arg1
    ret v2
}

fn @narrow(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u8, arg0, arg1
    v1 = checked_mul u8, v0, arg1
    ret v1
}

fn @negation(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_sub i8, 0, arg0
    v1 = checked_add i8, v0, arg1
    ret v1
}

// A long group splits at the speculation limit; replacements cross the split.
fn @bounded(arg0: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg0
    v1 = checked_add u256, v0, arg0
    v2 = checked_add u256, v1, arg0
    v3 = checked_add u256, v2, arg0
    v4 = checked_add u256, v3, arg0
    v5 = checked_add u256, v4, arg0
    v6 = checked_add u256, v5, arg0
    v7 = checked_add u256, v6, arg0
    v8 = checked_add u256, v7, arg0
    ret v8
}

fn @memory_boundary(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    mstore 0, v0
    v1 = checked_add u256, v0, arg1
    ret v1
}

fn @gas_boundary(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = gas
    v2 = checked_add u256, v0, v1
    ret v2
}

fn @panic_boundary(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v9 = ne arg0, 0
    icall panic_if_zero<0x1>, v9
    v1 = checked_add u256, v0, arg1
    ret v1
}

fn @division_boundary(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = checked_div u256, v0, arg1
    v2 = checked_add u256, v1, arg1
    ret v2
}

fn @block_boundary(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    jump bb1
  bb1:
    v1 = checked_add u256, v0, arg1
    ret v1
}

// Replacement reaches successor phi inputs without changing predecessors.
fn @phi_use(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = checked_add u256, v0, arg1
    jump bb1
  bb1:
    v2 = phi [bb0: v1]
    ret v2
}

// Failure payloads selected by predecessor must retain the individual edges.
fn @failure_phi(arg0: i1, arg1: i1) {
  bb0:
    jumpi arg0, bb2, bb1
  bb1:
    jumpi arg1, bb2, bb3
  bb2:
    v0 = phi [bb0: 32], [bb1: 64]
    mstore 0, v0
    revert 0, v0
  bb3:
    ret
}

// The continuation can also execute without passing through the first check.
fn @join_boundary(arg0: i1, arg1: i1, arg2: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jumpi arg1, bb3, bb2
  bb2:
    jumpi arg2, bb3, bb4
  bb3:
    mstore 0, 17
    revert 0, 32
  bb4:
    ret
}

fn @call_boundary(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = icall @helper, v0
    v2 = checked_add u256, v1, arg1
    ret v2
}

fn @helper(arg0: i256) -> i256 {
  bb0:
    ret arg0
}

// Generic predicates need no arithmetic recipe or panic payload.
fn @generic_false(arg0: i1, arg1: i1) {
  bb0:
    jumpi arg0, bb1, bb2
  bb1:
    jumpi arg1, bb3, bb2
  bb2:
    mstore 0, 123
    revert 0, 32
  bb3:
    ret
}

// Mixed polarities normalize the next predicate before combining.
fn @mixed_polarity(arg0: i1, arg1: i1) {
  bb0:
    jumpi arg0, bb2, bb1
  bb1:
    jumpi arg1, bb3, bb2
  bb2:
    mstore 0, 123
    revert 0, 32
  bb3:
    ret
}

// Moving a check across a load could expand memory or observe a different state.
fn @load_boundary(arg0: i1, arg1: i256) -> i256 {
  bb0:
    jumpi arg0, bb2, bb1
  bb1:
    v0 = mload 0
    v1 = lt v0, arg1
    jumpi v1, bb2, bb3
  bb2:
    mstore 0, 123
    revert 0, 32
  bb3:
    ret v0
}

// A shared outlined payload also qualifies.
fn @outlined(arg0: i1, arg1: i1) {
  bb0:
    jumpi arg0, bb2, bb1
  bb1:
    jumpi arg1, bb2, bb3
  bb2:
    tail_call @payload
  bb3:
    ret
}

fn @payload() {
  bb0:
    mstore 0, 123
    revert 0, 32
}

// Cyclic blocks keep their checks to avoid extra loop-carried stack traffic.
fn @cycle(arg0: i1, arg1: i1) {
  bb0:
    jump bb1
  bb1:
    jumpi arg0, bb3, bb2
  bb2:
    jumpi arg1, bb3, bb1
  bb3:
    mstore 0, 123
    revert 0, 32
}

// Keep branch boundaries when an accumulator would add to a crowded live set.
fn @live_values(arg0: i256, arg1: i256, arg2: i256, arg3: i256, arg4: i256, arg5: i256) -> i256 {
  bb0:
    v0 = checked_add u256, arg0, arg1
    v1 = checked_add u256, v0, arg2
    v2 = xor v1, arg3
    v3 = xor v2, arg4
    v4 = xor v3, arg5
    ret v4
}

// Keep the final success edge and its phi input when earlier failure edges disappear.
fn @success_phi(arg0: i1, arg1: i1, arg2: i1) -> i256 {
  bb0:
    jumpi arg0, bb1, bb3
  bb1:
    jumpi arg1, bb4, bb2
  bb2:
    jumpi arg2, bb4, bb3
  bb3:
    v0 = phi [bb0: 1], [bb2: 2]
    ret v0
  bb4:
    mstore 0, 123
    revert 0, 32
}
