; === ROOT/tests/ui/codegen/run-call/storage-copy-order/using_for_receiver.sol:Test ===
@module Test
; function bump() internal returns (uint256)
fn @bump() -> i256 {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = checked_add uint256, v0, 1
    sstore 0, v1 !metadata(storage=slot(0))
    v2 = mapping_slot 1, 1
    v3 = sload v2 !metadata(storage=symbolic(v2))
    v4 = checked_add uint256, v3, 1
    sstore v2, v4 !metadata(storage=symbolic(v2))
    v5 = sload 0 !metadata(storage=slot(0))
    ret v5
}

; function poke() internal returns (uint256)
fn @poke() -> i256 {
  bb0:
    v0 = sload 2 !metadata(storage=slot(2))
    v1 = gt v0, 0
    v2 = eq v1, false
    icall panic_if<0x32>, v2
    v3 = storage_array_data_slot 2
    sstore v3, 9 !metadata(storage=symbolic(v3))
    ret 0
}

; function storageValue() external returns (uint256) [selector 0xa977a973]
fn @storageValue() -> i256 [selector=0xa977a973, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = icall @bump
    v2 = icall @g, v0, v1
    ret v2
}

; function mappingValue() external returns (uint256) [selector 0xcca39d9b]
fn @mappingValue() -> i256 [selector=0xcca39d9b, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = mapping_slot 1, 1
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = icall @bump
    v3 = icall @g, v1, v2
    ret v3
}

; function freeFunction() external returns (uint256) [selector 0x59c72a5d]
fn @freeFunction() -> i256 [selector=0x59c72a5d, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = icall @bump
    v2 = icall @h, v0, v1
    ret v2
}

; function localValue() external pure returns (uint256) [selector 0xa35f68bc]
fn @localValue() -> i256 [selector=0xa35f68bc, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @g, 1, 5
    ret v0
}

; function storageParameter() external returns (uint256) [selector 0x47ac6e30]
fn @storageParameter() -> i256 [selector=0x47ac6e30, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 2 !metadata(storage=slot(2))
    v1 = gt v0, 0xffffffffffffffff
    icall panic_if<0x41>, v1
    v2 = add v0, 1
    v3 = storage_array_data_slot 2
    v4 = add v3, v0
    sstore v4, 1 !metadata(storage=symbolic(v4))
    sstore 2, v2 !metadata(storage=slot(2))
    v5 = icall @poke
    v6 = icall @f, 2, v5
    ret v6
}

; function g(uint256 a, uint256 b) internal pure returns (uint256)
fn @g(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = checked_mul uint256, arg0, 100
    v1 = checked_add uint256, v0, arg1
    ret v1
}

; function f(uint256[] storage m, uint256) internal view returns (uint256)
fn @f(arg0: i256, arg1: i256) -> i256 [view] {
  bb0:
    v0 = sload arg0 !metadata(storage=symbolic(arg0))
    v1 = gt v0, 0
    v2 = eq v1, false
    icall panic_if<0x32>, v2
    v3 = storage_array_data_slot arg0
    v4 = sload v3 !metadata(storage=symbolic(v3))
    ret v4
}

; function h(uint256 a, uint256 b) pure returns (uint256)
fn @h(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = checked_mul uint256, arg0, 100
    v1 = checked_add uint256, v0, arg1
    ret v1
}
