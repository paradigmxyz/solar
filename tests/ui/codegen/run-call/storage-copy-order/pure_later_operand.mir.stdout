; === ROOT/tests/ui/codegen/run-call/storage-copy-order/pure_later_operand.sol:Test ===
@module Test
; constructor() [creation entry]
fn @constructor() [constructor] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = gt v0, 0xffffffffffffffff
    icall panic_if<0x41>, v1
    v2 = add v0, 1
    v3 = storage_array_data_slot 0
    v4 = add v3, v0
    sstore v4, 1 !metadata(storage=symbolic(v4))
    sstore 0, v2 !metadata(storage=slot(0))
    ret
}

; function first(uint256[] memory m, uint256 z) internal pure returns (uint256)
fn @first(arg0: ptr<memory>, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = mload arg0
    v1 = gt v0, 0
    v2 = eq v1, false
    icall panic_if<0x32>, v2
    v3 = ptradd arg0, 32
    v4 = mload v3
    v5 = checked_add uint256, v4, arg1
    ret v5
}

; function length() internal view returns (uint256)
fn @length() -> i256 [view] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    ret v0
}

; function arithmetic(uint256 x) external view returns (uint256) [selector 0x9381a585]
fn @arithmetic(arg0: i256) -> i256 [selector=0x9381a585, view, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @load_storage_word_array, 0
    v1 = checked_add uint256, arg0, 1
    v2 = icall @first, v0, v1
    ret v2
}

; function viewCall() external view returns (uint256) [selector 0x33fd44fa]
fn @viewCall() -> i256 [selector=0x33fd44fa, view, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @load_storage_word_array, 0
    v1 = icall @length
    v2 = icall @first, v0, v1
    ret v2
}

fn @load_storage_word_array(arg0: i256) -> ptr<memory> {
  bb0:
    v0 = load_storage_array uint256, arg0
    ret v0
}
