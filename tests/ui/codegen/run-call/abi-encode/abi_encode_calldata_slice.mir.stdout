; function encPackedBytes(bytes calldata data, uint256 start, uint256 end) external pure returns (bytes memory) [selector 0xe3b899da]
fn @encPackedBytes(arg0: slice<calldata>, arg1: i256, arg2: i256) -> ptr<memory> [selector=0xe3b899da, pure, abi_params=[bytes, uint256, uint256], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = extract_value slice<calldata>, arg0, 1
    v2 = lt v1, arg2
    v3 = lt arg2, arg1
    v4 = or v2, v3
    v5 = zext i1 v4 to i256
    icall revert_if<empty>, v4
    v6 = sub arg2, arg1
    v7 = ptradd v0, arg1
    v8 = make_calldata_slice v7, v6
    v9 = abi_encode_packed (calldata_bytes v8)
    ret v9
}

