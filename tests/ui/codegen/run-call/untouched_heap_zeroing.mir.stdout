; function big() external pure returns (uint256[8] memory words) [selector 0x887b13a3]
fn @big() -> ptr<memory> [selector=0x887b13a3, pure, abi_params=[], abi_returns=[array<8, word>], abi_return_params=[array<8, uint256>]] {
  bb0:
    v0 = alloc 256 !metadata(preserves_fmp)
    memory_zero v0, 256
    jump bb1
  bb1:  ; preds = bb0, bb3
    v1 = phi [bb0: v0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v8]
    v3 = lt v2, 8
    jumpi v3, bb4, bb5
  bb5:  ; preds = bb1
    jump bb2
  bb2:  ; preds = bb5
    ret v1
  bb4:  ; preds = bb1
    v4 = lt v2, 8
    v5 = eq v4, false
    icall panic_if<0x32>, v5
    v6 = shl v2, 5
    v7 = ptradd v1, v6
    mstore v7, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    jump bb6
  bb6:  ; preds = bb4
    jump bb3
  bb3:  ; preds = bb6
    v8 = checked_add uint256, v2, 1
    jump bb1
}

