}

; function uncheckedCallee() external pure returns (uint256) [selector 0xc2c44d8f]
fn @uncheckedCallee() -> i256 [selector=0xc2c44d8f, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @uncheckedMake, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
