; === ROOT/tests/ui/codegen/run-call/calls/pure_struct_unchecked_caller.sol:C ===
@module C
; function checkedMake(uint256 a) internal pure returns (S memory)
fn @checkedMake(arg0: i256) -> ptr<memory> [pure] {
  bb0:
    v0 = alloc 32 !metadata(preserves_fmp)
    mstore v0, 0
    v1 = alloc 32
    v2 = checked_add uint256, arg0, 1
    mstore v1, v2
    ret v1
}

; function uncheckedMake(uint256 a) internal pure returns (S memory)
fn @uncheckedMake(arg0: i256) -> ptr<memory> [pure] {
  bb0:
    v0 = alloc 32 !metadata(preserves_fmp)
    mstore v0, 0
    v1 = alloc 32
    v2 = add arg0, 1
    mstore v1, v2
    ret v1
}

; function checkedCallee() external pure returns (uint256) [selector 0x07ed54cc]
fn @checkedCallee() -> i256 [selector=0x07ed54cc, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = alloc 32
    v1 = checked_add uint256, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, 1
    mstore v0, v1
    v2 = mload v0
