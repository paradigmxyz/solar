    v10 = make_memory_slice v9, v8
    v11 = extcall static word i160 3, v10
    jumpi v11, bb4, bb3
  bb3:                                            ; preds = bb2
    revert_returndata
  bb4:                                            ; preds = bb2
    v12 = mload 0 !metadata(memory=scratch)
    v13 = mul v12, 0x1000000000000000000000000
    v14 = mload 64 !metadata(memory=scratch)
    v15 = sub v14, v0
    v16 = insert_value struct0, undef struct0, 0, v6
    v17 = insert_value struct0, v16, 1, v13
    v18 = insert_value struct0, v17, 2, v15
    ret v18
}

; function sliceHashes(bytes calldata input, uint256 start, uint256 end) external pure returns (bytes32, bytes20) [selector 0x8a26a444]
fn @sliceHashes(arg0: slice<calldata>, arg1: i256, arg2: i256) -> struct1 [selector=0x8a26a444, pure, abi_params=[bytes, uint256, uint256], abi_returns=[word, word<bytes20>], abi_return_params=[bytes32, bytes20]] {
