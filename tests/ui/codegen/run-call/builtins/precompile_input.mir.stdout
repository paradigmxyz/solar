; function memoryHashes(bytes memory input) external pure returns (bytes32, bytes20) [selector 0xf691234d]
fn @memoryHashes(arg0: ptr<memory>) -> struct1 [selector=0xf691234d, pure, abi_params=[bytes], abi_returns=[word, word<bytes20>], abi_return_params=[bytes32, bytes20]] {
