; === ROOT/tests/ui/codegen/run-call/builtins/precompile_input.sol:PrecompileInput ===
@module PrecompileInput
@types
  struct0: {i256, i256, i256}
  struct1: {i256, i256}

; function calldataHashes(bytes calldata input) external pure returns (bytes32, bytes20, uint256 growth) [selector 0xbe0f2d16]
fn @calldataHashes(arg0: slice<calldata>) -> struct0 [selector=0xbe0f2d16, pure, abi_params=[bytes], abi_returns=[word, word<bytes20>, word], abi_return_params=[bytes32, bytes20, uint256]] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    v1 = extract_value slice<calldata>, arg0, 0
    v2 = extract_value slice<calldata>, arg0, 1
    v3 = fmp
    calldatacopy v3, v1, v2 !metadata(memory=heap)
    v4 = make_memory_slice v3, v2
    v5 = extcall static word revert i160 2, v4
    v6 = extract_value slice<calldata>, arg0, 0
    v7 = extract_value slice<calldata>, arg0, 1
    v8 = fmp
    calldatacopy v8, v6, v7 !metadata(memory=heap)
    v9 = make_memory_slice v8, v7
    v10 = extcall static word revert i160 3, v9
    v11 = mul v10, 0x1000000000000000000000000
    v12 = mload 64 !metadata(memory=scratch)
    v13 = sub v12, v0
    v14 = insert_value struct0, undef struct0, 0, v5
    v15 = insert_value struct0, v14, 1, v11
    v16 = insert_value struct0, v15, 2, v13
    ret v16
}

; function sliceHashes(bytes calldata input, uint256 start, uint256 end) external pure returns (bytes32, bytes20) [selector 0x8a26a444]
fn @sliceHashes(arg0: slice<calldata>, arg1: i256, arg2: i256) -> struct1 [selector=0x8a26a444, pure, abi_params=[bytes, uint256, uint256], abi_returns=[word, word<bytes20>], abi_return_params=[bytes32, bytes20]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = extract_value slice<calldata>, arg0, 1
    v2 = lt v1, arg2
    v3 = lt arg2, arg1
    v4 = or v2, v3
    v5 = zext i1 v4 to i256
    icall revert_if<empty>, v4
    v6 = sub arg2, arg1
    v7 = ptradd v0, arg1
    v8 = make_calldata_slice v7, v6
    v9 = extract_value slice<calldata>, v8, 0
    v10 = extract_value slice<calldata>, v8, 1
    v11 = fmp
    calldatacopy v11, v9, v10 !metadata(memory=heap)
    v12 = make_memory_slice v11, v10
    v13 = extcall static word revert i160 2, v12
    v14 = extract_value slice<calldata>, arg0, 0
    v15 = extract_value slice<calldata>, arg0, 1
    v16 = lt v15, arg2
    v17 = lt arg2, arg1
    v18 = or v16, v17
    v19 = zext i1 v18 to i256
    icall revert_if<empty>, v18
    v20 = sub arg2, arg1
    v21 = ptradd v14, arg1
    v22 = make_calldata_slice v21, v20
    v23 = extract_value slice<calldata>, v22, 0
    v24 = extract_value slice<calldata>, v22, 1
    v25 = fmp
    calldatacopy v25, v23, v24 !metadata(memory=heap)
    v26 = make_memory_slice v25, v24
    v27 = extcall static word revert i160 3, v26
    v28 = mul v27, 0x1000000000000000000000000
    v29 = insert_value struct1, undef struct1, 0, v13
    v30 = insert_value struct1, v29, 1, v28
    ret v30
}

; function memoryHashes(bytes memory input) external pure returns (bytes32, bytes20) [selector 0xf691234d]
fn @memoryHashes(arg0: ptr<memory>) -> struct1 [selector=0xf691234d, pure, abi_params=[bytes], abi_returns=[word, word<bytes20>], abi_return_params=[bytes32, bytes20]] {
  bb0:
    v0 = extcall static word revert i160 2, arg0
    v1 = extcall static word revert i160 3, arg0
    v2 = mul v1, 0x1000000000000000000000000
    v3 = insert_value struct1, undef struct1, 0, v0
    v4 = insert_value struct1, v3, 1, v2
    ret v4
}

; function forgedHashes(uint256 offset, uint256 length) external pure returns (bytes32, bytes20) [selector 0x8c192089]
fn @forgedHashes(arg0: i256, arg1: i256) -> struct1 [selector=0x8c192089, pure, abi_params=[uint256, uint256], abi_returns=[word, word<bytes20>], abi_return_params=[bytes32, bytes20]] {
  bb0:
    v0 = make_calldata_slice ptr<calldata> 0, 0
    v1 = extract_value slice<calldata>, v0, 1
    v2 = inttoptr i256 arg0 to ptr<calldata>
    v3 = make_calldata_slice v2, v1
    v4 = extract_value slice<calldata>, v3, 0
    v5 = make_calldata_slice v4, arg1
    v6 = extract_value slice<calldata>, v5, 0
    v7 = extract_value slice<calldata>, v5, 1
    v8 = fmp
    calldatacopy v8, v6, v7 !metadata(memory=heap)
    v9 = make_memory_slice v8, v7
    v10 = extcall static word revert i160 2, v9
    v11 = extract_value slice<calldata>, v5, 0
    v12 = extract_value slice<calldata>, v5, 1
    v13 = fmp
    calldatacopy v13, v11, v12 !metadata(memory=heap)
    v14 = make_memory_slice v13, v12
    v15 = extcall static word revert i160 3, v14
    v16 = mul v15, 0x1000000000000000000000000
    v17 = insert_value struct1, undef struct1, 0, v10
    v18 = insert_value struct1, v17, 1, v16
    ret v18
}

; function recover(bytes32 hash, uint8 v, bytes32 r, bytes32 s) external pure returns (address) [selector 0xc2bf17b0]
fn @recover(arg0: i256, arg1: i8, arg2: i256, arg3: i256) -> i160 [selector=0xc2bf17b0, pure, abi_params=[bytes32, uint8, bytes32, bytes32], abi_returns=[word<uint160>], abi_return_params=[address]] {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v0, arg0
    v2 = add v1, 32
    v3 = zext i8 arg1 to i256
    mstore v2, v3
    v4 = add v1, 64
    mstore v4, arg2
    v5 = add v1, 96
    mstore v5, arg3
    v6 = make_memory_slice v0, 128
    v7 = extcall static word revert i160 1, v6
    v8 = trunc i256 v7 to i160
    ret v8
}
