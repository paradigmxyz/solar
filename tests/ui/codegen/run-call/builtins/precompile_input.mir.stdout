; function recover(bytes32 hash, uint8 v, bytes32 r, bytes32 s) external pure returns (address) [selector 0xc2bf17b0]
fn @recover(arg0: i256, arg1: i8, arg2: i256, arg3: i256) -> i160 [selector=0xc2bf17b0, pure, abi_params=[bytes32, uint8, bytes32, bytes32], abi_returns=[word<uint160>], abi_return_params=[address]] {
  bb0:
    v0 = fmp
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v0, arg0
    v2 = add v1, 32
    v3 = zext i8 arg1 to i256
    mstore v2, v3
    v4 = add v1, 64
    mstore v4, arg2
    v5 = add v1, 96
    mstore v5, arg3
    v6 = make_memory_slice v0, 128
    v7 = extcall static word i160 1, v6
    jumpi v7, bb2, bb1
  bb1:                                            ; preds = bb0
    revert_returndata
  bb2:                                            ; preds = bb0
    v8 = mload 0 !metadata(memory=scratch)
    v9 = trunc i256 v8 to i160
    ret v9
}
