}

; function doCreate(ic) -> addr
fn @doCreate(arg0: i256) -> i256 {
  bb0:
    v0 = mload arg0
    v1 = add arg0, 32
    v2 = create 0, v1, v0
    v3 = zext i160 v2 to i256
    mstore 32, v3 !metadata(memory=scratch)
    ret v3
}
