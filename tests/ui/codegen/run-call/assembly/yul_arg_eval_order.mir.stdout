; function deployIdiom() external returns (uint256 r) [selector 0x298d6964]
fn @deployIdiom() -> i256 [selector=0x298d6964, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = alloc 64 !metadata(preserves_fmp)
    mstore v0, 20
    v1 = ptradd v0, 32
    mstore v1, 0x600a600a5f39600a5ff3600760005260206000f3000000000000000000000000
    mstore 32, 0 !metadata(memory=scratch)
    v2 = ptrtoint ptr<memory> v0 to i256
    v3 = icall @doCreate, v2
    v4 = mload 32 !metadata(memory=scratch)
    v5 = extcodesize v4
    v6 = mul v5, v3
    v7 = eq v6, 0
    v8 = zext i1 v7 to i256
    v9 = eq v8, 0
    v10 = zext i1 v9 to i256
    ret v10
}

; function eff() -> x
fn @eff() -> i256 {
  bb0:
    mstore 0, 5 !metadata(memory=scratch)
    ret 10
}

; function w(v) -> x
fn @w(arg0: i256) -> i256 {
