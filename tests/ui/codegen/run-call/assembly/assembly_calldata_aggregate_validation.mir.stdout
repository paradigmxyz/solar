    v8 = ptrtoint ptr<calldata> v4 to i256
    v9 = add v8, v7
    v10 = calldataload v9
    v11 = gt v10, 0xffffffffffffffffffffffffffffffffffffffff
    icall revert_if<empty>, v11
    v12 = add v5, 1
