    v6 = lt v5, v3
    jumpi v6, bb2, bb3
  bb3:                                            ; preds = bb1
    v13 = abi_encode [calldata_array<word<uint160>>], scratch, args arg0
    v14 = extract_value slice<memory>, v13, 0
    v15 = extract_value slice<memory>, v13, 1
    v16 = keccak256 v14, v15
    ret v16
  bb2:                                            ; preds = bb1
