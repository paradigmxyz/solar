; === ROOT/tests/ui/codegen/run-call/assembly/assembly_low_memory_recursive_routes.sol:AssemblyLowMemoryRecursiveRoutes ===
@module AssemblyLowMemoryRecursiveRoutes
@types
  struct0: {i256, i256, i256}

; function layout(uint256 a, uint256 words) external pure returns (bytes32 h) [selector 0x3dab18c6]
fn @layout(arg0: i256, arg1: i256) -> i256 [selector=0x3dab18c6, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    v0 = calldataload 36
    v1 = shl v0, 5
    v2 = add v1, 160
    mstore v2, arg0
    v3 = sub v2, 160
    v4 = add v3, 32
    v5 = keccak256 160, v4
    ret v5
}

; function highBuffer(uint256 a, uint256 n) external pure returns (uint256 w0, uint256 w1, uint256 r) [selector 0x7cd515d1]
fn @highBuffer(arg0: i256, arg1: i256) -> struct0 [selector=0x7cd515d1, pure, abi_params=[uint256, uint256], abi_returns=[word, word, word], abi_return_params=[uint256, uint256, uint256]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v2]
    v3 = phi [bb0: 0], [bb3: v3]
    v4 = phi [bb0: 0], [bb3: v4]
    v5 = phi [bb0: 0x2080], [bb3: v9]
    v6 = lt v5, 0x2880
    v7 = zext i1 v6 to i256
    v8 = ne v7, 0
    jumpi v8, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    v10 = icall @f, v1
    v11 = mload 0x2080
    v12 = mload 0x20a0
    v13 = insert_value struct0, undef struct0, 0, v11
    v14 = insert_value struct0, v13, 1, v12
    v15 = insert_value struct0, v14, 2, v10
    ret v15
  bb4:                                            ; preds = bb1
    mstore v5, v0
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v9 = add v5, 32
    jump bb1
}

; function f(x) -> y
fn @f(arg0: i256) -> i256 {
  bb0:
    switch arg0, default bb3, [0 => bb2]
  bb2:                                            ; preds = bb0
    jump bb1
  bb3:                                            ; preds = bb0
    v0 = sub arg0, 1
    v1 = icall @f, v0
    v2 = mul v1, arg0
    jump bb1
  bb1:                                            ; preds = bb2, bb3
    v3 = phi [bb2: 1], [bb3: v2]
    ret v3
}
