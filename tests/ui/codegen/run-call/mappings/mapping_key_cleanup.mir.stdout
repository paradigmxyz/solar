fn @signedUserKey() -> i256 [selector=0x27072c8b, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sext i16 0xffff to i256
    v1 = mapping_slot v0, 2
    sstore v1, 9 !metadata(storage=symbolic(v1))
    mstore 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff !metadata(memory=scratch)
    mstore 32, 2 !metadata(memory=scratch)
    v2 = keccak256 0, 64 !metadata(memory=scratch)
    v3 = sload v2 !metadata(storage=symbolic(v2))
    ret v3
}

; function signedKey() external returns (uint value) [selector 0xa0b120fe]
fn @signedKey() -> i256 [selector=0xa0b120fe, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
