; function test_cleanup() public returns (bool) [selector 0x2b63198c]
fn @test_cleanup() -> i1 [selector=0x2b63198c, abi_params=[], abi_returns=[word<bool>], abi_return_params=[bool]] {
  bb0:
    v0 = mapping_slot 1, 0
    sstore v0, 3 !metadata(storage=symbolic(v0))
