; === ROOT/tests/ui/codegen/run-call/integers/udvt_identity_conversion.sol:UdvtIdentityConversion ===
@module UdvtIdentityConversion
; function inject(uint256 raw) internal pure returns (Small x)
fn @inject(arg0: i256) -> i256 [pure] {
  bb0:
    ret arg0
}

; function injectSigned(uint256 raw) internal pure returns (SignedSmall x)
fn @injectSigned(arg0: i256) -> i256 [pure] {
  bb0:
    ret arg0
}

; function widenSmall(Small a) internal pure returns (uint256)
fn @widenSmall(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = trunc i256 arg0 to i8
    v1 = zext i8 v0 to i256
    ret v1
}

; function widenSigned(SignedSmall a) internal pure returns (int256)
fn @widenSigned(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = trunc i256 arg0 to i8
    v1 = sext i8 v0 to i256
    ret v1
}

; function viaWiden(uint256 raw) external pure returns (uint256) [selector 0xb878f209]
fn @viaWiden(arg0: i256) -> i256 [selector=0xb878f209, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @inject, arg0
    v1 = icall @widenSmall, v0
    ret v1
}

; function viaWidenSigned(uint256 raw) external pure returns (int256) [selector 0xe025fca0]
fn @viaWidenSigned(arg0: i256) -> i256 [selector=0xe025fca0, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[int256]] {
  bb0:
    v0 = icall @injectSigned, arg0
    v1 = icall @widenSigned, v0
    ret v1
}
