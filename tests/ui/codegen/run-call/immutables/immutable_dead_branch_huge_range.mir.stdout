; constructor() payable [creation entry]
fn @constructor() [constructor, payable] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    v2 = callvalue
    v3 = gt v2, 1
    jumpi v3, bb4, bb5
  bb5:                                            ; preds = bb3
