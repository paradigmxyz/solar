    icall panic_if<0x32>, v9
    v10 = extract_value slice<calldata>, arg0, 0
    v11 = ptrtoint ptr<calldata> v10 to i256
    v12 = add v11, 32
    v13 = calldataload v12
    v14 = checked_add uint256, v6, v13
    v15 = extract_value slice<calldata>, arg0, 1
    v16 = gt v15, 2
    v17 = eq v16, false
    icall panic_if<0x32>, v17
    v18 = extract_value slice<calldata>, arg0, 0
    v19 = ptrtoint ptr<calldata> v18 to i256
    v20 = add v19, 64
    v21 = calldataload v20
    v22 = checked_add uint256, v14, v21
    ret v22
