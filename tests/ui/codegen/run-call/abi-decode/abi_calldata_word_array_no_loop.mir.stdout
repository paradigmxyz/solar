; function triple(uint256[3] calldata a) external pure returns (uint256) [selector 0x237edeb6]
fn @triple(arg0: slice<calldata>) -> i256 [selector=0x237edeb6, pure, abi_params=[array<3, uint256>], abi_returns=[word], abi_return_params=[uint256]] {
