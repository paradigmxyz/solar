; function oversized(bytes4 selector) internal returns (bool)
fn @oversized(arg0: i256) -> i1 {
  bb0:
    v0 = abi_encode_packed (bytes4 arg0, uint256 32, uint256 0xffffffffffffffff)
    v1 = address
    v2 = gas
    v3 = extcall<create> v1, v0, gas v2
    v4 = icall returndata_bytes<>
    v5 = eq v3, false
    jumpi v5, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    v6 = ptradd v4, 32
    v7 = mload v4
    v8 = keccak256 v6, v7
    v9 = eq v8, 0x8e6896d848ce77893db8ffe49ed1a378c34c94cda53b83ae7938e28a946cb069
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v10 = phi [bb1: v9], [bb2: false]
    ret v10
}
