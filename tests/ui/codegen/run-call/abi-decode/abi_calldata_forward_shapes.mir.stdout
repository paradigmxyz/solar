    v0 = calldatasize
    v1 = make_calldata_slice ptr<calldata> 0, v0
    v2 = extract_value slice<calldata>, v1, 0
    v3 = extract_value slice<calldata>, v1, 1
    v4 = calldatasize
    v5 = gt v3, 0xffffffffffffffff
    icall revert_if<invalid_calldata_tail_length>, v5
    v6 = sub v4, v3
    v7 = ptrtoint ptr<calldata> v2 to i256
    v8 = slt v6, v7
    icall revert_if<calldata_tail_too_short>, v8
    v9 = extract_value slice<calldata>, v1, 1
    v10 = add v9, 31
    v11 = and v10, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v12 = add v11, 32
    v13 = lt v12, v9
    icall panic_if<0x41>, v13
    v14 = alloc v12
    mstore v14, v9
    v15 = ptradd v14, 32
    v16 = extract_value slice<calldata>, v1, 0
    v17 = extract_value slice<calldata>, v1, 1
    calldatacopy v15, v16, v17
    v18 = ptradd v14, 32
    v19 = mload v14
    v20 = keccak256 v18, v19
    ret v20
}

