struct Item {
    address token;
    uint256 amount;
}

struct Order {
    address maker;
    Item[] offer;
    Item[] consideration;
    bytes signature;
}

// Each `sink` hashes the calldata the forwarding functions send it, so the expected hashes are
// the selector and canonical ABI encoding of the decoded values.
contract AbiCalldataForwardOrders {
    function sink(Order[] calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function sinkWith(Order[] calldata, uint256) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function sinkOne(Order calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function forward(Order[] calldata orders) external view returns (bytes32) {
        return this.sink(orders);
    }

    function forwardWith(Order[] calldata orders) external view returns (bytes32) {
        return this.sinkWith(orders, 7);
    }

    function forwardOne(Order[] calldata orders, uint256 index) external view returns (bytes32) {
        return this.sinkOne(orders[index]);
    }

    function encode(Order[] calldata orders) external pure returns (bytes32) {
        return keccak256(abi.encode(orders));
    }
}
