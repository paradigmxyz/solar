// Nested calldata tail offsets use solc's signed bound: an element offset of
// `-32` points at the array's own length word, which is a valid one-byte
// element whose payload is the first byte of the offset word. Both direct
// reads and `abi.encode` of the array must accept it, while an offset past the
// end of calldata is rejected.
pragma abicoder v2;

contract AbiCalldataBytesArrayWrappedOffset {
    function first(bytes[] calldata values) external pure returns (bytes memory) {
        return values[0];
    }

    function encode(bytes[] calldata values) external pure returns (bytes32) {
        return keccak256(abi.encode(values));
    }
}
