  bb0:
    v0 = lt arg0, 10
    icall require<short_string>, v0, 5, 0x6775617264000000000000000000000000000000000000000000000000000000
    v1 = checked_add uint256, arg0, 1
    jump bb2
  bb2:                                            ; preds = bb0
    jump bb1
  bb1:                                            ; preds = bb2
    ret v1
}

