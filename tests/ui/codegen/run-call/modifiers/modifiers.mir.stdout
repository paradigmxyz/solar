@module Modifiers
; function rec(uint256 d) internal returns (uint256)
fn @rec(arg0: i256) -> i256 {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = checked_mul uint256, v0, 100
    v2 = checked_add uint256, v1, arg0
    sstore 0, v2 !metadata(storage=slot(0))
    ret arg0
}

