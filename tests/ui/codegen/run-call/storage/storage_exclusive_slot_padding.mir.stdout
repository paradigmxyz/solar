fn @stateVariable() -> i256 [selector=0xe1967eae, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    sstore 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff !metadata(storage=slot(0))
    sstore 0, 1 !metadata(storage=slot(0))
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = shr v0, 160
    ret v1
}

