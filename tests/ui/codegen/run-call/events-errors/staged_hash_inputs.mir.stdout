fn @calldataBytes(arg0: slice<calldata>) -> i256 [selector=0x7965815f, abi_params=[bytes], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @freePointer
    v1 = extract_value slice<calldata>, arg0, 0
    v2 = extract_value slice<calldata>, arg0, 1
    v3 = fmp
    calldatacopy v3, v1, v2 !metadata(memory=heap)
    v4 = keccak256 v3, v2
    log 0, 0, 0x24ace672d0b56bb74d7b34faba262f0ca4bc2f84bc4494f66422a1c5f810d76b, v4
    v5 = icall @freePointer
    v6 = eq v5, v0
    jumpi v6, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v7 = phi [bb1: i8 1], [bb2: i8 0]
    v8 = zext i8 v7 to i256
    ret v8
}

