; === ROOT/tests/ui/codegen/run-call/constructors/constructor_multiple_base_argument_initialization_viair.sol:ConstructorArgumentInitializationA ===
@module ConstructorArgumentInitializationA
; constructor(uint256) [creation entry]
fn @constructor(arg0: i256) [constructor, abi_params=[uint256]] {
  bb0:
    sstore 0, 2 !metadata(storage=slot(0))
    ret
}

; getter for `uint256 public x` [selector 0x0c55699c]
fn @x() -> i256 [selector=0x0c55699c, view, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    ret v0
}

