; function record(uint256 value_) internal returns (uint256)
fn @record(arg0: i256) -> i256 {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = gt v0, 0xffffffffffffffff
    icall panic_if<0x41>, v1
    v2 = add v0, 1
    v3 = storage_array_data_slot 0
    v4 = add v3, v0
    sstore v4, arg0 !metadata(storage=symbolic(v4))
    sstore 0, v2 !metadata(storage=slot(0))
    ret arg0
}

