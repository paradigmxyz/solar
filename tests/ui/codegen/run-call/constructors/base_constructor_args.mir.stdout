    v2 = eq v1, false
    icall panic_if<0x32>, v2
    v3 = storage_array_data_slot 0
    v4 = sload v3 !metadata(storage=symbolic(v3))
    v5 = sload 0 !metadata(storage=slot(0))
    v6 = gt v5, 1
    v7 = eq v6, false
    icall panic_if<0x32>, v7
    v8 = storage_array_data_slot 0
    v9 = add v8, 1
    v10 = sload v9 !metadata(storage=offset(v8, 1))
    v11 = sload 0 !metadata(storage=slot(0))
    v12 = gt v11, 2
    v13 = eq v12, false
    icall panic_if<0x32>, v13
    v14 = storage_array_data_slot 0
    v15 = add v14, 2
    v16 = sload v15 !metadata(storage=offset(v14, 2))
    v17 = sload 0 !metadata(storage=slot(0))
    v18 = gt v17, 3
    v19 = eq v18, false
    icall panic_if<0x32>, v19
    v20 = storage_array_data_slot 0
    v21 = add v20, 3
    v22 = sload v21 !metadata(storage=offset(v20, 3))
    v23 = insert_value struct0, undef struct0, 0, v4
    v24 = insert_value struct0, v23, 1, v10
    v25 = insert_value struct0, v24, 2, v16
