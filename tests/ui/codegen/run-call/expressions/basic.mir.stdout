; function fill(uint256 length) external pure returns (uint256[4] memory values) [selector 0x3fda5389]
fn @fill(arg0: i256) -> ptr<memory> [selector=0x3fda5389, pure, abi_params=[uint256], abi_returns=[array<4, word>], abi_return_params=[array<4, uint256>]] {
