; function sum(uint256[] calldata values) external pure returns (uint256 result) [selector 0x0194db8e]
fn @sum(arg0: slice<calldata>) -> i256 [selector=0x0194db8e, pure, abi_params=[array<_, uint256>], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
