    v4 = extract_value slice<calldata>, v1, 1
    v5 = lt v3, v4
    jumpi v5, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v2
  bb4:                                            ; preds = bb1
    v6 = extract_value slice<calldata>, v1, 1
    v7 = lt v3, v6
    v8 = eq v7, false
    icall panic_if<0x32>, v8
    v9 = extract_value slice<calldata>, v1, 0
    v10 = mul v3, 32
    v11 = gt v3, 0x7ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    icall panic_if<0x41>, v11
    v12 = ptrtoint ptr<calldata> v9 to i256
    v13 = add v12, v10
    v14 = calldataload v13
    v15 = checked_add uint256, v2, v14
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v16 = checked_add uint256, v3, 1
    jump bb1
}

