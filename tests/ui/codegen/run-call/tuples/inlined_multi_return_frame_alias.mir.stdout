; === ROOT/tests/ui/codegen/run-call/tuples/inlined_multi_return_frame_alias.sol:Test ===
@module Test
@types
  struct0: {i256, i256}

; function run() external pure returns (uint256) [selector 0xc0406226]
fn @run() -> i256 [selector=0xc0406226, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @outer
    ret v0
}

; function outer() internal pure returns (uint256 result)
fn @outer() -> i256 [pure] {
  bb0:
    v0 = icall @pair
    v1 = extract_value struct0, v0, 0
    v2 = extract_value struct0, v0, 1
    ret v2
}

; function pair() internal pure returns (uint256 first, uint256 second)
fn @pair() -> struct0 [pure] {
  bb0:
    v0 = assign 0xabcd
    v1 = assign 0x1234
    v2 = insert_value struct0, undef struct0, 0, v0
    v3 = insert_value struct0, v2, 1, v1
    ret v3
}
