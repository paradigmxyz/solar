// The padding after a `bytes` object's last byte is not cleared when the object is an external function parameter decoded from non-canonical calldata.
// Every case below consumes the object with Solidity or with assembly that reads the padding, and
// the matching `_probe` function reads the padding word with assembly to show that it is nonzero
// at the point of consumption.
contract BytesPadding_calldata_param {
    error E(bytes data);
    event Data(bytes data);
    event Topic(bytes indexed data);

    bytes private store;

    function sink(bytes memory) external pure {}

    function echo(bytes memory) external pure returns (bytes memory) {
        return msg.data;
    }

    // Returns `n` data bytes of 0x11 followed by 0xab padding.
    function dirty(uint256 n) external pure returns (bytes memory) {
        assembly {
            let rl := and(add(n, 31), not(31))
            mstore(0x00, 0x20)
            mstore(0x20, n)
            for { let i := 0 } lt(i, rl) { i := add(i, 32) } {
                mstore(add(0x40, i), 0x4141414141414141414141414141414141414141414141414141414141414141)
            }
            mstore(add(0x40, n), 0xabababababababababababababababababababababababababababababababab)
            return(0x00, add(0x40, rl))
        }
    }

    // Reverts with `Error(string)` data of `n` string bytes followed by 0xab padding.
    function dirtyRevert(uint256 n) external pure {
        assembly {
            let rl := and(add(n, 31), not(31))
            mstore(0x00, shl(224, 0x08c379a0))
            mstore(0x04, 0x20)
            mstore(0x24, n)
            for { let i := 0 } lt(i, rl) { i := add(i, 32) } {
                mstore(add(0x44, i), 0x4141414141414141414141414141414141414141414141414141414141414141)
            }
            mstore(add(0x44, n), 0xabababababababababababababababababababababababababababababababab)
            revert(0x00, add(0x44, rl))
        }
    }

    function _stir() private pure returns (bytes32) {
        uint256 m = ~msg.data.length;
        return keccak256(abi.encode(m, m, m, m, m, m, m, m, m, m, m, m, m, m, m, m));
    }

    function _packed(uint256 n) private pure returns (bytes memory) {
        bytes memory data = new bytes(n - 1);
        for (uint256 i; i < data.length; ++i) data[i] = bytes1(uint8(0x41));
        return abi.encodePacked(uint8(0x41), data);
    }

    function _concat(uint256 n) private pure returns (bytes memory) {
        bytes memory data = new bytes(n - 1);
        for (uint256 i; i < data.length; ++i) data[i] = bytes1(uint8(0x41));
        return bytes.concat("A", data);
    }

    function _fresh(uint256 n) private pure returns (bytes memory b) {
        b = new bytes(n);
        for (uint256 i; i < n; ++i) b[i] = bytes1(uint8(0x41));
    }

    // Whether the padding bytes after the end of `b` are nonzero.
    function _dirty(bytes memory b) private pure returns (bool d) {
        assembly {
            let l := mload(b)
            let r := and(l, 31)
            if r {
                d := iszero(iszero(shl(mul(8, r), mload(add(add(b, 32), and(l, not(31)))))))
            }
        }
    }

    function ret(bytes memory b) external pure returns (bytes memory) {
        
        return b;
    }

    function ret_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function revert_custom(bytes memory b) external pure  {
        
        revert E(b);
    }

    function revert_custom_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function revert_string(bytes memory b) external pure  {
        
        revert(string(b));
    }

    function revert_string_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function encode(bytes memory b) external pure returns (bytes memory) {
        
        return abi.encode(b);
    }

    function encode_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function packed(bytes memory b) external pure returns (bytes memory) {
        
        return abi.encodePacked(b, uint8(9));
    }

    function packed_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function encode_call(bytes memory b) external view returns (bytes memory) {
        
        return abi.encodeCall(this.sink, (b));
    }

    function encode_call_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function concat(bytes memory b) external pure returns (bytes memory) {
        
        return bytes.concat(b, hex"01");
    }

    function concat_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function concat_string(bytes memory b) external pure returns (string memory) {
        
        return string.concat(string(b), "x");
    }

    function concat_string_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function to_bytes32(bytes memory b) external pure returns (bytes32) {
        
        return bytes32(b);
    }

    function to_bytes32_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function to_bytes4(bytes memory b) external pure returns (bytes4) {
        
        return bytes4(b);
    }

    function to_bytes4_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function keccak(bytes memory b) external pure returns (bytes32) {
        
        return keccak256(b);
    }

    function keccak_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function last_byte(bytes memory b) external pure returns (bytes1) {
        
        return b[b.length - 1];
    }

    function last_byte_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function push(bytes memory b) external returns (bytes memory) {
        
        store = b;
        store.push(0x01);
        return store;
    }

    function push_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function store_raw(bytes memory b) external returns (bytes32, bytes32, bytes32) {
        
        store = b;
        bytes32 s0;
        bytes32 d0;
        bytes32 d1;
        assembly {
            s0 := sload(store.slot)
            mstore(0, store.slot)
            let p := keccak256(0, 0x20)
            d0 := sload(p)
            d1 := sload(add(p, 1))
        }
        return (s0, d0, d1);
    }

    function store_raw_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function forward(bytes memory b) external view returns (bytes memory) {
        
        return this.echo(b);
    }

    function forward_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function asm_return(bytes memory b) external pure  {
        
        assembly {
            let rl := and(add(mload(b), 31), not(31))
            return(add(b, 32), rl)
        }
    }

    function asm_return_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function asm_revert(bytes memory b) external pure  {
        
        assembly {
            let rl := and(add(mload(b), 31), not(31))
            revert(add(b, 32), rl)
        }
    }

    function asm_revert_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function asm_keccak(bytes memory b) external pure returns (bytes32 h) {
        
        assembly {
            let rl := and(add(mload(b), 31), not(31))
            h := keccak256(add(b, 32), rl)
        }
    }

    function asm_keccak_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function asm_staticcall(bytes memory b) external view  {
        
        assembly {
            let rl := and(add(mload(b), 31), not(31))
            let out := mload(0x40)
            pop(staticcall(gas(), 4, add(b, 32), rl, out, rl))
            return(out, rl)
        }
    }

    function asm_staticcall_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function asm_call(bytes memory b) external  {
        
        assembly {
            let rl := and(add(mload(b), 31), not(31))
            let out := mload(0x40)
            pop(call(gas(), 4, 0, add(b, 32), rl, out, rl))
            return(out, rl)
        }
    }

    function asm_call_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }

    function asm_mcopy(bytes memory b) external pure  {
        
        assembly {
            let rl := and(add(mload(b), 31), not(31))
            let out := mload(0x40)
            mcopy(out, add(b, 32), rl)
            return(out, rl)
        }
    }

    function asm_mcopy_probe(bytes memory b) external pure returns (bool d) {
        
        d = _dirty(b);
    }
}
