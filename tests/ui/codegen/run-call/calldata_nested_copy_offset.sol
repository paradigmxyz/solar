// A nested offset of `-0x20` wraps `base + offset` back onto earlier calldata. Element access,
// `abi.encode` and copies to storage accept it, like solc's lazy `access_calldata_tail` and
// encoder. Copying the value to memory decodes it with solc's ABI decoder, which rejects every
// nested offset above `2**64 - 1`, so the copy reverts, whichever way the memory value is made:
// a local, an assignment, a returned value, a struct or array literal, a fixed array of dynamic
// arrays, or a struct nested in a struct. The last ten calls copy a canonical encoding.
pragma abicoder v2;

contract CalldataNestedCopyOffset {
    struct S {
        uint256 x;
        string s;
    }

    uint256[][] ints;
    bytes[] bytesArray;
    string[] strings;
    S strukt;

    struct W {
        uint256[][] v;
    }

    struct N {
        uint256 x;
        S s;
    }

    function copy_uint(uint256[][] calldata a) external pure returns (uint256) {
        uint256[][] memory x = a;
        return x[1].length * 1000 + x[1][0];
    }

    function access_uint(uint256[][] calldata a) external pure returns (uint256) {
        return a[1].length * 1000 + a[1][0];
    }

    function encode_uint(uint256[][] calldata a) external pure returns (bytes32) {
        return keccak256(abi.encode(a));
    }

    function store_uint(uint256[][] calldata a) external returns (uint256) {
        ints = a;
        return ints[1].length * 1000 + ints[1][0];
    }

    function copy_bytes(bytes[] calldata a) external pure returns (uint256) {
        bytes[] memory x = a;
        return x[1].length;
    }

    function access_bytes(bytes[] calldata a) external pure returns (uint256) {
        return a[1].length;
    }

    function encode_bytes(bytes[] calldata a) external pure returns (bytes32) {
        return keccak256(abi.encode(a));
    }

    function store_bytes(bytes[] calldata a) external returns (uint256) {
        bytesArray = a;
        return bytesArray[1].length;
    }

    function copy_string(string[] calldata a) external pure returns (uint256) {
        string[] memory x = a;
        return bytes(x[1]).length;
    }

    function access_string(string[] calldata a) external pure returns (uint256) {
        return bytes(a[1]).length;
    }

    function encode_string(string[] calldata a) external pure returns (bytes32) {
        return keccak256(abi.encode(a));
    }

    function store_string(string[] calldata a) external returns (uint256) {
        strings = a;
        return bytes(strings[1]).length;
    }

    function copy_struct(S calldata a) external pure returns (uint256) {
        S memory x = a;
        return bytes(x.s).length;
    }

    function access_struct(S calldata a) external pure returns (uint256) {
        return bytes(a.s).length;
    }

    function encode_struct(S calldata a) external pure returns (bytes32) {
        return keccak256(abi.encode(a));
    }

    function store_struct(S calldata a) external returns (uint256) {
        strukt = a;
        return bytes(strukt.s).length;
    }

    function pass(uint256[][] calldata a) internal pure returns (uint256[][] memory) {
        return a;
    }

    function return_uint(uint256[][] calldata a) external pure returns (uint256) {
        uint256[][] memory x = pass(a);
        return x[1].length * 1000 + x[1][0];
    }

    function assign_uint(uint256[][] calldata a) external pure returns (uint256) {
        uint256[][] memory x;
        x = a;
        return x[1].length * 1000 + x[1][0];
    }

    function ctor_uint(uint256[][] calldata a) external pure returns (uint256) {
        W memory w = W(a);
        return w.v[1].length * 1000 + w.v[1][0];
    }

    function literal_uint(uint256[][] calldata a) external pure returns (uint256) {
        uint256[][][2] memory m = [a, a];
        return m[1][1].length * 1000 + m[1][1][0];
    }

    function fixed_uint(uint256[][2] calldata a) external pure returns (uint256) {
        uint256[][2] memory x = a;
        return x[1].length * 1000 + x[1][0];
    }

    function nested_struct(N calldata a) external pure returns (uint256) {
        N memory x = a;
        return bytes(x.s.s).length;
    }
}
