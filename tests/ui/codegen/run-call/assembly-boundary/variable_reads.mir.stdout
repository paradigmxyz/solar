; function loop() external pure returns (uint256 seen) [selector 0xa92100cb]
fn @loop() -> i256 [selector=0xa92100cb, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
