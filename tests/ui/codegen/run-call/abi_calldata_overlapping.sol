pragma abicoder v2;

contract AbiCalldataOverlapping {
    function memoryRead(uint256[][] calldata values) external pure returns (uint256) {
        uint256[][] memory copied = values;
        return copied[0][0] + copied[1][1];
    }

    function encodeLength(uint256[][] calldata values) external pure returns (uint256) {
        return abi.encode(values).length;
    }
}

