pragma abicoder v2;

contract CalldataStructBytesValidation {
    struct Value {
        bytes data;
        uint256 tag;
    }

    function copy(Value calldata value) external pure returns (uint256) {
        Value memory copyValue = value;
        return copyValue.data.length + copyValue.tag;
    }

    function copyField(Value calldata value) external pure returns (uint256) {
        bytes memory data = value.data;
        return data.length;
    }

    function copyArray(bytes[] calldata values) external pure returns (uint256) {
        bytes[] memory copyValues = values;
        return copyValues[0].length;
    }
}
