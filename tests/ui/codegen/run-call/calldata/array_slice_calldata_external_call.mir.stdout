; === ROOT/tests/ui/codegen/run-call/calldata/array_slice_calldata_external_call.sol:ArraySliceCalldataExternalCall ===
@module ArraySliceCalldataExternalCall
; function sink(uint256[] calldata values) external pure returns (uint256) [selector 0xe55582b7]
fn @sink(arg0: slice<calldata>) -> i256 [selector=0xe55582b7, pure, abi_params=[array<_, uint256>], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 1
    ret v0
}

; function forward(uint256[] calldata values, uint256 start, uint256 end) external view returns (uint256) [selector 0x4b1f0a4b]
fn @forward(arg0: slice<calldata>, arg1: i256, arg2: i256) -> i256 [selector=0x4b1f0a4b, view, abi_params=[array<_, uint256>, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = address
    v1 = gas
    v2 = extract_value slice<calldata>, arg0, 0
    v3 = extract_value slice<calldata>, arg0, 1
    v4 = lt v3, arg2
    v5 = lt arg2, arg1
    v6 = or v4, v5
    v7 = zext i1 v6 to i256
    icall revert_if<empty>, v6
    v8 = sub arg2, arg1
    v9 = mul arg1, 32
    v10 = ptradd v2, v9
    v11 = make_calldata_slice v10, v8
    v12 = extract_value slice<calldata>, v11, 1
    v13 = mul v12, 32
    v14 = gt v12, 0x7ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    icall panic_if<0x41>, v14
    v15 = abi_encode [calldata_array<word>], scratch, selector 0xe55582b700000000000000000000000000000000000000000000000000000000, args v11
    v16 = extract_value slice<memory>, v15, 0
    v17 = extract_value slice<memory>, v15, 1
    v18 = zext i160 v0 to i256
    v19 = staticcall v1, v18, v16, v17, 0, 32
    jumpi v19, bb2, bb1
  bb1:                                            ; preds = bb0
    revert_returndata
  bb2:                                            ; preds = bb0
    v20 = returndatasize
    v21 = lt v20, 32
    icall revert_if<tuple_data_too_short>, v21
    v22 = mload 0 !metadata(memory=scratch)
    ret v22
}
