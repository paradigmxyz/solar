// A storage copy reads nested calldata in place and checks each range as it goes, so a length word
// that no memory array could hold reverts with empty data, as in solc, rather than panicking.
contract C {
    uint256[][] arrays;
    bytes[] strings;

    function nestedArray(uint256[][] calldata s) external {
        arrays = s;
    }

    function nestedBytes(bytes[] calldata s) external {
        strings = s;
    }
}
