// A returned calldata array of narrow words encodes straight from calldata in one loop that reads,
// validates, and writes each word at its own address, as solc does: a word that is not canonical
// for its type reverts with empty data, even when assembly forged the array, a forged range that
// wraps past the end of the address space copies the wrapped words, and an unused parameter is
// not validated.

contract CalldataNarrowArrayReturn {
    enum Kind {
        A,
        B,
        C
    }

    event Emitted(address[] values);

    function words(uint8[] calldata a) external pure returns (uint8[] calldata) {
        return a;
    }

    function bools(bool[] calldata a) external pure returns (bool[] calldata) {
        return a;
    }

    function addresses(address[] calldata a) external pure returns (address[] calldata) {
        return a;
    }

    function kinds(Kind[] calldata a) external pure returns (Kind[] calldata) {
        return a;
    }

    function signed(int8[] calldata a) external pure returns (int8[] calldata) {
        return a;
    }

    function fixedBytes(bytes4[] calldata a) external pure returns (bytes4[] calldata) {
        return a;
    }

    function tail(uint8[] calldata a) external pure returns (uint8[] calldata) {
        return a[1:];
    }

    function mixed(uint8[] calldata a, uint8 x) external pure returns (uint8, uint8[] calldata) {
        return (x, a);
    }

    function encode(uint8[] calldata a) external pure returns (bytes memory) {
        return abi.encode(a);
    }

    function emitAddresses(address[] calldata a) external {
        emit Emitted(a);
    }

    function unused(uint8[] calldata) external pure returns (uint256) {
        return 1;
    }

    function forged(uint256 offset, uint256 length) external pure returns (uint8[] calldata p) {
        assembly {
            p.offset := offset
            p.length := length
        }
    }

    function forgedWrap(uint256 marker, uint256 offset, uint256 length) external pure returns (uint8[] calldata p) {
        assembly {
            p.offset := offset
            p.length := length
        }
    }
}
