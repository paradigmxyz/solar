; function stopIfZero(uint256 x) internal pure returns (uint256)
fn @stopIfZero(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    v1 = zext i1 v0 to i256
    v2 = ne v1, 0
    jumpi v2, bb1, bb2
