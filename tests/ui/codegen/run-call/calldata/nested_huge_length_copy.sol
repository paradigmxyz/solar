// A length word in calldata that no array or byte string of that size can fit panics on the
// allocation before the calldata range check, as in solc. Nested lengths are read while the copy
// walks the outer value.
contract C {
    struct T {
        uint256[] a;
    }

    struct U {
        uint256[] a;
        uint256 b;
    }

    function arrArr(uint256[][] calldata s) external pure returns (uint256[][] memory) {
        return s;
    }

    function structArr(T[] calldata s) external pure returns (T[] memory) {
        return s;
    }

    // The head of the struct is cut short, so its check comes before the array member's allocation.
    function truncatedStruct(U calldata s) external pure returns (U memory) {
        return s;
    }

    function structOne(T calldata s) external pure returns (T memory) {
        return s;
    }

    function bytesArr(bytes[] calldata s) external pure returns (bytes[] memory) {
        return s;
    }

    function bytesOne(bytes[1] calldata s) external pure returns (bytes[1] memory) {
        return s;
    }
}
