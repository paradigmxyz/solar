// With debug revert strings, a returned calldata aggregate reverts with the messages of solc's
// calldata re-encoding, not those of the ABI decoder.

contract CalldataReturnDirectEncode {
    struct S {
        uint256 value;
        bytes tail;
    }

    struct Narrow {
        uint8 a;
        bool b;
        address c;
    }

    struct Inner {
        uint16 x;
        bytes y;
    }

    struct Outer {
        Narrow n;
        Inner i;
        uint256 z;
    }

    struct Pair {
        uint256 a;
        uint256 b;
    }

    event Emitted(Narrow n);

    function dynamic(S calldata s) external pure returns (S calldata) {
        return s;
    }

    function narrow(Narrow calldata n) external pure returns (Narrow calldata) {
        return n;
    }

    function nested(Outer calldata o) external pure returns (Outer calldata) {
        return o;
    }

    function words(uint256[2] calldata a) external pure returns (uint256[2] calldata) {
        return a;
    }

    function narrowWords(uint8[2] calldata a) external pure returns (uint8[2] calldata) {
        return a;
    }

    function bytesPair(bytes[2] calldata a) external pure returns (bytes[2] calldata) {
        return a;
    }

    function dynamicItems(S[] calldata a) external pure returns (S[] calldata) {
        return a;
    }

    function narrowItems(Narrow[] calldata a) external pure returns (Narrow[] calldata) {
        return a;
    }

    function mixed(uint256 x, S calldata s, uint256[2] calldata a)
        external
        pure
        returns (uint256, S calldata, uint256[2] calldata)
    {
        return (x, s, a);
    }

    function emitNarrow(Narrow calldata n) external {
        emit Emitted(n);
    }

    function forgedItems(uint256 offset, uint256 length) external pure returns (Pair[] calldata p) {
        assembly {
            p.offset := offset
            p.length := length
        }
    }

    function wrapWords(uint256 p) external pure returns (uint256[2] calldata a) {
        assembly {
            a := p
        }
    }

    function wrapStruct(uint256 p) external pure returns (Pair calldata s) {
        assembly {
            s := p
        }
    }
}
