contract C {
    bytes stored;
    bytes[] pushed;
    string text;

    function store(bytes[] calldata a) external returns (uint256) {
        stored = a[0];
        return stored.length;
    }

    function push(bytes[] calldata a) external returns (uint256) {
        pushed.push(a[0]);
        return pushed.length;
    }

    function sstr(string[] calldata a) external returns (uint256) {
        text = a[0];
        return bytes(text).length;
    }

    function req(string[] calldata a) external pure {
        require(false, a[0]);
    }

    function rev(string[] calldata a) external pure {
        revert(a[0]);
    }
}
