fn @checkField(arg0: slice<calldata>) [pure] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = ptrtoint ptr<calldata> v0 to i256
    v2 = add v1, 0
    v3 = calldataload v2
    v4 = shl v3, 192
