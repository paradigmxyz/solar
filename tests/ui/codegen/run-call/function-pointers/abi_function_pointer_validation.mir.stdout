; function h(S calldata s) external pure returns (uint r) [selector 0x4fc262ac]
fn @h(arg0: slice<calldata>) -> i256 [selector=0x4fc262ac, pure, abi_params=[tuple<function>], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = ptrtoint ptr<calldata> v0 to i256
    v2 = add v1, 0
    v3 = calldataload v2
    v4 = shl v3, 192
    v5 = ne v4, 0
    icall revert_if<empty>, v5
    v6 = shr v3, 64
