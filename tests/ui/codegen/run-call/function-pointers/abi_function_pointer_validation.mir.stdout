}

; function g(S calldata) external pure returns (uint r) [selector 0x5cf6281d]
fn @g(arg0: slice<calldata>) -> i256 [selector=0x5cf6281d, pure, abi_params=[tuple<function>], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
