; function reduce( uint256[] memory array, function(uint256, uint256) internal returns (uint256) callback, uint256 init ) internal returns (uint256)
fn @reduce(arg0: ptr<memory>, arg1: i256, arg2: i256) -> i256 {
  bb0:
    v0 = assign 0
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v1 = phi [bb0: arg0], [bb3: v1]
    v2 = phi [bb0: arg1], [bb3: v2]
    v3 = phi [bb0: arg2], [bb3: v15]
    v4 = phi [bb0: 0], [bb3: v4]
