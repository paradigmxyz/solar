//@ revisions: report check
//@ compile-flags: -Zevm-ir-pipeline=peephole
//@[report] compile-flags: -Zdebugify=report
//@[check] compile-flags: -Zdebugify=check
//~[check]? ERROR: debugify: EVM IR pass `peephole` left 1 instruction without a location
// Folding the `add` leaves a `push` that carries the function event but no origin. LLVM's
// `not-generate` check reports it, and `check` rejects it.
@module GapCheck
bb0:
  push 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe !metadata(invoke=f@10..30)
  push 1
  add !metadata(span=10..20)
  stop
