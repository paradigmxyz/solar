//@ compile-flags: -Zevm-ir-pipeline=outline
//@ filecheck:
@module DebugInfo

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push [[RET0:bb[0-9]+]]
// CHECK: + jump [[OUTLINE:bb[0-9]+]]
// CHECK: {{^[ +].*}}bb1:
// CHECK: + push [[RET1:bb[0-9]+]]
// CHECK: + jump [[OUTLINE]]
// CHECK: + [[OUTLINE]]:
// CHECK: {{^[ +].*}}push 1 !metadata(span=1..5)
// CHECK: + jump
bb0:
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  jump bb1 !metadata(span=11..15)

bb1:
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  stop !metadata(span=31..35)
