//@ compile-flags: -Zevm-ir-pipeline=outline --optimize-runs 1
//@ filecheck:
@module SharedBodyGather

// A position whose origins all hold on every site keeps that, since the merge of identical
// locations is that location. Sites that differ merge into alternatives.
// CHECK: + [[STUB:bb[0-9]+]] {{\[ret=.*\]}}:
// CHECK: {{^[ +].*}}push 1 !metadata(all=[1..5, 6..10]){{$}}
// CHECK: {{^[ +].*}}pop !metadata(spans=[11..15, 16..20, 21..25, 26..30]){{$}}
bb0:
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[11..15, 16..20])
  jump bb1 !metadata(span=31..35)

bb1:
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  push 1 !metadata(all=[1..5, 6..10])
  pop !metadata(all=[21..25, 26..30])
  stop !metadata(span=36..40)
