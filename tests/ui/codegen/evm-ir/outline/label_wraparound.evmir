//@ compile-flags: -Ogas -Zevm-ir-pipeline=outline --optimize-runs 1
//@ filecheck:
@module LabelWraparound

// Synthetic labels use unoccupied values when the largest source label is u32::MAX.
// CHECK-LABEL: {{^[ +].*}}bb4294967295:
// CHECK: + push bb{{[0-9]+}}
// CHECK: + jump bb0
// CHECK: + bb0 {{\[ret=.*\]}}:
bb4294967295:
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
  pop
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
  pop
  stop
