//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=outline
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=outline
@module BatchDisjoint

// Two effectful computations have separate occurrences in each source block.
// The relocatable push separates the candidate windows. Splitting both sites
// must preserve the first continuation's route to the second shared body.
bb0:
  push 7
  push 0
  mstore
  push 0
  mload
  push 1
  add
  push 0
  mstore
  push 0
  mload
  push 32
  mstore
  msize
  pop
  push bb3
  pop
  push 42
  push 64
  mstore
  push 64
  mload
  push 2
  add
  push 64
  mstore
  push 64
  mload
  push 96
  mstore
  msize
  pop
  jump bb1
bb1:
  push 7
  push 0
  mstore
  push 0
  mload
  push 1
  add
  push 0
  mstore
  push 0
  mload
  push 32
  mstore
  msize
  pop
  push bb3
  pop
  push 42
  push 64
  mstore
  push 64
  mload
  push 2
  add
  push 64
  mstore
  push 64
  mload
  push 96
  mstore
  msize
  pop
  jump bb2
bb2:
  push 7
  push 0
  mstore
  push 0
  mload
  push 1
  add
  push 0
  mstore
  push 0
  mload
  push 32
  mstore
  msize
  pop
  push bb3
  pop
  push 42
  push 64
  mstore
  push 64
  mload
  push 2
  add
  push 64
  mstore
  push 64
  mload
  push 96
  mstore
  msize
  pop
  stop
bb3:
