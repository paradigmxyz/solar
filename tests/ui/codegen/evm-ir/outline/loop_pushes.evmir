//@ revisions: gas size once
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=outline
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=outline
//@[once] compile-flags: -Osize --optimize-runs 1 -Zevm-ir-pipeline=outline
//@[gas] filecheck: --check-prefix=GAS
//@[size] filecheck: --check-prefix=SIZE
//@[once] filecheck: --check-prefix=ONCE
@module LoopPushes

// A loop adds a 32-byte constant on every iteration, and the code after it pushes the constant
// three more times. Size mode shares the constant between the three pushes outside the loop, but
// the loop keeps its own: sharing it adds two jumps to every iteration, more gas over the 200
// expected executions than the deposit of the 25 bytes it saves. With one expected execution the
// bytes win and the loop shares the constant too. Gas mode shares nothing here.
// GAS-LABEL: {{^[ +].*}}bb1 [loop]:
// GAS-NEXT: {{^[ +].*}}push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
// SIZE-LABEL: {{^[ +].*}}bb1 [loop]:
// SIZE-NEXT: {{^[ +].*}}push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
// ONCE-LABEL: {{^[ +].*}}bb1 [loop]:
// ONCE-NEXT: + push [[RETURN:bb[0-9]+]]
// ONCE-NEXT: + jump [[STUB:bb[0-9]+]]
bb0:
  push 0
  calldataload
  jump bb1

bb1 [loop]:
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
  add
  dup 1
  push bb1
  jumpi
  jump bb2

// GAS-LABEL: {{^[ +].*}}bb2:
// GAS-NEXT: {{^[ +].*}}push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
// SIZE-LABEL: {{^[ +].*}}bb2:
// SIZE-NEXT: + push [[RETURN:bb[0-9]+]]
// SIZE-NEXT: + jump [[STUB:bb[0-9]+]]
// ONCE-LABEL: {{^[ +].*}}bb2:
// ONCE-NEXT: + push [[RETURN2:bb[0-9]+]]
// ONCE-NEXT: + jump [[STUB]]
bb2:
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
  or
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
  xor
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95
  and
  push 0
  mstore
  push 32
  push 0
  return
