//@compile-flags: -Ogas -Zevm-ir-pipeline=outline --optimize-runs 1
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push [[RET0:bb[0-9]+]]
// CHECK: + jump [[OUTLINE:bb[0-9]+]]
// CHECK: + [[OUTLINE]]:
// CHECK: {{^[ +].*}}push 0x123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef1
// CHECK: + swap 1
// CHECK: + jump
// CHECK: + [[RET1:bb[0-9]+]] [continuation]:
// CHECK: {{^[ +].*}}pop
// CHECK: {{^[ +].*}}stop
// CHECK: + [[RET0]] [continuation]:
// CHECK: + push [[RET1]]
// CHECK: + jump [[OUTLINE]]
bb0:
  push 0x123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef1
  pop
  push 0x123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef1
  pop
  stop
