//@ compile-flags: -Zevm-ir-pipeline=outline --optimize-runs 1
//@ filecheck:
@module SharedBodyOrigins

// The shared body runs for one of its sites, so each instruction takes the merged locations of the
// sites' instructions at its position, and the stub's return jump the merged call-site locations.
// A position every site agrees on keeps its single span.
// CHECK: + [[STUB:bb[0-9]+]] {{\[ret=.*\]}}:
// CHECK: {{^[ +].*}}push 1 !metadata(span=1..5){{$}}
// CHECK: {{^[ +].*}}pop !metadata(spans=[6..10, 26..30]){{$}}
// CHECK: + jump !metadata(span=1..5){{$}}
bb0:
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  jump bb1 !metadata(span=11..15)

bb1:
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  push 1 !metadata(span=1..5)
  pop !metadata(span=26..30)
  stop !metadata(span=31..35)
