//@ compile-flags: -Ogas -Zevm-ir-pipeline=outline
@module ShortExpensiveRuns

bb0:
  push 0
  calldataload
  indexed_jump bb1, bb2, bb3, bb4

// Three instructions can occupy more bytes than a much longer arithmetic sequence.
bb1:
  push 0x123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
  push 128
  mstore
  push 1
  stop
bb2:
  push 0x123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
  push 128
  mstore
  push 2
  stop

// Large pushes with a duplicated output also pay for every return shuffle.
bb3:
  push 0x23456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef01
  push 0x3456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012
  dup 1
  push 3
  stop
bb4:
  push 0x23456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef01
  push 0x3456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012
  dup 1
  push 4
  stop
