//@compile-flags: -Zevm-ir-pipeline=outline
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push [[RET0:bb[0-9]+]]
// CHECK: + jump [[OUTLINE:bb[0-9]+]]
// CHECK: {{^[ +].*}}bb1:
// CHECK: + push [[RET1:bb[0-9]+]]
// CHECK: + jump [[OUTLINE]]
// CHECK: + [[OUTLINE]]:
// CHECK-COUNT-12: {{^[ +].*}}push 1
// CHECK: + jump
// CHECK: + [[RET0]]:
// CHECK: + jump bb1
// CHECK: + [[RET1]]:
// CHECK: {{^[ +].*}}stop
bb0:
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  jump bb1
bb1:
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  push 1
  pop
  stop

// Zero immediates assemble as PUSH0. Their apparent two-byte EVM IR encoding must not make an
// otherwise unprofitable repeated run eligible for outlining.
bb4294967291:
  push 0
  pop
  push 0
  pop
  push 0
  pop
  push 0
  pop
  stop
bb4294967292:
  push 0
  pop
  push 0
  pop
  push 0
  pop
  push 0
  pop
  stop
bb4294967293:
  push 0
  pop
  push 0
  pop
  push 0
  pop
  push 0
  pop
  stop
bb4294967294:
  push 0
  pop
  push 0
  pop
  push 0
  pop
  push 0
  pop
  stop
bb4294967295:
  push 0
  pop
  push 0
  pop
  push 0
  pop
  push 0
  pop
  stop
