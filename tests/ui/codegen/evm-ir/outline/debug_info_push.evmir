//@ compile-flags: -Zevm-ir-pipeline=outline --optimize-runs 1
//@ filecheck:
@module DebugInfoPush

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + jump [[STUB:bb[0-9]+]] !metadata(invoke=first@1..10)
// CHECK: + [[STUB]] {{\[ret=.*\]}}:
// CHECK: {{^[ +].*}}push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95 !metadata(spans=[1..5, 11..15])
// CHECK: + [[SECOND:bb[0-9]+]] [continuation]:
// CHECK: + jump [[STUB]] !metadata(invoke=second@11..20)
bb0:
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95 !metadata(span=1..5, invoke=first@1..10)
  pop !metadata(span=6..10)
  push 0x9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95 !metadata(span=11..15, invoke=second@11..20)
  pop !metadata(span=16..20)
  stop !metadata(span=21..25)
