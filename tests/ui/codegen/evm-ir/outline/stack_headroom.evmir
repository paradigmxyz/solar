//@ compile-flags: -Osize -Zevm-ir-pipeline=outline
//@ filecheck:
@module StackHeadroom

// A physical jump carries 1,023 hidden words into the repeated runs. Outlining
// either run would overflow when it pushes the continuation and stub words.
// CHECK-NOT: +   jump
bb0:
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  push 0
  push 0
  push 0
  push bb1
  jump
bb1:
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  op_0d !meta(stack=0->0)
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  not
  stop
