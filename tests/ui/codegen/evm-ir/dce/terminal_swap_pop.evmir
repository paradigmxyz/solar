//@compile-flags: -Zevm-ir-pipeline=dce
//@filecheck:
@module TerminalSwapPop

bb0:
  push 11
  push 22
  push bb1
  jump

// The top incoming word is unchanged; the deeper discarded word is unobserved.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: -   pop
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}sstore
bb1:
  swap 1
  pop
  push 0
  sstore
  stop

// Keeping the discarded word would overflow when the address is pushed.
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^    }}swap 1
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}push 0
bb2:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->4)
  swap 1
  pop
  push 0
  sstore
  stop

// DUP2 observes the lower incoming word and prevents pair removal.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^    }}swap 1
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}dup 2
bb3:
  callf !meta(stack=0->3)
  swap 1
  pop
  dup 2
  push 0
  sstore
  stop

// GAS, PC and unknown effects bound the terminal suffix proof.
// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^    }}swap 1
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}gas
bb4:
  callf !meta(stack=0->2)
  swap 1
  pop
  gas
  push 0
  sstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^    }}swap 1
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}pc
bb5:
  callf !meta(stack=0->2)
  swap 1
  pop
  pc
  push 0
  sstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^    }}swap 1
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}op_0c
bb6:
  callf !meta(stack=0->2)
  swap 1
  pop
  op_0c !meta(stack=0->0)
  push 0
  sstore
  stop
