//@ compile-flags: -Ogas -Zevm-ir-pipeline=dce
//@ filecheck:
@module CodeRelativeTerminals

bb0:
  push 99
  calldatasize
  jumpi bb1, bb2
// CODESIZE observes the bytes removed by local terminal POP cleanup.
// CHECK-LABEL: bb1:
// CHECK-NEXT: {{^    }}pop
bb1:
  pop
  codesize
  push 0
  mstore
  stop
bb2:
  calldatasize
  jumpi bb3, bb4
// CODECOPY observes the bytes removed by local terminal POP cleanup.
// CHECK-LABEL: bb3:
// CHECK-NEXT: {{^    }}pop
bb3:
  pop
  push 32
  push 0
  push 0
  codecopy
  push 32
  push 0
  return
bb4:
  calldatasize
  jumpi bb5, bb7
// The same CODESIZE barrier applies to POP-only predecessor edges.
// CHECK-LABEL: bb5:
// CHECK-NEXT: {{^    }}pop
bb5:
  pop
  jump bb6
bb6:
  codesize
  push 0
  mstore
  stop
// The same CODECOPY barrier applies to POP-only predecessor edges.
// CHECK-LABEL: bb7:
// CHECK-NEXT: {{^    }}pop
bb7:
  pop
  jump bb8
bb8:
  push 32
  push 0
  push 0
  codecopy
  push 32
  push 0
  return
