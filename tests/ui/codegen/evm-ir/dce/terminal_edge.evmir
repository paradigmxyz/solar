//@compile-flags: -Zevm-ir-pipeline=dce
//@filecheck:
@module TerminalEdge

bb0:
  callvalue
  jumpi bb8, bb9
bb9:
  callvalue
  jumpi bb7, bb5
bb7:
  push 11
  push 22
  callvalue
  jumpi bb1, bb3

// Both words are unobserved by the self-contained revert body.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK-NEXT: -   pop
// CHECK-NEXT: -   pop
// CHECK-NEXT: {{^[ +].*}}jump bb2
bb1:
  pop
  pop
  jump bb2
bb2:
  push 0
  push 0
  revert

// The successor consumes an incoming word, so preserve the cleanup.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^    }}pop
// CHECK-NEXT: {{^    }}jump bb4
bb3:
  pop
  jump bb4
bb4:
  push 0
  sstore
  stop

// This branch reaches cleanup at 1024 words; deleting its POPs would overflow.
bb5:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->4)
  jump bb6
// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}jump bb2
bb6:
  pop
  pop
  jump bb2

// Even an empty STOP successor needs one word for the explicit jump label.
bb8:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->4)
  jump bb10
// CHECK-LABEL: {{^[ +].*}}bb10:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}jump bb11
bb10:
  pop
  jump bb11
bb11:
  stop
