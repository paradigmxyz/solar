//@compile-flags: -Zevm-ir-pipeline=default
//@filecheck:
@module PostEliminationPeephole

// Removing the dead saved address exposes `EQ ISZERO JUMPI`, which the
// conditional cleanup after DCE must reduce to `SUB JUMPI`.
// CHECK-LABEL: bb0:
// CHECK: sub
// CHECK-NEXT: push bb1
// CHECK-NEXT: jumpi
bb0:
  push 320
  dup 1
  push 256
  mstore
  dup 1
  mload
  push 1
  dup 2
  and
  eq
  swap 1
  pop
  iszero
  push bb1
  jumpi
  stop
bb1:
  stop
