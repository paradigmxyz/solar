//@ compile-flags: -Zevm-ir-pipeline=dce
//@ filecheck:
@module DeadStackTail

// The target pushes its RETURN operands, so it never reads the incoming stack.
// CHECK-LABEL: bb0:
// CHECK-NOT: {{^[ +].*}}push
// CHECK-NOT: {{^[ +].*}}add
// CHECK-NOT: {{^[ +].*}}pop
// CHECK: {{^[ +].*}}jump bb1
bb0:
  push 1
  push 2
  add
  pop
  jump bb1
bb1:
  push 0
  push 0
  return

// A target that consumes its entry value must retain the predecessor tail.
// CHECK-LABEL: bb2:
// CHECK: {{^[ +].*}}push 7
// CHECK: {{^[ +].*}}jump bb3
bb2:
  push 7
  jump bb3
bb3:
  push 0
  revert

// Reads of the call's context have no effect besides their gas, so unused ones
// before a halt go too.
// CHECK-LABEL: bb4:
// CHECK-NOT: {{^[ +].*}}calldatasize
// CHECK-NOT: {{^[ +].*}}caller
// CHECK-NOT: {{^[ +].*}}callvalue
// CHECK: {{^[ +].*}}revert
bb4:
  calldatasize
  caller
  callvalue
  pop
  push 0
  push 0
  revert

// An account read warms the account and a memory read expands memory, so both
// stay.
// CHECK-LABEL: bb5:
// CHECK: {{^[ +].*}}balance
// CHECK: {{^[ +].*}}mload
// CHECK: {{^[ +].*}}revert
bb5:
  push 5
  balance
  push 0
  mload
  push 0
  push 0
  revert
