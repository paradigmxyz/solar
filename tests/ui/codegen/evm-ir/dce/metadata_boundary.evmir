//@ compile-flags: -Zevm-ir-pipeline=dce
//@ filecheck:
@module MetadataBoundary

// An unknown instruction's declared stack effect is an analysis boundary, not a physical
// stack model.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}op_0c !metadata(stack=1->1)
// CHECK-NEXT: -   pop
// CHECK-NEXT: {{^[ +].*}}stop
bb0:
  push 1
  op_0c !metadata(stack=1->1)
  pop
  stop

// Copy elimination does not walk through an unknown instruction.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}op_0c !metadata(stack=0->0)
// CHECK-NEXT: {{^[ +].*}}pop
bb1:
  push 2
  push 1
  dup1
  op_0c !metadata(stack=0->0)
  pop
  sstore
  stop
