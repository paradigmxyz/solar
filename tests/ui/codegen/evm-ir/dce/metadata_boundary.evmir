//@ compile-flags: -Zevm-ir-pipeline=dce
//@ filecheck:
@module MetadataBoundary

// A non-canonical stack override is an analysis boundary, not a physical stack model.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}op_0c !meta(stack=1->1)
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}stop
bb0:
  push 1
  op_0c !meta(stack=1->1)
  pop
  stop
