//@ compile-flags: --evm-version byzantium -Zevm-ir-pipeline=default -Zprint-after-stage
//@ filecheck:
@module StageCheckpoints

// CHECK: stage=input checkpoint=evm.scheduled-input
// CHECK: shl
// CHECK: stage=pipeline checkpoint=evm.target-legal
// CHECK-NOT: shl
// CHECK: exp
// CHECK: pop
// CHECK: stage=pipeline checkpoint=evm.final
// CHECK-NOT: pop
// CHECK: exp
// CHECK: stop
bb0:
  push 7
  push 1
  shl
  pop
  push 1
  pop
  stop
