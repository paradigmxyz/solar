//@ compile-flags: -Onone -Zevm-ir-pipeline=merge-fallthrough-thunks -Zdump=disasm-runtime
//@ filecheck:

// CHECK-LABEL: // === AdjacentLabels (runtime) ===
@module AdjacentLabels

bb0:
  push 0
  calldataload
  jumpi bb2, bb1

// bb2 and bb3 only jump to bb4, which follows bb3. Removing bb3 puts bb2 right before bb4, so
// both thunks go and the three edges jump straight to the join.
bb1:
  push 1
  calldataload
  jumpi bb3, bb5
bb2:
  jump bb4
bb3:
  jump bb4

// CHECK: {{^; bb0}}
// CHECK-NEXT: JUMPDEST
// CHECK-NEXT: PUSH1 0x2a
bb4:
  push 42
  push 0
  mstore
  push 32
  push 0
  return

bb5:
  stop
