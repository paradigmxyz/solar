//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=loop-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=loop-layout
// A latch whose last test guards a panic jumps back to its header on the test's
// `iszero` and to the panic otherwise. Gas builds turn the test around, so the
// latch jumps to the panic, drops the `iszero`, and falls through into its
// header placed after it.
@module InvertedLatch
bb0:
  push 3
  push 0
  jump bb1
bb1:
  dup 2
  dup 2
  lt
  push bb3
  jumpi
  jump bb2
bb2:
  pop
  pop
  stop
bb3:
  push 1
  add
  dup 1
  iszero
  iszero
  push bb1
  jumpi
  jump bb4
bb4 [cold]:
  push 0
  push 0
  revert
