//@ compile-flags: -Ogas -Zevm-ir-pipeline=loop-layout
//@ filecheck:
// Cases that jump forward to a shared join, as a UTF-8 rune count classifies each byte, are not
// back edges of a loop, so no branch counts as an exit and every case keeps equal odds: the first
// case, taken half the time, falls through into the join, and the other cases jump to it.
// CHECK: {{^ +}}bb2:
// CHECK: + bb7:
// CHECK: {{^ +}}bb4:
// CHECK: + bb3:
@module JoinCases
bb0:
  push 0
  push 0
  jump bb1
bb1:
  dup 1
  push 100
  gt
  push bb2
  jumpi
  pop
  stop
bb2:
  dup 1
  mload
  push 0
  byte
  push 128
  dup 2
  lt
  push bb7
  jumpi
  push 224
  dup 2
  lt
  push bb3
  jumpi
  push 240
  dup 2
  lt
  push bb5
  jumpi
  pop
  push 4
  add
  jump bb4
bb3:
  pop
  push 2
  add
  jump bb4
bb4:
  swap 1
  push 1
  add
  swap 1
  jump bb1
bb5:
  pop
  push 3
  add
  jump bb4
bb7:
  pop
  push 1
  add
  jump bb4
