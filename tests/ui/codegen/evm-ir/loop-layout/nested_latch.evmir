//@ compile-flags: -Ogas -Zevm-ir-pipeline=loop-layout
//@ filecheck:
// The inner loop's entry is reached again through the outer loop, so the flow estimate decides.
// Its latch never takes the panic branch, and its header leaves the loop on one traversal in
// ten, so the latch is hotter than the entry and moves before the header.
// CHECK: {{^ +}}bb2:
// CHECK: - bb3:
// CHECK: {{^ +}}bb4:
// CHECK: {{^ +}}jump bb3
// CHECK-NEXT: + bb3:
@module NestedLatch
bb0:
  push 0
  jump bb1
bb1:
  dup 1
  push 4
  gt
  push bb2
  jumpi
  pop
  stop
bb2:
  push 0
  jump bb3
bb3:
  dup 1
  push 8
  gt
  push bb4
  jumpi
  jump bb5
bb4:
  push 1
  add
  dup 1
  iszero
  push bb6
  jumpi
  jump bb3
bb5:
  pop
  push 1
  add
  jump bb1
bb6 [cold]:
  push 0
  push 0
  revert
