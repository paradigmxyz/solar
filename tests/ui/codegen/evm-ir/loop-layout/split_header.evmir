//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=loop-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=loop-layout
// The header's exit code, `pop; pop; stop`, follows its branch. The latch repeats the test and
// branch and falls into a new exit block, which the header jumps to.
@module SplitHeader
bb0:
  push 3
  push 0
  jump bb1
bb1:
  dup 2
  dup 2
  lt
  push bb2
  jumpi
  pop
  pop
  stop
bb2:
  push 1
  add
  jump bb1
