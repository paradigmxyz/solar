//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=loop-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=loop-layout
//@ filecheck:
// A program's `@optimize` line, which its contract's `@custom:solar-optimize` tag sets, selects the
// objective of every optimized build: the gas build keeps the latch after the loop header, as the
// size build does, where an untagged gas build moves it before the header.
@module OptimizeTag
@optimize size
// CHECK-NOT: {{^[+-]}} bb4:
bb0:
  push 0
  push bb2
  jumpi
  jump bb1
bb1:
  stop
bb2:
  push 3
  push 0
  jump bb3
bb3:
  dup 2
  dup 2
  lt
  push bb4
  jumpi
  jump bb1
bb4:
  push 1
  add
  jump bb3
