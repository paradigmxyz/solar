//@ compile-flags: -Zevm-ir-pipeline=peephole
@module FusionKeepsExplainedKind

// A survivor without a span keeps its explained kind: the parser marks an unlocated instruction
// dropped, and the fusion does not give it the removed partner's location, as it would a survivor
// with an unexplained gap (covered by a unit test, since the text format cannot spell one).
bb0:
  calldatasize
  push 0
  lt !metadata(span=1..3)
  iszero
  push 0
  mstore
  stop

// A survivor with its own span keeps it, and the removed partner's is not added.
bb1:
  calldatasize
  push 31
  dup 2
  gt !metadata(span=4..6)
  iszero
  push 0
  mstore
  pop
  stop
bb2:
  calldatasize
  push 31
  dup 2
  gt
  iszero !metadata(span=7..9)
  push 0
  mstore
  pop
  stop

bb3:
  calldatasize
  push 0
  lt !metadata(span=10..12)
  iszero !metadata(span=13..15)
  push 0
  mstore
  stop
bb4:
  calldatasize
  push 31
  dup 2
  gt !metadata(span=16..18)
  iszero !metadata(span=19..21)
  push 0
  mstore
  pop
  stop
