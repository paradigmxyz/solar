// Exactly 1024 words is permitted after retaining the two originals.
// CHECK-LABEL: bb1:
// CHECK-NEXT: dup 1
// CHECK-NEXT: push 160
// CHECK-NEXT: mstore
// CHECK-NEXT: dup 2
// CHECK-NEXT: push 128
// CHECK-NEXT: mstore
bb1:
  push 160
  mstore
  push 128
  mstore
  push 128
  mload
  push 160
  mload
  stop

// One additional incoming word makes the candidate peak 1025; keep the outer store.
// CHECK-LABEL: bb2:
// CHECK-NEXT: push 7
// CHECK-NEXT: push 160
// CHECK-NEXT: mstore
bb2:
  push 7
  push 160
  mstore
  push 128
  mstore
  push 128
  mload
  push 160
  mload
  stop
