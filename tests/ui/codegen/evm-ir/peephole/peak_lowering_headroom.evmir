//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module PeakLoweringHeadroom

// The dynamic target can reach bb1 with 1,023 words. Removing this no-op
// suffix would change its required stack overflow into success.
bb0:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push 0
  push bb1
  not
  not
  jump

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK-NEXT: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}stop
bb1:
  push 1
  dup 1
  pop
  pop
  stop
