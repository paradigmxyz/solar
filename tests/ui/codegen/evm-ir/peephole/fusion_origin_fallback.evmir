//@ compile-flags: -Zevm-ir-pipeline=peephole
@module FusionOriginFallback

// The surviving instruction computes the removed partner's value, so it takes the partner's
// location when it has no span of its own, even when the parser marked it dropped: the `iszero`
// takes the `lt`'s in `bb0`, the inverted compare takes the `iszero`'s in `bb2`.
bb0:
  calldatasize
  push 0
  lt !metadata(span=1..3)
  iszero
  push 0
  mstore
  stop

// A survivor with its own span keeps it, and the removed partner's is not added.
bb1:
  calldatasize
  push 31
  dup 2
  gt !metadata(span=4..6)
  iszero
  push 0
  mstore
  pop
  stop
bb2:
  calldatasize
  push 31
  dup 2
  gt
  iszero !metadata(span=7..9)
  push 0
  mstore
  pop
  stop

bb3:
  calldatasize
  push 0
  lt !metadata(span=10..12)
  iszero !metadata(span=13..15)
  push 0
  mstore
  stop
bb4:
  calldatasize
  push 31
  dup 2
  gt !metadata(span=16..18)
  iszero !metadata(span=19..21)
  push 0
  mstore
  pop
  stop
