//@ compile-flags: -Zevm-ir-pipeline=peephole

@module test
bb0:
  push 0 !metadata(span=0..1)
  push 0 !metadata(span=1..2)
  push 0 !metadata(span=2..3)
  push 0 !metadata(span=3..4)
  swap 2 !metadata(span=0..1)
  swap 3 !metadata(span=1..2)
  swap 2 !metadata(span=2..3)
  exchange 2, 3 !metadata(span=3..4)
  swap 2 !metadata(span=4..5)
  stop

bb1:
  calldatasize
  push 128 !metadata(span=5..6)
  mstore !metadata(span=6..7)
  push 32 !metadata(span=7..8)
  push 128 !metadata(span=8..9)
  return !metadata(span=9..10)
