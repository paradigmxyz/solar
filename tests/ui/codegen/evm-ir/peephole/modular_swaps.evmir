//@ compile-flags: -Zevm-ir-pipeline=peephole

@module ModularSwaps

// The modulus stays third while the top two addends or factors commute.
bb0 [stack=3]:
  swap 1
  addmod
  stop
bb1 [stack=3]:
  swap 1
  mulmod
  stop

// Moving the modulus changes the result and must retain the swap.
bb2 [stack=3]:
  swap 2
  addmod
  stop
bb3 [stack=3]:
  swap 2
  mulmod
  stop

// The ternary operations do not match the binary DUP2/OP/SWAP1/POP rewrite.
bb4 [stack=3]:
  dup 2
  addmod
  swap 1
  pop
  stop
bb5 [stack=3]:
  dup 2
  mulmod
  swap 1
  pop
  stop
