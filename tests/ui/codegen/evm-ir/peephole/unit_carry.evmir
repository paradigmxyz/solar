//@ revisions: gas size
//@ compile-flags: -Zevm-ir-pipeline=peephole
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@ filecheck:

@module PhysicalUnitCarry
bb0:
  push 64
  calldataload
  push 32
  calldataload
  push 0
  calldataload
  jumpi bb1, bb2

// Both paths preserve the independent calldata prefix below the arithmetic word.
// CHECK-LABEL: {{^[ +]*}}bb1:
// CHECK: {{^[ +].*}}push 1
// CHECK: {{^[ +].*}}add
// CHECK: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}iszero
// CHECK-NOT: {{^[ +].*}}lt
// CHECK: {{^[ +].*}}jump bb3
bb1:
  dup 1
  push 1
  add
  swap 1
  dup 2
  lt
  jump bb3

// CHECK-LABEL: {{^[ +]*}}bb2:
// CHECK: {{^[ +].*}}push 1
// CHECK: {{^[ +].*}}add
// CHECK: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}iszero
// CHECK-NOT: {{^[ +].*}}lt
// CHECK: {{^[ +].*}}jump bb3
bb2:
  push 1
  dup 2
  add
  swap 1
  dup 2
  lt
  jump bb3

// Return all three words: original prefix, wrapped sum, carry.
bb3:
  push 64
  mstore
  push 32
  mstore
  push 0
  mstore
  push 96
  push 0
  return
