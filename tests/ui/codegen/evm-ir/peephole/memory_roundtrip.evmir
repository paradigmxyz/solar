//@ revisions: gas size legacy extended
//@ compile-flags: -Zevm-ir-pipeline=peephole
//@[gas] compile-flags: -Ogas --evm-version=osaka
//@[size] compile-flags: -Osize --evm-version=osaka
//@[legacy] compile-flags: -Ogas --evm-version=paris
//@[extended] compile-flags: -Ogas --evm-version=amsterdam
//@ filecheck:

@module MemoryRoundtrip

// Store three calldata words, restore their stack order, then publish both copies.
// CHECK-LABEL: bb0:
// CHECK: dup 1
// CHECK-NEXT: push 192
// CHECK-NEXT: mstore
// CHECK-NEXT: dup 2
// CHECK-NEXT: push 160
// CHECK-NEXT: mstore
// CHECK-NEXT: dup 3
// CHECK-NEXT: push 128
// CHECK-NEXT: mstore
bb0:
  push 0
  calldataload
  push 32
  calldataload
  push 64
  calldataload
  push 192
  mstore
  push 160
  mstore
  push 128
  mstore
  push 128
  mload
  push 160
  mload
  push 192
  mload
  push 288
  mstore
  push 256
  mstore
  push 224
  mstore
  push 192
  push 128
  return

// The innermost store/load pair may already have become DUP1 plus MSTORE.
// CHECK-LABEL: bb1:
// CHECK: dup 1
// CHECK-NEXT: push 160
// CHECK-NEXT: mstore
// CHECK: dup 2
// CHECK-NEXT: push 128
// CHECK-NEXT: mstore
bb1:
  push 11
  push 22
  push 160
  mstore
  dup 1
  push 128
  mstore
  push 160
  mload
  stop

// Overlapping words would change a reloaded value; keep the outer store/load.
// CHECK-LABEL: bb2:
// CHECK: push 129
// CHECK-NEXT: mstore
bb2:
  push 11
  push 22
  push 129
  mstore
  push 128
  mstore
  push 128
  mload
  push 129
  mload
  stop

// Equal addresses are also aliases, even when both source values are literals.
// CHECK-LABEL: bb3:
// CHECK: push 128
// CHECK-NEXT: mstore
bb3:
  push 11
  push 22
  push 128
  mstore
  push 128
  mstore
  push 128
  mload
  push 128
  mload
  stop

// Address zero is valid before PUSH0 exists and after its introduction.
// CHECK-LABEL: bb5:
// CHECK: dup 1
// CHECK-NEXT: push 32
// CHECK-NEXT: mstore
// CHECK-NEXT: dup 2
// CHECK-NEXT: push 0
// CHECK-NEXT: mstore
bb5:
  push 11
  push 22
  push 32
  mstore
  push 0
  mstore
  push 0
  mload
  push 32
  mload
  stop

// A 16-word run fits the bounded matcher.
// CHECK-LABEL: bb6:
// CHECK: dup 16
// CHECK-NEXT: push 128
// CHECK-NEXT: mstore
bb6:
  push 99
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 608
  mstore
  push 576
  mstore
  push 544
  mstore
  push 512
  mstore
  push 480
  mstore
  push 448
  mstore
  push 416
  mstore
  push 384
  mstore
  push 352
  mstore
  push 320
  mstore
  push 288
  mstore
  push 256
  mstore
  push 224
  mstore
  push 192
  mstore
  push 160
  mstore
  push 128
  mstore
  push 128
  mload
  push 160
  mload
  push 192
  mload
  push 224
  mload
  push 256
  mload
  push 288
  mload
  push 320
  mload
  push 352
  mload
  push 384
  mload
  push 416
  mload
  push 448
  mload
  push 480
  mload
  push 512
  mload
  push 544
  mload
  push 576
  mload
  push 608
  mload
  stop

// A 17-word run cannot be rewritten as one complete run.
// CHECK-LABEL: bb7:
// CHECK: push 640
// CHECK-NEXT: mstore
bb7:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 640
  mstore
  push 608
  mstore
  push 576
  mstore
  push 544
  mstore
  push 512
  mstore
  push 480
  mstore
  push 448
  mstore
  push 416
  mstore
  push 384
  mstore
  push 352
  mstore
  push 320
  mstore
  push 288
  mstore
  push 256
  mstore
  push 224
  mstore
  push 192
  mstore
  push 160
  mstore
  push 128
  mstore
  push 128
  mload
  push 160
  mload
  push 192
  mload
  push 224
  mload
  push 256
  mload
  push 288
  mload
  push 320
  mload
  push 352
  mload
  push 384
  mload
  push 416
  mload
  push 448
  mload
  push 480
  mload
  push 512
  mload
  push 544
  mload
  push 576
  mload
  push 608
  mload
  push 640
  mload
  stop
