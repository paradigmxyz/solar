//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: - swap 1
// CHECK: + swap 2
// CHECK: {{^[ +].*}}pop
// CHECK: - swap 1
