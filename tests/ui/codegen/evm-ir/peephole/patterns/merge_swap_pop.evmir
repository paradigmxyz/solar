//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: - swap 1
// CHECK: + swap 2
// CHECK: {{^[ +].*}}pop
// CHECK: - swap 1
bb0:
  push 1
  push 2
  push 3
  swap 1
  pop
  swap 1
  pop
  push 0
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: - swap 2
// CHECK: + swap 3
// CHECK: - swap 1
bb1:
  push 1
  push 2
  push 3
  push 4
  swap 2
  pop
  pop
  swap 1
  pop
  push 0
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: - swap 15
// CHECK: + swap 16
// CHECK: - swap 1
bb2:
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  swap 15
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  swap 1
  pop
  push 0
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: - swap 1
// CHECK: + swap 3
// CHECK: - swap 2
bb3:
  push 1
  push 2
  push 3
  push 4
  swap 1
  pop
  swap 2
  pop
  push 0
  mstore
  stop

// A permutation is dead when all values it touches are discarded.
// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: - swap 1
// CHECK-COUNT-2: {{^[ +].*}}pop
bb4:
  calldatasize
  calldatasize
  swap 1
  pop
  pop
  push 0
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: - swap 3
// CHECK-COUNT-4: {{^[ +].*}}pop
bb5:
  calldatasize
  calldatasize
  calldatasize
  calldatasize
  swap 3
  pop
  pop
  pop
  pop
  push 0
  mstore
  stop

// The merged `SWAP17` has no Osaka lowering, so leave the legacy boundary intact.
// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^[ +].*}}swap 16
// CHECK: {{^[ +].*}}swap 1
bb6:
  callf !meta(stack=0->18)
  swap 16
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  swap 1
  pop
  stop
