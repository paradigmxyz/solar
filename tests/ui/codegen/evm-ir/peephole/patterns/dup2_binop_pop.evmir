//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: - dup 2
// CHECK: {{^[ +].*}}add
// CHECK: - swap 1
// CHECK: - pop
bb0:
  calldatasize
  returndatasize
  dup 2
  add
  swap 1
  pop
  stop

