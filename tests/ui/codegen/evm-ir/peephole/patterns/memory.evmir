//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}mstore
// CHECK: - dup 1
// CHECK: - push 32
// CHECK: - mstore
// CHECK: {{^[ +].*}}push 7
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}push 96
// CHECK-NEXT: {{^[ +].*}}mstore
bb0:
  push 1
  dup 1
  push 32
  mstore
  dup 1
  push 32
  mstore
  push 7
  push 96
  mstore
  push 96
  mload
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: - pop
// CHECK-NEXT: - push 32
// CHECK-NEXT: - mload
bb1:
  push 1
  dup 1
  push 32
  mstore
  pop
  push 32
  mload
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}mload
// CHECK: - dup 1
// CHECK: - push 32
// CHECK: - mstore
bb2:
  push 32
  mload
  dup 1
  push 32
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}mload
// CHECK: {{^[ +].*}}dup 1
// CHECK: {{^[ +].*}}push 64
// CHECK: {{^[ +].*}}mstore
bb3:
  push 32
  mload
  dup 1
  push 64
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^[ +].*}}push 7
// CHECK: -   dup 1
// CHECK: {{^[ +].*}}push 32
// CHECK: {{^[ +].*}}mstore
// CHECK: -   pop
bb4:
  push 7
  dup 1
  push 32
  mstore
  pop
  stop

// Keep the copy when it remains live after the store.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^[ +].*}}dup 1
// CHECK: {{^[ +].*}}mstore
bb5:
  push 7
  dup 1
  push 32
  mstore
  stop

// Reuse the stored value instead of loading it again.
// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^[ +].*}}push 7
// CHECK-NEXT: +   dup 1
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: -   push 32
// CHECK-NEXT: -   mload
bb6:
  callf !metadata(stack=0->255)
  callf !metadata(stack=0->255)
  callf !metadata(stack=0->255)
  callf !metadata(stack=0->255)
  push 0
  push 0
  push 7
  push 32
  mstore
  push 32
  mload
  stop

// CHECK-LABEL: bb7:
// CHECK: +   dup 1
// CHECK: {{^[ +].*}}sstore
// CHECK: -   sload
bb7:
  push 7
  push 4
  sstore
  push 4
  sload
  stop

// CHECK-LABEL: bb8:
// CHECK: +   dup 1
// CHECK: {{^[ +].*}}tstore
// CHECK: -   tload
bb8:
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  push 0
  tstore
  push 0
  tload
  stop

// Storage and transient storage are separate address spaces.
// CHECK-LABEL: bb9:
// CHECK: {{^[ +].*}}sstore
// CHECK-NEXT: {{^[ +].*}}push 4
// CHECK-NEXT: {{^[ +].*}}tload
bb9:
  push 7
  push 4
  sstore
  push 4
  tload
  stop

// A different slot must still be loaded.
// CHECK-LABEL: bb10:
// CHECK: {{^[ +].*}}tstore
// CHECK-NEXT: {{^[ +].*}}push 5
// CHECK-NEXT: {{^[ +].*}}tload
bb10:
  push 7
  push 4
  tstore
  push 5
  tload
  stop

// CHECK-LABEL: bb11:
// CHECK: -   push 128
// CHECK: +   push 0
// CHECK: {{^[ +].*}}mstore
// CHECK: {{^[ +].*}}push 32
// CHECK: -   push 128
// CHECK: +   push 0
bb11:
  calldatasize
  push 128
  mstore
  push 32
  push 128
  return

// A longer return includes memory outside the stored word.
bb12:
  calldatasize
  push 128
  mstore
  push 64
  push 128
  return

// A different return offset does not read the stored word.
bb13:
  calldatasize
  push 128
  mstore
  push 32
  push 160
  return

// MSIZE observes the store's original memory expansion.
bb14:
  calldatasize
  push 128
  mstore
  msize
  push 32
  push 128
  return

// CHECK-LABEL: bb15:
// CHECK: -   dup 2
// CHECK: +   swap 1
// CHECK: {{^[ +].*}}mstore
// CHECK: -   swap 1
// CHECK: -   pop
bb15:
  calldatasize
  caller
  dup 2
  push 128
  mstore
  swap 1
  pop
  stop

// Consume a deeper word without disturbing the remaining stack order.
bb16:
  calldatasize
  caller
  callvalue
  dup 3
  push 128
  mstore
  swap 2
  pop
  stop

// A different swap discards a different source.
bb17:
  calldatasize
  caller
  callvalue
  dup 3
  push 128
  mstore
  swap 1
  pop
  stop
