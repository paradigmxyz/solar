//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}mstore
// CHECK: - dup1
// CHECK: - push 32
// CHECK: - mstore
bb0:
  push 1
  dup1
  push 32
  mstore
  dup1
  push 32
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}mstore
// CHECK: - pop
// CHECK: - push 32
// CHECK: - mload
bb1:
  push 1
  dup1
  push 32
  mstore
  pop
  push 32
  mload
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}mload
// CHECK: - dup1
// CHECK: - push 32
// CHECK: - mstore
bb2:
  push 32
  mload
  dup1
  push 32
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}mload
// CHECK: {{^[ +].*}}dup1
// CHECK: {{^[ +].*}}push 64
// CHECK: {{^[ +].*}}mstore
bb3:
  push 32
  mload
  dup1
  push 64
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^[ +].*}}push 7
// CHECK: -   dup1
// CHECK: {{^[ +].*}}push 32
// CHECK: {{^[ +].*}}mstore
// CHECK: -   pop
bb4:
  push 7
  dup1
  push 32
  mstore
  pop
  stop

// Keep the copy when it remains live after the store.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^[ +].*}}dup1
// CHECK: {{^[ +].*}}mstore
bb5:
  push 7
  dup1
  push 32
  mstore
  stop
