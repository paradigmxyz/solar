//@compile-flags: -Zevm-ir-pipeline=peephole
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}mstore
// CHECK: - dup 1
// CHECK: - push 32
// CHECK: - mstore
// CHECK: {{^[ +].*}}push 7
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}push 96
// CHECK-NEXT: {{^[ +].*}}mstore
bb0:
  push 1
  dup 1
  push 32
  mstore
  dup 1
  push 32
  mstore
  push 7
  push 96
  mstore
  push 96
  mload
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: - pop
// CHECK-NEXT: - push 32
// CHECK-NEXT: - mload
bb1:
  push 1
  dup 1
  push 32
  mstore
  pop
  push 32
  mload
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}mload
// CHECK: - dup 1
// CHECK: - push 32
// CHECK: - mstore
bb2:
  push 32
  mload
  dup 1
  push 32
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}mload
// CHECK: {{^[ +].*}}dup 1
// CHECK: {{^[ +].*}}push 64
// CHECK: {{^[ +].*}}mstore
bb3:
  push 32
  mload
  dup 1
  push 64
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^[ +].*}}push 7
// CHECK: -   dup 1
// CHECK: {{^[ +].*}}push 32
// CHECK: {{^[ +].*}}mstore
// CHECK: -   pop
bb4:
  push 7
  dup 1
  push 32
  mstore
  pop
  stop

// Keep the copy when it remains live after the store.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^[ +].*}}dup 1
// CHECK: {{^[ +].*}}mstore
bb5:
  push 7
  dup 1
  push 32
  mstore
  stop

// Reuse the stored value instead of loading it again.
// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^[ +].*}}push 7
// CHECK-NEXT: +   dup 1
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: -   push 32
// CHECK-NEXT: -   mload
bb6:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push 7
  push 32
  mstore
  push 32
  mload
  stop
