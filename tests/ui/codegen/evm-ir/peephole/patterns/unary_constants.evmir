//@ revisions: paris osaka
//@ compile-flags: -Zevm-ir-pipeline=peephole
//@[paris] compile-flags: --evm-version=paris
//@[osaka] compile-flags: --evm-version=osaka
@module UnaryConstants

// ISZERO(0) materializes one, including on forks without PUSH0.
bb0:
  push 0
  iszero
  push 0
  mstore
  stop

// A folded false condition removes the entire closed conditional jump.
bb1:
  push 2
  iszero
  push bb100
  jumpi
  push 9
  push 0
  mstore
  stop

// An already false condition removes its jump without needing a unary fold.
bb2:
  push 0
  push bb100
  jumpi
  stop

// Keep a true branch and a condition read from the incoming stack.
bb3:
  push 1
  push bb100
  jumpi
  stop
bb4:
  iszero
  push bb100
  jumpi
  stop

// NOT(MAX) folds to zero, while NOT(0) already is its selected recipe.
bb5:
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  not
  push 0
  mstore
  stop
bb6:
  push 0
  not
  push 0
  mstore
  stop

// A literal address is not a statically identified block target.
bb11:
  push 0
  push 255
  jumpi
  stop

// Canonical explicit stack metadata still permits folding.
bb12:
  push 7 !metadata(stack=0->1)
  iszero !metadata(stack=1->1)
  stop

// Symbolic and deferred values are not literal words.
bb14:
  push bb100
  iszero
  stop
bb15:
  push_deferred 0
  iszero
  stop

bb100:
  push 0
  push 0
  revert
