//@ revisions: osaka amsterdam
//@[osaka] compile-flags: --evm-version osaka -Zevm-ir-pipeline=peephole -Zdump=disasm-deploy
//@[osaka] filecheck: --check-prefixes=CHECK,OSAKA
//@[amsterdam] compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=peephole -Zdump=disasm-deploy
//@[amsterdam] filecheck: --check-prefixes=CHECK,AMSTERDAM
@module exchange

// CHECK: - swap 2
// CHECK: - swap 3
// CHECK: - swap 2
// CHECK: + exchange 2, 3
// OSAKA: SWAP2
// OSAKA-NEXT: SWAP3
// OSAKA-NEXT: SWAP2
// AMSTERDAM: EXCHANGE 2, 3
bb0:
  push 0
  push 1
  push 2
  push 3
  swap 2
  swap 3
  swap 2
  stop

bb1:
  push 0
  push 1
  push 2
  push 3
  exchange 2, 3
  swap 2
  stop

bb2:
  push 0
  push 1
  push 2
  push 3
  swap 2
  exchange 2, 3
  stop

bb3:
  push 0
  push 1
  push 2
  push 3
  exchange 2, 3
  exchange 2, 3
  stop
