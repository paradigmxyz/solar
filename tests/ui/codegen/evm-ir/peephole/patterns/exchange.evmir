//@ revisions: osaka amsterdam
//@[osaka] compile-flags: --evm-version osaka -Zevm-ir-pipeline=peephole -Zdump=disasm-deploy
//@[osaka] filecheck:
//@[amsterdam] compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=peephole -Zdump=disasm-deploy
//@[amsterdam] filecheck:
@module exchange

// Swaps stay canonical through peephole cleanup on every target.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^    swap 2}}
// CHECK-NEXT: {{^    swap 3}}
// CHECK-NEXT: {{^    swap 2}}
// CHECK: SWAP2
// CHECK-NEXT: SWAP3
// CHECK-NEXT: SWAP2
bb0:
  push 0
  push 1
  push 2
  push 3
  swap 2
  swap 3
  swap 2
  stop

bb1:
  push 0
  push 1
  push 2
  push 3
  exchange 2, 3
  swap 2
  stop

bb2:
  push 0
  push 1
  push 2
  push 3
  swap 2
  exchange 2, 3
  stop

bb3:
  push 0
  push 1
  push 2
  push 3
  exchange 2, 3
  exchange 2, 3
  stop

bb4:
  push 0
  push 1
  push 2
  push 3
  exchange 2, 3
  swap 3
  stop

bb5:
  push 0
  push 1
  push 2
  push 3
  swap 3
  exchange 2, 3
  stop
