// CHECK: - push 2
// CHECK: {{^[ +].*}}push 0
// CHECK: - mod
bb10:
  push 2
  push 0
  mod
  stop

// CHECK-LABEL: {{^[ +].*}}bb11:
// CHECK: - push 2
// CHECK: {{^[ +].*}}push 0
// CHECK: - smod
bb11:
  push 2
  push 0
  smod
  stop

// CHECK-LABEL: {{^[ +].*}}bb12:
// CHECK: - push 2
// CHECK: {{^[ +].*}}push 0
// CHECK: - and
bb12:
  push 2
  push 0
  and
  stop

// CHECK-LABEL: {{^[ +].*}}bb13:
// CHECK: - push 2
// CHECK: {{^[ +].*}}push 0
// CHECK: - gt
bb13:
  push 2
  push 0
  gt
  stop

// CHECK-LABEL: {{^[ +].*}}bb14:
// CHECK: {{^[ +].*}}push 2
// CHECK: - push 1
// CHECK: - mul
bb14:
  push 2
  push 1
  mul
  stop

// CHECK-LABEL: {{^[ +].*}}bb15:
// CHECK: - push 2
// CHECK: {{^[ +].*}}push 1
// CHECK: - exp
bb15:
  push 2
  push 1
  exp
  stop

// Fold adjacent constants through the shared EVM word evaluator.
// CHECK-LABEL: {{^[ +].*}}bb16:
// CHECK: -   add
// CHECK: +   push 67
bb16:
  push 31 !metadata(stack=0->1)
  push 36 !metadata(stack=0->1)
  add !metadata(stack=2->1)
  stop

// CHECK-LABEL: {{^[ +].*}}bb17:
// CHECK: -   mul
// CHECK: +   push 128
bb17:
  push 32 !metadata(stack=0->1)
  push 4 !metadata(stack=0->1)
  mul !metadata(stack=2->1)
  stop

// Emit the compact materialization priced by the fold.
// CHECK-LABEL: {{^[ +].*}}bb18:
// CHECK: -   add
// CHECK: +   push 0
// CHECK-NEXT: +   not
bb18:
  push 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe
  push 1
  add
  stop

// CHECK-LABEL: {{^[ +].*}}bb19:
// CHECK: -   sub
// CHECK: +   push 26
bb19:
  push 5
  push 31
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb20:
// CHECK: +   push 32
// CHECK: -   gt
// CHECK: -   iszero
// CHECK: +   lt
bb20:
  calldatasize
  push 31
  dup 2
  gt
  iszero
  push 0
  mstore
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb21:
// CHECK: +   push 31
// CHECK: -   lt
// CHECK: -   iszero
// CHECK: +   gt
bb21:
  calldatasize
  push 32
  dup 2
  lt
  iszero
  push 0
  mstore
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb22:
// CHECK: -   gt
// CHECK: -   iszero
// CHECK: +   push 30
// CHECK: +   lt
bb22:
  calldatasize
  push 31
  gt
  iszero
  push 0
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb23:
// CHECK: -   lt
// CHECK: -   iszero
// CHECK: +   push 32
// CHECK: +   gt
bb23:
  calldatasize
  push 31
  lt
  iszero
  push 0
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb24:
// CHECK: +   push 256
// CHECK: -   gt
// CHECK: -   iszero
// CHECK: +   lt
bb24:
  calldatasize
  push 255
  dup 2
  gt
  iszero
  push 0
  mstore
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb25:
// CHECK: {{^[ +].*}}gt
// CHECK-NEXT: {{^[ +].*}}iszero
bb25:
  calldatasize
  push 31
  dup 1
  gt
  iszero
  push 0
  mstore
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb26:
// CHECK: {{^[ +].*}}gt
// CHECK-NEXT: {{^[ +].*}}iszero
bb26:
  calldatasize
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  dup 2
  gt
  iszero
  push 0
  mstore
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb27:
// CHECK: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}iszero
bb27:
