// CHECK: - sar
bb5:
  push 2
  push 0
  sar
  stop

// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^[ +].*}}push 2
// CHECK: - push 0
// CHECK: + iszero
bb6:
  push 2
  push 0
  eq
  stop

// CHECK-LABEL: {{^[ +].*}}bb7:
// CHECK: - push 2
// CHECK: {{^[ +].*}}push 0
// CHECK: - mul
bb7:
  push 2
  push 0
  mul
  stop

