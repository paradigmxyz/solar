//@ compile-flags: -Zevm-ir-pipeline=peephole
//@ filecheck:
@module ReloadStoredValueStackLimit

// The reload keeps the stored value with a `DUP1` that peaks one word above the `PUSH; MLOAD` it
// replaces. At 1023 words that is 1025, so the window stays; at 1022 words it fits. The depth
// before the window counts the block's earlier instructions, and a block entered through a jump
// takes the verifier's bound. A block without a known entry depth keeps the window, unless the
// block already reaches the reload's peak after the window, up to its first conditional jump or
// terminal, counting the growth of a lowered `jump`.

// Memory reload kept at 1023 words.
// CHECK-LABEL: bb0 [stack=1023]:
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mload
bb0 [stack=1023]:
  push 0
  mstore
  push 0
  mload
  push 32
  mstore
  push 32
  push 32
  return

// Storage reload kept at 1023 words.
// CHECK-LABEL: bb1 [stack=1023]:
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}sstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}sload
bb1 [stack=1023]:
  push 0
  sstore
  push 0
  sload
  push 32
  sstore
  push 32
  push 32
  return

// Transient storage reload kept at 1023 words.
// CHECK-LABEL: bb2 [stack=1023]:
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}tstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}tload
bb2 [stack=1023]:
  push 0
  tstore
  push 0
  tload
  push 32
  tstore
  push 32
  push 32
  return

// Memory reload rewritten at 1022 words.
// CHECK-LABEL: bb3 [stack=1022]:
// CHECK-NEXT: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   mload
bb3 [stack=1022]:
  push 0
  mstore
  push 0
  mload
  push 32
  mstore
  push 32
  push 32
  return

// Storage reload rewritten at 1022 words.
// CHECK-LABEL: bb4 [stack=1022]:
// CHECK-NEXT: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}sstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   sload
bb4 [stack=1022]:
  push 0
  sstore
  push 0
  sload
  push 32
  sstore
  push 32
  push 32
  return

// Transient storage reload rewritten at 1022 words.
// CHECK-LABEL: bb5 [stack=1022]:
// CHECK-NEXT: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}tstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   tload
bb5 [stack=1022]:
  push 0
  tstore
  push 0
  tload
  push 32
  tstore
  push 32
  push 32
  return

// Three words pushed before the window leave 1023 words.
// CHECK-LABEL: bb6 [stack=1020]:
// CHECK: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mload
bb6 [stack=1020]:
  push 1
  push 2
  push 3
  push 0
  mstore
  push 0
  mload
  stop

// The same pushes from 1019 words leave 1022 words.
// CHECK-LABEL: bb7 [stack=1019]:
// CHECK: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   mload
bb7 [stack=1019]:
  push 1
  push 2
  push 3
  push 0
  mstore
  push 0
  mload
  stop

// A block entered at 1023 words through a jump keeps the window.
// CHECK-LABEL: bb9
// CHECK: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mload
bb8 [stack=1022]:
  push 1
  jump bb9
bb9:
  push 0
  mstore
  push 0
  mload
  stop

// A block entered at 1021 words through a jump takes the rewrite.
// CHECK-LABEL: bb11
// CHECK: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   mload
bb10 [stack=1020]:
  push 1
  jump bb11
bb11:
  push 0
  mstore
  push 0
  mload
  stop

// A block with no known entry depth keeps the window.
// CHECK-LABEL: bb12:
// CHECK: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mload
bb12:
  push 7
  push 0
  mstore
  push 0
  mload
  stop

// Two words pushed after the window reach the reload's peak, so it fits without an entry bound.
// CHECK-LABEL: bb13:
// CHECK: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   mload
bb13:
  push 7
  push 0
  mstore
  push 0
  mload
  push 1
  push 2
  stop

// A `jump` to a block that does not follow lowers to a push, which adds a word to the peak.
// CHECK-LABEL: bb14:
// CHECK: +   dup 1
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: -   push 0
// CHECK-NEXT: -   mload
bb14:
  push 7
  push 0
  mstore
  push 0
  mload
  push 1
  jump bb16

// A `jump` to the next block adds none.
// CHECK-LABEL: bb15:
// CHECK: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mstore
// CHECK-NEXT: {{^ +}}push 0
// CHECK-NEXT: {{^ +}}mload
bb15:
  push 7
  push 0
  mstore
  push 0
  mload
  push 1
  jump bb16
bb16:
  stop
