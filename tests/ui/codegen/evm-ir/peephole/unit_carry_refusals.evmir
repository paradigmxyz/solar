//@ revisions: gas size
//@ compile-flags: -Zevm-ir-pipeline=peephole
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@ filecheck:

@module PhysicalCarryRefusals
bb0:
  push 0
  calldataload
  // CHECK: {{^[ +].*}}push 2
  // CHECK: {{^[ +].*}}add
  // CHECK: {{^[ +].*}}swap 1
  // CHECK-NEXT: {{^[ +].*}}dup 2
  // CHECK-NEXT: {{^[ +].*}}lt
  dup 1
  dup 1
  push 2
  add
  swap 1
  dup 2
  lt
  push 32
  mstore
  push 0
  mstore
  // CHECK: {{^[ +].*}}push 1
  // CHECK: {{^[ +].*}}add
  // CHECK: {{^[ +].*}}swap 1
  // CHECK-NEXT: {{^[ +].*}}dup 2
  // CHECK-NEXT: {{^[ +].*}}slt
  dup 1
  dup 1
  push 1
  add
  swap 1
  dup 2
  slt
  push 96
  mstore
  push 64
  mstore
  // CHECK: {{^[ +].*}}push 1
  // CHECK: {{^[ +].*}}add
  // CHECK: {{^[ +].*}}swap 1
  // CHECK-NEXT: {{^[ +].*}}dup 2
  // CHECK-NEXT: {{^[ +].*}}gt
  dup 1
  dup 1
  push 1
  add
  swap 1
  dup 2
  gt
  push 160
  mstore
  push 128
  mstore
  // CHECK: {{^[ +].*}}push 1
  // CHECK: {{^[ +].*}}add
  // CHECK: {{^[ +].*}}swap 1
  // CHECK-NEXT: {{^[ +].*}}dup 2
  // CHECK-NEXT: {{^[ +].*}}sgt
  dup 1
  dup 1
  push 1
  add
  swap 1
  dup 2
  sgt
  push 224
  mstore
  push 192
  mstore
  // Reversed LT stack order computes x < sum, not carry.
  // CHECK: {{^[ +].*}}dup 2
  // CHECK-NEXT: {{^[ +].*}}lt
  dup 1
  push 1
  add
  dup 2
  lt
  push 256
  mstore
  pop
  push 288
  push 0
  return
