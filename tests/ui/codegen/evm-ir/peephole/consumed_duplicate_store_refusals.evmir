//@ revisions: gas size paris
//@[gas] compile-flags: -Ogas --evm-version osaka -Zevm-ir-pipeline=peephole
//@[size] compile-flags: -Osize --evm-version osaka -Zevm-ir-pipeline=peephole
//@[paris] compile-flags: -Ogas --evm-version paris -Zevm-ir-pipeline=peephole
//@ filecheck:
@module ConsumedDuplicateStoreRefusals

// Distinct addresses retain both writes.
// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK-COUNT-2: {{^[ +] *}}mstore
bb0:
  push 0
  calldataload
  dup 1
  push 32
  mstore
  push 96
  mstore
  jump bb1

// Overlapping but unequal words retain both writes.
// CHECK-LABEL: {{^[ +] *}}bb1:
// CHECK-COUNT-2: {{^[ +] *}}mstore
bb1:
  push 0
  calldataload
  dup 1
  push 32
  mstore
  push 33
  mstore
  jump bb2

// DUP2 copies a different value, so the writes can differ.
// CHECK-LABEL: {{^[ +] *}}bb2:
// CHECK-COUNT-2: {{^[ +] *}}mstore
bb2:
  push 0
  calldataload
  push 32
  calldataload
  dup 2
  push 128
  mstore
  push 128
  mstore
  pop
  jump bb3

// A byte store is not an identical fullword store.
// CHECK-LABEL: {{^[ +] *}}bb3:
// CHECK: mstore
// CHECK: mstore8
bb3:
  push 0
  calldataload
  dup 1
  push 128
  mstore
  push 128
  mstore8
  jump bb4

// A read between the stores is outside the adjacent pattern.
// CHECK-LABEL: {{^[ +] *}}bb4:
// CHECK-COUNT-2: {{^[ +] *}}mstore
bb4:
  push 0
  calldataload
  dup 1
  push 128
  mstore
  msize
  pop
  push 128
  mstore
  jump bb5

// GAS between stores prevents adjacency.
// CHECK-LABEL: {{^[ +] *}}bb5:
// CHECK-COUNT-2: {{^[ +] *}}mstore
bb5:
  push 0
  calldataload
  dup 1
  push 128
  mstore
  gas
  pop
  push 128
  mstore
  jump bb6

// An ordinary arithmetic operation also prevents adjacency.
// CHECK-LABEL: {{^[ +] *}}bb6:
// CHECK-COUNT-2: {{^[ +] *}}mstore
bb6:
  push 0
  calldataload
  dup 1
  push 128
  mstore
  push 1
  add
  push 128
  mstore
  stop
