//@ revisions: byzantium osaka
//@ compile-flags: -Ogas -Zevm-ir-pipeline=peephole
//@[byzantium] compile-flags: --evm-version byzantium
//@[osaka] compile-flags: --evm-version osaka
//@ filecheck:
@module DisjointMasksCall

// The main module contains no GAS. The child can return its forwarded gas.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 0x1010101
// CHECK-NEXT: {{^[ +].*}}or
// CHECK-NEXT: {{^[ +].*}}push 0x80808080
// CHECK-NEXT: {{^[ +].*}}and
// CHECK: {{^[ +].*}}call
bb0:
  push 0
  calldataload
  push 0x01010101
  or
  push 0x80808080
  and
  push 0
  mstore
  push 32
  push 32
  push 32
  push 0
  push 0
  push 4096
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  call
  pop
  push 64
  push 0
  return
