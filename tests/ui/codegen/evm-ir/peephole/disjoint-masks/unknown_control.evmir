//@ revisions: byzantium osaka
//@ compile-flags: -Ogas -Zevm-ir-pipeline=peephole
//@[byzantium] compile-flags: --evm-version byzantium
//@[osaka] compile-flags: --evm-version osaka
//@ filecheck:
@module DisjointMasksUnknownControl

// No PushLabel or raw opcode masks the unknown computed-transfer check.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 0x1010101
// CHECK-NEXT: {{^[ +].*}}or
// CHECK-NEXT: {{^[ +].*}}push 0x80808080
// CHECK-NEXT: {{^[ +].*}}and
// CHECK: {{^[ +].*}}jump
bb0:
  push 0
  calldataload
  push 0x01010101
  or
  push 0x80808080
  and
  push 0
  mstore
  push 32
  calldataload
  jump
