//@[byzantium] compile-flags: --evm-version byzantium
//@[osaka] compile-flags: --evm-version osaka
//@ filecheck:
@module DisjointMasksPublicLabel

// Parsed labels can be ordinary numeric data and carry no private proof.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 0x1010101
// CHECK-NEXT: {{^[ +].*}}or
// CHECK-NEXT: {{^[ +].*}}push 0x80808080
// CHECK-NEXT: {{^[ +].*}}and
// CHECK: {{^[ +].*}}push bb1
bb0:
  push 0
  calldataload
  push 0x01010101
  or
  push 0x80808080
  and
  push 0
  mstore
  push bb1
  push 32
  mstore
  push 64
  push 0
  return
bb1:
  stop
