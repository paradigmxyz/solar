//@ revisions: gas size paris
//@[gas] compile-flags: -Ogas --evm-version osaka -Zevm-ir-pipeline=peephole
//@[size] compile-flags: -Osize --evm-version osaka -Zevm-ir-pipeline=peephole
//@[paris] compile-flags: -Ogas --evm-version paris -Zevm-ir-pipeline=peephole
//@ filecheck:
@module ConsumedDuplicateStore

bb0:
  push 0
  calldataload
  dup 1
  push 0
  eq
  jumpi bb1, bb6
bb6:
  dup 1
  push 1
  eq
  jumpi bb2, bb7
bb7:
  dup 1
  push 2
  eq
  jumpi bb3, bb4

// The copied value is consumed while the unrelated incoming prefix survives.
// CHECK-LABEL: {{^[ +] *}}bb1:
// CHECK: - dup 1
// CHECK-NEXT: {{^[ +] *}}push 0
// CHECK-NEXT: {{^[ +] *}}mstore
// CHECK-NEXT: - push 0
// CHECK-NEXT: - mstore
bb1:
  pop
  push 64
  calldataload
  push 32
  calldataload
  dup 1
  push 0
  mstore
  push 0
  mstore
  msize
  push 0
  mload
  push 0
  mstore
  push 32
  mstore
  push 64
  mstore
  push 96
  push 0
  return

// The copied value is consumed while the unrelated incoming prefix survives.
// CHECK-LABEL: {{^[ +] *}}bb2:
// CHECK: - dup 1
// CHECK-NEXT: {{^[ +] *}}push 33
// CHECK-NEXT: {{^[ +] *}}mstore
// CHECK-NEXT: - push 33
// CHECK-NEXT: - mstore
bb2:
  pop
  push 64
  calldataload
  push 32
  calldataload
  dup 1
  push 33
  mstore
  push 33
  mstore
  msize
  push 33
  mload
  push 0
  mstore
  push 32
  mstore
  push 64
  mstore
  push 96
  push 0
  return

// The copied value is consumed while the unrelated incoming prefix survives.
// CHECK-LABEL: {{^[ +] *}}bb3:
// CHECK: - dup 1
// CHECK-NEXT: {{^[ +] *}}push 256
// CHECK-NEXT: {{^[ +] *}}mstore
// CHECK-NEXT: - push 256
// CHECK-NEXT: - mstore
bb3:
  pop
  push 64
  calldataload
  push 32
  calldataload
  dup 1
  push 256
  mstore
  push 256
  mstore
  msize
  push 256
  mload
  push 0
  mstore
  push 32
  mstore
  push 64
  mstore
  push 96
  push 0
  return

// The copied value is consumed while the unrelated incoming prefix survives.
// CHECK-LABEL: {{^[ +] *}}bb4:
// CHECK: - dup 1
// CHECK-NEXT: - push 0x10000
// CHECK-NEXT: - mstore
// CHECK-NEXT: {{^[ +] *}}push 0x10000
// CHECK-NEXT: {{^[ +] *}}mstore
// CHECK-NEXT: {{^[ +] *}}msize
bb4:
  pop
  push 64
  calldataload
  push 32
  calldataload
  dup 1
  push 65536
  mstore
  push 65536
  mstore
  msize
  push 65536
  mload
  push 0
  mstore
  push 32
  mstore
  push 64
  mstore
  push 96
  push 0
  return
