//@ compile-flags: -Zevm-ir-pipeline=terminal-prefixes
//@ filecheck:
@module TerminalRegion

bb0:
  push 99
  jump bb1
// CHECK-LABEL: bb1:
// CHECK-NEXT: -   pop
// CHECK: calldatasize
bb1:
  pop
  calldatasize
  jumpi bb2, bb3
bb2:
  push 7
  push 0
  mstore
  push 32
  push 0
  return
bb3:
  push 0
  push 0
  revert
