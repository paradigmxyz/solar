//@ revisions: gas size legacy
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-prefixes
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=terminal-prefixes
//@[legacy] compile-flags: -Ogas --evm-version homestead -Zevm-ir-pipeline=terminal-prefixes
//@ filecheck:
@module terminal_pair_exchange_guards

// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 11{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 22{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 128{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}swap 1{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 160{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 64{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 128{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}return{{$}}
bb0:
  push 11
  push 22
  push 128
  swap 1
  mstore
  push 160
  mstore
  push 64
  push 128
  return

// CHECK-LABEL: {{^[ +] *}}bb1:
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 99{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 11{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 128{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}exchange 1, 2{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 32{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 128{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}return{{$}}
bb1:
  push 99
  push 11
  push 128
  exchange 1, 2
  mstore
  push 32
  push 128
  return

// CHECK-LABEL: {{^[ +] *}}bb2:
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 11{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 128{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 1{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 50{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}gas !metadata(keep_with_next){{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}sub !metadata(keep_with_next){{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}call{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}pop{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 22{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 160{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 64{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 128{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}return{{$}}
bb2:
  push 11
  push 128
  mstore
  push 0
  push 0
  push 0
  push 0
  push 0
  push 1
  push 50
  gas !meta(keep_with_next)
  sub !meta(keep_with_next)
  call
  pop
  push 22
  push 160
  mstore
  push 64
  push 128
  return
