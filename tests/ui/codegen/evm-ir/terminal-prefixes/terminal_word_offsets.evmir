//@ filecheck:
@module terminal_word_offsets

// Only positive offsets through 128 are compacted, including unaligned offsets.
// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK-NOT: {{^[ +]}}
// CHECK: {{^[ +] *}}push 7{{$}}
// CHECK-NOT: {{^[ +]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +]}}
// CHECK: {{^[ +] *}}push 32{{$}}
// CHECK-NOT: {{^[ +]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +]}}
// CHECK: {{^[ +] *}}return{{$}}
bb0:
  push 7
  push 0
  mstore
  push 32
  push 0
  return

