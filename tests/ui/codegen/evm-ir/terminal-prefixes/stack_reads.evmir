//@ compile-flags: --evm-version osaka -Zevm-ir-pipeline=terminal-prefixes,terminal-prefixes,terminal-prefixes
//@ filecheck:
@module TerminalPrefixStackReads

// Repeat the pass so one changed region cannot hide the other two cases.
bb0:
  push 0
  calldataload
  push 0
  eq
  jumpi bb1, bb3
bb1:
  push 99
  push 42
  jump bb2
// DUP reads an incoming word despite having zero consumed operands.
// The return word must be 99, not 42.
// CHECK-LABEL: bb2:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}dup 1
bb2:
  pop
  dup 1
  push 0
  mstore
  push 32
  push 0
  return
bb3:
  push 0
  calldataload
  push 1
  eq
  jumpi bb4, bb6
bb4:
  push 99
  push 7
  push 42
  jump bb5
// SWAP reads below locally produced words despite preserving stack height.
// The return word must be 99, not 7.
// CHECK-LABEL: bb5:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}push 1
// CHECK-NEXT: {{^    }}swap 2
bb5:
  pop
  push 1
  swap 2
  push 0
  mstore
  push 32
  push 0
  return
bb6:
  push 99
  push 7
  push 42
  jump bb7
// EXCHANGE's second read can reach into the incoming prefix.
// The return word must be 7, not 42.
// CHECK-LABEL: bb7:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}push 1
// CHECK-NEXT: {{^    }}push 2
// CHECK-NEXT: {{^    }}exchange 1, 2
bb7:
  pop
  push 1
  push 2
  exchange 1, 2
  pop
  push 0
  mstore
  push 32
  push 0
  return
