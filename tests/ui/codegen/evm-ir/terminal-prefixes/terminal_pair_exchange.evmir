//@ revisions: gas size legacy
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-prefixes
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=terminal-prefixes
//@[legacy] compile-flags: -Ogas --evm-version homestead -Zevm-ir-pipeline=terminal-prefixes
//@ filecheck:
@module terminal_pair_exchange

// Complete return remains first=11, second=22; stack permutation stays in place.
// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 11{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 22{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}exchange 1, 2{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 32{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}mstore{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 64{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}push 0{{$}}
// CHECK-NOT: {{^[ +] *}}{{[^- ]}}
// CHECK: {{^[ +] *}}return{{$}}
bb0:
  push 11
  push 22
  push 128
  exchange 1, 2
  mstore
  push 160
  mstore
  push 64
  push 128
  return

