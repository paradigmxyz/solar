//@ revisions: gas size legacy
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-prefixes
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=terminal-prefixes
//@[legacy] compile-flags: -Ogas --evm-version homestead -Zevm-ir-pipeline=terminal-prefixes
//@ filecheck:
@module terminal_multi_code_observer

// Complete four-word coverage still respects module-wide code observations.
// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK-NOT: {{^[+-]}}
bb0:
  push 11
  push 128
  mstore
  push 22
  push 160
  mstore
  push 33
  push 192
  mstore
  push 44
  push 224
  mstore
  push 128
  dup 1
  return

// Even a separate code-copy and external-code observer prevents relocation.
// CHECK-LABEL: {{^[ +] *}}bb1:
// CHECK-NOT: {{^[+-]}}
bb1:
  push 4
  push_data 0
  push 0
  codecopy
  push 0
  extcodesize
  pop
  stop

@data 0 hex"11223344"
