//@ compile-flags: -Zevm-ir-pipeline=terminal-prefixes
@module CumulativeTerminalCapacity

// Removing bb1's POP raises bb2's entry from 1022 to 1023 words. Its
// remaining POP must stay or its two return operands overflow the stack.
bb0:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  jump bb1

bb1:
  pop
  push 7
  jump bb2

bb2:
  pop
  push 0
  push 0
  return
