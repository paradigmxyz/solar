//@ compile-flags: -Zevm-ir-pipeline=terminal-prefixes
//@ filecheck:
@module TerminalRegionGuards

bb0:
  push 99
  calldatasize
  jumpi bb1, bb2
// Observable program position prevents removing the incoming prefix.
// CHECK-LABEL: bb1:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}pc
bb1:
  pop
  pc
  push 0
  mstore
  stop
bb2:
  calldatasize
  jumpi bb3, bb12
// CHECK-LABEL: bb3:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}gas
bb3:
  pop
  gas
  push 0
  mstore
  stop
bb4:
  calldatasize
  jumpi bb5, bb7
// A prefix entering a loop is outside the acyclic proof.
// CHECK-LABEL: bb5:
// CHECK-NEXT: {{^    }}pop
bb5:
  pop
  jump bb6
bb6:
  calldatasize
  jumpi bb6, bb9
bb7:
  pop
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->4)
  jump bb8
// A retained word would overflow the explicit outgoing jump's label push.
// CHECK-LABEL: bb8:
// CHECK-NEXT: {{^    }}pop
bb8:
  pop
  jump bb10
bb9:
  stop
bb10:
  stop
// Code-relative reads remain observations even in a terminal region.
// CHECK-LABEL: bb11:
// CHECK-NEXT: {{^    }}pop
// CHECK-NEXT: {{^    }}codesize
bb11:
  pop
  codesize
  push 0
  mstore
  stop
bb12:
  calldatasize
  jumpi bb11, bb14
// CHECK-LABEL: bb13:
// CHECK-NEXT: {{^    }}pop
bb13:
  pop
  push 32
  push 0
  push 0
  codecopy
  push 32
  push 0
  return
bb14:
  calldatasize
  jumpi bb13, bb4
