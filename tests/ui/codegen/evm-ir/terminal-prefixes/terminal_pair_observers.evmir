//@ revisions: gas size legacy
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-prefixes
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=terminal-prefixes
//@[legacy] compile-flags: -Ogas --evm-version homestead -Zevm-ir-pipeline=terminal-prefixes
//@ filecheck:
@module terminal_pair_observers

// Intervening memory, gas and call observations are never crossed.
// MLOAD between stores prevents relocation.
// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK-NOT: {{^[+-]}}
bb0:
  push 11
  push 128
  mstore
  push 128
  mload
  push 160
  mstore
  push 64
  push 128
  return

// MSIZE between stores prevents relocation.
// CHECK-LABEL: {{^[ +] *}}bb1:
// CHECK-NOT: {{^[+-]}}
bb1:
  push 11
  push 128
  mstore
  msize
  push 160
  mstore
  push 64
  push 128
  return

// GAS between stores prevents relocation.
// CHECK-LABEL: {{^[ +] *}}bb2:
// CHECK-NOT: {{^[+-]}}
bb2:
  push 11
  push 128
  mstore
  gas
  push 160
  mstore
  push 64
  push 128
  return

// A reserved call between stores prevents relocation.
// CHECK-LABEL: {{^[ +] *}}bb3:
// CHECK-NOT: {{^[+-]}}
bb3:
  push 11
  push 128
  mstore
  push 0
  push 0
  push 0
  push 0
  push 0
  push 1
  push 50
  gas !meta(keep_with_next)
  sub !meta(keep_with_next)
  call
  push 160
  mstore
  push 64
  push 128
  return

// An observation after both stores also prevents relocation.
// CHECK-LABEL: {{^[ +] *}}bb4:
// CHECK-NOT: {{^[+-]}}
bb4:
  push 11
  push 128
  mstore
  push 22
  push 160
  mstore
  push 0
  mload
  pop
  push 64
  push 128
  return
