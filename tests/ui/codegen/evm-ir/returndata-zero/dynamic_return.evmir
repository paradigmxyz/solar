//@ revisions: paris shanghai
//@ compile-flags: -Zevm-ir-pipeline=returndata-zero
//@[paris] compile-flags: --evm-version paris
//@[shanghai] compile-flags: --evm-version shanghai
@module module

// The callee jumps through a label that escapes, into code that makes a call, and that code
// returns to the caller's continuation, which no edge reaches: the continuation keeps its zero.
// A loop head keeps its zero too, since the back edge comes after the call.
bb0:
  push 0
  calldataload
  push bb4
  jumpi
  push bb2
  jump bb1

bb1 [ret=0, inputs=1, outputs=0]:
  push bb3
  jump

bb3:
  push 0
  push 0
  push 0
  push 0
  push 0
  address
  gas
  call
  pop
  jump

bb2 [continuation]:
  push 0
  pop
  stop

bb4:
  push 0
  pop
  push 0
  push 0
  push 0
  push 0
  push 0
  address
  gas
  call
  pop
  push 1
  push bb4
  jumpi
  stop
