//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=terminal-dedup

// The callee returns its observed forwarded gas.
// Sharing the terminal body must not insert a transfer before this observation.
@module TerminalForwardedCall
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 32
  push 0
  push 0
  push 0
  push 0
  push 32
  calldataload
  push 0xffffff
  call
  pop
  push 32
  push 0
  return
bb2:
  push 32
  push 0
  push 0
  push 0
  push 0
  push 32
  calldataload
  push 0xffffff
  call
  pop
  push 32
  push 0
  return
