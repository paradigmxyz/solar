//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup
//@ filecheck:
@module DebugInfo

// Both entries return the same word, and the body pays for sharing. A dynamic
// condition exercises either entry. The shared block cannot unconditionally
// invoke `first`: the other path already invoked `second`. Keep that ambiguous
// checkpoint unknown without introducing executable code for debugging.
bb0:
  calldatasize
  jumpi bb1, bb2

// CHECK-LABEL: + bb1:{{$}}
// CHECK: + push 11 !metadata(spans=[11..15, 31..35])
// CHECK: + return !metadata(spans=[20..25, 40..45])
bb1 [invoke=first@1..10]:
  push 11 !metadata(span=11..15)
  push 0
  mstore
  push 32
  push 0
  return !metadata(span=20..25)

// CHECK-LABEL: {{^ }}bb2 [invoke=second@11..20]:
// CHECK: + jump bb1
bb2 [invoke=second@11..20]:
  push 11 !metadata(span=31..35)
  push 0
  mstore
  push 32
  push 0
  return !metadata(span=40..45)
