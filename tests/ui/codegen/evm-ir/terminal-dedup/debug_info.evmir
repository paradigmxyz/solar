//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup
//@ filecheck:
@module DebugInfo

bb0:
  push 1 !metadata(span=1..5)
  jumpi bb1, bb2 !metadata(span=6..10)

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 0 !metadata(spans=[11..15, 31..35])
// CHECK: {{^[ +].*}}revert !metadata(spans=[20..25, 40..45])
bb1:
  push 0 !metadata(span=11..15)
  dup 1 !metadata(span=16..19)
  revert !metadata(span=20..25)

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: + jump bb1
bb2:
  push 0 !metadata(span=31..35)
  dup 1 !metadata(span=36..39)
  revert !metadata(span=40..45)
