//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup -Zdump=disasm-runtime

// Code positions remain observable in the original terminal body.
@module ObservedTerminal
bb0:
  calldatasize
  jumpi bb1, bb2
bb1:
  pc
  push 0
  mstore
  push 32
  push 0
  return
bb2:
  pc
  push 0
  mstore
  push 32
  push 0
  return
