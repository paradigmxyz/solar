//@compile-flags: -Zevm-ir-pipeline=terminal-dedup
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}indexed_jump bb1, bb2, bb3, bb5
bb0:
  push 1
  indexed_jump bb1, bb2, bb3, bb5

// CHECK-LABEL: + bb1:
// CHECK: {{^[ +].*}}revert
bb1 [cold]:
  push 64
  push 32
  push 0
  revert
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: + jump bb1
bb2:
  push 64
  push 32
  push 0
  revert

// Replacing a shrinking terminal body with a jump would overflow at a 1,024-word entry depth.
bb3:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 1
  push 2
  push 3
  push 4
  jump bb4

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK-NOT: jump
// CHECK-COUNT-5: {{^[ +].*}}pop
bb4:
  pop
  pop
  pop
  pop
  pop
  stop

bb5:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 1
  push 2
  push 3
  push 4
  jump bb6

// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK-NOT: jump
// CHECK-COUNT-5: {{^[ +].*}}pop
bb6:
  pop
  pop
  pop
  pop
  pop
  stop
