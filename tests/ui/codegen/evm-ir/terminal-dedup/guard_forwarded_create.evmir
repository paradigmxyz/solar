//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=terminal-dedup

// The initializer returns its observed gas as the created runtime code.
// Sharing the terminal body must not insert a transfer before this observation.
@module TerminalForwardedCreate
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 7
  push 32
  push 0
  calldatacopy
  push 7
  push 0
  push 0
  create
  push 0
  mstore
  push 32
  push 0
  return
bb2:
  push 7
  push 32
  push 0
  calldatacopy
  push 7
  push 0
  push 0
  create
  push 0
  mstore
  push 32
  push 0
  return
