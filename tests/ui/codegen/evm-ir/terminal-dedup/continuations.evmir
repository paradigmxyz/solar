//@ revisions: dedup simplify
//@[dedup] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-dedup
//@[simplify] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-dedup,cfg-simplify
@module SharedContinuations

bb0:
  push 0
  calldataload
  jumpi bb1, bb2

bb1:
  push bb3
  jump bb5
bb2:
  push bb4
  jump bb5

// Equal nonterminal return bodies can be shared. Conflicting function events are dropped.
bb3 [continuation] [invoke=first@1..10]:
  push 1 !metadata(span=1..3, invoke=first@1..10)
  add
  jump bb6
bb4 [continuation] [invoke=second@11..20]:
  push 1 !metadata(span=11..13, invoke=second@11..20)
  add
  jump bb6

bb5:
  push 9
  swap 1
  jump
bb6:
  push 0
  mstore
  push 32
  push 0
  return

// A direct predecessor prevents sharing a nonterminal continuation body.
bb7:
  jump bb8
bb8 [continuation]:
  push 1
  add
  jump bb6

// Ordinary labels do not grant permission to redirect their numeric values.
bb9:
  push bb10
  jump bb5
bb10:
  push 1
  add
  jump bb6
