//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=late-dce
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=late-dce
//@ filecheck:

@module StoreReloadRefusals

// Unequal overlapping address.
// CHECK-LABEL: {{^[ +]*}}bb0:
// CHECK: {{^[ +]*}}mload
// CHECK-NEXT: {{^[ +]*}}add
bb0:
  push 0
  calldataload
  push 128
  mstore
  push 7
  push 129
  mload
  add
  push 768
  mstore
  jump bb1

// Irreversible subtraction.
// CHECK-LABEL: {{^[ +]*}}bb1:
// CHECK: {{^[ +]*}}mload
// CHECK-NEXT: {{^[ +]*}}sub
bb1:
  push 0
  calldataload
  push 128
  mstore
  push 7
  push 128
  mload
  sub
  push 768
  mstore
  jump bb2

// Intervening MSIZE is consumed.
// CHECK-LABEL: {{^[ +]*}}bb2:
// CHECK: {{^[ +]*}}mload
// CHECK-NEXT: {{^[ +]*}}add
bb2:
  push 0
  calldataload
  push 128
  mstore
  msize
  push 512
  mstore
  push 7
  push 128
  mload
  add
  push 768
  mstore
  jump bb3

// Intervening GAS is consumed.
// CHECK-LABEL: {{^[ +]*}}bb3:
// CHECK: {{^[ +]*}}mload
// CHECK-NEXT: {{^[ +]*}}add
bb3:
  push 0
  calldataload
  push 128
  mstore
  gas
  push 512
  mstore
  push 7
  push 128
  mload
  add
  push 768
  mstore
  jump bb4

// Intervening source write.
// CHECK-LABEL: {{^[ +]*}}bb4:
// CHECK: {{^[ +]*}}mload
// CHECK-NEXT: {{^[ +]*}}add
bb4:
  push 0
  calldataload
  push 128
  mstore
  push 99
  push 129
  mstore
  push 7
  push 128
  mload
  add
  push 768
  mstore
  jump bb5

// Byte store.
// CHECK-LABEL: {{^[ +]*}}bb5:
// CHECK: {{^[ +]*}}mload
// CHECK-NEXT: {{^[ +]*}}add
bb5:
  push 0
  calldataload
  push 128
  mstore8
  push 7
  push 128
  mload
  add
  push 768
  mstore
  push 32
  push 768
  return
