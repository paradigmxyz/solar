//@ compile-flags: -Ogas -Zevm-ir-pipeline=late-dce
//@ filecheck:
@module StoreReloadMetadata
// CHECK-LABEL: bb0:
// CHECK: dup 1
// CHECK: add
bb0:
  push 0
  calldataload
  push 128 !metadata(span=0..1, invoke=reload@1..50)
  mstore !metadata(span=10..11)
  push 7 !metadata(span=20..21)
  push 128 !metadata(span=30..31)
  mload !metadata(span=40..41)
  add !metadata(span=45..46, exit=return)
  push 0
  mstore
  push 32
  push 0
  return
