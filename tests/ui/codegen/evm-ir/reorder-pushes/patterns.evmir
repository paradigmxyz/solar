//@compile-flags: -Zevm-ir-pipeline=reorder-pushes
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK-NEXT: +   push 10
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK: -   swap 1
bb0:
  push 0
  calldataload
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 3
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: +   calldatasize
bb1:
  calldatasize
  push 3
  swap 1
  mod
  stop

// Move the push before the complete nested expression.
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK-NEXT: +   push 10
// CHECK: -   swap 1
bb2:
  push 0
  calldataload
  push 31
  add
  push 10
  swap 1
  sub
  stop

// `gas` and `pc` observe changes caused by moving a push.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^    swap 1}}
bb3:
  gas
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^    swap 1}}
bb4:
  pc
  push 10
  swap 1
  sub
  stop

// A duplicated producer can move after the push by rebasing its depth.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: -   dup 1
// CHECK: {{^[ +].*}}push 10
// CHECK: -   swap 1
// CHECK: +   dup 2
bb5:
  push 1
  dup 1
  push 10
  swap 1
  sub
  stop

// Calls observe the gas spent by any push moved before them.
// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^    swap 1}}
bb6:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  call
  push 10
  swap 1
  sub
  stop

// Returndata size is stable until a call changes it.
// CHECK-LABEL: {{^[ +].*}}bb7:
// CHECK: {{^[ +].*}}push 3
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: +   returndatasize
bb7:
  returndatasize
  push 3
  swap 1
  mod
  stop

// A single streaming pass handles chained candidates.
// CHECK-LABEL: {{^[ +].*}}bb8:
// CHECK: {{^[ +].*}}push 1
// CHECK-NEXT: -   swap 1
// CHECK: {{^[ +].*}}push 2
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: +   calldatasize
bb8:
  calldatasize
  push 1
  swap 1
  push 2
  swap 1
  sub
  stop

// Reorder a deep producer like every other closed expression.
// CHECK-LABEL: {{^[ +].*}}bb9:
// CHECK: +   push 1
// CHECK: -   swap 1
bb9:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->2)
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  sub
  stop

// Chained rewrites move every immediate before the shared producer.
// CHECK-LABEL: {{^[ +].*}}bb10:
// CHECK: +   push 1
// CHECK: +   push 2
// CHECK: -   swap 1
bb10:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  push 2
  swap 1
  sub
  stop

// A cheap rewrite can expose a nested producer for the next candidate.
// CHECK-LABEL: {{^[ +].*}}bb11:
// CHECK-NEXT: -   calldatasize
// CHECK-NEXT: +   push 20
// CHECK: -   swap 1
// CHECK: -   swap 1
bb11:
  calldatasize
  push 10
  swap 1
  sub
  push 20
  swap 1
  sub
  stop

// Do not scan through a nested gas or position observation.
// CHECK-LABEL: {{^[ +].*}}bb12:
// CHECK: {{^    swap 1}}
bb12:
  gas
  push 1
  add
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb13:
// CHECK: {{^    swap 1}}
bb13:
  pc
  push 1
  add
  push 10
  swap 1
  sub
  stop

// A preceding push does not affect memory expansion or access warming.
// CHECK-LABEL: {{^[ +].*}}bb14:
// CHECK-NEXT: +   push 10
// CHECK: -   swap 1
bb14:
  push 0
  mload
  push 10
  swap 1
  sub
  stop

// Storage access warming does not observe the extra stack word.
// CHECK-LABEL: {{^[ +].*}}bb15:
// CHECK-NEXT: +   push 10
// CHECK: -   swap 1
bb15:
  push 0
  sload
  push 10
  swap 1
  sub
  stop

// Long chains stay linear and place every push before the producer.
// CHECK-LABEL: {{^[ +].*}}bb16:
// CHECK-NEXT: -   calldatasize
// CHECK-COUNT-16: -   swap 1
// CHECK-NEXT: +   calldatasize
bb16:
  calldatasize
  push 1
  swap 1
  push 2
  swap 1
  push 3
  swap 1
  push 4
  swap 1
  push 5
  swap 1
  push 6
  swap 1
  push 7
  swap 1
  push 8
  swap 1
  push 9
  swap 1
  push 10
  swap 1
  push 11
  swap 1
  push 12
  swap 1
  push 13
  swap 1
  push 14
  swap 1
  push 15
  swap 1
  push 16
  swap 1
  stop

// Memory expansion can change a prior MSIZE observation, so two read expressions do not commute.
// CHECK-LABEL: {{^[ +].*}}bb17:
// CHECK: {{^    msize}}
// CHECK: {{^    swap 1}}
bb17:
  msize
  push 4096
  mload
  swap 1
  sub
  stop

// Writes and copies are barriers even when their result does not use the extra stack word.
// CHECK-LABEL: {{^[ +].*}}bb18:
// CHECK: {{^    create}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb18:
  push 0
  push 0
  push 0
  create
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb19:
// CHECK: {{^    create2}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb19:
  push 0
  push 0
  push 0
  push 0
  create2
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb20:
// CHECK: {{^    log0}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb20:
  push 0
  push 0
  push 0
  log0
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb21:
// CHECK: {{^    mstore}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb21:
  push 0
  push 0
  push 0
  mstore
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb22:
// CHECK: {{^    sstore}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb22:
  push 0
  push 0
  push 0
  sstore
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb23:
// CHECK: {{^    calldatacopy}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb23:
  push 0
  push 0
  push 0
  push 0
  calldatacopy
  push 10
  swap 1
  sub
  stop
