//@compile-flags: -Zevm-ir-pipeline=reorder-pushes
@module module

bb0:
  push 0
  calldataload
  push 10
  swap 1
  sub
  stop

bb1:
  calldatasize
  push 3
  swap 1
  mod
  stop

// Move the push before the complete nested expression.
bb2:
  push 0
  calldataload
  push 31
  add
  push 10
  swap 1
  sub
  stop

// `gas` and `pc` observe changes caused by moving a push.
bb3:
  gas
  push 10
  swap 1
  sub
  stop

bb4:
  pc
  push 10
  swap 1
  sub
  stop

// Physical stack operations can depend on values below the candidate producer.
bb5:
  push 1
  dup 1
  push 10
  swap 1
  sub
  stop

// Calls observe the gas spent by any push moved before them.
bb6:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  call
  push 10
  swap 1
  sub
  stop

bb7:
  returndatasize
  push 3
  swap 1
  mod
  stop

// A single streaming pass handles chained candidates.
bb8:
  calldatasize
  push 1
  swap 1
  push 2
  swap 1
  sub
  stop

// Moving the push would raise the producer's peak above the EVM stack limit.
bb9:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->2)
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  sub
  stop

// Chained rewrites must account for headroom already spent by an earlier push.
bb10:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  push 2
  swap 1
  sub
  stop

// A cheap rewrite can expose a nested producer for the next candidate.
bb11:
  calldatasize
  push 10
  swap 1
  sub
  push 20
  swap 1
  sub
  stop

// Do not scan through a nested gas or position observation.
bb12:
  gas
  push 1
  add
  push 10
  swap 1
  sub
  stop

bb13:
  pc
  push 1
  add
  push 10
  swap 1
  sub
  stop

// A preceding push does not affect memory expansion or access warming.
bb14:
  push 0
  mload
  push 10
  swap 1
  sub
  stop

bb15:
  push 0
  sload
  push 10
  swap 1
  sub
  stop

// Long chains stay linear and place every push before the producer.
bb16:
  calldatasize
  push 1
  swap 1
  push 2
  swap 1
  push 3
  swap 1
  push 4
  swap 1
  push 5
  swap 1
  push 6
  swap 1
  push 7
  swap 1
  push 8
  swap 1
  push 9
  swap 1
  push 10
  swap 1
  push 11
  swap 1
  push 12
  swap 1
  push 13
  swap 1
  push 14
  swap 1
  push 15
  swap 1
  push 16
  swap 1
  stop
