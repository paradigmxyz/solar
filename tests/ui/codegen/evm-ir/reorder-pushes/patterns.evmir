//@compile-flags: -Zevm-ir-pipeline=reorder-pushes
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK-NEXT: +   push 10
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK: -   swap 1
bb0:
  push 0
  calldataload
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^    gas}}
// CHECK: {{^    swap 1}}
bb1:
  gas
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: -   dup 1
// CHECK: {{^[ +].*}}push 10
// CHECK: -   swap 1
// CHECK: +   dup 2
bb2:
  push 1
  dup 1
  push 10
  swap 1
  sub
  stop

// Memory expansion can change a prior MSIZE observation, so the ranges do not commute.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^    msize}}
// CHECK: {{^    swap 1}}
bb3:
  msize
  push 4096
  mload
  swap 1
  sub
  stop
