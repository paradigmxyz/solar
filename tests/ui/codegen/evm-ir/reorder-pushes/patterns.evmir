//@compile-flags: -Zevm-ir-pipeline=reorder-pushes
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK-NEXT: +   push 10
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK: -   swap 1
bb0:
  push 0
  calldataload
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 3
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: +   calldatasize
bb1:
  calldatasize
  push 3
  swap 1
  mod
  stop

// Move the push before the complete nested expression.
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK-NEXT: +   push 10
// CHECK: -   swap 1
bb2:
  push 0
  calldataload
  push 31
  add
  push 10
  swap 1
  sub
  stop

// `gas` and `pc` observe changes caused by moving a push.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^    swap 1}}
bb3:
  gas
  push 10
  swap 1
  sub
  stop

bb4:
  pc
  push 10
  swap 1
  sub
  stop

// Physical stack operations can depend on values below the candidate producer.
bb5:
  push 1
  dup 1
  push 10
  swap 1
  sub
  stop

// Calls observe the gas spent by any push moved before them.
bb6:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  call
  push 10
  swap 1
  sub
  stop

bb7:
  returndatasize
  push 3
  swap 1
  mod
  stop

// A single streaming pass handles chained candidates.
bb8:
  calldatasize
  push 1
  swap 1
  push 2
  swap 1
  sub
  stop

// Moving the push would raise the producer's peak above the EVM stack limit.
// CHECK-LABEL: {{^[ +].*}}bb9:
// CHECK: {{^    swap 1}}
bb9:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->2)
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  sub
  stop

// Chained rewrites must account for headroom already spent by an earlier push.
// CHECK-LABEL: {{^[ +].*}}bb10:
// CHECK: +   push 1
// CHECK: -   swap 1
// CHECK: {{^    swap 1}}
bb10:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  push 2
  swap 1
  sub
  stop

// A cheap rewrite can expose a nested producer for the next candidate.
// CHECK-LABEL: {{^[ +].*}}bb11:
// CHECK-NEXT: -   calldatasize
// CHECK-NEXT: +   push 20
// CHECK: -   swap 1
// CHECK: -   swap 1
bb11:
  calldatasize
  push 10
  swap 1
  sub
  push 20
  swap 1
  sub
  stop

// Do not scan through a nested gas or position observation.
bb12:
  gas
  push 1
  add
  push 10
  swap 1
  sub
  stop

bb13:
  pc
  push 1
  add
  push 10
  swap 1
  sub
  stop

// A preceding push does not affect memory expansion or access warming.
// CHECK-LABEL: {{^[ +].*}}bb14:
// CHECK-NEXT: +   push 10
// CHECK: -   swap 1
bb14:
  push 0
  mload
  push 10
  swap 1
  sub
  stop

bb15:
  push 0
  sload
  push 10
  swap 1
  sub
  stop

// Long chains stay linear and place every push before the producer.
// CHECK-LABEL: {{^[ +].*}}bb16:
// CHECK-NEXT: -   calldatasize
// CHECK-COUNT-16: -   swap 1
// CHECK-NEXT: +   calldatasize
bb16:
  calldatasize
  push 1
  swap 1
  push 2
  swap 1
  push 3
  swap 1
  push 4
  swap 1
  push 5
  swap 1
  push 6
  swap 1
  push 7
  swap 1
  push 8
  swap 1
  push 9
  swap 1
  push 10
  swap 1
  push 11
  swap 1
  push 12
  swap 1
  push 13
  swap 1
  push 14
  swap 1
  push 15
  swap 1
  push 16
  swap 1
  stop
