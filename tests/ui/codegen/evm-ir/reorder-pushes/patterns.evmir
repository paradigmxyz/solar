//@compile-flags: -Zevm-ir-pipeline=reorder-pushes
@module module

bb0:
  push 0
  calldataload
  push 10
  swap1
  sub
  stop

bb1:
  calldatasize
  push 3
  swap1
  mod
  stop

// Move the push before the complete nested expression.
bb2:
  push 0
  calldataload
  push 31
  add
  push 10
  swap1
  sub
  stop

// `gas` and `pc` observe changes caused by moving a push.
bb3:
  gas
  push 10
  swap1
  sub
  stop

bb4:
  pc
  push 10
  swap1
  sub
  stop

// Physical stack operations can depend on values below the candidate producer.
bb5:
  push 1
  dup1
  push 10
  swap1
  sub
  stop

// Calls observe the gas spent by any push moved before them.
bb6:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  call
  push 10
  swap1
  sub
  stop

bb7:
  returndatasize
  push 3
  swap1
  mod
  stop
