//@compile-flags: -Zevm-ir-pipeline=reorder-pushes
//@filecheck:
@module ReorderBarriers

// `GAS` and `PC` observe an earlier push.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^    gas}}
// CHECK: {{^    swap 1}}
bb0:
  gas
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^    pc}}
// CHECK: {{^    swap 1}}
bb1:
  pc
  push 10
  swap 1
  sub
  stop

// Calls observe the gas spent by an earlier push.
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^    call}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb2:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  push 0
  call
  push 10
  swap 1
  sub
  stop

// Returndata size is stable until a call changes it.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}push 3
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: +   returndatasize
bb3:
  returndatasize
  push 3
  swap 1
  mod
  stop

// Nested observations remain barriers.
// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^    gas}}
// CHECK: {{^    swap 1}}
bb4:
  gas
  push 1
  add
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^    pc}}
// CHECK: {{^    swap 1}}
bb5:
  pc
  push 1
  add
  push 10
  swap 1
  sub
  stop

// Memory expansion can change a prior MSIZE observation, so the ranges do not commute.
// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK: {{^    msize}}
// CHECK: {{^    swap 1}}
bb6:
  msize
  push 4096
  mload
  swap 1
  sub
  stop

// Writes and copies are barriers even when their result does not use the extra stack word.
// CHECK-LABEL: {{^[ +].*}}bb7:
// CHECK: {{^    create}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb7:
  push 0
  push 0
  push 0
  create
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb8:
// CHECK: {{^    create2}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb8:
  push 0
  push 0
  push 0
  push 0
  create2
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb9:
// CHECK: {{^    log0}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb9:
  push 0
  push 0
  push 0
  log0
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb10:
// CHECK: {{^    mstore}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb10:
  push 0
  push 0
  push 0
  mstore
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb11:
// CHECK: {{^    sstore}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb11:
  push 0
  push 0
  push 0
  sstore
  push 10
  swap 1
  sub
  stop

// CHECK-LABEL: {{^[ +].*}}bb12:
// CHECK: {{^    calldatacopy}}
// CHECK-NEXT: {{^    push 10}}
// CHECK-NEXT: {{^    swap 1}}
bb12:
  push 0
  push 0
  push 0
  push 0
  calldatacopy
  push 10
  swap 1
  sub
  stop
