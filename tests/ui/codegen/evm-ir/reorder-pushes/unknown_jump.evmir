//@ compile-flags: -Zevm-ir-pipeline=reorder-pushes,block-layout
//@ filecheck:
@module UnknownJump

// An unknown dynamic edge can carry this prefix into any block, so a
// peak-raising rewrite cannot rely on the block's structural entry depth.
bb0:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push bb1
  push 0
  add
  jump
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^    swap 1}}
bb1:
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  sub
  stop

// The current non-fallthrough jump cannot provide headroom: block layout may make it fall through.
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^    swap 1}}
bb2:
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  jump bb4
bb3:
  stop
bb4:
  stop

// A fallthrough jump adds no lowering headroom, so the matching rewrite stays blocked.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^    swap 1}}
bb5:
  calldatasize
  calldatasize
  add
  push 1
  swap 1
  jump bb6
bb6:
  stop

// Block layout makes bb4 the fallthrough successor of bb2. The earlier rewrite must remain
// blocked instead of relying on the target push that this layout removes.
// CHECK-LABEL: after block-layout
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^    swap 1}}
