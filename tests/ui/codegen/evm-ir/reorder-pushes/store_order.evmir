//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=reorder-pushes
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=reorder-pushes
//@[gas] filecheck: --check-prefixes=CHECK,GAS
//@[size] filecheck: --check-prefixes=CHECK,SIZE
@module StoreOrder

// Preserve address-last store preparation for packing and common-prefix outlining.
// CHECK-LABEL: @module StoreOrder
// CHECK-NOT: {{^[+-]   }}
bb0:
  push 64
  dup 1
  push 42
  swap 1
  mstore
  jump bb1
bb1:
  dup 1
  push 23
  swap 1
  mstore8
  jump bb2
bb2:
  dup 1
  push 0x100000000000000000000000000000000
  swap 1
  mstore
  stop

// Gas mode removes zero-initialization swaps; size retains shared store prefixes.
// CHECK-LABEL: bb3:
// GAS: -   dup 1
// GAS: {{^[ +].*}}push 0
// GAS: -   swap 1
// GAS: +   dup 2
// SIZE: {{^    }}dup 1
// SIZE-NEXT: {{^    }}push 0
// SIZE-NEXT: {{^    }}swap 1
// CHECK: {{^[ +].*}}mstore
bb3:
  push 64
  dup 1
  push 0
  swap 1
  mstore
  stop
