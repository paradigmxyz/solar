//@ revisions: pushes expressions
//@[pushes] compile-flags: -Zevm-ir-pipeline=reorder-pushes -Zvalidate-ir=true
//@[expressions] compile-flags: -Zevm-ir-pipeline=reorder-expressions -Zvalidate-ir=true
//@ filecheck:
@module ReorderStackLimit

// Moving the literal before a two-word producer would overflow the stack.
// CHECK-LABEL: {{^[ +].*}}bb0 [stack=1022]:
// CHECK: {{^    swap 1}}
bb0 [stack=1022]:
  calldatasize
  push 1
  add
  push 3
  swap 1
  pop
  pop
  stop

// One word of headroom preserves the ordinary rewrite.
// CHECK-LABEL: {{^[ +].*}}bb1 [stack=1021]:
// CHECK: -   swap 1
bb1 [stack=1021]:
  calldatasize
  push 1
  add
  push 3
  swap 1
  pop
  pop
  stop

// A one-word producer can still move at the limit: neither order has a higher peak.
// CHECK-LABEL: {{^[ +].*}}bb2 [stack=1022]:
// CHECK: -   swap 1
bb2 [stack=1022]:
  calldatasize
  push 3
  swap 1
  pop
  pop
  stop

// Track the entire nested producer, rather than only its last operation.
// CHECK-LABEL: {{^[ +].*}}bb3 [stack=1021]:
// CHECK: {{^    swap 1}}
bb3 [stack=1021]:
  calldatasize
  calldatasize
  calldatasize
  add
  add
  push 3
  swap 1
  pop
  pop
  stop

// Equal two-word expression peaks make this rewrite safe at the limit.
// CHECK-LABEL: {{^[ +].*}}bb4 [stack=1021]:
// CHECK: -   swap 1
bb4 [stack=1021]:
  calldatasize
  push 1
  add
  push 0
  not
  push 1
  shr
  swap 1
  pop
  pop
  stop

// A copied jump target has no proved entry bound, so do not grow its peak.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^    swap 1}}
bb5:
  calldatasize
  push 1
  add
  push 3
  swap 1
  pop
  pop
  stop
bb6 [stack=1021]:
  push bb5
  dup 1
  jump

// Account for words consumed earlier in the block.
// CHECK-LABEL: {{^[ +].*}}bb7 [stack=1023]:
// CHECK: -   swap 1
bb7 [stack=1023]:
  pop
  pop
  calldatasize
  push 1
  add
  push 3
  swap 1
  pop
  pop
  stop

// The first two chained swaps fit, but moving the third push would overflow.
// CHECK-LABEL: {{^[ +].*}}bb8 [stack=1020]:
// CHECK-COUNT-2: -   swap 1
// CHECK: {{^    swap 1}}
bb8 [stack=1020]:
  calldatasize
  push 1
  add
  push 10
  swap 1
  push 20
  swap 1
  push 30
  swap 1
  pop
  pop
  pop
  pop
  stop
