//@ compile-flags: -Zevm-ir-pipeline=peephole
//@ filecheck:
@module PeepholeIszero

// `push 0; lt; iszero` becomes one `iszero`, which produces the old `iszero`'s output and so takes
// its context. The `push` and the `lt` take their origins with them.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +] *}}iszero !metadata(span=21..25){{$}}
bb0:
  calldatasize
  push 0 !metadata(span=1..5)
  lt !metadata(span=11..15)
  iszero !metadata(span=21..25)
  stop

// `eq; iszero; push; jumpi` becomes `sub; push; jumpi`. The `sub` keeps the `eq`'s context, as in
// solc's peephole optimizer, and the removed `iszero` takes its origin with it.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: + sub !metadata(span=31..35){{$}}
// CHECK-NEXT: {{^[ +] *}}push bb2 !metadata(span=45..49){{$}}
bb1:
  calldatasize
  caller
  eq !metadata(span=31..35)
  iszero !metadata(span=36..40)
  push bb2 !metadata(span=45..49)
  jumpi !metadata(span=50..55)
  stop
bb2:
  stop
