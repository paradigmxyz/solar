//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:
@module ExposedDataAddress

// The appended-data address is an observable numeric value even without CODECOPY.
// Removing a duplicate exit must not change the pointer stored on the stop path.
// CHECK-LABEL: bb0:
// CHECK: push_data 0
// CHECK: jumpi bb1, bb2
bb0:
  push_data 0
  push 0
  sstore
  callvalue
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK: revert
bb1:
  push 0
  push 0
  revert
// CHECK-LABEL: bb2:
// CHECK: jumpi bb3, bb4
bb2:
  calldatasize
  jumpi bb3, bb4
// CHECK-LABEL: bb3:
// CHECK: revert
bb3:
  push 0
  push 0
  revert
bb4:
  stop

@data 0 hex"01020304"
