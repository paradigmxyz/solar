//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:

// The external callee at0x1000 returns its first GAS value. Giving bb1 a new
// JUMPDEST reduces forwarded gas on the false path and changes this return.
@module ForwardedOwnerGas
bb0:
  callvalue
  jumpi bb2, bb1
// CHECK-LABEL: {{^  }}bb1:
// CHECK: {{^    }}call
// CHECK: {{^    }}return
bb1:
  push 32
  push 0
  push 0
  push 0
  push 0
  push 4096
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  call
  pop
  push 32
  push 0
  return
// CHECK-LABEL: {{^  }}bb2:
// CHECK: {{^    }}call
// CHECK: {{^    }}return
bb2:
  push 32
  push 0
  push 0
  push 0
  push 0
  push 4096
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  call
  pop
  push 32
  push 0
  return
