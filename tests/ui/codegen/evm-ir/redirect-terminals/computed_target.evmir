//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:
@module ComputedTarget

// An unknown physical target can still reach the otherwise duplicated exit.
// CHECK-LABEL: bb0:
// CHECK: jumpi bb1, bb2
bb0:
  callvalue
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK: revert
bb1:
  push 0
  push 0
  revert
// CHECK-LABEL: bb2:
// CHECK: jumpi bb3, bb4
bb2:
  calldatasize
  jumpi bb3, bb4
// CHECK-LABEL: bb3:
// CHECK: revert
bb3:
  push 0
  push 0
  revert
bb4:
  push 0
  calldataload
  jump
