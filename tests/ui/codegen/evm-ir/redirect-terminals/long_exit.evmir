//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:
@module ShareLongTakenExit

// Share the complete physical body, including its memory write. The owner
// already has a taken label; bb2's false edge stays in place.
// CHECK-LABEL: bb0:
// CHECK: jumpi bb1, bb2
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK-NEXT: push 42
// CHECK-NEXT: push 0
// CHECK-NEXT: mstore
// CHECK-NEXT: push 32
// CHECK-NEXT: push 0
// CHECK-NEXT: return
bb1:
  push 42
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: bb2:
// CHECK-NEXT: push 32
// CHECK-NEXT: calldataload
// CHECK: jumpi bb1, bb1
// CHECK-NOT: bb3:
bb2:
  push 32
  calldataload
  jumpi bb3, bb1
bb3:
  push 42
  push 0
  mstore
  push 32
  push 0
  return
