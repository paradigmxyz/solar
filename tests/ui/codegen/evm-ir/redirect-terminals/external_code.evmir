//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:
@module ExposedExternalCode

// An external code query can target this contract itself. The stored code hash
// must not change when the other taken exits happen to have identical bodies.
// CHECK-LABEL: bb0:
// CHECK: address
// CHECK-NEXT: extcodehash
// CHECK: jumpi bb1, bb2
bb0:
  address
  extcodehash
  push 0
  sstore
  callvalue
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK: revert
bb1:
  push 0
  push 0
  revert
// CHECK-LABEL: bb2:
// CHECK: jumpi bb3, bb4
bb2:
  calldatasize
  jumpi bb3, bb4
// CHECK-LABEL: bb3:
// CHECK: revert
bb3:
  push 0
  push 0
  revert
bb4:
  stop

