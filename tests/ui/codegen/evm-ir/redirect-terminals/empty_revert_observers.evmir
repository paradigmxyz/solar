//@ revisions: gas size paris
//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@[paris] compile-flags: -Ogas --evm-version paris
//@ filecheck:
@module EmptyRevertObserver
// The existing call reserve remains glued; only an already taken empty exit moves.
// CHECK-LABEL: {{^[ +] *}}bb0:
// CHECK: gas !metadata(keep_with_next)
// CHECK-NEXT: {{^[ +] *}}sub !metadata(keep_with_next)
// CHECK-NEXT: {{^[ +] *}}call{{$}}
bb0:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 4096
  push 50
  gas !metadata(keep_with_next)
  sub !metadata(keep_with_next)
  call
  pop
  gas
  push 128
  mstore
  callvalue
  jumpi bb1, bb2
// Conflicting invocations disappear; both real source span sets survive.
// CHECK-LABEL: {{^[ +] *}}bb1 [cold]:
// CHECK: push 0 !metadata(spans=[10..11, 30..31])
// CHECK: revert !metadata(spans=[12..13, 32..33])
bb1 [cold, invoke=first@10..20]:
  push 0 !metadata(span=10..11)
  push 0 !metadata(span=11..12)
  revert !metadata(span=12..13)
// CHECK-LABEL: {{^[ +] *}}bb2:
// CHECK: + {{ *}}jumpi bb1, bb4
// CHECK-NOT: {{^[ +] *}}bb3
// CHECK: {{^[ +] *}}bb4:
bb2:
  calldatasize
  jumpi bb3, bb4
bb3 [cold, invoke=second@30..40]:
  push 0 !metadata(span=30..31)
  push 0 !metadata(span=31..32)
  revert !metadata(span=32..33)
bb4:
  gas
  push 160
  mstore
  callvalue
  jumpi bb5, bb6
// Both payload bodies retain their separate targets under GAS observation.
// CHECK-LABEL: {{^[ +] *}}bb5:
// CHECK-LABEL: {{^[ +] *}}bb7:
bb5:
  push 32
  push 0
  revert
bb6:
  calldatasize
  jumpi bb7, bb8
bb7:
  push 32
  push 0
  revert
bb8:
  callvalue
  jumpi bb9, bb10
// Both return bodies retain their separate targets under GAS observation.
// CHECK-LABEL: {{^[ +] *}}bb9:
// CHECK-LABEL: {{^[ +] *}}bb11:
bb9:
  push 0
  push 0
  return
bb10:
  calldatasize
  jumpi bb11, bb12
bb11:
  push 0
  push 0
  return
bb12:
  callvalue
  jumpi bb13, bb14
// Both push_metadata bodies retain their separate targets under GAS observation.
// CHECK-LABEL: {{^[ +] *}}bb13:
// CHECK-LABEL: {{^[ +] *}}bb15:
bb13:
  push 0 !metadata(stack=0->1)
  push 0
  revert
bb14:
  calldatasize
  jumpi bb15, bb16
bb15:
  push 0 !metadata(stack=0->1)
  push 0
  revert
bb16:
  callvalue
  jumpi bb17, bb18
// Both term_metadata bodies retain their separate targets under GAS observation.
// CHECK-LABEL: {{^[ +] *}}bb17:
// CHECK-LABEL: {{^[ +] *}}bb19:
bb17:
  push 0
  push 0
  revert !metadata(stack=2->0)
bb18:
  calldatasize
  jumpi bb19, bb20
bb19:
  push 0
  push 0
  revert !metadata(stack=2->0)
bb20:
  push 64
  push 128
  return
