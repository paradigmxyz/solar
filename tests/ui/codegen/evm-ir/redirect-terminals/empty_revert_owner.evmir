//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals -Ogas
//@ filecheck:
@module EmptyRevertObserver
bb0:
  gas
  push 128
  mstore
  callvalue
  jumpi bb2, bb1
// CHECK-LABEL: {{^[ +] *}}bb1 [cold]:
bb1 [cold]:
  push 0
  push 0
  revert
bb2:
  calldatasize
  jumpi bb3, bb4
// CHECK-LABEL: {{^[ +] *}}bb3 [cold]:
bb3 [cold]:
  push 0
  push 0
  revert
bb4:
  gas
  push 160
  mstore
  push 64
  push 128
  return
