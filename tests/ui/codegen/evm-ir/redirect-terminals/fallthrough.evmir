//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:
@module PreserveFallthrough

// bb1 already has a taken edge and is also bb2's false successor. Redirect
// only the taken duplicate; preserve that false edge and the existing label.
// CHECK-LABEL: bb0:
// CHECK: jumpi bb1, bb2
bb0:
  callvalue
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK: revert
bb1:
  push 0
  push 0
  revert
// CHECK-LABEL: bb2:
// CHECK-NEXT: calldatasize
// CHECK: jumpi bb1, bb1
// CHECK-NOT: bb3:
bb2:
  calldatasize
  jumpi bb3, bb1
bb3:
  push 0
  push 0
  revert
