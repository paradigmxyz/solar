//@ compile-flags: -Zevm-ir-pipeline=redirect-terminals
//@ filecheck:
@module PreserveFallthrough

// bb1 is also a false successor. Sharing with it could change its preferred
// fallthrough or add a JUMPDEST on an unconditionally entered canonical body.
// CHECK-LABEL: bb0:
// CHECK: jumpi bb1, bb2
bb0:
  callvalue
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK: revert
bb1:
  push 0
  push 0
  revert
// CHECK-LABEL: bb2:
// CHECK: jumpi bb3, bb1
bb2:
  calldatasize
  jumpi bb3, bb1
// CHECK-LABEL: bb3:
// CHECK: revert
bb3:
  push 0
  push 0
  revert
