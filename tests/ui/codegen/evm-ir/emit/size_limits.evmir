//@ revisions: osaka allow amsterdam
//@ compile-flags: --emit=bin-runtime
//@[allow] compile-flags: --allow=5574
//@[amsterdam] compile-flags: --evm-version amsterdam
//@ normalize-stdout-test: "(?s).+" -> ""
//~[osaka]? WARN: contract code size is 24587 bytes and exceeds 24576 bytes

// Bytecode emitted for EVM IR input gets the size warnings of a Solidity contract: here, 24,577
// bytes of data push the runtime code past EIP-170's limit, which Amsterdam raises.
@module program
@data
  0: hex""
bb0:
  push 32
  push_data 0
  push 0
  codecopy
  push 32
  push 0
  return
