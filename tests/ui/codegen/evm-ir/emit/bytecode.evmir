//@ compile-flags: --emit=abi,hashes,bin,bin-runtime

// The program assembles as runtime code, and creation code that copies it from after itself and
// returns it. EVM IR declares no ABI.
@module program
@data
  0: hex"1122"
bb0:
  push 2
  push_data 0
  push 0
  codecopy
  push 32
  push 0
  return
