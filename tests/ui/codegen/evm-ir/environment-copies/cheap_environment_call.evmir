//@ revisions: none gas size
//@ compile-flags: -Zevm-ir-pipeline=environment-copies
//@[none] compile-flags: -Onone
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@ filecheck:
@module EnvironmentBarrier

// A later external call can observe the gas forwarded after preparation.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^ +}}caller
// CHECK-NEXT: {{^ +}}dup 1
bb0:
  caller
  dup 1
  pop
  pop
  push 0
  push 0
  push 0
  push 0
  push 1
  push 10000
  staticcall
  pop
  stop
