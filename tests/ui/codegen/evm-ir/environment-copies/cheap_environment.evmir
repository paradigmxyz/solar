//@ revisions: none gas size
//@ compile-flags: -Zevm-ir-pipeline=environment-copies
//@[none] compile-flags: -Onone
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@[none] filecheck: --check-prefix=NONE
//@[gas] filecheck: --check-prefix=READ
//@[size] filecheck: --check-prefix=READ
@module EnvironmentCopies

// Retain every resident word while copying a non-top environment value. The
// final memory image is [caller, caller, 23, caller, 17], including the original
// caller and both unrelated literals. A second direct read stays a direct read.
// READ-LABEL: {{^[ +].*}}bb0:
// READ: - dup 2 !metadata(span=10..20)
// READ-NEXT: + caller !metadata(span=10..20)
// READ-NEXT: {{^ +}}caller
// NONE-LABEL: {{^[ +].*}}bb0:
// NONE: {{^ +}}dup 2 !metadata(span=10..20)
// NONE-NEXT: {{^ +}}caller
bb0:
  push 17
  caller
  push 23
  dup 2 !metadata(span=10..20)
  caller
  push 0
  mstore
  push 32
  mstore
  push 64
  mstore
  push 96
  mstore
  push 128
  mstore
  push 160
  push 0
  return

// NUMBER is deliberately outside this rereading policy.
// READ-LABEL: {{^[ +].*}}bb1:
// READ: {{^ +}}number
// READ-NEXT: {{^ +}}dup 1
// NONE-LABEL: {{^[ +].*}}bb1:
// NONE: {{^ +}}number
// NONE-NEXT: {{^ +}}dup 1
bb1:
  number
  dup 1
  stop

// Mutable or return-data-dependent reads cannot acquire environment recipes.
// READ-LABEL: {{^[ +].*}}bb2:
// READ: {{^ +}}mload
// READ-NEXT: {{^ +}}dup 1
// NONE-LABEL: {{^[ +].*}}bb2:
// NONE: {{^ +}}mload
// NONE-NEXT: {{^ +}}dup 1
bb2:
  push 0
  mload
  dup 1
  stop

// READ-LABEL: {{^[ +].*}}bb3:
// READ: {{^ +}}returndatasize
// READ-NEXT: {{^ +}}dup 1
// NONE-LABEL: {{^[ +].*}}bb3:
// NONE: {{^ +}}returndatasize
// NONE-NEXT: {{^ +}}dup 1
bb3:
  returndatasize
  dup 1
  stop

// Unknown incoming words and inaccessible copies clear local identities. A
// prior CALLER cannot label an unknown word reached after that loss of state.
// READ-LABEL: {{^[ +].*}}bb4:
// READ: {{^ +}}dup 2
// READ-NEXT: {{^ +}}swap 1
// READ-NEXT: {{^ +}}dup 1
// NONE-LABEL: {{^[ +].*}}bb4:
// NONE: {{^ +}}dup 2
// NONE-NEXT: {{^ +}}swap 1
// NONE-NEXT: {{^ +}}dup 1
bb4:
  dup 1
  caller
  dup 2
  swap 1
  dup 1
  stop

// Explicit stack contracts remain attached to their original physical opcode.
// The printer omits this canonical contract, but the DUP must remain a DUP.
// READ-LABEL: {{^[ +].*}}bb5:
// READ: {{^ +}}caller
// READ-NEXT: {{^ +}}dup 1
// NONE-LABEL: {{^[ +].*}}bb5:
// NONE: {{^ +}}caller
// NONE-NEXT: {{^ +}}dup 1
bb5:
  caller
  dup 1 !metadata(stack=0->1)
  stop
