//@ compile-flags: -Ogas -Zevm-ir-pipeline=late-word
@module ShiftPairMaskEvents

// The first shift's count is a copy of the second's, which keeps its function events. The event
// is not repeated on the copy.
bb0:
  push 4
  calldataload
  push 0
  not
  push 96 !metadata(span=1..3, invoke=first@1..10)
  shr
  and !metadata(span=4..6)
  push 0
  mstore
  push 32
  push 0
  return
