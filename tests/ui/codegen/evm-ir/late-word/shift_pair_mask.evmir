@module ShiftPairMask

bb0:
  push 36
  calldataload
  indexed_jump bb1, bb2, bb3, bb4

// A mask built as `PUSH0 NOT PUSH s SHR` costs two gas more than the shift pair that clears the
// same bits, so the pair replaces it.
bb1:
  push 4
  calldataload
  push 0
  not
  push 96
  shr
  and
  push 0
  mstore
  push 32
  push 0
  return

// A literal mask costs less than the pair, so it stays.
bb2:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 0
  mstore
  push 32
  push 0
  return

// A shift count of 256 makes the mask zero, but its two-byte push costs the pair more bytes,
// so the mask stays.
bb3:
  push 4
  calldataload
  push 0
  not
  push 256
  shr
  and
  push 0
  mstore
  push 32
  push 0
  return

// A zero count keeps the whole word; the pair is still cheaper than the mask.
bb4:
  push 4
  calldataload
  push 0
  not
  push 0
  shr
  and
  push 0
  mstore
  push 32
  push 0
  return
