//@ compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=block-cse
//@ filecheck:
@module module

// A `GAS` read holds back no other code: every repeated storage load reuses the first one, but
// each `GAS` read stays.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^ +}}sload
// CHECK-NOT: {{^[ +] ?}}sload
// CHECK: gas
// CHECK-NOT: {{^[ +] ?}}sload
// CHECK: gas
// CHECK-NOT: {{^[ +] ?}}sload
// CHECK: {{^ +}}stop
bb0:
  push 0
  sload
  push 0
  sload
  gas
  push 0
  sload
  gas
  push 0
  sload
  stop

