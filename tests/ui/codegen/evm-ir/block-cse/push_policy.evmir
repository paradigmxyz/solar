//@ compile-flags: -Zevm-ir-pipeline=block-cse
@module module

// Immutable ID zero retains the existing direct-push policy.
bb0:
  push_immutable 0, 32
  push_immutable 0, 32
  stop

// Repeated nonzero immutable IDs can reuse the live placeholder value.
bb1:
  push_immutable 1, 32
  push_immutable 1, 32
  stop

// The same immutable ID with different widths denotes different instructions.
bb2:
  push_immutable 1, 1
  push_immutable 1, 32
  stop

// Literal words and symbolic references with equal numeric IDs stay distinct.
bb3:
  push 1
  push_deferred 1
  push_immutable 1, 32
  stop

// Deferred pushes retain their existing direct-push policy.
bb4:
  push_deferred 1
  push_deferred 1
  stop

// Literal zero stays a push while a repeated nonzero literal can become a dup.
bb5:
  push 0
  push 0
  push 1
  push 1
  stop
