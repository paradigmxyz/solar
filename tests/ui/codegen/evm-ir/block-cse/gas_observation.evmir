//@ compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=block-cse
//@ filecheck:
@module module

// Before any `GAS` read, a repeated storage load reuses the first one; after it, each load stays,
// as dropping a warm `SLOAD` would shrink what the next `GAS` read measures by 100 gas.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: sload
// CHECK: +   dup 1
// CHECK: gas
// CHECK: {{^ +}}sload
// CHECK: gas
// CHECK: {{^ +}}sload
// CHECK: {{^ +}}stop
bb0:
  push 0
  sload
  push 0
  sload
  gas
  push 0
  sload
  gas
  push 0
  sload
  stop

// A known memory word is not forwarded to a load after a `GAS` read either.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: mstore
// CHECK: gas
// CHECK: {{^ +}}mload
bb1:
  push 7
  push 64
  mstore
  gas
  push 64
  mload
  stop
