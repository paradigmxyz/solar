//@ compile-flags: -Zevm-ir-pipeline=stack-reschedule
//@ filecheck:
@module module

// Four unrolled copies of `t += i; i += 1` with one merged overflow check. Each copy computes
// the step from a copy of `i` first and lets the sum consume `i` itself, and the check reads only
// its condition, as its revert reads nothing from the stack, so the run continues through it
// and the last step joins the schedule. The block's shuffles and pushes drop from 20 operations
// to 14, the overflow test becomes its mirror, and the back edge follows the check directly.
// CHECK-LABEL: {{^[ +].*}}bb0 [loop] [stack=3]:
// CHECK: +   gt
// CHECK-NEXT: push bb1
// CHECK-NEXT: jumpi
// CHECK-NOT: {{^[ +] .*(swap|add|push)}}
// CHECK: jump bb0
bb0 [loop, stack=3]:
  dup 2
  dup 2
  add
  swap 2
  push 1
  add
  dup 1
  swap 3
  add
  swap 2
  push 1
  add
  dup 1
  swap 3
  add
  swap 2
  push 1
  add
  dup 1
  swap 3
  add
  swap 1
  dup 2
  lt
  push bb1
  jumpi
  swap 1
  push 1
  add
  swap 1
  jump bb0
bb1 [cold]:
  push 0
  push 0
  revert
