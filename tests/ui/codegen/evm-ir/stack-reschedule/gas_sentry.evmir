//@ compile-flags: -Zevm-ir-pipeline=stack-reschedule
//@ filecheck:
@module module

// An `SSTORE` fails unless more than 2,300 gas is left, so no schedule may spend more gas before
// it. Popping the dead word first would save the two swaps but put the pop above the store; the
// schedule that pops it right after the store saves the same swaps and is kept instead.
// CHECK-LABEL: {{^[ +].*}}bb0 [stack=2]:
// CHECK-NEXT: dup 2
// CHECK-NEXT: push 0
// CHECK-NEXT: sstore
// CHECK-NOT: {{^[ +] }}
// CHECK: {{^[ +] +}}pop
// CHECK-NEXT: push 1
// CHECK-NEXT: add
// CHECK-NOT: {{^[ +] .*swap}}
// CHECK: mstore
bb0 [stack=2]:
  dup 2
  push 0
  sstore
  swap 1
  push 1
  add
  swap 1
  pop
  push 0
  mstore
  stop
