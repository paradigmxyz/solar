//@ run-call: fib(uint256)(uint256) 0 => 0
//@ run-call: fib(uint256)(uint256) 10 => 55
//@ run-call: fib(uint256)(uint256) 90 => 2880067194370816120
//@ run-call: fact(uint256)(uint256) 0 => 1
//@ run-call: fact(uint256)(uint256) 5 => 120
//@ run-call: fact(uint256)(uint256) 20 => 2432902008176640000

// Loops, and a recursive function that returns through the address its caller pushes.
@module control
bb0:
  push 0
  calldataload
  push 224
  shr
  dup 1
  push 0xc6c2ea17
  eq
  push bb2
  jumpi
  dup 1
  push 0x0b95d228
  eq
  push bb6
  jumpi
  jump bb1
bb1 [cold]:
  push 0
  push 0
  revert

// fib(n) iterates `(n, a, b) -> (n - 1, b, a + b)` from `(n, 0, 1)` until `n` is zero.
bb2:
  push 4
  calldataload
  push 0
  push 1
  jump bb3
bb3 [loop]:
  dup 3
  iszero
  jumpi bb5, bb4
bb4 [loop]:
  dup 1
  dup 3
  add
  swap 2
  pop
  swap 1
  swap 2
  push 1
  swap 1
  sub
  swap 2
  jump bb3
bb5:
  pop
  push 0
  mstore
  push 32
  push 0
  return

// fact(n) calls bb7 with its return address below `n`, and bb7 leaves `n!` in place of both.
bb6:
  push bb10
  push 4
  calldataload
  jump bb7
bb7:
  dup 1
  iszero
  push bb9
  jumpi
  dup 1
  push 1
  swap 1
  sub
  push bb8
  swap 1
  jump bb7
bb8 [continuation]:
  mul
  swap 1
  jump
bb9:
  pop
  push 1
  swap 1
  jump
bb10 [continuation]:
  push 0
  mstore
  push 32
  push 0
  return
