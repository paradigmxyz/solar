//@ compile-flags: --evm-version byzantium -Zevm-ir-pipeline=legalize-shifts
//@ filecheck:
@module LegalizeShiftDebugSpans

// A folded factor replaces the shift push and keeps its metadata.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push 2{{$}}
// CHECK-NEXT: + mul !metadata(span=30..40)
// CHECK: + push 2 !metadata(span=50..60)
// CHECK-NEXT: + exp !metadata(span=50..60)
// CHECK-NEXT: + mul !metadata(span=50..60)
bb0:
  push 7
  push 1
  shl !metadata(span=30..40)
  calldatasize
  shl !metadata(span=50..60)
  stop
