//@ compile-flags: -Ogas -Zevm-ir-pipeline=constant-data
//@ filecheck:
@module ConstantDataHeadroom

// An opaque jump can enter bb1 with 1,022 words. The original stores peak at
// 1,024, while CODECOPY would need one more word.
bb0:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push bb1
  not
  not
  jump

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK-NOT: push_data
// CHECK: {{^[ +].*}}mstore
// CHECK: {{^[ +].*}}stop
bb1:
  push 0x112233445566778899aabbccddeeff00112233445566778899aabbccddeeff00
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0xffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100
  swap 1
  mstore
  stop
