//@ compile-flags: -Zevm-ir-pipeline=constant-data
//@ filecheck:
@module ConstantData

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: -   push 0x3333333333333333333333333333333333333333333333333333333333333333
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: -   mstore
// CHECK-NEXT: +   push 96
// CHECK-NEXT: +   push_data literal_0
// CHECK-NEXT: +   dup 3
// CHECK-NEXT: +   codecopy
bb0:
  push 0
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x2222222222222222222222222222222222222222222222222222222222222222
  swap 1
  mstore
  push 64
  dup 2
  add
  push 0x3333333333333333333333333333333333333333333333333333333333333333
  swap 1
  mstore
  stop
