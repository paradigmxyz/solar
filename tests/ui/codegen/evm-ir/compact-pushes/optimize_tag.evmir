//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=compact-pushes
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=compact-pushes
//@ filecheck:
// The contract's size objective selects the repeated-pattern recipe even in a gas build.
@module OptimizeTag
@optimize size

// CHECK-LABEL: bb0:
// CHECK: + push 255
// CHECK-NEXT: + push 0
// CHECK-NEXT: + not
// CHECK-NEXT: + div
bb0:
  push 0x0101010101010101010101010101010101010101010101010101010101010101
  pop
  stop
