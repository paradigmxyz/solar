//@ revisions: size gas
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=compact-pushes
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=compact-pushes
//@[size] filecheck: --check-prefix=SIZE
//@[gas] filecheck: --check-prefix=GAS
@module RepeatedPatterns

// Size-first code divides the all-ones word for a pattern that repeats across it, and multiplies
// the repetition of a one by a repeated factor. Gas builds keep the literals, since the division
// and multiplication would cost gas on every execution.
// SIZE-LABEL: bb0:
// SIZE: + push 255
// SIZE-NEXT: + push 0
// SIZE-NEXT: + not
// SIZE-NEXT: + div
// SIZE-NEXT: + push 48
// SIZE-NEXT: + push 255
// SIZE-NEXT: + push 0
// SIZE-NEXT: + not
// SIZE-NEXT: + div
// SIZE-NEXT: + mul
// GAS-LABEL: bb0:
// GAS-NEXT: push 0x101010101010101010101010101010101010101010101010101010101010101
// GAS-NEXT: push 0x3030303030303030303030303030303030303030303030303030303030303030
bb0:
  push 0x0101010101010101010101010101010101010101010101010101010101010101
  push 0x3030303030303030303030303030303030303030303030303030303030303030
  pop
  pop
  stop
