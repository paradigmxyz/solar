//@ compile-flags: -Ogas --evm-version=cancun -Zevm-ir-pipeline=compact-pushes
//@ filecheck:
@module LiteralCacheUnknown

// An unresolved computed edge clears absolute bounds module-wide. This pins
// the existing adapter refusal, not an isolated new helper capacity predicate.
bb0:
  push 7
  calldatasize
  jumpi bb1, bb2
bb2:
  push 0
  calldataload
  jump

// CHECK-LABEL: {{^[ +] *}}bb1:
// CHECK-COUNT-9: {{^[ +] *}}push 0x123456789abcdef0123456789abcdef0
// CHECK-NOT: {{^[ +] *}}dup
// CHECK: {{^[ +] *}}stop
bb1:
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  push 0x123456789abcdef0123456789abcdef0
  not
  add
  stop
