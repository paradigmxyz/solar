//@ compile-flags: -Osize -Zevm-ir-pipeline=compact-pushes --emit=bin-runtime
@module StackLimit

// The pass does not look at stack depth: the recipe for the repeated byte pattern is emitted at
// 1023 words, and the verifier warns about the peak that follows. A literal there peaks at 1024
// and fits, but exceeding the limit is otherwise a runtime failure, so keeping a literal to avoid
// it is not worth the bytes.
//~? WARN: `push` in block 0 grows the EVM stack to 1025 words
bb0 [stack=1023]:
  push 0x3030303030303030303030303030303030303030303030303030303030303030
  pop
  stop
