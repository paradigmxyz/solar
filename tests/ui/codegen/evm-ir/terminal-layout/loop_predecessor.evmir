//@ revisions: terminal pipeline
//@[terminal] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-layout
//@[pipeline] compile-flags: -Osize -Zevm-ir-pipeline=default
//@[pipeline] filecheck:

@module LoopPredecessor

// The existing predecessor's loop fallthrough remains in place.
bb0:
  push 1
  indexed_jump bb1, bb3, bb3, bb3, bb4
bb1 [loop]:
  push 0
  push 0
  jump bb2
bb2:
  return
bb3:
  push 0
  push 0
  jump bb2

// Moving the cold tail before the loop trace keeps its backedge fallthrough
// and lets the final stop fall off the bytecode.
// CHECK-LABEL: @module LoopPredecessor
// CHECK: {{^[ +]*}}bb4:
// CHECK: {{^[ +]*}}bb5 [loop]:
// CHECK: {{^[ +]*}}bb6 [loop]:
bb4:
  push 4
  jump bb6
bb5 [loop]:
  push 1
  swap 1
  sub
  jump bb6
bb6 [loop]:
  dup 1
  push bb5
  jumpi
  pop
  stop
bb7 [cold]:
  push 0
  push 0
  revert
