// === ROOT/tests/ui/codegen/evm-ir/terminal-layout/loop_predecessor.evmir (after pipeline-default) ===
@module LoopPredecessor
bb0:
  push 1
  indexed_jump bb1, bb1, bb1, bb1, bb4
bb1 [loop]:
  push 0
  push 0
  return
bb4:
  push 4
  jump bb6
bb5 [loop]:
  push 1
  swap 1
  sub
  jump bb6
bb6 [loop]:
  dup 1
  push bb5
  jumpi
  stop
