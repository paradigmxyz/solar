//@ compile-flags: -Ogas -Zevm-ir-pipeline=terminal-layout
//@ filecheck:

@module InlineEdges

// CHECK: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}bb2:
bb0:
  push 1
  push bb3
  jumpi
  push 2
  push bb3
  jumpi
  push 3
  push bb3
  jumpi
  jump bb1
bb1:
  push 0
  push 0
  jump bb2
bb2:
  return
bb3:
  push 0
  push 0
  jump bb2
