//@ compile-flags: -Ogas -Zevm-ir-pipeline=terminal-layout

@module CallerFallthrough

// Moving bb4 would introduce a jump on bb3's existing fallthrough.
bb0:
  push 1
  indexed_jump bb1, bb4, bb4, bb4
bb1:
  push 0
  push 0
  jump bb2
bb2:
  return
bb3:
  jump bb4
bb4:
  push 0
  push 0
  jump bb2
