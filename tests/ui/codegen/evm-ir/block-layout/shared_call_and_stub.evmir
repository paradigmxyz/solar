//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-layout
//@[size] filecheck:
@module shared_call_and_stub

// A one-off direct call shares the return tail with a stub used by two call sites.
// The direct call must not disable the stub's better fallthrough placement.
bb0:
  calldatasize
  jumpi bb7, bb1
bb1:
  push bb6
  jump bb5
bb2:
  push bb6
  jump bb4
bb3:
  push bb6
  jump bb4
// CHECK-LABEL: {{^[ +]*}}bb4:
// CHECK-NEXT: {{^[ +]*}}push 32
// CHECK-NEXT: {{^[ +]*}}pop
// CHECK-NEXT: {{^[ +]*}}jump bb5
// CHECK-NEXT: {{^[ +]*}}bb5:
bb4:
  push 32
  pop
  jump bb5
bb5:
  push 1
  swap 1
  jump
bb6 [continuation]:
  pop
  stop
bb7:
  push 0
  calldataload
  jumpi bb2, bb3
