@module module

// The first stub and the revert tail they share form one cold trace that thirty references reach.
// The other stubs have two references each. Packing ranks traces by references per byte, so the
// tail trace stays at the front, and the stubs that fit in the first 256 bytes follow it.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}bb2 [cold]:
// CHECK: {{^[ +].*}}bb1 [cold]:
// CHECK: {{^[ +].*}}bb3 [cold]:

bb0:
  push 1
  push bb32
  jumpi
  push 1
  push bb33
  jumpi
  stop

bb2 [cold]:
  push 0x10000001
  jump bb1

