//@ revisions: gas size repeat
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-layout
//@[repeat] compile-flags: -Osize -Zevm-ir-pipeline=block-layout,block-layout,block-layout
//@[size] filecheck:
//@[repeat] filecheck:
@module shared_call_width

// Padding puts the other branch targets near the PUSH1 boundary. Keeping bb3 beside the first
// call makes their labels wider; delaying it saves two bytes. Repeating layout keeps that choice.
bb0:
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  calldatasize
  jumpi bb4, bb1
bb1:
  push bb7
  jump bb3
// CHECK-LABEL: {{^[ +]*}}bb2:
// CHECK-NEXT: {{^[ +]*}}push bb7
// CHECK-NEXT: {{^[ +]*}}jump bb3
// CHECK-NEXT: {{^[ +]*}}bb3:
bb2:
  push bb7
  jump bb3
bb3:
  push 0x2222222222222222222222222222222222222222222222222222222222222222
  swap 1
  jump
bb4:
  push 0
  calldataload
  jumpi bb2, bb5
bb5:
  push 32
  calldataload
  jumpi bb2, bb6
bb6:
  jump bb2
bb7 [continuation]:
  pop
  stop
