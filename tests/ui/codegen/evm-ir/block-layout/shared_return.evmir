//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-layout
//@[size] filecheck:
@module shared_return

// The more frequently referenced entry keeps its return tail as a fallthrough.
// CHECK-LABEL: bb1:
// CHECK: jump bb3
// CHECK-LABEL: bb2:
// CHECK-NEXT: {{[ +]*}}push 2
// CHECK-NEXT: {{[ +]*}}jump bb3
// CHECK-NEXT: {{[ +]*}}bb3:
bb0:
  push bb7
  jump bb1
bb1:
  push 1
  jump bb3
bb2:
  push 2
  jump bb3
bb3:
  swap 1
  jump
bb4:
  push bb7
  jump bb2
bb5:
  push bb7
  jump bb2
bb6:
  push bb7
  jump bb2
bb7:
  pop
  stop
