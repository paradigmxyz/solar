//@compile-flags: -Zevm-ir-pipeline=block-layout
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}bb4:
// bb5 reaches the stack limit, so its jump must remain a fallthrough.
// CHECK: {{^[ +].*}}bb5:
// CHECK: {{^[ +].*}}jump bb6
// CHECK-NEXT: {{^[ +].*}}bb6:
bb0:
  push 1
  push bb1
  jumpi
  jump bb2
bb1:
  stop
bb2:
  jump bb3
bb3:
  push 1
  jumpi bb4, bb5
bb4:
  jump bb6
bb5:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 1
  push 2
  push 3
  push 4
  jump bb6
bb6:
  stop
