//@ compile-flags: -Ogas -Zevm-ir-pipeline=block-layout
//@ run-call: pick(uint256,uint256)(uint256) 0, 0 => 2
//@ run-call: pick(uint256,uint256)(uint256) 1, 0 => 2
//@ run-call: pick(uint256,uint256)(uint256) 1, 1 => 1
// The entry trace takes `bb1` after `bb0`, so `bb2` reaches `bb1` only by a jump. Layout then places
// the branch target `bb3` next in index order, behind that jump. The branch turns around and
// falls into `bb3`.
@module TurnedBranch
bb0:
  push 4
  calldataload
  push bb2
  jumpi
  jump bb1
bb1:
  push 2
  push 0
  mstore
  push 32
  push 0
  return
bb2:
  push 36
  calldataload
  push bb3
  jumpi
  jump bb1
bb3:
  push 1
  push 0
  mstore
  push 32
  push 0
  return
