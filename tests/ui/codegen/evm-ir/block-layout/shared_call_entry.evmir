//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-layout
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-layout
//@ filecheck:
@module shared_call_entry

// Incoming branches to a call site do not count invocations of an outlined stub.
// Keep the first call's callee as fallthrough in both modes.
// CHECK-LABEL: bb1:
// CHECK-NEXT: {{[ +]*}}push bb7
// CHECK-NEXT: {{[ +]*}}jump bb3
// CHECK-NOT: {{^[ +]+bb[0-9]+:}}
// CHECK: {{^[ +]+bb3:}}
bb0:
  calldatasize
  jumpi bb4, bb1
bb1:
  push bb7
  jump bb3
bb2:
  push bb7
  jump bb3
bb3:
  push 1
  swap 1
  jump
bb4:
  push 0
  calldataload
  jumpi bb2, bb5
bb5:
  push 32
  calldataload
  jumpi bb2, bb6
bb6:
  jump bb2
bb7 [continuation]:
  pop
  stop
