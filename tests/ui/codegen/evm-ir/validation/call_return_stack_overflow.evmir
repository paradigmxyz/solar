//@ compile-flags: --emit=bin-runtime
// A call that leaves more words than it consumes returns above the stack limit.
//~? WARN: `call return` in block 0 grows the EVM stack to 1026 words
@module module

bb0 [stack=1020]:
  push bb2
  jump bb1

bb1 [ret=0, inputs=1, outputs=6]:
  jump

bb2 [continuation]:
  stop
