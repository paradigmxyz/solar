//~? ERROR: EVM IR verification failed: block 0: `cmplog` must follow the `push` of its site ID, kept with it
//~? ERROR: EVM IR verification failed: block 1: `cmplog` must follow the `push` of its site ID, kept with it
//~? ERROR: EVM IR verification failed: block 1: `push` is kept with the next instruction, which must be `edgecov` or `cmplog`, not `lt`
@module module

// Instrumentation emits a comparison operand log only as `push <word>; cmplog` with the push
// kept with it, so an instrumented interpreter can refund the push and find every log by its shape.
bb0:
  push 1
  push 2
  push 0x114
  cmplog
  eq
  pop
  jump bb1

bb1:
  push 1
  push 2
  push 0x210 !meta(keep_with_next)
  lt
  push 3
  dup 1
  cmplog
  pop
  pop
  pop
  stop
