//~? ERROR: EVM IR verification failed: block 0: `edgecov` must follow the `push` of its site ID, kept with it
//~? ERROR: EVM IR verification failed: block 1: `edgecov` must follow the `push` of its site ID, kept with it
//~? ERROR: EVM IR verification failed: block 1: `push` is kept with the next instruction, which must be `edgecov` or `cmplog`, not `pop`
@module module

// Instrumentation emits an edge coverage probe only as `push <id>; edgecov` with the push kept
// with it, so an instrumented interpreter can refund the push and find every probe by its shape.
bb0:
  push 1
  edgecov
  jump bb1

bb1:
  push 2 !meta(keep_with_next)
  pop
  push 3
  dup 1
  edgecov
  pop
  stop
