//@ compile-flags: --emit=bin-runtime
//~? WARN: `indexed_jump` in block 1 grows the EVM stack to 1025 words
@module module

// Lowering an indexed jump pushes three more words. That fits from 1021 words
// but not from 1022.
bb0 [stack=1021]:
  indexed_jump bb2

bb1 [stack=1022]:
  indexed_jump bb3

bb2:
  stop

bb3:
  stop
