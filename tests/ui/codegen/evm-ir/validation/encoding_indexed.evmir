//@ compile-flags: -Zevm-ir-pipeline=none -Zdump=disasm-runtime
//~? ERROR: EVM IR verification failed: block 0: `indexed_jump` encoding grows the stack to 1025 words, exceeding the limit of 1024
@module EncodingLimit

// The condition/index is consumed only after its encoding needs a temporary.
bb0:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push 0
  push 0
  indexed_jump bb1, bb2
bb1:
  stop
bb2:
  stop
