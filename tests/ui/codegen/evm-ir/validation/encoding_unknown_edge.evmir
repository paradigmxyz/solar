//@ compile-flags: -Zevm-ir-pipeline=none -Zdump=disasm-runtime
//~? ERROR: EVM IR verification failed: block 1: `jump` encoding grows the stack to 1025 words, exceeding the limit of 1024
@module EncodingUnknownEdge

// The other branch's unknown target invalidates optimization bounds, but must
// not hide a concrete overflowing address push on this directly reached branch.
bb0:
  calldatasize
  jumpi bb1, bb2
bb1:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push 0
  push 0
  jump bb3
bb2:
  push 0
  calldataload
  jump
bb3:
  stop
