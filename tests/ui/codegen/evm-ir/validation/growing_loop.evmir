//@ compile-flags: -Zevm-ir-pipeline=stack-normalize
//~? ERROR: EVM IR verification failed: block 1: `push` grows the stack to 1025 words, exceeding the limit of 1024
@module GrowingLoop

// Provenance widening must retain distinct heights and reject an unbalanced loop.
bb0:
  push 0
  jump bb1
bb1:
  push 0
  jump bb1
