// `bb3` is entered from `bb1` and `bb2` at different depths, and its `pop` sequence underflows at
// the lower one. The block reports the message once.
//~? ERROR: EVM IR verification failed: block 3: `pop` on an empty stack
@module module

bb0:
  push 1
  jumpi bb1, bb2

bb1:
  push 0
  jump bb3

bb2:
  jump bb3

bb3:
  pop
  pop
  stop
