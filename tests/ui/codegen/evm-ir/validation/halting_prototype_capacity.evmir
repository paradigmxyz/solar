//@ compile-flags: -Zevm-ir-pipeline=none
//~? ERROR: EVM IR verification failed: block 1: `push` grows the stack to 1025 words, exceeding the limit of 1024
@module HaltingPrototypeCapacity

// The first arrival at bb1 carries [bb2]; the later arrival carries [0, bb2].
// Unused label data creates a structural cycle through a computed-return block.
// Forgetting the first raw prototype would mistake bb2 for a fresh recursive
// continuation and strip a real word before validating the second arrival.
bb0:
  push bb2
  calldatasize
  jumpi bb1, bb2
bb1:
  push bb2
  pop
  push bb3
  pop
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push 0
  stop
bb2:
  push 0
  swap 1
  jump bb1
bb3:
  jump
