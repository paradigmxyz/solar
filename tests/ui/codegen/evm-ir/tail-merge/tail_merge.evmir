//@compile-flags: -Zevm-ir-pipeline=tail-merge
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}jump bb2
bb0:
  push 1
  push bb1
  jumpi
  jump bb2

// CHECK-LABEL: {{^[ +].*}}bb1 [cold]:
// CHECK: {{^[ +].*}}push 11
// CHECK: + jump [[TAIL_A:bb[0-9]+]]
bb1 [cold]:
  push 11
  push 22
  push 33
  push 44
  push 55
  revert

// CHECK-LABEL: {{^[ +].*}}bb2 [cold]:
// CHECK: {{^[ +].*}}push 99
// CHECK: + jump [[TAIL_A]]
bb2 [cold]:
  push 99
  push 22
  push 33
  push 44
  push 55
  revert

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}push 77
// CHECK: {{^[ +].*}}push 66
// CHECK: + jump [[TAIL_B:bb[0-9]+]]
bb3:
  push 77
  push 66
  push 33
  push 44
  push 55
  revert

// CHECK-LABEL: {{^[ +].*}}bb6 [cold]:
// CHECK: {{^[ +].*}}push 111
// CHECK: + jump [[TAIL_C:bb[0-9]+]]
bb6 [cold]:
  push 111
  push 222
  push 333
  push 444
  push 555
  revert

// The maximum textual label is valid and must not overflow synthetic-label allocation.
// CHECK-LABEL: {{^[ +].*}}bb4294967295:
// CHECK: {{^[ +].*}}push 999
// CHECK: + jump [[TAIL_C]]
bb4294967295:
  push 999
  push 222
  push 333
  push 444
  push 555
  revert

// PUSH0 makes this shared suffix five bytes, so replacing it with two jumps and a shared tail
// would grow the module. The size lower bound must use the selected EVM version's push width.
// CHECK-LABEL: {{^[ +].*}}bb4294967293:
// CHECK: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}push0
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}stop
bb4294967293:
  push 0
  pop
  push0
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb4294967294:
// CHECK: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}push0
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}stop
bb4294967294:
  push 0
  pop
  push0
  pop
  stop

// The second copy falls through to bb10, so its jump currently emits no bytes. Counting a
// conservative PUSH+JUMP would make this three-byte suffix appear profitable to share.
// CHECK-LABEL: {{^[ +].*}}bb8:
// CHECK: {{^[ +].*}}push0
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}jump bb10
bb8:
  push0
  dup 1
  pop
  jump bb10

// CHECK-LABEL: {{^[ +].*}}bb9:
// CHECK: {{^[ +].*}}push0
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}pop
// CHECK-NEXT: {{^[ +].*}}jump bb10
bb9:
  push0
  dup 1
  pop
  jump bb10

bb10:
  stop

// CHECK: + [[TAIL_B]]:
// CHECK: {{^[ +].*}}push 33
// CHECK: {{^[ +].*}}revert
// CHECK: + [[TAIL_A]] [cold]:
// CHECK: {{^[ +].*}}push 22
// CHECK: + jump [[TAIL_B]]
// CHECK: + [[TAIL_C]]:
// CHECK: {{^[ +].*}}push 222
// CHECK: {{^[ +].*}}revert
