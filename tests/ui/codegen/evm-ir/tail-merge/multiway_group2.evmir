  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: bb2:
// CHECK: {{^[ +].*}}push 102
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: {{^[ +].*}}push 32
