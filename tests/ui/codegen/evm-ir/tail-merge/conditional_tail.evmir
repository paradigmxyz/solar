//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=tail-merge
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge
//@ filecheck:

@module ConditionalTail
bb0:
  push 0
  calldataload
  jumpi bb1, bb2

// The four-byte suffix and conditional transfer meet the seven-byte lower bound.
// CHECK-LABEL: bb1:
// CHECK: push 3
// CHECK: + jump [[TAIL:bb[0-9]+]]
bb1:
  push 3
  push 32
  calldataload
  lt
  jumpi bb3, bb4
// CHECK-LABEL: bb2:
// CHECK: push 2
// CHECK: + jump [[TAIL]]
bb2:
  push 2
  push 32
  calldataload
  lt
  jumpi bb3, bb4
bb3:
  push 100
  push 0
  mstore
  push 32
  push 0
  return
bb4:
  push 200
  push 0
  mstore
  push 32
  push 0
  return

// Three one-byte instructions plus the same transfer remain below the lower bound.
// CHECK-LABEL: bb5:
// CHECK: push 1
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}iszero
// CHECK-NEXT: {{^[ +].*}}iszero
// CHECK-NEXT: {{^[ +].*}}jumpi bb3, bb4
bb5:
  push 1
  dup 1
  iszero
  iszero
  jumpi bb3, bb4
// CHECK-LABEL: bb6:
// CHECK: push 2
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: {{^[ +].*}}iszero
// CHECK-NEXT: {{^[ +].*}}iszero
// CHECK-NEXT: {{^[ +].*}}jumpi bb3, bb4
bb6:
  push 2
  dup 1
  iszero
  iszero
  jumpi bb3, bb4

// CHECK: + [[TAIL]]:
// CHECK: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb3, bb4
