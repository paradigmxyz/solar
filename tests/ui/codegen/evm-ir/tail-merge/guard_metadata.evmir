//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=tail-merge
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge

// An explicitly declared stack effect does not make an unknown opcode transparent.
@module guard_metadata
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  callf !meta(stack=0->0)
  push 11
  push 22
  push 33
  push 44
  stop
bb2:
  callf !meta(stack=0->0)
  push 11
  push 22
  push 33
  push 44
  stop
