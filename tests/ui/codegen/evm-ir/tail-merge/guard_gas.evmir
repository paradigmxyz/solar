//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=tail-merge
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge

// Sharing these equal bodies must preserve the returned observation.
@module observer_gas
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  gas
  push 0
  mstore
  push 32
  push 0
  return
bb2:
  gas
  push 0
  mstore
  push 32
  push 0
  return
