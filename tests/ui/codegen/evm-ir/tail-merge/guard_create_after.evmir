//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge

// The inserted jump precedes this observation in a successor block.
@module guard_create_after
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 11
  pop
  push 22
  pop
  push 33
  pop
  jump bb3
bb2:
  push 11
  pop
  push 22
  pop
  push 33
  pop
  jump bb3
bb3:
  calldatasize
  push 0
  push 0
  calldatacopy
  calldatasize
  push 0
  push 0
  create
  push 0
  mstore
  push 32
  push 0
  return
