//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=tail-merge
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge
//@ filecheck:

// The observation still prevents sharing through an empty forwarding target.
// CHECK-LABEL: bb1:
// CHECK: push 3
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb3, bb4
@module ForwardedConditionalObserved
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 3
  push 32
  calldataload
  lt
  jumpi bb3, bb4
bb2:
  push 2
  push 32
  calldataload
  lt
  jumpi bb7, bb4
bb3:
  pc
  push 0
  mstore
  push 32
  push 0
  return
bb4:
  push 200
  push 0
  mstore
  push 32
  push 0
  return
bb7:
  jump bb3

