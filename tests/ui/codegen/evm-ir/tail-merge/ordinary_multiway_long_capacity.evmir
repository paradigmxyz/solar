//@ filecheck:
@module OrdinaryMultiwayLongCapacity
bb0:
  push 0
  calldataload
  push 3
  swap 1
  mod
  indexed_jump bb1, bb2, bb3
// CHECK-LABEL: bb1:
// CHECK: push 11
// CHECK: {{^[ +]*}}jump [[TAIL:bb[0-9]+]]
bb1:
  push 1
  push 2
  push 3
  push 11
  add
  mul
  xor
  push 256
  mstore
  push 32
  push 256
  return
// CHECK-LABEL: bb2:
// CHECK: push 22
// CHECK: {{^[ +]*}}jump [[TAIL]]
bb2:
  push 1
  push 2
  push 3
  push 22
  add
  mul
  xor
  push 256
  mstore
  push 32
  push 256
  return
// The third member starts at 1024. ADD/MUL/XOR consumes its four inputs before
// the memory return. A new jump address would instead overflow at this boundary.
