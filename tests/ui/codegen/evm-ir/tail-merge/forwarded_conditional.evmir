//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=tail-merge
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge
//@ filecheck:

@module ForwardedConditional
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
// CHECK-LABEL: bb1:
// CHECK: push 3
// CHECK: + jump [[TAIL:bb[0-9]+]]
bb1:
  push 3
  push 32
  calldataload
  lt
  jumpi bb3, bb4
// An empty forwarding block must not prevent matching the conditional suffix.
// CHECK-LABEL: bb2:
// CHECK: push 2
// CHECK: + jump [[TAIL]]
bb2:
  push 2
  push 32
  calldataload
  lt
  jumpi bb7, bb4
bb3:
  push 100
  push 0
  mstore
  push 32
  push 0
  return
bb4:
  push 200
  push 0
  mstore
  push 32
  push 0
  return
bb7:
  jump bb3

// Source terminator metadata remains part of conditional identity.
// CHECK-LABEL: bb8:
// CHECK: push 5
// CHECK-NEXT: {{^[ +].*}}push 64
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb9, bb10
bb8:
  push 5
  push 64
  calldataload
  lt
  jumpi bb9, bb10 !meta(stack=1->0)
bb9:
  stop
bb10:
  invalid
// CHECK-LABEL: bb11:
// CHECK: push 6
// CHECK-NEXT: {{^[ +].*}}push 64
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb12, bb10
bb11:
  push 6
  push 64
  calldataload
  lt
  jumpi bb12, bb10
bb12:
  jump bb9

// An annotated forwarding terminator is not erased by the local shortcut.
// CHECK-LABEL: bb13:
// CHECK: push 7
// CHECK-NEXT: {{^[ +].*}}push 96
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb17, bb18
bb13:
  push 7
  push 96
  calldataload
  lt
  jumpi bb17, bb18
// CHECK-LABEL: bb14:
// CHECK: push 8
// CHECK-NEXT: {{^[ +].*}}push 96
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb15, bb18
bb14:
  push 8
  push 96
  calldataload
  lt
  jumpi bb15, bb18
bb15:
  jump bb17 !meta(stack=0->0)
bb17:
  stop
bb18:
  invalid

// CHECK: + [[TAIL]]:
// CHECK: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb3, bb4
