@module Group3
bb0:
  push 0
  calldataload
  push 3
  swap 1
  mod
  indexed_jump bb1, bb2, bb3
// CHECK-LABEL: bb1:
// CHECK: {{^[ +].*}}push 101
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}return
bb1:
  push 101
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: bb2:
// CHECK: {{^[ +].*}}push 102
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}return
bb2:
  push 102
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: bb3:
// CHECK: {{^[ +].*}}push 103
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}return
bb3:
  push 103
  push 0
  mstore
  push 32
  push 0
  return
