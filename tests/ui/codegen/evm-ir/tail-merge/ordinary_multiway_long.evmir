//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=tail-merge
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=tail-merge
//@[gas] filecheck: --check-prefixes=CHECK,GAS
//@[size] filecheck: --check-prefixes=CHECK,SIZE

@module OrdinaryMultiwayLong
bb0:
  push 0
  calldataload
  push 3
  swap 1
  mod
  indexed_jump bb1, bb2, bb3
// A long conditional tail already profitable as a pair has one
// owner for all three eligible Size members. Gas retains its existing pair rule.
// CHECK-LABEL: bb1:
// CHECK: push 3
// CHECK: {{^[ +]*}}jump [[TAIL:bb[0-9]+]]
bb1:
  push 3
  push 32
  calldataload
  push 1
  and
  push 64
  calldataload
  add
  lt
  jumpi bb10, bb11
// CHECK-LABEL: bb2:
// CHECK: push 2
// CHECK: {{^[ +]*}}jump [[TAIL]]
bb2:
  push 2
  push 32
  calldataload
  push 1
  and
  push 64
  calldataload
  add
  lt
  jumpi bb12, bb11
// CHECK-LABEL: bb3:
// CHECK: push 1
// SIZE: {{^[ +]*}}jump [[TAIL]]
// GAS-NEXT: {{^[ +].*}}push 32
// GAS-NEXT: {{^[ +].*}}calldataload
// GAS-NEXT: {{^[ +].*}}push 1
// GAS-NEXT: {{^[ +].*}}and
// GAS-NEXT: {{^[ +].*}}push 64
// GAS-NEXT: {{^[ +].*}}calldataload
// GAS-NEXT: {{^[ +].*}}add
// GAS-NEXT: {{^[ +].*}}lt
// GAS-NEXT: {{^[ +].*}}jumpi bb13, bb14
bb3:
  push 1
  push 32
  calldataload
  push 1
  and
  push 64
  calldataload
  add
  lt
  jumpi bb13, bb14
bb10:
  push 100
  push 0
  mstore
  push 32
  push 0
  return
bb11:
  push 200
  push 0
  mstore
  push 32
  push 0
  return
bb12:
  jump bb10
bb13:
  jump bb10
bb14:
  jump bb11
// CHECK: {{^[ +]*}}[[TAIL]]:
// CHECK: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}and
// CHECK-NEXT: {{^[ +].*}}push 64
// CHECK-NEXT: {{^[ +].*}}calldataload
// CHECK-NEXT: {{^[ +].*}}add
// CHECK-NEXT: {{^[ +].*}}lt
// CHECK-NEXT: {{^[ +].*}}jumpi bb10, bb11
