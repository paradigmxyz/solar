//@ compile-flags: -Ogas --optimize-runs 10000 -Zevm-ir-pipeline=tail-dup -Zvalidate-ir=true
// A copy of a block that falls through out of its loop ends with a jump of its own, whose label
// push must stay within the stack the path already reaches. All three loops run at the stack
// limit. The first exit ends at its highest stack and falls into a block that pushes nothing, so
// its copy would push the label to 1025 words and it stays shared. The second exit peaks before
// its end, and the third falls into a block whose first push reaches the label's height anyway,
// as a callee entered right after its return address does, so both copies go.
@module StackLimit
bb0 [stack=1021]:
  jump bb1
bb1 [loop]:
  push 0
  calldataload
  push bb2
  jumpi
  jump bb3
bb2 [loop, cold]:
  jump bb1
bb3 [loop]:
  push 1
  push 2
  push 3
  jump bb4
bb4:
  stop
bb5 [stack=1021]:
  jump bb6
bb6 [loop]:
  push 0
  calldataload
  push bb7
  jumpi
  jump bb8
bb7 [loop, cold]:
  jump bb6
bb8 [loop]:
  push 1
  push 2
  push 3
  pop
  jump bb9
bb9:
  stop
bb10 [stack=1020]:
  jump bb11
bb11 [loop]:
  push 0
  calldataload
  push bb12
  jumpi
  jump bb13
bb12 [loop, cold]:
  jump bb11
bb13 [loop]:
  push 1
  push 2
  push 3
  jump bb14
bb14:
  dup 1
  stop
