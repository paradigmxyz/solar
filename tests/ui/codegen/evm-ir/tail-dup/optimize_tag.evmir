//@ revisions: gas size
//@[gas] compile-flags: -Ogas --optimize-runs 10000 -Zevm-ir-pipeline=tail-dup
//@[size] compile-flags: -Osize --optimize-runs 10000 -Zevm-ir-pipeline=tail-dup
//@ filecheck:
// The contract's gas objective enables copying the hot loop header even in a size build.
@module OptimizeTag
@optimize gas

bb0:
  push 0
  calldataload
  push 0
  jump bb1
bb1 [loop]:
  dup 2
  dup 2
  eq
  push bb3
  jumpi
  dup 1
  calldataload
  push 1
  and
  push bb2
  jumpi
  pop
  pop
  push 0
  push 0
  return
// CHECK-LABEL: {{^[ +].*}}bb2 [loop]:
// CHECK-NEXT: {{^[ +].*}}push 1
// CHECK-NEXT: {{^[ +].*}}add
// CHECK-NEXT: - jump bb1
// CHECK-NEXT: + dup 2
// CHECK-NEXT: + dup 2
// CHECK-NEXT: + eq
// CHECK-NEXT: + push bb3
// CHECK-NEXT: + jumpi
// CHECK: + return
bb2 [loop]:
  push 1
  add
  jump bb1
bb3:
  stop
