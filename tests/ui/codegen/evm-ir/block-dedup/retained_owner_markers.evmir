//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-dedup
//@[gas] filecheck: --check-prefix=GAS
//@[size] filecheck: --check-prefix=SIZE
@module RetainedOwnerMarkers

// The first copies bb1/bb2 are canonical and unaddressable. The middle copies
// bb7/bb8 are already addressable and survive to preserve bb6's fallthrough.
// Removing bb9/bb10/bb11 sends their path through BOTH middle markers. Counting
// only each old member's direct canonical target misses those two extra markers.
// Gas mode must decline; size mode may still take the whole-block saving.
bb0:
  push 0
  calldataload
  jumpi bb3, bb1
bb1:
  push 31
  pop
  jump bb2
bb2:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
bb3:
  push 32
  calldataload
  jumpi bb7, bb4
bb4:
  push 64
  calldataload
  jumpi bb8, bb5
// GAS-LABEL: {{^[ +].*}}bb5:
// GAS: {{^[ +].*}}jumpi bb9, bb6
// SIZE-LABEL: {{^[ +].*}}bb5:
// SIZE: + {{.*}}jumpi bb6, bb6
bb5:
  push 96
  calldataload
  jumpi bb9, bb6
// GAS-LABEL: {{^[ +].*}}bb6:
// SIZE-LABEL: {{^[ +].*}}bb6:
bb6:
  push 41
  pop
  jump bb7
// GAS-LABEL: {{^[ +].*}}bb7:
// SIZE-LABEL: {{^[ +].*}}bb7:
bb7:
  push 31
  pop
  jump bb8
// GAS-LABEL: {{^[ +].*}}bb8:
// SIZE-LABEL: {{^[ +].*}}bb8:
bb8:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
// GAS-LABEL: {{^[ +].*}}bb9:
// SIZE-NOT: {{^[ +].*}}bb9:
bb9:
  push 41
  pop
  jump bb10
// GAS-LABEL: {{^[ +].*}}bb10:
// SIZE-NOT: {{^[ +].*}}bb10:
bb10:
  push 31
  pop
  jump bb11
// GAS-LABEL: {{^[ +].*}}bb11:
// SIZE-NOT: {{^[ +].*}}bb11:
bb11:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
