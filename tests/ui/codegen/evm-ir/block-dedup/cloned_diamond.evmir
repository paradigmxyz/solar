//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-dedup
//@ filecheck:
@module ClonedDiamond

// The whole second diamond differs only by its successor identities. Its
// removed internal fallthroughs must not keep otherwise removable clone blocks.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + {{.*}}jumpi bb1, bb1
bb0:
  calldatasize
  jumpi bb10, bb1
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}jumpi bb3, bb2
bb1:
  push 0
  calldataload
  jumpi bb3, bb2
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}push 11
// CHECK: {{^[ +].*}}return
bb2:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}push 22
// CHECK: {{^[ +].*}}return
bb3:
  push 22
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-NOT: {{^[ +].*}}bb10:
// CHECK-NOT: {{^[ +].*}}bb11:
// CHECK-NOT: {{^[ +].*}}bb12:
bb10:
  push 0
  calldataload
  jumpi bb12, bb11
bb11:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
bb12:
  push 22
  push 0
  mstore
  push 32
  push 0
  return
