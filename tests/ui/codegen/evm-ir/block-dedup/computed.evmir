//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-dedup
//@ filecheck:
@module ExcludedControl

// The runtime numeric destination cannot establish safe entry/redirection facts.
// CHECK-LABEL: {{^[ +].*}}bb0:
bb0:
  calldatasize
  jump
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}return
bb1:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}return
bb2:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
