//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-dedup
//@ filecheck:
@module ExcludedControl

// A pushed label disables this bounded pass even when its value is discarded.
// CHECK-LABEL: {{^[ +].*}}bb0:
bb0:
  push bb1
  pop
  calldatasize
  jumpi bb2, bb1
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}return
bb1:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}return
bb2:
  push 11
  push 0
  mstore
  push 32
  push 0
  return
