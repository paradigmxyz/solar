//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=block-dedup
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=block-dedup
//@ filecheck:
@module DebugOrigins

// Debug origins and function events do not split executable equivalence classes.
// The owner must retain both source origins and drop the ambiguous invocation.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + {{.*}}jumpi bb1, bb1
bb0:
  calldatasize
  jumpi bb2, bb1
// CHECK-LABEL: + bb1:{{$}}
// CHECK: + {{.*}}push 11 !metadata(spans=[11..15, 31..35])
// CHECK: + {{.*}}return !metadata(spans=[20..25, 40..45])
bb1 [invoke=first@1..10]:
  push 11 !metadata(span=11..15)
  push 0
  mstore
  push 32
  push 0
  return !metadata(span=20..25)
// CHECK-NOT: {{^[ +].*}}bb2
bb2 [invoke=second@11..20]:
  push 11 !metadata(span=31..35)
  push 0
  mstore
  push 32
  push 0
  return !metadata(span=40..45)
