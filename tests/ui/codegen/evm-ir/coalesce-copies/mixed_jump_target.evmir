//@ compile-flags: --evm-version cancun -Zevm-ir-pipeline=coalesce-copies
//@ filecheck:
@module MixedJumpTarget

// The dynamic target reaching bb3 is either the known bb4 label or an unknown runtime word. The
// latter may jump to bb5 with a 1,022-word prefix, so coalescing its copies would overflow.
// CHECK-NOT: mcopy
bb0:
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  push 0
  push 0
  push 0
  jumpi bb1, bb2
bb1:
  push bb4
  jump bb3
bb2:
  push 0
  jump bb3
bb3:
  jump
bb4:
  stop
bb5:
  push 128
  mload
  push 256
  mstore
  push 160
  mload
  push 288
  mstore
  stop
