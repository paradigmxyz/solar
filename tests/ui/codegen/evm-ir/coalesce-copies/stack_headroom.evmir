//@ compile-flags: --evm-version cancun -Zevm-ir-pipeline=coalesce-copies
//@ filecheck:
@module StackHeadroom

// Compute a physical jump target through `add` so the analysis cannot recover
// the label. An unknown dynamic edge may carry this 1,022-word prefix into any
// block, so the optional rewrite must remain disabled.
// CHECK-NOT: mcopy
bb0:
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  op_0c !meta(stack=0->255)
  push 0
  push 0
  push bb1
  push 0
  add
  jump
bb1:
  push 128
  mload
  push 256
  mstore
  push 160
  mload
  push 288
  mstore
  stop
