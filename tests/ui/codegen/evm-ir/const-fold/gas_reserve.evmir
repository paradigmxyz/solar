//@ revisions: paris osaka
//@ compile-flags: -Zevm-ir-pipeline=const-fold
//@[paris] compile-flags: --evm-version=paris
//@[osaka] compile-flags: --evm-version=osaka
@module GasReserve

// The verifier admits `keep_with_next` only on the `gas; sub; call` reserve of a call, so those
// instructions are the protected boundaries. The pass never starts a rewrite after `sub` or
// removes the `gas` and `sub`, and it still folds the operands that come before them.
bb0:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 1
  push 2
  add
  push 2300
  gas !metadata(keep_with_next)
  sub !metadata(keep_with_next)
  call
  pop
  stop
