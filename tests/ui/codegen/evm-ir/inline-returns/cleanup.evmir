//@ revisions: gas size
//@ compile-flags: -Zevm-ir-pipeline=default -Zdump=disasm-runtime
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@ filecheck:

// CHECK-LABEL: // === ReturnCleanup (runtime) ===
@module ReturnCleanup

bb0:
  push bb5
  push 7
  push 0
  calldataload
  jumpi bb1, bb2

// The copied POP cancels the caller's push.
// CHECK: PUSH1 0x02
// CHECK-NEXT: MUL
// CHECK-NEXT: SWAP1
// CHECK-NEXT: JUMP
bb1:
  push 2
  mul
  swap 1
  push 0
  jump bb3
bb2:
  push 3
  mul
  swap 1
  push 1
  jump bb3
bb3:
  pop
  jump
bb5:
  push 0
  mstore
  push 32
  push 0
  return
