//@ revisions: inline simplify
//@[inline] compile-flags: -Ogas -Zevm-ir-pipeline=inline-returns
//@[simplify] compile-flags: -Ogas -Zevm-ir-pipeline=inline-returns,cfg-simplify
@module InlineReturns

bb0:
  push 1
  jumpi bb1, bb2
bb1:
  push bb5 !metadata(stack=0->1)
  jump bb4
bb2:
  push bb5
  jump bb4

// Fallthrough is already free and should not be expanded.
bb3:
  jump bb4
bb4:
  jump !metadata(stack=1->0)
bb5:
  stop

// This tail fits the shortest possible push plus jump.
bb6:
  push bb5
  push 7
  jump bb8
bb7:
  push bb5
  push 9
  jump bb8
bb8:
  swap 1
  jump

// Position and gas observations, relocations, and larger tails remain separate.
bb9:
  jump bb11
bb10:
  stop
bb11:
  pc
  jump
bb12:
  jump bb14
bb13:
  stop
bb14:
  gas
  jump
bb15:
  jump bb17
bb16:
  stop
bb17:
  push 65536
  jump
