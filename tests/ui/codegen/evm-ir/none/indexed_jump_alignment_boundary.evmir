//@ revisions: gas low size
//@ compile-flags: -Zdump=disasm-deploy -Zevm-ir-pipeline=none --evm-version=cancun
//@[gas] compile-flags: -Ogas --optimize-runs=1000000
//@[low] compile-flags: -Ogas --optimize-runs=200
//@[size] compile-flags: -Osize --optimize-runs=1000000

// Padding would move the last target above 0xff. Retry compact BYTE encoding.
@module ByteTableBoundary

bb0:
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  pop
  push 0x2222222222222222222222222222222222222222222222222222222222222222
  pop
  push 0x3333333333333333333333333333333333333333333333333333333333333333
  pop
  push 0x4444444444444444444444444444444444444444444444444444444444444444
  pop
  push 0x5555555555555555555555555555555555555555555555555555555555555555
  pop
  push 0x6666666666666666666666666666666666666666666666666666666666666666
  pop
  push 0
  calldataload
  push 3
  and
  indexed_jump bb1, bb2, bb3, bb4
bb1:
  push 11
  jump bb5
bb2:
  push 22
  jump bb5
bb3:
  push 33
  jump bb5
bb4:
  push 44
  jump bb5
bb5:
  push 0
  mstore
  push 32
  push 0
  return
