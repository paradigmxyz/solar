//@filecheck:
@module module

; A `;` comment runs to the end of the line, and what it says is not syntax: ( { " ' // /* hex"00"
// A `//` comment may hold a ; as well.
/* So may a block comment ; bb9: and a string literal: */
// CHECK-LABEL: {{^[ +].*}}bb0 [stack=0]:
// CHECK-NOT: ;
// CHECK: {{^[ +].*}}jumpi bb1, bb2
bb0 [stack=0]:  ; runtime dispatch entry + function f(uint256 a) external [selector 0x12345678]
  push 0  ; trailing note: it's "quoted" ; twice
  calldataload !metadata(source=dispatch)
  push 0x371303c0
  eq
  jumpi bb1, bb2

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}return
bb1:  ; non-ASCII too: λ → ✓
  push 0
  push 0
  return

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: {{^[ +].*}}revert
bb2:  ;
  push 0
  push 0
  revert
