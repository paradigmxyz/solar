@module extended_stack

bb0:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  dup 1
  swap 1
  pop
  dup 17 //~[osaka]? ERROR: `dup` requires Amsterdam-compatible EVM
  swap 17 //~[osaka]? ERROR: `swap` requires Amsterdam-compatible EVM
  exchange 1, 16
  exchange 1, 17 //~[osaka]? ERROR: `exchange` requires Amsterdam-compatible EVM
  stop
