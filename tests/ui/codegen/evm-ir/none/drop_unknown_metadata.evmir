//@filecheck: --implicit-check-not=!meta
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK-COUNT-5: {{^[ +].*}}push 0
// CHECK: {{^[ +].*}}stop
bb0:
