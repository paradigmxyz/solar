//@ compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=stack-normalize
//@ filecheck:
@module extended

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK-NOT: {{^[ +].*}}dup 20
// CHECK: {{^[ +].*}}stop
bb0:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  push 18
  push 19
  dup 20
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK-NOT: {{^[ +].*}}swap 20
// CHECK: {{^[ +].*}}stop
bb1:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  push 18
  push 19
  push 20
  swap 20
  swap 20
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK-NOT: {{^[ +].*}}exchange 1, 17
// CHECK: {{^[ +].*}}stop
bb2:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  exchange 1, 17
  exchange 1, 17
  stop
