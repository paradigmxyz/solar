//@ compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=stack-normalize
//@ filecheck:
@module extended

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK-NOT: {{^[ +].*}}dup 20
// CHECK: {{^[ +].*}}stop
bb0:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  push 18
  push 19
  dup 20
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK-NOT: {{^[ +].*}}swap 20
// CHECK: {{^[ +].*}}stop
bb1:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  push 18
  push 19
  push 20
  swap 20
  swap 20
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK-NOT: {{^[ +].*}}exchange 1, 17
// CHECK: {{^[ +].*}}stop
bb2:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  exchange 1, 17
  exchange 1, 17
  stop

// Prefer the shorter encoding when two shuffles cost the same gas.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}push 1
// CHECK-NEXT: -   dup 1
// CHECK-NEXT: -   exchange 1, 2
// CHECK-NEXT: +   swap 1
// CHECK-NEXT: +   dup 2
// CHECK-NEXT: {{^[ +].*}}stop
bb3:
  push 0
  push 1
  dup 1
  exchange 1, 2
  stop

// Reach SWAPN past depth 16 when a duplicate word keeps the run off the permutation solver.
// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^[ +].*}}push 17
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: {{^[ +].*}}swap 18
// CHECK-NEXT: {{^[ +].*}}stop
bb4:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  push 17
  dup 1
  swap 1
  swap 18
  stop

// Reach EXCHANGE past depth 16 for the same kind of run.
// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^[ +].*}}push 16
// CHECK-NEXT: {{^[ +].*}}dup 1
// CHECK-NEXT: -   swap 1
// CHECK-NEXT: {{^[ +].*}}exchange 1, 17
// CHECK-NEXT: {{^[ +].*}}stop
bb5:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  push 16
  dup 1
  swap 1
  exchange 1, 17
  stop
