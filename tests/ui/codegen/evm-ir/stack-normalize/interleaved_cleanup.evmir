//@ compile-flags: -Zevm-ir-pipeline=stack-normalize
@module InterleavedCleanup

// A cleanup that keeps four words among eleven surplus ones swaps each kept word home
// while it pops, instead of first popping every surplus word from under the kept ones.
bb0:
  push 0
  push 1
  push 2
  push 3
  push 4
  push 5
  push 6
  push 7
  push 8
  push 9
  push 10
  push 11
  push 12
  push 13
  push 14
  push 15
  pop
  pop
  pop
  pop
  swap 2
  pop
  swap 3
  pop
  swap 3
  pop
  swap 3
  pop
  swap 3
  pop
  swap 3
  pop
  swap 4
  pop
  swap 1
  swap 3
  swap 2
  swap 3
  stop
