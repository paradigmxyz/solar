//@ compile-flags: -Zevm-ir-pipeline=stack-normalize --emit=bin-runtime
@module StackNormalizePeak

// The `dup` takes the stack to 1025 words, which `stack-normalize` removes, so the check on the
// pipeline's output finds no overflow.
bb0 [stack=1020]:
  push 0
  push 0
  push 0
  push 0
  dup 1
  pop
  sstore
  stop
