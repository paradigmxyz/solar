//@ compile-flags: -Zevm-ir-pipeline=stack-normalize
//~? ERROR: EVM IR verification failed: block 0: `dup` grows the stack to 1025 words, exceeding the limit of 1024
@module StackNormalizePeak

// The original DUP overflows at depth 1,024. Do not remove it and make the SSTORE reachable.
bb0:
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  callf !meta(stack=0->255)
  push 0
  push 0
  push 0
  push 0
  dup 1
  pop
  sstore
  stop
