//@ revisions: cleanup none
//@[cleanup] compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=word-cleanup
//@[none] compile-flags: --evm-version amsterdam -Zevm-ir-pipeline=none
@module Masks

// The producer already returns an address.
bb0:
  caller
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 0
  mstore
  stop

// The consumer ignores high address bits through a physical shuffle.
bb1:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 32
  swap 1
  balance
  swap 1
  mstore
  stop

// A full-width second use prevents deleting shared cleanup.
bb2:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  dup 1
  balance
  push 32
  mstore
  push 0
  mstore
  stop

// A narrow mask still matters to an address consumer.
bb3:
  push 4
  calldataload
  push 255
  and
  balance
  push 0
  mstore
  stop

// All uses ignore the cleared bits, including the store's byte operand.
bb4:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  dup 1
  balance
  push 32
  mstore
  push 0
  mstore8
  stop

// Demand propagates through modular arithmetic without crossing carry-sensitive reads.
bb5:
  push 4
  calldataload
  push 65535
  and
  push 7
  add
  push 0
  mstore8
  stop

// Both cleanups cannot disappear when a full-word observer remains.
bb6:
  push 4
  calldataload
  push 255
  and
  push 65535
  and
  push 0
  mstore
  stop

// Stack values leaving a block remain fully observed.
bb7:
  push 4
  calldataload
  push 255
  and
  jump bb8
bb8:
  push 0
  mstore
  stop

// A symbolic address is not a literal mask.
bb9:
  caller
  push bb8
  and
  push 0
  mstore
  stop

// GAS is a barrier for consumer-based cleanup.
bb10:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  gas
  pop
  balance
  push 0
  mstore
  stop

// The result of a comparison is already boolean.
bb11:
  caller
  iszero
  push 1
  and
  push 0
  mstore
  stop

// The address is the second popped call operand, not its gas operand.
bb12:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 100000
  staticcall
  push 0
  mstore
  stop

// EXCHANGE preserves the identity of a masked value.
bb13:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 7
  push 32
  exchange 1, 2
  swap 1
  balance
  push 0
  mstore
  pop
  pop
  stop

// Custom stack effects cannot establish a producer width.
bb14:
  callf !metadata(stack=0->1)
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 0
  mstore
  stop

// A custom terminal cannot establish consumer demand.
bb15:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  selfdestruct !metadata(stack=1->0)

// Full-width demand through an equality must retain the cleanup.
bb16:
  push 4
  calldataload
  push 255
  and
  push 4
  calldataload
  eq
  push 0
  mstore
  stop

// The dependency can span more than a bounded peephole window.
bb17:
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  push 3
  pop
  extcodehash
  push 0
  mstore
  stop

// Protected gas/call bundles end consumer tracking.
bb18:
  push 0
  push 0
  push 0
  push 0
  push 0
  push 4
  calldataload
  push 0xffffffffffffffffffffffffffffffffffffffff
  and
  push 71
  gas !metadata(keep_with_next)
  sub !metadata(keep_with_next)
  call
  push 0
  mstore
  stop

// Neither masked operand can rely on the other's removable width guarantee.
bb19:
  push 4
  calldataload
  push 255
  and
  push 36
  calldataload
  push 255
  and
  and
  push 0
  mstore
  stop

// A duplicated mask must still survive a full-width observation.
bb20:
  push 4
  calldataload
  push 255
  and
  dup1
  and
  push 0
  mstore
  stop

// Removing an outer mask must preserve the inner mask that proves its width.
bb21:
  push 4
  calldataload
  push 255
  and
  push 255
  and
  push 0
  mstore
  stop

// A physical branch observes the masked word even when the fallthrough drops it.
bb22:
  push 4
  calldataload
  push 255
  and
  push 36
  calldataload
  push bb23
  jumpi
  pop
  stop
bb23:
  push 0
  mstore
  stop
