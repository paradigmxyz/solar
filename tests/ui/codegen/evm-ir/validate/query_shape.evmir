//@ compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify -Zvalidate-evm-ir-passes=- --emit=bin-runtime
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
// Threading the empty bb1 changes the region at the entry: its query runs both versions from
// the entry with zeroed memory, merges memory where the paths join, reads the returned word
// through that merge, and asserts that the two return different words or end differently.
@module ValidateQueryShape
// CHECK-LABEL: ; query: ValidateQueryShape-evm_ir_cfg_simplify-r0-{{[0-9a-f]+}}.smt2
// CHECK: ; function: region bb0
// CHECK: ; pass: evm-ir/cfg-simplify
// CHECK: ; claim: evm-ir/cfg-simplify preserves region bb0
// CHECK: (assert (= [[V0:t[0-9]+]] (input_calldataload_1 #x{{0+}})))
// CHECK: (assert (= [[MERGED:m[0-9]+]] (ite {{g[0-9]+}} {{m[0-9]+}} mem0)))
// CHECK: (assert (= [[OLD:t[0-9]+]] (ite {{g[0-9]+}} #x{{0+}}2 #x{{0+}})))
// CHECK: (assert (= [[NEW:t[0-9]+]] (ite {{g[0-9]+}} #x{{0+}} #x{{0+}}2)))
// CHECK: (assert (or (and [[G:g[0-9]+]] (not [[H:g[0-9]+]])) (and [[G]] [[H]] (not (= [[OLD]] [[NEW]])))))
// CHECK-NEXT: (check-sat)
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  jump bb3
bb2:
  push 2
  push 0
  mstore
  jump bb3
bb3:
  push 32
  push 0
  return
