//@ compile-flags: -Ogas -Zevm-ir-pipeline=peephole-early -Zvalidate-evm-ir-passes=- --emit=bin-runtime
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
// A loop: peephole-early drops `push 0; add` in the body, which only the region from the loop
// header bb1 runs through. It starts with an unknown stack and memory, takes the free-memory
// pointer's bounds on trust, and ends where control reaches bb1 again: a continuation compared
// by target, stack, memory, storage and world.
@module ValidateLoop
// CHECK: ; function: region bb1
// CHECK: ; axioms: free-memory-pointer
// CHECK: (declare-const lbl1 (_ BitVec 256))
// CHECK: (declare-const arg0 (_ BitVec 256))
// CHECK: (check-sat)
bb0:
  push 0
  calldataload
  jump bb1
bb1 [loop]:
  dup 1
  jumpi bb2, bb3
bb2 [loop]:
  dup 1
  push 7
  sstore
  push 1
  swap 1
  sub
  push 0
  add
  jump bb1
bb3:
  dup 1
  push 7
  sstore
  stop
