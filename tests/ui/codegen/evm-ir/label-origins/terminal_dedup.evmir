//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup
//@ filecheck:
@module LabelOriginsDedup

bb0:
  push 1
  jumpi bb1, bb2

// Equal terminal bodies share the first copy, which keeps its label and its origin. The second
// copy only jumps to the first and keeps its own, since it still has a label.
// CHECK-LABEL: {{^[ +].*}}bb1 !metadata(span=10..20):
// CHECK: {{^[ +].*}}revert
// CHECK-LABEL: {{^[ +].*}}bb2 !metadata(span=30..40):
// CHECK: + jump bb1
bb1 !metadata(span=10..20):
  push 0
  dup 1
  revert

bb2 !metadata(span=30..40):
  push 0
  dup 1
  revert
