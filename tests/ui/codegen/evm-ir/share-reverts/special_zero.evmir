//@compile-flags: -Zevm-ir-pipeline=share-reverts
//@filecheck:
@module module
@libraries
  L_0: "a.sol:L"

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push bb1
// CHECK: + jump bb2
bb0:
  push 1
  iszero
  push bb2
  jumpi
  jump bb1

// CHECK-LABEL: {{^[ +].*}}bb1 [cold]:
// CHECK: {{^[ +].*}}push_library L_0
// CHECK: {{^[ +].*}}revert
bb1 [cold]:
  push_library L_0
  dup 1
  revert

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: + push bb3
// CHECK: + jump bb4
bb2:
  push 1
  iszero
  push bb4
  jumpi
  jump bb3

// CHECK-LABEL: {{^[ +].*}}bb3 [cold]:
// CHECK: {{^[ +].*}}push_immutable 0, 32
// CHECK: {{^[ +].*}}revert
bb3 [cold]:
  push_immutable 0, 32
  dup 1
  revert
bb4:
  stop
