//@compile-flags: -Zevm-ir-pipeline=share-reverts
//@filecheck:
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: - iszero
// CHECK: - push bb2
// CHECK: + push bb1
// CHECK: {{^[ +].*}}jumpi
// CHECK: - jump bb1
// CHECK: + jump bb2
bb0:
  push 1
  iszero
  push bb2
  jumpi
  jump bb1

// CHECK-LABEL: {{^[ +].*}}bb1 [cold]:
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}revert
bb1 [cold]:
  // Empty reverts use two PUSH0s, not DUP1.
  push 0
  push 0
  revert
bb2:
  stop
