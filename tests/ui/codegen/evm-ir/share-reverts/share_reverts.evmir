//@ revisions: direct normalized
//@[direct] compile-flags: -Zevm-ir-pipeline=share-reverts
//@[direct] filecheck:
//@[normalized] compile-flags: -Zevm-ir-pipeline=peephole,share-reverts
//@[normalized] filecheck: --check-prefix=NORMALIZED
@module module

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: - iszero
// CHECK: - push bb2
// CHECK: + push bb1
// CHECK: {{^[ +].*}}jumpi
// CHECK: - jump bb1
// CHECK: + jump bb2
bb0:
  push 1
  iszero
  push bb2
  jumpi
  jump bb1

// CHECK-LABEL: {{^[ +].*}}bb1 [cold]:
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}revert
bb1 [cold]:
  // Empty reverts use two PUSH0s, not DUP1.
  push 0
  push 0
  revert
bb2:
  stop

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: - iszero
// CHECK: - push bb5
// CHECK: + push bb4
// CHECK: - jump bb4
// CHECK: + jump bb5
bb3:
  calldatasize
  iszero
  push bb5
  jumpi
  jump bb4

// CHECK-LABEL: {{^[ +].*}}bb4 [cold]:
// CHECK-NEXT: {{^[ +].*}}push 17
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}mstore
// CHECK-NEXT: {{^[ +].*}}push 32
// CHECK-NEXT: {{^[ +].*}}push 0
// CHECK-NEXT: {{^[ +].*}}revert
bb4 [cold]:
  push 17
  push 0
  mstore
  push 32
  push 0
  revert
bb5:
  stop

// CHECK-LABEL: {{^[ +].*}}bb6:
// CHECK-NEXT: {{^[ +].*}}calldatasize
// CHECK-NEXT: {{^[ +].*}}push bb8
// CHECK-NEXT: {{^[ +].*}}jumpi
// CHECK-NEXT: {{^[ +].*}}jump bb7
bb6:
  calldatasize
  push bb8
  jumpi
  jump bb7
bb7 [cold]:
  push 18
  push 0
  mstore
  push 32
  push 0
  revert
bb8:
  stop

// NORMALIZED-LABEL: {{^[ +].*}}bb9:
// NORMALIZED: - push 7
// NORMALIZED: + push 6
// NORMALIZED-LABEL: {{^[ +].*}}bb9:
// NORMALIZED: - push 6
// NORMALIZED: + push 7
// NORMALIZED: - push bb11
// NORMALIZED: + push bb10
// NORMALIZED: - jump bb10
// NORMALIZED: + jump bb11
bb9:
  push 7
  calldatasize
  lt
  iszero
  push bb11
  jumpi
  jump bb10
bb10 [cold]:
  push 17
  push 0
  mstore
  push 32
  push 0
  revert
bb11:
  stop

// The bounded matcher cannot cross a gas observation.
bb12:
  push 6
  gas
  gt
  push bb14
  jumpi
  jump bb13
bb13 [cold]:
  push 32
  push 0
  revert
bb14:
  stop

// Increasing PUSH0 to PUSH1 would increase materialization cost.
bb15:
  push 0
  calldatasize
  gt
  push bb17
  jumpi
  jump bb16
bb16 [cold]:
  push 32
  push 0
  revert
bb17:
  stop

// Negating x > MAX would require an overflowing constant bound.
bb18:
  push 115792089237316195423570985008687907853269984665640564039457584007913129639935
  calldatasize
  gt
  push bb20
  jumpi
  jump bb19
bb19 [cold]:
  push 32
  push 0
  revert
bb20:
  stop

// CHECK-LABEL: {{^[ +].*}}bb21:
// CHECK: - sub
// CHECK: - push bb23
// CHECK: + eq
// CHECK: + push bb22
bb21:
  calldatasize
  push 7
  sub
  push bb23
  jumpi
  jump bb22
bb22 [cold]:
  push 17
  push 0
  mstore
  push 32
  push 0
  revert
bb23:
  stop

// CHECK-LABEL: {{^[ +].*}}bb24:
// CHECK: - eq
// CHECK: - push bb26
// CHECK: + sub
// CHECK: + push bb25
bb24:
  calldatasize
  push 7
  eq
  push bb26
  jumpi
  jump bb25
bb25 [cold]:
  push 17
  push 0
  mstore
  push 32
  push 0
  revert
bb26:
  stop
