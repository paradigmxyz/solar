@module LateOrientationGas

// This module has no code-address observer; GAS independently blocks the rule.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 7
// CHECK-NEXT: {{^[ +].*}}swap 1
// CHECK-NEXT: {{^[ +].*}}swap 2
// CHECK-NEXT: {{^[ +].*}}add
// CHECK: {{^[ +].*}}gas
bb0:
  push 11
  push 12
  push 7
  swap 1
  swap 2
  add
  gas
  push 0
  mstore
  push 32
  push 0
  return
