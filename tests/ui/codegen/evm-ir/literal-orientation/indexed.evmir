//@[byzantium] compile-flags: --evm-version byzantium
//@[osaka] compile-flags: --evm-version osaka
//@ filecheck:
@module LateOrientationIndexed

// A singleton has a provably in-range index; exclusion concerns later encoding.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 7
// CHECK-NEXT: {{^[ +].*}}swap 1
// CHECK-NEXT: {{^[ +].*}}swap 2
// CHECK-NEXT: {{^[ +].*}}add
// CHECK: {{^[ +].*}}indexed_jump bb1
bb0:
  push 11
  push 12
  push 7
  swap 1
  swap 2
  add
  push 0
  indexed_jump bb1
bb1:
  push 0
  mstore
  push 32
  mstore
  push 64
  push 0
  return
