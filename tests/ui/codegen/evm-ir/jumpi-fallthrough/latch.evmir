//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=jumpi-fallthrough
//@[size] compile-flags: -Osize --optimize-runs 1 -Zevm-ir-pipeline=jumpi-fallthrough
//@ run-call: sum(uint256)(uint256) 1 => 1
//@ run-call: sum(uint256)(uint256) 100 => 5050
// The latch jumps back to its header on every iteration but the last, and the exit follows it.
// Turned around, it jumps back on the test's `iszero` and falls into the exit, which saves the
// second transfer on every iteration in gas and size builds alike.
@module Latch
bb0:
  push 0
  push 4
  calldataload
  jump bb1
bb1 [loop]:
  dup 1
  swap 2
  add
  swap 1
  push 1
  swap 1
  sub
  dup 1
  push 0
  eq
  push bb2
  jumpi
  jump bb1
bb2:
  pop
  push 0
  mstore
  push 32
  push 0
  return
