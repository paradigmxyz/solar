//@ compile-flags: -Ogas -Zevm-ir-pipeline=jumpi-fallthrough
//@ run-call: pick(uint256)(uint256) 0 => 1
//@ run-call: pick(uint256)(uint256) 7 => 2
// A condition that already ends in `iszero` loses it when the branch turns around.
@module Iszero
bb0:
  push 4
  calldataload
  iszero
  push bb2
  jumpi
  jump bb1
bb2:
  push 1
  push 0
  mstore
  push 32
  push 0
  return
bb1:
  push 2
  push 0
  mstore
  push 32
  push 0
  return
