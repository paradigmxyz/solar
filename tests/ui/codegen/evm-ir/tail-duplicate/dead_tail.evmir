//@ revisions: gas size
//@ compile-flags: -Zevm-ir-pipeline=tail-duplicate
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
@module DeadTail

// Padding places the callers beyond the packed address range.
bb0:
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  push 0
  calldataload
  jumpi bb1, bb2

bb1:
  push 7
  jump bb3

bb7:
  stop

bb2:
  push 11
  jump bb3

// Unreachable separators keep the callers from falling through into the tail.
bb6:
  stop

// Both predecessors copy this block, so the original disappears.
bb3:
  push 3
  add
  jump bb5

bb4:
  stop

bb5:
  push 0
  mstore
  push 32
  push 0
  return
