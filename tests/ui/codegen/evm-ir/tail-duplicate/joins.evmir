//@ revisions: gas size below above zero
//@ compile-flags: -Zevm-ir-pipeline=tail-duplicate
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@[below] compile-flags: -Ogas --optimize-runs=90
//@[above] compile-flags: -Ogas --optimize-runs=91
//@[zero] compile-flags: -Ogas --optimize-runs=0
@module Joins

bb0:
  push 0
  calldataload
  jumpi bb101, bb100

// Do not disturb labels packed into the one-byte address range.
bb101:
  push 5
  jump bb4

// Padding places the remaining callers beyond the packed region.
bb100:
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  push 32
  calldataload
  jumpi bb1, bb2
bb1:
  push 7
  jump bb4
bb2:
  push 11
  jump bb4
bb3:
  stop
bb4:
  push 3
  add
  jump bb6
bb5:
  stop
bb6:
  push 0
  mstore
  push 32
  push 0
  return

// The incoming fallthrough does not pay a transfer.
bb7:
  push 17
  jump bb8
bb8:
  push 3
  add
  jump bb6

// An outgoing fallthrough would need a new transfer in the copy.
bb9:
  push 19
  jump bb11
bb10:
  stop
bb11:
  push 3
  add
  jump bb12
bb12:
  stop

// Loop and cold tails stay shared.
bb13:
  push 23
  jump bb15
bb14:
  stop
bb15 [loop]:
  push 3
  add
  jump bb6
bb16:
  push 29
  jump bb18
bb17:
  stop
bb18 [cold]:
  push 3
  add
  jump bb6

// Immutable patches and gas observations cannot be copied.
bb19:
  push 31
  jump bb24
bb20:
  jump bb22
bb21:
  stop
bb22:
  push_immutable 0, 1
  jump bb6
bb23:
  stop
bb24:
  gas
  pop
  jump bb6
