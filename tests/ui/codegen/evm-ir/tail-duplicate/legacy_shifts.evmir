//@ revisions: byzantium constantinople
//@ compile-flags: -Ogas -Zevm-ir-pipeline=tail-duplicate -Zdump=disasm-runtime
//@[byzantium] compile-flags: --evm-version byzantium
//@[constantinople] compile-flags: --evm-version constantinople
//@[byzantium] filecheck: --check-prefix=LEGACY
//@[constantinople] filecheck: --check-prefix=NATIVE

@module LegacyShiftTail

// Padding places both callers beyond the packed-address prefix.
bb0:
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  push 0
  calldataload
  jumpi bb1, bb2

// The legacy expansion must stay shared; native SAR remains cheap enough to copy.
// LEGACY: PUSH1 0x07
// LEGACY-NEXT: PUSH1 0x01
// LEGACY-NEXT: PUSH2 [[TAIL:0x[0-9a-f]+]]
// LEGACY-NEXT: JUMP
// NATIVE: PUSH1 0x07
// NATIVE-NEXT: PUSH1 0x01
// NATIVE-NEXT: SAR
bb1:
  push 7
  push 1
  jump bb4

// LEGACY: PUSH1 0x09
// LEGACY-NEXT: PUSH1 0x01
// LEGACY-NEXT: PUSH2 [[TAIL]]
// LEGACY-NEXT: JUMP
// NATIVE: PUSH1 0x09
// NATIVE-NEXT: PUSH1 0x01
// NATIVE-NEXT: SAR
bb2:
  push 9
  push 1
  jump bb4
bb3:
  stop
bb4:
  sar
  jump bb6
bb5:
  stop
bb6:
  push 0
  mstore
  push 32
  push 0
  return
