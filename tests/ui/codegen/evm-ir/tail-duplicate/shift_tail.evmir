//@ compile-flags: --evm-version constantinople -Ogas -Zevm-ir-pipeline=tail-duplicate -Zdump=disasm-runtime
//@ filecheck:

@module ShiftTail

// Padding places both callers beyond the packed-address prefix.
bb0:
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  push 0x123456789abcdef013579bdf2468ace01234567890abcdef032547698badcfe0
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  pop
  push 0
  calldataload
  jumpi bb1, bb2

// Native SAR is cheap enough to copy into both callers.
// CHECK: PUSH1 0x07
// CHECK-NEXT: PUSH1 0x01
// CHECK-NEXT: SAR
bb1:
  push 7
  push 1
  jump bb4

// CHECK: PUSH1 0x09
// CHECK-NEXT: PUSH1 0x01
// CHECK-NEXT: SAR
bb2:
  push 9
  push 1
  jump bb4
bb3:
  stop
bb4:
  sar
  jump bb6
bb5:
  stop
bb6:
  push 0
  mstore
  push 32
  push 0
  return
