//@ revisions: gas size
//@ compile-flags: --evm-version=osaka -Zevm-ir-pipeline=cfg-simplify
//@[gas] compile-flags: -Ogas
//@[size] compile-flags: -Osize
//@[gas] filecheck: --check-prefix=FOLD
//@[size] filecheck: --check-prefix=KEEP
@module DirectLiteralArms

bb0:
  push 0
  calldataload
  push 0
  eq
  jumpi bb100, bb1
bb1:
  push 0
  calldataload
  push 1
  eq
  jumpi bb110, bb2
bb2:
  push 0
  calldataload
  push 2
  eq
  jumpi bb120, bb3
bb3:
  push 0
  calldataload
  push 3
  eq
  jumpi bb130, bb4
bb4:
  push 0
  calldataload
  push 4
  eq
  jumpi bb140, bb5
bb5:
  push 0
  calldataload
  push 5
  eq
  jumpi bb150, bb6
bb6:
  push 0
  calldataload
  push 6
  eq
  jumpi bb160, bb999
bb999:
  stop

// Arbitrary truthiness: condition 0 selects 1; every nonzero condition selects 0.
// KEEP-LABEL: {{^[ +] *}}bb100:
// KEEP: {{^[ +] *}}jumpi bb101, bb102
// FOLD-LABEL: {{^[ +] *}}bb100:
// FOLD-NOT: {{^[ +] *}}jumpi bb101, bb102
// FOLD: {{^[ +] *}}iszero
// FOLD: {{^[ +] *}}push 0
// FOLD: {{^[ +] *}}add
// FOLD: {{^[ +] *}}push 0
// FOLD: {{^[ +] *}}mstore
// FOLD: {{^[ +] *}}push 32
// FOLD: {{^[ +] *}}push 0
// FOLD: {{^[ +] *}}return
bb100:
  push 32
  calldataload
  jumpi bb101, bb102
bb101:
  push 0
  push 0
  mstore
  push 32
  push 0
  return
bb102:
  push 1
  push 0
  mstore
  push 32
  push 0
  return

// Canonical EQ keeps its Boolean word; no second normalization.
// KEEP-LABEL: {{^[ +] *}}bb110:
// KEEP: {{^[ +] *}}jumpi bb111, bb112
// FOLD-LABEL: {{^[ +] *}}bb110:
// FOLD-NOT: {{^[ +] *}}jumpi bb111, bb112
// FOLD: {{^[ +] *}}eq
// FOLD-NOT: {{^[ +] *}}iszero
// FOLD: {{^[ +] *}}push 5
// FOLD: {{^[ +] *}}shl
// FOLD: {{^[ +] *}}push 36
// FOLD: {{^[ +] *}}sub
// FOLD: {{^[ +] *}}push 0
// FOLD: {{^[ +] *}}mstore
// FOLD: {{^[ +] *}}push 32
// FOLD: {{^[ +] *}}push 0
// FOLD: {{^[ +] *}}return
bb110:
  push 32
  calldataload
  push 7
  eq
  jumpi bb111, bb112
bb111:
  push 4
  push 0
  mstore
  push 32
  push 0
  return
bb112:
  push 36
  push 0
  mstore
  push 32
  push 0
  return

