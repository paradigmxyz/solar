//@ revisions: none simplify
//@[none] compile-flags: -Ogas -Zevm-ir-pipeline=none
//@[simplify] compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify
@module Continuations

bb0:
  push 0
  calldataload
  jumpi bb1, bb6

// The hidden return address can bypass both continuation thunks.
bb1:
  push bb2
  jump bb5
bb2 [continuation]:
  jump bb3
bb3 [continuation]:
  jump bb4
bb4:
  stop
bb5:
  jump

// These ordinary address-taken labels must remain distinct: their identity is observed.
bb6:
  push bb7
  push bb8
  eq
  push 0
  mstore
  push 32
  push 0
  return
bb7:
  jump bb4
bb8:
  jump bb4
