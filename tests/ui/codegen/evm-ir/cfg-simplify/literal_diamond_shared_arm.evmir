//@ compile-flags: --evm-version=london -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module LiteralDiamondGuard
// CHECK-LABEL: bb0:
// CHECK: jumpi [[YES:bb[0-9]+]], [[NO:bb[0-9]+]]
// CHECK: [[YES]]:
// CHECK: push 4
// CHECK: [[NO]]:
// CHECK: push 36
bb10:
  calldatasize
  jumpi bb0, bb11
bb11:
  jump bb1
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 4
  jump bb3
bb2:
  push 36
  jump bb3
bb3:
  push 0
  mstore

  push 32
  push 0
  return
