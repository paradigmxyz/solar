//@compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify
//@filecheck:
// A branch whose edges reach halting blocks with identical bodies, directly or
// through empty jumps, runs the same code either way, so it becomes a `pop` of
// its condition. Halting blocks that differ, or equal blocks that do not halt,
// keep the branch.
@module module

bb0:
  push 0
  calldataload
  jumpi bb20, bb21

bb20:
  push 32
  calldataload
  jumpi bb1, bb3

bb21:
  push 64
  calldataload
  jumpi bb7, bb10

// CHECK-LABEL: bb1:
// CHECK: - jumpi bb2, bb30
// CHECK: + pop
bb1:
  calldatasize
  jumpi bb2, bb30

bb2:
  push 0
  push 0
  revert

bb30:
  push 0
  push 0
  revert

// CHECK-LABEL: bb3:
// CHECK: - push bb4
// CHECK-NEXT: - jumpi
// CHECK: + pop
// CHECK-NEXT: {{^ +}}push 1
bb3:
  callvalue
  push bb4
  jumpi
  jump bb5

bb4:
  push 1
  push 2
  revert

bb5:
  jump bb6

bb6:
  push 1
  push 2
  revert

// CHECK-LABEL: bb7:
// CHECK: {{^ +}}jumpi bb8, bb9
bb7:
  caller
  jumpi bb8, bb9

bb8:
  push 0
  push 0
  revert

bb9:
  push 0
  push 0
  return

// CHECK-LABEL: bb10:
// CHECK: {{^ +}}jumpi bb11, bb12
bb10:
  origin
  jumpi bb11, bb12

bb11:
  push 0
  jump bb13

bb12:
  push 0
  jump bb13

bb13:
  pop
  stop
