//@ revisions: cfg dedup
//@[cfg] compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify -Zdump=disasm-runtime
//@[dedup] compile-flags: -Ogas -Zevm-ir-pipeline=terminal-dedup -Zdump=disasm-runtime
//@ filecheck:
@module LivePc

// Both structural and physical branches must retain separate PC instructions.
// CHECK: JUMPI
// CHECK: PC
// CHECK: RETURN
// CHECK: PC
// CHECK: RETURN
// CHECK: PC
// CHECK: RETURN
// CHECK: PC
// CHECK: RETURN
bb0:
  push 0
  calldataload
  jumpi bb1, bb2

bb1:
  push 32
  calldataload
  jumpi bb3, bb4

bb2:
  push 64
  calldataload
  push bb5
  jumpi
  jump bb6

bb3:
  pc
  push 0
  mstore
  push 32
  push 0
  return

bb4:
  pc
  push 0
  mstore
  push 32
  push 0
  return

bb5:
  pc
  push 0
  mstore
  push 32
  push 0
  return

bb6:
  pc
  push 0
  mstore
  push 32
  push 0
  return
