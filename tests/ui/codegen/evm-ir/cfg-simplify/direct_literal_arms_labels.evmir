//@ compile-flags: -Ogas --evm-version=osaka -Zevm-ir-pipeline=cfg-simplify,block-layout
//@ filecheck:

// The nonempty predecessor with a higher ID survives forwarding and absorbs the parent.
// A fresh false-return leaf must still follow that parent after block-layout.
// The original external names are intentionally noncanonical. The existing bb9
// is internal ID 7; a fresh internal ID 9 must receive a different printed name.
// CHECK-LABEL: (after block-layout)
// CHECK: {{^[ +] *}}bb9:
// CHECK: {{^[ +] *}}push 99
// CHECK: {{^[ +] *}}pop
// CHECK: {{^[ +] *}}sub
// CHECK: {{^[ +] *}}jumpi bb6, [[FRESH:bb([0-8]|[1-9][0-9]+)]]
// CHECK-NOT: {{^[ +] *}}bb
// CHECK: {{^[ +] *}}[[FRESH]]:
// CHECK: {{^[ +] *}}push 0
// CHECK: {{^[ +] *}}mstore
// CHECK: {{^[ +] *}}push 32
// CHECK: {{^[ +] *}}push 0
// CHECK: {{^[ +] *}}return

@module DirectLiteralLayout
bb0:
  calldatasize
  jumpi bb9, bb10
bb4:
  push 0
  mstore
  push 32
  push 0
  return
bb5:
  push 0
  mstore
  push 32
  push 0
  return
bb3:
  push 32
  calldataload
  iszero
  jumpi bb1, bb2
bb1:
  push 4
  calldataload
  dup1
  iszero
  jumpi bb6, bb4
bb2:
  push 36
  calldataload
  dup1
  iszero
  jumpi bb6, bb5
bb6:
  push 0
  push 0
  revert
bb9:
  push 99
  pop
  jump bb3
bb10:
  stop
