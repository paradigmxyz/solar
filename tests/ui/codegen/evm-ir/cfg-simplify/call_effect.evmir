//@compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify
//@filecheck:
@module module

// A function that returns through a jump is absorbed into its caller, which pushed the address.
// CHECK-LABEL: bb0:
// CHECK: - jump bb11
// CHECK-NEXT: + push bb13
// CHECK-NEXT: + push 1
// CHECK-NEXT: + swap 1
// CHECK-NEXT: + jump
bb0:
  push 0
  calldataload
  push bb1
  jumpi
  push 32
  calldataload
  push bb6
  jumpi
  jump bb11

// A function entry that is absorbed into its caller passes its call effect to the loop header it
// continues in. The call effect then counts the word the entry left above the return address.
// CHECK-LABEL: bb1:
// CHECK: - jump bb2
// CHECK: - bb2 [ret=0, inputs=1, outputs=1]:
// CHECK: + bb4 [ret=1, inputs=2, outputs=1]:
bb1:
  push bb3
  jump bb2

bb2 [ret=0, inputs=1, outputs=1]:
  push 1
  jump bb4

bb3 [continuation]:
  stop

bb4:
  push 64
  calldataload
  push bb4
  jumpi
  swap 1
  jump

// A function entry that calls out stays apart from its caller, so that the call back to the
// caller's continuation keeps its place at the top of the stack.
// CHECK-LABEL: bb6:
// CHECK-NEXT: push bb9
// CHECK-NEXT: jump bb8
// CHECK-NEXT: bb8 [ret=0, inputs=1, outputs=1]:
bb6:
  push bb9
  jump bb8

bb8 [ret=0, inputs=1, outputs=1]:
  push bb10
  push 3
  jump bb12

bb9 [continuation]:
  stop

bb10 [continuation]:
  jump

bb12 [ret=1, inputs=2, outputs=1]:
  swap 1
  jump

bb11:
  push bb13
  jump bb14

bb14 [ret=0, inputs=1, outputs=1]:
  push 1
  swap 1
  jump

bb13 [continuation]:
  stop
