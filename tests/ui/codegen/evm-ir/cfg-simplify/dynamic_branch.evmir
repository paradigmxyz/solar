//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module DynamicBranch

bb0:
  push 0
  calldataload
  jump
bb1:
  push 42
  push 0
  mstore
  push 32
  push 0
  return
// Independent references keep every dynamically entered target addressable.
bb2:
  push bb1
  push bb3
  push bb4
  stop
// Both identical conditional targets remain independently addressable.
// CHECK-LABEL: bb3:
// CHECK: jumpi bb1, bb4
bb3:
  push 32
  calldataload
  jumpi bb1, bb4
// CHECK-LABEL: bb4:
// CHECK-NEXT: push 42
bb4:
  push 42
  push 0
  mstore
  push 32
  push 0
  return
