//@ revisions: modern legacy
//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@[modern] compile-flags: --evm-version=london
//@[modern] filecheck: --check-prefix=FOLD
//@[legacy] compile-flags: --evm-version=byzantium
//@[legacy] filecheck: --check-prefix=KEEP
@module LiteralDiamond

// Arbitrary nonzero conditions select the true literal, including 2 and MAX.
// FOLD-LABEL: bb0:
// FOLD: {{^[ +] *}}calldataload
// FOLD: {{^[ +] *}}iszero
// FOLD: {{^[ +] *}}push 5
// FOLD: {{^[ +] *}}shl
// FOLD: {{^[ +] *}}push 4
// FOLD: {{^[ +] *}}add
// FOLD: {{^[ +] *}}iszero
// FOLD: {{^[ +] *}}push 8
// FOLD: {{^[ +] *}}shl
// FOLD: {{^[ +] *}}push 512
// FOLD: {{^[ +] *}}sub
// KEEP: jumpi bb1, bb2
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 4
  jump bb3
bb2:
  push 36
  jump bb3
bb3:
  push 0
  mstore
  push 32
  calldataload
  jumpi bb4, bb5
// Descending constants exercise SUB with EVM top-minus-next operand order.
bb4:
  push 512
  jump bb6
bb5:
  push 256
  jump bb6
bb6:
  push 32
  mstore
  push 64
  push 0
  return
