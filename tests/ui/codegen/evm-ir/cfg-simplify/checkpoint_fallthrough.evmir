//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
// One direct jump is insufficient when another path falls into the label.
@module CheckpointFallthrough
bb0:
  push 0
  calldataload
  push bb2 !metadata(span=10..20)
  jumpi !metadata(span=10..20)
  jump bb1
bb1:
  push 1
  pop
  jump bb2
bb2 [checkpoint=30..40@10..20@0]:
  push 2
  push 0
  mstore
  stop
