//@ compile-flags: -Ogas --evm-version=osaka -Zevm-ir-pipeline=cfg-simplify,block-layout
//@ filecheck:
// Both folds append fresh Return blocks in one simplification run. The second
// parent's old incoming count is conservative after the first pair disappears.
// CHECK-LABEL: (after block-layout)
// CHECK: {{^[ +] *}}bb13:
// CHECK: {{^[ +] *}}push 100
// CHECK: {{^[ +] *}}sub
// CHECK: {{^[ +] *}}jumpi bb20, [[SECOND:bb[0-9]+]]
// CHECK-NOT: {{^[ +] *}}bb
// CHECK: {{^[ +] *}}[[SECOND]]:
// CHECK: {{^[ +] *}}mstore
// CHECK: {{^[ +] *}}return
// CHECK: {{^[ +] *}}bb90:
// CHECK: {{^[ +] *}}push 99
// CHECK: {{^[ +] *}}pop
// CHECK: {{^[ +] *}}push 36
// CHECK: {{^[ +] *}}sub
// CHECK: {{^[ +] *}}jumpi bb13, [[FIRST:bb[0-9]+]]
// CHECK-NOT: {{^[ +] *}}bb
// CHECK: {{^[ +] *}}[[FIRST]]:
// CHECK: {{^[ +] *}}mstore
// CHECK: {{^[ +] *}}return
// CHECK: {{^[ +] *}}bb20 [cold]:
// CHECK: {{^[ +] *}}revert
@module TwoSequentialFreshReturns
bb0:
  calldatasize
  jumpi bb90, bb91
bb4:
  push 0
  mstore
  push 32
  push 0
  return
bb5:
  push 0
  mstore
  push 32
  push 0
  return
bb14:
  push 0
  mstore
  push 32
  push 0
  return
bb15:
  push 0
  mstore
  push 32
  push 0
  return
bb3:
  push 132
  calldataload
  iszero
  jumpi bb1, bb2
bb1:
  push 4
  calldataload
  dup 1
  iszero
  jumpi bb13, bb4
bb2:
  push 36
  calldataload
  dup 1
  iszero
  jumpi bb13, bb5
bb13:
  pop
  push 164
  calldataload
  iszero
  jumpi bb11, bb12
bb11:
  push 68
  calldataload
  dup 1
  iszero
  jumpi bb20, bb14
bb12:
  push 100
  calldataload
  dup 1
  iszero
  jumpi bb20, bb15
bb20 [cold]:
  push 0
  push 0
  revert
bb90:
  push 99
  pop
  jump bb3
bb91:
  stop
