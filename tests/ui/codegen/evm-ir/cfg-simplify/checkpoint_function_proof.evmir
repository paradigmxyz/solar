//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=check
// An unmapped transfer must retain its recorded function identity. The second checkpoint's
// identity does not match, so it cannot invent a source hit on that branch.
@module CheckpointFunctionProof
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(invoke=caller@100..200)
bb1 [checkpoint=30..40@100..200@0]:
  push 1
  push 0
  mstore
  stop
bb2 [checkpoint=50..60@300..400@0]:
  push 2
  push 0
  mstore
  stop
