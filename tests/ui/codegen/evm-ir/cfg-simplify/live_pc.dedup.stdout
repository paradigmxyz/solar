- ; === ROOT/tests/ui/codegen/evm-ir/cfg-simplify/live_pc.evmir (before terminal-dedup) ===
+ ; === ROOT/tests/ui/codegen/evm-ir/cfg-simplify/live_pc.evmir (after terminal-dedup) ===
  @module LivePc
  bb0:
    push 0
    calldataload
    jumpi bb1, bb2
  bb1:
    push 32
    calldataload
    jumpi bb3, bb4
  bb2:
    push 64
    calldataload
    push bb5
    jumpi
    jump bb6
  bb3:
    pc
    push 0
    mstore
    push 32
    push 0
    return
  bb4:
    pc
    push 0
    mstore
    push 32
    push 0
    return
  bb5:
    pc
    push 0
    mstore
    push 32
    push 0
    return
  bb6:
    pc
    push 0
    mstore
    push 32
    push 0
    return
  
; === LivePc (runtime) ===
bb0:
  0000  PUSH0
  0001  CALLDATALOAD
  0002  ISZERO
  0003  PUSH1 0x0f
  0005  JUMPI  ; -> bb3, else bb1
bb1:
  0006  PUSH1 0x20
  0008  CALLDATALOAD
  0009  PUSH1 0x19
  000b  JUMPI  ; -> bb5, else bb2
bb2:
  000c  PUSH1 0x21
  000e  JUMP  ; -> bb6
bb3:
  000f  JUMPDEST
  0010  PUSH1 0x40
  0012  CALLDATALOAD
  0013  PUSH1 0x29
  0015  JUMPI  ; -> bb7, else bb4
bb4:
  0016  PUSH1 0x31
  0018  JUMP  ; -> bb8
bb5:
  0019  JUMPDEST
  001a  PC
  001b  PUSH0
  001c  MSTORE
  001d  PUSH1 0x20
  001f  PUSH0
  0020  RETURN
bb6:
  0021  JUMPDEST
  0022  PC
  0023  PUSH0
  0024  MSTORE
  0025  PUSH1 0x20
  0027  PUSH0
  0028  RETURN
bb7:
  0029  JUMPDEST
  002a  PC
  002b  PUSH0
  002c  MSTORE
  002d  PUSH1 0x20
  002f  PUSH0
  0030  RETURN
bb8:
  0031  JUMPDEST
  0032  PC
  0033  PUSH0
  0034  MSTORE
  0035  PUSH1 0x20
  0037  PUSH0
  0038  RETURN
