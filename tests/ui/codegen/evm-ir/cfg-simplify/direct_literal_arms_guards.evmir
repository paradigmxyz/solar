//@ compile-flags: -Ogas --evm-version=osaka -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module DirectLiteralArmsGuards

bb0:
  push 0
  calldataload
  push 0
  eq
  jumpi bb100, bb1
bb1:
  push 0
  calldataload
  push 1
  eq
  jumpi bb110, bb2
bb2:
  push 0
  calldataload
  push 2
  eq
  jumpi bb120, bb999
bb999:
  stop

// The shifted selection plus normalization and two markers is not profitable.
// CHECK-LABEL: {{^[ +] *}}bb100:
// CHECK: {{^[ +] *}}jumpi bb101, bb102
bb100:
  push 32
  calldataload
  jumpi bb101, bb102
bb101:
  push 4
  push 0
  mstore
  push 32
  push 0
  return
bb102:
  push 36
  push 0
  mstore
  push 32
  push 0
  return

// A modulo-wrapped difference is not an integer power of two.
// CHECK-LABEL: {{^[ +] *}}bb110:
// CHECK: {{^[ +] *}}jumpi bb111, bb112
bb110:
  push 32
  calldataload
  iszero
  jumpi bb111, bb112
bb111:
  push 115792089237316195423570985008687907853269984665640564039457584007913129639935
  push 0
  mstore
  push 32
  push 0
  return
bb112:
  push 0
  push 0
  mstore
  push 32
  push 0
  return

// An explicit, valid literal stack annotation declines the new rewrite.
// CHECK-LABEL: {{^[ +] *}}bb120:
// CHECK: {{^[ +] *}}jumpi bb121, bb122
bb120:
  push 32
  calldataload
  iszero
  jumpi bb121, bb122
bb121:
  push 4 !metadata(stack=0->1)
  push 0
  mstore
  push 32
  push 0
  return
bb122:
  push 36
  push 0
  mstore
  push 32
  push 0
  return
