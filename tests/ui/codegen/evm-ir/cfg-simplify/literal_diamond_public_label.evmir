//@ compile-flags: --evm-version=london -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module LiteralDiamondGuard
// CHECK-LABEL: bb0:
// CHECK: jumpi bb1, bb2
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 4
  jump bb3
bb2:
  push 36
  jump bb3
bb3:
  push 0
  mstore
  push bb1
  push 64
  mstore
  push 32
  push 0
  return
