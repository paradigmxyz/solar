//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
// Checkpoints cannot survive opaque address uses or a different incoming source origin.
@module CheckpointProof
bb0:
  push bb1
  push 0
  mstore
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1 [checkpoint=30..40@10..20@0]:
  push 1
  push 0
  mstore
  stop
bb2 [checkpoint=50..60@70..80@0]:
  push 2
  push 0
  mstore
  stop
