//@ compile-flags: -Osize -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module SharedBranches

bb0:
  push bb1
  pop
  push bb2
  pop
  push bb3
  pop
  push bb4
  pop
  push bb5
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: - push bb7
// CHECK: - jump bb6
// CHECK: + jumpi bb7, bb8
bb1:
  push 1
  push bb7
  jump bb6

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: + jumpi bb7, bb8 !metadata(invoke=caller@5..10)
bb2:
  push 0
  push bb7 !metadata(invoke=caller@5..10)
  jump bb6

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: + jumpi bb7, bb8 !metadata(invoke=callee@1..5)
bb3:
  push 1
  push bb7
  jump bb6 !metadata(invoke=callee@1..5)

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: + jumpi bb7, bb8 !metadata(invoke=callee@10..20)
bb4:
  push 1
  push bb7
  jump bb9

// CHECK-LABEL: {{^[ +].*}}bb5:
// CHECK: {{^[ +].*}}push bb7
// CHECK: {{^[ +] *}}jumpi{{$}}
// CHECK-NEXT: {{^[ +].*}}jump bb8
bb5:
  push 1
  push bb7
  jump bb6 !metadata(stack=0->0)

bb6:
  jumpi
  jump bb8
bb7:
  stop
bb8:
  push 0
  push 0
  revert
bb9 [invoke=callee@10..20]:
  jumpi
  jump bb8
