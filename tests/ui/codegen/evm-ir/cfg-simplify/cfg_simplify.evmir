//@compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@filecheck:
@module module

// CHECK-LABEL: bb0:
// CHECK: - push bb1
// CHECK: + push bb2
bb0:
  push bb1
  jump

// CHECK: - bb1:
// CHECK: - jump bb2
bb1:
  jump bb2

// CHECK-LABEL: bb2:
// CHECK: {{^[ +].*}}push bb3
// CHECK: {{^[ +].*}}push bb7
// CHECK: {{^[ +].*}}push bb9
// CHECK: - jump bb4
// CHECK: + push 1
// CHECK-NEXT: + pop
// CHECK-NEXT: + stop
bb2:
  push 1
  push bb3
  pop
  push bb7
  pop
  push bb9
  pop
  push bb11
  pop
  push bb15
  pop
  jump bb4

// CHECK-LABEL: bb3:
// CHECK: {{^[ +].*}}jump bb2
bb3:
  push 2
  jump bb2

// CHECK: - bb4:
// CHECK: - jump bb5
// CHECK: - bb5:
// CHECK: - jumpi bb6, bb6
// CHECK: - bb6:
// CHECK: - stop
bb4:
  jump bb5
bb5:
  push 1
  jumpi bb6, bb6
bb6:
  stop

// CHECK-LABEL: bb7:
// CHECK: - jump bb8
// CHECK: - bb8:
// CHECK: {{^[ +].*}}stop
bb7:
  jump bb8
bb8:
  stop

// Physical branches use an encoded target push and `JUMPI` before the
// unconditional terminator.
// CHECK-LABEL: bb9:
// CHECK: {{^[ +].*}}push 7
// CHECK: - push bb10
// CHECK: - jumpi
// CHECK: - jump bb10
// CHECK: - bb10:
// CHECK: + pop
// CHECK-NEXT: {{^[ +].*}}stop
bb9:
  push 7
  push bb10
  jumpi
  jump bb10
bb10:
  stop

// A shared conditional jump consumes the label directly.
// CHECK-LABEL: bb11:
// CHECK: - push bb12
// CHECK: + push bb14
bb11:
  push 1
  push bb12
  jump bb13
bb12:
  jump bb14
bb13:
  jumpi
  stop
bb14:
  push 9
  pop
  stop

// A stack operation before the shared jump makes the label an ordinary value.
// CHECK-LABEL: bb15:
// CHECK: {{^[ +].*}}push bb16
bb15:
  push 1
  push bb16
  jump bb17
bb16:
  jump bb18
bb17:
  swap 1
  jumpi
  stop
bb18:
  push 10
  pop
  stop
