//@compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify
//@filecheck:
@module module

// CHECK-LABEL: bb0:
// CHECK: - push bb1
// CHECK: + push bb2
bb0:
  push bb1
  jump

// CHECK: - bb1:
// CHECK: - jump bb2
bb1:
  jump bb2

// CHECK-LABEL: bb2:
// CHECK: {{^[ +].*}}push bb3
// CHECK: {{^[ +].*}}push bb7
// CHECK: {{^[ +].*}}push bb9
// CHECK: - jump bb4
// CHECK: + push 1
// CHECK-NEXT: + pop
// CHECK-NEXT: + stop
bb2:
  push bb33
  pop
  push bb36
  pop
  push bb42
  pop
  push bb45
  pop
  push bb31
  pop
  push 1
  push bb3
  pop
  push bb7
  pop
  push bb9
  pop
  push bb11
  pop
  push bb15
  pop
  push bb19
  pop
  push bb20
  pop
  push bb21
  pop
  push bb22
  pop
  push bb23
  pop
  push bb24
  pop
  push bb25
  pop
  push bb26
  pop
  push bb27
  pop
  push bb28
  pop
  push bb29
  pop
  push bb30
  pop
  jump bb4

// CHECK-LABEL: bb3:
// CHECK: {{^[ +].*}}jump bb2
bb3:
  push 2
  jump bb2

// CHECK: - bb4:
// CHECK: - jump bb5
// CHECK: - bb5:
// CHECK: - jumpi bb6, bb6
// CHECK: - bb6:
// CHECK: - stop
bb4:
  jump bb5
bb5:
  push 1
  jumpi bb6, bb6
bb6:
  stop

// CHECK-LABEL: bb7:
// CHECK: - jump bb8
// CHECK: - bb8:
// CHECK: {{^[ +].*}}stop
bb7:
  jump bb8
bb8:
  stop

// Physical branches use an encoded target push and `JUMPI` before the
// unconditional terminator.
// CHECK-LABEL: bb9:
// CHECK: {{^[ +].*}}push 7
// CHECK: - push bb10
// CHECK: - jumpi
// CHECK: - jump bb10
// CHECK: - bb10:
// CHECK: + pop
// CHECK-NEXT: {{^[ +].*}}stop
bb9:
  push 7
  push bb10
  jumpi
  jump bb10
bb10:
  stop

// A shared conditional jump consumes the label directly.
// CHECK-LABEL: bb11:
// CHECK: - push bb12
// CHECK: + push bb14
bb11:
  push 1
  push bb12
  jump bb13
bb12:
  jump bb14
bb13:
  jumpi
  stop
bb14:
  push 9
  pop
  stop

// A stack operation before the shared jump makes the label an ordinary value.
// CHECK-LABEL: bb15:
// CHECK: {{^[ +].*}}push bb16
bb15:
  push 1
  push bb16
  jump bb17
bb16:
  jump bb18
bb17:
  swap 1
  jumpi
  stop
bb18:
  push 10
  pop
  stop

bb19:
  jump bb21
bb20:
  jump bb21
// CHECK-LABEL: {{^[ +].*}}bb21:
// CHECK: - jump bb22 !metadata(span=10..20)
// CHECK: + push 128 !metadata(span=10..20)
// CHECK-NEXT: + mstore
// CHECK-NEXT: + push 32
// CHECK-NEXT: + push 128
// CHECK-NEXT: + return
bb21:
  jump bb22 !metadata(span=10..20)
bb22:
  push 128
  mstore
  push 32
  push 128
  return
// CHECK-LABEL: {{^[ +].*}}bb23:
// CHECK-NEXT: {{^[ +].*}}jump bb22
bb23:
  jump bb22

bb24:
  jump bb26
bb25:
  jump bb26
// CHECK-LABEL: {{^[ +].*}}bb26:
// CHECK-NEXT: {{^[ +].*}}jump bb27
bb26:
  jump bb27
bb27:
  push 256
  mstore
  push 32
  push 256
  return
bb28:
  jump bb30
bb29:
  jump bb30
// CHECK-LABEL: {{^[ +].*}}bb30:
// CHECK: + push 128 !metadata(invoke=callee@30..40)
// CHECK-NEXT: + mstore
// CHECK: + return
bb30:
  jump bb22 !metadata(invoke=callee@30..40)


// CHECK-LABEL: {{^[ +].*}}bb31 [loop]:
// CHECK: {{^[ +].*}}push 7
// CHECK: {{^[ +].*}}push 8
// CHECK: {{^[ +].*}}stop
bb31:
  push 7
  jump bb32
bb32 [loop]:
  push 8
  stop

// CHECK-LABEL: {{^[ +].*}}bb33:
// CHECK: + jumpi bb34, bb35 !metadata(span=10..20)
bb33:
  calldatasize
  push bb34
  jumpi !metadata(span=10..20)
  jump bb35
bb34:
  push 0
  push 0
  mstore
  jump bb35
bb35:
  stop

// CHECK-LABEL: {{^[ +].*}}bb36 [loop]:
// CHECK: {{^[ +].*}}push bb37
// CHECK: {{^[ +].*}}jumpi
// CHECK: {{^[ +].*}}jump bb38
bb36 [loop]:
  calldatasize
  push bb37
  jumpi !metadata(span=10..20)
  jump bb38
bb37:
  push 0
  push 0
  mstore
  jump bb38
bb38:
  stop

// CHECK-LABEL: {{^[ +].*}}bb42:
// CHECK: + jumpi bb43, bb44 !metadata(invoke=callee@30..40)
bb42:
  calldatasize
  push bb43
  jumpi !metadata(invoke=callee@30..40)
  jump bb44
bb43:
  push 0
  push 0
  mstore
  jump bb44
bb44:
  stop

// CHECK-LABEL: {{^[ +].*}}bb45:
// CHECK: {{^[ +].*}}push bb46
// CHECK: {{^[ +].*}}jumpi
// CHECK: {{^[ +].*}}jump bb47
bb45:
  calldatasize
  push bb46
  jumpi !metadata(span=10..20)
  jump bb47
bb46 [cold]:
  push 0
  push 0
  mstore
  jump bb47
bb47:
  stop
