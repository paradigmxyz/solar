//@ revisions: gas budget size
//@[gas] compile-flags: -Ogas --optimize-runs 10000 -Zevm-ir-pipeline=copy-loop-blocks
//@[budget] compile-flags: -Ogas -Zevm-ir-pipeline=copy-loop-blocks
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=copy-loop-blocks
// Gas builds copy a branching loop's latch into the path that jumps to it, and
// the header into each block that then jumps to it, so the iterations through
// those paths take no unconditional jump. The path that falls through into the
// latch already takes none. In the second loop, the body too large to repay
// its copy and the block that ends the call stay shared, while the small
// header is copied into the body. Size builds copy nothing.
// At the default runs, the copies may add a twentieth of this small module's code: only the
// first loop's latch goes, whose copy adds the fewest bytes for the jump it saves.
@module CopyLoopBlocks
bb0:
  push 3
  push 0
  jump bb1
bb1 [loop]:
  dup 2
  dup 2
  lt
  push bb2
  jumpi
  jump bb6
bb2 [loop]:
  dup 1
  push 1
  and
  push bb4
  jumpi
  push 7
  pop
  jump bb5
bb4 [loop]:
  push 9
  pop
  jump bb5
bb5 [loop]:
  push 1
  add
  jump bb1
bb6:
  pop
  pop
  push 0
  jump bb7
bb7 [loop]:
  dup 1
  push 4
  lt
  push bb9
  jumpi
  jump bb12
bb8 [loop]:
  push 0xf3e2032afb5d60cd59de9ee314306de24f154ccf4db15b97573f0da04f9cdbb2
  pop
  push 0x27f2f3b5c278b1d8e1f6f9393f641c962573ace18c81b6e8e001b187fba5a5cc
  pop
  push 1
  add
  jump bb7
bb9 [loop]:
  dup 1
  push 2
  eq
  push bb10
  jumpi
  jump bb8
bb10 [loop]:
  jump bb11
bb12:
  pop
  stop
bb11 [loop]:
  push 0
  push 0
  return
