//@ compile-flags: --evm-version petersburg -Ogas --optimize-runs 10000 -Zevm-ir-pipeline=copy-loop-blocks -Zvalidate-ir=true -Zdump=disasm-runtime
//~? ERROR: opcode `selfbalance` is unavailable for `petersburg` EVM
// A copy must not add uses of an opcode the target lacks, which the checks after each pass count
// as new, so the latch that reads the balance stays shared. The header has no such opcode and is
// copied into the latch as usual. Only the final check reports the use the input already had.
@module UnavailableOpcode
bb0:
  push 3
  push 0
  jump bb1
bb1 [loop]:
  dup 2
  dup 2
  lt
  push bb2
  jumpi
  jump bb6
bb2 [loop]:
  dup 1
  push 1
  and
  push bb4
  jumpi
  push 7
  pop
  jump bb5
bb4 [loop]:
  push 9
  pop
  jump bb5
bb5 [loop]:
  selfbalance
  pop
  push 1
  add
  jump bb1
bb6:
  pop
  pop
  stop
