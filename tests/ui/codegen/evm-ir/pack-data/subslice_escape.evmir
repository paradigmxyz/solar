//@ compile-flags: -Ogas -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module subslice_escape
@data
  literal_0: hex"2233"
  literal_1: hex"2233"
  literal_2: hex"aa"

// An out-of-range copy may observe bytes after this entry, so packing must
// preserve its address and surrounding data.
// CHECK: literal_0: hex"2233"
// CHECK: literal_1: hex"2233"
// CHECK: literal_2: hex"aa"
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push_data literal_0
// CHECK: {{^[ +].*}}push_data literal_1
// CHECK: {{^[ +].*}}push_data literal_2
// CHECK: {{^[ +].*}}mstore
// CHECK: {{^[ +].*}}mstore
bb0:
  push 3
  push_data literal_0
  push 0
  codecopy
  push 2
  push_data literal_1
  push 32
  codecopy
  push 1
  push_data literal_2
  push 64
  codecopy
  push 128
  push 0x112233445566778899aabbccddeeff00112233445566778899aabbccddeeff00
  dup 2
  mstore
  push 0x112233445566778899aabbccddeeff00112233445566778899aabbccddeeff00
  dup 2
  mstore
  stop
