//@ compile-flags: -Ogas -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module subslice_escape

// An out-of-range copy may observe bytes after this entry, so packing must
// preserve its address and surrounding data.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push_data literal_0
// CHECK: {{^[ +].*}}push_data literal_1
bb0:
  push 3
  push_data literal_0
  push 0
  codecopy
  push 7
  push_data literal_1
  push 32
  codecopy
  stop

// CHECK: @data literal_0 hex"2233"
// CHECK: @data literal_1 hex"00112233445566"
@data literal_0 hex"2233"
@data literal_1 hex"00112233445566"
