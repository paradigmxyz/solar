//@ compile-flags: -O none -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module no_subslices
@data
  small_0: hex"2233"
  container_1: hex"11223344"

// Required data cleanup at `-O none` removes no live bytes but must not alter
// a data reference's entry or offset.
// CHECK: small_0: hex"2233"
// CHECK: container_1: hex"11223344"
// CHECK: push_data small_0
bb0:
  push 2
  push_data small_0
  push 0
  codecopy
  push 4
  push_data container_1
  push 32
  codecopy
  stop
