//@ compile-flags: -O none -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module no_subslices
@data
  container_0: hex"11223344"
  small_1: hex"2233"

// Required data cleanup at `-O none` removes no live bytes but must not alter
// a data reference's entry or offset.
// CHECK: container_0: hex"11223344"
// CHECK: small_1: hex"2233"
// CHECK: push_data small_1
bb0:
  push 2
  push_data small_1
  push 0
  codecopy
  push 4
  push_data container_0
  push 32
  codecopy
  stop
