//@ compile-flags: -Osize -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module shared_core

// The runs write different first words, so no whole run is shared. They write the same three words
// after it, which both sites copy from one entry while each keeps its own first store.
// CHECK: literal_0: hex"333333333333333333333333333333333333333333333333333333333333333344444444444444444444444444444444444444444444444444444444444444445555555555555555555555555555555555555555555555555555555555555555"
// CHECK-NOT: literal_1
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push 96
// CHECK-NEXT: {{^[ +].*}}push_data literal_0
// CHECK: {{^[ +].*}}codecopy
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 96
// CHECK-NEXT: {{^[ +].*}}push_data literal_0
// CHECK: {{^[ +].*}}codecopy
bb0:
  push 128
  push 0x1111111111111111111111111111111111111111111111111111111111111111
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x3333333333333333333333333333333333333333333333333333333333333333
  swap 1
  mstore
  push 64
  dup 2
  add
  push 0x4444444444444444444444444444444444444444444444444444444444444444
  swap 1
  mstore
  push 96
  dup 2
  add
  push 0x5555555555555555555555555555555555555555555555555555555555555555
  swap 1
  mstore
  stop

bb1:
  push 256
  push 0x2222222222222222222222222222222222222222222222222222222222222222
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x3333333333333333333333333333333333333333333333333333333333333333
  swap 1
  mstore
  push 64
  dup 2
  add
  push 0x4444444444444444444444444444444444444444444444444444444444444444
  swap 1
  mstore
  push 96
  dup 2
  add
  push 0x5555555555555555555555555555555555555555555555555555555555555555
  swap 1
  mstore
  stop
