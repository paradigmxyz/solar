//@ compile-flags: -Ogas -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module StoreOrigins

// The copy carries the origins of every store it replaces, and the function
// event of the run lands on the copy itself.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push 96 !metadata(spans=[3..4, 5..6, 7..8])
// CHECK-NEXT: + push_data literal_0 !metadata(spans=[3..4, 5..6, 7..8])
// CHECK-NEXT: + dup 3 !metadata(spans=[3..4, 5..6, 7..8])
// CHECK-NEXT: + codecopy !metadata(spans=[3..4, 5..6, 7..8], invoke=f@1..40)
bb0:
  push 128 !metadata(span=1..2)
  push 0x60dcee479c2410b6b4b7a6d1a6377647925bd947f08644cd7a1fa1c09ebd6952 !metadata(span=3..4)
  dup 2 !metadata(span=3..4)
  mstore !metadata(span=3..4)
  push 32 !metadata(span=5..6)
  dup 2 !metadata(span=5..6)
  add !metadata(span=5..6)
  push 0x9d83d740d78074f607ffe98e9d58a31d9c03c24858bf59b4db23c277a692fd83 !metadata(span=5..6)
  swap 1 !metadata(span=5..6)
  mstore !metadata(span=5..6, invoke=f@1..40)
  push 64 !metadata(span=7..8)
  dup 2 !metadata(span=7..8)
  add !metadata(span=7..8)
  push 0x4bd36327efa725f9ca70386fc5ef73f77045a4d6a040acc52f3a48be7570446b !metadata(span=7..8)
  swap 1 !metadata(span=7..8)
  mstore !metadata(span=7..8)
  stop !metadata(span=9..10)
