//@ compile-flags: -Ogas -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module high_fanout

// Every site of a highly shared run copies from one data entry; the cost
// model prices the whole group, with no cap on its sites.
// CHECK: literal_0: hex"0000000000000000000000000000000011112222333344445555666677778888000000000000000000000000000000009999aaaabbbbccccddddeeeeffff0000"
// CHECK-NOT: literal_1
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: push_data literal_0
// CHECK-NOT: mstore
bb0:
  push 128
  push 0x11112222333344445555666677778888
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x9999aaaabbbbccccddddeeeeffff0000
  swap 1
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: push_data literal_0
// CHECK-NOT: mstore
bb1:
  push 256
  push 0x11112222333344445555666677778888
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x9999aaaabbbbccccddddeeeeffff0000
  swap 1
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb2:
// CHECK: push_data literal_0
// CHECK-NOT: mstore
bb2:
  push 384
  push 0x11112222333344445555666677778888
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x9999aaaabbbbccccddddeeeeffff0000
  swap 1
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: push_data literal_0
// CHECK-NOT: mstore
bb3:
  push 512
  push 0x11112222333344445555666677778888
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x9999aaaabbbbccccddddeeeeffff0000
  swap 1
  mstore
  stop

// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: push_data literal_0
// CHECK-NOT: mstore
bb4:
  push 640
  push 0x11112222333344445555666677778888
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x9999aaaabbbbccccddddeeeeffff0000
  swap 1
  mstore
  stop
