//@ revisions: gas size
//@[gas] compile-flags: -Ogas -Zevm-ir-pipeline=pack-data
//@[size] compile-flags: -Osize -Zevm-ir-pipeline=pack-data
// Literal-store runs need not follow the lowering's store shape: stores may
// come in any order, address absolute memory, store single bytes, compute
// their words from constants, and leave address words on the stack.
@module store_shapes

// Stores out of address order.
bb0:
  push 128
  push 0x9bc6e4fa5d522384082d1e5c1605de5475e40b01fd77c07b6669219edf7e82d5
  push 32
  dup 3
  add
  mstore
  push 0xb2c21dbb68957cc0d5ed859319dd922e4b68ac4485519463f6ae8ce6e134c17c
  dup 2
  mstore
  stop

// Stores to absolute addresses.
bb1:
  push 0xd5faee0062014a6c28aa4d626c62f78487c02d2a58cd35b4a6945fa481cf8460
  push 0
  mstore
  push 0x33f7772814ee8933a86eb3d9c498a57d8d04fc4417077a5eb148b2d12bbde766
  push 32
  mstore
  push 0x52e631e20c1632dca5439643fa36aa1712574eb71471d231e4e5bcc569bc93eb
  push 64
  mstore
  stop

// Single bytes and a word computed from constants.
bb2:
  push 128
  push 0x52e631e20c1632dca5439643fa36aa1712574eb71471d231e4e5bcc569bc93eb
  dup 2
  mstore
  push 0xc588fa7445630aa67aba0cc9b6222420c35de937083756c43be5b1da2b627173
  push 32
  dup 3
  add
  mstore
  push 0x77
  push 64
  dup 3
  add
  mstore8
  push 0x88
  push 65
  dup 3
  add
  mstore8
  push 0x5566778899aabbccddeeff00112233445566778899aabbccddeeff
  push 40
  shl
  push 66
  dup 3
  add
  mstore
  stop

// The run leaves an address word on the stack for later code.
bb3:
  push 128
  push 0x0d3c2b0955cf3291ab5c51ef9fff7c69bc97542606f31a583f0bf4d9e950d9e6
  dup 2
  mstore
  push 32
  dup 2
  add
  push 0x8cceea0fdff3f199f532007d7f753aaabbf75d5694ca41cb9f8369703e84347c
  dup 2
  mstore
  push 0xeaded93a948cd58a33eef8ba374fb4a6c69ed66290ba8b12c52fda74bfc68c2f
  push 32
  dup 3
  add
  mstore
  pop
  pop
  stop

// A gap between stores keeps them: a copy would overwrite the gap.
bb4:
  push 128
  push 0x470832e49ec041d3b4ca465ba336cde4ebe208059e314075437c8cec42ce6712
  dup 2
  mstore
  push 0xdd2dcc2d8f206914122e5376e83de8f129b1c2b99d2c878a9e10be39d90a1c5f
  push 64
  dup 3
  add
  mstore
  stop
