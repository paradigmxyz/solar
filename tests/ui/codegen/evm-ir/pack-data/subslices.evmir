//@ compile-flags: -Ogas -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module subslices

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}push_data 0+1
// CHECK: {{^[ +].*}}push_data 0+2
// CHECK: {{^[ +].*}}push_data 0+1
bb0:
  push_data 0
  pop
  push_data 1
  pop
  push_data 2+1
  pop
  stop

// CHECK: @data 0 hex"00112233445566"
// CHECK-NOT: @data 1
@data 0 hex"1122334455"
@data 1 hex"2233"
@data 2 hex"00112233445566"
