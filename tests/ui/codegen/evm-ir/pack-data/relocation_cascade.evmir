//@ compile-flags: -Osize -Zevm-ir-pipeline=pack-data
//@ filecheck:
@module relocation_cascade

// Moving this entry into the later container would widen three data references,
// which would then widen four jumps across the PUSH1 boundary.
// CHECK-COUNT-3: push_data small_0
// CHECK: @data small_0 hex"112233445566"
bb0:
  push 6
  push_data small_0
  push 0
  codecopy
  push 6
  push_data small_0
  push 8
  codecopy
  push 6
  push_data small_0
  push 16
  codecopy
  push 253
  push_data middle_1
  push 32
  codecopy
  push 7
  push_data container_2
  push 320
  codecopy
  jump bb4

bb1:
  jump bb4

bb2:
  jump bb4

bb3:
  jump bb4

bb5:
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  pop
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  pop
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  pop
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  pop
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  pop
  push 0xffffffffffffffffffffffffffffffffffffffffffffffff
  pop
  push 0
  pop
  stop

bb6:
  stop

bb7:
  stop

bb8:
  stop

bb9:
  stop

bb10:
  stop

bb4:
  stop

@data small_0 hex"112233445566"
@data middle_1 hex""
@data container_2 hex"00112233445566"
