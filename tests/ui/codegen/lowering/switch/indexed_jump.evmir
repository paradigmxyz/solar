//@ compile-flags: -Zevm-ir-pipeline=default -O none -Zdump=disasm-runtime
//@ filecheck:

@module indexed_jump

// CHECK-LABEL: // === indexed_jump (runtime) ===
// CHECK-NEXT: PUSH1 0x01
// CHECK-NEXT: PUSH1 0x03
// CHECK-NEXT: SHL
// CHECK-NEXT: PUSH2 {{.*}}
// CHECK-NEXT: SWAP1
// CHECK-NEXT: SHR
// CHECK-NEXT: PUSH1 0xff
// CHECK-NEXT: AND
// CHECK-NEXT: JUMP ; unknown
// CHECK-NEXT: ; bb0
// CHECK-NEXT: JUMPDEST
// CHECK-NEXT: STOP
// CHECK-NEXT: ; bb1
// CHECK-NEXT: JUMPDEST
// CHECK-NEXT: INVALID
bb0:
  push 1
  indexed_jump bb1, bb2
bb1:
  stop
bb2:
  invalid
