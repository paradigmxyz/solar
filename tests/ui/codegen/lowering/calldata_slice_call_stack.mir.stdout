; getter for `mapping(SliceToken => uint256) public fees` [selector 0xfaaebd21]
fn @fees(arg0: i160) -> i256 [selector=0xfaaebd21, view, abi_params=[address], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = mapping_slot v0, 0
    v2 = sload v1 !metadata(storage=symbolic(v1))
    ret v2
}

