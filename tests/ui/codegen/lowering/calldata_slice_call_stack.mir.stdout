; function getFee(SliceToken token, uint256 amount) public view returns (uint256) [selector 0x4edeb834]
fn @getFee(arg0: i160, arg1: i256) -> i256 [selector=0x4edeb834, view, abi_params=[address, uint256], abi_returns=[word], abi_return_params=[uint256]] {
