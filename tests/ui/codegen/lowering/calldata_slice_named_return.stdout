    v13 = gt v10, v12
    v14 = or v9, v13
    jumpi v14, bb1, bb3
  bb3:
    v0 = internal_call @unwrap, 1, v6, v10
    v1 = mload v0
    mstore 128, v1
    returndata 128, 32
  bb1:
