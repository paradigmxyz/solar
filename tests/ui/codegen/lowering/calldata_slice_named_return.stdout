    v13 = or v11, v12
    v14 = calldataload v9
    v16 = sub v6, v10
    v17 = gt v14, v16
    v18 = or v13, v17
    jumpi v18, bb1, bb3
  bb3:
    v0 = internal_call @unwrap, 2, v10, v14
    v22 = mload 32 !metadata(memory=scratch)
    v2 = add v22, 32
    v3 = mload v2
    mstore 128, v3
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
