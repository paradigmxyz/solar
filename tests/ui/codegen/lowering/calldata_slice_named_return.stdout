// === ROOT/tests/ui/codegen/lowering/calldata_slice_named_return.sol:CalldataSliceNamedReturn ===
@module CalldataSliceNamedReturn
@phase evm-shaped
fn @unwrap(arg0: calldataptr, arg1: u256) -> (calldataptr, u256) [pure] {
  bb0:
    v1 = sub arg1, 32
    v3 = add arg0, v1
    v4 = calldataload v3
    jumpi v4, bb1, bb2
  bb1:
    jump bb2
  bb2:
    v17 = phi [bb1: arg0], [bb0: arg0]
    v18 = phi [bb1: v1], [bb0: arg1]
    ret v17, v18
}

fn @use() [selector=0x01bd03f7, pure] {
  bb0:
