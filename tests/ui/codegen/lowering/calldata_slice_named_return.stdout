    v33 = phi [bb1: v2], [bb0: arg1]
    v15 = gt v33, 0xffffffffffffffff
    jumpi v15, bb3, bb4
  bb4:
    v16 = calldatasize
    v17 = sub v16, v33
    v18 = sgt v32, v17
    jumpi v18, bb3, bb5
  bb5:
    v20 = add v33, 63
    v23 = and v20, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v24 = mload 64 !metadata(memory=scratch, effect=memory_write)
    v35 = add v24, v23
