    v5 = add v4, 4
    v6 = add v5, 32
    v7 = gt v4, 0xffffffffffffffff
    v8 = gt v6, v2
    v9 = or v7, v8
    v10 = calldataload v5
    v12 = sub v2, v6
    v13 = gt v10, v12
    v14 = or v9, v13
    jumpi v14, bb1, bb3
  bb3:
    v0 = internal_call @unwrap, 2, v6, v10
    v20 = mload 32 !metadata(memory=scratch)
    v21 = add v20, 32
    v22 = mload v21
    mstore 128, v22
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb3, bb1
  bb1:
