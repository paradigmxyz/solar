// === ROOT/tests/ui/codegen/lowering/mapping.sol:Mapping ===
@module Mapping
fn @balances(arg0: u256) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    ret v1
}

fn @allowances(arg0: address, arg1: address) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = mapping_slot arg0, 1
    v1 = mapping_slot arg1, v0
    v2 = sload v1 !metadata(storage=symbolic(v1))
    ret v2
}

fn @set_balance(arg0: u256, arg1: u256) [abi_args=lazy] {
  bb0:
    v0 = mapping_slot arg0, 0
    sstore v0, arg1 !metadata(storage=symbolic(v0))
    stop
}

fn @add_balance(arg0: u256, arg1: u256) [abi_args=lazy] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = add v1, arg1
    v3 = lt v2, v1
    jumpi v3, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 17 !metadata(memory=scratch)
    revert 0, 36
  bb2:
    v4 = mapping_slot arg0, 0
    sstore v4, v2 !metadata(storage=symbolic(v4))
    stop
}

fn @approve(arg0: address, arg1: address, arg2: u256) [abi_args=lazy] {
  bb0:
    v0 = mapping_slot arg0, 1
    v1 = mapping_slot arg1, v0
    sstore v1, arg2 !metadata(storage=symbolic(v1))
    stop
}

fn @get_allowance(arg0: address, arg1: address) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = mapping_slot arg0, 1
    v1 = mapping_slot arg1, v0
    v2 = sload v1 !metadata(storage=symbolic(v1))
    ret v2
}

