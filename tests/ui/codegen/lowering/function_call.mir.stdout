// === ROOT/tests/ui/codegen/lowering/function_call.sol:FunctionCall ===
@module FunctionCall
; function double(uint256 x) internal pure returns (uint256)
fn @double(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = checked_add uint256, arg0, arg0
    ret v0
}

; function quadruple(uint256 x) public pure returns (uint256) [selector 0x7fdb7587]
fn @quadruple(arg0: i256) -> i256 [selector=0x7fdb7587, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @double, arg0
    v1 = icall @double, v0
    ret v1
}

; function sum_then_double(uint256 a, uint256 b) public pure returns (uint256) [selector 0xd386d5a2]
fn @sum_then_double(arg0: i256, arg1: i256) -> i256 [selector=0xd386d5a2, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = checked_add uint256, arg0, arg1
    v1 = icall @double, v0
    ret v1
}
