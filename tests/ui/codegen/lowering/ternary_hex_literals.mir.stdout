    jump bb3
  bb3:  ; preds = bb1, bb2
    v2 = phi [bb1: v0], [bb2: v1]
    v3 = abi_encode_packed (data hex"ff", bytes v2)
    ret v3
}

; function pairHash(bool c) external pure returns (bytes32) [selector 0x7e8b97e2]
fn @pairHash(arg0: i1) -> i256 [selector=0x7e8b97e2, pure, abi_params=[bool], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    jumpi arg0, bb1, bb2
  bb2:  ; preds = bb0
    v2 = alloc 64 !metadata(preserves_fmp)
