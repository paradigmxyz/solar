fn @literal_bytes_word(arg0: i256, arg1: i256) -> ptr<memory> {
  bb0:
    v0 = alloc 64 !metadata(preserves_fmp)
    mstore v0, arg1
    v1 = ptradd v0, 32
    mstore v1, arg0
    ret v0
}
