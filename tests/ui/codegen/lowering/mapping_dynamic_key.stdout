// === ROOT/tests/ui/codegen/lowering/mapping_dynamic_key.sol:MappingDynamicKey ===
@module MappingDynamicKey
; getter for `mapping(string => address) public lookup` [selector 0xf67187ac]
fn @lookup(arg0: slice<calldata>) -> i160 [selector=0xf67187ac, view, abi_params=[bytes], abi_returns=[word<uint160>], abi_return_params=[address]] {
  bb0:
    v0 = mapping_slot_bytes arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = trunc i256 v1 to i160
    ret v2
}

