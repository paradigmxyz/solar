fn @set(arg0: ptr<memory>, arg1: i160) [selector=0xa815ff15, abi_params=[bytes, address], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = mapping_slot_bytes arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = and v1, 0xffffffffffffffffffffffff0000000000000000000000000000000000000000
    v3 = zext i160 arg1 to i256
    v4 = and v3, 0xffffffffffffffffffffffffffffffffffffffff
    v5 = or v2, v4
    sstore v0, v5 !metadata(storage=symbolic(v0))
    ret
}

; function get(string memory name) public view returns (address) [selector 0x693ec85e]
