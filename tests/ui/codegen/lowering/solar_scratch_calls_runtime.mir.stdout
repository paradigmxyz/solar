    v2 = eq v1, false
    icall revert_if<empty>, v2
    icall @stash
    v3 = checked_add uint256, arg0, 2
    v4 = abi_encode [word], object, args v3
    v5 = ptradd v4, 32
    v6 = mload v4
    v7 = keccak256 v5, v6
    v8 = ne v7, 0
    v9 = eq v8, false
    icall revert_if<empty>, v9
    v10 = mload 0 !metadata(memory=scratch)
    v11 = add v10, 32
    v12 = mload v11
    ret v12
}

