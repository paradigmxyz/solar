    v8 = keccak256 v6, v7
    v9 = ne v8, 0
    v10 = eq v9, false
    icall revert_if<empty>, v10
    v11 = add v3, 32
    v12 = mload v11
    ret v12
}

fn @repeatedCalls(arg0: i256) -> i1 [selector=0x815c6630, pure, abi_params=[uint256], abi_returns=[word<bool>], abi_return_params=[bool]] {
  bb0:
    v0 = icall @temporary, arg0
    v1 = icall @temporary, arg0
    v2 = eq v0, v1
