}

fn @storeWord() [pure] {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    ret
}

fn @harmlessStore(arg0: i256) -> i256 [selector=0x2cc17cf8, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    icall @storeWord
    v0 = fmp
    v1 = abi_encode [word], object, args arg0
    v2 = ptradd v1, 32
    v3 = mload v1
    v4 = keccak256 v2, v3
    v5 = ne v4, 0
    v6 = eq v5, false
    icall revert_if<empty>, v6
