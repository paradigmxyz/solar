// === ROOT/tests/ui/codegen/lowering/solar_scratch_calls_runtime.sol:Test ===
@module Test
fn @temporary(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = fmp
    v1 = abi_encode [word], object, args arg0
    v2 = ptradd v1, 32
    v3 = mload v1
    v4 = keccak256 v2, v3
    set_fmp v0
    ret v4
}

fn @olderObject(arg0: i256) -> i256 [selector=0x72c0df62, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = abi_encode [word], object, args arg0
    v1 = icall @temporary, arg0
    v2 = ne v1, 0
    v3 = eq v2, false
    icall revert_if<empty>, v3
    v4 = checked_add uint256, arg0, 2
    v5 = abi_encode [word], object, args v4
    v6 = ptradd v5, 32
    v7 = mload v5
    v8 = keccak256 v6, v7
    v9 = ne v8, 0
    v10 = eq v9, false
    icall revert_if<empty>, v10
    v11 = abi_decode [uint256], v0
    ret v11
}

fn @readBeforeCall(arg0: i256) -> i256 [selector=0x84e117a0, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    mstore v0, arg0
    v1 = mload v0
    v2 = add v0, 32
    mstore 64, v2 !metadata(memory=scratch)
    v3 = icall @temporary, arg0
    v4 = ne v3, 0
    v5 = eq v4, false
    icall revert_if<empty>, v5
    ret v1
}

