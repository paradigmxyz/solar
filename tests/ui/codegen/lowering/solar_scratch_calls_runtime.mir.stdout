}

fn @refreshedInLoop(arg0: i256) -> i256 [selector=0x53c6d1b0, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v10]
    v2 = phi [bb0: 0], [bb3: v11]
    v3 = lt v2, 2
    jumpi v3, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v1
  bb4:
    v4 = checked_add uint256, v0, v2
    v5 = mload 64 !metadata(memory=scratch)
    mstore v5, v4
    v6 = mload v5
    v7 = icall @temporary, v4
    v8 = ne v7, 0
    v9 = eq v8, false
    icall revert_if<empty>, v9
    v10 = checked_add uint256, v1, v6
    jump bb6
  bb6:
    jump bb3
  bb3:
    v11 = checked_add uint256, v2, 1
    jump bb1
}
