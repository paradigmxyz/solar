}

; function wordAligned(bytes calldata data) external pure returns (uint256) [selector 0xc0b853b2]
fn @wordAligned(arg0: slice<calldata>) -> i256 [selector=0xc0b853b2, pure, abi_params=[bytes], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    icall @_dirty
    v0 = abi_encode_packed (bytes arg0, uint8 i8 7)
    v1 = icall @_tail, v0
