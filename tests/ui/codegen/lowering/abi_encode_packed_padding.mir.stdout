; === ROOT/tests/ui/codegen/lowering/abi_encode_packed_padding.sol:EncodePackedPadding ===
@module EncodePackedPadding
; function padding(address implementation) external pure returns (uint256) [selector 0x7b3bd6e0]
fn @padding(arg0: i160) -> i256 [selector=0x7b3bd6e0, pure, abi_params=[address], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    icall @_dirty
    v0 = alloc 64 !metadata(preserves_fmp)
    mstore v0, 20
    v1 = ptradd v0, 32
    mstore v1, 0x602c3d8160093d39f33d3d3d3d363d3d37363d73000000000000000000000000
    v2 = alloc 64 !metadata(preserves_fmp)
    mstore v2, 13
    v3 = ptradd v2, 32
    mstore v3, 0x5af43d3d93803e602a57fd5bf300000000000000000000000000000000000000
    v4 = abi_encode_packed (bytes v0, uint160 arg0, bytes v2)
    v5 = icall @_tail, v4
    ret v5
}

; function fromCalldata(bytes calldata data) external pure returns (uint256) [selector 0x00319bae]
fn @fromCalldata(arg0: slice<calldata>) -> i256 [selector=0x00319bae, pure, abi_params=[bytes], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    icall @_dirty
    v0 = abi_encode_packed (uint8 i8 1, bytes arg0)
    v1 = icall @_tail, v0
