// === ROOT/tests/ui/codegen/lowering/abi_decode_static_tuple.sol:AbiDecodeStaticTuple ===
@module AbiDecodeStaticTuple
fn @decode(arg0: memorybytes) -> (u256, bool, address) [abi_params=[bytes], abi_returns=[word, word, word]] {
  bb0:
    frame_store scratch, word, 0, 0 !metadata(memory=scratch)
    frame_store scratch, word, 32, 0 !metadata(memory=scratch)
    frame_store scratch, word, 64, 0 !metadata(memory=scratch)
    v0 = memory_object_len memorybytes, arg0
    v1 = memory_object_data memorybytes, arg0
    v2 = lt v0, 96
    jumpi v2, bb1, bb2
  bb1:
    tail_call @__revert_empty
  bb2:
    v3 = memory_object_load_element memorybytes, arg0, 0
    v4 = add v1, 32
    v5 = memory_object_load_element memorybytes, arg0, 1
    v6 = iszero v5
    v7 = iszero v6
    v8 = eq v5, v7
    v9 = iszero v8
    jumpi v9, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    v10 = add v1, 64
    v11 = memory_object_load_element memorybytes, arg0, 2
    v12 = and v11, 0xffffffffffffffffffffffffffffffffffffffff
    v13 = eq v11, v12
    v14 = iszero v13
    jumpi v14, bb5, bb6
  bb5:
    revert 0, 0
  bb6:
    v15 = alloc memoryfixedarray<3, 1>, exact, uninitialized, infallible, 96
    memory_object_store_element memoryfixedarray<3, 1>, v15, 1, v7
    memory_object_store_element memoryfixedarray<3, 1>, v15, 2, v12
    v16 = memory_object_data memoryfixedarray, v15
    mstore 32, v16 !metadata(memory=scratch)
    v17 = mload 32 !metadata(memory=scratch)
    v18 = add v17, 32
    v19 = mload v18
    v20 = add v17, 64
    v21 = mload v20
    ret v3, v19, v21
}

fn @__revert_empty() {
  bb0:
    revert 0, 0
}

