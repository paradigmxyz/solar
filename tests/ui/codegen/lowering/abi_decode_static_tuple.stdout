// === ROOT/tests/ui/codegen/lowering/abi_decode_static_tuple.sol:AbiDecodeStaticTuple ===
@module AbiDecodeStaticTuple
fn @decode(arg0: memorybytes) -> (u256, bool, address) [abi_args=lazy, abi_params=[bytes], abi_returns=[word, word, word]] {
  bb0:
    v0 = memory_object_len memorybytes, arg0
    v1 = memory_object_data memorybytes, arg0
    v2 = lt v0, 96
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = add v1, 0
    v4 = make_memory_slice v3, 32
    v5 = memory_slice_load_word memory, v4, 0
    v6 = iszero 1
    jumpi v6, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    v7 = add v1, 32
    v8 = make_memory_slice v7, 32
    v9 = memory_slice_load_word memory, v8, 0
    v10 = iszero v9
    v11 = iszero v10
    v12 = eq v9, v11
    v13 = iszero v12
    jumpi v13, bb5, bb6
  bb5:
    revert 0, 0
  bb6:
    v14 = add v1, 64
    v15 = make_memory_slice v14, 32
    v16 = memory_slice_load_word memory, v15, 0
    v17 = and v16, 0xffffffffffffffffffffffffffffffffffffffff
    v18 = eq v16, v17
    v19 = iszero v18
    jumpi v19, bb7, bb8
  bb7:
    revert 0, 0
  bb8:
    v20 = mload 32 !metadata(memory=scratch)
    v21 = add v20, 32
    mstore v21, v11
    v22 = add v20, 64
    mstore v22, v17
    v23 = mload 32 !metadata(memory=scratch)
    v24 = add v23, 32
    v25 = mload v24
    v26 = add v23, 64
    v27 = mload v26
    ret v5, v25, v27
}

