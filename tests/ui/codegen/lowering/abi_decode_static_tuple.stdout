// === ROOT/tests/ui/codegen/lowering/abi_decode_static_tuple.sol:AbiDecodeStaticTuple ===
@module AbiDecodeStaticTuple
fn @decode(arg0: memorybytes) -> (u256, bool, address) [abi_returns=[word, word, word]] {
  bb0:
    mstore 128, 0
    mstore 160, 0
    mstore 192, 0
    v0 = memory_object_len memorybytes, arg0
    v1 = memory_object_data memorybytes, arg0
    v2 = lt v0, 96
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = mload v1
    v4 = add v1, 32
    v5 = mload v4
    v6 = iszero v5
    v7 = iszero v6
    v8 = eq v5, v7
    v9 = iszero v8
    jumpi v9, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    v10 = add v1, 64
    v11 = mload v10
    v12 = and v11, 0xffffffffffffffffffffffffffffffffffffffff
    v13 = eq v11, v12
    v14 = iszero v13
    jumpi v14, bb5, bb6
  bb5:
    revert 0, 0
  bb6:
    v15 = fmp
    v16 = add v15, 32
    mstore v16, v7
    v17 = add v15, 64
    mstore v17, v12
    mstore 32, v15 !metadata(memory=scratch)
    v18 = mload 32 !metadata(memory=scratch)
    v19 = add v18, 32
    v20 = mload v19
    v21 = add v18, 64
    v22 = mload v21
    ret v3, v20, v22
}

