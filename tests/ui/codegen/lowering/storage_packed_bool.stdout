@module PackedBool
fn @a() -> bool [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = and v0, 255
    ret v1
}

fn @b() -> bool [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = shr 8, v0
    v2 = and v1, 255
    ret v2
}

fn @set(arg0: bool, arg1: bool) [abi_args=lazy] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = and v0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00
    v2 = and arg0, 255
    v3 = or v1, v2
    sstore 0, v3 !metadata(storage=slot(0))
    v4 = sload 0 !metadata(storage=slot(0))
    v5 = and v4, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff00ff
    v6 = and arg1, 255
    v7 = shl 8, v6
    v8 = or v5, v7
    sstore 0, v8 !metadata(storage=slot(0))
    stop
}

fn @both() -> bool [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = and v0, 255
    jumpi v1, bb1, bb2
  bb1:
    v2 = sload 0 !metadata(storage=slot(0))
    v3 = shr 8, v2
    v4 = and v3, 255
    jump bb2
  bb2:
    v5 = phi [bb0: 0], [bb1: v4]
    ret v5
}

