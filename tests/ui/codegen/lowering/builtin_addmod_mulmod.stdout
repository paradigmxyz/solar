@module AddmodMulmod
fn @am(arg0: u256, arg1: u256, arg2: u256) -> u256 [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 96
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    jumpi arg2, bb4, bb3
  bb3:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 18 !metadata(memory=scratch)
    revert 0, 36
  bb4:
    v3 = addmod arg0, arg1, arg2
    ret v3
}

