// === ROOT/tests/ui/codegen/lowering/type_conversion.sol:TypeConversion ===
@module TypeConversion
fn @narrowAddress(arg0: address) -> u16 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = and arg0, 0xffffffffffffffffffffffffffffffffffffffff
    v1 = and v0, 0xffff
    ret v1
}

fn @narrowUint(arg0: u256) -> u16 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = and arg0, 0xffff
    ret v0
}

fn @narrowSigned(arg0: i256) -> i8 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = shl 248, arg0
    v1 = sar 248, v0
    ret v1
}

