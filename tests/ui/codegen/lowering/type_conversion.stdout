// === ROOT/tests/ui/codegen/lowering/type_conversion.sol:TypeConversion ===
@module TypeConversion
fn @narrowAddress(arg0: address) -> u16 [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = calldataload 4
    v5 = and v4, 0xffffffffffffffffffffffffffffffffffffffff
    v6 = eq v4, v5
    jumpi v6, bb4, bb3
  bb3:
    revert 0, 0
  bb4:
    v7 = and arg0, 0xffffffffffffffffffffffffffffffffffffffff
    v8 = and v7, 0xffff
    ret v8
}

fn @narrowUint(arg0: u256) -> u16 [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = and arg0, 0xffff
    ret v4
}

fn @narrowSigned(arg0: i256) -> i8 [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = shl 248, arg0
    v5 = sar 248, v4
    ret v5
}

