// === ROOT/tests/ui/codegen/lowering/recursive_memory_return.sol:C ===
@module C
fn @build(arg0: u256) -> memorystruct [selector=0x77fc2b19, pure, abi_params=[u256], abi_returns=[tuple<word, word>]] {
  bb0:
    v0 = eq arg0, 0
    v1 = alloc memorystruct<2>, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
    memory_object_store_field memorystruct<2>, v1, 0, 0
    memory_object_store_field memorystruct<2>, v1, 1, 0
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v3 = checked_sub u256, arg0, 1
    v4 = icall @build, v3
    v5 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    v6 = memory_object_load_field memorystruct<2>, v4, 0
    v7 = checked_add u256, v6, arg0
    v8 = memory_object_load_field memorystruct<2>, v4, 1
    v9 = checked_add u256, v8, 1
    memory_object_store_field memorystruct<2>, v5, 0, v7
    memory_object_store_field memorystruct<2>, v5, 1, v9
    ret v5
  bb1:
    v2 = alloc memorystruct<2>, exact, uninitialized, infallible, 64
    memory_object_store_field memorystruct<2>, v2, 0, 0
    memory_object_store_field memorystruct<2>, v2, 1, 0
    ret v2
}

fn @mkArr(arg0: u256) -> memoryarray [selector=0xfb67dbf3, pure, abi_params=[u256], abi_returns=[memory_array<word>]] {
  bb0:
    v0 = mul arg0, 1
    v1 = iszero 1
    v2 = div v0, 1
    v3 = eq v2, arg0
    v4 = or v1, v3
    v5 = iszero v4
    panic_if v5, 0x41
    v6 = add v0, 1
    v7 = lt v6, v0
    panic_if v7, 0x41
    v8 = mul v6, 32
    v9 = iszero 32
    v10 = div v8, 32
    v11 = eq v10, v6
    v12 = or v9, v11
    v13 = iszero v12
    panic_if v13, 0x41
    v14 = alloc memoryarray<1>, exact, zeroed, panic, v8
    set_memory_object_len memoryarray, v14, arg0
    jump bb1
  bb1:
    v15 = phi [bb0: arg0], [bb3: v15]
    v16 = phi [bb0: v14], [bb3: v16]
    v17 = phi [bb0: memoryarray 96], [bb3: v17]
    v18 = phi [bb0: 0], [bb3: v24]
    v19 = lt v18, v15
    jumpi v19, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v16
  bb4:
    v20 = checked_mul u256, v18, 10
    v21 = memory_object_len memoryarray, v16
    v22 = lt v18, v21
    v23 = iszero v22
    panic_if v23, 0x32
    memory_object_store_element memoryarray<1>, v16, v18, v20
    jump bb6
  bb6:
    jump bb3
  bb3:
    v24 = checked_add u256, v18, 1
    jump bb1
}

fn @fillImpl(arg0: memoryarray, arg1: u256) -> memoryarray [pure] {
  bb0:
    v0 = memory_object_len memoryarray, arg0
    v1 = eq arg1, v0
    jumpi v1, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v2 = checked_mul u256, arg1, arg1
    v3 = memory_object_len memoryarray, arg0
    v4 = lt arg1, v3
    v5 = iszero v4
    panic_if v5, 0x32
    memory_object_store_element memoryarray<1>, arg0, arg1, v2
    v6 = checked_add u256, arg1, 1
    v7 = icall @fillImpl, arg0, v6
    ret v7
  bb1:
    ret arg0
}

fn @squares(arg0: u256) -> memoryarray [selector=0x1d1d15d4, pure, abi_params=[u256], abi_returns=[memory_array<word>]] {
  bb0:
    v0 = mul arg0, 1
    v1 = iszero 1
    v2 = div v0, 1
    v3 = eq v2, arg0
    v4 = or v1, v3
    v5 = iszero v4
    panic_if v5, 0x41
    v6 = add v0, 1
    v7 = lt v6, v0
    panic_if v7, 0x41
    v8 = mul v6, 32
    v9 = iszero 32
    v10 = div v8, 32
    v11 = eq v10, v6
    v12 = or v9, v11
    v13 = iszero v12
    panic_if v13, 0x41
    v14 = alloc memoryarray<1>, exact, zeroed, panic, v8
    set_memory_object_len memoryarray, v14, arg0
    v15 = icall @fillImpl, v14, 0
    ret v15
}
