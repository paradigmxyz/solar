@module C
fn @build(arg0: i256) -> memptr [selector=0x77fc2b19, pure, abi_params=[u256], abi_returns=[tuple<word, word>], abi_return_params=[tuple<u256, u256>]] {
  bb0:
    v0 = eq arg0, 0
    v1 = alloc 64 !metadata(preserves_fmp)
    store v1, 0
    store v1+32, 0
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v3 = checked_sub u256, arg0, 1
    v4 = icall @build, v3
    v5 = alloc 64
    v6 = load v4
    v7 = checked_add u256, v6, arg0
    v8 = load v4+32
    v9 = checked_add u256, v8, 1
    store v5, v7
    store v5+32, v9
    ret v5
  bb1:
    v2 = alloc 64
    store v2, 0
    store v2+32, 0
    ret v2
}

fn @mkArr(arg0: i256) -> memptr [selector=0xfb67dbf3, pure, abi_params=[u256], abi_returns=[memory_array<word>], abi_return_params=[array<_, u256>]] {
  bb0:
    v0 = mul arg0, 1
    v1 = eq 1, 0
    v2 = div v0, 1
    v3 = eq v2, arg0
    v4 = or v1, v3
    v5 = zext i1 v4 to i256
    v6 = eq v5, 0
    icall panic_if<0x41>, v6
    v7 = add v0, 1
    v8 = lt v7, v0
    icall panic_if<0x41>, v8
    v9 = mul v7, 32
    v10 = eq 32, 0
    v11 = div v9, 32
    v12 = eq v11, v7
    v13 = or v10, v12
    v14 = zext i1 v13 to i256
    v15 = eq v14, 0
    icall panic_if<0x41>, v15
    v16 = alloc zeroed checked v9
    store v16, arg0
    jump bb1
  bb1:
    v17 = phi [bb0: arg0], [bb3: v17]
    v18 = phi [bb0: v16], [bb3: v18]
    v19 = phi [bb0: memptr 96], [bb3: v19]
    v20 = phi [bb0: 0], [bb3: v28]
    v21 = lt v20, v17
    jumpi v21, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v18
  bb4:
    v22 = checked_mul u256, v20, 10
    v23 = load v18
    v24 = lt v20, v23
    v25 = eq v24, false
    icall panic_if<0x32>, v25
    v26 = shl 5, v20
    v27 = ptradd v18, v26
    store v27+32, v22
    jump bb6
  bb6:
    jump bb3
  bb3:
    v28 = checked_add u256, v20, 1
    jump bb1
}

fn @fillImpl(arg0: memptr, arg1: i256) -> memptr [pure] {
  bb0:
    v0 = load arg0
    v1 = eq arg1, v0
    jumpi v1, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v2 = checked_mul u256, arg1, arg1
    v3 = load arg0
    v4 = lt arg1, v3
    v5 = eq v4, false
    icall panic_if<0x32>, v5
    v6 = shl 5, arg1
    v7 = ptradd arg0, v6
    store v7+32, v2
    v8 = checked_add u256, arg1, 1
    v9 = icall @fillImpl, arg0, v8
    ret v9
  bb1:
    ret arg0
}

fn @squares(arg0: i256) -> memptr [selector=0x1d1d15d4, pure, abi_params=[u256], abi_returns=[memory_array<word>], abi_return_params=[array<_, u256>]] {
  bb0:
