    v9 = mul v7, 32
    v10 = eq 32, 0
    v11 = div v9, 32
    v12 = eq v11, v7
    v13 = or v10, v12
    v14 = zext i1 v13 to i256
    v15 = eq v14, 0
    icall panic_if<0x41>, v15
    v16 = alloc zeroed checked v9
