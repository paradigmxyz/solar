    v1 = ne v0, 0
    jumpi v1, bb5, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr v2, 224
    switch v3, default bb5, [0x82d38954 => bb2, 0xae4e757a => bb3, 0xf2a75fe4 => bb4]
