fn @three() [selector=0xae4e757a, abi_wrapper, pure] {
  bb0:
    v17 = calldatasize
    v18 = lt v17, 100
    jumpi v18, bb1, bb2
  bb2:
    v26 = mload 64 !metadata(memory=scratch, alloc_ptr)
    v27 = add v26, 128 !metadata(alloc_ptr)
