    mstore v21, arg0
    v23 = add v26, 64
    mstore v23, arg1
    v25 = add v26, 96
    mstore v25, arg2
    v16 = keccak256 v21, 96
    mstore 0, v16 !metadata(memory=scratch)
    returndata 0, 32
  bb4:
    mstore 32, 65 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
  bb1:
    revert 0, 0
}

