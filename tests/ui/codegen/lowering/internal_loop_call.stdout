// === ROOT/tests/ui/codegen/lowering/internal_loop_call.sol:C ===
@module C
; function sumTo(uint256 n) internal pure returns (uint256 s)
fn @sumTo(arg0: i256) -> i256 [pure] {
  bb0:
    jump bb1
  bb1:  ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v4]
    v2 = phi [bb0: 0], [bb3: v5]
    v3 = lt v2, v0
    jumpi v3, bb4, bb5
  bb5:  ; preds = bb1
    jump bb2
  bb2:  ; preds = bb5
    ret v1
  bb4:  ; preds = bb1
    v4 = checked_add uint256, v1, v2
    jump bb6
  bb6:  ; preds = bb4
    jump bb3
  bb3:  ; preds = bb6
    v5 = checked_add uint256, v2, 1
    jump bb1
}

; function run(uint256 n) public pure returns (uint256) [selector 0xa444f5e9]
fn @run(arg0: i256) -> i256 [selector=0xa444f5e9, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sumTo, arg0
    ret v0
}
