// Reverting with more return data than was copied returns the heap as well, so
// a `bytes` argument whose copy may be in that range keeps the copy.
contract MemoryBytesViewBubble {
    fallback() external {
        assembly {
            mstore(0, 0x1111)
            revert(0, 0x100)
        }
    }

    // The size copied predates the call.
    function bubbleStale(bytes memory b) external returns (uint256) {
        uint256 n = b.length;
        address t = address(this);
        assembly {
            let s := returndatasize()
            let ok := call(gas(), t, 0, 0, 0, 0, 0)
            if ok {
                mstore(0, n)
                return(0, 32)
            }
            returndatacopy(0, 0, s)
            revert(0, returndatasize())
        }
    }
}
