// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() [selector=0x3955f902, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = internal_call @__decode_calldata_slice_3, 2, 4
    v10 = mload 32 !metadata(memory=scratch)
    v5 = add v10, 32
    v6 = mload v5
    v0 = internal_call @_last, 1, v3, v6
    mstore 128, v0
    returndata 128, 32
}

fn @lastWord2() [selector=0x97f495a8, pure] {
  bb0:
    v11 = calldatasize
    v12 = lt v11, 36
    jumpi v12, bb1, bb3
  bb1:
    revert 0, 0
  bb2:
    v6 = sub v16, 1
    v7 = add v13, 1
    v9 = internal_call @_last, 1, v7, v6
    v10 = xor v0, v9
    mstore 128, v10
    returndata 128, 32
  bb3:
    v13 = internal_call @__decode_calldata_slice_3, 2, 4
    v20 = mload 32 !metadata(memory=scratch)
    v15 = add v20, 32
    v16 = mload v15
    v0 = internal_call @_last, 1, v13, v16
    jumpi v16, bb2, bb1
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 [pure] {
  bb0:
    v2 = sub arg1, 32
    v3 = add arg0, v2
    v4 = calldataload v3
    ret v4
}

fn @__decode_calldata_slice_3(arg0: u256) -> (u256, u256) {
  bb0:
    v0 = calldatasize
    v1 = calldataload arg0
    v2 = add v1, 4
    v3 = add v1, 36
    v4 = gt v1, 0xffffffffffffffff
    v5 = gt v3, v0
    v6 = or v4, v5
    v7 = calldataload v2
    v9 = sub v0, v3
    v10 = gt v7, v9
    v11 = or v6, v10
    jumpi v11, bb2, bb1
  bb1:
    ret v3, v7
  bb2:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb4, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb4, [0x3955f902 => bb2, 0x97f495a8 => bb3]
  bb2:
    tail_call @lastWord
  bb3:
    tail_call @lastWord2
  bb4:
    revert 0, 0
}

