  bb2:
    mstore 128, 0
    v3 = internal_call @_last, 1, arg0
    v4 = slice_ptr arg0
    v5 = slice_len arg0
    v6 = lt v5, 1
    br v6, bb3, bb4
  bb3:
    revert 0, 0
  bb4:
    v7 = sub v5, 1
    v8 = add v4, 1
    v9 = make_calldata_slice v8, v7
    v10 = internal_call @_last, 1, v9
    v11 = xor v3, v10
    mstore 128, v11
    returndata 128, 32
}

