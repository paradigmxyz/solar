// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() [selector=0x3955f902, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldataload 4
    v4 = add v3, 4
    v5 = add v3, 36
    v6 = gt v3, 0xffffffffffffffff
    v7 = gt v5, v1
    v8 = or v6, v7
    jumpi v8, bb1, bb3
  bb3:
    v9 = calldataload v4
    v11 = calldatasize
    v12 = sub v11, v5
    v13 = gt v9, v12
    jumpi v13, bb1, bb4
  bb4:
    v0 = internal_call @_last, 1, v5, v9
    mstore 128, v0
    returndata 128, 32
}

fn @lastWord2() [selector=0x97f495a8, pure] {
  bb0:
    v9 = calldatasize
    v10 = lt v9, 36
    jumpi v10, bb3, bb4
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 50 !metadata(memory=scratch)
    revert 0, 36
  bb2:
    v4 = sub v17, 1
    v5 = add v13, 1
    v7 = internal_call @_last, 1, v5, v4
    v8 = xor v0, v7
    mstore 128, v8
    returndata 128, 32
  bb3:
    revert 0, 0
  bb4:
    v11 = calldataload 4
    v12 = add v11, 4
    v13 = add v11, 36
    v14 = gt v11, 0xffffffffffffffff
    v15 = gt v13, v9
    v16 = or v14, v15
    jumpi v16, bb3, bb5
  bb5:
    v17 = calldataload v12
    v19 = calldatasize
    v20 = sub v19, v13
    v21 = gt v17, v20
    jumpi v21, bb3, bb6
  bb6:
    v0 = internal_call @_last, 1, v13, v17
    jumpi v17, bb2, bb1
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 [pure] {
  bb0:
    v2 = sub arg1, 32
    v3 = add arg0, v2
    v4 = calldataload v3
    ret v4
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb4, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb4, [0x3955f902 => bb2, 0x97f495a8 => bb3]
  bb2:
    tail_call @lastWord
  bb3:
    tail_call @lastWord2
  bb4:
    revert 0, 0
}

