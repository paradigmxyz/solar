// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
fn @lastWord(arg0: calldataslice) {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    br v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    mstore 128, 0
    v3 = internal_call @_last, 1, arg0
    mstore 128, v3
    returndata 128, 32
}

fn @_last(arg0: calldataslice) -> u256 {
  bb0:
    v0 = internal_frame_addr 128
    mstore v0, 0 !metadata(memory=internal_frame)
    v1 = slice_ptr arg0
    v2 = slice_len arg0
    v3 = sub v2, 32
    v4 = add v1, v3
    v5 = calldataload v4
    v6 = internal_frame_addr 128
    mstore v6, v5 !metadata(memory=internal_frame)
    v7 = internal_frame_addr 128
    v8 = mload v7 !metadata(memory=internal_frame)
    ret v8
}

fn @lastWord2(arg0: calldataslice) {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    br v2, bb1, bb2
  bb1:
