fn @decode_calldata_slice() -> i256 {
  bb0:
    v0 = calldatasize
    v1 = calldataload 4
    v2 = add v1, 4
    v3 = add v2, 32
    v4 = gt v1, 0xffffffffffffffff
    v5 = gt v3, v0
    v6 = or v4, v5
    v8 = calldataload v2
    v10 = sub v0, v3
    v11 = gt v8, v10
    v14 = or v6, v11
    jumpi v14, bb1, bb2
  bb2:
    ret v2
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = calldatasize
    v2 = lt v1, 36
    v3 = zext i1 v2 to i256
    v4 = or v0, v3
    v5 = ne v4, 0
    jumpi v5, bb1, bb2
  bb2:
    v6 = calldataload 0
    v7 = shr 224, v6
    switch v7, default bb1, [0x3955f902 => bb3, 0x97f495a8 => bb4]
  bb4:
    tail_call @lastWord2
  bb3:
