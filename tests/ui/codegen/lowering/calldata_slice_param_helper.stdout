// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = calldataload 4
    v5 = lt v4, 32
    v6 = add v4, 4
    v7 = lt v6, 4
    v8 = gt v6, v3
    v9 = or v5, v7
    v10 = or v9, v8
    jumpi v10, bb1, bb3
  bb3:
    v11 = add v4, 36
    v12 = lt v11, v6
    v13 = gt v11, v3
    v14 = or v12, v13
    jumpi v14, bb1, bb4
  bb4:
    v15 = calldataload v6
    v17 = add v11, v15
    v18 = lt v17, v11
    v19 = gt v17, v3
    v20 = or v18, v19
    jumpi v20, bb1, bb5
  bb5:
    v29 = add arg0, 36
    v30 = add arg0, 4
    v31 = calldataload v30
    v21 = internal_call @_last, 1, v29, v31
    v25 = mload 64 !metadata(memory=scratch, effect=memory_write)
    v32 = add v25, 32
    mstore 64, v32 !metadata(memory=scratch)
    mstore v25, v21
    returndata v25, 32
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 {
  bb0:
    v3 = sub arg1, 32
    v4 = add arg0, v3
    v5 = calldataload v4
    ret v5
}

fn @lastWord2() {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = calldataload 4
    v5 = lt v4, 32
    v6 = add v4, 4
    v7 = lt v6, 4
    v8 = gt v6, v3
    v9 = or v5, v7
    v10 = or v9, v8
    jumpi v10, bb1, bb3
  bb3:
    v11 = add v4, 36
    v12 = lt v11, v6
    v13 = gt v11, v3
    v14 = or v12, v13
    jumpi v14, bb1, bb4
  bb4:
    v15 = calldataload v6
    v17 = add v11, v15
    v18 = lt v17, v11
    v19 = gt v17, v3
    v20 = or v18, v19
    jumpi v20, bb1, bb5
  bb5:
    v39 = add arg0, 36
    v40 = add arg0, 4
    v41 = calldataload v40
    v21 = internal_call @_last, 1, v39, v41
    jumpi v41, bb6, bb1
  bb6:
    v25 = sub v41, 1
    v26 = add v39, 1
    v28 = internal_call @_last, 1, v26, v25
    v29 = xor v21, v28
    v33 = mload 64 !metadata(memory=scratch, effect=memory_write)
    v42 = add v33, 32
    mstore 64, v42 !metadata(memory=scratch)
    mstore v33, v29
    returndata v33, 32
}

fn @entry() {
  bb0:
    v0 = callvalue
    jumpi v0, bb5, bb1
  bb1:
    v1 = calldatasize
    jumpi v1, bb2, bb5
  bb2:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb5, [0x3955f902 => bb3, 0x97f495a8 => bb4]
  bb3:
    tail_call @lastWord
  bb4:
    tail_call @lastWord2
  bb5:
    revert 0, 0
}

