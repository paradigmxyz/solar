// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v5 = calldatasize
    v6 = gt 36, v5
    jumpi v6, bb1, bb3
  bb3:
    v8 = calldataload 4
    v9 = add v8, 4
    v10 = lt v9, 4
    v11 = calldatasize
    v12 = gt v9, v11
    v13 = lt v8, 32
    v14 = or v10, v12
    v15 = or v14, v13
    jumpi v15, bb1, bb4
  bb4:
    v16 = add v8, 36
    v17 = lt v16, v9
    v18 = calldatasize
    v19 = gt v16, v18
    v20 = or v17, v19
    jumpi v20, bb1, bb5
  bb5:
    v21 = calldataload v9
    v23 = add v21, 31
    v24 = lt v23, v21
    jumpi v24, bb1, bb6
  bb6:
    v26 = and v23, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v27 = add v16, v26
    v28 = lt v27, v16
    v29 = calldatasize
    v30 = gt v27, v29
    v31 = or v28, v30
    jumpi v31, bb1, bb7
  bb7:
    v0 = internal_call @_last, 1, v16, v21
    mstore 128, v0
    returndata 128, 32
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 {
  bb0:
    v6 = internal_frame_addr 128
    mstore v6, 0 !metadata(memory=internal_frame)
    v2 = sub arg1, 32
    v3 = add arg0, v2
    v4 = calldataload v3
    v7 = internal_frame_addr 128
    mstore v7, v4 !metadata(memory=internal_frame)
    v8 = internal_frame_addr 128
    v9 = mload v8 !metadata(memory=internal_frame)
    ret v9
}

fn @lastWord2() {
  bb0:
    v9 = calldatasize
    v10 = lt v9, 36
    jumpi v10, bb1, bb3
  bb1:
    revert 0, 0
  bb2:
    v4 = sub v29, 1
    v5 = add v24, 1
    v7 = internal_call @_last, 1, v5, v4
    v8 = xor v0, v7
    mstore 128, v8
    returndata 128, 32
  bb3:
    v13 = calldatasize
    v14 = gt 36, v13
    jumpi v14, bb1, bb4
  bb4:
    v16 = calldataload 4
    v17 = add v16, 4
    v18 = lt v17, 4
    v19 = calldatasize
    v20 = gt v17, v19
    v21 = lt v16, 32
    v22 = or v18, v20
    v23 = or v22, v21
    jumpi v23, bb1, bb5
  bb5:
    v24 = add v16, 36
    v25 = lt v24, v17
    v26 = calldatasize
    v27 = gt v24, v26
    v28 = or v25, v27
    jumpi v28, bb1, bb6
  bb6:
    v29 = calldataload v17
    v31 = add v29, 31
    v32 = lt v31, v29
    jumpi v32, bb1, bb7
  bb7:
    v34 = and v31, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v35 = add v24, v34
    v36 = lt v35, v24
    v37 = calldatasize
    v38 = gt v35, v37
    v39 = or v36, v38
    jumpi v39, bb1, bb8
  bb8:
    v0 = internal_call @_last, 1, v24, v29
    jumpi v29, bb2, bb1
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb5, bb1
  bb1:
    v1 = calldatasize
    jumpi v1, bb2, bb5
  bb2:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb5, [0x3955f902 => bb3, 0x97f495a8 => bb4]
  bb3:
    tail_call @lastWord
  bb4:
    tail_call @lastWord2
  bb5:
    revert 0, 0
}

