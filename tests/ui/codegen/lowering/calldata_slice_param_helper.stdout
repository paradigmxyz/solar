// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase lowered
fn @lastWord() [selector=0x3955f902, abi_wrapper, pure] {
  bb0:
    v10 = icall @decode_calldata_slice
    v12 = add v10, 32
    v11 = calldataload v10
    v2 = sub v11, 32
    v5 = add v12, v2
    v6 = calldataload v5
    mstore 128, v6
    returndata 128, 32
}

fn @lastWord2() [selector=0x97f495a8, abi_wrapper, pure] {
  bb0:
    v28 = icall @decode_calldata_slice
    v29 = calldataload v28
    v30 = add v28, 32
    v13 = sub v29, 32
    v16 = add v30, v13
    v17 = calldataload v16
    v4 = eq v29, 0
    jumpi v4, bb1, bb2
  bb2:
    v36 = add v28, 33
    v20 = sub v29, 33
    v23 = add v36, v20
    v24 = calldataload v23
    v11 = xor v17, v24
    mstore 128, v11
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @decode_calldata_slice() -> i256 {
  bb0:
    v0 = calldatasize
    v1 = calldataload 4
    v2 = add v1, 4
    v3 = add v2, 32
    v4 = gt v1, 0xffffffffffffffff
    v5 = gt v3, v0
    v6 = or v4, v5
    v8 = calldataload v2
    v10 = sub v0, v3
    v11 = gt v8, v10
    v14 = or v6, v11
    jumpi v14, bb1, bb2
  bb2:
    ret v2
  bb1:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = calldatasize
    v2 = lt v1, 36
    v3 = zext i1 v2 to i256
    v4 = or v0, v3
    v5 = ne v4, 0
    jumpi v5, bb1, bb2
  bb2:
    v6 = calldataload 0
    v7 = shr 224, v6
    switch v7, default bb1, [0x3955f902 => bb3, 0x97f495a8 => bb4]
  bb4:
    tail_call @lastWord2
  bb3:
    tail_call @lastWord
  bb1:
    revert 0, 0
}
