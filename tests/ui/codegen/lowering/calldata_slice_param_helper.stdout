// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldataload 4
    v4 = add v3, 4
    v5 = calldataload v4
    v6 = add v3, 36
    v0 = internal_call @_last, 1, v6, v5
    mstore 128, v0
    returndata 128, 32
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 {
  bb0:
    v3 = sub arg1, 32
    v4 = add arg0, v3
    v5 = calldataload v4
    ret v5
}

fn @lastWord2() {
  bb0:
    v9 = calldatasize
    v10 = lt v9, 36
    jumpi v10, bb1, bb3
  bb1:
    revert 0, 0
  bb2:
    v4 = sub v13, 1
    v5 = add v14, 1
    v7 = internal_call @_last, 1, v5, v4
    v8 = xor v0, v7
    mstore 128, v8
    returndata 128, 32
  bb3:
    v11 = calldataload 4
    v12 = add v11, 4
    v13 = calldataload v12
    v14 = add v11, 36
    v0 = internal_call @_last, 1, v14, v13
    jumpi v13, bb2, bb1
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb5, bb1
  bb1:
    v1 = calldatasize
    jumpi v1, bb2, bb5
  bb2:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb5, [0x3955f902 => bb3, 0x97f495a8 => bb4]
  bb3:
    tail_call @lastWord
  bb4:
    tail_call @lastWord2
  bb5:
    revert 0, 0
}

