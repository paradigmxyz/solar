// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() [selector=0x3955f902, pure] {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldataload 4
    v4 = add v3, 4
    v5 = calldatasize
    v6 = sub v5, 4
    v7 = gt v3, v6
    jumpi v7, bb1, bb3
  bb3:
    v8 = calldatasize
    v9 = sub v8, v4
    v10 = gt 32, v9
    jumpi v10, bb1, bb4
  bb4:
    v11 = calldataload v4
    v12 = add v3, 36
    v13 = calldatasize
    v14 = sub v13, v12
    v15 = gt v11, v14
    jumpi v15, bb1, bb5
  bb5:
    v0 = internal_call @_last, 1, v12, v11
    mstore 128, v0
    returndata 128, 32
}

fn @lastWord2() [selector=0x97f495a8, pure] {
  bb0:
    v11 = calldatasize
    v12 = lt v11, 36
    jumpi v12, bb1, bb3
  bb1:
    revert 0, 0
  bb2:
    v6 = sub v21, 1
    v7 = add v22, 1
    v9 = internal_call @_last, 1, v7, v6
    v10 = xor v0, v9
    mstore 128, v10
    returndata 128, 32
  bb3:
    v13 = calldataload 4
    v14 = add v13, 4
    v15 = calldatasize
    v16 = sub v15, 4
    v17 = gt v13, v16
    jumpi v17, bb1, bb4
  bb4:
    v18 = calldatasize
    v19 = sub v18, v14
    v20 = gt 32, v19
    jumpi v20, bb1, bb5
  bb5:
    v21 = calldataload v14
    v22 = add v13, 36
    v23 = calldatasize
    v24 = sub v23, v22
    v25 = gt v21, v24
    jumpi v25, bb1, bb6
  bb6:
    v0 = internal_call @_last, 1, v22, v21
    jumpi v21, bb2, bb1
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 [pure] {
  bb0:
    v2 = sub arg1, 32
    v3 = add arg0, v2
    v4 = calldataload v3
    ret v4
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb4, bb1
  bb1:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb4, [0x3955f902 => bb2, 0x97f495a8 => bb3]
  bb2:
    tail_call @lastWord
  bb3:
    tail_call @lastWord2
  bb4:
    revert 0, 0
}

