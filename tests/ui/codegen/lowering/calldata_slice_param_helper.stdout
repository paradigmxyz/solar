// === ROOT/tests/ui/codegen/lowering/calldata_slice_param_helper.sol:CalldataSliceParamHelper ===
@module CalldataSliceParamHelper
@phase evm-shaped
fn @lastWord() {
  bb0:
    v1 = calldatasize
    v2 = lt v1, 36
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v5 = calldatasize
    v6 = gt 36, v5
    jumpi v6, bb1, bb3
  bb3:
    v36 = add 4, 0
    v9 = calldataload v36
    v10 = add v9, 4
    v11 = lt v10, 4
    v12 = calldatasize
    v13 = gt v10, v12
    v14 = or v11, v13
    jumpi v14, bb1, bb4
  bb4:
    v15 = add v9, 36
    v16 = lt v15, v10
    v17 = calldatasize
    v18 = gt v15, v17
    v19 = or v16, v18
    jumpi v19, bb1, bb5
  bb5:
    v38 = add v10, 0
    v21 = calldataload v38
    v23 = add v21, 31
    v24 = lt v23, v21
    jumpi v24, bb1, bb6
  bb6:
    v26 = and v23, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v27 = add v15, v26
    v28 = lt v27, v15
    v29 = calldatasize
    v30 = gt v27, v29
    v31 = or v28, v30
    jumpi v31, bb1, bb7
  bb7:
    v0 = internal_call @_last, 1, v15, v21
    mstore 128, v0
    returndata 128, 32
}

fn @lastWord2() {
  bb0:
    v9 = calldatasize
    v10 = lt v9, 36
    jumpi v10, bb3, bb4
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 50 !metadata(memory=scratch)
    revert 0, 36
  bb2:
    v4 = sub v29, 1
    v5 = add v23, 1
    v7 = internal_call @_last, 1, v5, v4
    v8 = xor v0, v7
    mstore 128, v8
    returndata 128, 32
  bb3:
    revert 0, 0
  bb4:
    v13 = calldatasize
    v14 = gt 36, v13
    jumpi v14, bb3, bb5
  bb5:
    v44 = add 4, 0
    v17 = calldataload v44
    v18 = add v17, 4
    v19 = lt v18, 4
    v20 = calldatasize
    v21 = gt v18, v20
    v22 = or v19, v21
    jumpi v22, bb3, bb6
  bb6:
    v23 = add v17, 36
    v24 = lt v23, v18
    v25 = calldatasize
    v26 = gt v23, v25
    v27 = or v24, v26
    jumpi v27, bb3, bb7
  bb7:
    v46 = add v18, 0
    v29 = calldataload v46
    v31 = add v29, 31
    v32 = lt v31, v29
    jumpi v32, bb3, bb8
  bb8:
    v34 = and v31, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v35 = add v23, v34
    v36 = lt v35, v23
    v37 = calldatasize
    v38 = gt v35, v37
    v39 = or v36, v38
    jumpi v39, bb3, bb9
  bb9:
    v0 = internal_call @_last, 1, v23, v29
    jumpi v29, bb2, bb1
}

fn @_last(arg0: calldataptr, arg1: u256) -> u256 {
  bb0:
    v2 = sub arg1, 32
    v3 = add arg0, v2
    v4 = calldataload v3
    ret v4
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb5, bb1
  bb1:
    v1 = calldatasize
    jumpi v1, bb2, bb5
  bb2:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb5, [0x3955f902 => bb3, 0x97f495a8 => bb4]
  bb3:
    tail_call @lastWord
  bb4:
    tail_call @lastWord2
  bb5:
    revert 0, 0
}

