  bb2:
    v8 = add v28, 1
    v19 = sub v27, 33
    v21 = add v8, v19
    v22 = calldataload v21
    v11 = xor v16, v22
    mstore 128, v11
    returndata 128, 32
  bb1:
    revert 0, 0
