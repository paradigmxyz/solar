// === ROOT/tests/ui/codegen/lowering/loop_rotation.sol:LoopRotation ===
@module LoopRotation
fn @route(arg0: i256, arg1: i256) -> i256 [selector=0x44af87f6, pure, abi_params=[u256, u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v7]
    v1 = phi [bb0: arg0], [bb3: v6]
    v2 = phi [bb0: 0], [bb3: v2]
    v3 = phi [bb0: arg1], [bb3: v3]
    v4 = lt v0, v3
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v1
  bb4:
    v5 = checked_mul u256, v1, 997
    v6 = checked_div u256, v5, 0x3e8
    jump bb6
  bb6:
    jump bb3
  bb3:
    v7 = checked_add u256, v0, 1
    jump bb1
}
