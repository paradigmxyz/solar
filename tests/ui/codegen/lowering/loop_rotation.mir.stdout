; === ROOT/tests/ui/codegen/lowering/loop_rotation.sol:LoopRotation ===
@module LoopRotation
; function route(uint256 amount, uint256 hops) external pure returns (uint256) [selector 0x44af87f6]
fn @route(arg0: i256, arg1: i256) -> i256 [selector=0x44af87f6, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v6]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v2]
    v3 = phi [bb0: 0], [bb3: v7]
    v4 = lt v3, v1
    jumpi v4, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v0
  bb4:                                            ; preds = bb1
    v5 = checked_mul uint256, v0, 997
    v6 = checked_div uint256, v5, 0x3e8
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v7 = checked_add uint256, v3, 1
    jump bb1
}
