@module Ternary
; function max(uint256 a, uint256 b) public pure returns (uint256) [selector 0x6d5433e6]
fn @max(arg0: i256, arg1: i256) -> i256 [selector=0x6d5433e6, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = lt arg1, arg0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v1 = phi [bb1: arg0], [bb2: arg1]
    ret v1
}

; function clamp(uint256 x, uint256 lo, uint256 hi) public pure returns (uint256) [selector 0x9e422447]
fn @clamp(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0x9e422447, pure, abi_params=[uint256, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
