; function abs_diff(uint256 a, uint256 b) public pure returns (uint256) [selector 0xef0baf7e]
fn @abs_diff(arg0: i256, arg1: i256) -> i256 [selector=0xef0baf7e, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
