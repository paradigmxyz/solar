@module Ternary
fn @max(arg0: u256, arg1: u256) -> u256 [selector=0x6d5433e6, pure, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    v0 = gt arg0, arg1
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb1:
    jump bb3
  bb3:
    v1 = phi [bb1: arg0], [bb2: arg1]
    ret v1
}

