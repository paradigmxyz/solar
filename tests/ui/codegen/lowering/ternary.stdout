    jump bb6
  bb6:
    v2 = phi [bb4: arg2], [bb5: arg0]
    jump bb3
  bb1:
    jump bb3
  bb3:
    v3 = phi [bb1: arg1], [bb6: v2]
    ret v3
}

fn @abs_diff(arg0: u256, arg1: u256) -> u256 [selector=0xef0baf7e, pure, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    v0 = lt arg0, arg1
    v1 = iszero v0
    jumpi v1, bb1, bb2
  bb2:
    v3 = checked_sub u256, arg1, arg0
    jump bb3
  bb1:
