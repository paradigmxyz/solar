// === ROOT/tests/ui/codegen/lowering/checked_bit_search.sol:CheckedBitSearch ===
@module CheckedBitSearch
@phase lowered
fn @fls.0() [selector=0x27be8b2d, abi_wrapper, pure] {
  bb0:
    v0 = icall @fls.3, arg0
    mstore 128, v0
    returndata 128, 32
}

fn @clz.1() [selector=0x30244f7a, abi_wrapper, pure] {
  bb0:
    v0 = icall @clz.4, arg0
    mstore 128, v0
    returndata 128, 32
