fn @fls.3(arg0: word) -> word [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:
    v1 = shr 128, arg0
    v2 = ne v1, 0
    v44 = word_cast v2
    v45 = shl 7, v44
    v48 = shr v45, arg0
    v6 = shr 64, v48
    v7 = ne v6, 0
    v49 = word_cast v7
    v50 = shl 6, v49
    v51 = or v45, v50
    v54 = shr v50, v48
    v12 = shr 32, v54
    v13 = ne v12, 0
    v55 = word_cast v13
    v56 = shl 5, v55
    v57 = or v51, v56
    v60 = shr v56, v54
    v18 = shr 16, v60
    v19 = ne v18, 0
    v61 = word_cast v19
    v62 = shl 4, v61
    v63 = or v57, v62
    v66 = shr v62, v60
    v24 = shr 8, v66
    v25 = ne v24, 0
    v67 = word_cast v25
    v68 = shl 3, v67
    v69 = or v63, v68
    v72 = shr v68, v66
    v30 = shr 4, v72
    v31 = ne v30, 0
    v73 = word_cast v31
    v74 = shl 2, v73
    v75 = or v69, v74
    v78 = shr v74, v72
    v36 = shr 2, v78
    v37 = ne v36, 0
    v79 = word_cast v37
    v80 = add v79, v79
    v81 = or v75, v80
    v84 = shr v80, v78
    v42 = shr 1, v84
    v43 = or v81, v42
    ret v43
  bb1:
    ret 256
}

fn @clz.4(arg0: word) -> word [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb2, bb1
  bb1:
    v1 = icall @fls.3, arg0
    v4 = sub 255, v1
    v5 = lt 255, v1
    jumpi v5, bb3, bb2
  bb3:
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    mstore 32, 17 !metadata(memory=scratch)
    revert 28, 36
  bb2:
    v3 = phi [bb0: 256], [bb1: v4]
    ret v3
}

fn @ffs.5(arg0: word) -> word [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb2, bb1
  bb1:
    v1 = not arg0
    v6 = add v1, 1
    v3 = and arg0, v6
    v4 = icall @fls.3, v3
    jump bb2
  bb2:
    v5 = phi [bb0: 256], [bb1: v4]
    ret v5
}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = calldatasize
    v2 = lt v1, 36
    v3 = word_cast v2
    v4 = or v0, v3
    v5 = ne v4, 0
    jumpi v5, bb1, bb2
  bb2:
    v6 = calldataload 0
    v7 = shr 224, v6
    switch v7, default bb1, [0x2297890a => bb3, 0x27be8b2d => bb4, 0x30244f7a => bb5]
  bb5:
    tail_call @clz.1
  bb4:
    tail_call @fls.0
  bb3:
    tail_call @ffs.2
  bb1:
    revert 0, 0
}
