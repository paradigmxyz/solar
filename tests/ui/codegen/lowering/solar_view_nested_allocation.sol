// Nested decodes charge their parents' allocations even when the parent is a calldata view.
// The malformed inner lengths fit when each decode starts from the original free pointer,
// but overflow after reserving the parent's bytes. Allocation failure must precede the empty
// revert for a payload shorter than its declared length.
contract SolarViewNestedAllocation {
    // Retain the parent's reservation without copying its payload before decoding the child.
    // CHECK-LABEL: fn @viewed(
    // CHECK: calldataload
    // CHECK-NOT: calldatacopy
    // CHECK: mstore 64, {{v[0-9]+}}
    // CHECK-NOT: calldatacopy
    // CHECK: calldataload
    function viewed(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0x10000) }
        /// @custom:solar-view
        bytes memory payload = abi.decode(data, (bytes));
        /// @custom:solar-view
        string memory text = abi.decode(payload, (string));
        return bytes(text).length;
    }

    function copied(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0x10000) }
        bytes memory payload = abi.decode(data, (bytes));
        string memory text = abi.decode(payload, (string));
        return bytes(text).length;
    }

    // An ordinary decoding copy must also see the space its viewed input would have used.
    function ordinary(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0x10000) }
        /// @custom:solar-view
        bytes memory payload = abi.decode(data, (bytes));
        string memory text = abi.decode(payload, (string));
        return bytes(text).length;
    }

    // The valid input reserves 128 bytes for its parent and 64 for its child. Each fits
    // separately at this pointer, but their sum exceeds the allocation limit.
    function highPointer(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0xffffffffffffff40) }
        /// @custom:solar-view
        bytes memory payload = abi.decode(data, (bytes));
        /// @custom:solar-view
        string memory text = abi.decode(payload, (string));
        uint256 length = bytes(text).length;
        assembly { mstore(0x40, 0x10000) }
        return length;
    }

    // An explicit pointer reset starts a new allocation range. Do not carry the parent's
    // hypothetical reservation across it or reuse the parent's absolute allocation end.
    function resetBetween(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0x10000) }
        /// @custom:solar-view
        bytes memory payload = abi.decode(data, (bytes));
        assembly { mstore(0x40, 0xffffffffffffff40) }
        /// @custom:solar-view
        string memory text = abi.decode(payload, (string));
        uint256 length = bytes(text).length;
        assembly { mstore(0x40, 0x10000) }
        return length;
    }

    // The nested input is the first tuple field, but the second field's allocation still
    // precedes the nested decode. Its empty bytes object reserves a length word as well.
    function tupleFirst(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0x10000) }
        /// @custom:solar-view
        (bytes memory payload, bytes memory other) = abi.decode(data, (bytes, bytes));
        /// @custom:solar-view
        string memory text = abi.decode(payload, (string));
        return bytes(text).length + other.length;
    }

    function tupleCopied(bytes calldata data) external pure returns (uint256) {
        assembly { mstore(0x40, 0x10000) }
        (bytes memory payload, bytes memory other) = abi.decode(data, (bytes, bytes));
        string memory text = abi.decode(payload, (string));
        return bytes(text).length + other.length;
    }

    // Each iteration reserves another child. After the parent, one child still fits; a
    // second child crosses the limit. The exit reset must not erase an earlier panic.
    function repeated(bytes calldata data, uint256 count) external pure returns (uint256 result) {
        assembly { mstore(0x40, 0xffffffffffffff00) }
        /// @custom:solar-view
        bytes memory payload = abi.decode(data, (bytes));
        for (uint256 i; i < count; ++i) {
            /// @custom:solar-view
            string memory text = abi.decode(payload, (string));
            result += bytes(text).length;
        }
        assembly { mstore(0x40, 0x10000) }
    }
}
