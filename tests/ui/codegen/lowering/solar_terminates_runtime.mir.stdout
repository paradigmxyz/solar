    mstore v1, 32
    v2 = mload arg0
    v3 = ptradd arg0, 32
    v4 = ptrtoint ptr<memory> v3 to i256
    v5 = add v4, v2
    mstore v5, 0
    v6 = add v2, 31
    v7 = and v6, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
