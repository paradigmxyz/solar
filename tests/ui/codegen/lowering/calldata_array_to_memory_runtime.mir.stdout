    v40 = checked_mul u256, v39, 10
    v41 = checked_add u256, v36, v40
    v42 = memory_object_load_field memorystruct<3>, v0, 2
    v43 = inttoptr i256 v42 to memorybytes
    v44 = memory_object_len memorybytes, v43
    v45 = checked_mul u256, v44, 100
