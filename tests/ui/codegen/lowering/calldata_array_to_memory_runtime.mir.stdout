    v35 = alloc memorybytes, exact, uninitialized, infallible, v34
    set_memory_object_len memorybytes, v35, v30
    memory_object_copy_from_slice memorybytes, v35, arg2
    memory_object_store_field memorystruct<3>, v0, 0, arg0
    memory_object_store_field memorystruct<3>, v0, 1, v22
    memory_object_store_field memorystruct<3>, v0, 2, v35
    v36 = memory_object_load_field memorystruct<3>, v0, 0
    v37 = memory_object_load_field memorystruct<3>, v0, 1
