@module C
fn @setDirect(arg0: u256, arg1: u256) [abi_args=lazy] {
  bb0:
    v0 = mapping_slot arg0, 0
    sstore v0, arg1 !metadata(storage=symbolic(v0))
    stop
}

fn @getViaRef(arg0: u256) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    ret v1
}

fn @bump(arg0: u256) [abi_args=lazy] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = add v0, 1
    v2 = sload v1 !metadata(storage=offset(v0, 1))
    v3 = add v2, 1
    v4 = lt v3, v2
    jumpi v4, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 17 !metadata(memory=scratch)
    revert 0, 36
  bb2:
    v5 = add v0, 1
    sstore v5, v3 !metadata(storage=offset(v0, 1))
    stop
}

