// === ROOT/tests/ui/codegen/lowering/mapping_struct_getter.sol:C ===
@module C
types:
  struct0: {i160, i256, i160}

fn @items(arg0: i256) -> struct0 [selector=0xbfb231d2, view, abi_params=[u256], abi_returns=[word<u160>, word, word<u160>], abi_return_params=[address, u256, address]] {
  bb0:
    v0 = mapping_slot arg0, 1
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffff
    v3 = trunc i256 v2 to i160
    v4 = add v0, 1
    v5 = sload v4 !metadata(storage=offset(v0, 1))
    v6 = add v0, 2
    v7 = sload v6 !metadata(storage=offset(v0, 2))
    v8 = and v7, 0xffffffffffffffffffffffffffffffffffffffff
    v9 = trunc i256 v8 to i160
    v10 = insert_value struct0, undef struct0, 0, v3
    v11 = insert_value struct0, v10, 1, v5
    v12 = insert_value struct0, v11, 2, v9
    ret v12
}

fn @constructor() [constructor] {
  bb0:
    sstore 0, 1 !metadata(storage=slot(0))
    ret
}
