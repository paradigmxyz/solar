// A `@custom:solar-view` declaration reads the `bytes` and `string` an `abi.decode` of calldata
// finds where they are. Each function returns what its copying twin returns, and fails where the
// twin fails: an offset or a length past the input reverts, and a length the copy could not
// allocate panics with 0x41 before the length is checked against the input.
contract SolarViewDecode {
    // The view's decode allocates nothing: the free memory pointer is read for the replayed
    // allocation check and the hash's scratch copy, and never written. The result's third word
    // still lands at address 64, since static results are returned from address 0.
    // CHECK-LABEL: fn @viewed(
    // CHECK-NOT: mstore 64, {{.*}}memory=scratch
    // CHECK: returndata
    function viewed(bytes calldata data) external pure returns (bytes32, uint256, bytes1) {
        /// @custom:solar-view
        (uint256 id, bytes memory payload) = abi.decode(data, (uint256, bytes));
        return (keccak256(payload), id + payload.length, payload[0]);
    }

    function copied(bytes calldata data) external pure returns (bytes32, uint256, bytes1) {
        (uint256 id, bytes memory payload) = abi.decode(data, (uint256, bytes));
        return (keccak256(payload), id + payload.length, payload[0]);
    }

    // Two views replay their copies' allocations in order: the second copy's allocation starts
    // where the first one's ends.
    function pairViewed(bytes calldata data) external pure returns (bytes32, uint256, bytes memory) {
        /// @custom:solar-view
        (bytes memory a, string memory b) = abi.decode(data, (bytes, string));
        return (keccak256(a), bytes(b).length, abi.encodePacked(a, b));
    }

    function pairCopied(bytes calldata data) external pure returns (bytes32, uint256, bytes memory) {
        (bytes memory a, string memory b) = abi.decode(data, (bytes, string));
        return (keccak256(a), bytes(b).length, abi.encodePacked(a, b));
    }

    // A view decodes in place too, into views of the same calldata.
    function nestedViewed(bytes calldata data) external pure returns (string memory) {
        /// @custom:solar-view
        bytes memory payload = abi.decode(data, (bytes));
        /// @custom:solar-view
        string memory text = abi.decode(payload, (string));
        return string.concat(text, "!");
    }

    function nestedCopied(bytes calldata data) external pure returns (string memory) {
        bytes memory payload = abi.decode(data, (bytes));
        string memory text = abi.decode(payload, (string));
        return string.concat(text, "!");
    }

    function encodedViewed(bytes calldata data) external pure returns (bytes memory) {
        /// @custom:solar-view
        (uint256 id, bytes memory payload) = abi.decode(data, (uint256, bytes));
        return abi.encode(id, payload);
    }

    function encodedCopied(bytes calldata data) external pure returns (bytes memory) {
        (uint256 id, bytes memory payload) = abi.decode(data, (uint256, bytes));
        return abi.encode(id, payload);
    }

    // Every encoding of a view, also through a conversion between `bytes` and `string`, equals
    // the encoding of the copy.
    function conversions(bytes calldata data) external view returns (bool) {
        /// @custom:solar-view
        (bytes memory a, string memory b) = abi.decode(data, (bytes, string));
        (bytes memory ca, string memory cb) = abi.decode(data, (bytes, string));
        return keccak256(bytes.concat(a, bytes(b))) == keccak256(bytes.concat(ca, bytes(cb)))
            && keccak256(bytes(string.concat(b, string(a))))
                == keccak256(bytes(string.concat(cb, string(ca))))
            && keccak256(abi.encodeWithSelector(0x12345678, a, b))
                == keccak256(abi.encodeWithSelector(0x12345678, ca, cb))
            && keccak256(abi.encodeWithSignature("target(bytes,string)", a, b))
                == keccak256(abi.encodeWithSignature("target(bytes,string)", ca, cb))
            && keccak256(abi.encodeCall(this.target, (a, b)))
                == keccak256(abi.encodeCall(this.target, (ca, cb)))
            && keccak256(abi.encodePacked(b, a)) == keccak256(abi.encodePacked(cb, ca))
            && keccak256(bytes(b)) == keccak256(bytes(cb)) && bytes(b)[1] == bytes(cb)[1];
    }

    function target(bytes calldata, string calldata) external pure {}
}
