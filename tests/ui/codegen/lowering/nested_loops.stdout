@module NestedLoops
fn @sum_grid(arg0: u256, arg1: u256) -> u256 [abi_args=lazy, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v6]
    v1 = phi [bb0: arg0], [bb5: v8]
    v2 = phi [bb0: 0], [bb5: v9]
    v3 = phi [bb0: 0], [bb5: v16]
    v4 = phi [bb0: arg1], [bb5: v11]
    v5 = lt v3, v1
    jumpi v5, bb3, bb4
  bb2:
    ret v0
  bb3:
    jump bb6
  bb4:
    jump bb2
  bb5:
    jump bb1
  bb6:
    v6 = phi [bb3: v0], [bb10: v14]
    v7 = phi [bb3: 0], [bb10: v15]
    v8 = phi [bb3: v1], [bb10: v8]
    v9 = phi [bb3: v2], [bb10: v9]
    v10 = phi [bb3: v3], [bb10: v10]
    v11 = phi [bb3: v4], [bb10: v11]
    v12 = lt v7, v11
    jumpi v12, bb8, bb9
  bb7:
    v16 = add v10, 1
    jump bb5
  bb8:
    v13 = mul v10, v7
    v14 = add v6, v13
    v15 = add v7, 1
    jump bb10
  bb9:
    jump bb7
  bb10:
    jump bb6
}

fn @find_first(arg0: u256, arg1: u256) -> u256 [abi_args=lazy, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg1], [bb5: v5]
    v1 = phi [bb0: 0], [bb5: v14]
    v2 = phi [bb0: arg0], [bb5: v7]
    v3 = phi [bb0: 0], [bb5: v8]
    v4 = lt v1, v2
    jumpi v4, bb3, bb4
  bb2:
    ret v2
  bb3:
    jump bb6
  bb4:
    jump bb2
  bb5:
    jump bb1
  bb6:
    v5 = phi [bb3: v0], [bb10: v5]
    v6 = phi [bb3: v1], [bb10: v6]
    v7 = phi [bb3: v2], [bb10: v7]
    v8 = phi [bb3: v3], [bb10: v8]
    v9 = phi [bb3: 0], [bb10: v13]
    v10 = lt v9, v7
    jumpi v10, bb8, bb9
  bb7:
    v14 = add v6, 1
    jump bb5
  bb8:
    v11 = add v6, v9
    v12 = eq v11, v5
    jumpi v12, bb11, bb12
  bb9:
    jump bb7
  bb10:
    jump bb6
  bb11:
    ret v6
  bb12:
    jump bb13
  bb13:
    v13 = add v9, 1
    jump bb10
}

