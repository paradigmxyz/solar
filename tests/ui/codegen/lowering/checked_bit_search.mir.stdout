fn @fls.3(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v1 = shr 128, arg0
    v2 = ne v1, 0
    jumpi v2, bb4, bb5
  bb5:
    jump bb6
  bb4:
    v3 = shr 128, arg0
    jump bb6
  bb6:
    v4 = phi [bb4: v3], [bb5: arg0]
    v5 = phi [bb4: 128], [bb5: 0]
    v6 = shr 64, v4
    v7 = ne v6, 0
    jumpi v7, bb7, bb8
  bb8:
    jump bb9
  bb7:
    v8 = shr 64, v4
    v9 = or v5, 64
    jump bb9
  bb9:
    v10 = phi [bb7: v8], [bb8: v4]
    v11 = phi [bb7: v9], [bb8: v5]
    v12 = shr 32, v10
    v13 = ne v12, 0
    jumpi v13, bb10, bb11
  bb11:
    jump bb12
  bb10:
    v14 = shr 32, v10
    v15 = or v11, 32
    jump bb12
  bb12:
    v16 = phi [bb10: v14], [bb11: v10]
    v17 = phi [bb10: v15], [bb11: v11]
    v18 = shr 16, v16
    v19 = ne v18, 0
    jumpi v19, bb13, bb14
  bb14:
    jump bb15
  bb13:
    v20 = shr 16, v16
    v21 = or v17, 16
    jump bb15
  bb15:
    v22 = phi [bb13: v20], [bb14: v16]
    v23 = phi [bb13: v21], [bb14: v17]
    v24 = shr 8, v22
    v25 = ne v24, 0
    jumpi v25, bb16, bb17
  bb17:
    jump bb18
  bb16:
    v26 = shr 8, v22
    v27 = or v23, 8
    jump bb18
  bb18:
    v28 = phi [bb16: v26], [bb17: v22]
    v29 = phi [bb16: v27], [bb17: v23]
    v30 = shr 4, v28
    v31 = ne v30, 0
    jumpi v31, bb19, bb20
  bb20:
    jump bb21
  bb19:
    v32 = shr 4, v28
    v33 = or v29, 4
    jump bb21
  bb21:
    v34 = phi [bb19: v32], [bb20: v28]
    v35 = phi [bb19: v33], [bb20: v29]
    v36 = shr 2, v34
    v37 = ne v36, 0
    jumpi v37, bb22, bb23
  bb23:
    jump bb24
  bb22:
    v38 = shr 2, v34
    v39 = or v35, 2
    jump bb24
  bb24:
    v40 = phi [bb22: v38], [bb23: v34]
    v41 = phi [bb22: v39], [bb23: v35]
    v42 = shr 1, v40
    v43 = or v41, v42
    ret v43
  bb1:
    ret 256
}

fn @clz.4(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:
    v1 = icall @fls.3, arg0
    v2 = checked_sub u256, 255, v1
    jump bb3
  bb1:
    jump bb3
  bb3:
