    ret v3
}

fn @ffs.5(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:
    v1 = not arg0
    v2 = checked_add u256, v1, 1
    v3 = and arg0, v2
    v4 = icall @fls.3, v3
    jump bb3
  bb1:
    jump bb3
  bb3:
    v5 = phi [bb1: 256], [bb2: v4]
    ret v5
}
