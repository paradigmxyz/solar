// === ROOT/tests/ui/codegen/lowering/branch.sol:Branch ===
@module Branch
fn @max(arg0: u256, arg1: u256) -> u256 [selector=0x6d5433e6, pure, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    v0 = gt arg0, arg1
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb3:
    ret arg1
  bb1:
    ret arg0
}

fn @abs_diff(arg0: u256, arg1: u256) -> u256 [selector=0xef0baf7e, pure, abi_params=[u256, u256], abi_returns=[word]] {
  bb0:
    v0 = lt arg0, arg1
    v1 = iszero v0
    jumpi v1, bb1, bb2
  bb2:
    v3 = checked_sub u256, arg1, arg0
    ret v3
  bb1:
    v2 = checked_sub u256, arg0, arg1
    ret v2
  bb3:
    invalid
}
