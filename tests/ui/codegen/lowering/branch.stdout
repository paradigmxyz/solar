; === ROOT/tests/ui/codegen/lowering/branch.sol:Branch ===
@module Branch
; function max(uint256 a, uint256 b) public pure returns (uint256) [selector 0x6d5433e6]
fn @max(arg0: i256, arg1: i256) -> i256 [selector=0x6d5433e6, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = lt arg1, arg0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    ret arg1
  bb1:                                            ; preds = bb0
    ret arg0
}

; function abs_diff(uint256 a, uint256 b) public pure returns (uint256) [selector 0xef0baf7e]
fn @abs_diff(arg0: i256, arg1: i256) -> i256 [selector=0xef0baf7e, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = lt arg0, arg1
    v1 = eq v0, false
    jumpi v1, bb1, bb2
  bb2:                                            ; preds = bb0
    v3 = checked_sub uint256, arg1, arg0
    ret v3
  bb1:                                            ; preds = bb0
    v2 = checked_sub uint256, arg0, arg1
    ret v2
  bb3:
    invalid
}
