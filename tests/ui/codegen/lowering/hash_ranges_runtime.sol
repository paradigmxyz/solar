// `keccak256`, `sha256` and `ripemd160` of calldata, whole or a range of it,
// hash a copy staged past the free memory pointer without reserving it, and
// of a view in memory hash its bytes where they lie; the precompiles write
// their digest to scratch space. The results are the ones copies give.
import {Bytes} from "solar:core/Bytes.sol";

contract Test {
    function calldataHashes(bytes calldata b)
        external
        pure
        returns (bytes32, bytes32, bytes32, bytes32, bytes20)
    {
        return (keccak256(b), keccak256(b[2:]), sha256(b), sha256(b[1:]), ripemd160(b[:2]));
    }

    function viewHashes(bytes memory data) public pure returns (bytes32, bytes20, bytes32) {
        /// @custom:solar-view
        (bytes memory inner) = abi.decode(data, (bytes));
        /// @custom:solar-view
        bytes memory part = Bytes.slice(inner, 1, 2);
        return (sha256(inner), ripemd160(part), keccak256(part));
    }

    function calldataViewHashes(bytes calldata data) external pure returns (bytes32, bytes20) {
        /// @custom:solar-view
        (bytes memory inner) = abi.decode(data, (bytes));
        return (sha256(inner), ripemd160(inner));
    }
}
