// === ROOT/tests/ui/codegen/lowering/ternary_operand_reuse.sol:TernaryOperandReuse ===
@module TernaryOperandReuse
fn @addCaller(arg0: u256, arg1: u256) [abi_returns=[word, word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 64
    jumpi v2, bb1, bb2
  bb2:
    v3 = caller
    v4 = addmod arg0, arg1, v3
    mstore 0, v4 !metadata(memory=scratch)
    mstore 32, v3 !metadata(memory=scratch)
    returndata 0, 64
  bb1:
    revert 0, 0
}

fn @mulRepeated(arg0: u256) [abi_returns=[word, word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb2:
    v3 = caller
    v4 = mulmod v3, v3, arg0
    mstore 0, v4 !metadata(memory=scratch)
    mstore 32, v3 !metadata(memory=scratch)
    returndata 0, 64
  bb1:
    revert 0, 0
}
