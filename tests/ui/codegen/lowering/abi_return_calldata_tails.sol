// An external function returns a calldata aggregate as its input held it. The
// entry decode checks only the aggregate's own span, so encoding the return
// checks every inner offset, length and word it reads, as solc's encoder
// does: each call above reverts exactly where solc's reverts, and returns
// exactly what solc's returns otherwise.
contract CalldataReturns {
    struct S {
        uint256 a;
        bytes b;
    }

    function echo(uint256[][] calldata a) external pure returns (uint256[][] calldata) {
        return a;
    }

    function narrow(uint8[][] calldata a) external pure returns (uint8[][] calldata) {
        return a;
    }

    function inner(uint8[] calldata a) internal pure returns (uint8[] calldata) {
        return a;
    }

    // A call's result is no decoded parameter, so its words are checked too.
    function viaCall(uint8[] calldata a) external pure returns (uint8[] calldata) {
        return inner(a);
    }

    function deep(uint8[][][] calldata a) external pure returns (uint8[][][] calldata) {
        return a;
    }

    function structs(S[] calldata s) external pure returns (S[] calldata) {
        return s;
    }
}
