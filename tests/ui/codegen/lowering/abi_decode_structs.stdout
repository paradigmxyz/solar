    switch v3, default bb5, [0x6644232b => bb2, 0xaca542ca => bb3, 0xfc7ec666 => bb4]
  bb2:
    tail_call @dFlat
  bb3:
    tail_call @dDynArr
  bb4:
    tail_call @dNested
  bb5:
    revert 0, 0
}

