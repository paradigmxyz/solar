    jumpi v1, bb2, bb6
  bb2:
    v2 = calldataload 0
    v3 = shr 224, v2
    switch v3, default bb6, [0x6644232b => bb3, 0xaca542ca => bb4, 0xfc7ec666 => bb5]
  bb3:
    tail_call @dFlat
  bb4:
    tail_call @dDynArr
  bb5:
    tail_call @dNested
  bb6:
    revert 0, 0
}

