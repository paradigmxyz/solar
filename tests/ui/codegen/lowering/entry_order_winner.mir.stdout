    v2 = add v1, 32
    v3 = mload v2
    v4 = add v1, 64
    v5 = mload v4
    ret v0, v3, v5
}

fn @mix(arg0: memoryfixedarray, arg1: u256, arg2: u256, arg3: u256) -> (u256, u256, u256) [pure] {
  bb0:
