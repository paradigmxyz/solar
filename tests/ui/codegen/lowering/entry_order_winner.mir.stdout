    v16 = addmod v15, v14, 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff
    v17 = iszero v16
    v18 = iszero v11
    v19 = and v18, v17
    switch v19, default bb1, [0 => bb2, 1 => bb3]
  bb3:
    v37 = mulmod arg2, arg2, 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff
    v38 = mulmod v3, v3, 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff
    v39 = sub 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff, 3
