// === ROOT/tests/ui/codegen/lowering/entry_order_winner.sol:InternalModularEntryWinner ===
@module InternalModularEntryWinner
fn @combine(arg0: memoryfixedarray, arg1: u256, arg2: u256, arg3: u256) -> (u256, u256, u256) [selector=0x09f13e31, pure, abi_params=[array<3, u256>, u256, u256, u256], abi_returns=[word, word, word]] {
  bb0:
