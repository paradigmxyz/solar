  bb1:
    v59 = phi [bb0: 0], [bb2: v36], [bb3: v58]
    v60 = phi [bb0: 0], [bb2: v34], [bb3: v56]
    v61 = phi [bb0: 0], [bb2: v28], [bb3: v49]
