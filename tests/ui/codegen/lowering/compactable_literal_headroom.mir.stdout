fn @subtractComplement(arg0: u256, arg1: u256, arg2: u256, arg3: u256) -> u256 [pure] {
  bb0:
    v0 = eq arg3, 0
    v1 = iszero v0
    jumpi v1, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v6 = not arg0
