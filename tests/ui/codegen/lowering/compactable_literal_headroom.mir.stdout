  bb1:
    v2 = sub arg3, 1
    v3 = lt arg3, 1
    jumpi v3, bb4, bb5
  bb5:
    v4 = icall @subtractComplement, 1, arg0, arg1, arg2, v2
    v5 = xor v4, arg3
