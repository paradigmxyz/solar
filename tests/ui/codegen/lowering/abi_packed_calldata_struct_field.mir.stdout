@module AbiPackedCalldataStructField
; function pack(ForwardRequestData calldata request) external pure returns (bytes memory) [selector 0xc917a597]
fn @pack(arg0: slice<calldata>) -> ptr<memory> [selector=0xc917a597, pure, abi_params=[tuple<address, address, uint256, uint256, uint48, bytes, bytes>], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = ptrtoint ptr<calldata> v0 to i256
    v2 = add v1, 160
    v3 = calldatasize
    v4 = sub v3, v2
    v5 = slt v4, 32
    icall revert_if<calldata_tail_too_short>, v5
    v6 = calldataload v2
    v7 = ptrtoint ptr<calldata> v0 to i256
    v8 = add v7, v6
    v9 = calldatasize
    v10 = ptrtoint ptr<calldata> v0 to i256
    v11 = sub v9, v10
    v12 = sub v11, 31
    v13 = slt v6, v12
    v14 = eq v13, false
    icall revert_if<invalid_calldata_tail_offset>, v14
    v15 = calldataload v8
    v16 = calldatasize
    v17 = gt v15, 0xffffffffffffffff
    icall revert_if<invalid_calldata_tail_length>, v17
    v18 = add v8, 32
    v19 = sub v16, v15
    v20 = slt v19, v18
    icall revert_if<calldata_tail_too_short>, v20
    v21 = inttoptr i256 v18 to ptr<calldata>
    v22 = make_calldata_slice v21, v15
    v23 = extract_value slice<calldata>, arg0, 0
    v24 = ptrtoint ptr<calldata> v23 to i256
    v25 = add v24, 0
    v26 = calldataload v25
    v27 = gt v26, 0xffffffffffffffffffffffffffffffffffffffff
    icall revert_if<empty>, v27
    v28 = trunc i256 v26 to i160
    v29 = abi_encode_packed (calldata_bytes v22, uint160 v28)
    ret v29
}

