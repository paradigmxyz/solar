; function returnRevert() public pure [selector 0xdcdb78bc]
fn @returnRevert() [selector=0xdcdb78bc, pure, abi_params=[], abi_returns=[], abi_return_params=[]] {
  bb0:
    icall revert_if<empty>, true
    invalid
}

; function unitTernary(bool writeValue, uint256 newValue) public [selector 0xeb6f9827]
fn @unitTernary(arg0: i1, arg1: i256) [selector=0xeb6f9827, abi_params=[bool, uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    jumpi arg0, bb1, bb2
  bb2:                                            ; preds = bb0
    icall @clear
    jump bb3
  bb1:                                            ; preds = bb0
    icall @writeIfNonZero, arg1
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    ret
}

; function clear() internal
fn @clear() {
  bb0:
    sstore 0, 0 !metadata(storage=slot(0))
    ret
}
