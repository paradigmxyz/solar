; === ROOT/tests/ui/codegen/lowering/internal_void_call.sol:InternalVoidCall ===
@module InternalVoidCall
; getter for `uint256 public value` [selector 0x3fa4f245]
fn @value() -> i256 [selector=0x3fa4f245, view, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    ret v0
}

; function set(uint256 newValue) public [selector 0x60fe47b1]
fn @set(arg0: i256) [selector=0x60fe47b1, abi_params=[uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    icall @writeIfNonZero, arg0
    ret
}

; function writeIfNonZero(uint256 newValue) internal
fn @writeIfNonZero(arg0: i256) {
  bb0:
    v0 = ne arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    sstore 0, arg0 !metadata(storage=slot(0))
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    ret
}

; function setUnlessZero(uint256 newValue) public [selector 0x305f34c8]
fn @setUnlessZero(arg0: i256) [selector=0x305f34c8, abi_params=[uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    sstore 0, arg0 !metadata(storage=slot(0))
    ret
  bb1:                                            ; preds = bb0
    ret
}

; function returnVoidCall(uint256 newValue) public [selector 0x6659499b]
fn @returnVoidCall(arg0: i256) [selector=0x6659499b, abi_params=[uint256], abi_returns=[], abi_return_params=[]] {
