contract AbiCalldataFixedScalarReencode {
    function f(uint256[3] calldata values) external pure returns (bytes memory) {
        return abi.encode(values);
    }

    function g(uint256[3][2] calldata values, uint256 which) external view returns (bytes memory) {
        return this.f(values[which]);
    }

    function h(uint8[3] calldata values) external pure returns (bytes memory) {
        return abi.encode(values);
    }

    function i(uint8[3][2] calldata values, uint256 which) external view returns (bytes memory) {
        return this.h(values[which]);
    }
}
