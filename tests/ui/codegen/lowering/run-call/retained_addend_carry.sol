// Return the retained operand and independent prefix as well as the arithmetic result.
contract RetainedAddendCarry {
    function wrapped(uint256 a, uint256 b, uint256 tag)
        external pure returns (uint256, uint256, uint256, bool)
    {
        unchecked {
            uint256 sum = a + b;
            return (tag, b, sum, sum < a);
        }
    }

    function checked(uint256 a, uint256 b, uint256 tag)
        external pure returns (uint256, uint256, uint256)
    {
        uint256 sum = a + b;
        return (tag, b, sum);
    }
}
