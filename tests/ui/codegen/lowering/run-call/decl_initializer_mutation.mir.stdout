  bb3:
    v7 = checked_add u256, v2, 1
    v8 = checked_add u256, v2, 1
    v9 = memory_slice v1
    v10 = slice_len v9
    v11 = lt v2, v10
    v12 = eq v11, false
    icall panic_if<0x32>, v12
    v13 = shl 5, v2
    slice_store_word v9, v13, v7
