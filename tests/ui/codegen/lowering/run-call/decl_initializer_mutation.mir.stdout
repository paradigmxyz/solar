    v2 = phi [bb3: v0], [bb6: v6]
    v3 = phi [bb3: arg1], [bb6: v3]
    v4 = phi [bb3: 0], [bb6: v7]
    v5 = lt v4, v3
    jumpi v5, bb7, bb8
  bb8:
