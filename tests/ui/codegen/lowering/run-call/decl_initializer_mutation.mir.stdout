  bb2:
    v14 = checked_mul u256, v2, 100
    v15 = memory_slice v1
    v16 = slice_len v15
    v17 = lt 0, v16
    v18 = eq v17, false
    icall panic_if<0x32>, v18
    v19 = slice_load_word v15, 0
    v20 = checked_add u256, v14, v19
    v21 = memory_slice v1
    v22 = slice_len v21
    v23 = lt 1, v22
    v24 = eq v23, false
    icall panic_if<0x32>, v24
