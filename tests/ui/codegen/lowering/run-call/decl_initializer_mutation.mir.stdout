@module DeclInitializerMutation
fn @countLoop() -> i256 [selector=0xcf886ab8, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v4]
    v1 = phi [bb0: 0], [bb5: v3]
    v2 = lt v1, 5
    jumpi v2, bb3, bb4
  bb4:
    jump bb2
  bb2:
    ret v0
  bb3:
    v3 = checked_add u256, v1, 1
    v4 = checked_add u256, v0, v1
    jump bb5
  bb5:
    jump bb1
}

fn @sumIndexed() -> i256 [selector=0x4130978a, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
