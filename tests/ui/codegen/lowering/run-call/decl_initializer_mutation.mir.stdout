    v1 = make_memory_slice v0, 3
    slice_store_word v1, 0, 7
    slice_store_word v1, 32, 11
    slice_store_word v1, 64, 13
    jump bb1
  bb1:
    v2 = phi [bb0: v0], [bb5: v2]
    v3 = phi [bb0: 0], [bb5: v6]
    v4 = phi [bb0: 0], [bb5: v12]
    v5 = lt v3, 3
    jumpi v5, bb3, bb4
  bb4:
    jump bb2
  bb2:
    ret v4
  bb3:
    v6 = checked_add u256, v3, 1
    v7 = make_memory_slice v2, 3
    v8 = lt v3, 3
    v9 = eq v8, false
    icall panic_if<0x32>, v9
    v10 = shl 5, v3
    v11 = slice_load_word v7, v10
    v12 = checked_add u256, v4, v11
    jump bb5
  bb5:
    jump bb1
}

fn @multiDecl() -> i256 [selector=0x71fe0bed, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
