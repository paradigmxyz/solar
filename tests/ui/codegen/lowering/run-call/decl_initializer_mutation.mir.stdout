fn @lhsIndexMutation() -> i256 [selector=0x8d320a6e, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc memoryarray<1>, exact, zeroed, panic, 160
    mstore v0, 4
    jump bb1
  bb1:
    v1 = phi [bb0: v0], [bb5: v1]
    v2 = phi [bb0: 0], [bb5: v8]
    v3 = phi [bb0: 0], [bb5: v3]
    v4 = memory_slice v1
    v5 = slice_len v4
    v6 = lt v2, v5
