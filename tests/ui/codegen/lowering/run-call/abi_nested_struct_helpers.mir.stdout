// === ROOT/tests/ui/codegen/lowering/run-call/abi_nested_struct_helpers.sol:NestedStructHelpers ===
@module NestedStructHelpers
@types
  struct0: {i256, i256, i256}

fn @pair(arg0: ptr<memory>) -> struct0 [selector=0x7a5de1e9, pure, abi_params=[tuple<tuple<uint256, bytes>, tuple<uint256, bytes>>], abi_returns=[word, word, word], abi_return_params=[uint256, uint256, uint256]] {
  bb0:
    v0 = mload arg0, ptr<memory>
    v1 = mload v0
    v2 = ptradd arg0, 32
    v3 = mload v2, ptr<memory>
    v4 = mload v3
    v5 = ptradd arg0, 32
    v6 = mload v5, ptr<memory>
    v7 = ptradd v6, 32
    v8 = mload v7, ptr<memory>
    v9 = mload v8
    v10 = insert_value struct0, undef struct0, 0, v1
    v11 = insert_value struct0, v10, 1, v4
    v12 = insert_value struct0, v11, 2, v9
    ret v12
}

fn @pairs(arg0: ptr<memory>) -> i256 [selector=0x054d20d9, pure, abi_params=[array<_, tuple<tuple<uint256, bytes>, tuple<uint256, bytes>>>], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v27]
    v2 = phi [bb0: 0], [bb3: v28]
    v3 = mload v0
    v4 = lt v2, v3
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v1
  bb4:
    v5 = mload v0
    v6 = lt v2, v5
    v7 = eq v6, false
    icall panic_if<0x32>, v7
    v8 = shl 5, v2
    v9 = ptradd v0, v8
    v10 = ptradd v9, 32
    v11 = mload v10, ptr<memory>
    v12 = mload v11, ptr<memory>
    v13 = mload v12
    v14 = mload v0
    v15 = lt v2, v14
    v16 = eq v15, false
    icall panic_if<0x32>, v16
    v17 = shl 5, v2
    v18 = ptradd v0, v17
    v19 = ptradd v18, 32
    v20 = mload v19, ptr<memory>
    v21 = ptradd v20, 32
    v22 = mload v21, ptr<memory>
    v23 = ptradd v22, 32
    v24 = mload v23, ptr<memory>
    v25 = mload v24
    v26 = checked_add uint256, v13, v25
    v27 = checked_add uint256, v1, v26
    jump bb6
  bb6:
    jump bb3
  bb3:
    v28 = checked_add uint256, v2, 1
    jump bb1
}
