    v37 = xor v36, v14
    v38 = xor v37, v15
    v39 = xor v38, v16
    v40 = xor v23, v39
    ret v40
}

fn @_size(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 63
    v1 = eq v0, false
    icall revert_if<empty>, v1
    v2 = checked_add uint256, arg0, 1
    ret v2
}

fn @_write(arg0: i256, arg1: i256) [pure] {
  bb0:
    calldatacopy arg0, 0, arg1
    ret
}

fn @_copy(arg0: i256) -> ptr<memory> [pure] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    mstore v0, arg0
    v1 = add v0, 32
    codecopy v1, 0, arg0
    v2 = add v0, 32
    v3 = add v2, arg0
    mstore 64, v3 !metadata(memory=scratch)
    v4 = inttoptr i256 v0 to ptr<memory>
    ret v4
}
