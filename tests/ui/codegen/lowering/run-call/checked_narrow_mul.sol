// Products of operands of at most 128 bits fit in a word, so only their range overflows;
// wider signed products also need the quotient test, and only 256-bit ones the `min * -1` case.
contract CheckedNarrowMul {
    function u8(uint8 a, uint8 b) external pure returns (uint8) {
        return a * b;
    }

    function i8(int8 a, int8 b) external pure returns (int8) {
        return a * b;
    }

    function u128(uint128 a, uint128 b) external pure returns (uint128) {
        return a * b;
    }

    function i128(int128 a, int128 b) external pure returns (int128) {
        return a * b;
    }

    function i192(int192 a, int192 b) external pure returns (int192) {
        return a * b;
    }

    function i256(int256 a, int256 b) external pure returns (int256) {
        return a * b;
    }

    function p8(uint8 a, uint8 b) external pure returns (uint8) {
        return a ** b;
    }

    function pi8(int8 a, uint8 b) external pure returns (int8) {
        return a ** b;
    }
}
