// === ROOT/tests/ui/codegen/lowering/run-call/terminal_tail_closure_observers.sol:TailClosureCycle ===
@module TailClosureCycle
fn @run(arg0: u256, arg1: u256) [selector=0x7357f5d2, pure, abi_params=[u256, u256], abi_returns=[]] {
  bb0:
    icall @route, 0, arg0, arg1
