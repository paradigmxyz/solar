  bb0:
    icall @route, 0, arg0, arg1
    stop
}

fn @route(arg0: u256, arg1: u256) [pure] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v5]
    v1 = phi [bb0: arg1], [bb3: v4]
    v2 = eq v0, 0
    v3 = iszero v2
    jumpi v3, bb4, bb5
  bb5:
    jump bb2
  bb2:
    icall @leaf, 0, v1
    revert 0, 0
  bb4:
    v4 = xor v1, v0
    jump bb6
  bb6:
    jump bb3
  bb3:
    v5 = sub v0, 1
    jump bb1
}

fn @leaf(arg0: u256) [pure] {
  bb0:
    mstore 0, arg0 !metadata(memory=scratch)
    revert 0, 32
}

