// === ROOT/tests/ui/codegen/lowering/run-call/terminal_tail_closure_observers.sol:DescendantLoad ===
@module DescendantLoad
fn @run(arg0: u256) [selector=0xa444f5e9, pure, abi_params=[u256], abi_returns=[]] {
  bb0:
    icall @route, 0, arg0
    stop
}

fn @other(arg0: u256) [selector=0x369984d6, pure, abi_params=[u256], abi_returns=[]] {
  bb0:
    icall @route, 0, arg0
    stop
}

fn @route(arg0: u256) [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb1:
    icall @leaf, 0, 1
    jump bb3
  bb3:
    icall @leaf, 0, arg0
    revert 0, 0
}

fn @leaf(arg0: u256) [pure] {
  bb0:
    v0 = mload arg0
    mstore 0, arg0 !metadata(memory=scratch)
    mstore 32, v0 !metadata(memory=scratch)
    revert 0, 64
}

