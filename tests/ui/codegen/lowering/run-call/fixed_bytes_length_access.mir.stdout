}

; function makeBytes() private returns (bytes4)
fn @makeBytes() -> i256 {
  bb0:
    v0 = sload 1 !metadata(storage=slot(1))
    v1 = checked_add uint256, v0, 1
    sstore 1, v1 !metadata(storage=slot(1))
