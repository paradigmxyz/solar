fn @pack() -> struct0 [selector=0xef082838, pure, abi_params=[], abi_returns=[word, word], abi_return_params=[bytes32, uint256]] {
  bb0:
    v0 = alloc zeroed checked 96
    mstore v0, 2
    v1 = mload v0
    v2 = lt 0, v1
    v3 = eq v2, false
    icall panic_if<0x32>, v3
    v4 = ptradd v0, 32
    mstore v4, 1
    v5 = mload v0
    v6 = lt 1, v5
    v7 = eq v6, false
    icall panic_if<0x32>, v7
    v8 = ptradd v0, 64
    mstore v8, 2
    v9 = abi_encode_packed (array<word> memoryarray<1> v0)
    v10 = ptradd v9, 32
    v11 = mload v9
    v12 = keccak256 v10, v11
    v13 = mload v9
    v14 = insert_value struct0, undef struct0, 0, v12
    v15 = insert_value struct0, v14, 1, v13
    ret v15
}

