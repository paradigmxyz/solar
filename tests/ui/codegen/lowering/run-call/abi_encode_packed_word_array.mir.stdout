// === ROOT/tests/ui/codegen/lowering/run-call/abi_encode_packed_word_array.sol:AbiEncodePackedWordArray ===
@module AbiEncodePackedWordArray
@types
  struct0: {i256, i256}

fn @pack() -> struct0 [selector=0xef082838, pure, abi_params=[], abi_returns=[word, word], abi_return_params=[bytes32, u256]] {
  bb0:
    v0 = alloc zeroed checked 96
    store v0, 2
    v1 = load v0
    v2 = lt 0, v1
    v3 = eq v2, false
    icall panic_if<0x32>, v3
    store v0+32, 1
    v4 = load v0
    v5 = lt 1, v4
    v6 = eq v5, false
    icall panic_if<0x32>, v6
    store v0+64, 2
    v7 = abi_encode_packed (array<word> memoryarray<1> v0)
    v8 = ptradd v7, 32
    v9 = load v7
    v10 = keccak256 v8, v9
    v11 = load v7
    v12 = insert_value struct0, undef struct0, 0, v10
    v13 = insert_value struct0, v12, 1, v11
    ret v13
}

fn @cleanDirtyMemory() -> i256 [selector=0x4585502b, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc zeroed checked 96
    store v0, 2
    v1 = ptrtoint ptr<memory> v0 to i256
    v2 = add v1, 32
    store v2, 257
    v3 = ptrtoint ptr<memory> v0 to i256
    v4 = add v3, 64
    store v4, 514
    v5 = abi_encode_packed (array<word<u8>> memoryarray<1> v0)
    v6 = ptrtoint ptr<memory> v5 to i256
    v7 = add v6, 32
    v8 = load v7
    v9 = ptrtoint ptr<memory> v5 to i256
    v10 = add v9, 64
    v11 = load v10
    v12 = load v5
    v13 = eq v12, 64
    jumpi v13, bb1, bb2
  bb2:
    jump bb3
  bb1:
    v14 = eq v8, 1
    jump bb3
  bb3:
    v15 = phi [bb1: v14], [bb2: false]
    jumpi v15, bb4, bb5
  bb5:
    jump bb6
  bb4:
    v16 = eq v11, 2
    jump bb6
  bb6:
    v17 = phi [bb4: v16], [bb5: false]
    icall require<short_string>, v17, 12, 0x6469727479206d656d6f72790000000000000000000000000000000000000000
    ret 1
}

fn @packCalldata(arg0: slice<calldata>) -> i256 [selector=0x38651f67, pure, abi_params=[array<_, u8>], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 1
    v1 = extract_value slice<calldata>, arg0, 0
    v2 = mul v0, 32
    v3 = eq 32, 0
    v4 = div v2, 32
    v5 = eq v4, v0
    v6 = or v3, v5
    v7 = zext i1 v6 to i256
    v8 = eq v7, 0
    icall panic_if<0x41>, v8
    v9 = calldatasize
    v10 = ptrtoint ptr<calldata> v1 to i256
    v11 = sub v9, v10
    v12 = slt v11, v2
    icall revert_if<calldata_tail_too_short>, v12
    v13 = mul v0, 32
    v14 = eq 32, 0
    v15 = div v13, 32
    v16 = eq v15, v0
    v17 = or v14, v16
    v18 = zext i1 v17 to i256
    v19 = eq v18, 0
    icall panic_if<0x41>, v19
    v20 = add 32, v13
    v21 = lt v20, 32
    icall panic_if<0x41>, v21
    v22 = alloc v20
    store v22, v0
    jump bb1
  bb1:
    v23 = phi [bb0: 0], [bb2: v34]
    v24 = lt v23, v0
    jumpi v24, bb2, bb3
  bb3:
    v35 = abi_encode_packed (array<word<u8>> memoryarray<1> v22)
    v36 = ptradd v35, 32
    v37 = load v35
    v38 = keccak256 v36, v37
    ret v38
  bb2:
    v25 = mul v23, 32
    v26 = ptrtoint ptr<calldata> v1 to i256
    v27 = add v26, v25
    v28 = load calldata v27
    v29 = shr 8, v28
    v30 = eq v29, 0
    v31 = eq v30, false
    icall revert_if<empty>, v31
    v32 = shl 5, v23
    v33 = ptradd v22, v32
    store v33+32, v28
    v34 = add v23, 1
    jump bb1
}

fn @rejectDirtyCalldata() -> i256 [selector=0xe0d4a2a5, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc zeroed checked 64
    store v0, 1
    v1 = load v0
    v2 = lt 0, v1
    v3 = eq v2, false
    icall panic_if<0x32>, v3
    store v0+32, 1
    v4 = abi_encode [memory_array<word<u8>>], object, selector 0x38651f6700000000000000000000000000000000000000000000000000000000, args v0
    v5 = ptrtoint ptr<memory> v4 to i256
    v6 = add v5, 100
    store v6, 257
    v7 = address
    v8 = gas
    v9 = address_call v7, v4, gas v8
    v10 = eq v9, false
    icall require<short_string>, v10, 14, 0x64697274792063616c6c64617461000000000000000000000000000000000000
    ret 1
}
