; getter for `uint256 public observed` [selector 0xba210709]
fn @observed() -> i256 [selector=0xba210709, view, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    ret v0
}

; constructor() record(value()) [creation entry]
fn @constructor() [constructor] {
  bb0:
    v0 = icall @value
    sstore 0, v0 !metadata(storage=slot(0))
    jump bb2
  bb2:  ; preds = bb0
    jump bb1
  bb1:  ; preds = bb2
    ret
}

; function value() internal virtual returns (uint256)
fn @value() -> i256 {
  bb0:
    ret 1
}

