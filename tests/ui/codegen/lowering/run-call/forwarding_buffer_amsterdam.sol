contract TwoHundredHarness {
    function run() external returns (uint256) {
        address target = address(new TwoHundred());
        bytes memory values = new bytes(6400);
        for (uint256 i; i < 200; i++) {
            assembly {
                mstore(add(add(values, 0x20), mul(i, 0x20)), add(mul(i, 1000), 7))
            }
        }
        for (uint256 flag; flag < 2; flag++) {
            bytes memory data = abi.encodePacked(flag, values, new bytes(flag * 0x1000));
            (bool success, bytes memory result) = target.call(data);
            require(success, "call");
            require(keccak256(result) == keccak256(abi.encodePacked(values, keccak256(data))), "result");
        }
        return 1;
    }
}
