// ported-from: test/libsolidity/semanticTests/abicoder/abi_decode_overlapping_dynamic_arrays.sol
// ported-from: test/libsolidity/semanticTests/abicoder/abi_decode_from_calldata_static_array.sol
contract AbiDecodeStructsRunCall {
    struct Flat {
        uint256 a;
        address b;
        bool c;
    }

    struct Dyn {
        uint256 id;
        string name;
        uint256[] nums;
    }

    struct Nested {
        Flat flat;
        Dyn dyn;
        bytes tail;
    }

    function dFlat(bytes memory b) public pure returns (uint256, address, bool) {
        Flat memory f = abi.decode(b, (Flat));
        return (f.a, f.b, f.c);
    }

    function dMixed(bytes memory b) public pure returns (uint256, string memory, uint256) {
        (uint256 value, string memory name, uint256[] memory values) =
            abi.decode(b, (uint256, string, uint256[]));
        return (value, name, values.length);
    }

    function dNested(bytes memory b) public pure returns (uint256, string memory, uint256) {
        Nested memory n = abi.decode(b, (Nested));
        return (n.flat.a, n.dyn.name, n.tail.length);
    }

    function dDynArr(bytes memory b) public pure returns (uint256, uint256, uint256, uint256) {
        Dyn[] memory ds = abi.decode(b, (Dyn[]));
        return (ds.length, ds[0].id, ds[1].id, ds[0].nums.length);
    }

    function dFixedDyn(bytes memory b) public pure returns (uint256, uint256) {
        bytes[2] memory values = abi.decode(b, (bytes[2]));
        return (values[0].length, values[1].length);
    }

    function typedDynArray(Dyn[] calldata ds) external pure returns (uint256, uint256, uint256) {
        return (ds.length, ds[0].id, ds[1].id);
    }

    function nestedRoundtrip() public pure returns (uint256, string memory, uint256) {
        Nested memory n;
        n.flat = Flat(7, address(1), true);
        n.dyn.id = 42;
        n.dyn.name = "hi";
        n.dyn.nums = new uint256[](2);
        n.dyn.nums[0] = 4;
        n.dyn.nums[1] = 5;
        n.tail = "xyz";
        return dNested(abi.encode(n));
    }

    function dynamicArrayRoundtrip() public pure returns (uint256, uint256, uint256, uint256) {
        Dyn[] memory ds = new Dyn[](2);
        Dyn memory first;
        first.id = 42;
        first.name = "hi";
        first.nums = new uint256[](2);
        first.nums[0] = 4;
        first.nums[1] = 5;
        Dyn memory second;
        second.id = 43;
        second.name = "bye";
        second.nums = new uint256[](1);
        second.nums[0] = 6;
        ds[0] = first;
        ds[1] = second;
        return dDynArr(abi.encode(ds));
    }

    function fixedDynamicRoundtrip() public pure returns (uint256, uint256) {
        bytes[2] memory values;
        values[0] = hex"01";
        values[1] = hex"0203";
        bytes[2] memory decoded = abi.decode(abi.encode(values), (bytes[2]));
        return (decoded[0].length, decoded[1].length);
    }

    function dStaticNested(bytes calldata b)
        public
        pure
        returns (uint256, uint256, uint256, uint256, uint256, uint256)
    {
        uint256[2][3] memory values = abi.decode(b, (uint256[2][3]));
        return (
            values[0][0], values[0][1], values[1][0], values[1][1], values[2][0], values[2][1]
        );
    }

    function dNestedArrays(bytes memory b)
        public
        pure
        returns (uint256, uint256, uint256, uint256)
    {
        uint256[][] memory values = abi.decode(b, (uint256[][]));
        return (values.length, values[0].length, values[0][0], values[1][0]);
    }

    function dArrayFixed(bytes memory b)
        public
        pure
        returns (uint256, uint256, uint256, uint256, uint256)
    {
        uint256[2][] memory values = abi.decode(b, (uint256[2][]));
        return (values.length, values[0][0], values[0][1], values[1][0], values[1][1]);
    }

    function dFixedNestedDyn(bytes memory b)
        public
        pure
        returns (uint256, uint256, uint256, uint256, uint256)
    {
        uint256[][2] memory values = abi.decode(b, (uint256[][2]));
        return (values[0].length, values[0][0], values[0][1], values[1].length, values[1][0]);
    }

    function dCalldataDyn(bytes calldata b)
        public
        pure
        returns (uint256, uint256, uint256)
    {
        uint256[] memory values = abi.decode(b, (uint256[]));
        return (values.length, values[0], values[1]);
    }

    function dOverlap(bytes memory buf) public pure returns (bool same, bool inplaceDecoded) {
        (uint256[] memory arr1, uint256[] memory arr2) = abi.decode(buf, (uint256[], uint256[]));
        assembly {
            same := eq(arr1, arr2)
            inplaceDecoded := eq(arr1, add(buf, 0x60))
        }
    }
}
