@module ScalarDispatch
fn @difference(arg0: u256, arg1: u256, arg2: u256) -> u256 [selector=0x214636e1, pure, abi_params=[u256, u256, u256], abi_returns=[word]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v0]
    v1 = phi [bb0: arg0], [bb3: v10]
    v2 = phi [bb0: arg2], [bb3: v2]
    v3 = phi [bb0: 0], [bb3: v12]
    v4 = phi [bb0: arg1], [bb3: v11]
    v5 = lt v3, v2
    v6 = eq v5, 0
    v7 = iszero v6
    jumpi v7, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v1
  bb4:
    v8 = and v1, v4
    v9 = or v1, v4
    v10 = sub v9, v8
    v11 = add v4, v3
    jump bb6
  bb6:
    jump bb3
  bb3:
    v12 = add v3, 1
    jump bb1
}

