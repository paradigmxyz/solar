fn @recurse(arg0: u256, arg1: u256) -> u256 {
  bb0:
    switch arg1, default bb3, [0 => bb2]
  bb2:
    v0 = icall @leaf, 1, arg0
    jump bb1
  bb3:
    v1 = sub arg1, 1
    v2 = icall @recurse, 1, arg0, v1
