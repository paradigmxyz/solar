fn @step(arg0: u256, arg1: u256) -> (u256, u256) [pure] {
  bb0:
    v0 = mul arg0, 3
    v1 = add v0, arg1
    v2 = shl 1, arg1
    v3 = xor arg0, v2
    ret v1, v3
}

