// === ROOT/tests/ui/codegen/lowering/run-call/abi_decode_offset_overflow.sol:AbiDecodeOffsetOverflow ===
@module AbiDecodeOffsetOverflow
fn @test() -> u256 [selector=0xf8a8fd6d, pure, abi_params=[], abi_returns=[word]] {
  bb0:
    v0 = alloc memoryarray<1>, exact, zeroed, panic, 64
    set_memory_object_len memoryarray, v0, 1
    v1 = abi_encode [word, word, word], object, args 32, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v2 = alloc memorystruct<1>, exact, uninitialized, infallible, 32 !metadata(preserves_fmp)
    memory_object_store_field memorystruct<1>, v2, 0, 0
    memory_object_store_field memorystruct<1>, v2, 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v3 = memory_object_len memoryarray, v0
    v4 = lt 0, v3
    v5 = iszero v4
    panic_if v5, 0x32
    memory_object_store_element memoryarray<1>, v0, 0, 0x1e240
    v6 = abi_decode [array<2, array<_, u256>>], v1
    v7 = lt 1, 2
    v8 = iszero v7
    panic_if v8, 0x32
    v9 = memory_object_load_element memoryfixedarray<2, 1>, v6, 1
    v10 = memory_object_from_ptr memoryarray, v9
    v11 = eq v10, 0
    jumpi v11, bb1, bb2
  bb1:
    v12 = alloc memoryarray<1>, exact, uninitialized, infallible, 32
    set_memory_object_len memoryarray, v12, 0
    memory_object_store_element memoryfixedarray<2, 1>, v6, 1, v12
    jump bb2
  bb2:
    v13 = phi [bb0: v10], [bb1: v12]
    v14 = memory_object_len memoryarray, v13
    v15 = lt 0, v14
    v16 = iszero v15
    panic_if v16, 0x32
    v17 = memory_object_load_element memoryarray<1>, v13, 0
    ret v17
}

