// === ROOT/tests/ui/codegen/lowering/run-call/abi_decode_offset_overflow.sol:AbiDecodeOffsetOverflow ===
@module AbiDecodeOffsetOverflow
fn @test() -> i256 [selector=0xf8a8fd6d, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc memoryarray<1>, exact, zeroed, panic, 64
    mstore v0, 1
    v1 = abi_encode [word, word, word], object, args 32, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v2 = alloc memorystruct<1>, exact, uninitialized, infallible, 32 !metadata(preserves_fmp)
    memory_object_store_field memorystruct<1>, v2, 0, 0
    memory_object_store_field memorystruct<1>, v2, 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v3 = memory_slice v0
    v4 = slice_len v3
    v5 = lt 0, v4
    v6 = eq v5, false
    icall panic_if<0x32>, v6
    slice_store_element v3, 0, 0x1e240
    v7 = abi_decode [array<2, array<_, u256>>], v1
    v8 = lt 1, 2
    v9 = eq v8, false
    icall panic_if<0x32>, v9
    v10 = memory_object_load_element memoryfixedarray<2, 1>, v7, 1
    v11 = inttoptr i256 v10 to memptr
    v12 = eq v10, 0
    jumpi v12, bb1, bb2
  bb1:
    v13 = alloc memoryarray<1>, exact, uninitialized, infallible, 32
    mstore v13, 0
    v14 = ptrtoint memptr v13 to i256
    memory_object_store_element memoryfixedarray<2, 1>, v7, 1, v14
    jump bb2
  bb2:
    v15 = phi [bb0: v11], [bb1: v13]
    v16 = memory_slice v15
    v17 = slice_len v16
    v18 = lt 0, v17
    v19 = eq v18, false
    icall panic_if<0x32>, v19
    v20 = slice_load_element v16, 0
    ret v20
}

fn @withinArray() -> i256 [selector=0xac457954, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc memoryarray<1>, exact, zeroed, panic, 64
    mstore v0, 1
    v1 = abi_encode [word, word], object, args 32, 2
    v2 = alloc memorystruct<2>, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
    memory_object_store_field memorystruct<2>, v2, 0, 0
