// === ROOT/tests/ui/codegen/lowering/run-call/abi_decode_offset_overflow.sol:AbiDecodeOffsetOverflow ===
@module AbiDecodeOffsetOverflow
fn @test() -> i256 [selector=0xf8a8fd6d, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc memoryarray<1>, exact, zeroed, panic, 64
    mstore v0, 1
    v1 = abi_encode [word, word, word], object, args 32, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v2 = alloc memorystruct<1>, exact, uninitialized, infallible, 32 !metadata(preserves_fmp)
    v3 = make_memory_slice v2, 1
    slice_store_element v3, 0, 0
    v4 = make_memory_slice v2, 1
    slice_store_element v4, 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v5 = memory_slice v0
    v6 = slice_len v5
    v7 = lt 0, v6
    v8 = eq v7, false
    icall panic_if<0x32>, v8
    slice_store_element v5, 0, 0x1e240
    v9 = abi_decode [array<2, array<_, u256>>], v1
    v10 = make_memory_slice v9, 2
    v11 = lt 1, 2
    v12 = eq v11, false
    icall panic_if<0x32>, v12
    v13 = slice_load_element v10, 1
    v14 = inttoptr i256 v13 to memptr
    v15 = eq v13, 0
    jumpi v15, bb1, bb2
  bb1:
    v16 = alloc memoryarray<1>, exact, uninitialized, infallible, 32
    mstore v16, 0
    v17 = ptrtoint memptr v16 to i256
    slice_store_element v10, 1, v17
    jump bb2
  bb2:
    v18 = phi [bb0: v14], [bb1: v16]
    v19 = memory_slice v18
    v20 = slice_len v19
    v21 = lt 0, v20
    v22 = eq v21, false
    icall panic_if<0x32>, v22
    v23 = slice_load_element v19, 0
    ret v23
}

