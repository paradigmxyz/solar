    v3 = memory_slice v0
    v4 = slice_len v3
    v5 = lt 0, v4
    v6 = eq v5, false
    icall panic_if<0x32>, v6
    slice_store_element v3, 0, 0x1e240
    memory_object_store_field memorystruct<2>, v2, 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff60
    memory_object_store_field memorystruct<2>, v2, 1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff60
    v7 = abi_decode [array<_, array<_, u256>>], v1
    v8 = memory_slice v7
    v9 = slice_len v8
    v10 = lt 0, v9
    v11 = eq v10, false
    icall panic_if<0x32>, v11
    v12 = slice_load_element v8, 0
    v13 = inttoptr i256 v12 to memptr
    v14 = eq v12, 0
    jumpi v14, bb1, bb2
  bb1:
    v15 = alloc memoryarray<1>, exact, uninitialized, infallible, 32
    mstore v15, 0
    v16 = memory_slice v7
    v17 = ptrtoint memptr v15 to i256
    slice_store_element v16, 0, v17
    jump bb2
  bb2:
    v18 = phi [bb0: v13], [bb1: v15]
    v19 = memory_slice v18
    v20 = slice_len v19
    v21 = lt 0, v20
    v22 = eq v21, false
    icall panic_if<0x32>, v22
    v23 = slice_load_element v19, 0
    v24 = memory_slice v7
    v25 = slice_len v24
    v26 = lt 1, v25
    v27 = eq v26, false
    icall panic_if<0x32>, v27
    v28 = slice_load_element v24, 1
    v29 = inttoptr i256 v28 to memptr
    v30 = eq v28, 0
    jumpi v30, bb3, bb4
  bb3:
    v31 = alloc memoryarray<1>, exact, uninitialized, infallible, 32
    mstore v31, 0
    v32 = memory_slice v7
    v33 = ptrtoint memptr v31 to i256
    slice_store_element v32, 1, v33
    jump bb4
  bb4:
    v34 = phi [bb2: v29], [bb3: v31]
    v35 = memory_slice v34
    v36 = slice_len v35
    v37 = lt 0, v36
    v38 = eq v37, false
    icall panic_if<0x32>, v38
    v39 = slice_load_element v35, 0
    v40 = checked_add u256, v23, v39
    ret v40
}
