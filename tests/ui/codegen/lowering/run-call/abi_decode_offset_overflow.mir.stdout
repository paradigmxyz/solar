// === ROOT/tests/ui/codegen/lowering/run-call/abi_decode_offset_overflow.sol:AbiDecodeOffsetOverflow ===
@module AbiDecodeOffsetOverflow
fn @test() -> i256 [selector=0xf8a8fd6d, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc zeroed checked 64
    mstore v0, 1
    v1 = abi_encode [word, word, word], object, args 32, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v2 = alloc 32 !metadata(preserves_fmp)
    mstore v2, 0
    mstore v2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v3 = mload v0
    v4 = lt 0, v3
    v5 = eq v4, false
    icall panic_if<0x32>, v5
    v6 = ptradd v0, 32
    mstore v6, 0x1e240
    v7 = abi_decode [array<2, array<_, u256>>], v1
    v8 = lt 1, 2
    v9 = eq v8, false
    icall panic_if<0x32>, v9
    v10 = ptradd v7, 32
    v11 = mload v10
    v12 = inttoptr i256 v11 to ptr<memory>
    v13 = eq v11, 0
    jumpi v13, bb1, bb2
  bb1:
    v14 = alloc 32
    mstore v14, 0
    v15 = ptradd v7, 32
    v16 = ptrtoint ptr<memory> v14 to i256
    mstore v15, v16
    jump bb2
  bb2:
    v17 = phi [bb0: v12], [bb1: v14]
    v18 = mload v17
    v19 = lt 0, v18
    v20 = eq v19, false
    icall panic_if<0x32>, v20
    v21 = ptradd v17, 32
    v22 = mload v21
    ret v22
}

