// === ROOT/tests/ui/codegen/lowering/run-call/abi_decode_offset_overflow.sol:AbiDecodeOffsetOverflow ===
@module AbiDecodeOffsetOverflow
fn @test() -> i256 [selector=0xf8a8fd6d, pure, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = alloc memoryarray<1>, exact, zeroed, panic, 64
    v1 = ptrtoint memptr v0 to i256
    mstore v1, 1
    v2 = abi_encode [word, word, word], object, args 32, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v3 = alloc memorystruct<1>, exact, uninitialized, infallible, 32 !metadata(preserves_fmp)
    memory_object_store_field memorystruct<1>, v3, 0, 0
    memory_object_store_field memorystruct<1>, v3, 0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v4 = memory_slice v0
    v5 = slice_len v4
    v6 = lt 0, v5
    v7 = eq v6, false
    icall panic_if<0x32>, v7
    slice_store_element v4, 0, 0x1e240
    v8 = abi_decode [array<2, array<_, u256>>], v2
    v9 = lt 1, 2
    v10 = eq v9, false
    icall panic_if<0x32>, v10
    v11 = memory_object_load_element memoryfixedarray<2, 1>, v8, 1
    v12 = inttoptr i256 v11 to memptr
    v13 = eq v11, 0
    jumpi v13, bb1, bb2
  bb1:
    v14 = alloc memoryarray<1>, exact, uninitialized, infallible, 32
    v15 = ptrtoint memptr v14 to i256
    mstore v15, 0
    v16 = ptrtoint memptr v14 to i256
    memory_object_store_element memoryfixedarray<2, 1>, v8, 1, v16
    jump bb2
  bb2:
    v17 = phi [bb0: v12], [bb1: v14]
    v18 = memory_slice v17
    v19 = slice_len v18
    v20 = lt 0, v19
    v21 = eq v20, false
    icall panic_if<0x32>, v21
    v22 = slice_load_element v18, 0
    ret v22
}

