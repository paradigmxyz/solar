// === ROOT/tests/ui/codegen/lowering/run-call/abi_decode_offset_overflow.sol:AbiDecodeOffsetOverflow ===
@module AbiDecodeOffsetOverflow
fn @test() -> i256 [selector=0xf8a8fd6d, pure, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = alloc zeroed checked 64
    mstore v0, 1
    v1 = abi_encode [word, word, word], object, args 32, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v2 = alloc 32 !metadata(preserves_fmp)
    mstore v2, 0
    mstore v2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    v3 = mload v0
    v4 = lt 0, v3
    v5 = eq v4, false
    icall panic_if<0x32>, v5
    v6 = ptradd v0, 32
    mstore v6, 0x1e240
    v7 = abi_decode [array<2, array<_, uint256>>], v1
    v8 = lt 1, 2
    v9 = eq v8, false
    icall panic_if<0x32>, v9
    v10 = ptradd v7, 32
    v11 = mload v10, ptr<memory>
    v12 = mload v11
    v13 = lt 0, v12
    v14 = eq v13, false
    icall panic_if<0x32>, v14
    v15 = ptradd v11, 32
    v16 = mload v15
    ret v16
}

