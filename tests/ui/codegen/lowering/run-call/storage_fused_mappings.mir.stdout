    v0 = zext i160 arg0 to i256
    v1 = mapping_slot v0, 3
    sstore v1, 9 !metadata(storage=symbolic(v1))
    v2 = zext i160 arg0 to i256
    v3 = keccak256_packed (uint256 v2, uint256 3)
    v4 = sload v3 !metadata(storage=symbolic(v3))
    ret v4
}
