// Raw calldata keeps arbitrary-length RETURN/REVERT data independent of ABI result decoding.
// RETURN and REVERT read memory themselves; no preceding MLOAD makes the FMP read explicit.
// This contract has no compiler-owned frames, so the initial free-memory floor is exactly 128.
contract FmpTerminalReads {
    function direct() external pure {
        assembly { return(64, 32) }
    }

    function fail() external pure {
        assembly { revert(64, 32) }
    }

    function slice(uint256 offset, uint256 size) external pure {
        assembly { return(offset, size) }
    }

    function failSlice(uint256 offset, uint256 size) external pure {
        assembly { revert(offset, size) }
    }

    function wrapped(uint256 offset, uint256 delta, uint256 size) external pure {
        assembly { return(add(offset, delta), size) }
    }
}
