fn @slice(arg0: slice<calldata>, arg1: i256) -> slice<calldata> [pure] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = ptrtoint ptr<calldata> v0 to i256
    v2 = add v1, arg1
    v3 = make_calldata_slice ptr<calldata> 0, 0
    v4 = extract_value slice<calldata>, v3, 1
    v5 = inttoptr i256 v2 to ptr<calldata>
    v6 = make_calldata_slice v5, v4
    v7 = extract_value slice<calldata>, arg0, 1
    v8 = sub v7, arg1
    v9 = extract_value slice<calldata>, v6, 0
    v10 = make_calldata_slice v9, v8
    ret v10
}
