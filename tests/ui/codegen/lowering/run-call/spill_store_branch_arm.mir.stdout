  bb1:
    revert_returndata
  bb2:
    v9 = gas
    v10 = abi_encode [word], selector 0x483f31ab00000000000000000000000000000000000000000000000000000000, args arg2
    v11 = extract_value slice<memory>, v10, 0
    v12 = extract_value slice<memory>, v10, 1
    v13 = zext i160 arg0 to i256
    v14 = extcodesize v13
    v15 = eq v14, 0
    icall revert_if<target_contract_has_no_code>, v15
    v16 = zext i160 arg0 to i256
    v17 = call v9, v16, 0, v11, v12, 0, 0
    jumpi v17, bb4, bb3
  bb3:
    revert_returndata
  bb4:
    ret
}
