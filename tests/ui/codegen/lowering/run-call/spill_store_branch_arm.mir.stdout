    v7 = call v0, arg0, 0, v3, v4, 0, 0
    jumpi v7, bb2, bb1
  bb1:
    revert_returndata
  bb2:
    v8 = gas
    v9 = abi_encode [word], selector 0x483f31ab00000000000000000000000000000000000000000000000000000000, args arg2
    v10 = slice_ptr v9
    v11 = slice_len v9
    v12 = extcodesize arg0
    v13 = eq v12, 0
    icall revert_if<target_contract_has_no_code>, v13
    v14 = call v8, arg0, 0, v10, v11, 0, 0
    jumpi v14, bb4, bb3
  bb3:
    revert_returndata
  bb4:
    ret
}
