// Calldata slices decode in place, bounded by the slice rather than by the end of calldata: a
// tail that starts inside the slice but runs past its end reverts, as solc decodes it, even
// though the words it would read lie in calldata.
contract AbiDecodeCalldataSubslice {
    function sub(bytes calldata data, uint256 n) external pure returns (uint256) {
        bytes memory b = abi.decode(data[:n], (bytes));
        return b.length;
    }

    function word(bytes calldata data, uint256 n) external pure returns (uint256) {
        return abi.decode(data[:n], (uint256));
    }
}
