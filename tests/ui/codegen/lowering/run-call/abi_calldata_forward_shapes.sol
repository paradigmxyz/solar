enum Mode {
    A,
    B,
    C
}

struct Flags {
    bool on;
    int8 delta;
    Mode mode;
    bytes4 tag;
}

struct Pair {
    uint256 a;
    uint256 b;
}

struct Holder {
    address[] receivers;
    uint256 tag;
}

struct Mixed {
    Flags[] flags;
    Pair[] pairs;
    uint256[][2] grid;
    bytes[] blobs;
}

// Each `sink` hashes the calldata the forwarding functions send it, so the expected hashes are
// the selector and canonical ABI encoding of the decoded values.
contract AbiCalldataForwardShapes {
    function sinkFlags(Flags[] calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function sinkPairs(Pair[] calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function sinkGrid(uint256[][2] calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function sinkMixed(Mixed calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function forwardFlags(Flags[] calldata flags) external view returns (bytes32) {
        return this.sinkFlags(flags);
    }

    function forwardPairs(Pair[] calldata pairs) external view returns (bytes32) {
        return this.sinkPairs(pairs);
    }

    function forwardGrid(uint256[][2] calldata grid) external view returns (bytes32) {
        return this.sinkGrid(grid);
    }

    function forwardMixed(Mixed calldata mixed) external view returns (bytes32) {
        return this.sinkMixed(mixed);
    }

    function sinkNested(uint8[][] calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function sinkHolder(Holder calldata) external pure returns (bytes32) {
        return keccak256(msg.data);
    }

    function forwardNested(uint8[][] calldata values) external view returns (bytes32) {
        return this.sinkNested(values);
    }

    function forwardHolder(Holder calldata holder) external view returns (bytes32) {
        return this.sinkHolder(holder);
    }

    function encodeNested(uint8[][] calldata values) external pure returns (bytes32) {
        return keccak256(abi.encode(values));
    }

    function encodeHolder(Holder calldata holder) external pure returns (bytes32) {
        return keccak256(abi.encode(holder));
    }

    function encodeFlags(Flags[] calldata flags) external pure returns (bytes32) {
        return keccak256(abi.encode(flags));
    }

    function encodePairs(Pair[] calldata pairs) external pure returns (bytes32) {
        return keccak256(abi.encode(pairs));
    }

    function encodeGrid(uint256[][2] calldata grid) external pure returns (bytes32) {
        return keccak256(abi.encode(grid));
    }

    function encodeMixed(Mixed calldata mixed) external pure returns (bytes32) {
        return keccak256(abi.encode(mixed));
    }
}
