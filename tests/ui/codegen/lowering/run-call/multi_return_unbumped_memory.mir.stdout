  struct0: {i256, i256}

fn @output() -> i256 [selector=0xf20eaeb8, inline_assembly, pure, abi_params=[], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    v1 = add v0, 32
    v2 = icall @emitWord, v1
    v3 = extract_value struct0, v2, 0
    v4 = extract_value struct0, v2, 1
