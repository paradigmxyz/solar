pragma abicoder v2;

contract CalldataStructBytesValidation {
    event BytesEmitted(bytes indexed value);

    struct Value {
        bytes data;
        uint256 tag;
    }

    function copy(Value calldata value) external pure returns (uint256) {
        Value memory copyValue = value;
        return copyValue.data.length + copyValue.tag;
    }

    function encodeField(Value calldata value) external pure returns (uint256) {
        bytes memory encoded = abi.encode(value.data);
        return uint8(encoded[64]);
    }

    function encodePackedField(Value calldata value) external pure returns (uint256) {
        bytes memory encoded = abi.encodePacked(value.data);
        return uint8(encoded[0]);
    }

    function hashField(Value calldata value) external pure returns (bytes32) {
        return keccak256(value.data);
    }

    function indexField(Value calldata value) external pure returns (uint256) {
        return uint8(value.data[0]);
    }

    function fixedField(Value calldata value) external pure returns (uint256) {
        return uint8(bytes1(value.data));
    }

    function copyField(Value calldata value) external pure returns (uint256) {
        bytes memory data = value.data;
        return data.length;
    }

    function copyWords(uint256[] calldata values) external pure returns (uint256) {
        uint256[] memory copyValues = values;
        return copyValues.length + copyValues[0];
    }

    function emitBytes(bytes calldata value) external returns (uint256) {
        emit BytesEmitted(value);
        return value.length;
    }

    function copyArray(bytes[] calldata values) external pure returns (uint256) {
        bytes[] memory copyValues = values;
        return copyValues[0].length;
    }
}
