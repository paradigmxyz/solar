  bb0:
    v0 = icall concat<bytes7, calldataslice>, 0x68656c6c6f2c2000000000000000000000000000000000000000000000000000, arg0
    ret v0
}

fn @share(arg0: i256) -> i256 [selector=0xc3d9c4b4, pure, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
