@module Small
@optimize size
fn @sum(arg0: i256) -> i256 [selector=0x188b85b4, pure, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v5]
    v2 = phi [bb0: 1], [bb3: v6]
    v3 = gt v2, v0
    v4 = eq v3, false
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v1
  bb4:
    v5 = checked_add u256, v1, v2
    jump bb6
  bb6:
    jump bb3
  bb3:
    v6 = checked_add u256, v2, 1
    jump bb1
}

