    icall panic_if<0x41>, v18
    v19 = add 32, v12
    v20 = lt v19, 32
    icall panic_if<0x41>, v20
    v21 = alloc memoryarray<1>, exact, uninitialized, infallible, v19
    store v21, v0
    v22 = make_calldata_slice v1, v12
    v23 = ptradd v21, 32
    v24 = slice_ptr v22
    v25 = slice_len v22
    copy calldata v23, v24, v25
