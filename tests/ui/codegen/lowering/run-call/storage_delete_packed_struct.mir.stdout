    v8 = add 3, 1
    v9 = add 3, 2
    sstore v9, 0 !metadata(storage=slot(5))
    v10 = sload 3 !metadata(storage=slot(3))
    v11 = add 3, 2
    v12 = sload v11 !metadata(storage=slot(5))
    v13 = and v12, 255
    v14 = mapping_slot 1, v0
    v15 = sload v14 !metadata(storage=symbolic(v14))
    v16 = sload v0 !metadata(storage=slot(4))
    ret v10, v13, v16, v15
}
