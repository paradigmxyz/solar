@module C
fn @signedUserKey() -> i256 [selector=0x27072c8b, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = sub 0, 1
    v1 = trunc i256 v0 to i16
    v2 = sext i16 v1 to i256
    v3 = mapping_slot v2, 2
    sstore v3, 9 !metadata(storage=symbolic(v3))
    v4 = not 0
    mstore 0, v4 !metadata(memory=scratch)
    mstore 32, 2 !metadata(memory=scratch)
    v5 = keccak256 0, 64 !metadata(memory=scratch)
    v6 = sload v5 !metadata(storage=symbolic(v5))
    ret v6
}

fn @signedKey() -> i256 [selector=0xa0b120fe, abi_params=[], abi_returns=[word], abi_return_params=[u256]] {
