// === ROOT/tests/ui/codegen/lowering/run-call/call_entry_fusion.sol:CallEntryFusion ===
@module CallEntryFusion
fn @run(arg0: u256, arg1: u256, arg2: u256) -> (u256, u256, u256, u256) [selector=0x24b912e5, pure, abi_params=[u256, u256, u256], abi_returns=[word, word, word, word]] {
  bb0:
    v0 = and arg1, 7
    v1 = internal_call @fold, 1, arg0, v0
    v2 = and arg0, 7
    v3 = internal_call @fold, 1, arg1, v2
    v4 = and arg0, 7
    v5 = and arg0, 7
    v6 = internal_call @fold, 1, v4, v5
    ret v1, v3, v6, arg2
}

fn @fold(arg0: u256, arg1: u256) -> u256 [pure] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v6]
    v1 = phi [bb0: arg0], [bb5: v1]
    v2 = phi [bb0: arg1], [bb5: v7]
    v3 = eq v2, 0
    v4 = iszero v3
    jumpi v4, bb3, bb4
  bb4:
    jump bb2
  bb2:
    ret v0
  bb3:
    v5 = xor v1, v2
    v6 = add v0, v5
    v7 = sub v2, 1
    jump bb5
  bb5:
    jump bb1
}
