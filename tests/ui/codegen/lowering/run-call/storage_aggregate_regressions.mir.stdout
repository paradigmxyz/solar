    v2 = lt v1, arg2
    jumpi v2, bb2, bb3
  bb3:
    stop
  bb2:
    v3 = add v0, v1
    sstore v3, 0 !metadata(storage=symbolic(v3))
    v4 = add v1, 1
    jump bb1
}
