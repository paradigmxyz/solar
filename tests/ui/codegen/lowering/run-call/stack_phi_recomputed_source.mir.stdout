// === ROOT/tests/ui/codegen/lowering/run-call/stack_phi_recomputed_source.sol:StackPhiRecomputedSource ===
@module StackPhiRecomputedSource
fn @count(arg0: u256, arg1: calldataslice) -> u256 [selector=0xd6c2a588, pure, abi_params=[u256, bytes], abi_returns=[word]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v6]
    v1 = phi [bb0: arg0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v5]
    v3 = phi [bb0: arg1], [bb3: v3]
    v4 = lt v0, v1
    jumpi v4, bb4, bb5
  bb2:
    ret v2
  bb3:
    v6 = add v0, 1
    jump bb1
  bb4:
    v5 = add v2, 1
    jump bb6
  bb5:
    jump bb2
  bb6:
    jump bb3
}

