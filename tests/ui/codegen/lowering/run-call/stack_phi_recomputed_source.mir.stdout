// === ROOT/tests/ui/codegen/lowering/run-call/stack_phi_recomputed_source.sol:StackPhiRecomputedSource ===
@module StackPhiRecomputedSource
fn @count(arg0: i256, arg1: calldataslice) -> i256 [selector=0xd6c2a588, pure, abi_params=[u256, bytes], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v5]
    v3 = phi [bb0: 0], [bb3: v6]
    v4 = lt v3, v0
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v2
  bb4:
    v5 = add v2, 1
    jump bb6
  bb6:
    jump bb3
  bb3:
    v6 = add v3, 1
    jump bb1
}
