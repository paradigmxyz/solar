contract AbiDecodeStorageInvalid {
    bytes private data;

    struct Narrow {
        uint8 a;
        uint8 b;
        address c;
        address d;
        bytes4 e;
        bytes4 f;
    }

    function decode(bytes memory input) external returns (uint256) {
        data = input;
        uint256[] memory decoded = abi.decode(data, (uint256[]));
        return decoded.length;
    }

    function decodeNarrow(bytes memory input) external returns (uint256) {
        data = input;
        Narrow memory decoded = abi.decode(data, (Narrow));
        return decoded.a + decoded.b;
    }
}
