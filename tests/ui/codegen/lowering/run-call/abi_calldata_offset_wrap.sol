pragma abicoder v2;

contract AbiCalldataOffsetWrap {
    function f(uint256[][] calldata values)
        external
        pure
        returns (uint256 a, uint256 b, uint256 c)
    {
        a = values.length;
        if (a > 0) b = values[0].length;
        if (a > 1) c = values[1].length;
    }
}
