    store_storage_bytes_literal 0, hex"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    mstore 0, 0 !metadata(memory=scratch)
