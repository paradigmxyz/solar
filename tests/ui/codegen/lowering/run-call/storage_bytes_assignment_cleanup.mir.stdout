    v4 = eq v3, 0
    v5 = zext i1 v4 to i256
    v6 = add v0, 1
    v7 = sload v6 !metadata(storage=offset(v0, 1))
    v8 = eq v7, 0
    v9 = zext i1 v8 to i256
    v10 = ne v5, 0
    v11 = ne v9, 0
    v12 = sload 0 !metadata(storage=slot(0))
    validate_storage_bytes v12
    v13 = and v12, 1
    v14 = eq v13, 1
    v15 = sub 0, v13
    v16 = or v15, 127
    v17 = shr v12, 1
    v18 = and v17, v16
    v19 = insert_value struct0, undef struct0, 0, v10
    v20 = insert_value struct0, v19, 1, v11
    v21 = insert_value struct0, v20, 2, v18
    ret v21
}

