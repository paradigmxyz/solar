; function cleanup() external returns (bool firstNonzero, bool staleZero, uint256 length) [selector 0x3cecd719]
fn @cleanup() -> struct0 [selector=0x3cecd719, abi_params=[], abi_returns=[word<bool>, word<bool>, word], abi_return_params=[bool, bool, uint256]] {
  bb0:
    store_storage_bytes_literal 0, hex"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    store_storage_bytes_literal 0, hex"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    mstore 0, 0 !metadata(memory=scratch)
    v0 = keccak256 0, 32 !metadata(memory=scratch)
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = eq v1, 0
    v3 = zext i1 v2 to i256
    v4 = eq v3, 0
    v5 = zext i1 v4 to i256
    v6 = add v0, 1
    v7 = sload v6 !metadata(storage=offset(v0, 1))
    v8 = eq v7, 0
    v9 = zext i1 v8 to i256
    v10 = ne v5, 0
    v11 = zext i1 v10 to i256
    v12 = ne v9, 0
    v13 = zext i1 v12 to i256
    v14 = sload 0 !metadata(storage=slot(0))
    validate_storage_bytes v14
    v15 = and v14, 1
    v16 = eq v15, 1
    v17 = sub 0, v15
    v18 = or v17, 127
    v19 = shr v14, 1
    v20 = and v19, v18
    v21 = insert_value struct0, undef struct0, 0, v11
    v22 = insert_value struct0, v21, 1, v13
    v23 = insert_value struct0, v22, 2, v20
    ret v23
}

