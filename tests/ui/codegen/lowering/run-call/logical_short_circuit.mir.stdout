fn @bump() -> bool [selector=0x68110b2f, abi_params=[], abi_returns=[word<bool>]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = checked_add u256, v0, 1
    sstore 0, v1 !metadata(storage=slot(0))
    ret true
}

