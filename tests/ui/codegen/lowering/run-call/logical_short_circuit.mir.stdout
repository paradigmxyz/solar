    jumpi v3, bb5, bb4
  bb4:
    revert_returndata
  bb5:
    v4 = returndatasize
    v5 = lt v4, 32
    icall revert_if<tuple_data_too_short>, v5
    v6 = mload 0 !metadata(memory=scratch)
    v7 = lt v6, 2
    v8 = eq v7, false
    icall revert_if<empty>, v8
    v9 = ne v6, 0
    jump bb3
  bb3:
    v10 = phi [bb5: v9], [bb2: false]
    v11 = sload 0 !metadata(storage=slot(0))
    v12 = insert_value struct0, undef struct0, 0, v11
    v13 = insert_value struct0, v12, 1, v10
    ret v13
}

