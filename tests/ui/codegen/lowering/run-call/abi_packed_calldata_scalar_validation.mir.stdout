// === ROOT/tests/ui/codegen/lowering/run-call/abi_packed_calldata_scalar_validation.sol:AbiPackedCalldataScalarValidation ===
@module AbiPackedCalldataScalarValidation
fn @encode(arg0: calldataslice) -> memorybytes [selector=0x1597ee44, pure, abi_params=[array<_, u8>], abi_returns=[memory_bytes]] {
  bb0:
    v0 = slice_len arg0
    v1 = slice_ptr arg0
    v2 = mul v0, 32
    v3 = iszero 32
    v4 = div v2, 32
    v5 = eq v4, v0
    v6 = or v3, v5
    v7 = iszero v6
    panic_if v7, 0x41
    v8 = calldatasize
    v9 = sub v8, v1
    v10 = slt v9, v2
    revert_if v10, calldata_tail_too_short
    v11 = mul v0, 32
    v12 = iszero 32
    v13 = div v11, 32
    v14 = eq v13, v0
    v15 = or v12, v14
    v16 = iszero v15
    panic_if v16, 0x41
    v17 = add 32, v11
    v18 = lt v17, 32
    panic_if v18, 0x41
    v19 = alloc memoryarray<1>, exact, uninitialized, infallible, v17
    set_memory_object_len memoryarray, v19, v0
    jump bb1
  bb1:
    v20 = phi [bb0: 0], [bb2: v34]
    v21 = lt v20, v0
    jumpi v21, bb2, bb3
  bb3:
    v35 = abi_encode_packed (array<word<u8>> memoryarray<1> v19)
    ret v35
  bb2:
    v22 = mul v20, 32
    v23 = iszero 32
    v24 = div v22, 32
    v25 = eq v24, v20
    v26 = or v23, v25
    v27 = iszero v26
    panic_if v27, 0x41
    v28 = add v1, v22
    v29 = calldataload v28
    v30 = and v29, 255
    v31 = eq v29, v30
    v32 = iszero v31
    revert_if v32, empty
    v33 = and v29, 255
    memory_object_store_element memoryarray<1>, v19, v20, v33
    v34 = add v20, 1
    jump bb1
}
