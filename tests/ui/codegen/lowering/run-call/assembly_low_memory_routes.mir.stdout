fn @lowHeapRoute(arg0: i256) -> i256 [selector=0x52ecae0e, pure, abi_params=[u256], abi_returns=[word<bool>], abi_return_params=[bool]] {
  bb0:
    v0 = icall @_spillHashes, arg0
    v1 = eq v0, 0
    v2 = zext i1 v1 to i256
    v3 = eq v2, 0
    v4 = zext i1 v3 to i256
    v5 = mload 64 !metadata(memory=scratch)
    v6 = lt v5, 0x2000
    v7 = zext i1 v6 to i256
    v8 = and v7, v4
    ret v8
}

