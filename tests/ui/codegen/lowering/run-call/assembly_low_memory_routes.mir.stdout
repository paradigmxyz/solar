fn @_lay(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = calldataload 36
    v1 = shl 5, v0
    v2 = add 160, v1
    jump bb1
  bb1:
    v3 = phi [bb0: arg0], [bb3: v3]
    v4 = phi [bb0: v2], [bb3: v4]
