fn @forwardDerived(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = checked_mul u256, arg0, 3
    v1 = checked_add u256, v0, 1
    v2 = calldatasize
    calldatacopy 128, v2, arg1
    ret v1
