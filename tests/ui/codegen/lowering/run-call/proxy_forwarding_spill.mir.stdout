    mstore v30, 0xdeadbeefdeadbeefdeadbeefdeadbeef00000000000000000000000000000000
    v31 = abi_encode [word, word, word, memory_bytes], selector 0xe6a9b50500000000000000000000000000000000000000000000000000000000, args 10, 20, 30, v28
    v32 = slice_ptr v31
