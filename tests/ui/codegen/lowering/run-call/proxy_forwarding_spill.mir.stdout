// === ROOT/tests/ui/codegen/lowering/run-call/proxy_forwarding_spill.sol:Proxy ===
@module Proxy
immutables:
  _defaultImplementation: bytes32

fn @constructor(arg0: i256) [constructor, abi_params=[address]] {
  bb0:
    v0 = trunc i256 arg0 to i160
    v1 = zext i160 v0 to i256
    v2 = shl 0, v1
    storeimmutable _defaultImplementation, v2
    ret
}

fn @fallback() [fallback, payable] {
  bb0:
    v0 = returndatasize
    mstore 64, v0 !metadata(memory=scratch)
    v1 = sload 0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc !metadata(storage=slot(0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc))
    v2 = eq v1, 0
    jumpi v2, bb1, bb2
  bb2:
    jump bb3
  bb1:
    v3 = loadimmutable _defaultImplementation
    jump bb3
  bb3:
    v4 = phi [bb1: v3], [bb2: v1]
    v5 = calldatasize
    v6 = returndatasize
    v7 = returndatasize
    calldatacopy v7, v6, v5
    v8 = returndatasize
    v9 = codesize
    v10 = calldatasize
    v11 = returndatasize
    v12 = gas
    v13 = delegatecall v12, v4, v11, v10, v9, v8
    v14 = zext i1 v13 to i256
    v15 = eq v14, 0
    v16 = zext i1 v15 to i256
    v17 = ne v16, 0
    jumpi v17, bb4, bb5
  bb5:
    jump bb6
  bb6:
    v20 = returndatasize
    returndatacopy 0, 0, v20 !metadata(memory=scratch)
    v21 = returndatasize
    returndata 0, v21
  bb4:
    v18 = returndatasize
    returndatacopy 0, 0, v18 !metadata(memory=scratch)
    v19 = returndatasize
    revert 0, v19
}

