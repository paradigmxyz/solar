// === ROOT/tests/ui/codegen/lowering/run-call/proxy_forwarding_spill.sol:FrameForwarding ===
@module FrameForwarding
fn @run(arg0: i256, arg1: i256) -> i256 [selector=0x7357f5d2, pure, abi_params=[u256, u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = icall @forward, arg0, arg1
