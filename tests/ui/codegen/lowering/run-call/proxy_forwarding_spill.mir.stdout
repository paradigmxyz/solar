fn @forwardSweep(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg1], [bb3: v0]
    v1 = phi [bb0: 0], [bb3: v7]
    v2 = phi [bb0: arg0], [bb3: v2]
    v3 = phi [bb0: 0], [bb3: v3]
    v4 = lt v1, v0
    v5 = zext i1 v4 to i256
    v6 = ne v5, 0
    jumpi v6, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v2
  bb4:
    mstore v1, 0
    jump bb6
  bb6:
    jump bb3
  bb3:
    v7 = add v1, 32
    jump bb1
}
