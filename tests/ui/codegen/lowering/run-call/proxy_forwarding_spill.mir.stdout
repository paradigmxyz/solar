}

fn @forward(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = calldatasize
    calldatacopy 128, v0, arg1
    ret arg0
}

fn @branch(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0x2c4d4a2d, pure, abi_params=[u256, u256, bool], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = icall @forwardBranch, arg0, arg1, arg2
