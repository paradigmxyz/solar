// === ROOT/tests/ui/codegen/lowering/run-call/event_indexed_calldata_validation.sol:EventIndexedCalldataValidation ===
@module EventIndexedCalldataValidation
fn @emitValues(arg0: calldataslice) -> i256 [selector=0x797a5ca9, abi_params=[array<_, u8>], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = extract_value calldataslice, arg0, 1
    v1 = extract_value calldataslice, arg0, 0
    v2 = mul v0, 32
    v3 = eq 32, 0
    v4 = div v2, 32
    v5 = eq v4, v0
    v6 = or v3, v5
    v7 = zext i1 v6 to i256
    v8 = eq v7, 0
    icall panic_if<0x41>, v8
    v9 = calldatasize
    v10 = sub v9, v1
    v11 = slt v10, v2
    icall revert_if<calldata_tail_too_short>, v11
    v12 = mul v0, 32
    v13 = eq 32, 0
    v14 = div v12, 32
    v15 = eq v14, v0
    v16 = or v13, v15
    v17 = zext i1 v16 to i256
    v18 = eq v17, 0
    icall panic_if<0x41>, v18
    v19 = add 32, v12
    v20 = lt v19, 32
    icall panic_if<0x41>, v20
    v21 = alloc v19
    store v21, v0
    jump bb1
  bb1:
    v22 = phi [bb0: 0], [bb2: v32]
    v23 = lt v22, v0
    jumpi v23, bb2, bb3
  bb3:
    v33 = abi_encode_packed (array<word<u8>> memoryarray<1> v21)
    v34 = ptrtoint memptr v33 to i256
    v35 = add v34, 32
    v36 = load v33
    v37 = keccak256 v35, v36
    log 0, 0, 0x917e3955768d9a5bc0d702bb1332503909c320d283997932327cc32751b23fb8, v37
    v38 = extract_value calldataslice, arg0, 1
    ret v38
  bb2:
    v24 = mul v22, 32
    v25 = add v1, v24
    v26 = load calldata v25
    v27 = shr 8, v26
    v28 = eq v27, 0
    v29 = eq v28, false
    icall revert_if<empty>, v29
    v30 = shl 5, v22
    v31 = ptradd v21, v30
    store v31+32, v26
    v32 = add v22, 1
    jump bb1
}
