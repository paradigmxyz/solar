    memory_object_store_field memorystruct<1>, v7, 0, 8
    v8 = sload 0 !metadata(storage=slot(0))
    v9 = gt v8, 0xffffffffffffffff
    jumpi v9, bb1, bb3
  bb3:
    v10 = add v8, 1
    v11 = storage_array_data_slot 0
    v12 = add v11, v8
    v13 = memory_object_load_field memorystruct<1>, v7, 0
    sstore v12, v13 !metadata(storage=symbolic(v12))
    sstore 0, v10 !metadata(storage=slot(0))
    stop
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
