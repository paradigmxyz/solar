  bb4:
    v29 = slice_len arg0
    v30 = lt 1, v29
    v31 = iszero v30
    panic_if v31, 0x32
    v32 = slice_ptr arg0
    v33 = add v32, 32
    v34 = calldatasize
    v35 = sub v34, v33
