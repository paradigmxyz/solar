// Two sites encode the same `(uint256, bytes)` tuple and two more prefix it with the same
// selector. Under the size objective each pair shares one `encode_abi_tuple` helper, under
// the gas objective each site keeps its own encoder; the bytes must match either way.
contract AbiEncodeSharedTuple {
    function first(uint256 a, bytes memory b) external pure returns (bytes memory) {
        return abi.encode(a, b);
    }

    function second(uint256 a, bytes memory b) external pure returns (bytes memory) {
        return abi.encode(a, b);
    }

    function tagged(uint256 a, bytes memory b) external pure returns (bytes memory) {
        return abi.encodeWithSelector(0xaabbccdd, a, b);
    }

    function retagged(uint256 a, bytes memory b) external pure returns (bytes memory) {
        return abi.encodeWithSelector(0xaabbccdd, a, b);
    }
}
