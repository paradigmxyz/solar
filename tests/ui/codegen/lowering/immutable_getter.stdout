// === ROOT/tests/ui/codegen/lowering/immutable_getter.sol:C ===
@module C
immutables:
  owner: u256

fn @owner() -> i160 [selector=0x8da5cb5b, view, abi_params=[], abi_returns=[word<u160>], abi_return_params=[address]] {
  bb0:
    v0 = loadimmutable owner
    v1 = trunc i256 v0 to i160
    ret v1
}

fn @constructor(arg0: i160) [constructor, abi_params=[address]] {
  bb0:
    v0 = zext i160 arg0 to i256
    storeimmutable owner, v0
    ret
}
