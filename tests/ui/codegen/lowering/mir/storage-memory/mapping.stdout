; === ROOT/tests/ui/codegen/lowering/mir/storage-memory/mapping.sol:Mapping ===
@module Mapping
; getter for `mapping(uint256 => uint256) public balances` [selector 0x4903b0d1]
fn @balances(arg0: i256) -> i256 [selector=0x4903b0d1, view, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    ret v1
}

; getter for `mapping(address => mapping(address => uint256)) public allowances` [selector 0x55b6ed5c]
fn @allowances(arg0: i160, arg1: i160) -> i256 [selector=0x55b6ed5c, view, abi_params=[address, address], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = mapping_slot v0, 1
    v2 = zext i160 arg1 to i256
    v3 = mapping_slot v2, v1
    v4 = sload v3 !metadata(storage=symbolic(v3))
    ret v4
}

; function set_balance(uint256 id, uint256 amount) public [selector 0xb41d1f5c]
fn @set_balance(arg0: i256, arg1: i256) [selector=0xb41d1f5c, abi_params=[uint256, uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = mapping_slot arg0, 0
    sstore v0, arg1 !metadata(storage=symbolic(v0))
    ret
}

; function add_balance(uint256 id, uint256 amount) public [selector 0xe72cc64e]
fn @add_balance(arg0: i256, arg1: i256) [selector=0xe72cc64e, abi_params=[uint256, uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = mapping_slot arg0, 0
    v1 = sload v0 !metadata(storage=symbolic(v0))
    v2 = checked_add uint256, v1, arg1
    v3 = mapping_slot arg0, 0
    sstore v3, v2 !metadata(storage=symbolic(v3))
    ret
}

; function approve(address owner, address spender, uint256 amount) public [selector 0xe1f21c67]
fn @approve(arg0: i160, arg1: i160, arg2: i256) [selector=0xe1f21c67, abi_params=[address, address, uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = mapping_slot v0, 1
    v2 = zext i160 arg1 to i256
    v3 = mapping_slot v2, v1
    sstore v3, arg2 !metadata(storage=symbolic(v3))
    ret
}

; function get_allowance(address owner, address spender) public view returns (uint256) [selector 0x18836994]
fn @get_allowance(arg0: i160, arg1: i160) -> i256 [selector=0x18836994, view, abi_params=[address, address], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = mapping_slot v0, 1
    v2 = zext i160 arg1 to i256
    v3 = mapping_slot v2, v1
