; === ROOT/tests/ui/codegen/lowering/mir/coverage/modifier_overrides.sol:A ===
@module A
; getter for `uint256 public total` [selector 0x2ddbd13a]
fn @total() -> i256 [selector=0x2ddbd13a, view, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    ret v0
}

; function f(uint256 x) public guard(x) [selector 0xb3de648b]
fn @f(arg0: i256) [selector=0xb3de648b, abi_params=[uint256], abi_returns=[], abi_return_params=[]] {
  bb0:
    coverage 1
    coverage 2
    v0 = gt arg0, 1
    coverage 3
    jumpi v0, bb2, bb3
  bb3:                                            ; preds = bb0
    jump bb4
  bb2:                                            ; preds = bb0
    coverage 4
    jump bb4
  bb4:                                            ; preds = bb2, bb3
    v1 = eq v0, false
    icall revert_if<empty>, v1
    coverage 5
    coverage 10
    v2 = sload 0 !metadata(storage=slot(0))
    v3 = checked_add uint256, v2, arg0
    sstore 0, v3 !metadata(storage=slot(0))
    jump bb5
  bb5:                                            ; preds = bb4
    jump bb1
  bb1:                                            ; preds = bb5
    ret
}

