; function packed(uint256 x) external pure returns (bytes32) [selector 0x977eca9c]
fn @packed(arg0: i256) -> i256 [selector=0x977eca9c, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    coverage 36
    v0 = keccak256_packed (uint256 arg0)
    coverage 37
    ret v0
}
