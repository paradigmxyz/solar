  bb3:                                            ; preds = bb0
    jump bb4
  bb2:                                            ; preds = bb0
    coverage 31
    jump bb4
  bb4:                                            ; preds = bb2, bb3
    v0 = phi [bb2: i8 1], [bb3: i8 2]
    v1 = zext i8 v0 to i256
    coverage 32
    v2 = ne v1, 0
    coverage 33
    jumpi v2, bb5, bb6
  bb6:                                            ; preds = bb4
    jump bb7
  bb5:                                            ; preds = bb4
    coverage 34
    jump bb7
  bb7:                                            ; preds = bb5, bb6
    v3 = eq v2, false
    icall revert_if<empty>, v3
    coverage 35
