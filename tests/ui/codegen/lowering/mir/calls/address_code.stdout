; === ROOT/tests/ui/codegen/lowering/mir/calls/address_code.sol:AddressCode ===
@module AddressCode
; function codeLength(address account) external view returns (uint256) [selector 0xbd3736e3]
fn @codeLength(arg0: i160) -> i256 [selector=0xbd3736e3, view, abi_params=[address], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = extcodesize v0
    ret v1
}

; function codeHash(address account) external view returns (bytes32) [selector 0x3dc44827]
fn @codeHash(arg0: i160) -> i256 [selector=0x3dc44827, view, abi_params=[address], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = extcodehash v0
    ret v1
}

; function code(address account) external view returns (bytes memory) [selector 0x5b90b752]
fn @code(arg0: i160) -> ptr<memory> [selector=0x5b90b752, view, abi_params=[address], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = extcodesize v0
    v2 = add v1, 31
    v3 = and v2, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v4 = add v3, 32
    v5 = lt v4, v1
    icall panic_if<0x41>, v5
    v6 = alloc zeroed checked v4
    mstore v6, v1
    v7 = ptradd v6, 32
    v8 = zext i160 arg0 to i256
    extcodecopy v8, v7, 0, v1 !metadata(memory=heap)
    ret v6
}

; function addressFromBytes20(bytes20 value) external pure returns (address) [selector 0x247e14fa]
fn @addressFromBytes20(arg0: i256) -> i160 [selector=0x247e14fa, pure, abi_params=[bytes20], abi_returns=[word<uint160>], abi_return_params=[address]] {
  bb0:
    v0 = shr arg0, 96
    v1 = trunc i256 v0 to i160
    ret v1
}

; function callerCodeLength() external view returns (uint256) [selector 0xfb7e2a0a]
fn @callerCodeLength() -> i256 [selector=0xfb7e2a0a, view, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = caller
    v1 = zext i160 v0 to i256
    v2 = extcodesize v1
    ret v2
}
