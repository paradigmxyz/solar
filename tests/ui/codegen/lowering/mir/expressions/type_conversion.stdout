; === ROOT/tests/ui/codegen/lowering/mir/expressions/type_conversion.sol:TypeConversion ===
@module TypeConversion
; function narrowAddress(address asset) public pure returns (uint16) [selector 0xaf290423]
fn @narrowAddress(arg0: i160) -> i16 [selector=0xaf290423, pure, abi_params=[address], abi_returns=[word<uint16>], abi_return_params=[uint16]] {
  bb0:
    v0 = trunc i160 arg0 to i16
    ret v0
}

