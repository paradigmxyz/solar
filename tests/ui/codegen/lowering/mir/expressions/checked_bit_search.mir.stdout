; function fls(uint256 x) internal pure returns (uint256 r)
fn @fls.3(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    v1 = shr arg0, 128
    v2 = ne v1, 0
    jumpi v2, bb4, bb5
  bb5:                                            ; preds = bb3
    jump bb6
  bb4:                                            ; preds = bb3
    v3 = shr arg0, 128
    v4 = assign 128
    jump bb6
  bb6:                                            ; preds = bb4, bb5
    v5 = phi [bb4: v3], [bb5: arg0]
    v6 = phi [bb4: v4], [bb5: 0]
    v7 = shr v5, 64
    v8 = ne v7, 0
    jumpi v8, bb7, bb8
  bb8:                                            ; preds = bb6
    jump bb9
  bb7:                                            ; preds = bb6
    v9 = shr v5, 64
    v10 = or v6, 64
    jump bb9
  bb9:                                            ; preds = bb7, bb8
    v11 = phi [bb7: v9], [bb8: v5]
    v12 = phi [bb7: v10], [bb8: v6]
    v13 = shr v11, 32
    v14 = ne v13, 0
    jumpi v14, bb10, bb11
  bb11:                                           ; preds = bb9
    jump bb12
  bb10:                                           ; preds = bb9
    v15 = shr v11, 32
    v16 = or v12, 32
    jump bb12
  bb12:                                           ; preds = bb10, bb11
    v17 = phi [bb10: v15], [bb11: v11]
    v18 = phi [bb10: v16], [bb11: v12]
    v19 = shr v17, 16
    v20 = ne v19, 0
    jumpi v20, bb13, bb14
  bb14:                                           ; preds = bb12
    jump bb15
  bb13:                                           ; preds = bb12
    v21 = shr v17, 16
    v22 = or v18, 16
    jump bb15
  bb15:                                           ; preds = bb13, bb14
    v23 = phi [bb13: v21], [bb14: v17]
    v24 = phi [bb13: v22], [bb14: v18]
    v25 = shr v23, 8
    v26 = ne v25, 0
    jumpi v26, bb16, bb17
  bb17:                                           ; preds = bb15
    jump bb18
  bb16:                                           ; preds = bb15
    v27 = shr v23, 8
    v28 = or v24, 8
    jump bb18
  bb18:                                           ; preds = bb16, bb17
    v29 = phi [bb16: v27], [bb17: v23]
    v30 = phi [bb16: v28], [bb17: v24]
    v31 = shr v29, 4
    v32 = ne v31, 0
    jumpi v32, bb19, bb20
  bb20:                                           ; preds = bb18
    jump bb21
  bb19:                                           ; preds = bb18
    v33 = shr v29, 4
    v34 = or v30, 4
    jump bb21
  bb21:                                           ; preds = bb19, bb20
    v35 = phi [bb19: v33], [bb20: v29]
    v36 = phi [bb19: v34], [bb20: v30]
    v37 = shr v35, 2
    v38 = ne v37, 0
    jumpi v38, bb22, bb23
  bb23:                                           ; preds = bb21
    jump bb24
  bb22:                                           ; preds = bb21
    v39 = shr v35, 2
    v40 = or v36, 2
    jump bb24
  bb24:                                           ; preds = bb22, bb23
    v41 = phi [bb22: v39], [bb23: v35]
    v42 = phi [bb22: v40], [bb23: v36]
    v43 = shr v41, 1
    v44 = or v43, v42
    ret v44
  bb1:                                            ; preds = bb0
    ret 256
}

; function clz(uint256 x) internal pure returns (uint256 r)
fn @clz.4(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    v1 = icall @fls.3, arg0
    v2 = checked_sub uint256, 255, v1
    jump bb3
  bb1:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v3 = phi [bb1: 256], [bb2: v2]
    ret v3
}

; function ffs(uint256 x) internal pure returns (uint256 r)
fn @ffs.5(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    v1 = not arg0
    v2 = checked_add uint256, v1, 1
    v3 = and v2, arg0
    v4 = icall @fls.3, v3
    jump bb3
  bb1:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v5 = phi [bb1: 256], [bb2: v4]
    ret v5
}
