; === ROOT/tests/ui/codegen/lowering/mir/expressions/loop_checked_helper.sol:LoopCheckedHelper ===
@module LoopCheckedHelper
; function checkedAdd(uint256 a, uint256 b) internal pure returns (uint256 c)
fn @checkedAdd(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = add arg0, arg1
    v1 = lt v0, arg0
    jumpi v1, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    icall @panicArithmetic
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    ret v0
}

; function panicArithmetic() internal pure
fn @panicArithmetic() [pure] {
  bb0:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 17 !metadata(memory=scratch)
    revert 0, 36
}

; function accumulate(uint256 n, uint256 seed) public pure returns (uint256 acc) [selector 0x4256913b]
fn @accumulate(arg0: i256, arg1: i256) -> i256 [selector=0x4256913b, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = gt arg0, 0x3e8
    v1 = eq v0, false
    v2 = eq v1, false
    icall revert_if<empty>, v2
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v3 = phi [bb0: arg0], [bb3: v3]
    v4 = phi [bb0: arg1], [bb3: v4]
    v5 = phi [bb0: arg1], [bb3: v8]
    v6 = phi [bb0: 0], [bb3: v9]
    v7 = lt v6, v3
    jumpi v7, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v5
  bb4:                                            ; preds = bb1
    v8 = icall @checkedAdd, v5, v6
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v9 = icall @checkedAdd, v6, 1
    jump bb1
}

; function add(uint256 a, uint256 b) public pure returns (uint256) [selector 0x771602f7]
fn @add(arg0: i256, arg1: i256) -> i256 [selector=0x771602f7, pure, abi_params=[uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @checkedAdd, arg0, arg1
    ret v0
}
