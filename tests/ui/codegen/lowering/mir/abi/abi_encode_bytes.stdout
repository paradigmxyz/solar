; === ROOT/tests/ui/codegen/lowering/mir/abi/abi_encode_bytes.sol:AbiEncodeBytes ===
@module AbiEncodeBytes
; function hash3(uint a, uint b, uint c) external pure returns (bytes32) [selector 0x2dbf86c6]
fn @hash3(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0x2dbf86c6, pure, abi_params=[uint256, uint256, uint256], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    v0 = abi_encode [word, word, word], scratch, args arg0, arg1, arg2
    v1 = extract_value slice<memory>, v0, 0
    v2 = extract_value slice<memory>, v0, 1
    v3 = keccak256 v1, v2
    ret v3
}

; function encode3(uint a, uint b, uint c) external pure returns (bytes memory) [selector 0x536b260f]
fn @encode3(arg0: i256, arg1: i256, arg2: i256) -> ptr<memory> [selector=0x536b260f, pure, abi_params=[uint256, uint256, uint256], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = abi_encode [word, word, word], object, args arg0, arg1, arg2
    ret v0
}

; function encodeDynamic(uint a, string memory s) external pure returns (bytes memory) [selector 0x925bff47]
fn @encodeDynamic(arg0: i256, arg1: ptr<memory>) -> ptr<memory> [selector=0x925bff47, pure, abi_params=[uint256, bytes], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = abi_encode [word, memory_bytes], object, args arg0, arg1
    ret v0
}

; function hashDynamic(uint a, string memory s) external pure returns (bytes32) [selector 0xf58325b2]
fn @hashDynamic(arg0: i256, arg1: ptr<memory>) -> i256 [selector=0xf58325b2, pure, abi_params=[uint256, bytes], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    v0 = abi_encode [word, memory_bytes], scratch, args arg0, arg1
    v1 = extract_value slice<memory>, v0, 0
    v2 = extract_value slice<memory>, v0, 1
    v3 = keccak256 v1, v2
    ret v3
}

; function roundtrip(uint a) external pure returns (uint) [selector 0x33cddcf6]
fn @roundtrip(arg0: i256) -> i256 [selector=0x33cddcf6, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = abi_encode [word], object, args arg0
    v1 = abi_decode [uint256], v0
    ret v1
}
