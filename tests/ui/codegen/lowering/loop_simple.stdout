// === ROOT/tests/ui/codegen/lowering/loop_simple.sol:LoopSimple ===
@module LoopSimple
fn @sum_to(arg0: u256) -> u256 [selector=0xab225c69, pure, abi_params=[u256], abi_returns=[word]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb3: v6]
    v1 = phi [bb0: arg0], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v5]
    v3 = phi [bb0: 0], [bb3: v3]
    v4 = lt v0, v1
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v2
  bb4:
    v5 = checked_add u256, v2, v0
    jump bb6
  bb6:
    jump bb3
  bb3:
    v6 = checked_add u256, v0, 1
    jump bb1
}
