// === ROOT/tests/ui/codegen/lowering/loop_simple.sol:LoopSimple ===
@module LoopSimple
fn @sum_to(arg0: u256) -> u256 [abi_args=lazy, abi_params=[u256], abi_returns=[word]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: 0], [bb5: v6]
    v1 = phi [bb0: arg0], [bb5: v1]
    v2 = phi [bb0: 0], [bb5: v5]
    v3 = phi [bb0: 0], [bb5: v3]
    v4 = lt v0, v1
    jumpi v4, bb3, bb4
  bb2:
    ret v2
  bb3:
    v5 = add v2, v0
    v6 = add v0, 1
    jump bb5
  bb4:
    jump bb2
  bb5:
    jump bb1
}

