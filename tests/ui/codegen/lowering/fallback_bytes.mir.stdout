// === ROOT/tests/ui/codegen/lowering/fallback_bytes.sol:FallbackBytes ===
@module FallbackBytes
@types
  struct0: {i256, i256}

fn @invoke(arg0: ptr<memory>) -> struct0 [selector=0xa6514259, abi_params=[bytes], abi_returns=[word, word], abi_return_params=[uint256, bytes32]] {
  bb0:
    v0 = address
    v1 = gas
    v2 = address_call v0, arg0, gas v1
    v3 = icall returndata_bytes<>
    v4 = eq v2, false
    icall revert_if<empty>, v4
    v5 = mload v3
    v6 = ptradd v3, 32
    v7 = mload v3
    v8 = keccak256 v6, v7
    v9 = insert_value struct0, undef struct0, 0, v5
    v10 = insert_value struct0, v9, 1, v8
    ret v10
}

fn @fallback(arg0: slice<calldata>) -> ptr<memory> [fallback] {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 1
    v1 = add v0, 63
    v2 = and v1, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v3 = alloc v2
    mstore v3, v0
    v4 = ptradd v3, 32
    v5 = extract_value slice<calldata>, arg0, 0
    v6 = extract_value slice<calldata>, arg0, 1
    calldatacopy v4, v5, v6
    ret v3
}
