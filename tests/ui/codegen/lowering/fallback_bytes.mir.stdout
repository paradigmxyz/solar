// === ROOT/tests/ui/codegen/lowering/fallback_bytes.sol:FallbackBytes ===
@module FallbackBytes
@types
  struct0: {i256, i256}

fn @invoke(arg0: memptr) -> struct0 [selector=0xa6514259, abi_params=[bytes], abi_returns=[word, word], abi_return_params=[u256, bytes32]] {
  bb0:
    v0 = address
    v1 = gas
    v2 = address_call v0, arg0, gas v1
    v3 = icall returndata_bytes<>
    v4 = eq v2, false
    icall revert_if<empty>, v4
    v5 = load v3
    v6 = ptrtoint memptr v3 to i256
    v7 = add v6, 32
    v8 = load v3
    v9 = keccak256 v7, v8
    v10 = insert_value struct0, undef struct0, 0, v5
    v11 = insert_value struct0, v10, 1, v9
    ret v11
}

fn @fallback(arg0: calldataslice) -> memptr [fallback] {
  bb0:
    v0 = extract_value calldataslice, arg0, 0
    v1 = extract_value calldataslice, arg0, 1
    v2 = calldatasize
    v3 = gt v1, 0xffffffffffffffff
    icall revert_if<invalid_calldata_tail_length>, v3
    v4 = sub v2, v1
    v5 = sgt v0, v4
    icall revert_if<calldata_tail_too_short>, v5
    v6 = extract_value calldataslice, arg0, 1
    v7 = add v6, 63
    v8 = lt v7, v6
    icall panic_if<0x41>, v8
    v9 = not 31
    v10 = and v7, v9
    v11 = alloc v10
    store v11, v6
    v12 = ptradd v11, 32
    v13 = extract_value calldataslice, arg0, 0
    v14 = extract_value calldataslice, arg0, 1
    copy calldata v12, v13, v14
    ret v11
}
