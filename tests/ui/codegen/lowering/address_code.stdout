fn @code(arg0: i160) -> memorybytes [selector=0x5b90b752, view, abi_params=[address], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = zext i160 arg0 to i256
    v1 = extcodesize v0
    v2 = add v1, 63
