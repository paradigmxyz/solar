// === ROOT/tests/ui/codegen/lowering/stack_only_rematerialization.sol:StackOnlyRematerialization ===
@module StackOnlyRematerialization
; function first(bool selectFirst) external pure returns (uint256) [selector 0x6c94fb44]
fn @first(arg0: i1) -> i256 [selector=0x6c94fb44, pure, abi_params=[bool], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @storeAtDerivedAddress, 256, arg0
    ret v0
}

; function second(bool selectFirst) external pure returns (uint256) [selector 0xc04a1ee8]
fn @second(arg0: i1) -> i256 [selector=0xc04a1ee8, pure, abi_params=[bool], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @storeAtDerivedAddress, 288, arg0
    ret v0
}

; function storeAtDerivedAddress(uint256 base, bool selectFirst) internal pure returns (uint256 result)
fn @storeAtDerivedAddress(arg0: i256, arg1: i1) -> i256 [pure] {
  bb0:
    v0 = add arg0, 32
    jumpi arg1, bb1, bb2
  bb2:  ; preds = bb0
    jump bb3
  bb1:  ; preds = bb0
    jump bb3
  bb3:  ; preds = bb1, bb2
    v1 = phi [bb1: 7], [bb2: 8]
    mstore v0, v1
    v2 = mload v0
    ret v2
}
