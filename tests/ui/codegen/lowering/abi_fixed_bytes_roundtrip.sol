contract AbiFixedBytesRoundtrip {
    struct Packet {
        bytes12 id;
        bytes4 selector;
        bytes16 tag;
        uint256 amount;
    }

    Packet saved;

    function bare(bytes12 id) external pure returns (bytes12) {
        return id;
    }

    function roundTrip(Packet memory packet) external pure returns (Packet memory) {
        Packet memory copy = Packet(packet.id, packet.selector, packet.tag, packet.amount);
        return copy;
    }

    function store(Packet memory packet) external returns (Packet memory) {
        saved = packet;
        Packet memory copy = saved;
        return copy;
    }

    function retag(Packet memory packet, bytes16 tag) external pure returns (Packet memory) {
        Packet memory copy = Packet(packet.id, packet.selector, tag, packet.amount);
        return copy;
    }
}
