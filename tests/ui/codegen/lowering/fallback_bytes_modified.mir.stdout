; === ROOT/tests/ui/codegen/lowering/fallback_bytes_modified.sol:ModifiedFallbackBytes ===
@module ModifiedFallbackBytes
; fallback(bytes calldata input) external returns (bytes memory) [fallback]
fn @fallback(arg0: slice<calldata>) -> ptr<memory> [fallback] {
  bb0:
    v0 = calldataload 0
    v1 = ne v0, 0
    jumpi v1, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb1:                                            ; preds = bb0
    v2 = extract_value slice<calldata>, arg0, 1
    v3 = inttoptr i256 v0 to ptr<calldata>
    v4 = make_calldata_slice v3, v2
    jump bb3
  bb3:                                            ; preds = bb1, bb2
    v5 = phi [bb1: v4], [bb2: arg0]
    v6 = calldataload 32
    v7 = extract_value slice<calldata>, v5, 0
    v8 = make_calldata_slice v7, v6
    v9 = extract_value slice<calldata>, v8, 1
    v10 = add v9, 31
    v11 = and v10, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v12 = add v11, 32
    v13 = lt v12, v9
    icall panic_if<0x41>, v13
    v14 = alloc v12
    mstore v14, v9
    v15 = extract_value slice<calldata>, v8, 0
    v16 = extract_value slice<calldata>, v8, 1
    v17 = calldatasize
    v18 = gt v16, 0xffffffffffffffff
    icall revert_if<invalid_calldata_tail_length>, v18
    v19 = sub v17, v16
    v20 = ptrtoint ptr<calldata> v15 to i256
    v21 = slt v19, v20
    icall revert_if<calldata_tail_too_short>, v21
    v22 = ptradd v14, 32
    v23 = extract_value slice<calldata>, v8, 0
    v24 = extract_value slice<calldata>, v8, 1
    calldatacopy v22, v23, v24
    ret v14
}

; function invoke(uint256 offset, uint256 length) external returns (bytes memory) [selector 0x33298e25]
fn @invoke(arg0: i256, arg1: i256) -> ptr<memory> [selector=0x33298e25, abi_params=[uint256, uint256], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = address
    v1 = gas
    v2 = abi_encode [word, word], object, args arg0, arg1
    v3 = address_call v0, v2, gas v1
    v4 = icall returndata_bytes<>
    v5 = eq v3, false
    icall revert_if<empty>, v5
    ret v4
}
