; function repeatFalse() external repeat(false) returns (uint256 result) [selector 0x39a40f90]
fn @repeatFalse() -> i256 [selector=0x39a40f90, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jumpi false, bb2, bb3
  bb3:  ; preds = bb0
    jump bb4
  bb2:  ; preds = bb0
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = checked_add uint256, v0, 1
    v2 = checked_add uint256, 0, v1
    sstore 0, v2 !metadata(storage=slot(0))
    jump bb5
  bb5:  ; preds = bb2
    jump bb4
  bb4:  ; preds = bb5, bb3
    v3 = phi [bb5: v2], [bb3: 0]
    v4 = sload 0 !metadata(storage=slot(0))
    v5 = checked_add uint256, v4, 1
    v6 = checked_add uint256, 0, v5
    sstore 0, v6 !metadata(storage=slot(0))
    jump bb6
  bb6:  ; preds = bb4
    jump bb1
  bb1:  ; preds = bb6
    ret v6
}

