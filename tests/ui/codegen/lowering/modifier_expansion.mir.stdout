@module ModifierExpansion
; function value() external around returns (uint256) [selector 0x3fa4f245]
fn @value() -> i256 [selector=0x3fa4f245, abi_params=[], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = sload 0 !metadata(storage=slot(0))
    v1 = checked_add uint256, v0, 1
    sstore 0, v1 !metadata(storage=slot(0))
    v2 = sload 0 !metadata(storage=slot(0))
    jump bb2
  bb2:  ; preds = bb0
    v3 = sload 0 !metadata(storage=slot(0))
    v4 = checked_add uint256, v3, 2
    sstore 0, v4 !metadata(storage=slot(0))
    jump bb1
  bb1:  ; preds = bb2
    ret v2
}

