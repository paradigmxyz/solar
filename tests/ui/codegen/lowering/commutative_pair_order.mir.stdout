// === ROOT/tests/ui/codegen/lowering/commutative_pair_order.sol:CommutativePairOrder ===
@module CommutativePairOrder
; function mulmodPair(uint256, uint256, uint256) external pure returns (uint256 r) [selector 0x077c99b8]
fn @mulmodPair(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0x077c99b8, pure, abi_params=[uint256, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = calldataload 68
    v1 = calldataload 4
    v2 = add v1, 1
    v3 = calldataload 36
    v4 = add v3, 2
    v5 = mulmod v2, v4, v0
    v6 = mulmod v5, v2, v0
    mstore 0, v4 !metadata(memory=scratch)
    mstore 32, v0 !metadata(memory=scratch)
    ret v6
}

; function addmodPair(uint256, uint256, uint256) external pure returns (uint256 r) [selector 0x681cd3a4]
fn @addmodPair(arg0: i256, arg1: i256, arg2: i256) -> i256 [selector=0x681cd3a4, pure, abi_params=[uint256, uint256, uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = calldataload 68
    v1 = calldataload 4
    v2 = add v1, 1
    v3 = calldataload 36
    v4 = add v3, 2
    v5 = addmod v2, v4, v0
    v6 = addmod v5, v2, v0
    mstore 0, v4 !metadata(memory=scratch)
    mstore 32, v0 !metadata(memory=scratch)
