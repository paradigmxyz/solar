fn @doAdd() [selector=0xe9148a2a, public, pure, external_static_return_size=32, arg_types=(i256, i256)] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 64
    jumpi v2, bb1, bb2
  bb2:
    v3 = internal_call @add, 1, arg0, arg1
    mstore 128, v3
    returndata 128, 32
  bb1:
    revert 0, 0
}

fn @add(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = add arg0, arg1
    v1 = slt arg0, 0
    v2 = slt v0, arg1
    v3 = xor v1, v2
    jumpi v3, bb1, bb2
  bb2:
    ret v0
  bb1:
    tail_call @__revert_stub0
}

fn @doNeg() [selector=0x8fa81b4e, public, pure, external_static_return_size=32, arg_types=(i256)] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb2:
    v3 = internal_call @neg, 1, arg0
    mstore 128, v3
    returndata 128, 32
  bb1:
