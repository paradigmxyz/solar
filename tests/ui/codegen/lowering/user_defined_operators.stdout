fn @entry() [entry] {
  bb0:
    v0 = callvalue
    jumpi v0, bb5, bb1
  bb1:
    v1 = calldataload 0
    v2 = shr 224, v1
    switch v2, default bb5, [0x7cf9d6d4 => bb2, 0x8fa81b4e => bb3, 0xe9148a2a => bb4]
  bb4:
    tail_call @doAdd
  bb3:
    tail_call @doNeg
