@module LiveBranchCondition
fn @next(arg0: u256) -> u256 [selector=0xedd004e5, pure, abi_params=[u256], abi_returns=[word]] {
  bb0:
    v0 = add arg0, 1
    v1 = lt v0, arg0
    jumpi v1, bb1, bb2
  bb2:
    ret v0
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 17 !metadata(memory=scratch)
    revert 0, 36
}

fn @both(arg0: u256) -> u256 [selector=0x75de2d6b, pure, abi_params=[u256], abi_returns=[word]] {
  bb0:
    switch arg0, default bb3, [0 => bb2]
  bb2:
    v0 = add arg0, 7
    jump bb1
  bb3:
    v1 = add arg0, 9
    jump bb1
  bb1:
    v2 = phi [bb2: v0], [bb3: v1]
    ret v2
}
