// === ROOT/tests/ui/codegen/lowering/live_branch_condition.sol:LiveBranchCondition ===
@module LiveBranchCondition
fn @next(arg0: i256) -> i256 [selector=0xedd004e5, pure, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = checked_add u256, arg0, 1
    ret v0
}

fn @both(arg0: i256) -> i256 [selector=0x75de2d6b, pure, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    switch arg0, default bb3, [0 => bb2]
  bb2:
    v0 = add arg0, 7
    jump bb1
  bb3:
    v1 = add arg0, 9
    jump bb1
  bb1:
    v2 = phi [bb2: v0], [bb3: v1]
    ret v2
}

// === ROOT/tests/ui/codegen/lowering/live_branch_condition.sol:ReturndataBranch ===
@module ReturndataBranch
fn @test(arg0: i256) [selector=0x29e99f07, view, abi_params=[u256], abi_returns=[word], abi_return_params=[u256]] {
  bb0:
    v0 = gas
    v1 = staticcall v0, 4, 0, arg0, 0, 0
    v2 = zext i1 v1 to i256
    v3 = eq v2, 0
    v4 = zext i1 v3 to i256
    v5 = ne v4, 0
    jumpi v5, bb1, bb2
  bb2:
    jump bb3
  bb3:
    v6 = returndatasize
    v7 = gt v6, 0
    v8 = zext i1 v7 to i256
    v9 = ne v8, 0
    jumpi v9, bb4, bb5
  bb5:
    jump bb6
  bb6:
    store 0, 9 !metadata(memory=scratch)
    returndata 0, 32
  bb4:
    store 0, 7 !metadata(memory=scratch)
    returndata 0, 32
  bb1:
    revert 0, 0
}

// === ROOT/tests/ui/codegen/lowering/live_branch_condition.sol:ReloadableBranch ===
@module ReloadableBranch
@types
  struct0: {i256, i1}

fn @aggregate(arg0: i1, arg1: i256) -> struct0 [selector=0xb22b6a9f, pure, abi_params=[bool, u256], abi_returns=[word, word<bool>], abi_return_params=[u256, bool]] {
  bb0:
    v0 = alloc memorystruct<2>, exact, uninitialized, infallible, 64 !metadata(preserves_fmp)
    v1 = make_memory_slice v0, 2
    slice_store_word v1, 0, 0
    slice_store_word v1, 32, 0
    jumpi arg0, bb1, bb2
  bb2:
    v3 = make_memory_slice v0, 2
    slice_store_word v3, 0, 11
    jump bb3
  bb1:
    v2 = make_memory_slice v0, 2
    slice_store_word v2, 0, 7
    jump bb3
  bb3:
    jump bb4
  bb4:
    v4 = phi [bb3: 0], [bb6: v19]
    v5 = phi [bb3: arg0], [bb6: v5]
    v6 = phi [bb3: v0], [bb6: v6]
    v7 = phi [bb3: 0], [bb6: v7]
    v8 = phi [bb3: arg1], [bb6: v8]
    v9 = phi [bb3: 0], [bb6: v9]
    v10 = lt v4, v8
    jumpi v10, bb7, bb8
  bb8:
    jump bb5
  bb5:
    v20 = make_memory_slice v6, 2
    v21 = slice_load_word v20, 32
    v22 = insert_value struct0, undef struct0, 0, v21
    v23 = insert_value struct0, v22, 1, v5
    ret v23
  bb7:
    v11 = make_memory_slice v6, 2
    v12 = slice_load_word v11, 0
    v13 = checked_add u256, v12, v4
    slice_store_word v11, 0, v13
    v14 = make_memory_slice v6, 2
    v15 = slice_load_word v14, 0
    v16 = make_memory_slice v6, 2
    v17 = slice_load_word v16, 32
    v18 = checked_add u256, v17, v15
    slice_store_word v16, 32, v18
    jump bb9
  bb9:
    jump bb6
  bb6:
    v19 = checked_add u256, v4, 1
    jump bb4
}
