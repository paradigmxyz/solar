; === ROOT/tests/ui/codegen/lowering/abi_encode_semantic.sol:AbiEncodeSemantic ===
@module AbiEncodeSemantic
; function forward(Sink sink, uint256 value, bytes calldata data) external [selector 0xd7f31eb9]
fn @forward(arg0: i160, arg1: i256, arg2: slice<calldata>) [selector=0xd7f31eb9, abi_params=[address, uint256, bytes], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = gas
    v1 = abi_encode [word, calldata_bytes], scratch, selector 0x37650e7800000000000000000000000000000000000000000000000000000000, args arg1, arg2
    v2 = extract_value slice<memory>, v1, 0
    v3 = extract_value slice<memory>, v1, 1
    v4 = zext i160 arg0 to i256
    v5 = extcodesize v4
    v6 = eq v5, 0
    icall revert_if<target_contract_has_no_code>, v6
    v7 = zext i160 arg0 to i256
    v8 = call v0, v7, 0, v2, v3, 0, 0
    jumpi v8, bb2, bb1
  bb1:                                            ; preds = bb0
    revert_returndata
  bb2:                                            ; preds = bb0
    ret
}

; function forwardNarrow(Sink sink, uint8[] calldata data) external [selector 0x251c2c33]
fn @forwardNarrow(arg0: i160, arg1: slice<calldata>) [selector=0x251c2c33, abi_params=[address, array<_, uint8>], abi_returns=[], abi_return_params=[]] {
  bb0:
    v0 = gas
    v1 = abi_encode [calldata_array<word<uint8>>], scratch, selector 0xd55990ff00000000000000000000000000000000000000000000000000000000, args arg1
    v2 = extract_value slice<memory>, v1, 0
    v3 = extract_value slice<memory>, v1, 1
    v4 = zext i160 arg0 to i256
    v5 = extcodesize v4
    v6 = eq v5, 0
    icall revert_if<target_contract_has_no_code>, v6
    v7 = zext i160 arg0 to i256
    v8 = call v0, v7, 0, v2, v3, 0, 0
    jumpi v8, bb2, bb1
  bb1:                                            ; preds = bb0
    revert_returndata
  bb2:                                            ; preds = bb0
    ret
}
