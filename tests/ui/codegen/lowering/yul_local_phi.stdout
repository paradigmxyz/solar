// === ROOT/tests/ui/codegen/lowering/yul_local_phi.sol:YulLocalPhi ===
@module YulLocalPhi
fn @branchLocal(arg0: u256) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    frame_store scratch, word, 0, 0 !metadata(memory=scratch)
    frame_store scratch, word, 32, 1 !metadata(memory=scratch)
    v0 = eq arg0, 0
    v1 = iszero v0
    jumpi v1, bb1, bb2
  bb1:
    frame_store scratch, word, 32, 2 !metadata(memory=scratch)
    jump bb2
  bb2:
    v2 = frame_load scratch, word, 32 !metadata(memory=scratch)
    frame_store scratch, word, 0, v2 !metadata(memory=scratch)
    v3 = frame_load scratch, word, 0 !metadata(memory=scratch)
    ret v3
}

