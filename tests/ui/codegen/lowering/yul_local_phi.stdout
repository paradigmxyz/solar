@module YulLocalPhi
fn @branchLocal(arg0: u256) -> u256 [abi_args=lazy, abi_params=[u256], abi_returns=[word]] {
  bb0:
    v0 = eq arg0, 0
    v1 = iszero v0
    jumpi v1, bb1, bb2
  bb1:
    jump bb3
  bb2:
    jump bb3
  bb3:
    v2 = phi [bb1: 2], [bb2: 1]
    ret v2
}

