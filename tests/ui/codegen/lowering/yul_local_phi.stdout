@module YulLocalPhi
fn @branchLocal(arg0: u256) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    mstore 128, 0
    mstore 160, 1
    v0 = eq arg0, 0
    v1 = iszero v0
    jumpi v1, bb1, bb2
  bb1:
    mstore 160, 2
    jump bb2
  bb2:
    v2 = mload 160
    mstore 128, v2
    v3 = mload 128
    ret v3
}

