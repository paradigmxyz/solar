  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    mstore 128, 0
    mstore 160, 1
    v4 = eq arg0, 0
