; === ROOT/tests/ui/codegen/lowering/stack-resident/recursion.sol:Recursion ===
@module Recursion
; function fact(uint256 n) external pure returns (uint256) [selector 0x0b95d228]
fn @fact(arg0: i256) -> i256 [selector=0x0b95d228, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @factorial, arg0
    ret v0
}

; function total(uint256 n) external pure returns (uint256) [selector 0xb119ebfe]
fn @total(arg0: i256) -> i256 [selector=0xb119ebfe, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sum, arg0, 0
    ret v0
}

; function factorial(uint256 n) internal pure returns (uint256)
fn @factorial(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = gt arg0, 1
    v1 = eq v0, false
    jumpi v1, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    v2 = checked_sub uint256, arg0, 1
    v3 = icall @factorial, v2
    v4 = checked_mul uint256, arg0, v3
    ret v4
  bb1:                                            ; preds = bb0
    ret 1
}

; function sum(uint256 n, uint256 acc) internal pure returns (uint256)
fn @sum(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb2:                                            ; preds = bb0
    jump bb3
  bb3:                                            ; preds = bb2
    v1 = sub arg0, 1
    v2 = add arg1, arg0
    v3 = icall @sum, v1, v2
    ret v3
  bb1:                                            ; preds = bb0
    ret arg1
}
