@module ProductSlot
; function factorial(uint256 n) external pure returns (uint256 result) [selector 0x83714834]
fn @factorial(arg0: i256) -> i256 [selector=0x83714834, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: 1], [bb3: v5]
    v2 = phi [bb0: 2], [bb3: v6]
    v3 = lt v0, v2
    v4 = eq v3, false
    jumpi v4, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v1
  bb4:                                            ; preds = bb1
    v5 = checked_mul uint256, v1, v2
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v6 = checked_add uint256, v2, 1
    jump bb1
}
