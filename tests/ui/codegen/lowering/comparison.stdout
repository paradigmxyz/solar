// === ROOT/tests/ui/codegen/lowering/comparison.sol:Comparison ===
@module Comparison
fn @eq(arg0: u256, arg1: u256) -> bool [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 64
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = eq arg0, arg1
    ret v4
}

fn @lt(arg0: u256, arg1: u256) -> bool [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 64
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = lt arg0, arg1
    ret v4
}

fn @is_zero(arg0: u256) -> bool [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = calldatasize
    v4 = eq arg0, 0
    ret v4
}

