    internal_call @__clear_storage_words, 0, 1, v61, v56
    jump bb23
  bb23:
    jumpi v60, bb24, bb25
  bb24:
    v64 = memory_slice_load_word memory, v53, 0
    v65 = sub 32, v51
    v66 = mul v65, 8
    v67 = shl v66, 1
    v68 = sub v67, 1
    v69 = not v68
    v70 = and v64, v69
    v71 = mul v51, 2
    v72 = or v70, v71
    sstore 1, v72 !metadata(storage=slot(1))
    jump bb26
  bb25:
    v73 = shl 1, v51
    v74 = or v73, 1
    sstore 1, v74 !metadata(storage=slot(1))
    v75 = storage_array_data_slot 1
    jump bb27
  bb26:
    jump bb1
  bb27:
    v76 = phi [bb25: 0], [bb28: v81]
    v77 = lt v76, v59
    jumpi v77, bb28, bb29
  bb28:
    v78 = mul v76, 32
    v79 = memory_slice_load_word memory, v53, v78
    v80 = add v75, v76
    sstore v80, v79 !metadata(storage=symbolic(v80))
    v81 = add v76, 1
    jump bb27
  bb29:
    jump bb26
}

fn @__clear_storage_words(arg0: u256, arg1: u256, arg2: u256) {
  bb0:
    v0 = storage_array_data_slot arg0
    jump bb1
  bb1:
    v1 = phi [bb0: arg1], [bb2: v4]
    v2 = lt v1, arg2
    jumpi v2, bb2, bb3
  bb2:
    v3 = add v0, v1
    sstore v3, 0 !metadata(storage=symbolic(v3))
    v4 = add v1, 1
    jump bb1
  bb3:
    stop
}

