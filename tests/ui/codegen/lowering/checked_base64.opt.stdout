    switch v7, default bb1, [0x12496a1b => bb3, 0x2dba772b => bb4, 0x3d92c956 => bb5, 0x49145c91 => bb6]
  bb6:
    tail_call @decode.0
  bb5:
    tail_call @encodeNoPadding
  bb4:
    tail_call @encodeFileSafe
  bb3:
    tail_call @encode.1
  bb1:
    revert 0, 0
}

fn @alloc(arg0: i256) -> i256 {
  bb0:
    v0 = mload 64 !metadata(memory=scratch, alloc_ptr)
    v2 = add v0, arg0 !metadata(alloc_ptr)
    v3 = lt v2, v0
    v4 = gt v2, 0xffffffffffffffff
    v5 = or v3, v4
    jumpi v5, bb1, bb2
  bb2:
    mstore 64, v2 !metadata(memory=scratch)
    ret v0
  bb1:
    mstore 32, 65 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
}
