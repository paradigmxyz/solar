// === ROOT/tests/ui/codegen/lowering/yul_low_level_builtins.sol:YulLowLevelBuiltins ===
@module YulLowLevelBuiltins
fn @leadingZeros(arg0: u256) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    frame_store scratch, word, 0, 0 !metadata(memory=scratch)
    v0 = clz arg0
    frame_store scratch, word, 0, v0 !metadata(memory=scratch)
    v1 = frame_load scratch, word, 0 !metadata(memory=scratch)
    ret v1
}

fn @callCode(arg0: address) -> u256 [abi_args=lazy, abi_returns=[word]] {
  bb0:
    frame_store scratch, word, 0, 0 !metadata(memory=scratch)
    v0 = gas
    v1 = callcode v0, arg0, 0, 0, 0, 0, 0
    frame_store scratch, word, 0, v1 !metadata(memory=scratch)
    v2 = frame_load scratch, word, 0 !metadata(memory=scratch)
    ret v2
}

fn @safeCall(arg0: address, arg1: bytes4) -> bool [abi_args=lazy, abi_returns=[word]] {
  bb0:
    frame_store scratch, word, 0, 0 !metadata(memory=scratch)
    v0 = mload 64 !metadata(memory=scratch)
    mstore 0, arg1 !metadata(memory=scratch)
    v1 = gas
    v2 = call v1, arg0, 0, 0, 4, 0, 32
    frame_store scratch, word, 0, v2 !metadata(memory=scratch)
    v3 = frame_load scratch, word, 0 !metadata(memory=scratch)
    v4 = mload 0 !metadata(memory=scratch)
    v5 = eq v4, 1
    v6 = and v3, v5
    v7 = iszero v6
    v8 = eq v7, 0
    v9 = iszero v8
    jumpi v9, bb1, bb2
  bb1:
    v10 = returndatasize
    returndatacopy v0, 0, v10
    v11 = returndatasize
    revert v0, v11
  bb2:
    v12 = frame_load scratch, word, 0 !metadata(memory=scratch)
    v13 = extcodesize arg0
    v14 = gt v13, 0
    v15 = and v12, v14
    frame_store scratch, word, 0, v15 !metadata(memory=scratch)
    mstore 64, v0 !metadata(memory=scratch)
    v16 = frame_load scratch, word, 0 !metadata(memory=scratch)
    ret v16
}

