}

fn @multi(arg0: u256) -> (u256, u256) [abi_returns=[word, word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = internal_call @pair, 2, arg0
    v4 = mload 32 !metadata(memory=scratch)
    v5 = add v4, 32
    v6 = mload v5
    ret v3, v6
}

fn @pair(arg0: u256) -> (u256, u256) {
  bb0:
    v0 = add arg0, 1
    v1 = lt v0, arg0
    jumpi v1, bb1, bb2
  bb1:
    mstore 0, 0x4e487b7100000000000000000000000000000000000000000000000000000000 !metadata(memory=scratch)
    mstore 4, 17 !metadata(memory=scratch)
    revert 0, 36
  bb2:
    ret arg0, v0
}

fn @callVoid(arg0: u256) {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    internal_call @branchingVoid, 0, arg0
