@module InternalCallFallbacks
fn @recurse(arg0: u256) -> u256 [abi_returns=[word]] {
  bb0:
    v0 = calldatasize
    v1 = sub v0, 4
    v2 = slt v1, 32
    jumpi v2, bb1, bb2
  bb1:
    revert 0, 0
  bb2:
    v3 = internal_call @a, 1, arg0
    ret v3
}

fn @a(arg0: u256) -> u256 {
  bb0:
    v0 = eq arg0, 0
    jumpi v0, bb1, bb2
  bb1:
    mstore 0, 0 !metadata(memory=scratch)
