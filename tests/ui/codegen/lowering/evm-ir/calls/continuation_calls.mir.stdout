}

; function third(uint256 x) external pure returns (uint256) [selector 0xf1680ae6]
fn @third(arg0: i256) -> i256 [selector=0xf1680ae6, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
