; function combined(uint256 x) external pure returns (uint256) [selector 0xacb6e042]
fn @combined(arg0: i256) -> i256 [selector=0xacb6e042, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sum, arg0, 1
    v1 = checked_add uint256, arg0, v0
    v2 = icall @sum, arg0, 2
    v3 = checked_add uint256, v1, v2
    v4 = checked_add uint256, v3, 7
    ret v4
}

; function bounded(uint256 x) external pure returns (uint256) [selector 0xeadcc0c3]
fn @bounded(arg0: i256) -> i256 [selector=0xeadcc0c3, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = and arg0, 3
    v1 = icall @sum, v0, 1
    v2 = checked_add uint256, v0, v1
    v3 = icall @sum, v0, 2
    v4 = checked_add uint256, v2, v3
    v5 = checked_add uint256, v4, 7
    ret v5
}

; function sum(uint256 x, uint256 step) internal pure returns (uint256 r)
fn @sum(arg0: i256, arg1: i256) -> i256 [pure] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v5]
    v3 = phi [bb0: 0], [bb3: v6]
    v4 = lt v3, v0
    jumpi v4, bb4, bb5
  bb5:                                            ; preds = bb1
    jump bb2
  bb2:                                            ; preds = bb5
    ret v2
  bb4:                                            ; preds = bb1
    v5 = checked_add uint256, v2, v1
    jump bb6
  bb6:                                            ; preds = bb4
    jump bb3
  bb3:                                            ; preds = bb6
    v6 = checked_add uint256, v3, 1
    jump bb1
}
