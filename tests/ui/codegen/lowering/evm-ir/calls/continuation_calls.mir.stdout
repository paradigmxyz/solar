; === ROOT/tests/ui/codegen/lowering/evm-ir/calls/continuation_calls.sol:ContinuationCalls ===
@module ContinuationCalls
; function first(uint256 x) external pure returns (uint256) [selector 0x0b3f62f5]
fn @first(arg0: i256) -> i256 [selector=0x0b3f62f5, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sum, arg0, 1
    v1 = checked_add uint256, v0, 5
    ret v1
}

; function second(uint256 x) external pure returns (uint256) [selector 0x7896dfe3]
fn @second(arg0: i256) -> i256 [selector=0x7896dfe3, pure, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = icall @sum, arg0, 2
