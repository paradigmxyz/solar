fn @digests(arg0: i256, arg1: i256) -> i256 [selector=0xcf8609a5, pure, abi_params=[uint256, bytes32], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    jump bb1
  bb1:
    v0 = phi [bb0: arg0], [bb3: v0]
    v1 = phi [bb0: arg1], [bb3: v1]
    v2 = phi [bb0: 0], [bb3: v9]
    v3 = phi [bb0: 0], [bb3: v10]
    v4 = lt v3, v0
    jumpi v4, bb4, bb5
  bb5:
    jump bb2
  bb2:
    ret v2
  bb4:
    v5 = fmp
    v6 = abi_encode [word, word, word], object, args v3, v1, v2
    v7 = ptradd v6, 32
    v8 = mload v6
    v9 = keccak256 v7, v8
    set_fmp v5
    jump bb6
  bb6:
    jump bb3
  bb3:
    v10 = checked_add uint256, v3, 1
    jump bb1
}

