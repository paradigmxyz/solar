    v30 = mload v29
    v31 = byte 0, v30
    v32 = shl v31, 248
    v33 = shr v32, 248
    v34 = trunc i256 v33 to i8
    v35 = zext i8 v34 to i256
    v36 = checked_add uint256, v25, v35
    v37 = checked_add uint256, v22, v36
    v38 = insert_value struct0, undef struct0, 0, v37
    v39 = insert_value struct0, v38, 1, v0
    ret v39
}

