//@ compile-flags: -Zevm-ir-pipeline=default -O none -Zdump=disasm-runtime
//@ filecheck:

@module program_data

// CHECK-LABEL: // === program_data (runtime) ===
// CHECK-NEXT: PUSH1 0x04
// CHECK-NEXT: PUSH1 0x0a
// CHECK-NEXT: PUSH0
// CHECK-NEXT: CODECOPY
// CHECK-NEXT: PUSH1 0x04
// CHECK-NEXT: PUSH0
// CHECK-NEXT: RETURN
// The disassembler treats the opaque bytes as instructions, which also proves
// that the exact data was appended after the executable program.
// CHECK-NEXT: GT
// CHECK-NEXT: UNKNOWN 0x22
// CHECK-NEXT: CALLER
// CHECK-NEXT: PREVRANDAO
bb0:
  push 4
  push_data 0
  push 0
  codecopy
  push 4
  push 0
  return

@data 0 hex"11223344"
