//@ compile-flags: -Zevm-ir-pipeline=default -O gas -Zdump=disasm-runtime
//@ filecheck:

@module jumpi_layout

// CHECK-LABEL: ; === jumpi_layout (runtime) ===
// CHECK-NEXT: bb0:
// CHECK-NEXT: PUSH1 0x01
// CHECK-NEXT: PUSH1 0x06
// CHECK-NEXT: JUMPI ; -> bb2, else bb1
// CHECK-NEXT: bb1:
// CHECK-NEXT: STOP
// CHECK-NEXT: bb2:
// CHECK-NEXT: JUMPDEST
// CHECK-NEXT: INVALID
bb0:
  push 1
  jumpi bb1, bb2
bb2:
  stop
bb1:
  invalid
