//@ compile-flags: -Zevm-ir-pipeline=default -O none -Zdump=disasm-runtime
//@ filecheck:

@module push_pools

// Interned immediates and immutable placeholders keep separate identities.
// Repeated immutable placeholders retain their declared width, including zero.
// CHECK-LABEL: // === push_pools (runtime) ===
// CHECK-NEXT: PUSH4 0x80000000
// CHECK-NEXT: PUSH1 0x00
// CHECK-NEXT: PUSH20 0x0000000000000000000000000000000000000000
// CHECK-NEXT: PUSH4 0x80000000
// CHECK-NEXT: PUSH1 0x00
bb0:
  push 0x80000000
  push_immutable 3, 1
  push_immutable 4, 20
  push 0x80000000
  push_immutable 3, 1
  stop
