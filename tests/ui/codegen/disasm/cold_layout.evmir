//@ compile-flags: -Zcodegen -Zevm-ir-pipeline=default -O gas -Zdump=disasm-runtime
//@ filecheck:

@module cold_layout

// CHECK-LABEL: // === cold_layout (runtime) ===
// CHECK-NEXT: PUSH1 0x01
// CHECK-NEXT: PUSH1 0x06 ; bb0
// CHECK-NEXT: JUMPI
// CHECK-NEXT: STOP
// CHECK-NEXT: ; bb0
// CHECK-NEXT: JUMPDEST
// CHECK-NEXT: PUSH0
// CHECK-NEXT: PUSH0
// CHECK-NEXT: REVERT
bb0:
  push 1
  jumpi bb1, bb2
bb1 [cold]:
  push 0
  push 0
  revert
bb2:
  stop
