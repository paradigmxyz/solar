// === ROOT/tests/ui/codegen/disasm/creation_pricing.sol:Looped ===
@module Looped
fn @arr(arg0: i256) -> i256 [selector=0x71e5ee5f, view, abi_params=[uint256], abi_returns=[word], abi_return_params=[uint256]] {
  bb0:
    v0 = lt arg0, 100
    icall revert_if_zero<empty>, v0
    v1 = add 0, arg0
    v2 = sload v1 !metadata(storage=symbolic(arg0))
    ret v2
}

