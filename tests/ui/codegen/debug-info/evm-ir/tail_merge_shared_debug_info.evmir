//@ compile-flags: -Zevm-ir-pipeline=tail-merge,tail-merge --optimize-runs 1
//@ filecheck:
@module SharedDebugInfo

// The jump copies the first removed instruction as is, also when an earlier pass already shared
// it and gave it several origins.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + jump [[TAIL:bb[0-9]+]] !metadata(spans=[10..20, 50..60])
bb0:
  push 11
  push 22 !metadata(spans=[10..20, 50..60])
  push 33 !metadata(spans=[10..20, 50..60])
  push 44 !metadata(spans=[10..20, 50..60])
  push 55 !metadata(spans=[10..20, 50..60])
  revert !metadata(span=30..40)

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: + jump [[TAIL]] !metadata(spans=[10..20, 50..60])
bb1:
  push 99
  push 22 !metadata(spans=[10..20, 50..60])
  push 33 !metadata(spans=[10..20, 50..60])
  push 44 !metadata(spans=[10..20, 50..60])
  push 55 !metadata(spans=[10..20, 50..60])
  revert !metadata(spans=[30..40, 70..80])
