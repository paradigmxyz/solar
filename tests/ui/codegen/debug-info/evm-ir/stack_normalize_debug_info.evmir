//@ compile-flags: -Zevm-ir-pipeline=stack-normalize
//@ filecheck:
@module DebugInfo

// The one pop that replaces the run keeps every origin of the run.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + pop !metadata(spans=[7..8, 9..10, 11..12])
bb0:
  push 1 !metadata(span=1..2)
  push 2 !metadata(span=3..4)
  push 3 !metadata(span=5..6)
  swap 1 !metadata(span=7..8)
  swap 1 !metadata(span=9..10)
  pop !metadata(span=11..12)
  stop !metadata(span=13..14)
