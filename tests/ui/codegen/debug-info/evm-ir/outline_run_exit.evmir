//@ compile-flags: -Zevm-ir-pipeline=outline --optimize-runs 1
//@ filecheck:
@module OutlineRunExit

// The call sequence that replaces a run is not the instruction that leaves, so it takes the
// run's function entry but not its exit. The shared body keeps neither: the other site has none.
// CHECK-LABEL: (after outline)
// CHECK: + push {{bb[0-9]+}} !metadata(span=1..5, invoke=first@1..15){{$}}
// CHECK-NOT: {{^[ +].*exit=}}
bb0:
  push 1 !metadata(span=1..5, invoke=first@1..15)
  pop !metadata(span=6..10, exit=return)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  push 1 !metadata(span=1..5)
  pop !metadata(span=6..10)
  jump bb1 !metadata(span=11..15)

bb1:
  push 1 !metadata(span=21..25, invoke=second@21..35)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  push 1 !metadata(span=21..25)
  pop !metadata(span=26..30)
  stop !metadata(span=31..35)
