//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=report
// The same source span at different modifier depths has no single label checkpoint.
@module ThunkDepthConflict
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1:
  jump bb3 !metadata(span=30..40, modifier_depth=1)
bb2:
  push 1
  push 0
  mstore
  stop
bb3:
  jump bb4 !metadata(span=30..40, modifier_depth=2)
bb4:
  push 2
  push 0
  mstore
  stop
