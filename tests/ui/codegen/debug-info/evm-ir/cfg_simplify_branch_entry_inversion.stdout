- ; === ROOT/tests/ui/codegen/debug-info/evm-ir/cfg_simplify_branch_entry_inversion.evmir (before cfg-simplify) ===
+ ; === ROOT/tests/ui/codegen/debug-info/evm-ir/cfg_simplify_branch_entry_inversion.evmir (after cfg-simplify) ===
  @module BranchEntryInversion
  bb0:
    calldatasize
-   jumpi bb1, bb5
- bb1:
-   jump bb2
- bb2 [invoke=callee@30..70]:
-   jump bb3 !metadata(span=40..50)
- bb3:
+   jumpi bb3, bb5
+ bb3 [lent_invoke=callee@30..70]:
    push 2
    push 0
    mstore
    stop
  bb5:
    push 1
    push 0
    mstore
    stop
  
; === BranchEntryInversion (runtime) ===
bb0:
  0000  CALLDATASIZE
  0001  ISZERO
  0002  PUSH1 0x0a
  0004  JUMPI  ; -> bb2, else bb1
bb1:
  0005  PUSH1 0x02
  0007  PUSH0
  0008  MSTORE
  0009  STOP
bb2:
  000a  JUMPDEST
  000b  PUSH1 0x01
  000d  PUSH0
  000e  MSTORE
