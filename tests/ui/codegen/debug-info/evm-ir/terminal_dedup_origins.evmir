//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup
//@ filecheck:
@module Origins

bb0:
  push 1 !metadata(span=1..5)
  jumpi bb1, bb2 !metadata(span=6..10)

// Shared code keeps the origins of every path that runs it.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 0 !metadata(spans=[11..15, 31..35])
// CHECK: {{^[ +].*}}revert !metadata(spans=[20..25, 40..45])
bb1:
  push 0 !metadata(span=11..15)
  dup 1
  revert !metadata(span=20..25)
bb2:
  push 0 !metadata(span=31..35)
  dup 1
  revert !metadata(span=40..45)

// A path without an origin also runs the shared code, so the origins of the other paths would
// claim a source for it. The shared instructions have none.
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: {{^[ +].*}}push 7{{$}}
// CHECK: {{^[ +].*}}revert{{$}}
bb3:
  push 7 !metadata(span=51..55)
  revert !metadata(span=56..60)
bb4:
  push 7
  revert
