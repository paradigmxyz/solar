//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=report
//@ filecheck:
// Two source calls reach the same body. Its label cannot identify either call site.
// CHECK-NOT: checkpoint=
@module SharedThunkSpans
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1:
  jump bb3 !metadata(span=30..40)
bb2:
  jump bb3 !metadata(span=50..60)
bb3:
  push 2
  push 0
  mstore
  stop
