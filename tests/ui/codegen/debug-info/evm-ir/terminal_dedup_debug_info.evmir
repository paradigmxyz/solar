//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup
//@ filecheck:
@module DebugInfo

bb0:
  push 1 !metadata(span=1..5)
  jumpi bb1, bb2 !metadata(span=6..10)

// Shared instructions omit conflicting function events, and the shared entry omits an entry that
// the copies do not all enter. The unlocated copy in bb3 also runs the shared instructions, so
// they have no origin.
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: {{^[ +].*}}push 0{{$}}
// CHECK: {{^[ +].*}}revert{{$}}
bb1 [invoke=first@1..10]:
  push 0 !metadata(span=11..15, invoke=nested_first@11..25)
  dup 1 !metadata(span=16..19)
  revert !metadata(span=20..25)

// The survivor takes an entry only when every copy enters the same function, and these do not.
// The copy keeps its own, since only its callers run it.
// CHECK-LABEL: {{^[ +].*}}bb2 [invoke=second@11..20]:
// CHECK: + jump bb1
bb2 [invoke=second@11..20]:
  push 0 !metadata(span=31..35, invoke=nested_second@31..45)
  dup 1 !metadata(span=36..39)
  revert !metadata(span=40..45)

// A later copy cannot restore an invocation that conflicts within the group.
bb3:
  push 0 !metadata(invoke=nested_first@11..25)
  dup 1
  revert

// A copy without an event makes it unknown, since the shared instructions also run on that copy's
// path, which is not the call or the return.
// CHECK-LABEL: {{^[ +].*}}bb4:
// CHECK: {{^[ +].*}}push 32{{$}}
// CHECK: {{^[ +].*}}pop{{$}}
// CHECK: {{^[ +].*}}stop{{$}}
bb4:
  push 32
  pop !metadata(invoke=known@51..60)
  stop
bb5:
  push 32 !metadata(invoke=known@51..60)
  pop
  stop !metadata(invoke=known@51..60, exit=return)
bb6:
  push 32
  pop
  stop

// Conflicting exits and terminator invocations stay unknown across later copies.
// CHECK-LABEL: {{^[ +].*}}bb7:
// CHECK: {{^[ +].*}}push 64
// CHECK: {{^[ +].*}}pop
// CHECK: {{^[ +].*}}stop{{$}}
bb7:
  push 64
  pop
  stop !metadata(invoke=first@1..10, exit=return)
bb8:
  push 64
  pop
  stop !metadata(invoke=second@11..20, exit=revert)
bb9:
  push 64
  pop
  stop !metadata(invoke=first@1..10, exit=return)
