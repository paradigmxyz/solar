//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=check
// An unlocated prefix must not hide a later thunk's source. Function entries
// belong to the destinations, never the shared branch (which assembly may invert).
@module ThunkChainSpans
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1:
  jump bb3
bb2:
  push 32
  calldataload
  jumpi bb5, bb6
bb3 [invoke=first@30..70]:
  jump bb4 !metadata(span=30..40)
bb4:
  push 2
  push 0
  mstore
  stop
bb5:
  jump bb7
bb6:
  push 1
  push 0
  mstore
  stop
bb7 [invoke=second@80..120]:
  jump bb8 !metadata(span=90..100)
bb8:
  push 3
  push 0
  mstore
  stop
