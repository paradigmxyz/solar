//@ compile-flags: -Zevm-ir-pipeline=tail-merge --optimize-runs 1
//@ filecheck:
@module AgreeingEvents

// Both paths run the shared tail, and both enter `inner` at its first instruction, so the shared
// instruction keeps the entry. The jumps into the tail are not that instruction and take none.
// CHECK-LABEL: (after tail-merge)
// CHECK-NOT: {{^[ +].*jump.*invoke}}
// CHECK: {{^[ +].*}}push 22 !metadata(span=6..10, invoke=inner@1..30)
bb0:
  push 11 !metadata(span=1..5)
  push 22 !metadata(span=6..10, invoke=inner@1..30)
  push 33 !metadata(span=11..15)
  push 44 !metadata(span=16..20)
  push 55 !metadata(span=21..25)
  revert !metadata(span=26..30)
bb1:
  push 99 !metadata(span=31..35)
  push 22 !metadata(span=6..10, invoke=inner@1..30)
  push 33 !metadata(span=11..15)
  push 44 !metadata(span=16..20)
  push 55 !metadata(span=21..25)
  revert !metadata(span=26..30)
