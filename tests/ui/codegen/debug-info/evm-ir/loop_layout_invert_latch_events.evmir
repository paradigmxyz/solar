//@ compile-flags: -Ogas -Zevm-ir-pipeline=loop-layout
//@ filecheck:
// Turning a latch around removes its `iszero`, and with it the instruction that carried a function
// entry. The entry moves to the push that runs next, not to the conditional jump behind it, which
// also runs when the loop exits.
@module InvertLatchEvents

// CHECK-LABEL: (after loop-layout)
// CHECK: {{^[ +].*}}push bb4 !metadata(invoke=callee@1..10)
// CHECK-NEXT: {{^[ +].*}}jumpi{{$}}
bb0:
  push 3
  push 0
  jump bb1
bb1:
  dup 2
  dup 2
  lt
  push bb3
  jumpi
  jump bb2
bb2:
  pop
  pop
  stop
bb3:
  push 1
  add
  dup 1
  iszero
  iszero !metadata(invoke=callee@1..10)
  push bb1
  jumpi
  jump bb4
bb4 [cold]:
  push 0
  push 0
  revert
