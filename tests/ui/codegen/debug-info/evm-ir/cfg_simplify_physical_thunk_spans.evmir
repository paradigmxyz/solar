//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=report
// Scheduled branches can carry their label push and JUMPI as physical instructions.
// The other arm's jump-only thunks disappear into fallthrough; report those losses.
@module PhysicalThunkSpans
bb0:
  push 0
  calldataload
  push bb1 !metadata(span=10..20)
  jumpi !metadata(span=10..20)
  jump bb2 !metadata(span=50..60)
bb1:
  jump bb3 !metadata(span=30..40, invoke=callee@30..50)
bb2:
  jump bb4 !metadata(span=70..80)
bb3:
  push 2
  push 0
  mstore
  stop
bb4:
  push 1
  push 0
  mstore
  stop
