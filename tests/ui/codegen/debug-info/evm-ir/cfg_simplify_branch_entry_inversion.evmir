//@ compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify -Zdebugify=check -Zdump=disasm-runtime
// The true destination becomes fallthrough, so assembly inverts the branch and jumps to the
// false destination. Entering `callee` belongs to the true destination, not that JUMPI.
@module BranchEntryInversion
bb0:
  calldatasize
  jumpi bb1, bb5
bb1:
  jump bb2
bb2 [invoke=callee@30..70]:
  jump bb3 !metadata(span=40..50)
bb3:
  push 2
  push 0
  mstore
  stop
bb5:
  push 1
  push 0
  mstore
  stop
