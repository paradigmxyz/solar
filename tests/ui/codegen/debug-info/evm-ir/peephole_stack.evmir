//@ compile-flags: -Ogas --evm-version=osaka -Zevm-ir-pipeline=peephole,late-word
//@ filecheck:
@module PeepholeStack

// `dup2; push a; mstore; swap1; pop` becomes `swap1; push a; mstore`. The `mstore` keeps its own
// context, and the removed swap and pop take their origins with them.
// `push c; swap1; sub` becomes `push -c; add`. The `add` keeps the subtraction's context, and the
// removed push and swap take their origins with them.
// CHECK: + swap 1 !metadata(span=31..35){{$}}
// CHECK: {{^[ +] *}}add !metadata(span=21..25){{$}}
// CHECK-NOT: spans=
bb0:
  calldatasize
  push 1 !metadata(span=1..5)
  swap 1 !metadata(span=11..15)
  sub !metadata(span=21..25)
  stop
bb1:
  calldatasize
  caller
  dup 2 !metadata(span=31..35)
  push 128 !metadata(span=36..40)
  mstore !metadata(span=45..49)
  swap 1 !metadata(span=50..55)
  pop !metadata(span=56..60)
  stop
