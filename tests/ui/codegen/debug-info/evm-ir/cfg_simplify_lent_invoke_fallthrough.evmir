//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
// One direct jump is insufficient when another path falls into the label: the lent function
// entry must not stay on it.
// CHECK: - bb2 [lent_invoke=callee@30..50]:
// CHECK-NEXT: + bb2:
@module LentInvokeFallthrough
bb0:
  push 0
  calldataload
  push bb2 !metadata(span=10..20)
  jumpi !metadata(span=10..20)
  jump bb1
bb1:
  push 1
  pop
  jump bb2
bb2 [lent_invoke=callee@30..50]:
  push 2
  push 0
  mstore
  stop
