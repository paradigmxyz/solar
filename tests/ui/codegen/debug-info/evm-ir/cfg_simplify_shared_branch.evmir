//@ compile-flags: -Osize -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module SharedBranch

// The `jumpi` is the root of the merged branch. The pushed label and both jumps are removed, so
// their origins go with them.
bb0:
  push bb1
  pop
  stop

// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: + jumpi bb2, bb3 !metadata(span=21..25){{$}}
bb1:
  push 1
  push bb2 !metadata(span=1..5)
  jump bb4 !metadata(span=11..15)

bb2:
  stop
bb3:
  push 0
  push 0
  revert
bb4:
  jumpi !metadata(span=21..25)
  jump bb3 !metadata(span=31..35)
