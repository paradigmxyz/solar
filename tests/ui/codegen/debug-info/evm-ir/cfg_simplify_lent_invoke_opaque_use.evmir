//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
// A lent function entry cannot survive an opaque address use of its label. The entry on the
// label that only the branch reaches stays.
// CHECK: - bb1 [lent_invoke=callee@30..50]:
// CHECK-NEXT: + bb1:
// CHECK: bb2 [lent_invoke=independent@80..120]:
@module LentInvokeOpaqueUse
bb0:
  push bb1
  push 0
  mstore
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1 [lent_invoke=callee@30..50]:
  push 1
  push 0
  mstore
  stop
bb2 [lent_invoke=independent@80..120]:
  push 2
  push 0
  mstore
  stop
