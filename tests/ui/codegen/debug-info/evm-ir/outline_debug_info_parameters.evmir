//@ compile-flags: -Osize -Zevm-ir-pipeline=outline
//@ filecheck:
@module DebugInfoParameters

// Each site's call sequence takes the first location of its run and keeps the parameter pushes'
// own. A site with no located instruction gets none, and the stub, which also runs for that site,
// has none either.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push [[RET0:bb[0-9]+]] !metadata(span=1..2)
// CHECK-NEXT: push 2 !metadata(span=10..11)
// CHECK: + push 1 !metadata(span=1..2)
// CHECK-NEXT: + jump [[STUB:bb[0-9]+]] !metadata(span=1..2){{$}}
// CHECK-LABEL: {{^[ +].*}}bb1:
// CHECK: + push [[RET1:bb[0-9]+]] !metadata(span=101..102)
// CHECK: + jump [[STUB]] !metadata(span=101..102){{$}}
// CHECK-LABEL: {{^[ +].*}}bb3:
// CHECK: + push [[RET3:bb[0-9]+]]{{$}}
// CHECK: + jump [[STUB]]{{$}}
// CHECK: + [[STUB]] {{\[ret=.*\]}}:
// CHECK-COUNT-8: {{^[ +] *}}not{{$}}
// CHECK: + swap 1{{$}}
// CHECK-NEXT: {{^[ +] *}}add{{$}}
bb0:
  push 1 !metadata(span=1..2)
  not !metadata(span=2..3)
  not !metadata(span=3..4)
  not !metadata(span=4..5)
  not !metadata(span=5..6)
  not !metadata(span=6..7)
  not !metadata(span=7..8)
  not !metadata(span=8..9)
  not !metadata(span=9..10)
  push 2 !metadata(span=10..11)
  add !metadata(span=11..12)
  not !metadata(span=12..13)
  not !metadata(span=13..14)
  not !metadata(span=14..15)
  not !metadata(span=15..16)
  not !metadata(span=16..17)
  not !metadata(span=17..18)
  not !metadata(span=18..19)
  pop !metadata(span=19..20)
  jump bb1
bb1:
  push 3 !metadata(span=101..102)
  not !metadata(span=102..103)
  not !metadata(span=103..104)
  not !metadata(span=104..105)
  not !metadata(span=105..106)
  not !metadata(span=106..107)
  not !metadata(span=107..108)
  not !metadata(span=108..109)
  not !metadata(span=109..110)
  push 4 !metadata(span=110..111)
  add !metadata(span=111..112)
  not !metadata(span=112..113)
  not !metadata(span=113..114)
  not !metadata(span=114..115)
  not !metadata(span=115..116)
  not !metadata(span=116..117)
  not !metadata(span=117..118)
  not !metadata(span=118..119)
  pop !metadata(span=119..120)
  jump bb2
bb2:
  push 5 !metadata(span=201..202)
  not !metadata(span=202..203)
  not !metadata(span=203..204)
  not !metadata(span=204..205)
  not !metadata(span=205..206)
  not !metadata(span=206..207)
  not !metadata(span=207..208)
  not !metadata(span=208..209)
  not !metadata(span=209..210)
  push 6 !metadata(span=210..211)
  add !metadata(span=211..212)
  not !metadata(span=212..213)
  not !metadata(span=213..214)
  not !metadata(span=214..215)
  not !metadata(span=215..216)
  not !metadata(span=216..217)
  not !metadata(span=217..218)
  not !metadata(span=218..219)
  pop !metadata(span=219..220)
  jump bb3
bb3:
  push 7
  not
  not
  not
  not
  not
  not
  not
  not
  push 8
  add
  not
  not
  not
  not
  not
  not
  not
  pop
  stop
