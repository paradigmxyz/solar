//@ compile-flags: -Zevm-ir-pipeline=compact-pushes
//@ filecheck:
@module CompactPushDebugSpans

// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + push 0 !metadata(span=10..20)
// CHECK-NEXT: + not !metadata(span=10..20)
bb0:
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff !metadata(span=10..20)
  stop
