//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup -Zdebugify=check -Zdump=evm-ir
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
// Merging blocks that share most of a long origin list adds only the origin the list lacks.
@module OverlappingOrigins

bb0:
  push 0
  jumpi bb2, bb1
bb1:
  push 0
  jumpi bb3, bb4
// CHECK: stop !metadata(spans=[10..11, 20..21, 30..31, 40..41, 50..51, 60..61, 70..71, 80..81, 90..91, 100..101, 110..111, 120..121, 130..131, 140..141, 150..151, 160..161, 170..171, 180..181, 190..191, 200..201, 210..211])
bb2:
  stop !metadata(spans=[10..11, 20..21, 30..31, 40..41, 50..51, 60..61, 70..71, 80..81, 90..91, 100..101, 110..111, 120..121, 130..131, 140..141, 150..151, 160..161, 170..171, 180..181, 190..191, 200..201])
bb3:
  stop !metadata(spans=[10..11, 20..21, 30..31, 40..41, 50..51, 60..61, 70..71, 80..81, 90..91, 100..101, 110..111, 120..121, 130..131, 140..141, 150..151, 160..161, 170..171, 180..181, 190..191, 200..201, 210..211])
bb4:
  stop !metadata(spans=[10..11, 20..21, 30..31, 40..41, 50..51, 60..61, 70..71, 80..81, 90..91, 100..101, 110..111, 120..121, 130..131, 140..141, 150..151, 160..161, 170..171, 180..181, 190..191, 200..201])
