//@ compile-flags: -Osize -Zevm-ir-pipeline=compact-pushes
//@ filecheck:
// A push that carries a function entry becomes a recipe of several instructions, and the first of
// them, which runs first, takes the entry.
@module CompactPushesEntry

// CHECK-LABEL: (after compact-pushes)
// CHECK: {{^[ +].*}}push 0 !metadata(invoke=callee@1..10)
// CHECK-NEXT: {{^[ +].*}}not{{$}}
bb0:
  push 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff !metadata(invoke=callee@1..10)
  push 0
  mstore
  stop
