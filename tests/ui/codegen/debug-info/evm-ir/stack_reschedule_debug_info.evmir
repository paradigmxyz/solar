//@ compile-flags: -Zevm-ir-pipeline=stack-reschedule
//@ filecheck:
@module DebugInfo

// The operations keep their origins, the new stack operations carry none, and the replaced ones
// take their origins with them.
// CHECK-LABEL: {{^[ +].*}}bb0 [loop, stack=2]:
// CHECK: +   pop{{$}}
// CHECK: push 2 !metadata(span=3..4)
// CHECK: add !metadata(span=5..6)
// CHECK: mstore !metadata(span=13..14)
bb0 [loop, stack=2]:
  swap 1 !metadata(span=1..2)
  push 2 !metadata(span=3..4)
  add !metadata(span=5..6)
  swap 1 !metadata(span=7..8)
  pop !metadata(span=9..10)
  push 0 !metadata(span=11..12)
  mstore !metadata(span=13..14)
  stop !metadata(span=15..16)
