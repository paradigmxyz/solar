//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
// A bypassed thunk whose jump ends the function, such as a tail call, hands its origin to the
// incoming unconditional jump with the exit. A thunk jump without an origin leaves the incoming
// jump's origin alone.
@module ThunkExitOrigin

// CHECK-LABEL: (after cfg-simplify)
// CHECK: jump bb4 !metadata(span=30..40, exit=return)
// CHECK: jump bb4 !metadata(span=9..10, exit=return)
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 3
  jump bb3 !metadata(span=7..8)
bb2:
  push 4
  jump bb5 !metadata(span=9..10)
bb3:
  jump bb4 !metadata(span=30..40, exit=return)
bb5:
  jump bb4 !metadata(exit=return)
bb4:
  push 0
  push 0
  return
