//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
// A thunk whose span equals the conditional transfer's is redundant, but its function event is
// not: the bypassed thunk's activation must survive on the destination.
@module ThunkEqualSpanInvoke

// CHECK: {{^[ +].*}}jumpi bb3, bb2 !metadata(span=10..20)
// CHECK: {{^[ +].*}}bb3 [{{.*}}callee@30..50{{.*}}]:
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1:
  jump bb3 !metadata(span=10..20, invoke=callee@30..50)
bb2:
  push 1
  push 0
  mstore
  stop
bb3:
  push 2
  push 0
  mstore
  stop
