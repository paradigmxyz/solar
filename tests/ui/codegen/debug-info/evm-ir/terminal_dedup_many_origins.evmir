//@ compile-flags: -Zevm-ir-pipeline=terminal-dedup -Zdebugify=check -Zdump=evm-ir
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
// Merged terminal blocks keep every distinct origin, however many there are.
@module ManyOrigins

bb0:
  push 0
  jumpi bb8, bb1
bb1:
  push 0
  jumpi bb9, bb2
bb2:
  push 0
  jumpi bb10, bb3
bb3:
  push 0
  jumpi bb11, bb4
bb4:
  push 0
  jumpi bb12, bb5
bb5:
  push 0
  jumpi bb13, bb6
bb6:
  push 0
  jumpi bb14, bb7
bb7:
  push 0
  jumpi bb15, bb16
// CHECK: stop !metadata(spans=[10..11, 20..21, 30..31, 40..41, 50..51, 60..61, 70..71, 80..81, 90..91])
bb8:
  stop !metadata(span=10..11)
bb9:
  stop !metadata(span=20..21)
bb10:
  stop !metadata(span=30..31)
bb11:
  stop !metadata(span=40..41)
bb12:
  stop !metadata(span=50..51)
bb13:
  stop !metadata(span=60..61)
bb14:
  stop !metadata(span=70..71)
bb15:
  stop !metadata(span=80..81)
bb16:
  stop !metadata(span=90..91)
