//@ compile-flags: -Ogas -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module LoopExit

// The removed `iszero` takes its origin with it, and the retargeted push keeps its own.
// CHECK: + push bb4 !metadata(span=11..15){{$}}
bb0:
  push 10
  jump bb1
bb1:
  dup 1
  iszero !metadata(span=1..5)
  push bb2 !metadata(span=11..15)
  jumpi
  push 0
  jump bb3
bb2:
  push 1
  sub
  dup 1
  push bb1
  jumpi
  push 1
  jump bb3
bb3:
  pop
  pop
  stop
