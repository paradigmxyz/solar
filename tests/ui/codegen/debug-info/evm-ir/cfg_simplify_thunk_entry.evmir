//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=check
//@ filecheck:
// Two callers jump to a callee's entry thunk, which is bypassed. The callee starts at the first
// instruction of its body, which only the thunk enters, so the entry moves to that label and not
// onto the callers' jumps.
// CHECK-LABEL: (after cfg-simplify)
// CHECK-NOT: {{^[ +].*invoke}}
// CHECK: {{^[ +].*}}bb4 [invoke=callee@10..50]:
@module ThunkEntry
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  push 1
  jump bb3 !metadata(span=1..5)
bb2:
  push 2
  jump bb3 !metadata(span=6..10)
bb3 [invoke=callee@10..50]:
  jump bb4
bb4:
  push 2
  push 0
  mstore
  stop
