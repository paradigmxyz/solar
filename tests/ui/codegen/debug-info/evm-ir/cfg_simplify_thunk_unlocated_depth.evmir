//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=report
// An unlocated thunk still sits at its own modifier depth, so it votes on the depth of the chain.
// The depths of the two thunks differ, which leaves no single depth for a label checkpoint.
@module ThunkUnlocatedDepth
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1:
  jump bb3
bb2:
  push 1
  push 0
  mstore
  stop
bb3:
  jump bb4 !metadata(span=30..40, modifier_depth=1)
bb4:
  push 2
  push 0
  mstore
  stop
