//@ filecheck:
@module LabelOriginAfterJump

// An unannotated physical `jump` ends its block, and the next block's label carries an origin.
// The `jump` must not take that label as its target, and a `jump` to a label with its own
// metadata still must.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: {{^[ +].*}}jump
// CHECK-NOT: jump bb
// CHECK-LABEL: {{^[ +].*}}bb1 !metadata(span=10..20):
// CHECK: {{^[ +].*}}jump bb2 !metadata(span=30..35)
bb0:
  push bb1
  jump
bb1 !metadata(span=10..20):
  jump bb2 !metadata(span=30..35)
bb2:
  stop
