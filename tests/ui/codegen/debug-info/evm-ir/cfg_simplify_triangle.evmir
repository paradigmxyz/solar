//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify
//@ filecheck:
@module Triangle

// The `jumpi` is the root. The pushed label is its operand and the jump is removed, so their
// origins go with them.
// CHECK-LABEL: {{^[ +].*}}bb0:
// CHECK: + jumpi bb1, bb2 !metadata(span=11..15){{$}}
bb0:
  push 0
  calldataload
  push bb1 !metadata(span=1..5)
  jumpi !metadata(span=11..15)
  jump bb2 !metadata(span=21..25)
bb1:
  push 1
  push 0
  mstore
  jump bb2
bb2:
  stop
