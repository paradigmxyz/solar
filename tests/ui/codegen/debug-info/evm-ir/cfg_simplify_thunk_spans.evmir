//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify -Zdebugify=check
//@ filecheck:
// A conditional transfer must keep its own origin when its taken thunk is removed.
// The thunk's origin belongs only to the taken path, so it goes with it. Its function entry moves
// to the destination, which only that edge reaches.
// CHECK: + bb3 [lent_invoke=callee@30..50]:
@module ThunkSpans
bb0:
  push 0
  calldataload
  jumpi bb1, bb2 !metadata(span=10..20)
bb1:
  jump bb3 !metadata(span=30..40, invoke=callee@30..50)
bb2:
  push 1
  push 0
  mstore
  stop
bb3:
  push 2
  push 0
  mstore
  stop
