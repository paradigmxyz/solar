//@ compile-flags: -Osize -Zevm-ir-pipeline=outline
//@ filecheck:
@module OutlineParameterEntries

// The parameter pushes run before the part of each run that moves into the stub, so a function
// entry on one does not stay there. The site's call sequence, which runs first, takes it.
// CHECK-LABEL: (after outline)
// CHECK: {{^[ +].*}}bb0:
// CHECK: + push {{bb[0-9]+}} !metadata(invoke=first@1..10)
// CHECK-NEXT: push 2{{$}}
// CHECK: {{^[ +].*}}bb1:
// CHECK: + push {{bb[0-9]+}} !metadata(invoke=second@11..20)
// CHECK-NEXT: push 4{{$}}
bb0:
  push 1
  not
  not
  not
  not
  not
  not
  not
  not
  push 2 !metadata(invoke=first@1..10)
  add
  not
  not
  not
  not
  not
  not
  not
  pop
  jump bb1
bb1:
  push 3
  not
  not
  not
  not
  not
  not
  not
  not
  push 4 !metadata(invoke=second@11..20)
  add
  not
  not
  not
  not
  not
  not
  not
  pop
  jump bb2
bb2:
  push 5
  not
  not
  not
  not
  not
  not
  not
  not
  push 6
  add
  not
  not
  not
  not
  not
  not
  not
  pop
  jump bb3
bb3:
  push 7
  not
  not
  not
  not
  not
  not
  not
  not
  push 8
  add
  not
  not
  not
  not
  not
  not
  not
  pop
  stop

