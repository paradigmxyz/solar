//@ compile-flags: -Ogas -Zmir-pipeline=word-sequence-early -Zdump=mir -Zdebugify=check
//@ filecheck:
//@ normalize-stdout-test: "(?s).+" -> ""
//@ normalize-stderr-test: "debugify: [^\n]*\n" -> ""
// Joining two zero-extended tests with `or` or `and` before a zero test narrows the join to `i1`.
// The new `or` or `and` replaces the old one, so it keeps the old one's location; the zero test
// keeps its own.
@module WordSequenceEarlyBoolJoinOrigin

// CHECK-LABEL: {{^[ +].*}}fn @or_join{{[( ]}}
// CHECK: [[A:v[0-9]+]] = eq arg0, 1 !metadata(span=10..20)
// CHECK: [[B:v[0-9]+]] = eq arg1, 2 !metadata(span=30..40)
// CHECK: + [[OR:v[0-9]+]] = or [[A]], [[B]] !metadata(span=5..45)
// CHECK: eq [[OR]], false !metadata(span=1..50)
fn @or_join(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = eq arg0, 1 !metadata(span=10..20)
    v1 = eq arg1, 2 !metadata(span=30..40)
    v2 = zext i1 v0 to i256 !metadata(span=10..20)
    v3 = zext i1 v1 to i256 !metadata(span=30..40)
    v4 = or v2, v3 !metadata(span=5..45)
    v5 = eq v4, 0 !metadata(span=1..50)
    jumpi v5, bb1, bb2
  bb1:
    ret 7
  bb2:
    ret 0
}

// CHECK-LABEL: {{^[ +].*}}fn @and_join{{[( ]}}
// CHECK: [[C:v[0-9]+]] = eq arg0, 1 !metadata(span=110..120)
// CHECK: [[D:v[0-9]+]] = eq arg1, 2 !metadata(span=130..140)
// CHECK: + [[AND:v[0-9]+]] = and [[C]], [[D]] !metadata(span=105..145)
// CHECK: eq [[AND]], false !metadata(span=101..150)
fn @and_join(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = eq arg0, 1 !metadata(span=110..120)
    v1 = eq arg1, 2 !metadata(span=130..140)
    v2 = zext i1 v0 to i256 !metadata(span=110..120)
    v3 = zext i1 v1 to i256 !metadata(span=130..140)
    v4 = and v2, v3 !metadata(span=105..145)
    v5 = eq v4, 0 !metadata(span=101..150)
    jumpi v5, bb1, bb2
  bb1:
    ret 7
  bb2:
    ret 0
}
