//@ compile-flags: -Zmir-pipeline=merge-equivalent-functions
//@ filecheck:
// Calls to a merged duplicate land on the representative's entry label, so the label keeps the
// origins of both functions, as the body does.
@module SharedLabels

// CHECK-LABEL: {{^[ +].*}}fn @first{{[( ]}}
// CHECK: + bb0 !metadata(spans=[10..20, 50..60]):
fn @first(arg0: i256) -> i256 {
  bb0 !metadata(span=10..20):
    v0 = add arg0, 1 !metadata(span=30..40)
    ret v0 !metadata(span=30..40)
}

fn @second(arg0: i256) -> i256 {
  bb0 !metadata(span=50..60):
    v0 = add arg0, 1 !metadata(span=70..80)
    ret v0 !metadata(span=70..80)
}

// Nothing calls the duplicate, so its label adds no origin.
// CHECK-LABEL: {{^[ +].*}}fn @live{{[( ]}}
// CHECK: bb0 !metadata(span=90..100):
fn @live(arg0: i256) -> i256 {
  bb0 !metadata(span=90..100):
    v0 = add arg0, 7 !metadata(span=110..120)
    ret v0 !metadata(span=110..120)
}

fn @uncalled(arg0: i256) -> i256 {
  bb0 !metadata(span=130..140):
    v0 = add arg0, 7 !metadata(span=150..160)
    ret v0 !metadata(span=150..160)
}

// Only a function nothing calls calls the duplicate, so no entry reaches it either.
// CHECK-LABEL: {{^[ +].*}}fn @reached{{[( ]}}
// CHECK: bb0 !metadata(span=170..180):
fn @reached(arg0: i256) -> i256 {
  bb0 !metadata(span=170..180):
    v0 = add arg0, 9 !metadata(span=190..200)
    ret v0 !metadata(span=190..200)
}

fn @dead_callee(arg0: i256) -> i256 {
  bb0 !metadata(span=210..220):
    v0 = add arg0, 9 !metadata(span=230..240)
    ret v0 !metadata(span=230..240)
}

fn @dead_caller(arg0: i256) -> i256 {
  bb0:
    v0 = icall @dead_callee, arg0
    ret v0
}

// Only the second function is called, so the shared label names it alone.
// CHECK-LABEL: {{^[ +].*}}fn @uncalled_first{{[( ]}}
// CHECK: + bb0 !metadata(span=270..280):
fn @uncalled_first(arg0: i256) -> i256 {
  bb0 !metadata(span=250..260):
    v0 = add arg0, 11 !metadata(span=290..300)
    ret v0 !metadata(span=290..300)
}

fn @called_second(arg0: i256) -> i256 {
  bb0 !metadata(span=270..280):
    v0 = add arg0, 11 !metadata(span=310..320)
    ret v0 !metadata(span=310..320)
}

fn @entry(arg0: i256) -> i256 [selector=0x01020304] {
  bb0:
    v0 = icall @first, arg0
    v1 = icall @second, arg0
    v2 = icall @live, arg0
    v3 = icall @reached, arg0
    v7 = icall @called_second, arg0
    v4 = add v0, v1
    v5 = add v2, v3
    v6 = add v4, v5
    v8 = add v6, v7
    ret v8
}
