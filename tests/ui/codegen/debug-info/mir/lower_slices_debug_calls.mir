//@ compile-flags: -Zmir-pipeline=lower-slices -Zdebugify=check
// Argument casts and return-buffer loads inherit their call's context. Two calls with
// distinct origins catch a builder that retains the previous call's context.
@module DebugSliceCalls
fn @caller(arg0: slice<calldata>) -> i256 {
  bb0:
    v0 = icall @identity, arg0 !metadata(span=10..20)
    v1 = icall @identity, v0 !metadata(span=30..40)
    v2 = extract_value slice<calldata>, v1, 1
    ret v2
}
fn @identity(arg0: slice<calldata>) -> slice<calldata> {
  bb0:
    v0 = extract_value slice<calldata>, arg0, 0
    v1 = extract_value slice<calldata>, arg0, 1
    v2 = make_calldata_slice v0, v1
    ret v2 !metadata(span=50..60)
}
