//@ compile-flags: -Zmir-pipeline=if-convert
//@ filecheck:
// solc maps the branch of an `if` to the whole statement, which the join phi carries; our branch
// carries only the condition. Selects take the phi's span, while hoisted arm operations lose
// their locations because they also execute when their original source arm does not.
@module BranchDebugContext

// CHECK-LABEL: {{^[ +].*}}fn @diamond{{[( ]}}
// CHECK: + {{v[0-9]+}} = add arg0, 1{{$}}
// CHECK: + {{v[0-9]+}} = sub arg0, 1{{$}}
// CHECK: + {{v[0-9]+}} = zext i1 arg1 to i256 !metadata(span=5..9)
// CHECK: + {{v[0-9]+}} = add {{v[0-9]+}}, {{v[0-9]+}} !metadata(span=5..9)
fn @diamond(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2 !metadata(span=1..2)
  bb1:
    v0 = add arg0, 1 !metadata(span=10..20)
    jump bb3
  bb2:
    v1 = sub arg0, 1 !metadata(span=30..40)
    jump bb3
  bb3:
    v2 = phi [bb1: v0], [bb2: v1] !metadata(span=5..9)
    ret v2
}

// CHECK-LABEL: {{^[ +].*}}fn @triangle{{[( ]}}
// CHECK: + {{v[0-9]+}} = add arg0, 1{{$}}
// CHECK: + {{v[0-9]+}} = zext i1 arg1 to i256 !metadata(span=5..9)
// CHECK: + {{v[0-9]+}} = add {{v[0-9]+}}, arg0 !metadata(span=5..9)
fn @triangle(arg0: i256, arg1: i1) -> i256 {
  bb0:
    jumpi arg1, bb1, bb2 !metadata(span=1..2)
  bb1:
    v0 = add arg0, 1 !metadata(span=10..20)
    jump bb2
  bb2:
    v1 = phi [bb0: arg0], [bb1: v0] !metadata(span=5..9)
    ret v1
}
