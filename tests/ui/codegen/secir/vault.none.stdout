// === ROOT/tests/ui/codegen/secir/vault.sol:Vault ===
contract Vault
  storage:
    slot 0: owner
    slot 1: balances
    slot 2: total
  fn owner [external 0x8da5cb5b view] @ 10:5
    reads owner @ 10:5
  fn balances [external 0x27e235e3 view] @ 11:5
    reads balances[..] keyed by arg0 @ 11:5
  fn total [external 0x2ddbd13a view] @ 12:5
    reads total @ 12:5
  fn constructor [constructor nonpayable] @ 14:5
    reads owner @ 15:9
    writes owner @ 15:9
  fn deposit [external 0xd0e30db0 payable] @ 18:5
    reads balances[..] keyed by msg.sender @ 19:9
    reads total @ 20:9
    writes balances[..] keyed by msg.sender @ 19:9
    writes total @ 20:9
  fn withdraw [external 0x2e1a7d4d nonpayable] @ 23:5
    reads balances[..] keyed by msg.sender @ 24:17
    reads balances[..] keyed by msg.sender @ 27:9
    reads total @ 29:13
    writes balances[..] keyed by msg.sender @ 27:9
    writes total @ 29:13
    call to msg.sender with value from arg0 @ 25:9
    guard revert on arg0, balances[..] @ 24:9
    guard revert on call result @ 26:9
    unchecked @ 29:13
    writes after external call balances[..] keyed by msg.sender @ 27:9
    writes after external call total @ 29:13
  fn sweep [external 0x01681a62 nonpayable] @ 33:5
    reads owner @ 34:31
    icall _send @ 35:9
    icall _clear @ 36:9
    guard revert (access control) on msg.sender, owner @ 34:9
    writes after external call total @ 36:9
    transitive: reads owner writes total calls transfer
  fn _send [internal nonpayable] @ 39:5
    transfer to arg0 with value from arg1 @ 40:9
  fn _clear [internal nonpayable] @ 43:5
    writes total @ 44:9
