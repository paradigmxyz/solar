            x = (x ^ ~uint256(0x100)) * 3;
            x = (x ^ ~uint256(0x101)) * 3;
            x = (x ^ ~uint256(0x102)) * 3;
            x = (x ^ ~uint256(0x103)) * 3;
            x = (x ^ ~uint256(0x104)) * 3;
            x = (x ^ ~uint256(0x105)) * 3;
            x = (x ^ ~uint256(0x106)) * 3;
            x = (x ^ ~uint256(0x107)) * 3;
