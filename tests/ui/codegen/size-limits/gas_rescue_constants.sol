            x = (x ^ ~uint256(0x10b)) * 3;
            x = (x ^ ~uint256(0x10c)) * 3;
            x = (x ^ ~uint256(0x10d)) * 3;
            x = (x ^ ~uint256(0x10e)) * 3;
