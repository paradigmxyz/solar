//@ codegen-matrix: standard
//@ normalize-stdout-test: "(?s).+" -> ""
//@ run-call: fits => true

// A shared 12 KiB constant must stay in program data instead of being expanded into
// word stores at four ABI layouts. The hex literal was generated with
// random.Random(2502).randbytes(12288); all bytes, including zero, are significant.
interface LargeLiteralSink {
    function a(bytes calldata) external;
    function b(uint256, bytes calldata) external;
    function c(bytes calldata, uint256) external;
    function d(uint256, uint256, bytes calldata) external;
}

contract LargeInput {
    bytes constant DATA = hex"";

    function run(LargeLiteralSink sink, uint256 n) external {
        sink.a(DATA);
        sink.b(n, DATA);
        sink.c(DATA, n);
        sink.d(n, n, DATA);
    }
}


contract LiteralInputCodeSize {
    function fits() external pure returns (bool) {
        return type(LargeInput).runtimeCode.length <= 24576;
    }
}

