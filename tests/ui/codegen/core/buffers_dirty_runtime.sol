// A builder's backing is not zeroed here: this compiler leaves the memory as
// it finds it, and the hash of four words staged past the free memory pointer
// leaves that memory dirty right where the backing is allocated. Nothing a
// program can do with the result sees the difference: conversions, hashes,
// encodings, concatenation and storage all read only what was written, and
// return what a zeroed backing returns.
import {Buffers, ByteBuilder, WordBuilder} from "solar:core/Buffers.sol";

contract Test {
    using Buffers for ByteBuilder;
    using Buffers for WordBuilder;

    bytes private stored;
    uint256[] private storedWords;

    function dirty() internal pure returns (bytes32) {
        uint256 ones = type(uint256).max;
        return keccak256(abi.encode(ones, ones, ones, ones));
    }

    function built(uint256 n) internal pure returns (bytes32 h, bytes memory r) {
        h = dirty();
        ByteBuilder memory builder = Buffers.create(64);
        for (uint256 i; i < n; ++i) {
            builder.appendByte(bytes1(uint8(i + 1)));
        }
        r = builder.finish();
    }

    function conversions(uint256 n) public pure returns (bytes32, bytes32, bytes4, bytes32, uint256) {
        (bytes32 h, bytes memory r) = built(n);
        return (h, bytes32(r), bytes4(r), keccak256(r), r.length);
    }

    function encodings(uint256 n)
        public
        pure
        returns (bytes32, bytes memory, bytes memory, bytes memory, string memory)
    {
        (bytes32 h, bytes memory r) = built(n);
        return (h, abi.encode(r), abi.encodePacked(r, uint8(9)), bytes.concat(r, r), string(r));
    }

    function returned(uint256 n) public pure returns (bytes32, bytes memory) {
        return built(n);
    }

    function kept(uint256 n) public returns (bytes32 h, bytes memory) {
        bytes memory r;
        (h, r) = built(n);
        stored = r;
        return (h, stored);
    }

    function words(uint256 n) public returns (bytes32 h, uint256[] memory, bytes32, uint256[] memory) {
        h = dirty();
        WordBuilder memory builder = Buffers.createWords(8);
        for (uint256 i; i < n; ++i) {
            builder.append(i + 1);
        }
        uint256[] memory w = builder.finish();
        storedWords = w;
        return (h, w, keccak256(abi.encodePacked(w)), storedWords);
    }
}
