// `Cast` narrows a value or fails with the overflow panic; it never drops
// bits. Each width is checked at both of its edges, signed ones on both sides
// of zero.
import {Cast} from "solar:core/v1/Cast.sol";

contract Test {
    function u8(uint256 x) public pure returns (uint8) {
        return Cast.toUint8(x);
    }

    function u40(uint256 x) public pure returns (uint40) {
        return Cast.toUint40(x);
    }

    function u248(uint256 x) public pure returns (uint248) {
        return Cast.toUint248(x);
    }

    function i8(int256 x) public pure returns (int8) {
        return Cast.toInt8(x);
    }

    function i128(int256 x) public pure returns (int128) {
        return Cast.toInt128(x);
    }

    function signed(uint256 x) public pure returns (int256) {
        return Cast.toInt256(x);
    }

    function unsigned(int256 x) public pure returns (uint256) {
        return Cast.toUint256(x);
    }
}
