// `blake2f` is the compression function of BLAKE2b: twelve rounds over the
// initial state and the block of `abc` give the published digest, and the
// same call with no rounds, or without the final flag, gives what a reference
// implementation gives. `p256Verify` accepts the RFC 6979 signature of
// `sample` and rejects it with one bit of the hash, the key or `r` changed.
// On a target before Osaka the address is an empty account, which answers
// with nothing, so the same valid signature is `false` there.
import {Precompiles} from "solar:core/v1/Precompiles.sol";

contract Test {
    function compress(
        uint32 rounds,
        bytes32[2] memory h,
        bytes32[4] memory m,
        bytes8[2] memory t,
        bool finalBlock
    ) public view returns (bool, bytes32[2] memory) {
        return Precompiles.blake2f(rounds, h, m, t, finalBlock);
    }

    function verify(bytes32 hash, uint256 r, uint256 s, uint256 x, uint256 y)
        public
        view
        returns (bool)
    {
        return Precompiles.p256Verify(hash, r, s, x, y);
    }
}
