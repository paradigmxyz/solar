// === ROOT/tests/ui/codegen/core/forward_lowering.sol:Test ===
@module Test
@phase lowered
@immutables
  implementation: uint160

fn @fallback() [abi_wrapper, fallback, payable] {
  bb0:
    v0: i256 = loadimmutable implementation
    v1 = calldatasize
    tail_call @forwardDelegate, v0, 0, v1
}

fn @forwardDelegate(arg0: i256, arg1: i256, arg2: i256) [inline_assembly] {
  bb0:
    v0 = mload 64 !metadata(memory=scratch)
    calldatacopy v0, arg1, arg2
    v5 = gas
    v6 = delegatecall v5, arg0, v0, arg2, 0, 0
    v8 = returndatasize
    returndatacopy v0, 0, v8
    jumpi v6, bb2, bb1
  bb1:
    v12 = returndatasize
    revert v0, v12
  bb2:
    v13 = returndatasize
    returndata v0, v13
}

fn @constructor() [abi_wrapper, constructor] {
  bb0:
    v2 = callvalue
    v3 = ne v2, 0
    jumpi v3, bb2, bb1
  bb1:
    v0: i256 = address
    mstore 192, v0
    ret
  bb2:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    tail_call @fallback
}
