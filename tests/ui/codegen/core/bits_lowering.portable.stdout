}

fn @entry() [entry] {
  bb0:
    v0 = callvalue
    v1 = calldatasize
    v2 = lt v1, 36
    v3 = or v0, v2
    jumpi v3, bb1, bb2
  bb2:
    v4 = calldataload 0
    v5 = shr 224, v4
    switch v5, default bb1, [0x3ce23483 => bb3, 0x5b348c5a => bb4, 0xb2f925a4 => bb5]
  bb5:
    tail_call @ones
  bb4:
    tail_call @trailing
  bb3:
    tail_call @leading
  bb1:
    revert 0, 0
}
