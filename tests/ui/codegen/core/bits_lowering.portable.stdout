fn @leading() [selector=0x3ce23483, abi_wrapper, pure] {
  bb0:
    v0 = icall @leadingZeros, arg0
    mstore 128, v0
    returndata 128, 32
}

fn @trailing() [selector=0x5b348c5a, abi_wrapper, pure] {
  bb0:
    jumpi arg0, bb2, bb1
  bb2:
    v1 = not arg0
    v7 = add v1, 1
    v3 = and arg0, v7
    v4 = icall @leadingZeros, v3
    v9 = sub 255, v4
    v10 = lt 255, v4
    jumpi v10, bb3, bb1
  bb1:
    v6 = phi [bb0: 256], [bb2: v9]
    mstore 128, v6
    returndata 128, 32
  bb3:
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    mstore 32, 17 !metadata(memory=scratch)
    revert 28, 36
}

fn @ones() [selector=0xb2f925a4, abi_wrapper, pure] {
  bb0:
    v1 = and arg0, 1
    v3 = shr 2, arg0
    v4 = and v3, 0x5555555555555555555555555555555555555555555555555555555555555555
    v2 = shr 1, arg0
    v5 = sub v2, v4
    v7 = shr 2, v5
    v8 = and v7, 0x3333333333333333333333333333333333333333333333333333333333333333
    v6 = and v5, 0x3333333333333333333333333333333333333333333333333333333333333333
    v9 = add v6, v8
    v10 = shr 4, v9
    v11 = add v9, v10
    v12 = and v11, 0xf0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f
    v13 = mul v12, 0x101010101010101010101010101010101010101010101010101010101010101
    v14 = shr 248, v13
    v15 = add v14, v1
    mstore 128, v15
    returndata 128, 32
}

fn @leadingZeros(arg0: u256) -> u256 [pure] {
  bb0:
    jumpi arg0, bb2, bb1
  bb1:
    ret 256
  bb2:
    v1 = shr 128, arg0
    v61 = iszero v1
    v62 = iszero v61
    v4 = shl 128, arg0
    v64 = shl 7, v61
    v65 = sub arg0, v4
    v66 = mul v62, v65
    v67 = add v4, v66
    v7 = shr 192, v67
