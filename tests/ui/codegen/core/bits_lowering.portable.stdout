    returndata 128, 32
}

fn @highest() [selector=0xe076913c, abi_wrapper, pure] {
  bb0:
    v0 = icall @highestSetBit, arg0
    mstore 128, v0
    returndata 128, 32
}

fn @trailing() [selector=0x5b348c5a, abi_wrapper, pure] {
  bb0:
    v1 = sub 0, arg0
    v2 = and arg0, v1
    v3 = icall @highestSetBit, v2
