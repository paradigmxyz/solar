  bb3:
    v47 = add v64, 64
    v10 = shl 64, v67
    jump bb4
  bb4:
    v11 = phi [bb3: v47], [bb2: v64]
    v12 = phi [bb3: v10], [bb2: v67]
    v13 = shr 224, v12
    jumpi v13, bb6, bb5
  bb5:
    v49 = add v11, 32
    v16 = shl 32, v12
    jump bb6
  bb6:
    v17 = phi [bb5: v49], [bb4: v11]
    v18 = phi [bb5: v16], [bb4: v12]
    v19 = shr 240, v18
    jumpi v19, bb8, bb7
  bb7:
    v51 = add v17, 16
    v22 = shl 16, v18
    jump bb8
  bb8:
    v23 = phi [bb7: v51], [bb6: v17]
    v24 = phi [bb7: v22], [bb6: v18]
    v25 = shr 248, v24
    jumpi v25, bb10, bb9
  bb9:
    v53 = add v23, 8
    v28 = shl 8, v24
    jump bb10
  bb10:
    v29 = phi [bb9: v53], [bb8: v23]
    v30 = phi [bb9: v28], [bb8: v24]
    v31 = shr 252, v30
    jumpi v31, bb12, bb11
  bb11:
    v55 = add v29, 4
    v34 = shl 4, v30
    jump bb12
  bb12:
    v35 = phi [bb11: v55], [bb10: v29]
    v36 = phi [bb11: v34], [bb10: v30]
    v37 = shr 254, v36
    jumpi v37, bb14, bb13
  bb13:
    v57 = add v35, 2
    v40 = shl 2, v36
    jump bb14
  bb14:
    v41 = phi [bb13: v57], [bb12: v35]
    v42 = phi [bb13: v40], [bb12: v36]
    v43 = shr 255, v42
    v68 = iszero v43
