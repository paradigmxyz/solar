fn @toInt8(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = slt arg0, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff80
    jumpi v0, bb2, bb1
  bb1:
    v1 = sgt arg0, 127
    jump bb3
  bb2:
    jump bb3
  bb3:
    v2 = phi [bb1: v1], [bb2: true]
    jumpi v2, bb4, bb5
  bb5:
    jump bb6
  bb4:
    icall @_overflow
    jump bb6
  bb6:
    v3 = signextend 0, arg0
    ret v3
}

fn @toInt128(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = slt arg0, 0xffffffffffffffffffffffffffffffff80000000000000000000000000000000
    jumpi v0, bb2, bb1
  bb1:
    v1 = sgt arg0, 0x7fffffffffffffffffffffffffffffff
    jump bb3
  bb2:
    jump bb3
  bb3:
    v2 = phi [bb1: v1], [bb2: true]
    jumpi v2, bb4, bb5
  bb5:
    jump bb6
  bb4:
    icall @_overflow
    jump bb6
  bb6:
    v3 = signextend 15, arg0
    ret v3
}

