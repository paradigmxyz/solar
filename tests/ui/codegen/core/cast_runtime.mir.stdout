fn @toUint8(arg0: i256) -> i256 [pure] {
  bb0:
    v0 = gt arg0, 255
    jumpi v0, bb1, bb2
  bb2:
    jump bb3
  bb1:
    icall @_overflow
    jump bb3
  bb3:
    v1 = and arg0, 255
    ret v1
}

