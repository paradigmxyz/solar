// === ROOT/tests/ui/codegen/core/forward_lowering.sol:Test ===
@module Test
@phase lowered
@immutables
  implementation: u160

fn @fallback() [abi_wrapper, fallback, payable] {
  bb0:
    v0: i256 = loadimmutable implementation
    v2 = calldatasize
    calldatacopy 0, 0, v2
    v6 = gas
    v8 = delegatecall v6, v0, 0, v2, 0, 0
    jumpi v8, bb1, bb2
  bb2:
    v11 = returndatasize
    returndatacopy 0, 0, v11 !metadata(memory=abi_return)
    v12 = returndatasize
    revert 0, v12
  bb1:
    v9 = returndatasize
    returndatacopy 0, 0, v9 !metadata(memory=abi_return)
    v10 = returndatasize
    returndata 0, v10
}

fn @constructor() [abi_wrapper, constructor] {
  bb0:
    v2 = callvalue
    v3 = ne v2, 0
    jumpi v3, bb2, bb1
  bb1:
    v0: i256 = address
    mstore 192, v0
    ret
  bb2:
    revert 0, 0
}

fn @entry() [entry] {
  bb0:
    tail_call @fallback
}
