// `@custom:solar-view` on an `abi.decode` declaration reads the decoded `bytes`
// and `string` values where they are, in memory or calldata, and must behave
// exactly like the copying decode, which is what the `portable` revision runs:
// the same values, the same reverts on malformed input, and `Panic(0x41)` for
// lengths no copy could allocate.
import {Bytes} from "solar:core/v1/Bytes.sol";
import {Hash} from "solar:core/v1/Hash.sol";

contract Test {
    using Bytes for bytes;

    function fromMemory(bytes memory data)
        public
        pure
        returns (uint256 id, bytes32 hash, uint256 length, bytes1 last)
    {
        /// @custom:solar-view
        (uint256 n, bytes memory payload) = abi.decode(data, (uint256, bytes));
        id = n;
        hash = keccak256(payload);
        length = payload.length;
        if (length != 0) last = payload[length - 1];
    }

    // A view of calldata reads calldata, and hashing it copies the bytes past
    // the free memory pointer without allocating.
    function fromCalldata(bytes calldata data)
        external
        pure
        returns (uint256 id, bytes32 hash, uint256 length, bytes1 last)
    {
        /// @custom:solar-view
        (uint256 n, bytes memory payload) = abi.decode(data, (uint256, bytes));
        id = n;
        hash = keccak256(payload);
        length = payload.length;
        if (length != 0) last = payload[length - 1];
    }

    // Value fields are validated as in any decode.
    function tagged(bytes calldata data) external pure returns (uint8, uint256) {
        /// @custom:solar-view
        (uint8 tag, bytes memory payload) = abi.decode(data, (uint8, bytes));
        return (tag, payload.length);
    }

    function flagged(bytes calldata data)
        external
        pure
        returns (bool fromCalldata, uint256 calldataLength, bool fromMemory, uint256 memoryLength)
    {
        /// @custom:solar-view
        (bool flag, bytes memory payload) = abi.decode(data, (bool, bytes));
        (fromCalldata, calldataLength) = (flag, payload.length);
        bytes memory copy = data;
        /// @custom:solar-view
        (bool memoryFlag, bytes memory memoryPayload) = abi.decode(copy, (bool, bytes));
        (fromMemory, memoryLength) = (memoryFlag, memoryPayload.length);
    }

    function pair(bytes calldata data) external pure returns (bytes32 a, bytes32 b, uint256 total) {
        /// @custom:solar-view
        (bytes memory x, string memory s, bytes memory y) = abi.decode(data, (bytes, string, bytes));
        a = keccak256(x);
        b = keccak256(bytes(s));
        total = x.length + bytes(s).length + y.length;
    }

    function single(bytes memory data) public pure returns (uint256) {
        /// @custom:solar-view
        bytes memory v = abi.decode(data, (bytes));
        return v.length;
    }

    // The range reads of the core modules read calldata views in place.
    function reads(bytes calldata data)
        external
        pure
        returns (uint256 word, bytes4 tag, bool ok, uint256 tried, bytes memory out)
    {
        /// @custom:solar-view
        (bytes memory payload) = abi.decode(data, (bytes));
        word = payload.readUint256BE(0);
        tag = payload.readBytes4(32);
        (ok, tried) = payload.tryReadUint256BE(4);
        out = new bytes(4);
        Bytes.copyInto(out, 0, payload, 1, 4);
    }

    function narrowed(bytes calldata data) external pure returns (bytes32 whole, bytes32 part) {
        /// @custom:solar-view
        (bytes memory payload) = abi.decode(data, (bytes));
        /// @custom:solar-view
        bytes memory inner = payload.slice(1, 3);
        whole = keccak256(inner);
        part = Hash.keccak256Range(payload, 1, 3);
    }

    function equalsIn(bytes calldata data, bytes memory needle) external pure returns (bool) {
        /// @custom:solar-view
        (bytes memory payload) = abi.decode(data, (bytes));
        return payload.equalsAt(1, needle);
    }

    function equalsOut(bytes calldata data, bytes memory haystack) external pure returns (bool) {
        /// @custom:solar-view
        (bytes memory needle) = abi.decode(data, (bytes));
        return haystack.equalsAt(2, needle);
    }

    function equalsBoth(bytes calldata data) external pure returns (bool) {
        /// @custom:solar-view
        (bytes memory x, bytes memory y) = abi.decode(data, (bytes, bytes));
        return x.equalsAt(0, y);
    }

    // An untagged decode of a view decodes its bytes in place into copies.
    function nested(bytes calldata data)
        external
        pure
        returns (uint256 a, address b, bytes memory tail)
    {
        /// @custom:solar-view
        (bytes memory inner) = abi.decode(data, (bytes));
        (a, b, tail) = abi.decode(inner, (uint256, address, bytes));
    }

    function nestedMemory(bytes memory data)
        public
        pure
        returns (uint256 a, bytes memory tail, bytes memory original)
    {
        /// @custom:solar-view
        bytes memory body = data.slice(4, data.length - 4);
        (a, tail) = abi.decode(body, (uint256, bytes));
        tail[0] = 0xff;
        original = data;
    }

    function staticNested(bytes memory data) public pure returns (uint256 x, address y) {
        /// @custom:solar-view
        bytes memory body = data.slice(4, data.length - 4);
        (x, y) = abi.decode(body, (uint256, address));
    }
}
