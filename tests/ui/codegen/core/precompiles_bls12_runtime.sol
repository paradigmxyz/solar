// The BLS12-381 wrappers (EIP-2537) and KZG point evaluation (EIP-4844) of
// `Precompiles`, on vectors a reference implementation produced: the
// generators of G1 and G2 doubled by addition and by multiplication, a point
// and its negation summing to the point at infinity, the pairing identity
// e(G, H) e(-G, H) = 1, the field-to-curve maps, and the proof that the zero
// polynomial is zero at 1. A point off the curve, an element not below the
// modulus, a false evaluation and an input of the wrong length all fail.
import {Precompiles} from "solar:core/Precompiles.sol";

contract Test {
    function g1Add(bytes memory a, bytes memory b) public view returns (bool, bytes memory) {
        return Precompiles.bls12G1Add(a, b);
    }

    function g1Msm(bytes memory pairs) public view returns (bool, bytes memory) {
        return Precompiles.bls12G1Msm(pairs);
    }

    function g2Add(bytes memory a, bytes memory b) public view returns (bool, bytes memory) {
        return Precompiles.bls12G2Add(a, b);
    }

    function g2Msm(bytes memory pairs) public view returns (bool, bytes memory) {
        return Precompiles.bls12G2Msm(pairs);
    }

    function pairing(bytes memory pairs) public view returns (bool, bool) {
        return Precompiles.bls12Pairing(pairs);
    }

    function mapToG1(bytes memory element) public view returns (bool, bytes memory) {
        return Precompiles.bls12MapFpToG1(element);
    }

    function mapToG2(bytes memory element) public view returns (bool, bytes memory) {
        return Precompiles.bls12MapFp2ToG2(element);
    }

    function evaluate(bytes32 versionedHash, uint256 z, uint256 y, bytes memory commitment, bytes memory proof)
        public
        view
        returns (bool)
    {
        return Precompiles.pointEvaluation(versionedHash, z, y, commitment, proof);
    }
}
