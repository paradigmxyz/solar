// `@custom:solar-view` on an `abi.decode` declaration makes every array, struct,
// `bytes`, and `string` value a view of its encoding, in memory or calldata, and
// reads elements and fields in place. It must behave exactly like the copying
// decode, which the `portable` revision runs: the same values, the same reverts
// on malformed input, and `Panic(0x41)` for lengths no copy could allocate.
contract Test {
    enum Color {
        Red,
        Green,
        Blue
    }

    type Price is uint128;

    struct Inner {
        uint8 a;
        bytes b;
    }

    struct Outer {
        Inner[] inners;
        uint256[2] pair;
        string name;
        bool flag;
    }

    struct Point {
        uint64 x;
        address y;
        bytes4 z;
    }

    function mix(bytes32 h, uint256 v) internal pure returns (bytes32) {
        return keccak256(abi.encode(h, v));
    }

    function nestedMemory(bytes memory data) public pure returns (bytes32 h) {
        /// @custom:solar-view
        (uint256[][] memory rows, string[] memory names, Outer memory outer) =
            abi.decode(data, (uint256[][], string[], Outer));
        for (uint256 i; i < rows.length; ++i) {
            /// @custom:solar-view
            uint256[] memory row = rows[i];
            for (uint256 j; j < row.length; ++j) h = mix(h, row[j] + rows[i][j]);
        }
        for (uint256 i; i < names.length; ++i) {
            h = mix(h, bytes(names[i]).length);
            h = mix(h, uint256(keccak256(bytes(names[i]))));
        }
        for (uint256 i; i < outer.inners.length; ++i) {
            /// @custom:solar-view
            Inner memory inner = outer.inners[i];
            h = mix(h, inner.a);
            h = mix(h, uint256(keccak256(inner.b)));
            if (inner.b.length != 0) h = mix(h, uint8(inner.b[0]));
        }
        h = mix(h, outer.pair[0] ^ outer.pair[1]);
        h = mix(h, uint256(keccak256(bytes(outer.name))));
        h = mix(h, outer.flag ? 1 : 2);
    }

    function nestedCalldata(bytes calldata data) external pure returns (bytes32 h) {
        /// @custom:solar-view
        (uint256[][] memory rows, string[] memory names, Outer memory outer) =
            abi.decode(data, (uint256[][], string[], Outer));
        for (uint256 i; i < rows.length; ++i) {
            /// @custom:solar-view
            uint256[] memory row = rows[i];
            for (uint256 j; j < row.length; ++j) h = mix(h, row[j] + rows[i][j]);
        }
        for (uint256 i; i < names.length; ++i) {
            h = mix(h, bytes(names[i]).length);
            h = mix(h, uint256(keccak256(bytes(names[i]))));
        }
        for (uint256 i; i < outer.inners.length; ++i) {
            /// @custom:solar-view
            Inner memory inner = outer.inners[i];
            h = mix(h, inner.a);
            h = mix(h, uint256(keccak256(inner.b)));
            if (inner.b.length != 0) h = mix(h, uint8(inner.b[0]));
        }
        h = mix(h, outer.pair[0] ^ outer.pair[1]);
        h = mix(h, uint256(keccak256(bytes(outer.name))));
        h = mix(h, outer.flag ? 1 : 2);
    }

    // Static arrays and structs lie in the heads of their encoding.
    function points(bytes calldata data) external pure returns (bytes32 h) {
        /// @custom:solar-view
        (uint256[3] memory words, bytes[2] memory blobs, Point[2] memory ps) =
            abi.decode(data, (uint256[3], bytes[2], Point[2]));
        for (uint256 i; i < words.length; ++i) h = mix(h, words[i]);
        for (uint256 i; i < blobs.length; ++i) h = mix(h, uint256(keccak256(blobs[i])));
        for (uint256 i; i < ps.length; ++i) {
            h = mix(h, ps[i].x);
            h = mix(h, uint160(ps[i].y));
            h = mix(h, uint32(ps[i].z));
        }
    }

    // Every element was validated by the decode.
    function values(bytes memory data) public pure returns (bytes32 h) {
        /// @custom:solar-view
        (Color[] memory colors, bool[] memory flags, int8[] memory small, bytes7[] memory tags, Price[] memory prices) =
            abi.decode(data, (Color[], bool[], int8[], bytes7[], Price[]));
        for (uint256 i; i < colors.length; ++i) h = mix(h, uint256(colors[i]));
        for (uint256 i; i < flags.length; ++i) h = mix(h, flags[i] ? 3 : 4);
        for (uint256 i; i < small.length; ++i) h = mix(h, uint256(int256(small[i])));
        for (uint256 i; i < tags.length; ++i) h = mix(h, uint256(bytes32(tags[i])));
        for (uint256 i; i < prices.length; ++i) h = mix(h, Price.unwrap(prices[i]));
    }

    // An element view decodes in place too.
    function decodeElements(bytes calldata data) external pure returns (bytes32 h) {
        /// @custom:solar-view
        (bytes[] memory items) = abi.decode(data, (bytes[]));
        for (uint256 i; i < items.length; ++i) {
            /// @custom:solar-view
            (uint256 x, bytes memory rest) = abi.decode(items[i], (uint256, bytes));
            h = mix(h, x);
            h = mix(h, uint256(keccak256(rest)));
        }
    }

    // The views replay every allocation the copying decode makes, so the copy of the last value
    // is the one that no longer fits below 2^64 exactly where it would: when `over` is set, its
    // length word and bytes end at 2^64, and otherwise 32 bytes before, where the length fails
    // the range check instead.
    function arrayThreshold(bool over) public pure returns (uint256) {
        bytes memory data = abi.encode(new bytes[](2));
        uint256 end;
        assembly {
            end := mload(0x40)
        }
        // The copies of the array's three words and of the first element's length word.
        end += 128;
        uint256 length = (1 << 64) - end - 32 - (over ? 0 : 32);
        assembly {
            mstore(add(data, 0xc0), length)
        }
        /// @custom:solar-view
        (bytes[] memory items) = abi.decode(data, (bytes[]));
        return items.length;
    }

    function wordThreshold(bool over) public pure returns (uint256) {
        bytes memory data = abi.encode(new uint256[](3), bytes(""));
        uint256 end;
        assembly {
            end := mload(0x40)
        }
        // The copy of the array: its length and three words.
        end += 128;
        uint256 length = (1 << 64) - end - 32 - (over ? 0 : 32);
        assembly {
            mstore(add(data, 0xe0), length)
        }
        /// @custom:solar-view
        (uint256[] memory words, bytes memory tail) = abi.decode(data, (uint256[], bytes));
        return words.length + tail.length;
    }

    function structThreshold(bool over) public pure returns (uint256) {
        bytes memory data = abi.encode(Inner(1, ""));
        uint256 end;
        assembly {
            end := mload(0x40)
        }
        // The copy of the struct's two fields.
        end += 64;
        uint256 length = (1 << 64) - end - 32 - (over ? 0 : 32);
        assembly {
            mstore(add(data, 0x80), length)
        }
        /// @custom:solar-view
        (Inner memory inner) = abi.decode(data, (Inner));
        return inner.a + inner.b.length;
    }

    function index(bytes memory data, uint256 i, uint256 j) public pure returns (uint256) {
        /// @custom:solar-view
        (uint256[][] memory rows) = abi.decode(data, (uint256[][]));
        return rows[i][j];
    }
}
