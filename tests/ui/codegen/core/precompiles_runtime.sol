// `Precompiles` reports whether the precompile accepted its input apart from
// what it computed: a point off the curve and a pairing input of the wrong
// length are `false` with zeroed results, never a stale or padded answer.
// `2**256 % 253` is 31, returned at the modulus's full 33 bytes.
import {Precompiles} from "solar:core/v1/Precompiles.sol";

contract Test {
    function modexp(bytes memory base, bytes memory exponent, bytes memory modulus)
        public
        view
        returns (bool, bytes memory)
    {
        return Precompiles.modexp(base, exponent, modulus);
    }

    function ecAdd(uint256 x1, uint256 y1, uint256 x2, uint256 y2)
        public
        view
        returns (bool, uint256, uint256)
    {
        return Precompiles.ecAdd(x1, y1, x2, y2);
    }

    function ecMul(uint256 x, uint256 y, uint256 scalar) public view returns (bool, uint256, uint256) {
        return Precompiles.ecMul(x, y, scalar);
    }

    function ecPairing(bytes memory input) public view returns (bool, bool) {
        return Precompiles.ecPairing(input);
    }
}
