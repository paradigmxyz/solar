// `abi.decode(abi.encode(v), (T))` copies a view `v` of type `T` into an
// ordinary value, independent of the bytes the view reads: writes to the copy
// leave the source alone. Views in memory and in calldata, a view of an
// element, and a view parameter given either an object or a view all copy.
contract Test {
    struct Order {
        uint256 id;
        bytes payload;
        uint64[] amounts;
    }

    function fromMemory(bytes memory data) public pure returns (bytes memory, bytes32) {
        /// @custom:solar-view
        (Order memory order, bytes[] memory items) = abi.decode(data, (Order, bytes[]));
        (Order memory copy, bytes[] memory itemsCopy) =
            abi.decode(abi.encode(order, items), (Order, bytes[]));
        copy.id += 1;
        copy.amounts[0] = 7;
        copy.payload[0] = 0xff;
        itemsCopy[0] = "changed";
        return (abi.encode(copy, itemsCopy), keccak256(data));
    }

    function fromCalldata(bytes calldata data) external pure returns (bytes memory) {
        /// @custom:solar-view
        (Order memory order, bytes[] memory items) = abi.decode(data, (Order, bytes[]));
        Order memory copy = abi.decode(abi.encode(order), (Order));
        bytes[] memory itemsCopy = abi.decode(abi.encode(items), (bytes[]));
        copy.amounts[1] += 1;
        itemsCopy[1] = "x";
        return abi.encode(copy, itemsCopy);
    }

    function element(bytes memory data) public pure returns (bytes memory, bytes memory) {
        /// @custom:solar-view
        (bytes[] memory items) = abi.decode(data, (bytes[]));
        /// @custom:solar-view
        bytes memory first = items[0];
        bytes memory copy = abi.decode(abi.encode(first), (bytes));
        copy[0] = 0x00;
        return (copy, data);
    }

    /// @custom:solar-view order
    function cloned(Order memory order) internal pure returns (Order memory copy) {
        copy = abi.decode(abi.encode(order), (Order));
        copy.id = 99;
    }

    function fromObject(uint256 seed) public pure returns (uint256, uint256, uint256) {
        uint64[] memory amounts = new uint64[](1);
        amounts[0] = uint64(seed);
        Order memory order = Order(seed, "p", amounts);
        Order memory copy = cloned(order);
        copy.amounts[0] = 5;
        return (order.id, copy.id, order.amounts[0]);
    }

    function fromView(bytes calldata data) external pure returns (uint256, uint256, bytes memory) {
        /// @custom:solar-view
        (Order memory order) = abi.decode(data, (Order));
        Order memory copy = cloned(order);
        return (order.id, copy.id, copy.payload);
    }
}
