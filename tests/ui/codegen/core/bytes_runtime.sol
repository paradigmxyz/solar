import {Bytes} from "solar:core/v1/Bytes.sol";

contract Test {
    function read1(bytes memory b, uint256 o) public pure returns (bytes1) {
        return Bytes.readBytes1(b, o);
    }

    function read4(bytes memory b, uint256 o) public pure returns (bytes4) {
        return Bytes.readBytes4(b, o);
    }

    function read20(bytes memory b, uint256 o) public pure returns (bytes20) {
        return Bytes.readBytes20(b, o);
    }

    function read32(bytes memory b, uint256 o) public pure returns (bytes32) {
        return Bytes.readBytes32(b, o);
    }

    function readWord(bytes memory b, uint256 o) public pure returns (uint256) {
        return Bytes.readUint256BE(b, o);
    }

    function write1(bytes memory b, uint256 o, bytes1 v) public pure returns (bytes memory) {
        Bytes.writeBytes1(b, o, v);
        return b;
    }

    function write4(bytes memory b, uint256 o, bytes4 v) public pure returns (bytes memory) {
        Bytes.writeBytes4(b, o, v);
        return b;
    }

    function write32(bytes memory b, uint256 o, bytes32 v) public pure returns (bytes memory) {
        Bytes.writeBytes32(b, o, v);
        return b;
    }

    function writeWord(bytes memory b, uint256 o, uint256 v) public pure returns (bytes memory) {
        Bytes.writeUint256BE(b, o, v);
        return b;
    }

    function copyBetween(bytes memory d, uint256 dOff, bytes memory s, uint256 sOff, uint256 n)
        public
        pure
        returns (bytes memory)
    {
        Bytes.copyInto(d, dOff, s, sOff, n);
        return d;
    }

    function move(bytes memory b, uint256 dOff, uint256 sOff, uint256 n)
        public
        pure
        returns (bytes memory)
    {
        Bytes.copyInto(b, dOff, b, sOff, n);
        return b;
    }

    function fill(bytes memory b, uint256 o, uint256 n, bytes1 v) public pure returns (bytes memory) {
        Bytes.fill(b, o, n, v);
        return b;
    }
}
