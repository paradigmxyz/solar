// An ABI encoding that takes a `@custom:solar-view` copies it from where the
// view reads it, in memory or calldata, into its output, in the canonical form
// a copy of it would have, whatever offsets its input used. It must behave
// exactly like encoding the copy, which the `portable` revision runs.
import {Bytes} from "solar:core/v1/Bytes.sol";

contract Test {
    using Bytes for bytes;

    struct Order {
        uint256 id;
        bytes payload;
        uint64[] amounts;
    }

    struct Point {
        uint64 x;
        address y;
    }

    error Failed(bytes data, Order order);

    function target(Order calldata order, bytes[] calldata items) external pure returns (bytes32) {
        return keccak256(abi.encode(order, items));
    }

    function encodeAll(bytes memory data) public pure returns (bytes memory) {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        return abi.encode(b, s, words, items, order);
    }

    function encodeAllCalldata(bytes calldata data) external pure returns (bytes memory) {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        return abi.encode(b, s, words, items, order);
    }

    function encodeNested(bytes calldata data) external pure returns (bytes memory) {
        /// @custom:solar-view
        (Point[2] memory points, uint256[][] memory rows, Order[] memory orders) =
            abi.decode(data, (Point[2], uint256[][], Order[]));
        return abi.encode(points, rows, orders, rows[0], orders[0].payload);
    }

    function encodeElements(bytes memory data) public pure returns (bytes memory) {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        return abi.encodeWithSelector(0x12345678, items[1], order.payload, order.amounts, words, s, b);
    }

    // External call arguments and `abi.encodeCall` take views too.
    function encodeCalls(bytes calldata data) external view returns (bytes memory, bytes32) {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        bytes memory call = abi.encodeCall(this.target, (order, items));
        bytes32 answer = this.target(order, items);
        return (call, keccak256(abi.encodeWithSignature("f(bytes,string,uint256[])", b, s, words)) ^ answer);
    }

    function packed(bytes memory data) public pure returns (bytes memory, bytes32) {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        return (
            abi.encodePacked(b, s, words, items[0], order.amounts),
            keccak256(abi.encodePacked(order.payload, words, b))
        );
    }

    function concat(bytes calldata data) external pure returns (bytes memory, string memory) {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        return (
            bytes.concat(b, "-", items[0], bytes4(0x01020304), order.payload, bytes32(words[0])),
            string.concat(s, "!", s)
        );
    }

    function revertWith(bytes memory data) public pure {
        /// @custom:solar-view
        (bytes memory b, string memory s, uint256[] memory words, bytes[] memory items, Order memory order) =
            abi.decode(data, (bytes, string, uint256[], bytes[], Order));
        if (words.length > 1) revert(s);
        require(items.length > 1, s);
        revert Failed(b, order);
    }

    // A view of a range encodes the range.
    function encodeRange(bytes memory data) public pure returns (bytes memory) {
        /// @custom:solar-view
        bytes memory middle = data.slice(1, data.length - 2);
        return abi.encode(middle, bytes.concat(middle, middle));
    }
}
