// A `@custom:solar-view` parameter of an array or struct type takes the
// caller's object, which the function reads as any object is read, or a view
// of the encoding the value was decoded from, in memory or calldata, which a
// copy of the function reads in place. Other compilers pass the object, which
// the `portable` revision runs, with the same results.
contract Test {
    struct Order {
        uint256 id;
        bytes payload;
        uint64[] amounts;
    }

    /// @custom:solar-view xs
    function sum(uint64[] memory xs) internal pure returns (uint256 total) {
        for (uint256 i; i < xs.length; ++i) total += xs[i];
    }

    /// @custom:solar-view order
    function digest(Order memory order) internal pure returns (bytes32) {
        return keccak256(abi.encode(order.id, keccak256(order.payload), sum(order.amounts), order));
    }

    /// @custom:solar-view items
    function measure(bytes[] memory items) internal pure returns (uint256 total, bytes32 h) {
        for (uint256 i; i < items.length; ++i) {
            total += items[i].length;
            h = keccak256(abi.encode(h, keccak256(items[i])));
        }
        if (items.length != 0 && items[0].length >= 32) {
            (uint256 head) = abi.decode(items[0], (uint256));
            total += head % 1000;
        }
        h = keccak256(bytes.concat(h, items.length == 0 ? bytes("") : bytes("x")));
    }

    /// @custom:solar-view rows
    function grid(uint256[][] memory rows) internal pure returns (uint256 total) {
        for (uint256 i; i < rows.length; ++i) {
            /// @custom:solar-view
            uint256[] memory row = rows[i];
            for (uint256 j; j < row.length; ++j) total += row[j] * (i + 1);
        }
    }

    /// @custom:solar-view orders
    function chain(Order[] memory orders, uint256 i) internal pure returns (uint256) {
        if (i == orders.length) return 0;
        return uint256(digest(orders[i])) % 1000 + chain(orders, i + 1);
    }

    function fromObjects(uint256 seed) public pure returns (uint256, bytes32, uint256, uint256) {
        uint64[] memory amounts = new uint64[](3);
        amounts[0] = uint64(seed);
        amounts[2] = 9;
        Order memory order = Order(seed, abi.encode(seed, seed), amounts);
        bytes[] memory items = new bytes[](2);
        items[0] = abi.encode(seed * 3);
        uint256[][] memory rows = new uint256[][](2);
        rows[1] = new uint256[](2);
        rows[1][1] = seed;
        Order[] memory orders = new Order[](2);
        orders[0] = order;
        orders[1] = order;
        (uint256 total, bytes32 h) = measure(items);
        return (total, h ^ digest(order), grid(rows), chain(orders, 0));
    }

    function fromMemory(bytes memory data) public pure returns (uint256, bytes32, uint256, uint256) {
        /// @custom:solar-view
        (Order memory order, bytes[] memory items, uint256[][] memory rows, Order[] memory orders) =
            abi.decode(data, (Order, bytes[], uint256[][], Order[]));
        (uint256 total, bytes32 h) = measure(items);
        return (total, h ^ digest(order), grid(rows), chain(orders, 0));
    }

    function fromCalldata(bytes calldata data) external pure returns (uint256, bytes32, uint256, uint256) {
        /// @custom:solar-view
        (Order memory order, bytes[] memory items, uint256[][] memory rows, Order[] memory orders) =
            abi.decode(data, (Order, bytes[], uint256[][], Order[]));
        (uint256 total, bytes32 h) = measure(items);
        return (total, h ^ digest(order), grid(rows), chain(orders, 0));
    }

    // Views and objects mix in one call.
    function mixed(bytes calldata data, uint256 seed) external pure returns (bytes32, uint256) {
        /// @custom:solar-view
        (Order memory order, bytes[] memory items, uint256[][] memory rows, Order[] memory orders) =
            abi.decode(data, (Order, bytes[], uint256[][], Order[]));
        uint64[] memory amounts = new uint64[](1);
        amounts[0] = uint64(seed);
        Order memory local = Order(seed, items.length == 0 ? bytes("") : bytes("y"), amounts);
        return (digest(order) ^ digest(local), sum(order.amounts) + sum(amounts) + grid(rows) + chain(orders, 0));
    }
}
