// CHECK-NOT: "contracts"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract A {}"
    }
  },
  "settings": {
    "debug": {
      "debugInfo": ["snippet", "source"]
    },
    "outputSelection": {
      "*": {
        "*": [
          "evm.bytecode.object"
        ]
      }
    }
  }
}
