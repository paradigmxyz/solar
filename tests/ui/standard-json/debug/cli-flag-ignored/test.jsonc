//@ compile-flags: --revert-strings strip --evm-version paris -Zmir-pipeline=none
// Standard JSON does not inherit the command line's code generation options, like solc: the
// reason string stays in the bytecode, codegen runs the full MIR pipeline, and the metadata
// records no `debug` settings and the default EVM version.
// CHECK-NOT: "severity": "error"
// CHECK: "metadata":
// CHECK-NOT: revertStrings
// CHECK-NOT: paris
// CHECK: "deployedBytecode": {
// CHECK: 08c379a0
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract A { function f(uint256 x) external pure returns (uint256) { require(x == 1, \"x must be one\"); return x; } }"
    }
  },
  "settings": {
    "outputSelection": {
      "*": {
        "*": [
          "metadata",
          "evm.deployedBytecode.object"
        ]
      }
    }
  }
}
