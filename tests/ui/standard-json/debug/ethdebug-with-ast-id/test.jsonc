//@ normalize-stdout-test: "solar-[0-9a-f]{64}" -> "solar-COMPILATION_ID"
// `ethdebug` together with `ast-id` in `debugInfo` is accepted.
// CHECK-NOT: "severity": "error"
// CHECK: "abi":
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract A {}"
    }
  },
  "settings": {
    "debug": {
      "debugInfo": ["ast-id", "ethdebug"]
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "abi"
        ]
      }
    }
  }
}
