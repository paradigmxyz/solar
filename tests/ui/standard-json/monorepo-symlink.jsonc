//@ ignore-host: windows
//@ revisions: escape allowed
//@ compile-flags: --base-path ../../tests/ui/standard-json/monorepo/pkg
//@[allowed] compile-flags: --allow-paths ../../tests/ui/standard-json/monorepo/liblink
// Like solc, the command line checks the path of an import with symbolic links resolved against
// the allowed directories with symbolic links resolved. `pkg/deplink` links to `lib/dep`, outside
// the base path, and `liblink` links to `lib`.
{
  "language": "Solidity",
  "sources": {
    "src/A.sol": {"content": "import {C} from \"deplink/C.sol\";\n\ncontract A is C {}\n"}
  },
  "settings": {
    "outputSelection": {}
  }
}
