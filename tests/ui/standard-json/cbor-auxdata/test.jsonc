// CHECK-NEXT: }
// CHECK-NEXT: ],
// CHECK-NEXT: "A.sol:C": [
// CHECK-NEXT: {
// CHECK-NEXT: "offset":
// CHECK-NEXT: "value": "[[C:0xa2646970667358221220[0-9a-f]{64}65736f6c617243[0-9a-f]{6}0034]]"
// CHECK-NEXT: }
