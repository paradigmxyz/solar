//@ normalize-stdout-test: "solar-[0-9a-f]{64}" -> "solar-COMPILATION_ID"
//@ filecheck:
// Rewrites that orphan an operand move its origin onto the user without changing the bytecode
// or the legacy source map: the `sourceMap` snapshot in the `.stdout` must not change.
// CHECK-LABEL: "A": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "B": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "C": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract A {\n    function fold(uint256 x) external pure returns (uint256) {\n        unchecked {\n            return x + 1 + 2;\n        }\n    }\n\n    function inverted(uint256 x, uint256 y) external pure returns (uint256) {\n        if (!(x > y)) {\n            return 1;\n        }\n        return 2;\n    }\n\n    function both(uint256 x, uint256 y) external pure returns (uint256 r) {\n        unchecked {\n            if (!(x + 1 + 2 > y)) {\n                r = x * 7 + 1 + 2;\n            }\n        }\n    }\n}\n\ncontract B {\n    function fold(uint256 x) external pure returns (uint256) {\n        unchecked {\n            return x + 1 + 2;\n        }\n    }\n\n    function inverted(uint256 x, uint256 y) external pure returns (uint256) {\n        if (!(x > y)) {\n            return 1;\n        }\n        return 2;\n    }\n\n    function both(uint256 x, uint256 y) external pure returns (uint256 r) {\n        unchecked {\n            if (!(x + 1 + 2 > y)) {\n                r = x * 7 + 1 + 2;\n            }\n        }\n    }\n}\n\ncontract C {\n    function fold(uint256 x) external pure returns (uint256) {\n        unchecked {\n            return x + 1 + 2;\n        }\n    }\n\n    function inverted(uint256 x, uint256 y) external pure returns (uint256) {\n        if (!(x > y)) {\n            return 1;\n        }\n        return 2;\n    }\n\n    function both(uint256 x, uint256 y) external pure returns (uint256 r) {\n        unchecked {\n            if (!(x + 1 + 2 > y)) {\n                r = x * 7 + 1 + 2;\n            }\n        }\n    }\n}\n"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false,
      "bytecodeHash": "none"
    },
    "optimizer": {
      "enabled": true
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "evm.bytecode.object",
          "evm.bytecode.sourceMap",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.sourceMap"
        ],
        "B": [
          "evm.bytecode.object",
          "evm.bytecode.ethdebug",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.ethdebug"
        ],
        "C": [
          "evm.bytecode.object",
          "evm.deployedBytecode.object"
        ]
      }
    }
  }
}
