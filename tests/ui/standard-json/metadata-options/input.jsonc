  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "// SPDX-License-Identifier: MIT\nimport \"lib/B.sol\";\ncontract A { function value() external pure returns (uint256) { return B.value(); } }"
    },
    "src/B.sol": {
      "content": "// SPDX-License-Identifier: Apache-2.0\nlibrary B { function value() internal pure returns (uint256) { return 1; } }"
