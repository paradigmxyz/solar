// Consecutive `///` lines form one doc comment also when a lone CR ends them, as in solc.
// CHECK: "userdoc"
// CHECK: "f()"
// CHECK-NEXT: "notice": "first"
// CHECK: "devdoc"
// CHECK: "f()"
// CHECK-NEXT: "details": "second"
// CHECK: "g()"
// CHECK-NEXT: "details": "last"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract C {\r    /// @notice first\r    /// @dev second\r    function f() public {}\r\r    /// @notice ignored\r\r    /// @dev last\r    function g() public {}\r}\r"
    }
  },
  "settings": {
    "outputSelection": {
      "A.sol": {
        "*": ["userdoc", "devdoc"]
      }
    }
  }
}
