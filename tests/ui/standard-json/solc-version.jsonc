// `settings.solar.solcVersion` selects the language rules and the reported version.
// CHECK-NOT: "errorCode": "5333"
// CHECK: \"compiler\":{\"name\":\"solar\",\"version\":\"0.9.0+commit.
// CHECK-SAME: \"solar\":{\"solcVersion\":\"0.9.0\"}
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "pragma solidity ^0.9.0; contract C {}"
    }
  },
  "settings": {
    "solar": {
      "solcVersion": "0.9.0"
    },
    "outputSelection": {
      "A.sol": {
        "C": ["metadata"]
      }
    }
  }
}
