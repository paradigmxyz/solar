//@ filecheck:
// devdoc keeps `@return` tags like solc 0.8.38: a name with no text documents itself, a bare tag
// documents an empty text, and a tag that ends its `///` line takes its text from the next line.
// A getter's `return` keeps the whole tag text, and at each inheritance edge an inherited tag gets
// the return's name in front unless its text starts with it. solc keeps the blanks of `blankLine`'s second line,
// where we trim them.
// CHECK: "errorCode": "5856",
// CHECK-NEXT: "message": "tag `@return` references non-existent return parameter '@'",
// CHECK-NOT: "errorCode": "5856"
// CHECK-LABEL: "contracts": {
// CHECK-LABEL: "GetterReturn.sol": {
// CHECK: "inherited": {
// CHECK-NEXT: "return": "fresh Units",
// CHECK: "inheritedEmpty": {
// CHECK-NEXT: "return": "fresh ",
// CHECK: "named": {
// CHECK-NEXT: "return": "x the x",
// CHECK: "nameOnly": {
// CHECK-NEXT: "return": "x",
// CHECK: "sameAsName": {
// CHECK-NEXT: "return": "x x",
// CHECK: "unnamed": {
// CHECK-NEXT: "return": "plain",
// CHECK: "D": {
// CHECK: "throughUnnamed": {
// CHECK-NEXT: "return": "fresh Units",
// CHECK-NEXT: "returns": {
// CHECK-NEXT: "fresh": "Units"
// CHECK-LABEL: "NameOnly.sol": {
// CHECK: "block()": {
// CHECK: "a": "a"
// CHECK: "blankLine()": {
// CHECK: "b": ""
// CHECK: "loneAt()": {
// CHECK: "c": "c"
// CHECK: "loneAtThenText()": {
// CHECK: "e": "after a lone at sign"
// CHECK: "emptyLine()": {
// CHECK: "d": "after an empty line"
// CHECK-LABEL: "ReturnDescAfterNl.sol": {
// CHECK: "second": "Documentation for the second parameter"
// CHECK: "returns": {
// CHECK-NEXT: "d": "The result of the multiplication"
// CHECK-LABEL: "ReturnNameNoDescription.sol": {
// CHECK: "A": {
// CHECK: "a": "a"
// CHECK: "B": {
// CHECK: "b": "a"
// CHECK-LABEL: "StructGetterNoReturnName.sol": {
// CHECK: "IThing": {
// CHECK: "_0": ""
// CHECK: "value": {
// CHECK-NEXT: "return": "x ",
// CHECK-NEXT: "returns": {
// CHECK-NEXT: "x": ""
{
  "language": "Solidity",
  "settings": {
    "outputSelection": {
      "*": {
        "*": ["devdoc"]
      }
    }
  }
}
