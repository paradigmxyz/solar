// Source unit names are the input keys verbatim: `\` is an ordinary character. Stdout filters
// turn escaped backslashes into `/`, so the outputs selected by the exact keys check the names,
// and the metadata, escaped twice, shows each `\` as `//`. The `С` in `USDС.sol` is Cyrillic, as
// in the Sourcify contract this reduces.
// CHECK: "contracts": {
// CHECK-NEXT: "C:/Users/dev/ECoin.sol": {
// CHECK-NEXT: "ECoin": {
// CHECK: "contracts/USDС.sol": {
// CHECK-NEXT: "USDC": {
// CHECK: \"compilationTarget\":{\"contracts//USDС.sol\":\"USDC\"}
{
  "language": "Solidity",
  "sources": {
    "contracts\\USDС.sol": {
      "content": "contract USDC {}"
    },
    "C:\\Users\\dev\\ECoin.sol": {
      "content": "contract ECoin {}"
    }
  },
  "settings": {
    "outputSelection": {
      "contracts\\USDС.sol": {
        "USDC": [
          "abi",
          "metadata"
        ]
      },
      "C:\\Users\\dev\\ECoin.sol": {
        "ECoin": [
          "abi"
        ]
      }
    }
  }
}
