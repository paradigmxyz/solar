//@ filecheck:
// NatSpec tags start at the first `@` of a line like in solc 0.8.38, after a non-breaking space,
// after other text, or inside a block comment's code example. Later `@`s on the line and lines
// without `@` stay text, as does the line after a bare tag, and an invalid tag in the middle of a
// line ends the previous tag.
// CHECK-LABEL: "C": {
// CHECK: "i()": {
// CHECK-NEXT: "notice": "mail user@example.com"
// CHECK: "f()": {
// CHECK-NEXT: "details": "after a non-breaking space"
// CHECK: "g()": {
// CHECK-NEXT: "details": "mid line"
// CHECK: "h()": {
// CHECK-NEXT: "details": "first line second line"
// CHECK-LABEL: "D": {
// CHECK: "details": "Example:",
// CHECK-NEXT: "custom:x": "y   continued",
// CHECK-LABEL: "F": {
// CHECK: "details": "Mail",
// CHECK-LABEL: "G": {
// CHECK: "details": "mail user@example.com",
// CHECK-LABEL: "J": {
// CHECK: "details": "see @custom:y z",
// CHECK-LABEL: "R": {
// CHECK: "custom:y": "z",
// CHECK-LABEL: "P": {
// CHECK: "notice": "Safe vault. Do not add @custom:solar-trusted here",
{
  "language": "Solidity",
  "settings": {
    "outputSelection": {
      "A.sol": {
        "*": ["userdoc", "devdoc"]
      }
    }
  }
}
