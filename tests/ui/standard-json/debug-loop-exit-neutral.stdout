      "sources": [
        {
          "id": 0,
          "path": "A.sol",
          "contents": "contract Base {\n    function previous(uint256 n) external pure returns (uint256 last) {\n        assembly {\n            for {} 1 {} {\n                last := n\n                n := sub(n, 1)\n                if iszero(n) { break }\n            }\n        }\n    }\n\n    function mixed(uint256 x, uint256 y, uint256 n) external pure returns (uint256) { unchecked { for (uint256 i; i < n; ++i) { x += y; y += 17; } } return x; }\n    function compute(uint256 a, uint256 b, uint256 n) external pure returns (uint256) { for (uint256 i; i < n; ++i) { a = a * b + i; } return a; }\n    function assign(uint256 a, uint256 b, uint256 n) external pure returns (uint256) { unchecked { for (uint256 i; i < n; ++i) { a = b; } } return a; }\n    function hash() external pure returns (bytes32 result) { assembly { mstore(0, 1) mstore(32, 2) result := keccak256(0, 64) } }\n    function account(uint256 raw) external view returns (uint256) { return address(uint160(raw)).code.length; }\n}\ncontract A is Base {} contract B is Base {} contract C is Base {}\n",
          "language": "Solidity"
        }
      ]
    }
  }
