          "path": "A.sol",
          "contents": "contract Base {\n    function previous(uint256 n) external pure returns (uint256 last) {\n        assembly {\n            for {} 1 {} {\n                last := n\n                n := sub(n, 1)\n                if iszero(n) { break }\n            }\n        }\n    }\n\n}\ncontract A is Base {} contract B is Base {} contract C is Base {}\n",
