// A stop after lowering also gives the parsed AST, since type checking has not run.
// CHECK: "nodeType": "SourceUnit"
// CHECK: "typeDescriptions": {}
// CHECK-NOT: "referencedDeclaration"
// CHECK-NOT: "isPure"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract C { uint x; function f() public pure returns (uint256) { return x + 1; } }"
    }
  },
  "settings": {
    "stopAfter": "lowering",
    "outputSelection": {
      "*": {
        "": [
          "ast"
        ]
      }
    }
  }
}
