//@ revisions: default yul sonatina sir llvm
//@[yul] compile-flags: --codegen-backend yul
//@[sonatina] compile-flags: --codegen-backend sonatina
//@[sir] compile-flags: --codegen-backend sir
//@[llvm] compile-flags: --codegen-backend llvm
//@ filecheck:
// CHECK: "errors": [
// CHECK: "errorCode": "2264"
// CHECK: "deployedBytecode": {
// CHECK-NEXT: "opcodes":
// CHECK-SAME: PUSH20 0x1111111111111111111111111111111111111111
// CHECK-NOT: 0x2222222222222222222222222222222222222222
{
  "language": "Solidity",
  "sources": {},
  "settings": {
    "libraries": {
      "Wrong.sol": {
        "Lib": "0x2222222222222222222222222222222222222222"
      },
      "A.sol": {
        "Lib": "0x1111111111111111111111111111111111111111"
      }
    },
    "outputSelection": {
      "A.sol": {
        "C": [
          "evm.deployedBytecode.opcodes"
        ]
      }
    }
  }
}
