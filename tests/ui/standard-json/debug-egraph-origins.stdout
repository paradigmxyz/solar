      "sources": [
        {
          "id": 0,
          "path": "A.sol",
          "contents": "contract A {\n    function fold(uint256 x) external pure returns (uint256) {\n        unchecked {\n            return x + 1 + 2;\n        }\n    }\n\n    function inverted(uint256 x, uint256 y) external pure returns (uint256) {\n        if (!(x > y)) {\n            return 1;\n        }\n        return 2;\n    }\n\n    function both(uint256 x, uint256 y) external pure returns (uint256 r) {\n        unchecked {\n            if (!(x + 1 + 2 > y)) {\n                r = x * 7 + 1 + 2;\n            }\n        }\n    }\n}\n\ncontract B {\n    function fold(uint256 x) external pure returns (uint256) {\n        unchecked {\n            return x + 1 + 2;\n        }\n    }\n\n    function inverted(uint256 x, uint256 y) external pure returns (uint256) {\n        if (!(x > y)) {\n            return 1;\n        }\n        return 2;\n    }\n\n    function both(uint256 x, uint256 y) external pure returns (uint256 r) {\n        unchecked {\n            if (!(x + 1 + 2 > y)) {\n                r = x * 7 + 1 + 2;\n            }\n        }\n    }\n}\n\ncontract C {\n    function fold(uint256 x) external pure returns (uint256) {\n        unchecked {\n            return x + 1 + 2;\n        }\n    }\n\n    function inverted(uint256 x, uint256 y) external pure returns (uint256) {\n        if (!(x > y)) {\n            return 1;\n        }\n        return 2;\n    }\n\n    function both(uint256 x, uint256 y) external pure returns (uint256 r) {\n        unchecked {\n            if (!(x + 1 + 2 > y)) {\n                r = x * 7 + 1 + 2;\n            }\n        }\n    }\n}\n",
