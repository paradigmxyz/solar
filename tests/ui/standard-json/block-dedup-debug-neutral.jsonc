//@ compile-flags: -Zevm-ir-pipeline=block-dedup
//@ normalize-stdout-test: "solar-[0-9a-f]{64}" -> "solar-COMPILATION_ID"
//@ filecheck:
// CHECK-LABEL: "A": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "B": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "C": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract A { function a() external pure returns (uint256) { return 1; } function b() external pure returns (uint256) { return 1; } function c(bool fail) external pure returns (uint256) { if (fail) revert(); return 2; } function d(bool fail) external pure returns (uint256) { if (fail) revert(); return 2; } } contract B { function a() external pure returns (uint256) { return 1; } function b() external pure returns (uint256) { return 1; } function c(bool fail) external pure returns (uint256) { if (fail) revert(); return 2; } function d(bool fail) external pure returns (uint256) { if (fail) revert(); return 2; } } contract C { function a() external pure returns (uint256) { return 1; } function b() external pure returns (uint256) { return 1; } function c(bool fail) external pure returns (uint256) { if (fail) revert(); return 2; } function d(bool fail) external pure returns (uint256) { if (fail) revert(); return 2; } }"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false,
      "bytecodeHash": "none"
    },
    "optimizer": {
      "enabled": true
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "evm.bytecode.object",
          "evm.bytecode.sourceMap",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.sourceMap"
        ],
        "B": [
          "evm.bytecode.object",
          "evm.bytecode.ethdebug",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.ethdebug"
        ],
        "C": [
          "evm.bytecode.object",
          "evm.deployedBytecode.object"
        ]
      }
    }
  }
}
