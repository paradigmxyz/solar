//@ normalize-stdout-test: "solar-[0-9a-f]{64}" -> "solar-COMPILATION_ID"
//@ filecheck:
// CHECK-LABEL: "A": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "B": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "C": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract Base {\n    function previous(uint256 n) external pure returns (uint256 last) {\n        assembly {\n            for {} 1 {} {\n                last := n\n                n := sub(n, 1)\n                if iszero(n) { break }\n            }\n        }\n    }\n\n    function mixed(uint256 x, uint256 y, uint256 n) external pure returns (uint256) { unchecked { for (uint256 i; i < n; ++i) { x += y; y += 17; } } return x; }\n    function compute(uint256 a, uint256 b, uint256 n) external pure returns (uint256) { for (uint256 i; i < n; ++i) { a = a * b + i; } return a; }\n    function assign(uint256 a, uint256 b, uint256 n) external pure returns (uint256) { unchecked { for (uint256 i; i < n; ++i) { a = b; } } return a; }\n    function hash() external pure returns (bytes32 result) { assembly { mstore(0, 1) mstore(32, 2) result := keccak256(0, 64) } }\n}\ncontract A is Base {} contract B is Base {} contract C is Base {}\n"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false,
      "bytecodeHash": "none"
    },
    "optimizer": {
      "enabled": true
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "evm.bytecode.object",
          "evm.bytecode.sourceMap",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.sourceMap"
        ],
        "B": [
          "evm.bytecode.object",
          "evm.bytecode.ethdebug",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.ethdebug"
        ],
        "C": [
          "evm.bytecode.object",
          "evm.deployedBytecode.object"
        ]
      }
    }
  }
}
