//@ filecheck:
// A counter that is always hit with an earlier counter of its segment, with nothing between them
// that can halt, is dropped. The function entry `1` keeps the modifier entry `2` and the check of
// `n != 0` `3`, and the `_` placeholder `5` follows the check's `require` path `4`, which keeps the
// statement `6` behind it. A write to storage, a call, and a check that reverts end a segment, since
// a static call runs none of the writes: the counter `7` of the statement after the write of `6`
// stays, and so do the counters `8` and `9` around the call. The write of `9` starts the segment of
// the `if` `10`, which keeps its left condition `11`, and the right operand `12` keeps `13`.
// Probes whose counters have no alias stay in the code.
// CHECK: "deployedBytecode": {
// CHECK-NEXT: "coverageAliases": [
// CHECK-NEXT: [
// CHECK-NEXT: 2,
// CHECK-NEXT: 1
// CHECK-NEXT: ],
// CHECK-NEXT: [
// CHECK-NEXT: 3,
// CHECK-NEXT: 1
// CHECK-NEXT: ],
// CHECK-NEXT: [
// CHECK-NEXT: 6,
// CHECK-NEXT: 5
// CHECK-NEXT: ],
// CHECK-NEXT: [
// CHECK-NEXT: 11,
// CHECK-NEXT: 10
// CHECK-NEXT: ],
// CHECK-NEXT: [
// CHECK-NEXT: 13,
// CHECK-NEXT: 12
// CHECK-NEXT: ]
// CHECK-NEXT: ]
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "interface I {\n    function g() external;\n}\n\ncontract A {\n    uint256 a;\n\n    modifier nonZero(uint256 n) {\n        require(n != 0);\n        _;\n    }\n\n    function f(I i, uint256 x, bool b) external nonZero(x) {\n        a = x;\n        a = x + 1;\n        i.g();\n        a = 2;\n        if (b && x > 3) {\n            a = 3;\n        }\n    }\n}\n"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false
    },
    "solar": {
      "unstable": [
        "instrument-coverage"
      ]
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "evm.deployedBytecode.coverageAliases"
        ]
      }
    }
  }
}
