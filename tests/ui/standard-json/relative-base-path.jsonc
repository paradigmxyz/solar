//@ compile-flags: --base-path lib
// CHECK: "message": "{{.*}} lib/Missing.sol: File not found."
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "import \"Missing.sol\";"
    }
  },
  "settings": {
    "outputSelection": {
      "*": {
        "*": [
          "abi"
        ]
      }
    }
  }
}
