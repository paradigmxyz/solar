// Cycles are cut from DFS roots in source unit name order, comparing raw bytes
// like solc. Here `a-b/x.sol` sorts before `a/y.sol` because `-` is below `/`,
// although `a` is a path prefix of `a-b`, so the base is not cut from its
// derived contract.
// CHECK: "sources": {
// CHECK: "a/y.sol": {
// CHECK-NEXT: "id": 0
// CHECK: "a-b/x.sol": {
// CHECK-NEXT: "id": 1
// CHECK-NOT: definition of base has to precede definition of derived contract
{
  "language": "Solidity",
  "sources": {
    "a-b/x.sol": {
      "content": "import \"a/y.sol\";\ncontract X is Y {}\n"
    },
    "a/y.sol": {
      "content": "import \"a-b/x.sol\";\ncontract Y {}\n"
    }
  },
  "settings": {
    "outputSelection": {}
  }
}
