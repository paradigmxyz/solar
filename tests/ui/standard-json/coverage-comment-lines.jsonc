//@ filecheck:
// A comment line directly before the first statement of a body, whose count is the count of the
// body, is a skipped run of whole lines: it starts at the first byte of the line and ends with its
// newline, so it starts and ends on its own line and the `require` after it, which has no code
// region of its own, keeps its line. A single blank line below a statement is one skipped byte, its
// newline, and nothing starts on the statement's line.
// CHECK: "name": "A.sol:S.f(uint256)",
// CHECK: {{^ *2,$}}
// CHECK-NEXT: 0,
// CHECK-NEXT: 70,
// CHECK-NEXT: 20
// CHECK: {{^ *2,$}}
// CHECK-NEXT: 0,
// CHECK-NEXT: 141,
// CHECK-NEXT: 1
// A string literal whose newline is escaped continues on the next line, so a `/*` in it opens no
// comment and the `return` after it is not skipped.
// CHECK: "name": "A.sol:S.g()",
// CHECK-NOT: {{^ *249,$}}
// CHECK: {{^ *290,$}}
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract S {\n    uint256 total;\n\n    function f(uint256 x) external {\n        /// comment\n        require(x > 1);\n        uint256 y = x + 1;\n\n        total = y;\n    }\n\n    function g() external pure returns (uint256) {\n        string memory s = \"a\\\n/*\";\n        return bytes(s).length;\n    }\n}\n"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false
    },
    "solar": {
      "unstable": [
        "instrument-coverage"
      ]
    },
    "outputSelection": {
      "*": {
        "*": []
      }
    }
  }
}
