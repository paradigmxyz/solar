//@ compile-flags: -Zcodegen
//@ filecheck:
// CHECK-LABEL: "Widths": {
// CHECK: "bytecode": {
// CHECK: "object":
// CHECK: "opcodes":
// CHECK: "linkReferences": {}
// CHECK: "deployedBytecode": {
// CHECK: "object":
// CHECK: "opcodes":
// CHECK: "linkReferences": {}
// CHECK: "immutableReferences": {
// CHECK: "length": 1
// CHECK: "length": 20
// CHECK-LABEL: "OnlyRefs": {
// CHECK: "deployedBytecode": {
// CHECK-NEXT: "immutableReferences": {
// CHECK: "length": 2
// CHECK-NOT: "object":
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract Widths { uint8 immutable a; address immutable b; constructor(uint8 a_, address b_) { a = a_; b = b_; } function values() external view returns (uint8, address) { return (a, b); } } contract OnlyRefs { uint16 immutable x = 7; function value() external pure returns (uint16) { return x; } }"
    }
  },
  "settings": {
    "outputSelection": {
      "*": {
        "Widths": [
          "evm.bytecode",
          "evm.deployedBytecode"
        ],
        "OnlyRefs": [
          "evm.deployedBytecode.immutableReferences"
        ]
      }
    }
  }
}
