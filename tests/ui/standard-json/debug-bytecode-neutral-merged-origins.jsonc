//@ normalize-stdout-test: "solar-[0-9a-f]{64}" -> "solar-COMPILATION_ID"
//@ filecheck:
// Merging the origins of a deleted duplicate into its same-block survivor, in `egraph` and `cse`,
// must not change the bytecode, with or without source maps or ETHDebug.
// CHECK-LABEL: "A": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "B": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "C": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract A { uint256 s; function f(uint256 x, uint256 y) external view returns (uint256) { unchecked { return (x * y + 3) + (x * y + 3) + s + s; } } function g(uint256 x) external view returns (uint256) { uint256 a = s + x; uint256 b = s + x; return a * b; } } contract B { uint256 s; function f(uint256 x, uint256 y) external view returns (uint256) { unchecked { return (x * y + 3) + (x * y + 3) + s + s; } } function g(uint256 x) external view returns (uint256) { uint256 a = s + x; uint256 b = s + x; return a * b; } } contract C { uint256 s; function f(uint256 x, uint256 y) external view returns (uint256) { unchecked { return (x * y + 3) + (x * y + 3) + s + s; } } function g(uint256 x) external view returns (uint256) { uint256 a = s + x; uint256 b = s + x; return a * b; } }"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false,
      "bytecodeHash": "none"
    },
    "optimizer": {
      "enabled": true
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "evm.bytecode.object",
          "evm.bytecode.sourceMap",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.sourceMap"
        ],
        "B": [
          "evm.bytecode.object",
          "evm.bytecode.ethdebug",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.ethdebug"
        ],
        "C": [
          "evm.bytecode.object",
          "evm.deployedBytecode.object"
        ]
      }
    }
  }
}
