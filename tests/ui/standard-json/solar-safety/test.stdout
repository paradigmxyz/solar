  "contracts": {
    "safety.sol": {
      "Reviewed": {
        "solarSafety": {
          "memory": true,
          "arithmetic": true,
          "trusted": [
            "Reviewed.word(bytes)"
          ]
        }
      },
      "Clean": {
        "solarSafety": {
          "memory": true,
          "arithmetic": true,
          "trusted": []
        }
      },
      "Assembly": {
        "solarSafety": {
          "memory": false,
          "arithmetic": false,
          "trusted": []
        }
      },
      "Unchecked": {
        "solarSafety": {
          "memory": true,
          "arithmetic": false,
          "trusted": []
        }
      },
      "Trusting": {
        "solarSafety": {
          "memory": true,
          "arithmetic": true,
          "trusted": [
            "Reviewed.word(bytes)"
          ]
        }
      },
      "Unnamed": {
        "solarSafety": {
          "memory": true,
          "arithmetic": true,
          "trusted": [
            "Unnamed.constructor()",
            "Unnamed.fallback()",
            "Unnamed.receive()"
          ]
        }
      },
      "Recursive": {
        "solarSafety": {
          "memory": true,
          "arithmetic": true,
          "trusted": [
            "Recursive.reviewed(Recursive.Node)"
          ]
        }
      },
      "PointerFactory": {
        "solarSafety": {
          "memory": false,
          "arithmetic": false,
          "trusted": [
            "PointerFactory.pointer()"
          ]
        }
      },
      "PointerConsumer": {
        "solarSafety": {
          "memory": false,
          "arithmetic": false,
          "trusted": [
            "PointerFactory.pointer()"
          ]
        }
      }
    }
  }
