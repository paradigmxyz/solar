//@ normalize-stdout-test: "solar-[0-9a-f]{64}" -> "solar-COMPILATION_ID"
//@ filecheck:
// CHECK-LABEL: "A": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME:[0-9a-f]+]]"
// CHECK: "sourceMap":
// CHECK-LABEL: "B": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
// CHECK: "ethdebug": {
// CHECK-LABEL: "C": {
// CHECK-LABEL: "bytecode": {
// CHECK: "object": "[[CREATE]]"
// CHECK-LABEL: "deployedBytecode": {
// CHECK: "object": "[[RUNTIME]]"
{
  "language": "Solidity",
  "sources": {
    "A.sol": {
      "content": "contract Base {\n    function viaWord(uint256 x) external pure returns (uint256) {\n        function(uint256) internal pure returns (uint256) f = target;\n        return f(x);\n    }\n\n    function viaBytes(uint256 x) external pure returns (uint256) {\n        function(uint256) internal pure returns (uint256) f = target;\n        bytes32 raw;\n        assembly {\n            raw := f\n        }\n        function(bytes32) internal pure returns (bytes32) g;\n        assembly {\n            g := raw\n        }\n        return uint256(g(bytes32(x)));\n    }\n\n    function target(uint256 a) internal pure returns (uint256) {\n        return a + 1;\n    }\n}\ncontract A is Base {} contract B is Base {} contract C is Base {}\n"
    }
  },
  "settings": {
    "metadata": {
      "appendCBOR": false,
      "bytecodeHash": "none"
    },
    "optimizer": {
      "enabled": false
    },
    "outputSelection": {
      "A.sol": {
        "A": [
          "evm.bytecode.object",
          "evm.bytecode.sourceMap",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.sourceMap"
        ],
        "B": [
          "evm.bytecode.object",
          "evm.bytecode.ethdebug",
          "evm.deployedBytecode.object",
          "evm.deployedBytecode.ethdebug"
        ],
        "C": [
          "evm.bytecode.object",
          "evm.deployedBytecode.object"
        ]
      }
    }
  }
}
