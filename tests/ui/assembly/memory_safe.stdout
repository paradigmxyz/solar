source 0 "ROOT/tests/ui/assembly/memory_safe.sol" {
    contract MemorySafe {
        function memorySafe() public pure returns (uint256 result) {
            assembly ("memory-safe") {
                uint256 ptr = mload(0x40);
                mstore(ptr, 42);
                mstore(0x40, add(ptr, 32));
                result = mload(ptr);
            }
        }

        function withDialect() public pure returns (uint256 result) {
            assembly {
                result = 42;
            }
        }

