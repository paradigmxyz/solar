+- `case.sh` refuses a driver checkout that is not a clean `SOLAR_SHA`, unsets the escape hatches
+  (`CERTIFY_ALLOW_UNPINNED`, `CERTIFY_ALLOW_FOREIGN_SOLAR`) and records them in its status with the
+  driver and harness commits, runs one case in its own session under `receipt.py` (memory trace),
+  checks the record against the producer (`producer_check.py`), and appends
+  `KIND exit=N expect=E match=yes|no producer=… log_sha256=…` to its status.
+- `SOLAR_DIR` is the driver checkout at the commit under test; the harness may run from another
+  checkout, whose commit is recorded as `harness`.
 - `ship.sh` packs each case as it finishes (without its work tree, with a sha256 manifest) and
   pushes it to `SHIP_BRANCH` under `runs/<solar commit>/<case>`.
+
+## On a box
+
+`box/setup.sh SOLAR_SHA HARNESS_SHA LEAN_SHA` prepares a fresh box from public sources (pinned
+solc by sha256) and writes every tool version to `~/t5-versions.txt`. `box/go.sh MEMORY_MAX_BYTES`
+starts `run.sh` in a transient systemd scope with that `memory.max` and `memory.swap.max` 0, and
+starts nothing unless the driver's `tools/certify/box_admit.sh admit` reads both back
+(`$OUT.admission`). Each case also re-reads its own cgroup's limits and refuses (`REFUSED-SCOPE`)
+when `memory.max` is not a byte count or swap is allowed, and records `memory.peak` and
+`memory.events` in `scope.txt`.
diff --git a/tools/certify-adversarial/box/go.sh b/tools/certify-adversarial/box/go.sh
new file mode 100755
index 000000000..688d52aa9
--- /dev/null
+++ b/tools/certify-adversarial/box/go.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# box/go.sh MEMORY_MAX_BYTES: starts run.sh in a transient systemd scope whose memory.max is
+# MEMORY_MAX_BYTES and whose memory.swap.max is 0, and starts nothing unless the scope reads both
+# back (the driver's own tools/certify/box_admit.sh admit, which never accepts "max"). The read-back
+# is written to $OUT.admission. Every other variable run.sh needs comes from the environment.
+set -euo pipefail
+want=$1
+here=$(cd "$(dirname "$0")/.." && pwd)
+: "${OUT:?}" "${SOLAR_DIR:?}"
+[[ "$want" =~ ^[1-9][0-9]*$ ]] || { echo "go: MEMORY_MAX_BYTES must be a byte count" >&2; exit 2; }
+vars=(HOME PATH OUT SOLAR_DIR SOLAR_SHA LEAN_DIR LEAN_SHA BOX_CREATED CASES PACKAGES_FROM SLOTS ADMIT_MIN
+      END_MIN EST_MIN CARGO_BUILD_JOBS SHIP_BRANCH)
+envs=()
+for v in "${vars[@]}"; do [[ -z "${!v+x}" ]] || envs+=("$v=${!v}"); done
+exec sudo systemd-run --scope --quiet --unit="t5neg-$(date +%s)" -p "MemoryMax=$want" -p MemorySwapMax=0 \
+    --uid="$(id -u)" --gid="$(id -g)" -- env -i "${envs[@]}" ADMIT_WANT="$want" bash "$here/box/inscope.sh"
diff --git a/tools/certify-adversarial/box/inscope.sh b/tools/certify-adversarial/box/inscope.sh
new file mode 100755
index 000000000..2676fcf8c
--- /dev/null
+++ b/tools/certify-adversarial/box/inscope.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# box/inscope.sh: run by go.sh inside its scope. Admits the scope with the driver's box_admit.sh
+# (memory.max reads back as ADMIT_WANT, swap.max as 0, this shell in the scope) and only then runs
+# run.sh; anything it cannot read refuses.
+set -uo pipefail
+here=$(cd "$(dirname "$0")/.." && pwd)
+adm="$OUT.admission"
+cg=$(sed -n 's/^0:://p' /proc/self/cgroup | head -1)
+{
+    echo "cgroup $cg"
+    echo "pid $$"
+    echo "want_memory_max $ADMIT_WANT"
+    echo "memory.max $(cat "/sys/fs/cgroup$cg/memory.max" 2>&1)"
+    echo "memory.swap.max $(cat "/sys/fs/cgroup$cg/memory.swap.max" 2>&1)"
+} > "$adm"
+if ! bash "$SOLAR_DIR/tools/certify/box_admit.sh" admit "$cg" "$$" "$ADMIT_WANT" >> "$adm" 2>&1; then
+    echo "ADMISSION-REFUSED $(date -u +%FT%TZ)" >> "$adm"
+    exit 1
+fi
+echo "ADMITTED $(date -u +%FT%TZ)" >> "$adm"
+exec bash "$here/run.sh"
diff --git a/tools/certify-adversarial/box/setup.sh b/tools/certify-adversarial/box/setup.sh
new file mode 100755
index 000000000..2b5e29fea
--- /dev/null
+++ b/tools/certify-adversarial/box/setup.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# box/setup.sh SOLAR_SHA HARNESS_SHA LEAN_SHA: prepares a fresh box for run.sh from public sources
+# only: the system packages, rustup's stable toolchain, elan with solidity-lean's Lean toolchain,
+# Python 3.14 (generic.py's), solc 0.8.35 checked against soliditylang.org's sha256, the driver
+# checkout (~/solar at SOLAR_SHA), the harness (~/harness at HARNESS_SHA), solidity-lean (~/sl at
+# LEAN_SHA) and a package cache (~/pk: the same commit with its packages fetched by lake, for
+# --packages-from). Every version is written to ~/t5-versions.txt. Any failure stops it.
+set -euxo pipefail
+solar_sha=$1 harness_sha=$2 lean_sha=$3
+solc_url=https://binaries.soliditylang.org/linux-amd64/solc-linux-amd64-v0.8.35+commit.47b9dedd
+solc_sha256=fa8ac9a32d301ad023a36ee5a29f8e291fe3200c60244e43c142539e82a617f4
+export DEBIAN_FRONTEND=noninteractive
+sudo -E apt-get update -q
+sudo -E apt-get install -yq git build-essential time zstd curl ca-certificates
+# The sandbox (tools/certify/sandbox.sh, lean_iso.sh) needs unprivileged user namespaces.
+sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 || true
+unshare -r -m -p -f --mount-proc true
+mkdir -p ~/.local/bin ~/.cache/solc
+curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
+curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --default-toolchain none
+curl -fsSL https://astral.sh/uv/install.sh | sh
+export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.elan/bin:$PATH"
+uv python install 3.14
+py=$(uv python find 3.14)
+ln -sf "$py" ~/.local/bin/python3.14
+ln -sf "$py" ~/.local/bin/python3
+curl -fsSL "$solc_url" -o ~/.cache/solc/solc-0.8.35
+echo "$solc_sha256  $HOME/.cache/solc/solc-0.8.35" | sha256sum -c
+chmod +x ~/.cache/solc/solc-0.8.35
+clone() { # clone URL DIR SHA
+    git clone -q "$1" "$2"
+    git -C "$2" fetch -q origin "$3"
+    git -C "$2" checkout -q --detach "$3"
+    [[ "$(git -C "$2" rev-parse HEAD)" == "$3" ]]
+}
+clone https://github.com/paradigmxyz/solar ~/solar "$solar_sha"
+git clone -q --shared ~/solar ~/harness
+git -C ~/harness fetch -q https://github.com/paradigmxyz/solar "$harness_sha"
+git -C ~/harness checkout -q --detach "$harness_sha"
+clone https://github.com/paradigmxyz/solidity-lean ~/sl "$lean_sha"
+elan toolchain install "$(cat ~/sl/lean-toolchain)"
+git clone -q ~/sl ~/pk
+git -C ~/pk checkout -q --detach "$lean_sha"
+(cd ~/pk && lake exe cache get)
+{
+    echo "solar $(git -C ~/solar rev-parse HEAD)"
+    echo "harness $(git -C ~/harness rev-parse HEAD)"
+    echo "solidity-lean $(git -C ~/sl rev-parse HEAD)"
+    echo "package-cache $(git -C ~/pk rev-parse HEAD)"
+    echo "solc $(sha256sum < ~/.cache/solc/solc-0.8.35 | cut -c1-64) $(~/.cache/solc/solc-0.8.35 --version | tail -1)"
+    echo "python3 $(python3 --version)"
+    echo "rustc $(rustc --version)"
+    echo "cargo $(cargo --version)"
+    echo "lean $(cd ~/sl && lean --version)"
+    echo "lake $(cd ~/sl && lake --version)"
+    echo "gcc $(gcc --version | head -1)"
+    echo "time $(dpkg-query -W -f='${Version}' time)"
+    echo "kernel $(uname -r)"
+    echo "nproc $(nproc)"
+    echo "mem_total_bytes $(awk '/MemTotal/ {print $2 * 1024}' /proc/meminfo)"
+    echo "swap_total_bytes $(awk '/SwapTotal/ {print $2 * 1024}' /proc/meminfo)"
+    df -B1 --output=size,avail "$HOME" | tail -1 | awk '{print "disk_bytes " $1 " avail " $2}'
+} > ~/t5-versions.txt
+cat ~/t5-versions.txt
