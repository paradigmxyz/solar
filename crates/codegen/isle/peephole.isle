;; Types used by the EVM IR window extractors.
(type U256 (primitive U256))
(type StackOp (primitive StackOp))

;; Local peephole optimization over scheduled EVM IR.
;;
;; `peep` inspects the tail of a block's instruction list and returns the edit
;; to apply to its last `skip` instructions. The driver in
;; `backend/evm/ir/passes/peephole.rs` appends instructions one at a time and
;; applies edits until none matches, so every rule sees a fully optimized
;; prefix. Every window extractor may match the same tail, so every rule
;; carries a distinct priority encoding the order of the checks it replaced.

;; The instruction tail under inspection.
(type Window (primitive Window))
;; The result of a rule: how many trailing instructions it consumes and the edit.
(type Rewrite (primitive Rewrite))

;; An index into the immutable instruction window. Extract only the facets
;; needed by a matching rule, without copying or classifying entire windows.
(type Inst (primitive Inst))

;; A removable immediate push, a block-label push, or a legacy opcode.
(decl push (U256) Inst)
(extern extractor push push)
(decl push_block () Inst)
(extern extractor push_block push_block)
(decl opcode (u8) Inst)
(extern extractor opcode opcode)

(type Edit extern (enum
  (Keep (len u8))
  (OverwritePush0)
  (DropDiscardedSwap)
  (FoldConstants (value U256))
  (RemoveFirstKeepOne)
  (RemoveFirstKeepTwo)
  (RemoveFirstOverwrite (opcode u8))
  (SwapOverwrite (opcode u8))
  (OverwriteOne (opcode u8))
  (OverwriteTwo (opcode u8))
  (MergeSwapPop (depth u8))
  (ReloadStoredValue)
  (DropDoubleIszero)
  (EqIszeroJumpi)
  (StackOp (op StackOp))
  (StackOps (first StackOp) (second StackOp))
))

(decl pure rewrite (u8 Edit) Rewrite)
(extern constructor rewrite rewrite)

;; The last instructions of the block, oldest first.
(decl last2 (Inst Inst) Window)
(extern extractor last2 last2)
(decl last3 (Inst Inst Inst) Window)
(extern extractor last3 last3)
(decl last4 (Inst Inst Inst Inst) Window)
(extern extractor last4 last4)
(decl last5 (Inst Inst Inst Inst Inst) Window)
(extern extractor last5 last5)
(decl last6 (Inst Inst Inst Inst Inst Inst) Window)
(extern extractor last6 last6)
;; `SWAPn POP*n SWAP1 POP`, giving `n`.
(decl swap_pop_chain (u8) Window)
(extern extractor swap_pop_chain swap_pop_chain)
;; `SWAPn POP*(n+1)`, giving the number of pops.
(decl swap_discard_chain (u8) Window)
(extern extractor swap_discard_chain swap_discard_chain)
;; A `DUPn` that duplicates a known zero, on a target that has `PUSH0`.
(decl duplicates_known_zero () Window)
(extern extractor duplicates_known_zero duplicates_known_zero)
;; Adjacent constants whose folded result is a Pareto improvement, giving that result.
(decl fold_constants (U256) Window)
(extern extractor fold_constants fold_constants)
;; A trailing stack sequence whose net effect is the identity, giving its length.
(decl noop_stack_suffix (u8) Window)
(extern extractor noop_stack_suffix noop_stack_suffix)

;; Stack-operation facets of an instruction built as a logical stack operation.
(decl dup (u8) Inst)
(extern extractor dup dup)
(decl swap (u8) Inst)
(extern extractor swap swap)
(decl exchange (u8 u8) Inst)
(extern extractor exchange exchange)
(decl pop () Inst)
(extern extractor pop pop)
;; A push that may be deleted, or any push at all.
(decl removable_push () Inst)
(extern extractor removable_push removable_push)
(decl any_push () Inst)
(extern extractor any_push any_push)

;; Opcode classes.
;; `x OP 0 == 0`
(decl pure absorbs_zero (u8) bool)
(extern constructor absorbs_zero absorbs_zero)
;; `x OP 0 == x`
(decl pure zero_identity (u8) bool)
(extern constructor zero_identity zero_identity)
(decl pure is_commutative (u8) bool)
(extern constructor is_commutative is_commutative)
(decl pure partial flipped_comparison (u8) u8)
(extern constructor flipped_comparison flipped_comparison)
(decl pure is_noncommutative_binop (u8) bool)
(extern constructor is_noncommutative_binop is_noncommutative_binop)
;; Consumes two stack items and pushes nothing.
(decl pure is_sink (u8) bool)
(extern constructor is_sink is_sink)
(decl pure u8_add (u8 u8) u8)
(extern constructor u8_add u8_add)
(decl pure swap_op (u8) StackOp)
(extern constructor swap_op swap_op)
;; The `EXCHANGE` represented by three swaps.
(decl pure partial exchange_of_swaps (u8 u8 u8) StackOp)
(extern constructor exchange_of_swaps exchange_of_swaps)
(decl pure u256_is_zero (U256) bool)
(extern constructor u256_is_zero u256_is_zero)
(decl pure u256_is_one (U256) bool)
(extern constructor u256_is_one u256_is_one)

(decl partial peep (Window) Rewrite)

;; Every current rewrite ends at an opcode or a physical stack operation.
;; Reject pushes before inspecting older instructions or simulating the stack.
(decl nonpush_tail () Window)
(extern extractor nonpush_tail nonpush_tail)
(decl partial peep_nonpush (Window) Rewrite)
(rule (peep (and window (nonpush_tail))) (peep_nonpush window))

;; `... PUSH0 ... DUPn -> ... PUSH0 ... PUSH0` when the duplicate reads that zero.
;;
;; `PUSH0` is one byte and costs two gas, so it dominates every `DUPn` on targets that have it.
(rule 400 (peep_nonpush (duplicates_known_zero)) (rewrite 1 (Edit.OverwritePush0)))

;; `PUSH x PUSH 0 OP -> PUSH 0`, `PUSH x PUSH 1 EXP -> PUSH 1`.
(rule 350 (peep_nonpush (last3 (removable_push) (push v) (opcode opcode)))
         (if-let true (u256_is_zero v))
         (if-let true (absorbs_zero opcode))
         (rewrite 3 (Edit.RemoveFirstKeepOne)))
(rule 340 (peep_nonpush (last3 (removable_push) (push v) (opcode $EXP)))
         (if-let true (u256_is_one v))
         (rewrite 3 (Edit.RemoveFirstKeepOne)))

;; `PUSH 0 OP -> ∅`, `PUSH 0 EQ -> ISZERO`, `PUSH 0 OP -> POP PUSH 0`,
;; `PUSH 1 MUL -> ∅`, `PUSH 1 EXP -> POP PUSH 1`.
(rule 330 (peep_nonpush (last2 (push v) (opcode opcode)))
         (if-let true (u256_is_zero v))
         (if-let true (zero_identity opcode))
         (rewrite 2 (Edit.Keep 0)))
(rule 320 (peep_nonpush (last2 (push v) (opcode $EQ)))
         (if-let true (u256_is_zero v))
         (rewrite 2 (Edit.RemoveFirstOverwrite $ISZERO)))
(rule 310 (peep_nonpush (last2 (push v) (opcode opcode)))
         (if-let true (u256_is_zero v))
         (if-let true (absorbs_zero opcode))
         (rewrite 2 (Edit.SwapOverwrite $POP)))
(rule 300 (peep_nonpush (last2 (push v) (opcode $MUL)))
         (if-let true (u256_is_one v))
         (rewrite 2 (Edit.Keep 0)))
(rule 290 (peep_nonpush (last2 (push v) (opcode $EXP)))
         (if-let true (u256_is_one v))
         (rewrite 2 (Edit.SwapOverwrite $POP)))

;; Fold adjacent constants when the selected result materialization is a Pareto improvement.
(rule 285 (peep_nonpush (fold_constants value)) (rewrite 3 (Edit.FoldConstants value)))

;; `PUSH x POP -> ∅`.
(rule 280 (peep_nonpush (last2 (removable_push) (opcode $POP))) (rewrite 2 (Edit.Keep 0)))

;; `NOT NOT -> ∅`, `DUPn POP -> ∅`, or an involutive stack operation twice -> ∅.
(rule 270 (peep_nonpush (last2 (opcode $NOT) (opcode $NOT))) (rewrite 2 (Edit.Keep 0)))
(rule 260 (peep_nonpush (last2 (dup _) (pop))) (rewrite 2 (Edit.Keep 0)))
(rule 250 (peep_nonpush (last2 (swap n) (swap n))) (rewrite 2 (Edit.Keep 0)))
(rule 240 (peep_nonpush (last2 (exchange n m) (exchange n m))) (rewrite 2 (Edit.Keep 0)))

;; `DUPn SWAPn -> DUPn` because the swapped values are equal.
(rule 235 (peep_nonpush (last2 (dup n) (swap n))) (rewrite 2 (Edit.Keep 1)))

;; `ISZERO ISZERO ISZERO -> ISZERO`.
(rule 230 (peep_nonpush (last3 (opcode $ISZERO) (opcode $ISZERO) (opcode $ISZERO)))
         (rewrite 3 (Edit.OverwriteOne $ISZERO)))

;; `SWAP1 COMMUTATIVE_OP -> COMMUTATIVE_OP`.
(rule 220 (peep_nonpush (last2 (opcode $SWAP1) (opcode opcode)))
         (if-let true (is_commutative opcode))
         (rewrite 2 (Edit.RemoveFirstKeepOne)))

;; `SWAP1 LT -> GT`, `SWAP1 GT -> LT`, `SWAP1 SLT -> SGT`, or `SWAP1 SGT -> SLT`.
(rule 210 (peep_nonpush (last2 (opcode $SWAP1) (opcode comparison)))
         (if-let flipped (flipped_comparison comparison))
         (rewrite 2 (Edit.RemoveFirstOverwrite flipped)))

;; `DUP2 OP SWAP1 POP -> OP`.
;; `DUP2 OP SWAP1 POP -> SWAP1 OP`.
(rule 200 (peep_nonpush (last4 (opcode $DUP2) (opcode binop) (opcode $SWAP1) (opcode $POP)))
         (if-let true (is_commutative binop))
         (rewrite 4 (Edit.OverwriteOne binop)))
(rule 190 (peep_nonpush (last4 (opcode $DUP2) (opcode binop) (opcode $SWAP1) (opcode $POP)))
         (if-let true (is_noncommutative_binop binop))
         (rewrite 4 (Edit.OverwriteTwo binop)))

;; `DUP2 SINK POP -> SWAP1 SINK`.
(rule 180 (peep_nonpush (last3 (opcode $DUP2) (opcode opcode) (opcode $POP)))
         (if-let true (is_sink opcode))
         (rewrite 3 (Edit.OverwriteTwo opcode)))

;; `SWAPn POP*n SWAP1 POP -> SWAP(n+1) POP*(n+1)`.
(rule 170 (peep_nonpush (swap_pop_chain depth))
         (rewrite (u8_add depth 3) (Edit.MergeSwapPop (u8_add depth 1))))

;; `SWAPn POP*(n+1) -> POP*(n+1)` because every permuted value is discarded.
(rule 165 (peep_nonpush (swap_discard_chain pops))
          (rewrite (u8_add pops 1) (Edit.DropDiscardedSwap)))

;; `DUP1 PUSH x MSTORE DUP1 PUSH x MSTORE -> DUP1 PUSH x MSTORE`.
(rule 160 (peep_nonpush (last6 (opcode $DUP1) (push a) (opcode $MSTORE)
                      (opcode $DUP1) (push a) (opcode $MSTORE)))
         (rewrite 6 (Edit.Keep 3)))

;; `PUSH x MLOAD DUP1 PUSH x MSTORE -> PUSH x MLOAD`.
(rule 150 (peep_nonpush (last5 (push a) (opcode $MLOAD) (opcode $DUP1) (push a) (opcode $MSTORE)))
         (rewrite 5 (Edit.Keep 2)))

;; `DUP1 PUSH x MSTORE POP PUSH x MLOAD -> DUP1 PUSH x MSTORE`.
(rule 140 (peep_nonpush (last6 (opcode $DUP1) (push a) (opcode $MSTORE)
                      (opcode $POP) (push a) (opcode $MLOAD)))
         (rewrite 6 (Edit.Keep 3)))

;; `PUSH x MSTORE PUSH x MLOAD -> DUP1 PUSH x MSTORE`.
(rule 130 (peep_nonpush (last4 (push a) (opcode $MSTORE) (push a) (opcode $MLOAD)))
        (rewrite 4 (Edit.ReloadStoredValue)))

;; `DUP1 PUSH x MSTORE POP -> PUSH x MSTORE`.
(rule 120 (peep_nonpush (last4 (opcode $DUP1) (any_push) (opcode $MSTORE) (opcode $POP)))
        (rewrite 4 (Edit.RemoveFirstKeepTwo)))

;; `ISZERO ISZERO PUSH_REF JUMPI -> PUSH_REF JUMPI`.
(rule 110 (peep_nonpush (last4 (opcode $ISZERO) (opcode $ISZERO) (push_block) (opcode $JUMPI)))
        (rewrite 4 (Edit.DropDoubleIszero)))

;; `EQ ISZERO PUSH_REF JUMPI -> SUB PUSH_REF JUMPI`.
(rule 100 (peep_nonpush (last4 (opcode $EQ) (opcode $ISZERO) (push_block) (opcode $JUMPI)))
        (rewrite 4 (Edit.EqIszeroJumpi)))

;; A trailing stack sequence whose net effect is the identity.
(rule 95 (peep_nonpush (noop_stack_suffix len)) (rewrite len (Edit.Keep 0)))

;; `EXCHANGE n, m SWAPn -> SWAPn SWAPm`.
;; `EXCHANGE n, m SWAPm -> SWAPm SWAPn`.
;; `SWAPn EXCHANGE n, m -> SWAPm SWAPn`.
;; `SWAPm EXCHANGE n, m -> SWAPn SWAPm`.
(rule 90 (peep_nonpush (last2 (exchange n m) (swap n))) (rewrite 2 (Edit.StackOps (swap_op n) (swap_op m))))
(rule 80 (peep_nonpush (last2 (exchange n m) (swap m))) (rewrite 2 (Edit.StackOps (swap_op m) (swap_op n))))
(rule 70 (peep_nonpush (last2 (swap n) (exchange n m))) (rewrite 2 (Edit.StackOps (swap_op m) (swap_op n))))
(rule 60 (peep_nonpush (last2 (swap m) (exchange n m))) (rewrite 2 (Edit.StackOps (swap_op n) (swap_op m))))

;; `SWAPn SWAPm SWAPn -> EXCHANGE n, m`.
(rule 50 (peep_nonpush (last3 (swap first) (swap second) (swap third)))
        (if-let exchange (exchange_of_swaps first second third))
        (rewrite 3 (Edit.StackOp exchange)))
