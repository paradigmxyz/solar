;; Local MIR-to-EVM instruction selection.
;;
;; Each rule selects one opcode and its operand scheduling shape. Arithmetic
;; identities belong to MIR optimization; stack scheduling, version legalization,
;; calls, allocation, and control flow stay in their existing Rust lowerers.
;; Opcode bytes come from the generated EVM table. These rules are also used
;; by the target cost model, so selection and profitability share one mapping.

(type OpcodeLowering extern (enum
  (Nullary (opcode u8))
  (Unary (opcode u8))
  (Binary (opcode u8))
  (Store (opcode u8))
  (Nary (opcode u8))
  (MemoryCopy (opcode u8))
  (Log (opcode u8))
))

(decl partial select_opcode (Op) OpcodeLowering)

;; LOG0 through LOG4, by topic count.
(decl pure log_opcode (LogTopics) u8)
(extern constructor log_opcode log_opcode)

;; MLOAD or CALLDATALOAD, by source location.
(decl pure partial load_opcode (PtrLocation) u8)
(extern constructor load_opcode load_opcode)

;; MCOPY, CALLDATACOPY, or RETURNDATACOPY, by source location.
(decl pure copy_opcode (PtrLocation) u8)
(extern constructor copy_opcode copy_opcode)

(rule (select_opcode (Op.Add _ _)) (OpcodeLowering.Binary $ADD))
(rule (select_opcode (Op.Sub _ _)) (OpcodeLowering.Binary $SUB))
(rule (select_opcode (Op.Mul _ _)) (OpcodeLowering.Binary $MUL))
(rule (select_opcode (Op.Div _ _)) (OpcodeLowering.Binary $DIV))
(rule (select_opcode (Op.SDiv _ _)) (OpcodeLowering.Binary $SDIV))
(rule (select_opcode (Op.Mod _ _)) (OpcodeLowering.Binary $MOD))
(rule (select_opcode (Op.SMod _ _)) (OpcodeLowering.Binary $SMOD))
(rule (select_opcode (Op.Exp _ _)) (OpcodeLowering.Binary $EXP))
(rule (select_opcode (Op.AddMod _ _ _)) (OpcodeLowering.Nary $ADDMOD))
(rule (select_opcode (Op.MulMod _ _ _)) (OpcodeLowering.Nary $MULMOD))
(rule (select_opcode (Op.And _ _)) (OpcodeLowering.Binary $AND))
(rule (select_opcode (Op.Or _ _)) (OpcodeLowering.Binary $OR))
(rule (select_opcode (Op.Xor _ _)) (OpcodeLowering.Binary $XOR))
(rule (select_opcode (Op.Not _)) (OpcodeLowering.Unary $NOT))
(rule (select_opcode (Op.Clz _)) (OpcodeLowering.Unary $CLZ))
(rule (select_opcode (Op.Shl _ _)) (OpcodeLowering.Binary $SHL))
(rule (select_opcode (Op.Shr _ _)) (OpcodeLowering.Binary $SHR))
(rule (select_opcode (Op.Sar _ _)) (OpcodeLowering.Binary $SAR))
(rule (select_opcode (Op.Byte _ _)) (OpcodeLowering.Binary $BYTE))
(rule (select_opcode (Op.Lt _ _)) (OpcodeLowering.Binary $LT))
(rule (select_opcode (Op.Gt _ _)) (OpcodeLowering.Binary $GT))
(rule (select_opcode (Op.SLt _ _)) (OpcodeLowering.Binary $SLT))
(rule (select_opcode (Op.SGt _ _)) (OpcodeLowering.Binary $SGT))
(rule (select_opcode (Op.Eq _ _)) (OpcodeLowering.Binary $EQ))
(rule (select_opcode (Op.Load _ location)) (OpcodeLowering.Unary (load_opcode location)))
(rule (select_opcode (Op.Store _ _)) (OpcodeLowering.Store $MSTORE))
(rule (select_opcode (Op.Store8 _ _)) (OpcodeLowering.Store $MSTORE8))
(rule (select_opcode (Op.MSize)) (OpcodeLowering.Nullary $MSIZE))
(rule (select_opcode (Op.SLoad _)) (OpcodeLowering.Unary $SLOAD))
(rule (select_opcode (Op.SStore _ _)) (OpcodeLowering.Store $SSTORE))
(rule (select_opcode (Op.TLoad _)) (OpcodeLowering.Unary $TLOAD))
(rule (select_opcode (Op.TStore _ _)) (OpcodeLowering.Store $TSTORE))
(rule (select_opcode (Op.CalldataSize)) (OpcodeLowering.Nullary $CALLDATASIZE))
(rule (select_opcode (Op.Keccak256 _ _)) (OpcodeLowering.Binary $KECCAK256))
(rule (select_opcode (Op.Caller)) (OpcodeLowering.Nullary $CALLER))
(rule (select_opcode (Op.CallValue)) (OpcodeLowering.Nullary $CALLVALUE))
(rule (select_opcode (Op.Address)) (OpcodeLowering.Nullary $ADDRESS))
(rule (select_opcode (Op.Origin)) (OpcodeLowering.Nullary $ORIGIN))
(rule (select_opcode (Op.GasPrice)) (OpcodeLowering.Nullary $GASPRICE))
(rule (select_opcode (Op.Gas)) (OpcodeLowering.Nullary $GAS))
(rule (select_opcode (Op.Timestamp)) (OpcodeLowering.Nullary $TIMESTAMP))
(rule (select_opcode (Op.BlockNumber)) (OpcodeLowering.Nullary $NUMBER))
(rule (select_opcode (Op.Coinbase)) (OpcodeLowering.Nullary $COINBASE))
(rule (select_opcode (Op.ChainId)) (OpcodeLowering.Nullary $CHAINID))
(rule (select_opcode (Op.SelfBalance)) (OpcodeLowering.Nullary $SELFBALANCE))
(rule (select_opcode (Op.BaseFee)) (OpcodeLowering.Nullary $BASEFEE))
(rule (select_opcode (Op.BlobBaseFee)) (OpcodeLowering.Nullary $BLOBBASEFEE))
(rule (select_opcode (Op.GasLimit)) (OpcodeLowering.Nullary $GASLIMIT))
(rule (select_opcode (Op.SlotNum)) (OpcodeLowering.Nullary $SLOTNUM))
(rule (select_opcode (Op.PrevRandao)) (OpcodeLowering.Nullary $PREVRANDAO))
(rule (select_opcode (Op.Balance _)) (OpcodeLowering.Unary $BALANCE))
(rule (select_opcode (Op.BlockHash _)) (OpcodeLowering.Unary $BLOCKHASH))
(rule (select_opcode (Op.BlobHash _)) (OpcodeLowering.Unary $BLOBHASH))
(rule (select_opcode (Op.ExtCodeSize _)) (OpcodeLowering.Unary $EXTCODESIZE))
(rule (select_opcode (Op.ExtCodeHash _)) (OpcodeLowering.Unary $EXTCODEHASH))
(rule (select_opcode (Op.CodeSize)) (OpcodeLowering.Nullary $CODESIZE))
(rule (select_opcode (Op.ReturnDataSize)) (OpcodeLowering.Nullary $RETURNDATASIZE))
(rule (select_opcode (Op.SignExtend _ _)) (OpcodeLowering.Binary $SIGNEXTEND))
(rule (select_opcode (Op.Create _ _ _)) (OpcodeLowering.Nary $CREATE))
(rule (select_opcode (Op.Create2 _ _ _ _)) (OpcodeLowering.Nary $CREATE2))
(rule (select_opcode (Op.Log _ _ topics)) (OpcodeLowering.Log (log_opcode topics)))
(rule (select_opcode (Op.Copy _ _ _ location)) (OpcodeLowering.MemoryCopy (copy_opcode location)))
(rule (select_opcode (Op.CodeCopy _ _ _)) (OpcodeLowering.MemoryCopy $CODECOPY))
(rule (select_opcode (Op.ExtCodeCopy _ _ _ _)) (OpcodeLowering.MemoryCopy $EXTCODECOPY))
