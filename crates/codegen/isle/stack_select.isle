;; Local equivalent expressions selected against the physical stack.
;; A resident expression must already have executed in this block. Word equality
;; is equivalent to testing a wrapping difference or XOR for zero, in both
;; directions. The Rust adapter compares complete preparation/cleanup plans.

(decl zero () Value)
(extern extractor zero zero)
(decl pure partial zero_value () Value)
(extern constructor zero_value zero_value)

(decl pure partial resident (Op) Value)
(extern constructor resident resident)
(decl multi stack_rewrite (Op) Op)

(rule (stack_rewrite (Op.Eq a b))
  (if-let difference (resident (Op.Sub a b)))
  (if-let zero (zero_value))
  (Op.Eq difference zero))
(rule (stack_rewrite (Op.Eq a b))
  (if-let difference (resident (Op.Sub b a)))
  (if-let zero (zero_value))
  (Op.Eq difference zero))
(rule (stack_rewrite (Op.Eq a b))
  (if-let difference (resident (Op.Xor a b)))
  (if-let zero (zero_value))
  (Op.Eq difference zero))
(rule (stack_rewrite (Op.Eq (sub a b) (zero))) (Op.Eq a b))
(rule (stack_rewrite (Op.Eq (inst (Op.Xor a b)) (zero))) (Op.Eq a b))

;; Reuse already-computed components when their complete stack plan is cheaper.
(rule (stack_rewrite (Op.Add a b))
  (if-let common (resident (Op.And a b)))
  (if-let union (resident (Op.Or a b)))
  (Op.Add common union))
(rule (stack_rewrite (Op.Or a b))
  (if-let common (resident (Op.And a b)))
  (if-let different (resident (Op.Xor a b)))
  (Op.Add common different))
(rule (stack_rewrite (Op.Or a b))
  (if-let common (resident (Op.And a b)))
  (if-let different (resident (Op.Xor a b)))
  (Op.Xor common different))
(rule (stack_rewrite (Op.Xor a b))
  (if-let common (resident (Op.And a b)))
  (if-let union (resident (Op.Or a b)))
  (Op.Sub union common))
(rule (stack_rewrite (Op.Xor a b))
  (if-let common (resident (Op.And a b)))
  (if-let union (resident (Op.Or a b)))
  (Op.Xor common union))
(rule (stack_rewrite (Op.And a b))
  (if-let different (resident (Op.Xor a b)))
  (if-let union (resident (Op.Or a b)))
  (Op.Sub union different))
(rule (stack_rewrite (Op.And a b))
  (if-let different (resident (Op.Xor a b)))
  (if-let union (resident (Op.Or a b)))
  (Op.Xor union different))
(rule (stack_rewrite (Op.Not (bor a b)))
  (if-let left (resident (Op.Not a)))
  (if-let right (resident (Op.Not b)))
  (Op.And left right))
(rule (stack_rewrite (Op.Not (band a b)))
  (if-let left (resident (Op.Not a)))
  (if-let right (resident (Op.Not b)))
  (Op.Or left right))
(rule (stack_rewrite (Op.Eq (bor a b) (and zero (zero))))
  (if-let left (resident (Op.Eq a zero)))
  (if-let right (resident (Op.Eq b zero)))
  (Op.And left right))
