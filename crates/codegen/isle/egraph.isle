;; MIR instruction simplification rules for the e-graph pass.
;;
;; `rewrite` returns every equivalent instruction its rules can build, which
;; the e-graph adds to the class as alternative nodes, and `simplify` returns
;; the value an instruction is equal to, which merges the class into that
;; value. The pass in
;; `transform/egraph.rs` hands each instruction over with its operands
;; canonicalized and inspects operands of defining instructions as written.
;; Every rule must be exact for all 256-bit EVM words.
;;
;; The number after `rule` is an ISLE match priority: `(rule 9 ...)` is tried
;; before `(rule 8 ...)` when both match. We use distinct priorities to resolve
;; overlapping `simplify` rules; the first successful match determines the replacement.
;; The default priority is zero. These numbers order matching; Target determines
;; gas and size costs. The `multi` declaration on `rewrite` instead collects all
;; matching alternatives for the e-graph to compare by cost.
;;
;; Pseudocode below uses 256-bit wrapping arithmetic, unsigned comparisons and
;; logical `>>`; `signed(x)` selects a signed comparison or arithmetic shift.
;; Booleans are words in {0, 1}, and MAX = 2 ** 256 - 1. Named constants in the
;; patterns are compile-time immediates. `byte(i, x)` indexes from the high byte.
;; Division and modulo by zero evaluate to zero, following EVM semantics.
;; Combined shift counts saturate at 256 without wrapping. `constant(expr)` folds
;; an expression at compile time, and `**` denotes exponentiation.
;; ISLE's `(and a (iconst c))` binds both the value `a` and its immediate `c`;
;; the bitwise-AND extractor is `band`.

;; Predicates and projections implemented in `transform/egraph/isle.rs`.
(decl iconst (U256) Value)
(extern extractor iconst iconst)
(decl zero () Value)
(extern extractor zero zero)
(decl one () Value)
(extern extractor one one)
(decl all_ones () Value)
(extern extractor all_ones all_ones)
;; A value whose definition bounds it to zero or one.
(decl bool_value () Value)
(extern extractor bool_value bool_value)
;; The `address` opcode.
(decl current_address () Value)
(extern extractor current_address current_address)
;; A non-zero immediate.
(decl nonzero_const (U256) Value)
(extern extractor nonzero_const nonzero_const)
(decl pure is_const (Value) bool)
(extern constructor is_const is_const)
(decl pure is_zero_or_one (Value) bool)
(extern constructor is_zero_or_one is_zero_or_one)
;; `mask` clears the upper 96 bits of `value`, which are already clear.
(decl pure masks_clean_address (U256 Value) bool)
(extern constructor masks_clean_address masks_clean_address)
;; `mask` keeps every bit the definition of `value` can set.
(decl pure mask_covers (U256 Value) bool)
(extern constructor mask_covers mask_covers)
;; The definition of `value` bounds it below, or at most, the constant.
(decl pure below_const (Value U256) bool)
(extern constructor below_const below_const)
(decl pure at_most_const (Value U256) bool)
(extern constructor at_most_const at_most_const)
;; The shift moves every bit `value` can have out of the word.
(decl pure shifted_out (U256 Value) bool)
(extern constructor shifted_out shifted_out)
;; The sign bit `signextend` would copy is known to be clear.
(decl pure sign_clear (U256 Value) bool)
(extern constructor sign_clear sign_clear)
(decl pure differ (Value Value) bool)
(extern constructor differ differ)
(decl pure has_bitwise_shifting () bool)
(extern constructor has_bitwise_shifting has_bitwise_shifting)
(decl pure has_self_balance () bool)
(extern constructor has_self_balance has_self_balance)

(decl pure imm (U256) Value)
(extern constructor imm imm)
(decl pure imm_bool (bool) Value)
(extern constructor imm_bool imm_bool)
(decl pure u256 (u64) U256)
(extern constructor u256 u256)
(decl pure u256_max () U256)
(extern constructor u256_max u256_max)
(decl pure u256_not (U256) U256)
(extern constructor u256_not u256_not)
(decl pure u256_is_zero (U256) bool)
(extern constructor u256_is_zero u256_is_zero)
(decl pure u256_gt (U256 u64) bool)
(extern constructor u256_gt u256_gt)
(decl pure u256_ge (U256 u64) bool)
(extern constructor u256_ge u256_ge)
(decl pure u256_lt (U256 u64) bool)
(extern constructor u256_lt u256_lt)
;; `(c & bits) == bits`
(decl pure u256_has_bits (U256 u64) bool)
(extern constructor u256_has_bits u256_has_bits)
(decl pure u256_eq (U256 u64) bool)
(extern constructor u256_eq u256_eq)
(decl pure u256_is_one (U256) bool)
(extern constructor u256_is_one u256_is_one)
(decl pure u256_is_all_ones (U256) bool)
(extern constructor u256_is_all_ones u256_is_all_ones)
;; Wrapping arithmetic.
(decl pure u256_add (U256 U256) U256)
(extern constructor u256_add u256_add)
(decl pure u256_sub (U256 U256) U256)
(extern constructor u256_sub u256_sub)
(decl pure u256_neg (U256) U256)
(extern constructor u256_neg u256_neg)
(decl pure u256_and (U256 U256) U256)
(extern constructor u256_and u256_and)
;; Constant operations use EVM pop order and never truncate full-width indexes.
(decl pure u256_shl (U256 U256) U256)
(extern constructor u256_shl u256_shl)
(decl pure u256_shr (U256 U256) U256)
(extern constructor u256_shr u256_shr)
(decl pure u256_byte (U256 U256) U256)
(extern constructor u256_byte u256_byte)
(decl pure in_current_block (Value) bool)
(extern constructor in_current_block in_current_block)
(decl pure u256_same (U256 U256) bool)
(extern constructor u256_same u256_same)
(decl pure u256_from_limbs (u64 u64 u64 u64) U256)
(extern constructor u256_from_limbs u256_from_limbs)
;; Shift counts saturate at the word width; they must never wrap around.
(decl pure shift_sum (U256 U256) U256)
(extern constructor shift_sum shift_sum)
;; A byte-aligned left/right arithmetic shift pair is a sign extension.
(decl pure partial sign_byte (U256) U256)
(extern constructor sign_byte sign_byte)
(decl pure u256_min (U256 U256) U256)
(extern constructor u256_min u256_min)
(decl pure u256_le (U256 U256) bool)
(extern constructor u256_le u256_le)
;; The non-zero shift amount of a power of two.
(decl pure partial power_of_two_shift (U256) U256)
(extern constructor power_of_two_shift power_of_two_shift)
;; Identical values, or equal immediates.
(decl pure same_value (Value Value) bool)
(extern constructor same_value same_value)
(decl pure has_known_sign_bit (Value) bool)
(extern constructor has_known_sign_bit has_known_sign_bit)
(decl pure object_data_offset (MemoryObjectKind) u64)
(extern constructor object_data_offset object_data_offset)
(decl pure partial field_offset (MemoryObjectLayout u64) u64)
(extern constructor field_offset field_offset)
(decl pure layout_kind (MemoryObjectLayout) MemoryObjectKind)
(extern constructor layout_kind layout_kind)

;;;; In-place rewrites.

(decl multi rewrite (Op) Op)

;; (base + existing) + offset => base + (existing + offset), when offset != 0
(rule (rewrite (Op.Add (add base (iconst existing)) (nonzero_const offset)))
        (Op.Add base (imm (u256_add existing offset))))
;; (existing + base) + offset => base + (existing + offset), when offset != 0
(rule (rewrite (Op.Add (add (iconst existing) base) (nonzero_const offset)))
        (Op.Add base (imm (u256_add existing offset))))
;; (base - existing) + offset => base + (offset - existing), when offset != 0
(rule (rewrite (Op.Add (sub base (iconst existing)) (nonzero_const offset)))
        (Op.Add base (imm (u256_add (u256_neg existing) offset))))
;; offset + (base + existing) => base + (existing + offset), when offset != 0
(rule (rewrite (Op.Add (nonzero_const offset) (add base (iconst existing))))
        (Op.Add base (imm (u256_add existing offset))))
;; offset + (existing + base) => base + (existing + offset), when offset != 0
(rule (rewrite (Op.Add (nonzero_const offset) (add (iconst existing) base)))
        (Op.Add base (imm (u256_add existing offset))))
;; offset + (base - existing) => base + (offset - existing), when offset != 0
(rule (rewrite (Op.Add (nonzero_const offset) (sub base (iconst existing))))
        (Op.Add base (imm (u256_add (u256_neg existing) offset))))
;; c + b => b + c, when c != 0 and b is not constant
(rule (rewrite (Op.Add (and a (nonzero_const _)) b)) (if-let false (is_const b)) (Op.Add b a))

;; (base + existing) - offset => base + (existing - offset)
(rule (rewrite (Op.Sub (add base (iconst existing)) (iconst offset)))
        (Op.Add base (imm (u256_sub existing offset))))
;; (existing + base) - offset => base + (existing - offset)
(rule (rewrite (Op.Sub (add (iconst existing) base) (iconst offset)))
        (Op.Add base (imm (u256_sub existing offset))))
;; (base - existing) - offset => base + (-existing - offset)
(rule (rewrite (Op.Sub (sub base (iconst existing)) (iconst offset)))
        (Op.Add base (imm (u256_sub (u256_neg existing) offset))))

;; c * b => b * c, when c is neither 0 nor 1 and b is not constant
(rule (rewrite (Op.Mul (and a (iconst c)) b))
        (if-let false (is_const b))
        (if-let false (u256_is_zero c))
        (if-let false (u256_is_one c))
        (Op.Mul b a))
;; value * 2 ** k => value << k, when 1 <= k <= 255, value is not a known 0 or 1, and SHL is available
(rule (rewrite (Op.Mul value (iconst c)))
        (if-let false (is_zero_or_one value))
        (if-let false (u256_is_zero c))
        (if-let false (u256_is_one c))
        (if-let true (has_bitwise_shifting))
        (if-let shift (power_of_two_shift c))
        (Op.Shl (imm shift) value))

;; a / 2 ** k => a >> k, when 1 <= k <= 255 and SHR is available
(rule (rewrite (Op.Div a (iconst c)))
      (if-let true (has_bitwise_shifting))
      (if-let shift (power_of_two_shift c))
      (Op.Shr (imm shift) a))

;; a % 2 ** k => a & (2 ** k - 1), when 1 <= k <= 255
(rule (rewrite (Op.Mod a (iconst c)))
      (if-let _ (power_of_two_shift c))
      (Op.And a (imm (u256_sub c (u256 1)))))

;; a ** 2 => a * a
(rule (rewrite (Op.Exp a (iconst c))) (if-let true (u256_eq c 2)) (Op.Mul a a))

;; c & b => b & c
;; when c is neither 0 nor MAX, b is not constant, and c is not a redundant address mask
(rule (rewrite (Op.And (and a (iconst c)) b))
        (if-let false (is_const b))
        (if-let false (u256_is_zero c))
        (if-let false (u256_is_all_ones c))
        (if-let false (masks_clean_address c b))
        (Op.And b a))
;; (base & existing) & mask => base & (existing & mask), when mask is neither 0 nor MAX
(rule (rewrite (Op.And (band base (iconst existing)) (iconst mask)))
        (if-let false (u256_is_zero mask))
        (if-let false (u256_is_all_ones mask))
        (Op.And base (imm (u256_and mask existing))))
;; (existing & base) & mask => base & (existing & mask), when mask is neither 0 nor MAX
(rule (rewrite (Op.And (band (iconst existing) base) (iconst mask)))
        (if-let false (u256_is_zero mask))
        (if-let false (u256_is_all_ones mask))
        (Op.And base (imm (u256_and mask existing))))

;; MAX ^ b => ~b
(rule (rewrite (Op.Xor (all_ones) b)) (Op.Not b))
;; a ^ MAX => ~a
(rule (rewrite (Op.Xor a (all_ones))) (Op.Not a))

;; (value << inner) << outer => value << min(inner + outer, 256)
(rule (rewrite (Op.Shl (iconst outer) (shl (iconst inner) value)))
      (Op.Shl (imm (shift_sum outer inner)) value))
;; (value >> inner) >> outer => value >> min(inner + outer, 256)
(rule (rewrite (Op.Shr (iconst outer) (shr (iconst inner) value)))
      (Op.Shr (imm (shift_sum outer inner)) value))
;; (signed(value) >> inner) >> outer => signed(value) >> min(inner + outer, 256)
(rule (rewrite (Op.Sar (iconst outer) (sar (iconst inner) value)))
      (Op.Sar (imm (shift_sum outer inner)) value))

;; signed(value << amount) >> amount => signextend(31 - amount / 8, value)
;; when amount is byte-aligned and 0 <= amount <= 248
(rule (rewrite (Op.Sar (iconst amount) (shl (iconst amount) value)))
      (if-let byte (sign_byte amount))
      (Op.SignExtend (imm byte) value))

;; signextend(outer, signextend(inner, value)) => signextend(min(outer, inner), value)
(rule (rewrite (Op.SignExtend (iconst outer) (signextend (iconst inner) value)))
      (Op.SignExtend (imm (u256_min outer inner)) value))

;; a == b => b == 0, when a is a known zero and a and b have distinct value IDs
(rule (rewrite (Op.Eq (and a (zero)) b)) (if-let true (differ a b)) (Op.IsZero b))
;; a == b => a == 0, when b is a known zero and a and b have distinct value IDs
(rule (rewrite (Op.Eq a (and b (zero)))) (if-let true (differ a b)) (Op.IsZero a))
;; clz(input) == 255 => input == 1
(rule (rewrite (Op.Eq (clz input) (iconst c))) (if-let true (u256_eq c 255)) (Op.Eq input (imm (u256 1))))
;; clz(input) == 256 => input == 0
(rule (rewrite (Op.Eq (clz input) (iconst c))) (if-let true (u256_eq c 256)) (Op.IsZero input))
;; 255 == clz(input) => input == 1
(rule (rewrite (Op.Eq (iconst c) (clz input))) (if-let true (u256_eq c 255)) (Op.Eq input (imm (u256 1))))
;; 256 == clz(input) => input == 0
(rule (rewrite (Op.Eq (iconst c) (clz input))) (if-let true (u256_eq c 256)) (Op.IsZero input))

;; clz(input) == 0 => signed(input) < 0
(rule (rewrite (Op.IsZero (clz input))) (Op.SLt input (imm (u256 0))))
;; (a - b) == 0 => a == b
(rule (rewrite (Op.IsZero (sub a b))) (Op.Eq a b))
;; (a ^ b) == 0 => a == b
(rule (rewrite (Op.IsZero (bxor a b))) (Op.Eq a b))

;; clz(input) < 256 => input > 0
(rule (rewrite (Op.Lt (clz input) (iconst c))) (if-let true (u256_eq c 256)) (Op.Gt input (imm (u256 0))))
;; 255 < clz(input) => input == 0
(rule (rewrite (Op.Lt (iconst c) (clz input))) (if-let true (u256_eq c 255)) (Op.IsZero input))
;; a < 1 => a == 0
(rule (rewrite (Op.Lt a (one))) (Op.IsZero a))

;; clz(input) > 255 => input == 0
(rule (rewrite (Op.Gt (clz input) (iconst c))) (if-let true (u256_eq c 255)) (Op.IsZero input))
;; 256 > clz(input) => input > 0
(rule (rewrite (Op.Gt (iconst c) (clz input))) (if-let true (u256_eq c 256)) (Op.Gt input (imm (u256 0))))
;; 1 > b => b == 0
(rule (rewrite (Op.Gt (one) b)) (Op.IsZero b))

;; clz(input) >> 8 => input == 0
(rule (rewrite (Op.Shr (iconst c) (clz input))) (if-let true (u256_eq c 8)) (Op.IsZero input))
;; byte(30, clz(input)) => input == 0
(rule (rewrite (Op.Byte (iconst c) (clz input))) (if-let true (u256_eq c 30)) (Op.IsZero input))

;; cond ? 0 : 1 => cond == 0, when cond is boolean
(rule (rewrite (Op.Select (and cond (bool_value)) (zero) (one))) (Op.IsZero cond))

;; balance(address()) => selfbalance(), when SELFBALANCE is available
(rule (rewrite (Op.Balance (current_address))) (if-let true (has_self_balance)) (Op.SelfBalance))

;;;; Value replacements.

(decl partial simplify (Op) Value)

;; (a - b) + b => a
(rule 6 (simplify (Op.Add (sub a b) b)) a)
;; b + (a - b) => a
(rule 5 (simplify (Op.Add b (sub a b))) a)
;; a + 0 => a
(rule 2 (simplify (Op.Add a (zero))) a)
;; 0 + b => b
(rule 1 (simplify (Op.Add (zero) b)) b)

;; (a + b) - b => a
(rule 4 (simplify (Op.Sub (add a b) b)) a)
;; (a + b) - a => b
(rule 3 (simplify (Op.Sub (add a b) a)) b)
;; a - 0 => a
(rule 2 (simplify (Op.Sub a (zero))) a)
;; a - a => 0
(rule 1 (simplify (Op.Sub a a)) (imm (u256 0)))

;; 0 * _ => 0
(rule 4 (simplify (Op.Mul (and a (zero)) _)) a)
;; a * 1 => a
(rule 3 (simplify (Op.Mul a (one))) a)
;; _ * 0 => 0
(rule 2 (simplify (Op.Mul _ (and b (zero)))) b)
;; 1 * b => b
(rule 1 (simplify (Op.Mul (one) b)) b)

;; a / d => 0, when a is known to be less than constant d
(rule 5 (simplify (Op.Div a (iconst d))) (if-let true (below_const a d)) (imm (u256 0)))
;; 0 / _ => 0
(rule 4 (simplify (Op.Div (and a (zero)) _)) a)
;; a / 1 => a
(rule 3 (simplify (Op.Div a (one))) a)
;; _ / 0 => 0
(rule 2 (simplify (Op.Div _ (zero))) (imm (u256 0)))
;; clz(_) / b => 0, when constant b > 256
(rule 1 (simplify (Op.Div (clz _) (iconst b))) (if-let true (u256_gt b 256)) (imm (u256 0)))
;; sdiv(0, _) => 0
(rule 3 (simplify (Op.SDiv (and a (zero)) _)) a)
;; sdiv(a, 1) => a
(rule 2 (simplify (Op.SDiv a (one))) a)
;; sdiv(_, 0) => 0
(rule 1 (simplify (Op.SDiv _ (zero))) (imm (u256 0)))

;; a % m => a, when a is known to be less than constant m
(rule 6 (simplify (Op.Mod a (iconst m))) (if-let true (below_const a m)) a)
;; 0 % _ => 0
(rule 5 (simplify (Op.Mod (and a (zero)) _)) a)
;; _ % 0 => 0
(rule 4 (simplify (Op.Mod _ (zero))) (imm (u256 0)))
;; _ % 1 => 0
(rule 3 (simplify (Op.Mod _ (one))) (imm (u256 0)))
;; a % a => 0
(rule 2 (simplify (Op.Mod a a)) (imm (u256 0)))
;; clz(x) % b => clz(x), when constant b > 256
(rule 1 (simplify (Op.Mod (and a (clz _)) (iconst b))) (if-let true (u256_gt b 256)) a)
;; smod(0, _) => 0
(rule 4 (simplify (Op.SMod (and a (zero)) _)) a)
;; smod(_, 0) => 0
(rule 3 (simplify (Op.SMod _ (zero))) (imm (u256 0)))
;; smod(_, 1) => 0
(rule 2 (simplify (Op.SMod _ (one))) (imm (u256 0)))
;; smod(a, a) => 0
(rule 1 (simplify (Op.SMod a a)) (imm (u256 0)))

;; _ ** 0 => 1
(rule 3 (simplify (Op.Exp _ (zero))) (imm (u256 1)))
;; 1 ** _ => 1
(rule 2 (simplify (Op.Exp (and a (one)) _)) a)
;; a ** 1 => a
(rule 1 (simplify (Op.Exp a (one))) a)

;; addmod(_, _, 0) => 0
(rule 3 (simplify (Op.AddMod _ _ (zero))) (imm (u256 0)))
;; addmod(_, _, 1) => 0
(rule 2 (simplify (Op.AddMod _ _ (one))) (imm (u256 0)))
;; addmod(0, 0, _) => 0
(rule 1 (simplify (Op.AddMod (zero) (zero) _)) (imm (u256 0)))

;; mulmod(_, _, 0) => 0
(rule 4 (simplify (Op.MulMod _ _ (zero))) (imm (u256 0)))
;; mulmod(_, _, 1) => 0
(rule 3 (simplify (Op.MulMod _ _ (one))) (imm (u256 0)))
;; mulmod(0, _, _) => 0
(rule 2 (simplify (Op.MulMod (zero) _ _)) (imm (u256 0)))
;; mulmod(_, 0, _) => 0
(rule 1 (simplify (Op.MulMod _ (zero) _)) (imm (u256 0)))

;; signextend(byte, signextend(byte, x)) => signextend(byte, x)
(rule 6 (simplify (Op.SignExtend byte (and value (signextend byte _)))) value)
;; signextend(outer, signextend(inner, x)) => signextend(inner, x), when inner <= outer
(rule 5 (simplify (Op.SignExtend (iconst outer) (and value (signextend (iconst inner) _))))
        (if-let true (u256_le inner outer))
        value)
;; signextend(byte, value) => value, when byte < 31 and value is known to fit below its sign bit
(rule 4 (simplify (Op.SignExtend (iconst byte) value)) (if-let true (sign_clear byte value)) value)
;; signextend(_, 0) => 0
(rule 3 (simplify (Op.SignExtend _ (and value (zero)))) value)
;; signextend(byte, value) => value, when byte >= 31
(rule 2 (simplify (Op.SignExtend (iconst byte) value)) (if-let true (u256_ge byte 31)) value)
;; signextend(byte, clz(x)) => clz(x), when byte >= 1
(rule 1 (simplify (Op.SignExtend (iconst byte) (and value (clz _))))
        (if-let true (u256_ge byte 1))
        value)

;; a & (a | _) => a
(rule 18 (simplify (Op.And a (bor a _))) a)
;; a & (_ | a) => a
(rule 17 (simplify (Op.And a (bor _ a))) a)
;; (b | _) & b => b
(rule 16 (simplify (Op.And (bor b _) b)) b)
;; (_ | b) & b => b
(rule 15 (simplify (Op.And (bor _ b) b)) b)
;; a & mask => a, when mask is a low-bit mask covering every possible set bit of a
(rule 14 (simplify (Op.And a (iconst mask))) (if-let true (mask_covers mask a)) a)
;; mask & b => b, when mask is a low-bit mask covering every possible set bit of b
(rule 13 (simplify (Op.And (iconst mask) b)) (if-let true (mask_covers mask b)) b)
;; clz(x) & mask => clz(x), when (mask & 511) == 511
(rule 12 (simplify (Op.And (and a (clz _)) (iconst mask))) (if-let true (u256_has_bits mask 511)) a)
;; mask & clz(x) => clz(x), when (mask & 511) == 511
(rule 11 (simplify (Op.And (iconst mask) (and b (clz _)))) (if-let true (u256_has_bits mask 511)) b)
;; a & a => a
(rule 10 (simplify (Op.And a a)) a)
;; 0 & _ => 0
(rule 9 (simplify (Op.And (and a (zero)) _)) a)
;; _ & 0 => 0
(rule 6 (simplify (Op.And _ (and b (zero)))) b)
;; ~b & b => 0
(rule 3 (simplify (Op.And (bnot b) b)) (imm (u256 0)))
;; a & ~a => 0
(rule 2 (simplify (Op.And a (bnot a))) (imm (u256 0)))

;; a | (a & _) => a
(rule 11 (simplify (Op.Or a (band a _))) a)
;; a | (_ & a) => a
(rule 10 (simplify (Op.Or a (band _ a))) a)
;; (b & _) | b => b
(rule 9 (simplify (Op.Or (band b _) b)) b)
;; (_ & b) | b => b
(rule 8 (simplify (Op.Or (band _ b) b)) b)
;; a | a => a
(rule 7 (simplify (Op.Or a a)) a)
;; MAX | _ => MAX
(rule 6 (simplify (Op.Or (and a (all_ones)) _)) a)
;; a | 0 => a
(rule 5 (simplify (Op.Or a (zero))) a)
;; _ | MAX => MAX
(rule 4 (simplify (Op.Or _ (and b (all_ones)))) b)
;; 0 | b => b
(rule 3 (simplify (Op.Or (zero) b)) b)
;; ~b | b => MAX
(rule 2 (simplify (Op.Or (bnot b) b)) (imm (u256_max)))
;; a | ~a => MAX
(rule 1 (simplify (Op.Or a (bnot a))) (imm (u256_max)))

;; a ^ (a ^ b) => b
(rule 9 (simplify (Op.Xor a (bxor a b))) b)
;; a ^ (b ^ a) => b
(rule 8 (simplify (Op.Xor a (bxor b a))) b)
;; (a ^ b) ^ a => b
(rule 7 (simplify (Op.Xor (bxor a b) a)) b)
;; (b ^ a) ^ a => b
(rule 6 (simplify (Op.Xor (bxor b a) a)) b)
;; a ^ a => 0
(rule 5 (simplify (Op.Xor a a)) (imm (u256 0)))
;; 0 ^ b => b
(rule 4 (simplify (Op.Xor (zero) b)) b)
;; a ^ 0 => a
(rule 3 (simplify (Op.Xor a (zero))) a)
;; ~b ^ b => MAX
(rule 2 (simplify (Op.Xor (bnot b) b)) (imm (u256_max)))
;; a ^ ~a => MAX
(rule 1 (simplify (Op.Xor a (bnot a))) (imm (u256_max)))

;; ~~x => x
(rule 2 (simplify (Op.Not (bnot x))) x)
;; ~c => constant(~c)
(rule 1 (simplify (Op.Not (iconst c))) (imm (u256_not c)))

;; clz(a) => 0, when bit 255 of a is known to be set
(rule (simplify (Op.Clz a)) (if-let true (has_known_sign_bit a)) (imm (u256 0)))

;; value << 0 => value
(rule 3 (simplify (Op.Shl (zero) value)) value)
;; 0 << _ => 0
(rule 2 (simplify (Op.Shl _ (and value (zero)))) value)
;; _ << shift => 0, when shift >= 256
(rule 1 (simplify (Op.Shl (iconst shift) _)) (if-let true (u256_ge shift 256)) (imm (u256 0)))

;; value >> shift => 0, when shift removes every possible set bit of value
(rule 5 (simplify (Op.Shr (iconst shift) value)) (if-let true (shifted_out shift value)) (imm (u256 0)))
;; value >> 0 => value
(rule 4 (simplify (Op.Shr (zero) value)) value)
;; 0 >> _ => 0
(rule 3 (simplify (Op.Shr _ (and value (zero)))) value)
;; clz(_) >> shift => 0, when shift >= 9
(rule 2 (simplify (Op.Shr (iconst shift) (clz _))) (if-let true (u256_ge shift 9)) (imm (u256 0)))
;; _ >> shift => 0, when shift >= 256
(rule 1 (simplify (Op.Shr (iconst shift) _)) (if-let true (u256_ge shift 256)) (imm (u256 0)))

;; signed(value) >> 0 => value
(rule 2 (simplify (Op.Sar (zero) value)) value)
;; signed(0) >> _ => 0
(rule 1 (simplify (Op.Sar _ (and value (zero)))) value)

;; byte(_, 0) => 0
(rule 3 (simplify (Op.Byte _ (zero))) (imm (u256 0)))
;; byte(index, _) => 0, when index >= 32
(rule 2 (simplify (Op.Byte (iconst index) _)) (if-let true (u256_ge index 32)) (imm (u256 0)))
;; byte(index, clz(_)) => 0, when index < 30
(rule 1 (simplify (Op.Byte (iconst index) (clz _))) (if-let true (u256_lt index 30)) (imm (u256 0)))

;; c == 0 => constant(c == 0)
(rule 2 (simplify (Op.IsZero (iconst c))) (imm_bool (u256_is_zero c)))
;; (inner == 0) == 0 => inner, when inner is boolean
(rule 1 (simplify (Op.IsZero (iszero (and inner (bool_value))))) inner)

;; a == c => 0, when a is known to be less than constant c
(rule 7 (simplify (Op.Eq a (iconst c))) (if-let true (below_const a c)) (imm_bool false))
;; c == b => 0, when b is known to be less than constant c
(rule 6 (simplify (Op.Eq (iconst c) b)) (if-let true (below_const b c)) (imm_bool false))
;; a == a => 1
(rule 5 (simplify (Op.Eq a a)) (imm_bool true))
;; clz(_) == c => 0, when c > 256
(rule 4 (simplify (Op.Eq (clz _) (iconst c))) (if-let true (u256_gt c 256)) (imm_bool false))
;; c == clz(_) => 0, when c > 256
(rule 3 (simplify (Op.Eq (iconst c) (clz _))) (if-let true (u256_gt c 256)) (imm_bool false))
;; a == 1 => a, when a is boolean
(rule 2 (simplify (Op.Eq (and a (bool_value)) (one))) a)
;; 1 == b => b, when b is boolean
(rule 1 (simplify (Op.Eq (one) (and b (bool_value)))) b)

;; a < c => 1, when a is known to be less than constant c
(rule 10 (simplify (Op.Lt a (iconst c))) (if-let true (below_const a c)) (imm_bool true))
;; c < b => 0, when b is known to be at most constant c
(rule 9 (simplify (Op.Lt (iconst c) b)) (if-let true (at_most_const b c)) (imm_bool false))
;; clz(_) < b => 1, when b > 256
(rule 8 (simplify (Op.Lt (clz _) (iconst b))) (if-let true (u256_gt b 256)) (imm_bool true))
;; a < clz(_) => 0, when constant a >= 256
(rule 7 (simplify (Op.Lt (iconst a) (clz _))) (if-let true (u256_ge a 256)) (imm_bool false))
;; a < a => 0
(rule 6 (simplify (Op.Lt a a)) (imm_bool false))
;; _ < 0 => 0
(rule 5 (simplify (Op.Lt _ (zero))) (imm_bool false))
;; 0 < b => b, when b is boolean
(rule 4 (simplify (Op.Lt (zero) (and b (bool_value)))) b)
;; b < c => 1, when b is boolean and constant c > 1
(rule 3 (simplify (Op.Lt (bool_value) (iconst c))) (if-let true (u256_gt c 1)) (imm_bool true))
;; c < b => 0, when b is boolean and constant c >= 1
(rule 2 (simplify (Op.Lt (iconst c) (bool_value))) (if-let true (u256_ge c 1)) (imm_bool false))

;; a > c => 0, when a is known to be at most constant c
(rule 10 (simplify (Op.Gt a (iconst c))) (if-let true (at_most_const a c)) (imm_bool false))
;; c > b => 1, when b is known to be less than constant c
(rule 9 (simplify (Op.Gt (iconst c) b)) (if-let true (below_const b c)) (imm_bool true))
;; clz(_) > b => 0, when constant b >= 256
(rule 8 (simplify (Op.Gt (clz _) (iconst b))) (if-let true (u256_ge b 256)) (imm_bool false))
;; a > clz(_) => 1, when constant a > 256
(rule 7 (simplify (Op.Gt (iconst a) (clz _))) (if-let true (u256_gt a 256)) (imm_bool true))
;; a > a => 0
(rule 6 (simplify (Op.Gt a a)) (imm_bool false))
;; 0 > _ => 0
(rule 5 (simplify (Op.Gt (zero) _)) (imm_bool false))
;; a > 0 => a, when a is boolean
(rule 4 (simplify (Op.Gt (and a (bool_value)) (zero))) a)
;; c > b => 1, when b is boolean and constant c > 1
(rule 3 (simplify (Op.Gt (iconst c) (bool_value))) (if-let true (u256_gt c 1)) (imm_bool true))
;; b > c => 0, when b is boolean and constant c >= 1
(rule 2 (simplify (Op.Gt (bool_value) (iconst c))) (if-let true (u256_ge c 1)) (imm_bool false))

;; signed(a) < signed(a) => 0
(rule (simplify (Op.SLt a a)) (imm_bool false))
;; signed(a) > signed(a) => 0
(rule (simplify (Op.SGt a a)) (imm_bool false))

;; 1 ? then_value : _ => then_value
(rule 4 (simplify (Op.Select (one) then_value _)) then_value)
;; 0 ? _ : else_value => else_value
(rule 3 (simplify (Op.Select (zero) _ else_value)) else_value)
;; cond ? value : value => value, including equal immediates with different value IDs
(rule 2 (simplify (Op.Select _ then_value else_value))
        (if-let true (same_value then_value else_value))
        then_value)
;; cond ? 1 : 0 => cond, when cond is boolean
(rule 1 (simplify (Op.Select (and cond (bool_value)) (one) (zero))) cond)

;; memory_object_data(object, kind) => object, when kind has zero data offset
(rule (simplify (Op.MemoryObjectData object kind)) (if-let 0 (object_data_offset kind)) object)
;; memory_object_field_addr(object, layout, field) => object, when the field offset is zero
(rule (simplify (Op.MemoryObjectFieldAddr object layout field))
      (if-let 0 (field_offset layout field))
      object)
;; memory_object_element_addr(object, layout, 0) => object, when the layout has zero data offset
(rule (simplify (Op.MemoryObjectElementAddr object layout (zero)))
      (if-let 0 (object_data_offset (layout_kind layout)))
      object)
