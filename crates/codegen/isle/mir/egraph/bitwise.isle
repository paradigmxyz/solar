;; Bitwise identities and boolean combinations.

;; ~a ^ ~b => a ^ b.
(rule (rewrite (Op.Xor (bnot a) (bnot b))) (Op.Xor a b))

;; (base & existing) & mask => base & (mask & existing).
;; Requires: existing, mask are constants, mask != 0, mask != MAX.
(rule (rewrite (Op.And (band base (iconst existing)) (iconst mask)))
        (if-let false (u256_is_zero mask))
        (if-let false (u256_is_all_ones mask))
        (Op.And base (imm (u256_and mask existing))))

;; a ^ MAX => ~a, except i1 whose complement stays a legal branch condition.
(rule (rewrite (Op.Xor a (all_ones)))
      (if-let false (u256_eq (u256 (integer_width)) 1))
      (Op.Not a))
;; i1 a ^ true => a == false
(rule (rewrite (Op.Xor (and a (integer_bits 1)) (one))) (Op.Eq a (imm_bool false)))

;; x == 0 | (x * c) / x == c => x < MAX / c + 1.
;; Requires: c is constant, c >= 2. The test divides by the variable factor when the
;; constant is the left operand of the checked product.
(rule (rewrite (Op.Or (eq x (zero)) (eq (div (mul x (iconst c)) x) (iconst d))))
      (if-let true (u256_same c d))
      (if-let true (u256_ge c 2))
      (Op.Lt x (imm (u256_add (u256_div (u256_max) c) (u256 1)))))

;; Every selected bit outside constant is shifted out of the word.
;; ((value >> shift) | constant) & mask => constant & mask.
;; Requires: shift, constant, mask are constants, ((mask & ~constant) << shift) == 0.
(rule 43 (simplify (Op.And (bor (shr (iconst shift) value) (iconst constant)) (iconst mask)))
      (if-let true (u256_is_zero (u256_shl shift (u256_and mask (u256_not constant)))))
      (imm (u256_and constant mask)))

;; Every selected bit outside constant is shifted out of the word.
;; ((value << shift) | constant) & mask => constant & mask.
;; Requires: shift, constant, mask are constants, ((mask & ~constant) >> shift) == 0.
(rule 39 (simplify (Op.And (bor (shl (iconst shift) value) (iconst constant)) (iconst mask)))
      (if-let true (u256_is_zero (u256_shr shift (u256_and mask (u256_not constant)))))
      (imm (u256_and constant mask)))

;; (b | _) & b => b.
(rule 16 (simplify (Op.And (bor b _) b)) b)

;; (_ | b) & b => b.
(rule 15 (simplify (Op.And (bor _ b) b)) b)

;; a & mask => a.
;; Requires: mask is constant, mask is a low-bit mask covering all possible set bits of a.
(rule 14 (simplify (Op.And a (iconst mask))) (if-let true (mask_covers mask a)) (relied_ule a mask a))

;; clz(_) & mask => clz(_).
;; Requires: mask is constant, (mask & 511) == 511.
(rule 12 (simplify (Op.And (and a (clz _)) (iconst mask))) (if-let true (u256_has_bits mask 511)) a)

;; a & a => a.
(rule 10 (simplify (Op.And a a)) a)

;; _ & 0 => 0.
(rule 6 (simplify (Op.And _ (and b (zero)))) b)

;; ~b & b => 0.
(rule 3 (simplify (Op.And (bnot b) b)) (imm (u256 0)))

;; b | 1 => 1.
;; Requires: b is boolean.
(rule 12 (simplify (Op.Or (bool_value) (and b (one)))) b)

;; (b & _) | b => b.
(rule 9 (simplify (Op.Or (band b _) b)) b)

;; (_ & b) | b => b.
(rule 8 (simplify (Op.Or (band _ b) b)) b)

;; a | a => a.
(rule 7 (simplify (Op.Or a a)) a)

;; a | 0 => a.
(rule 5 (simplify (Op.Or a (zero))) a)

;; _ | MAX => MAX.
(rule 4 (simplify (Op.Or _ (and b (all_ones)))) b)

;; ~b | b => MAX.
(rule 2 (simplify (Op.Or (bnot b) b)) (imm (u256_max)))

;; (a ^ b) ^ a => b.
(rule 7 (simplify (Op.Xor (bxor a b) a)) b)

;; (b ^ a) ^ a => b.
(rule 6 (simplify (Op.Xor (bxor b a) a)) b)

;; a ^ a => 0.
(rule 5 (simplify (Op.Xor a a)) (imm (u256 0)))

;; a ^ 0 => a.
(rule 3 (simplify (Op.Xor a (zero))) a)

;; ~b ^ b => MAX.
(rule 2 (simplify (Op.Xor (bnot b) b)) (imm (u256_max)))

;; ~~x => x.
(rule 2 (simplify (Op.Not (bnot x))) x)

;; (x & y) & x => x & y.
(rule 1007 (simplify (Op.And (and value (band x y)) x))  value)

;; (y & x) & x => y & x.
(rule 1009 (simplify (Op.And (and value (band y x)) x))  value)

;; (x | y) | x => x | y.
(rule 1011 (simplify (Op.Or (and value (bor x y)) x))  value)

;; (y | x) | x => y | x.
(rule 1013 (simplify (Op.Or (and value (bor y x)) x))  value)

;; (x & y) & (x | z) => x & y.
(rule 1027 (simplify (Op.And (and value (band x y)) (bor x z)))  value)

;; (y & x) & (x | z) => y & x.
(rule 1031 (simplify (Op.And (and value (band y x)) (bor x z)))  value)

;; (y & x) & (z | x) => y & x.
(rule 1033 (simplify (Op.And (and value (band y x)) (bor z x)))  value)

;; (x | y) | (x & z) => x | y.
(rule 1035 (simplify (Op.Or (and value (bor x y)) (band x z)))  value)

;; (y | x) | (x & z) => y | x.
(rule 1039 (simplify (Op.Or (and value (bor y x)) (band x z)))  value)

;; (y | x) | (z & x) => y | x.
(rule 1041 (simplify (Op.Or (and value (bor y x)) (band z x)))  value)

;; (a < b) & (a == b) => false.
(rule 1105 (simplify (Op.And (lt a b) (eq a b)))  (imm_bool false))

;; (a < b) & (a > b) => false.
(rule 1107 (simplify (Op.And (lt a b) (gt a b)))  (imm_bool false))

;; (a == b) & (a > b) => false.
(rule 1109 (simplify (Op.And (eq a b) (gt a b)))  (imm_bool false))

;; (signed(a) < signed(b)) & (a == b) => false.
(rule 1111 (simplify (Op.And (slt a b) (eq a b)))  (imm_bool false))

;; (signed(a) > signed(b)) & (signed(a) < signed(b)) => false.
(rule 1114 (simplify (Op.And (sgt a b) (slt a b)))  (imm_bool false))

;; (a == b) & (signed(a) > signed(b)) => false.
(rule 1115 (simplify (Op.And (eq a b) (sgt a b)))  (imm_bool false))

;; (x < y) & (x != y) => x < y.
(rule 1202 (simplify (Op.And (and value (lt x y)) (ne x y))) value)

;; (x < y) | (x != y) => x != y.
(rule 1203 (simplify (Op.Or (lt x y) (and value (ne x y)))) value)

;; (x < y) | (y != x) => y != x.
(rule 1207 (simplify (Op.Or (lt x y) (and value (ne y x)))) value)

;; (x > y) & (x != y) => x > y.
(rule 1212 (simplify (Op.And (and value (gt x y)) (ne x y))) value)

;; (x > y) | (x != y) => x != y.
(rule 1213 (simplify (Op.Or (gt x y) (and value (ne x y)))) value)

;; (x < y) & (y < x) => false.
(rule 1220 (simplify (Op.And (lt x y) (lt y x))) (imm_bool false))

;; (signed(x) < signed(y)) & (x != y) => signed(x) < signed(y).
(rule 1224 (simplify (Op.And (and value (slt x y)) (ne x y))) value)

;; (signed(x) < signed(y)) | (x != y) => x != y.
(rule 1225 (simplify (Op.Or (slt x y) (and value (ne x y)))) value)

;; (signed(x) < signed(y)) | (y != x) => y != x.
(rule 1229 (simplify (Op.Or (slt x y) (and value (ne y x)))) value)

;; (signed(x) > signed(y)) & (x != y) => signed(x) > signed(y).
(rule 1234 (simplify (Op.And (and value (sgt x y)) (ne x y))) value)

;; (signed(x) > signed(y)) | (x != y) => x != y.
(rule 1235 (simplify (Op.Or (sgt x y) (and value (ne x y)))) value)

;; (signed(x) < signed(y)) & (signed(y) < signed(x)) => false.
(rule 1242 (simplify (Op.And (slt x y) (slt y x))) (imm_bool false))

;; (x == y) & (x != y) => false.
(rule 1300 (simplify (Op.And (eq x y) (ne x y))) (imm_bool false))

;; (x == y) | (x != y) => true.
(rule 1304 (simplify (Op.Or (eq x y) (ne x y))) (imm_bool true))

;; (x == y) ^ (x != y) => true.
(rule 1308 (simplify (Op.Xor (eq x y) (ne x y))) (imm_bool true))
