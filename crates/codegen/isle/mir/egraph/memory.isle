;; Memory operands and environment operations.

;; balance(address & mask) => balance(address), when mask keeps all low 160 bits.
;; Require a single use in this block to avoid retaining a shared mask or extending its live range.
(rule (rewrite (Op.Balance (and masked (band address (iconst mask)))))
      (if-let true (in_current_block masked))
      (if-let true (single_use masked))
      (if-let true (u256_is_zero (u256_shl (u256 96) (u256_not mask))))
      (Op.Balance address))

;; call(gas, zext(trunc(address, 160)), ...) => call(gas, address, ...).
;; The EVM consumes only the low 160 address bits; both casts must die in this block.
(rule (rewrite (Op.Call gas (and extended (zext (and narrowed (trunc (and address (integer_bits 256)) 160)))) value args_offset args_size ret_offset ret_size))
      (if-let true (in_current_block extended))
      (if-let true (single_use extended))
      (if-let true (in_current_block narrowed))
      (if-let true (single_use narrowed))
      (Op.Call gas address value args_offset args_size ret_offset ret_size))

;; callcode(gas, zext(trunc(address, 160)), ...) => callcode(gas, address, ...).
;; The EVM consumes only the low 160 address bits; both casts must die in this block.
(rule (rewrite (Op.CallCode gas (and extended (zext (and narrowed (trunc (and address (integer_bits 256)) 160)))) value args_offset args_size ret_offset ret_size))
      (if-let true (in_current_block extended))
      (if-let true (single_use extended))
      (if-let true (in_current_block narrowed))
      (if-let true (single_use narrowed))
      (Op.CallCode gas address value args_offset args_size ret_offset ret_size))

;; staticcall(gas, zext(trunc(address, 160)), ...) => staticcall(gas, address, ...).
;; The EVM consumes only the low 160 address bits; both casts must die in this block.
(rule (rewrite (Op.StaticCall gas (and extended (zext (and narrowed (trunc (and address (integer_bits 256)) 160)))) args_offset args_size ret_offset ret_size))
      (if-let true (in_current_block extended))
      (if-let true (single_use extended))
      (if-let true (in_current_block narrowed))
      (if-let true (single_use narrowed))
      (Op.StaticCall gas address args_offset args_size ret_offset ret_size))

;; delegatecall(gas, zext(trunc(address, 160)), ...) => delegatecall(gas, address, ...).
;; The EVM consumes only the low 160 address bits; both casts must die in this block.
(rule (rewrite (Op.DelegateCall gas (and extended (zext (and narrowed (trunc (and address (integer_bits 256)) 160)))) args_offset args_size ret_offset ret_size))
      (if-let true (in_current_block extended))
      (if-let true (single_use extended))
      (if-let true (in_current_block narrowed))
      (if-let true (single_use narrowed))
      (Op.DelegateCall gas address args_offset args_size ret_offset ret_size))

;; balance(address()) => selfbalance(), when SELFBALANCE is available
(rule (rewrite (Op.Balance (current_address))) (if-let true (has_self_balance)) (Op.SelfBalance))

;; memory_object_data(object, kind) => object, when kind has zero data offset
(rule (rewrite (Op.MemoryObjectData object kind)) (if-let 0 (object_data_offset kind)) (Op.Bitcast object))

;; memory_object_field_addr(object, layout, field) => object, when the field offset is zero
(rule (rewrite (Op.MemoryObjectFieldAddr object layout field))
      (if-let 0 (field_offset layout field))
      (Op.Bitcast object))

;; memory_object_element_addr(object, layout, 0) => object, when the layout has zero data offset
(rule (rewrite (Op.MemoryObjectElementAddr object layout (zero)))
      (if-let 0 (object_data_offset (layout_kind layout)))
      (Op.Bitcast object))

;; Call gas addr value offset (zero) out size => Call gas addr value (imm (u256 0)) (imm (u256 0)) out size
(rule (rewrite (Op.Call gas addr value offset (zero) out size)) (if-let false (same_value offset (imm (u256 0)))) (Op.Call gas addr value (imm (u256 0)) (imm (u256 0)) out size))

;; Call gas addr value offset size out (zero) => Call gas addr value offset size (imm (u256 0)) (imm (u256 0))
(rule (rewrite (Op.Call gas addr value offset size out (zero))) (if-let false (same_value out (imm (u256 0)))) (Op.Call gas addr value offset size (imm (u256 0)) (imm (u256 0))))

;; CallCode gas addr value offset (zero) out size => CallCode gas addr value (imm (u256 0)) (imm (u256 0)) out size
(rule (rewrite (Op.CallCode gas addr value offset (zero) out size)) (if-let false (same_value offset (imm (u256 0)))) (Op.CallCode gas addr value (imm (u256 0)) (imm (u256 0)) out size))

;; CallCode gas addr value offset size out (zero) => CallCode gas addr value offset size (imm (u256 0)) (imm (u256 0))
(rule (rewrite (Op.CallCode gas addr value offset size out (zero))) (if-let false (same_value out (imm (u256 0)))) (Op.CallCode gas addr value offset size (imm (u256 0)) (imm (u256 0))))

;; StaticCall gas addr offset (zero) out size => StaticCall gas addr (imm (u256 0)) (imm (u256 0)) out size
(rule (rewrite (Op.StaticCall gas addr offset (zero) out size)) (if-let false (same_value offset (imm (u256 0)))) (Op.StaticCall gas addr (imm (u256 0)) (imm (u256 0)) out size))

;; StaticCall gas addr offset size out (zero) => StaticCall gas addr offset size (imm (u256 0)) (imm (u256 0))
(rule (rewrite (Op.StaticCall gas addr offset size out (zero))) (if-let false (same_value out (imm (u256 0)))) (Op.StaticCall gas addr offset size (imm (u256 0)) (imm (u256 0))))

;; DelegateCall gas addr offset (zero) out size => DelegateCall gas addr (imm (u256 0)) (imm (u256 0)) out size
(rule (rewrite (Op.DelegateCall gas addr offset (zero) out size)) (if-let false (same_value offset (imm (u256 0)))) (Op.DelegateCall gas addr (imm (u256 0)) (imm (u256 0)) out size))

;; DelegateCall gas addr offset size out (zero) => DelegateCall gas addr offset size (imm (u256 0)) (imm (u256 0))
(rule (rewrite (Op.DelegateCall gas addr offset size out (zero))) (if-let false (same_value out (imm (u256 0)))) (Op.DelegateCall gas addr offset size (imm (u256 0)) (imm (u256 0))))

;; Log0 offset (zero)  => Log0 (imm (u256 0)) (imm (u256 0))
(rule (rewrite (Op.Log0 offset (zero) )) (if-let false (same_value offset (imm (u256 0)))) (Op.Log0 (imm (u256 0)) (imm (u256 0)) ))

;; Log1 offset (zero) t0 => Log1 (imm (u256 0)) (imm (u256 0)) t0
(rule (rewrite (Op.Log1 offset (zero) t0)) (if-let false (same_value offset (imm (u256 0)))) (Op.Log1 (imm (u256 0)) (imm (u256 0)) t0))

;; Log2 offset (zero) t0 t1 => Log2 (imm (u256 0)) (imm (u256 0)) t0 t1
(rule (rewrite (Op.Log2 offset (zero) t0 t1)) (if-let false (same_value offset (imm (u256 0)))) (Op.Log2 (imm (u256 0)) (imm (u256 0)) t0 t1))

;; Log3 offset (zero) t0 t1 t2 => Log3 (imm (u256 0)) (imm (u256 0)) t0 t1 t2
(rule (rewrite (Op.Log3 offset (zero) t0 t1 t2)) (if-let false (same_value offset (imm (u256 0)))) (Op.Log3 (imm (u256 0)) (imm (u256 0)) t0 t1 t2))

;; Log4 offset (zero) t0 t1 t2 t3 => Log4 (imm (u256 0)) (imm (u256 0)) t0 t1 t2 t3
(rule (rewrite (Op.Log4 offset (zero) t0 t1 t2 t3)) (if-let false (same_value offset (imm (u256 0)))) (Op.Log4 (imm (u256 0)) (imm (u256 0)) t0 t1 t2 t3))
