;; Bounded multi-operation recipes; materialize only after target cost selection.
;;
;; Pseudocode uses 256-bit wrapping words and unsigned comparisons. `>>` is
;; logical unless its left operand is signed; counts never wrap modulo 256.
;; Comparisons produce 0 or 1. `**` denotes exponentiation.

;; (x & m) == (m & y) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))
;; (x & m) == (y & m) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))
;; (m & x) == (m & y) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))
;; (m & x) == (y & m) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (x & m) != (m & y) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))
;; (x & m) != (y & m) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))
;; (m & x) != (m & y) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))
;; (m & x) != (y & m) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; shl(1, x) | 1 => x - ~x
(rule (sequence_rewrite (Op.Or (shl (one) x) (one)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))
;; 1 | shl(1, x) => x - ~x
(rule (sequence_rewrite (Op.Or (one) (shl (one) x)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))
;; (x + x) | 1 => x - ~x
(rule (sequence_rewrite (Op.Or (add x x) (one)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))
;; 1 | (x + x) => x - ~x
(rule (sequence_rewrite (Op.Or (one) (add x x)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))

;; ~x & ~y => ~(x | y)
(rule (sequence_rewrite (Op.And (bnot v0) (bnot v1))) (if-let r0 (make (Op.Or v0 v1))) (sequence (Op.Not r0)))

;; ~x | ~y => ~(x & y)
(rule (sequence_rewrite (Op.Or (bnot v0) (bnot v1))) (if-let r0 (make (Op.And v0 v1))) (sequence (Op.Not r0)))

;; (x == 0) & (y == 0) => (x | y) == 0
(rule (sequence_rewrite (Op.And (eq v0 (zero)) (eq v1 (zero)))) (if-let r0 (make (Op.Or v0 v1))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r0 zero)))

;; (m & x) | (m & y) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) | (m & y) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v1 v2))) (if-let r0 (make (Op.Or v0 v2))) (sequence (Op.And r0 v1)))
;; (m & x) | (y & m) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v2 v0))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) | (y & m) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v2 v1))) (if-let r0 (make (Op.Or v0 v2))) (sequence (Op.And r0 v1)))

;; (m & x) ^ (m & y) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) ^ (m & y) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v1 v2))) (if-let r0 (make (Op.Xor v0 v2))) (sequence (Op.And r0 v1)))
;; (m & x) ^ (y & m) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v2 v0))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) ^ (y & m) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v2 v1))) (if-let r0 (make (Op.Xor v0 v2))) (sequence (Op.And r0 v1)))

;; (m | x) & (m | y) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Or r0 v0)))
;; (x | m) & (m | y) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v1 v2))) (if-let r0 (make (Op.And v0 v2))) (sequence (Op.Or r0 v1)))
;; (m | x) & (y | m) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v2 v0))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Or r0 v0)))
;; (x | m) & (y | m) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v2 v1))) (if-let r0 (make (Op.And v0 v2))) (sequence (Op.Or r0 v1)))

;; (x << m) & (y << m) => (x & y) << m
(rule (sequence_rewrite (Op.And (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Shl v0 r0)))

;; (x << m) | (y << m) => (x | y) << m
(rule (sequence_rewrite (Op.Or (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.Shl v0 r0)))

;; (x << m) ^ (y << m) => (x ^ y) << m
(rule (sequence_rewrite (Op.Xor (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.Shl v0 r0)))

;; (x >> m) & (y >> m) => (x & y) >> m
(rule (sequence_rewrite (Op.And (shr v0 v1) (shr v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Shr v0 r0)))

;; (x >> m) | (y >> m) => (x | y) >> m
(rule (sequence_rewrite (Op.Or (shr v0 v1) (shr v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.Shr v0 r0)))

;; (x >> m) ^ (y >> m) => (x ^ y) >> m
(rule (sequence_rewrite (Op.Xor (shr v0 v1) (shr v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.Shr v0 r0)))

;; (signed(x) >> m) & (signed(y) >> m) => signed(x & y) >> m
(rule (sequence_rewrite (Op.And (sar v0 v1) (sar v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Sar v0 r0)))

;; (signed(x) >> m) | (signed(y) >> m) => signed(x | y) >> m
(rule (sequence_rewrite (Op.Or (sar v0 v1) (sar v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.Sar v0 r0)))

;; (signed(x) >> m) ^ (signed(y) >> m) => signed(x ^ y) >> m
(rule (sequence_rewrite (Op.Xor (sar v0 v1) (sar v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.Sar v0 r0)))

;; (x << m) + (y << m) => (x + y) << m
(rule (sequence_rewrite (Op.Add (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.Add v1 v2))) (sequence (Op.Shl v0 r0)))

;; x < 2 ** 8 => (x >> 8) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 256))) (if-let r0 (imm (u256 8))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 16 => (x >> 16) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 65536))) (if-let r0 (imm (u256 16))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 32 => (x >> 32) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 4294967296))) (if-let r0 (imm (u256 32))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 64 => (x >> 64) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 1 0 0))) (if-let r0 (imm (u256 64))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 128 => (x >> 128) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 1 0))) (if-let r0 (imm (u256 128))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 160 => (x >> 160) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 4294967296 0))) (if-let r0 (imm (u256 160))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 224 => (x >> 224) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 0 4294967296))) (if-let r0 (imm (u256 224))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 248 => (x >> 248) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 0 72057594037927936))) (if-let r0 (imm (u256 248))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; Seeded search: scripts/evm-rules/seeds.json.
;; (~(x & y) & x) => (~y & x)
(rule (sequence_rewrite (Op.And (bnot (band v0 v1)) v0)) (if-let r0 (make (Op.Not v1))) (sequence (Op.And r0 v0)))
;; (~(y & x) & x) => (~y & x)
(rule (sequence_rewrite (Op.And (bnot (band v0 v1)) v1)) (if-let r0 (make (Op.Not v0))) (sequence (Op.And r0 v1)))
;; (x & ~(x & y)) => (~y & x)
(rule (sequence_rewrite (Op.And v0 (bnot (band v0 v1)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.And r0 v0)))
;; (x & ~(y & x)) => (~y & x)
(rule (sequence_rewrite (Op.And v0 (bnot (band v1 v0)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.And r0 v0)))
;; (~(x | y) | x) => (~y | x)
(rule (sequence_rewrite (Op.Or (bnot (bor v0 v1)) v0)) (if-let r0 (make (Op.Not v1))) (sequence (Op.Or r0 v0)))
;; (~(y | x) | x) => (~y | x)
(rule (sequence_rewrite (Op.Or (bnot (bor v0 v1)) v1)) (if-let r0 (make (Op.Not v0))) (sequence (Op.Or r0 v1)))
;; (x | ~(x | y)) => (~y | x)
(rule (sequence_rewrite (Op.Or v0 (bnot (bor v0 v1)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.Or r0 v0)))
;; (x | ~(y | x)) => (~y | x)
(rule (sequence_rewrite (Op.Or v0 (bnot (bor v1 v0)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.Or r0 v0)))
;; select(c, x, 0) => bool(c) * x
(rule (sequence_rewrite (Op.Select c x (zero)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let b (make (Op.Eq z (imm (u256 0)))))
      (sequence (Op.Mul b x)))
;; select(c, x, 0) => c * x, when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) x (zero)))
      (sequence (Op.Mul c x)))
;; select(c, 0, x) => (c == 0) * x
(rule (sequence_rewrite (Op.Select c (zero) x))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (sequence (Op.Mul b x)))
;; select(c, MAX, x) => x | ((c == 0) - 1)
(rule (sequence_rewrite (Op.Select c (all_ones) x))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let one (imm (u256 1)))
      (if-let mask (make (Op.Sub b one)))
      (sequence (Op.Or x mask)))
;; select(c, x, MAX) => x | (0 - (c == 0))
(rule (sequence_rewrite (Op.Select c x (all_ones)))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let zero (imm (u256 0)))
      (if-let mask (make (Op.Sub zero b)))
      (sequence (Op.Or x mask)))
;; select(c, x, MAX) => x | (c - 1), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) x (all_ones)))
      (if-let one (imm (u256 1)))
      (if-let mask (make (Op.Sub c one)))
      (sequence (Op.Or x mask)))
;; General constant recipes are gas-only: the size corpus loses constant reuse.
;; select(c, T, F) => F + bool(c) * (T - F), when T >= F
(rule (sequence_rewrite (Op.Select c (iconst t) (and base (iconst f))))
      (if-let false (optimize_for_size))
      (if-let true (u256_ge t f))
      (if-let delta (imm (u256_sub t f)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let b (make (Op.Eq z (imm (u256 0)))))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add base scaled)))
;; select(c, T, F) => F + c * (T - F), when T >= F and c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (iconst t) (and base (iconst f))))
      (if-let false (optimize_for_size))
      (if-let true (u256_ge t f))
      (if-let delta (imm (u256_sub t f)))
      (if-let scaled (make (Op.Mul c delta)))
      (sequence (Op.Add base scaled)))
;; select(c, T, F) => T + (c == 0) * (F - T), when F >= T
(rule (sequence_rewrite (Op.Select c (and base (iconst t)) (iconst f)))
      (if-let false (optimize_for_size))
      (if-let true (u256_ge f t))
      (if-let delta (imm (u256_sub f t)))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add base scaled)))
;; select(c, x, K) => K + bool(c) * (x - K)
(rule (sequence_rewrite (Op.Select c x (and k (iconst _))))
      (if-let false (optimize_for_size))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let b (make (Op.Eq z (imm (u256 0)))))
      (if-let delta (make (Op.Sub x k)))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add k scaled)))
;; select(c, x, K) => K + c * (x - K), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) x (and k (iconst _))))
      (if-let false (optimize_for_size))
      (if-let delta (make (Op.Sub x k)))
      (if-let scaled (make (Op.Mul c delta)))
      (sequence (Op.Add k scaled)))
;; select(c, K, x) => K + (c == 0) * (x - K)
(rule (sequence_rewrite (Op.Select c (and k (iconst _)) x))
      (if-let false (optimize_for_size))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let delta (make (Op.Sub x k)))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add k scaled)))

;; select(c, y + x, y) => y + (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (add y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Add y gated)))
;; select(c, y, y + x) => y + ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (add y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Add y gated)))
;; select(c, x + y, y) => y + (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (add x y) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Add y gated)))
;; select(c, y, x + y) => y + ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (add x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Add y gated)))
;; select(c, y - x, y) => y - (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (sub y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Sub y gated)))
;; select(c, y, y - x) => y - ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (sub y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Sub y gated)))
;; select(c, y | x, y) => y | (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bor y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Or y gated)))
;; select(c, y, y | x) => y | ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bor y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Or y gated)))
;; select(c, x | y, y) => y | (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bor x y) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Or y gated)))
;; select(c, y, x | y) => y | ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bor x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Or y gated)))
;; select(c, y ^ x, y) => y ^ (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bxor y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Xor y gated)))
;; select(c, y, y ^ x) => y ^ ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bxor y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Xor y gated)))
;; select(c, x ^ y, y) => y ^ (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bxor x y) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Xor y gated)))
;; select(c, y, x ^ y) => y ^ ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bxor x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Xor y gated)))
;; select(c, y & x, y) => y & ~(c * ~x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (band y x) y))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul c complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
;; select(c, y, y & x) => y & ~((c == 0) * ~x)
(rule (sequence_rewrite (Op.Select c y (band y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul z complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
;; select(c, x & y, y) => y & ~(c * ~x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (band x y) y))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul c complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
;; select(c, y, x & y) => y & ~((c == 0) * ~x)
(rule (sequence_rewrite (Op.Select c y (band x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul z complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))

;; Cross-compiler scalar and canonicalization audit.

;; Exp (zero) n => Eq n zero
(rule (sequence_rewrite (Op.Exp (zero) n))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq n zero)))

;; SDiv x (iconst c) => Eq x limit
(rule (sequence_rewrite (Op.SDiv x (iconst c)))
      (if-let true (u256_same c (u256_shl (u256 255) (u256 1)))) (if-let limit (imm c))
      (sequence (Op.Eq x limit)))

;; AddMod x y (iconst m) => And value mask
(rule (sequence_rewrite (Op.AddMod x y (iconst m)))
      (if-let _ (power_of_two_shift m)) (if-let value (make (Op.Add x y))) (if-let mask (imm (u256_sub m (u256 1))))
      (sequence (Op.And value mask)))

;; MulMod x y (iconst m) => And value mask
(rule (sequence_rewrite (Op.MulMod x y (iconst m)))
      (if-let _ (power_of_two_shift m)) (if-let value (make (Op.Mul x y))) (if-let mask (imm (u256_sub m (u256 1))))
      (sequence (Op.And value mask)))

;; Sub (shl s x) (shl s y) => Shl s difference
(rule (sequence_rewrite (Op.Sub (shl s x) (shl s y)))
      (if-let difference (make (Op.Sub x y)))
      (sequence (Op.Shl s difference)))

;; Add (mul r x) (mul r y) => Mul r combined
(rule (sequence_rewrite (Op.Add (mul r x) (mul r y)))
      (if-let combined (make (Op.Add x y)))
      (sequence (Op.Mul r combined)))

;; Add (mul x r) (mul r y) => Mul r combined
(rule (sequence_rewrite (Op.Add (mul x r) (mul r y)))
      (if-let combined (make (Op.Add x y)))
      (sequence (Op.Mul r combined)))

;; Add (mul r x) (mul y r) => Mul r combined
(rule (sequence_rewrite (Op.Add (mul r x) (mul y r)))
      (if-let combined (make (Op.Add x y)))
      (sequence (Op.Mul r combined)))

;; Add (mul x r) (mul y r) => Mul r combined
(rule (sequence_rewrite (Op.Add (mul x r) (mul y r)))
      (if-let combined (make (Op.Add x y)))
      (sequence (Op.Mul r combined)))

;; Sub (mul r x) (mul r y) => Mul r combined
(rule (sequence_rewrite (Op.Sub (mul r x) (mul r y)))
      (if-let combined (make (Op.Sub x y)))
      (sequence (Op.Mul r combined)))

;; Sub (mul x r) (mul r y) => Mul r combined
(rule (sequence_rewrite (Op.Sub (mul x r) (mul r y)))
      (if-let combined (make (Op.Sub x y)))
      (sequence (Op.Mul r combined)))

;; Sub (mul r x) (mul y r) => Mul r combined
(rule (sequence_rewrite (Op.Sub (mul r x) (mul y r)))
      (if-let combined (make (Op.Sub x y)))
      (sequence (Op.Mul r combined)))

;; Sub (mul x r) (mul y r) => Mul r combined
(rule (sequence_rewrite (Op.Sub (mul x r) (mul y r)))
      (if-let combined (make (Op.Sub x y)))
      (sequence (Op.Mul r combined)))

;; Shr s (band (shl s x) m) => And x shifted
(rule (sequence_rewrite (Op.Shr s (band (shl s x) m)))
      (if-let shifted (make (Op.Shr s m)))
      (sequence (Op.And x shifted)))

;; Shr s (band m (shl s x)) => And x shifted
(rule (sequence_rewrite (Op.Shr s (band m (shl s x))))
      (if-let shifted (make (Op.Shr s m)))
      (sequence (Op.And x shifted)))

;; Eq (smod x (iconst m)) (zero) => Eq masked zero
(rule (sequence_rewrite (Op.Eq (smod x (iconst m)) (zero)))
      (if-let shift (power_of_two_shift m)) (if-let false (u256_ge shift (u256 255))) (if-let mask (imm (u256_sub m (u256 1)))) (if-let masked (make (Op.And x mask))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq masked zero)))

;; Ne (smod x (iconst m)) (zero) => Ne masked zero
(rule (sequence_rewrite (Op.Ne (smod x (iconst m)) (zero)))
      (if-let shift (power_of_two_shift m)) (if-let false (u256_ge shift (u256 255))) (if-let mask (imm (u256_sub m (u256 1)))) (if-let masked (make (Op.And x mask))) (if-let zero (imm (u256 0)))
      (sequence (Op.Ne masked zero)))

;; Exp (all_ones) n => Sub one twice
(rule (sequence_rewrite (Op.Exp (all_ones) n))
      (if-let one (imm (u256 1))) (if-let bit (make (Op.And n one))) (if-let twice (make (Op.Add bit bit)))
      (sequence (Op.Sub one twice)))

;; Div x x => Ne x zero
(rule (sequence_rewrite (Op.Div x x))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Ne x zero)))

;; Mod (one) x => Gt x one
(rule (sequence_rewrite (Op.Mod (one) x))
      (if-let one (imm (u256 1)))
      (sequence (Op.Gt x one)))

;; Select c (bnot x) (bnot y) => Not selected
(rule (sequence_rewrite (Op.Select c (bnot x) (bnot y)))
      (if-let selected (make (Op.Select c x y)))
      (sequence (Op.Not selected)))

;; Select c (sub (zero) x) (sub (zero) y) => Sub zero selected
(rule (sequence_rewrite (Op.Select c (sub (zero) x) (sub (zero) y)))
      (if-let zero (imm (u256 0))) (if-let selected (make (Op.Select c x y)))
      (sequence (Op.Sub zero selected)))

;; Or (ne x (zero)) (ne y (zero)) => Ne combined zero
(rule (sequence_rewrite (Op.Or (ne x (zero)) (ne y (zero))))
      (if-let combined (make (Op.Or x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Ne combined zero)))

;; And (band x (bnot a)) (bnot b) => And x complement
(rule (sequence_rewrite (Op.And (band x (bnot a)) (bnot b)))
      (if-let both (make (Op.Or a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.And x complement)))

;; And (band (bnot a) x) (bnot b) => And x complement
(rule (sequence_rewrite (Op.And (band (bnot a) x) (bnot b)))
      (if-let both (make (Op.Or a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.And x complement)))

;; Or (bor x (bnot a)) (bnot b) => Or x complement
(rule (sequence_rewrite (Op.Or (bor x (bnot a)) (bnot b)))
      (if-let both (make (Op.And a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.Or x complement)))

;; Or (bor (bnot a) x) (bnot b) => Or x complement
(rule (sequence_rewrite (Op.Or (bor (bnot a) x) (bnot b)))
      (if-let both (make (Op.And a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.Or x complement)))

;; Or (lt x y) (gt x y) => Ne x y
(rule (sequence_rewrite (Op.Or (lt x y) (gt x y)))

      (sequence (Op.Ne x y)))

;; Or (gt x y) (lt x y) => Ne x y
(rule (sequence_rewrite (Op.Or (gt x y) (lt x y)))

      (sequence (Op.Ne x y)))

;; Or (lt x y) (eq x y) => Eq compared zero
(rule (sequence_rewrite (Op.Or (lt x y) (eq x y)))
      (if-let compared (make (Op.Gt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Or (eq x y) (lt x y) => Eq compared zero
(rule (sequence_rewrite (Op.Or (eq x y) (lt x y)))
      (if-let compared (make (Op.Gt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Xor (lt x y) (gt x y) => Ne x y
(rule (sequence_rewrite (Op.Xor (lt x y) (gt x y)))

      (sequence (Op.Ne x y)))

;; Xor (gt x y) (lt x y) => Ne x y
(rule (sequence_rewrite (Op.Xor (gt x y) (lt x y)))

      (sequence (Op.Ne x y)))

;; Xor (lt x y) (eq x y) => Eq compared zero
(rule (sequence_rewrite (Op.Xor (lt x y) (eq x y)))
      (if-let compared (make (Op.Gt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Xor (eq x y) (lt x y) => Eq compared zero
(rule (sequence_rewrite (Op.Xor (eq x y) (lt x y)))
      (if-let compared (make (Op.Gt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Or (slt x y) (sgt x y) => Ne x y
(rule (sequence_rewrite (Op.Or (slt x y) (sgt x y)))

      (sequence (Op.Ne x y)))

;; Or (sgt x y) (slt x y) => Ne x y
(rule (sequence_rewrite (Op.Or (sgt x y) (slt x y)))

      (sequence (Op.Ne x y)))

;; Or (slt x y) (eq x y) => Eq compared zero
(rule (sequence_rewrite (Op.Or (slt x y) (eq x y)))
      (if-let compared (make (Op.SGt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Or (eq x y) (slt x y) => Eq compared zero
(rule (sequence_rewrite (Op.Or (eq x y) (slt x y)))
      (if-let compared (make (Op.SGt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Xor (slt x y) (sgt x y) => Ne x y
(rule (sequence_rewrite (Op.Xor (slt x y) (sgt x y)))

      (sequence (Op.Ne x y)))

;; Xor (sgt x y) (slt x y) => Ne x y
(rule (sequence_rewrite (Op.Xor (sgt x y) (slt x y)))

      (sequence (Op.Ne x y)))

;; Xor (slt x y) (eq x y) => Eq compared zero
(rule (sequence_rewrite (Op.Xor (slt x y) (eq x y)))
      (if-let compared (make (Op.SGt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Xor (eq x y) (slt x y) => Eq compared zero
(rule (sequence_rewrite (Op.Xor (eq x y) (slt x y)))
      (if-let compared (make (Op.SGt x y))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; Mul (mul x (iconst a)) (mul y (iconst b)) => Mul combined constant
(rule (sequence_rewrite (Op.Mul (mul x (iconst a)) (mul y (iconst b))))
      (if-let combined (make (Op.Mul x y))) (if-let constant (imm (u256_mul a b)))
      (sequence (Op.Mul combined constant)))

;; Add (add x (iconst a)) (add y (iconst b)) => Add combined constant
(rule (sequence_rewrite (Op.Add (add x (iconst a)) (add y (iconst b))))
      (if-let combined (make (Op.Add x y))) (if-let constant (imm (u256_add a b)))
      (sequence (Op.Add combined constant)))

;; And (band x (iconst a)) (band y (iconst b)) => And combined constant
(rule (sequence_rewrite (Op.And (band x (iconst a)) (band y (iconst b))))
      (if-let combined (make (Op.And x y))) (if-let constant (imm (u256_and a b)))
      (sequence (Op.And combined constant)))

;; Or (bor x (iconst a)) (bor y (iconst b)) => Or combined constant
(rule (sequence_rewrite (Op.Or (bor x (iconst a)) (bor y (iconst b))))
      (if-let combined (make (Op.Or x y))) (if-let constant (imm (u256_or a b)))
      (sequence (Op.Or combined constant)))

;; Xor (bxor x (iconst a)) (bxor y (iconst b)) => Xor combined constant
(rule (sequence_rewrite (Op.Xor (bxor x (iconst a)) (bxor y (iconst b))))
      (if-let combined (make (Op.Xor x y))) (if-let constant (imm (u256_xor a b)))
      (sequence (Op.Xor combined constant)))

;; Shr (iconst b) (shl (iconst a) x) => And shifted mask
(rule (sequence_rewrite (Op.Shr (iconst b) (shl (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let true (u256_ge a b)) (if-let count (imm (u256_sub a b))) (if-let shifted (make (Op.Shl count x))) (if-let mask (imm (u256_shr b (u256_shl a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; Shr (iconst b) (shl (iconst a) x) => And shifted mask
(rule (sequence_rewrite (Op.Shr (iconst b) (shl (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let false (u256_ge a b)) (if-let count (imm (u256_sub b a))) (if-let shifted (make (Op.Shr count x))) (if-let mask (imm (u256_shr b (u256_shl a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; Shl (iconst b) (shr (iconst a) x) => And shifted mask
(rule (sequence_rewrite (Op.Shl (iconst b) (shr (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let true (u256_ge a b)) (if-let count (imm (u256_sub a b))) (if-let shifted (make (Op.Shr count x))) (if-let mask (imm (u256_shl b (u256_shr a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; Shl (iconst b) (shr (iconst a) x) => And shifted mask
(rule (sequence_rewrite (Op.Shl (iconst b) (shr (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let false (u256_ge a b)) (if-let count (imm (u256_sub b a))) (if-let shifted (make (Op.Shl count x))) (if-let mask (imm (u256_shl b (u256_shr a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; And (shr (iconst count) (band x (iconst a))) (iconst b) => And shifted mask
(rule (sequence_rewrite (Op.And (shr (iconst count) (band x (iconst a))) (iconst b)))
      (if-let shift (imm count)) (if-let shifted (make (Op.Shr shift x))) (if-let mask (imm (u256_and (u256_shr count a) b)))
      (sequence (Op.And shifted mask)))

;; And (shl (iconst count) (band x (iconst a))) (iconst b) => And shifted mask
(rule (sequence_rewrite (Op.And (shl (iconst count) (band x (iconst a))) (iconst b)))
      (if-let shift (imm count)) (if-let shifted (make (Op.Shl shift x))) (if-let mask (imm (u256_and (u256_shl count a) b)))
      (sequence (Op.And shifted mask)))

;; select(c, zext(a), zext(b)) => zext(select(c, a, b)).
;; The temporary select retains the source integer type.
(rule (sequence_rewrite (Op.Select c (zext (and a (integer_bits bits))) (zext (and b (integer_bits bits)))))
      (if-let selected (make (Op.Select c a b)))
      (sequence (Op.Zext selected)))

;; select(c, sext(a, from, to), sext(b, from, to)) => sext(select(c, a, b), from, to).
(rule (sequence_rewrite (Op.Select c (sext (and a (integer_bits from)) from to) (sext (and b (integer_bits from)) from to)))
      (if-let selected (make (Op.Select c a b)))
      (sequence (Op.Sext selected from to)))

;; select(c, trunc(a, bits), trunc(b, bits)) => trunc(select(c, a, b), bits).
(rule (sequence_rewrite (Op.Select c (trunc (and a (integer_bits from)) bits) (trunc (and b (integer_bits from)) bits)))
      (if-let selected (make (Op.Select c a b)))
      (sequence (Op.Trunc selected bits)))

;; c ? false : b => !c & b, for canonical boolean operands.
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (zero) (and b (bool_value))))
      (if-let zero (imm (u256 0)))
      (if-let inverse (make (Op.Eq c zero)))
      (sequence (Op.And inverse b)))

;; c ? b : true => !c | b, for canonical boolean operands.
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (and b (bool_value)) (one)))
      (if-let zero (imm (u256 0)))
      (if-let inverse (make (Op.Eq c zero)))
      (sequence (Op.Or inverse b)))

;; (x - (y + a)) - b => (x - y) - (a + b).
(rule (sequence_rewrite (Op.Sub (sub x (add y (iconst a))) (iconst b)))
      (if-let difference (make (Op.Sub x y)))
      (if-let constant (imm (u256_add a b)))
      (sequence (Op.Sub difference constant)))

;; (x - (a - y)) - b => (x + y) - (a + b).
(rule (sequence_rewrite (Op.Sub (sub x (sub (iconst a) y)) (iconst b)))
      (if-let sum (make (Op.Add x y)))
      (if-let constant (imm (u256_add a b)))
      (sequence (Op.Sub sum constant)))

;; And (bnot b) (band x (bnot a)) => And x complement
(rule (sequence_rewrite (Op.And (bnot b) (band x (bnot a))))
      (if-let both (make (Op.Or a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.And x complement)))

;; And (bnot b) (band (bnot a) x) => And x complement
(rule (sequence_rewrite (Op.And (bnot b) (band (bnot a) x)))
      (if-let both (make (Op.Or a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.And x complement)))

;; Or (bnot b) (bor x (bnot a)) => Or x complement
(rule (sequence_rewrite (Op.Or (bnot b) (bor x (bnot a))))
      (if-let both (make (Op.And a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.Or x complement)))

;; Or (bnot b) (bor (bnot a) x) => Or x complement
(rule (sequence_rewrite (Op.Or (bnot b) (bor (bnot a) x)))
      (if-let both (make (Op.And a b))) (if-let complement (make (Op.Not both)))
      (sequence (Op.Or x complement)))

;; (lt(x, y) | eq(y, x)) => !gt(x, y).
(rule (sequence_rewrite (Op.Or (lt x y) (eq y x)))
      (if-let compared (make (Op.Gt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (lt(x, y) ^ eq(y, x)) => !gt(x, y).
(rule (sequence_rewrite (Op.Xor (lt x y) (eq y x)))
      (if-let compared (make (Op.Gt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (lt(x, y) | eq(y, x)) => !gt(x, y).
(rule (sequence_rewrite (Op.Or (eq y x) (lt x y)))
      (if-let compared (make (Op.Gt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (lt(x, y) ^ eq(y, x)) => !gt(x, y).
(rule (sequence_rewrite (Op.Xor (eq y x) (lt x y)))
      (if-let compared (make (Op.Gt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) | eq(x, y)) => !lt(x, y).
(rule (sequence_rewrite (Op.Or (gt x y) (eq x y)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) ^ eq(x, y)) => !lt(x, y).
(rule (sequence_rewrite (Op.Xor (gt x y) (eq x y)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) | eq(x, y)) => !lt(x, y).
(rule (sequence_rewrite (Op.Or (eq x y) (gt x y)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) ^ eq(x, y)) => !lt(x, y).
(rule (sequence_rewrite (Op.Xor (eq x y) (gt x y)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) | eq(y, x)) => !lt(x, y).
(rule (sequence_rewrite (Op.Or (gt x y) (eq y x)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) ^ eq(y, x)) => !lt(x, y).
(rule (sequence_rewrite (Op.Xor (gt x y) (eq y x)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) | eq(y, x)) => !lt(x, y).
(rule (sequence_rewrite (Op.Or (eq y x) (gt x y)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (gt(x, y) ^ eq(y, x)) => !lt(x, y).
(rule (sequence_rewrite (Op.Xor (eq y x) (gt x y)))
      (if-let compared (make (Op.Lt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (slt(x, y) | eq(y, x)) => !sgt(x, y).
(rule (sequence_rewrite (Op.Or (slt x y) (eq y x)))
      (if-let compared (make (Op.SGt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (slt(x, y) ^ eq(y, x)) => !sgt(x, y).
(rule (sequence_rewrite (Op.Xor (slt x y) (eq y x)))
      (if-let compared (make (Op.SGt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (slt(x, y) | eq(y, x)) => !sgt(x, y).
(rule (sequence_rewrite (Op.Or (eq y x) (slt x y)))
      (if-let compared (make (Op.SGt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (slt(x, y) ^ eq(y, x)) => !sgt(x, y).
(rule (sequence_rewrite (Op.Xor (eq y x) (slt x y)))
      (if-let compared (make (Op.SGt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) | eq(x, y)) => !slt(x, y).
(rule (sequence_rewrite (Op.Or (sgt x y) (eq x y)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) ^ eq(x, y)) => !slt(x, y).
(rule (sequence_rewrite (Op.Xor (sgt x y) (eq x y)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) | eq(x, y)) => !slt(x, y).
(rule (sequence_rewrite (Op.Or (eq x y) (sgt x y)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) ^ eq(x, y)) => !slt(x, y).
(rule (sequence_rewrite (Op.Xor (eq x y) (sgt x y)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) | eq(y, x)) => !slt(x, y).
(rule (sequence_rewrite (Op.Or (sgt x y) (eq y x)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) ^ eq(y, x)) => !slt(x, y).
(rule (sequence_rewrite (Op.Xor (sgt x y) (eq y x)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) | eq(y, x)) => !slt(x, y).
(rule (sequence_rewrite (Op.Or (eq y x) (sgt x y)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))

;; (sgt(x, y) ^ eq(y, x)) => !slt(x, y).
(rule (sequence_rewrite (Op.Xor (eq y x) (sgt x y)))
      (if-let compared (make (Op.SLt x y)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq compared zero)))


;; (band(zext(a:i1), zext(b:i1)) == 0) => (band(a, b) == false).
(rule (sequence_rewrite (Op.Eq (band (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))
      (if-let combined (make (Op.And a b)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq combined zero)))


;; (bor(zext(a:i1), zext(b:i1)) == 0) => (bor(a, b) == false).
(rule (sequence_rewrite (Op.Eq (bor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))
      (if-let combined (make (Op.Or a b)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq combined zero)))

;; ((a - x) - y) + b => (a + b) - (x + y), for constants a and b.
(rule (sequence_rewrite (Op.Add (sub (sub (iconst a) x) y) (iconst b)))
      (if-let sum (make (Op.Add x y)))
      (if-let constant (imm (u256_add a b)))
      (sequence (Op.Sub constant sum)))

;; ((a - x) - y) - b => (a - b) - (x + y), for constants a and b.
(rule (sequence_rewrite (Op.Sub (sub (sub (iconst a) x) y) (iconst b)))
      (if-let sum (make (Op.Add x y)))
      (if-let constant (imm (u256_sub a b)))
      (sequence (Op.Sub constant sum)))

;; (x - (y + a)) + b => (x - y) + (b - a), for constants a and b.
(rule (sequence_rewrite (Op.Add (sub x (add y (iconst a))) (iconst b)))
      (if-let difference (make (Op.Sub x y)))
      (if-let constant (imm (u256_sub b a)))
      (sequence (Op.Add difference constant)))

;; (x - (a - y)) + b => (x + y) + (b - a), for constants a and b.
(rule (sequence_rewrite (Op.Add (sub x (sub (iconst a) y)) (iconst b)))
      (if-let sum (make (Op.Add x y)))
      (if-let constant (imm (u256_sub b a)))
      (sequence (Op.Add sum constant)))
