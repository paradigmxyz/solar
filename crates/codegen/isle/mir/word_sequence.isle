;; Proved multi-operation recipes; materialize only after target cost selection.
;;
;; Pseudocode uses 256-bit wrapping words and unsigned comparisons. `>>` is
;; logical unless its left operand is signed; counts never wrap modulo 256.
;; Comparisons produce 0 or 1. `**` denotes exponentiation.

;; (x & m) == (m & y) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))
;; (x & m) == (y & m) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))
;; (m & x) == (m & y) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))
;; (m & x) == (y & m) => ((x ^ y) & m) == 0
(rule (sequence_rewrite (Op.Eq (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (x & m) != (m & y) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))
;; (x & m) != (y & m) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))
;; (m & x) != (m & y) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))
;; (m & x) != (y & m) => ((x ^ y) & m) != 0
(rule (sequence_rewrite (Op.Ne (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; shl(1, x) | 1 => x - ~x
(rule (sequence_rewrite (Op.Or (shl (one) x) (one)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))
;; 1 | shl(1, x) => x - ~x
(rule (sequence_rewrite (Op.Or (one) (shl (one) x)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))
;; (x + x) | 1 => x - ~x
(rule (sequence_rewrite (Op.Or (add x x) (one)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))
;; 1 | (x + x) => x - ~x
(rule (sequence_rewrite (Op.Or (one) (add x x)))
      (if-let complement (make (Op.Not x))) (sequence (Op.Sub x complement)))

;; ~x & ~y => ~(x | y)
(rule (sequence_rewrite (Op.And (bnot v0) (bnot v1))) (if-let r0 (make (Op.Or v0 v1))) (sequence (Op.Not r0)))

;; ~x | ~y => ~(x & y)
(rule (sequence_rewrite (Op.Or (bnot v0) (bnot v1))) (if-let r0 (make (Op.And v0 v1))) (sequence (Op.Not r0)))

;; (x == 0) & (y == 0) => (x | y) == 0
(rule (sequence_rewrite (Op.And (eq v0 (zero)) (eq v1 (zero)))) (if-let r0 (make (Op.Or v0 v1))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r0 zero)))

;; (m & x) | (m & y) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) | (m & y) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v1 v2))) (if-let r0 (make (Op.Or v0 v2))) (sequence (Op.And r0 v1)))
;; (m & x) | (y & m) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v2 v0))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) | (y & m) => (x | y) & m
(rule (sequence_rewrite (Op.Or (band v0 v1) (band v2 v1))) (if-let r0 (make (Op.Or v0 v2))) (sequence (Op.And r0 v1)))

;; (m & x) ^ (m & y) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) ^ (m & y) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v1 v2))) (if-let r0 (make (Op.Xor v0 v2))) (sequence (Op.And r0 v1)))
;; (m & x) ^ (y & m) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v2 v0))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.And r0 v0)))
;; (x & m) ^ (y & m) => (x ^ y) & m
(rule (sequence_rewrite (Op.Xor (band v0 v1) (band v2 v1))) (if-let r0 (make (Op.Xor v0 v2))) (sequence (Op.And r0 v1)))

;; (m | x) & (m | y) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Or r0 v0)))
;; (x | m) & (m | y) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v1 v2))) (if-let r0 (make (Op.And v0 v2))) (sequence (Op.Or r0 v1)))
;; (m | x) & (y | m) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v2 v0))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Or r0 v0)))
;; (x | m) & (y | m) => (x & y) | m
(rule (sequence_rewrite (Op.And (bor v0 v1) (bor v2 v1))) (if-let r0 (make (Op.And v0 v2))) (sequence (Op.Or r0 v1)))

;; (x << m) & (y << m) => (x & y) << m
(rule (sequence_rewrite (Op.And (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Shl v0 r0)))

;; (x << m) | (y << m) => (x | y) << m
(rule (sequence_rewrite (Op.Or (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.Shl v0 r0)))

;; (x << m) ^ (y << m) => (x ^ y) << m
(rule (sequence_rewrite (Op.Xor (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.Shl v0 r0)))

;; (x >> m) & (y >> m) => (x & y) >> m
(rule (sequence_rewrite (Op.And (shr v0 v1) (shr v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Shr v0 r0)))

;; (x >> m) | (y >> m) => (x | y) >> m
(rule (sequence_rewrite (Op.Or (shr v0 v1) (shr v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.Shr v0 r0)))

;; (x >> m) ^ (y >> m) => (x ^ y) >> m
(rule (sequence_rewrite (Op.Xor (shr v0 v1) (shr v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.Shr v0 r0)))

;; (signed(x) >> m) & (signed(y) >> m) => signed(x & y) >> m
(rule (sequence_rewrite (Op.And (sar v0 v1) (sar v0 v2))) (if-let r0 (make (Op.And v1 v2))) (sequence (Op.Sar v0 r0)))

;; (signed(x) >> m) | (signed(y) >> m) => signed(x | y) >> m
(rule (sequence_rewrite (Op.Or (sar v0 v1) (sar v0 v2))) (if-let r0 (make (Op.Or v1 v2))) (sequence (Op.Sar v0 r0)))

;; (signed(x) >> m) ^ (signed(y) >> m) => signed(x ^ y) >> m
(rule (sequence_rewrite (Op.Xor (sar v0 v1) (sar v0 v2))) (if-let r0 (make (Op.Xor v1 v2))) (sequence (Op.Sar v0 r0)))

;; (x << m) + (y << m) => (x + y) << m
(rule (sequence_rewrite (Op.Add (shl v0 v1) (shl v0 v2))) (if-let r0 (make (Op.Add v1 v2))) (sequence (Op.Shl v0 r0)))

;; x < 2 ** 8 => (x >> 8) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 256))) (if-let r0 (imm (u256 8))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 16 => (x >> 16) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 65536))) (if-let r0 (imm (u256 16))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 32 => (x >> 32) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 4294967296))) (if-let r0 (imm (u256 32))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 64 => (x >> 64) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 1 0 0))) (if-let r0 (imm (u256 64))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 128 => (x >> 128) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 1 0))) (if-let r0 (imm (u256 128))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 160 => (x >> 160) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 4294967296 0))) (if-let r0 (imm (u256 160))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 224 => (x >> 224) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 0 4294967296))) (if-let r0 (imm (u256 224))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < 2 ** 248 => (x >> 248) == 0
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 0 72057594037927936))) (if-let r0 (imm (u256 248))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; Seeded search: scripts/evm-rules/seeds.json.
;; (~(x & y) & x) => (~y & x)
(rule (sequence_rewrite (Op.And (bnot (band v0 v1)) v0)) (if-let r0 (make (Op.Not v1))) (sequence (Op.And r0 v0)))
;; (~(y & x) & x) => (~y & x)
(rule (sequence_rewrite (Op.And (bnot (band v0 v1)) v1)) (if-let r0 (make (Op.Not v0))) (sequence (Op.And r0 v1)))
;; (x & ~(x & y)) => (~y & x)
(rule (sequence_rewrite (Op.And v0 (bnot (band v0 v1)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.And r0 v0)))
;; (x & ~(y & x)) => (~y & x)
(rule (sequence_rewrite (Op.And v0 (bnot (band v1 v0)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.And r0 v0)))
;; (~(x | y) | x) => (~y | x)
(rule (sequence_rewrite (Op.Or (bnot (bor v0 v1)) v0)) (if-let r0 (make (Op.Not v1))) (sequence (Op.Or r0 v0)))
;; (~(y | x) | x) => (~y | x)
(rule (sequence_rewrite (Op.Or (bnot (bor v0 v1)) v1)) (if-let r0 (make (Op.Not v0))) (sequence (Op.Or r0 v1)))
;; (x | ~(x | y)) => (~y | x)
(rule (sequence_rewrite (Op.Or v0 (bnot (bor v0 v1)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.Or r0 v0)))
;; (x | ~(y | x)) => (~y | x)
(rule (sequence_rewrite (Op.Or v0 (bnot (bor v1 v0)))) (if-let r0 (make (Op.Not v1))) (sequence (Op.Or r0 v0)))
;; select(c, x, 0) => bool(c) * x
(rule (sequence_rewrite (Op.Select c x (zero)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let b (make (Op.Eq z (imm (u256 0)))))
      (sequence (Op.Mul b x)))
;; select(c, x, 0) => c * x, when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) x (zero)))
      (sequence (Op.Mul c x)))
;; select(c, 0, x) => (c == 0) * x
(rule (sequence_rewrite (Op.Select c (zero) x))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (sequence (Op.Mul b x)))
;; select(c, MAX, x) => x | ((c == 0) - 1)
(rule (sequence_rewrite (Op.Select c (all_ones) x))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let one (imm (u256 1)))
      (if-let mask (make (Op.Sub b one)))
      (sequence (Op.Or x mask)))
;; select(c, x, MAX) => x | (0 - (c == 0))
(rule (sequence_rewrite (Op.Select c x (all_ones)))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let zero (imm (u256 0)))
      (if-let mask (make (Op.Sub zero b)))
      (sequence (Op.Or x mask)))
;; select(c, x, MAX) => x | (c - 1), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) x (all_ones)))
      (if-let one (imm (u256 1)))
      (if-let mask (make (Op.Sub c one)))
      (sequence (Op.Or x mask)))
;; General constant recipes are gas-only: the size corpus loses constant reuse.
;; select(c, T, F) => F + bool(c) * (T - F), when T >= F
(rule (sequence_rewrite (Op.Select c (iconst t) (and base (iconst f))))
      (if-let false (optimize_for_size))
      (if-let true (u256_ge t f))
      (if-let delta (imm (u256_sub t f)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let b (make (Op.Eq z (imm (u256 0)))))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add base scaled)))
;; select(c, T, F) => F + c * (T - F), when T >= F and c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (iconst t) (and base (iconst f))))
      (if-let false (optimize_for_size))
      (if-let true (u256_ge t f))
      (if-let delta (imm (u256_sub t f)))
      (if-let scaled (make (Op.Mul c delta)))
      (sequence (Op.Add base scaled)))
;; select(c, T, F) => T + (c == 0) * (F - T), when F >= T
(rule (sequence_rewrite (Op.Select c (and base (iconst t)) (iconst f)))
      (if-let false (optimize_for_size))
      (if-let true (u256_ge f t))
      (if-let delta (imm (u256_sub f t)))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add base scaled)))
;; select(c, x, K) => K + bool(c) * (x - K)
(rule (sequence_rewrite (Op.Select c x (and k (iconst _))))
      (if-let false (optimize_for_size))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let b (make (Op.Eq z (imm (u256 0)))))
      (if-let delta (make (Op.Sub x k)))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add k scaled)))
;; select(c, x, K) => K + c * (x - K), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) x (and k (iconst _))))
      (if-let false (optimize_for_size))
      (if-let delta (make (Op.Sub x k)))
      (if-let scaled (make (Op.Mul c delta)))
      (sequence (Op.Add k scaled)))
;; select(c, K, x) => K + (c == 0) * (x - K)
(rule (sequence_rewrite (Op.Select c (and k (iconst _)) x))
      (if-let false (optimize_for_size))
      (if-let b (make (Op.Eq c (imm (u256 0)))))
      (if-let delta (make (Op.Sub x k)))
      (if-let scaled (make (Op.Mul b delta)))
      (sequence (Op.Add k scaled)))

;; select(c, y + x, y) => y + (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (add y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Add y gated)))
;; select(c, y, y + x) => y + ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (add y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Add y gated)))
;; select(c, x + y, y) => y + (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (add x y) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Add y gated)))
;; select(c, y, x + y) => y + ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (add x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Add y gated)))
;; select(c, y - x, y) => y - (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (sub y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Sub y gated)))
;; select(c, y, y - x) => y - ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (sub y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Sub y gated)))
;; select(c, y | x, y) => y | (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bor y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Or y gated)))
;; select(c, y, y | x) => y | ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bor y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Or y gated)))
;; select(c, x | y, y) => y | (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bor x y) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Or y gated)))
;; select(c, y, x | y) => y | ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bor x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Or y gated)))
;; select(c, y ^ x, y) => y ^ (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bxor y x) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Xor y gated)))
;; select(c, y, y ^ x) => y ^ ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bxor y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Xor y gated)))
;; select(c, x ^ y, y) => y ^ (c * x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (bxor x y) y))
      (if-let gated (make (Op.Mul c x)))
      (sequence (Op.Xor y gated)))
;; select(c, y, x ^ y) => y ^ ((c == 0) * x)
(rule (sequence_rewrite (Op.Select c y (bxor x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let gated (make (Op.Mul z x)))
      (sequence (Op.Xor y gated)))
;; select(c, y & x, y) => y & ~(c * ~x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (band y x) y))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul c complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
;; select(c, y, y & x) => y & ~((c == 0) * ~x)
(rule (sequence_rewrite (Op.Select c y (band y x)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul z complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
;; select(c, x & y, y) => y & ~(c * ~x), when c is canonical
(rule (sequence_rewrite (Op.Select (and c (bool_value)) (band x y) y))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul c complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
;; select(c, y, x & y) => y & ~((c == 0) * ~x)
(rule (sequence_rewrite (Op.Select c y (band x y)))
      (if-let z (make (Op.Eq c (imm (u256 0)))))
      (if-let complement (make (Op.Not x)))
      (if-let gated (make (Op.Mul z complement)))
      (if-let mask (make (Op.Not gated)))
      (sequence (Op.And y mask)))
