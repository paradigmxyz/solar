;; Shifts, byte extraction, and sign extension.

;; ((x << s) & m) >> s => x & (m >> s).
(rule (sequence_rewrite (Op.Shr s (band (shl s x) m)))
      (if-let shifted (make (Op.Shr s m)))
      (sequence (Op.And x shifted)))

;; (m & (x << s)) >> s => x & (m >> s).
(rule (sequence_rewrite (Op.Shr s (band m (shl s x))))
      (if-let shifted (make (Op.Shr s m)))
      (sequence (Op.And x shifted)))

;; (x << a) >> b => (x << (a - b)) & ((MAX << a) >> b).
;; Requires: b, a are constants, a != b, a >= b.
(rule (sequence_rewrite (Op.Shr (iconst b) (shl (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let true (u256_ge a b)) (if-let count (imm (u256_sub a b))) (if-let shifted (make (Op.Shl count x))) (if-let mask (imm (u256_shr b (u256_shl a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; (x << a) >> b => (x >> (b - a)) & ((MAX << a) >> b).
;; Requires: b, a are constants, a != b, a < b.
(rule (sequence_rewrite (Op.Shr (iconst b) (shl (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let false (u256_ge a b)) (if-let count (imm (u256_sub b a))) (if-let shifted (make (Op.Shr count x))) (if-let mask (imm (u256_shr b (u256_shl a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; (x >> a) << b => (x >> (a - b)) & ((MAX >> a) << b).
;; Requires: b, a are constants, a != b, a >= b.
(rule (sequence_rewrite (Op.Shl (iconst b) (shr (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let true (u256_ge a b)) (if-let count (imm (u256_sub a b))) (if-let shifted (make (Op.Shr count x))) (if-let mask (imm (u256_shl b (u256_shr a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; (x >> a) << b => (x << (b - a)) & ((MAX >> a) << b).
;; Requires: b, a are constants, a != b, a < b.
(rule (sequence_rewrite (Op.Shl (iconst b) (shr (iconst a) x)))
      (if-let false (u256_same a b))
      (if-let false (u256_ge a b)) (if-let count (imm (u256_sub b a))) (if-let shifted (make (Op.Shl count x))) (if-let mask (imm (u256_shl b (u256_shr a (u256_max)))))
      (sequence (Op.And shifted mask)))

;; (x >> a) & (MAX >> s) => (x << (s - a)) >> s.
;; Requires: optimizing for gas, x is 256 bits, a is constant, the mask is a constant (MAX >> s)
;; that no other instruction reads, a < s < 256. Size builds keep the masks, which the
;; pairs made larger.
(rule (sequence_rewrite (Op.And (shr (iconst a) (and x (integer_bits 256))) (iconst m)))
      (if-let true (late_word_sequence))
      (if-let false (optimize_for_size))
      (if-let s (low_mask_shift m))
      (if-let true (unshared_mask m))
      (if-let false (u256_ge a s))
      (if-let count (imm (u256_sub s a)))
      (if-let width (imm s))
      (if-let high (make (Op.Shl count x)))
      (sequence (Op.Shr width high)))

;; (x & (MAX >> s)) << b => (x << s) >> (s - b).
;; Requires: optimizing for gas, x is 256 bits, b is constant, the mask is a constant (MAX >> s)
;; that no other instruction reads, b < s < 256.
(rule (sequence_rewrite (Op.Shl (iconst b) (band (and x (integer_bits 256)) (iconst m))))
      (if-let true (late_word_sequence))
      (if-let false (optimize_for_size))
      (if-let s (low_mask_shift m))
      (if-let true (unshared_mask m))
      (if-let false (u256_ge b s))
      (if-let width (imm s))
      (if-let count (imm (u256_sub s b)))
      (if-let high (make (Op.Shl width x)))
      (sequence (Op.Shr count high)))
