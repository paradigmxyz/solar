;; Equality and ordered comparison identities.

;; (x & m) == (m & y) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (x & m) == (y & m) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (m & x) == (m & y) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (m & x) == (y & m) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (x & m) != (m & y) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; (x & m) != (y & m) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; (m & x) != (m & y) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; (m & x) != (y & m) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; A width test, that a word fits in `k` bits or does not, is canonically the comparison with
;; its limit, `x < 2 ** k` or `x > 2 ** k - 1`, for 1 <= k < W. The run that spells the tests,
;; late and lowered, chooses between the two by price, where the uses are known.

;; (x >> k) != 0 => x > 2 ** k - 1.
;; Requires: k is constant, 1 <= k < W.
(rule (sequence_rewrite (Op.Ne (shr (iconst k) x) (zero)))
      (if-let false (spelling_widths))
      (if-let true (u256_ge k (u256 1)))
      (if-let false (u256_ge k (u256_add (u256 (integer_sign_bit)) (u256 1))))
      (if-let limit (imm (u256_sub (u256_shl k (u256 1)) (u256 1))))
      (enabling_sequence (Op.Gt x limit)))

;; (x >> k) > 0 => x > 2 ** k - 1.
;; Requires: k is constant, 1 <= k < W.
(rule (sequence_rewrite (Op.Gt (shr (iconst k) x) (zero)))
      (if-let false (spelling_widths))
      (if-let true (u256_ge k (u256 1)))
      (if-let false (u256_ge k (u256_add (u256 (integer_sign_bit)) (u256 1))))
      (if-let limit (imm (u256_sub (u256_shl k (u256 1)) (u256 1))))
      (enabling_sequence (Op.Gt x limit)))

;; (x >> k) == 0 => x < 2 ** k.
;; Requires: k is constant, 1 <= k < W.
(rule (sequence_rewrite (Op.Eq (shr (iconst k) x) (zero)))
      (if-let false (spelling_widths))
      (if-let true (u256_ge k (u256 1)))
      (if-let false (u256_ge k (u256_add (u256 (integer_sign_bit)) (u256 1))))
      (if-let limit (imm (u256_shl k (u256 1))))
      (enabling_sequence (Op.Lt x limit)))

;; (x & m) != 0 => x > 2 ** k - 1.
;; Requires: m is constant, m == 2 ** W - 2 ** k and 1 <= k < W.
(rule (sequence_rewrite (Op.Ne (band x (iconst m)) (zero)))
      (if-let false (spelling_widths))
      (if-let power (u256_sub (u256 0) m))
      (if-let _ (power_of_two_shift power))
      (if-let limit (imm (u256_sub power (u256 1))))
      (enabling_sequence (Op.Gt x limit)))

;; (x & m) == 0 => x < 2 ** k.
;; Requires: m is constant, m == 2 ** W - 2 ** k and 1 <= k < W.
(rule (sequence_rewrite (Op.Eq (band x (iconst m)) (zero)))
      (if-let false (spelling_widths))
      (if-let power (u256_sub (u256 0) m))
      (if-let _ (power_of_two_shift power))
      (if-let limit (imm power))
      (enabling_sequence (Op.Lt x limit)))

;; x < 2 ** k => (x >> k) == 0.
;; Requires: k is constant, 1 <= k, and the block computes x >> k already.
(rule (sequence_rewrite (Op.Lt v0 (iconst c0)))
      (if-let true (spelling_widths))
      (if-let k (power_of_two_shift c0))
      (if-let r1 (shared_shift k v0))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq r1 zero)))

;; x > 2 ** k - 1 => (x >> k) != 0.
;; Requires: k is constant, 1 <= k, and the block computes x >> k already.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0)))
      (if-let true (spelling_widths))
      (if-let k (power_of_two_shift (u256_add c0 (u256 1))))
      (if-let r1 (shared_shift k v0))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Ne r1 zero)))

;; x < 2 ** k => (x >> k) == 0.
;; Requires: k is constant, 1 <= k, and the target prices the shift below the comparison.
(rule (sequence_rewrite (Op.Lt v0 (iconst c0)))
      (if-let true (spelling_widths))
      (if-let k (power_of_two_shift c0))
      (if-let true (width_shifts k true))
      (if-let r0 (imm k))
      (if-let r1 (make (Op.Shr r0 v0)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Eq r1 zero)))

;; x > 2 ** k - 1 => (x >> k) != 0.
;; Requires: k is constant, 1 <= k, and the target prices the shift below the comparison.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0)))
      (if-let true (spelling_widths))
      (if-let k (power_of_two_shift (u256_add c0 (u256 1))))
      (if-let true (width_shifts k false))
      (if-let r0 (imm k))
      (if-let r1 (make (Op.Shr r0 v0)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Ne r1 zero)))

;; A mask that stays keeps the low `W - s` bits of a word, and `x & m` equals or differs from a
;; word `y` that has at most that many bits exactly when the difference of `x` and `y`, shifted
;; left by `s`, is zero or not. The shifted word is a zero test that a branch reads for free.
;; The target prices the spelling for the root's use, and the root removes the mask.

;; (x & m) == 0 => (x << s) == 0.
;; Requires: m == MAX >> s, nothing else reads the mask, and the target prices the shift lower.
(rule (sequence_rewrite (Op.Eq (and mask (band x (iconst m))) (zero)))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let true (sole_reader mask))
      (if-let true (masked_shifts s true true))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Shl r0 x)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Eq r1 zero)))

;; (x & m) != 0 => (x << s) != 0.
(rule (sequence_rewrite (Op.Ne (and mask (band x (iconst m))) (zero)))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let true (sole_reader mask))
      (if-let true (masked_shifts s false true))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Shl r0 x)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Ne r1 zero)))

;; (x & m) == y => ((x ^ y) << s) == 0.
;; Requires: m == MAX >> s, y is not zero and has at most W - s bits, nothing else reads the mask,
;; and the target prices the shift lower.
(rule (sequence_rewrite (Op.Eq (and mask (band x (iconst m))) y))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let false (zero_operand y))
      (if-let true (sole_reader mask))
      (if-let true (fits_below_shift y s))
      (if-let true (masked_shifts s true false))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Xor x y)))
      (if-let r2 (make (Op.Shl r0 r1)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Eq r2 zero)))

;; y == (x & m) => ((x ^ y) << s) == 0.
(rule (sequence_rewrite (Op.Eq y (and mask (band x (iconst m)))))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let false (zero_operand y))
      (if-let true (sole_reader mask))
      (if-let true (fits_below_shift y s))
      (if-let true (masked_shifts s true false))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Xor x y)))
      (if-let r2 (make (Op.Shl r0 r1)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Eq r2 zero)))

;; (x & m) != y => ((x ^ y) << s) != 0.
(rule (sequence_rewrite (Op.Ne (and mask (band x (iconst m))) y))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let false (zero_operand y))
      (if-let true (sole_reader mask))
      (if-let true (fits_below_shift y s))
      (if-let true (masked_shifts s false false))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Xor x y)))
      (if-let r2 (make (Op.Shl r0 r1)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Ne r2 zero)))

;; y != (x & m) => ((x ^ y) << s) != 0.
(rule (sequence_rewrite (Op.Ne y (and mask (band x (iconst m)))))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let false (zero_operand y))
      (if-let true (sole_reader mask))
      (if-let true (fits_below_shift y s))
      (if-let true (masked_shifts s false false))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Xor x y)))
      (if-let r2 (make (Op.Shl r0 r1)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Ne r2 zero)))

;; (x & m) == (z & m) => ((x ^ z) << s) == 0.
;; Requires: m == MAX >> s, nothing else reads either mask, and the target prices the shift lower.
;; Both masks go, whatever bits `x` and `z` have above the mask.
(rule (sequence_rewrite (Op.Eq (and mask (band x (iconst m))) (and other (band z (iconst n)))))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let true (u256_same m n))
      (if-let true (sole_reader mask))
      (if-let true (sole_reader other))
      (if-let true (masked_shifts s true false))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Xor x z)))
      (if-let r2 (make (Op.Shl r0 r1)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Eq r2 zero)))

;; (x & m) != (z & m) => ((x ^ z) << s) != 0.
(rule (sequence_rewrite (Op.Ne (and mask (band x (iconst m))) (and other (band z (iconst n)))))
      (if-let true (spelling_widths))
      (if-let s (low_mask_shift m))
      (if-let true (u256_same m n))
      (if-let true (sole_reader mask))
      (if-let true (sole_reader other))
      (if-let true (masked_shifts s false false))
      (if-let r0 (imm s))
      (if-let r1 (make (Op.Xor x z)))
      (if-let r2 (make (Op.Shl r0 r1)))
      (if-let zero (imm (u256 0)))
      (enabling_sequence (Op.Ne r2 zero)))

;; (x < 2 ** k) & (w == 0) => ((x >> k) | w) == 0.
;; Requires: k is constant, 1 <= k. The tests join into one word that a branch reads for free.
(rule (sequence_rewrite (Op.And (lt x (iconst c)) (eq w (zero))))
      (if-let true (spelling_widths))
      (if-let k (power_of_two_shift c))
      (if-let r0 (imm k))
      (if-let r1 (make (Op.Shr r0 x)))
      (if-let r2 (make (Op.Or r1 w)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq r2 zero)))

;; (w == 0) & (x < 2 ** k) => (w | (x >> k)) == 0.
;; Requires: k is constant, 1 <= k.
(rule (sequence_rewrite (Op.And (eq w (zero)) (lt x (iconst c))))
      (if-let true (spelling_widths))
      (if-let k (power_of_two_shift c))
      (if-let r0 (imm k))
      (if-let r1 (make (Op.Shr r0 x)))
      (if-let r2 (make (Op.Or w r1)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq r2 zero)))

;; smod(x, m) == 0 => (x & (m - 1)) == 0.
;; Requires: m is constant, m == 2 ** shift and 1 <= shift <= (W - 1), shift < (W - 1).
(rule (sequence_rewrite (Op.Eq (smod x (iconst m)) (zero)))
      (if-let shift (power_of_two_shift m)) (if-let false (u256_ge shift (u256 (integer_sign_bit)))) (if-let mask (imm (u256_sub m (u256 1)))) (if-let masked (make (Op.And x mask))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq masked zero)))

;; smod(x, m) != 0 => (x & (m - 1)) != 0.
;; Requires: m is constant, m == 2 ** shift and 1 <= shift <= (W - 1), shift < (W - 1).
(rule (sequence_rewrite (Op.Ne (smod x (iconst m)) (zero)))
      (if-let shift (power_of_two_shift m)) (if-let false (u256_ge shift (u256 (integer_sign_bit)))) (if-let mask (imm (u256_sub m (u256 1)))) (if-let masked (make (Op.And x mask))) (if-let zero (imm (u256 0)))
      (sequence (Op.Ne masked zero)))

;; (zext(a) & zext(b)) == 0 => (a & b) == 0.
;; Requires: a is boolean, b is boolean.
(rule (sequence_rewrite (Op.Eq (band (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))
      (if-let combined (make (Op.And a b)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq combined zero)))

;; (zext(a) | zext(b)) == 0 => (a | b) == 0.
;; Requires: a is boolean, b is boolean.
(rule (sequence_rewrite (Op.Eq (bor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))
      (if-let combined (make (Op.Or a b)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq combined zero)))

;; (x / c) * c == x => x % c == 0.
;; Requires: c is constant, c != 0. x is a multiple of c.
(rule (sequence_rewrite (Op.Eq (mul (div x (iconst c)) (iconst d)) x))
      (if-let true (u256_ge c (u256 1)))
      (if-let true (u256_same c d))
      (if-let divisor (imm c))
      (if-let remainder (make (Op.Mod x divisor)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq remainder zero)))

;; x == (x / c) * c => x % c == 0.
;; Requires: c is constant, c != 0.
(rule (sequence_rewrite (Op.Eq x (mul (div x (iconst c)) (iconst d))))
      (if-let true (u256_ge c (u256 1)))
      (if-let true (u256_same c d))
      (if-let divisor (imm c))
      (if-let remainder (make (Op.Mod x divisor)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq remainder zero)))

;; Branch folding, check elimination, and if-conversion read these comparisons against MAX
;; first, so the recipes wait for the late run. A branch reads `~x` as it is.

;; x < MAX => ~x != 0.
;; Requires: W == 256, so `not` needs no mask.
(rule (sequence_rewrite (Op.Lt (and x (integer_bits 256)) (all_ones)))
      (if-let true (late_word_sequence))
      (if-let complement (make (Op.Not x)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne complement zero)))

;; x > (MAX - 1) => ~x == 0.
;; Requires: W == 256, c is constant, c == (MAX - 1).
(rule (sequence_rewrite (Op.Gt (and x (integer_bits 256)) (iconst c)))
      (if-let true (late_word_sequence))
      (if-let true (u256_same c (u256_sub (u256_max) (u256 1))))
      (if-let complement (make (Op.Not x)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq complement zero)))

;; x != MAX => ~x != 0.
;; Requires: W == 256.
(rule (sequence_rewrite (Op.Ne (and x (integer_bits 256)) (all_ones)))
      (if-let true (late_word_sequence))
      (if-let complement (make (Op.Not x)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne complement zero)))
