;; Equality and ordered comparison identities.

;; (x & m) == (m & y) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (x & m) == (y & m) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (m & x) == (m & y) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (m & x) == (y & m) => ((x ^ y) & m) == 0.
(rule (sequence_rewrite (Op.Eq (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq masked zero)))

;; (x & m) != (m & y) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band x m) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; (x & m) != (y & m) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band x m) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; (m & x) != (m & y) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band m x) (band m y)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; (m & x) != (y & m) => ((x ^ y) & m) != 0.
(rule (sequence_rewrite (Op.Ne (band m x) (band y m)))
      (if-let difference (make (Op.Xor x y)))
      (if-let masked (make (Op.And difference m)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne masked zero)))

;; x < c0 => (x >> 8) == 0.
;; Requires: c0 is constant, c0 == 256.
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 256))) (if-let r0 (imm (u256 8))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 16) == 0.
;; Requires: c0 is constant, c0 == 65536.
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 65536))) (if-let r0 (imm (u256 16))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 32) == 0.
;; Requires: c0 is constant, c0 == 4294967296.
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256 4294967296))) (if-let r0 (imm (u256 32))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 64) == 0.
;; Requires: c0 is constant, c0 == 0x10000000000000000.
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 1 0 0))) (if-let r0 (imm (u256 64))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 128) == 0.
;; Requires: c0 is constant, c0 == (2 ** 128).
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 1 0))) (if-let r0 (imm (u256 128))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 160) == 0.
;; Requires: c0 is constant, c0 == (2 ** 160).
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 4294967296 0))) (if-let r0 (imm (u256 160))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 224) == 0.
;; Requires: c0 is constant, c0 == (2 ** 224).
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 0 4294967296))) (if-let r0 (imm (u256 224))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x < c0 => (x >> 248) == 0.
;; Requires: c0 is constant, c0 ==
;; (2 ** 248).
(rule (sequence_rewrite (Op.Lt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 0 0 0 72057594037927936))) (if-let r0 (imm (u256 248))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Eq r1 zero)))

;; x > c0 => (x >> 8) != 0.
;; Requires: c0 is constant, c0 == 255.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256 255))) (if-let r0 (imm (u256 8))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 16) != 0.
;; Requires: c0 is constant, c0 == 65535.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256 65535))) (if-let r0 (imm (u256 16))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 32) != 0.
;; Requires: c0 is constant, c0 == 4294967295.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256 4294967295))) (if-let r0 (imm (u256 32))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 64) != 0.
;; Requires: c0 is constant, c0 == (2 ** 64) - 1.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 18446744073709551615 0 0 0))) (if-let r0 (imm (u256 64))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 128) != 0.
;; Requires: c0 is constant, c0 == (2 ** 128) - 1.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 18446744073709551615 18446744073709551615 0 0))) (if-let r0 (imm (u256 128))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 160) != 0.
;; Requires: c0 is constant, c0 == (2 ** 160) - 1.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 18446744073709551615 18446744073709551615 4294967295 0))) (if-let r0 (imm (u256 160))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 224) != 0.
;; Requires: c0 is constant, c0 == (2 ** 224) - 1.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 18446744073709551615 18446744073709551615 18446744073709551615 4294967295))) (if-let r0 (imm (u256 224))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; x > c0 => (x >> 248) != 0.
;; Requires: c0 is constant, c0 == (2 ** 248) - 1.
(rule (sequence_rewrite (Op.Gt v0 (iconst c0))) (if-let true (u256_same c0 (u256_from_limbs 18446744073709551615 18446744073709551615 18446744073709551615 72057594037927935))) (if-let r0 (imm (u256 248))) (if-let r1 (make (Op.Shr r0 v0))) (if-let zero (imm (u256 0))) (sequence (Op.Ne r1 zero)))

;; (x >> c0) != 0 => x > (1 << c0) - 1.
;; Requires: c0 is constant.
;; The inverse of the rules above: a test that a branch reads costs nothing, but a
;; zero-or-one word needs two `ISZERO`s, which one comparison saves.
(rule (sequence_rewrite (Op.Ne (shr (iconst c0) x) (zero)))
      (if-let mask (imm (u256_sub (u256_shl c0 (u256 1)) (u256 1))))
      (sequence (Op.Gt x mask)))

;; smod(x, m) == 0 => (x & (m - 1)) == 0.
;; Requires: m is constant, m == 2 ** shift and 1 <= shift <= (W - 1), shift < (W - 1).
(rule (sequence_rewrite (Op.Eq (smod x (iconst m)) (zero)))
      (if-let shift (power_of_two_shift m)) (if-let false (u256_ge shift (u256 (integer_sign_bit)))) (if-let mask (imm (u256_sub m (u256 1)))) (if-let masked (make (Op.And x mask))) (if-let zero (imm (u256 0)))
      (sequence (Op.Eq masked zero)))

;; smod(x, m) != 0 => (x & (m - 1)) != 0.
;; Requires: m is constant, m == 2 ** shift and 1 <= shift <= (W - 1), shift < (W - 1).
(rule (sequence_rewrite (Op.Ne (smod x (iconst m)) (zero)))
      (if-let shift (power_of_two_shift m)) (if-let false (u256_ge shift (u256 (integer_sign_bit)))) (if-let mask (imm (u256_sub m (u256 1)))) (if-let masked (make (Op.And x mask))) (if-let zero (imm (u256 0)))
      (sequence (Op.Ne masked zero)))

;; (zext(a) & zext(b)) == 0 => (a & b) == 0.
;; Requires: a is boolean, b is boolean.
(rule (sequence_rewrite (Op.Eq (band (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))
      (if-let combined (make (Op.And a b)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq combined zero)))

;; (zext(a) | zext(b)) == 0 => (a | b) == 0.
;; Requires: a is boolean, b is boolean.
(rule (sequence_rewrite (Op.Eq (bor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))
      (if-let combined (make (Op.Or a b)))
      (if-let zero (imm (u256 0)))
      (sequence (Op.Eq combined zero)))

;; (x / c) * c == x => x % c == 0.
;; Requires: c is constant, c != 0. x is a multiple of c.
(rule (sequence_rewrite (Op.Eq (mul (div x (iconst c)) (iconst d)) x))
      (if-let true (u256_ge c (u256 1)))
      (if-let true (u256_same c d))
      (if-let divisor (imm c))
      (if-let remainder (make (Op.Mod x divisor)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq remainder zero)))

;; x == (x / c) * c => x % c == 0.
;; Requires: c is constant, c != 0.
(rule (sequence_rewrite (Op.Eq x (mul (div x (iconst c)) (iconst d))))
      (if-let true (u256_ge c (u256 1)))
      (if-let true (u256_same c d))
      (if-let divisor (imm c))
      (if-let remainder (make (Op.Mod x divisor)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq remainder zero)))

;; Branch folding, check elimination, and if-conversion read these comparisons against MAX
;; first, so the recipes wait for the late run. A branch reads `~x` as it is.

;; x < MAX => ~x != 0.
;; Requires: W == 256, so `not` needs no mask.
(rule (sequence_rewrite (Op.Lt (and x (integer_bits 256)) (all_ones)))
      (if-let true (late_word_sequence))
      (if-let complement (make (Op.Not x)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne complement zero)))

;; x > (MAX - 1) => ~x == 0.
;; Requires: W == 256, c is constant, c == (MAX - 1).
(rule (sequence_rewrite (Op.Gt (and x (integer_bits 256)) (iconst c)))
      (if-let true (late_word_sequence))
      (if-let true (u256_same c (u256_sub (u256_max) (u256 1))))
      (if-let complement (make (Op.Not x)))
      (if-let zero (imm (u256 0))) (sequence (Op.Eq complement zero)))

;; x != MAX => ~x != 0.
;; Requires: W == 256.
(rule (sequence_rewrite (Op.Ne (and x (integer_bits 256)) (all_ones)))
      (if-let true (late_word_sequence))
      (if-let complement (make (Op.Not x)))
      (if-let zero (imm (u256 0))) (sequence (Op.Ne complement zero)))
