;; Pure 256-bit word reductions, checked by scripts/evm-rules/verify.py.
;;
;; Mixed bitwise families were discovered by bounded enumeration; arithmetic
;; candidates were supplied explicitly. See scripts/evm-rules/README.md for the
;; search recipe, proof boundary and counterexample replay. These alternatives
;; stay at the original instruction and compete under Target plus stack traffic.
;; Add(value, 0) lets a leaf replacement use the multi-result rewrite interface;
;; ordinary simplification removes it without allocating an instruction.
;; Matching puts constants on the right of commutative pairs and comparisons,
;; including nested definitions, so constant-left mirrors are unnecessary.

;; shl(1, x) => x + x
;; Keep the producer in place; rebuilding it at a later consumer extends live ranges.
(rule (rewrite (Op.Shl (one) x)) (Op.Add x x))

;; ~((1 << n) - 1) => MAX << n
;; ~(x - 1) => 0 - x
;; Mined from storage-byte masks; shifts of 256 or more yield zero.
(rule (rewrite (Op.Not (sub (shl n (one)) (one)))) (Op.Shl n (imm (u256_max))))
(rule (rewrite (Op.Not (sub x (one)))) (Op.Sub (imm (u256 0)) x))

;; lt (add x, 1), x => eq (add x, 1), 0
;; gt x, (add x, 1) => eq (add x, 1), 0
;; Only wrapping from MAX to zero can make an increment smaller. Reuse the
;; sum so a checked increment does not keep the previous counter live too.
(rule (rewrite (Op.Lt (and sum (add x (one))) x)) (Op.Eq sum (imm (u256 0))))
(rule (rewrite (Op.Gt x (and sum (add x (one))))) (Op.Eq sum (imm (u256 0))))

;; gt (sub x, 1), x => eq x, 0
;; lt x, (sub x, 1) => eq x, 0
;; Only wrapping from zero to MAX can make a decrement larger.
(rule (rewrite (Op.Gt (sub x (one)) x)) (Op.Eq x (imm (u256 0))))
(rule (rewrite (Op.Lt x (sub x (one)))) (Op.Eq x (imm (u256 0))))
(rule (rewrite (Op.Gt (add x (all_ones)) x)) (Op.Eq x (imm (u256 0))))
(rule (rewrite (Op.Lt x (add x (all_ones)))) (Op.Eq x (imm (u256 0))))

;; (x & y) & (x ^ y) => 0
;; (x & y) & (x | y) => x & y
;; (x | y) & (x ^ y) => x ^ y
;; (x & y) | (x | y) => x | y
;; (x & y) | (x ^ y) => x | y
;; (x | y) | (x ^ y) => x | y
;; (x & y) ^ (x | y) => x ^ y
;; (x & y) ^ (x ^ y) => x | y
;; (x | y) ^ (x ^ y) => x & y
(rule (rewrite (Op.And (band v0 v1) (bxor v0 v1))) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And (band v0 v1) (bxor v1 v0))) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And (bxor v0 v1) (band v0 v1))) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And (bxor v0 v1) (band v1 v0))) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And (band v0 v1) (bor v0 v1))) (Op.And v0 v1))
(rule (rewrite (Op.And (band v0 v1) (bor v1 v0))) (Op.And v0 v1))
(rule (rewrite (Op.And (bor v0 v1) (band v0 v1))) (Op.And v0 v1))
(rule (rewrite (Op.And (bor v0 v1) (band v1 v0))) (Op.And v0 v1))
(rule (rewrite (Op.And (bor v0 v1) (bxor v0 v1))) (Op.Xor v0 v1))
(rule (rewrite (Op.And (bor v0 v1) (bxor v1 v0))) (Op.Xor v0 v1))
(rule (rewrite (Op.And (bxor v0 v1) (bor v0 v1))) (Op.Xor v0 v1))
(rule (rewrite (Op.And (bxor v0 v1) (bor v1 v0))) (Op.Xor v0 v1))
(rule (rewrite (Op.Or (band v0 v1) (bor v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (band v0 v1) (bor v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bor v0 v1) (band v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bor v0 v1) (band v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (band v0 v1) (bxor v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (band v0 v1) (bxor v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bxor v0 v1) (band v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bxor v0 v1) (band v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bor v0 v1) (bxor v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bor v0 v1) (bxor v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bxor v0 v1) (bor v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Or (bxor v0 v1) (bor v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Xor (band v0 v1) (bor v0 v1))) (Op.Xor v0 v1))
(rule (rewrite (Op.Xor (band v0 v1) (bor v1 v0))) (Op.Xor v0 v1))
(rule (rewrite (Op.Xor (bor v0 v1) (band v0 v1))) (Op.Xor v0 v1))
(rule (rewrite (Op.Xor (bor v0 v1) (band v1 v0))) (Op.Xor v0 v1))
(rule (rewrite (Op.Xor (band v0 v1) (bxor v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Xor (band v0 v1) (bxor v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Xor (bxor v0 v1) (band v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Xor (bxor v0 v1) (band v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Xor (bor v0 v1) (bxor v0 v1))) (Op.And v0 v1))
(rule (rewrite (Op.Xor (bor v0 v1) (bxor v1 v0))) (Op.And v0 v1))
(rule (rewrite (Op.Xor (bxor v0 v1) (bor v0 v1))) (Op.And v0 v1))
(rule (rewrite (Op.Xor (bxor v0 v1) (bor v1 v0))) (Op.And v0 v1))

;; x * MAX => 0 - x
;; sdiv(x, MAX) => 0 - x
;; Includes the EVM minimum-signed-word / -1 wraparound case.
(rule (rewrite (Op.Mul x (all_ones))) (Op.Sub (imm (u256 0)) x))
(rule (rewrite (Op.SDiv x (all_ones))) (Op.Sub (imm (u256 0)) x))

;; ~x - ~y => y - x
;; x + ~x => MAX
(rule (rewrite (Op.Sub (bnot x) (bnot y))) (Op.Sub y x))
(rule (rewrite (Op.Add x (bnot x))) (Op.Add (imm (u256_max)) (imm (u256 0))))
(rule (rewrite (Op.Add (bnot x) x)) (Op.Add (imm (u256_max)) (imm (u256 0))))

;; Additional families from mixed arithmetic/bitwise enumeration.
;; (add (and x y) (or x y)) => (add x y)
(rule (rewrite (Op.Add (band v0 v1) (bor v0 v1))) (Op.Add v0 v1))
(rule (rewrite (Op.Add (band v0 v1) (bor v1 v0))) (Op.Add v0 v1))
(rule (rewrite (Op.Add (bor v0 v1) (band v0 v1))) (Op.Add v0 v1))
(rule (rewrite (Op.Add (bor v0 v1) (band v1 v0))) (Op.Add v0 v1))

;; (add (and x y) (xor x y)) => (or x y)
(rule (rewrite (Op.Add (band v0 v1) (bxor v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Add (band v0 v1) (bxor v1 v0))) (Op.Or v0 v1))
(rule (rewrite (Op.Add (bxor v0 v1) (band v0 v1))) (Op.Or v0 v1))
(rule (rewrite (Op.Add (bxor v0 v1) (band v1 v0))) (Op.Or v0 v1))

;; (add (not (add x y)) x) => (not y)
(rule (rewrite (Op.Add (bnot (add v0 v1)) v0)) (Op.Not v1))
(rule (rewrite (Op.Add (bnot (add v0 v1)) v1)) (Op.Not v0))
(rule (rewrite (Op.Add v0 (bnot (add v0 v1)))) (Op.Not v1))
(rule (rewrite (Op.Add v0 (bnot (add v1 v0)))) (Op.Not v1))

;; (add (not x) (sub x y)) => (not y)
(rule (rewrite (Op.Add (bnot v0) (sub v0 v1))) (Op.Not v1))
(rule (rewrite (Op.Add (sub v0 v1) (bnot v0))) (Op.Not v1))

;; (add (sub x y) (sub y x)) => 0x0
(rule (rewrite (Op.Add (sub v0 v1) (sub v1 v0))) (Op.Add (imm (u256 0)) (imm (u256 0))))

;; (add (add x y) (sub x y)) => (add x x)
(rule (rewrite (Op.Add (add v0 v1) (sub v0 v1))) (Op.Add v0 v0))
(rule (rewrite (Op.Add (add v0 v1) (sub v1 v0))) (Op.Add v1 v1))
(rule (rewrite (Op.Add (sub v0 v1) (add v0 v1))) (Op.Add v0 v0))
(rule (rewrite (Op.Add (sub v0 v1) (add v1 v0))) (Op.Add v0 v0))

;; (and (sub (or x y) x) x) => 0x0
(rule (rewrite (Op.And (sub (bor v0 v1) v0) v0)) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And (sub (bor v0 v1) v1) v1)) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And v0 (sub (bor v0 v1) v0))) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And v0 (sub (bor v1 v0) v0))) (Op.Add (imm (u256 0)) (imm (u256 0))))

;; (or (sub x (and x y)) x) => x
(rule (rewrite (Op.Or (sub v0 (band v0 v1)) v0)) (Op.Add v0 (imm (u256 0))))
(rule (rewrite (Op.Or (sub v0 (band v1 v0)) v0)) (Op.Add v0 (imm (u256 0))))
(rule (rewrite (Op.Or v0 (sub v0 (band v0 v1)))) (Op.Add v0 (imm (u256 0))))
(rule (rewrite (Op.Or v0 (sub v0 (band v1 v0)))) (Op.Add v0 (imm (u256 0))))

;; (and (not (or x y)) x) => 0x0
(rule (rewrite (Op.And (bnot (bor v0 v1)) v0)) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And (bnot (bor v0 v1)) v1)) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And v0 (bnot (bor v0 v1)))) (Op.Add (imm (u256 0)) (imm (u256 0))))
(rule (rewrite (Op.And v0 (bnot (bor v1 v0)))) (Op.Add (imm (u256 0)) (imm (u256 0))))

;; (or (not (and x y)) x) => 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
(rule (rewrite (Op.Or (bnot (band v0 v1)) v0)) (Op.Add (imm (u256_max)) (imm (u256 0))))
(rule (rewrite (Op.Or (bnot (band v0 v1)) v1)) (Op.Add (imm (u256_max)) (imm (u256 0))))
(rule (rewrite (Op.Or v0 (bnot (band v0 v1)))) (Op.Add (imm (u256_max)) (imm (u256 0))))
(rule (rewrite (Op.Or v0 (bnot (band v1 v0)))) (Op.Add (imm (u256_max)) (imm (u256 0))))

;; Extract one byte from a word.
(rule (rewrite (Op.And (shr (iconst shift) x) (iconst mask)))
  (if-let true (u256_eq mask 255))
  (if-let index (sign_byte shift))
  (Op.Byte (imm index) x))

;; (x << s) >> s => x, if x fits in the retained 256 - s bits.
;; Keep the intermediate in this block to avoid extending a cross-block live range.
;; Require one use so removing a shared overflow check does not disrupt outlining.
(rule (rewrite (Op.Shr (iconst shift) (and shifted (shl (iconst shift) x))))
      (if-let true (in_current_block shifted))
      (if-let true (single_use shifted))
      (if-let true (u256_lt shift 256))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (Op.Add x (imm (u256 0))))

;; (x << s) == (y << s) => x == y, if neither shift loses bits.
(rule (rewrite (Op.Eq (shl (iconst shift) x) (shl (iconst shift) y)))
      (if-let true (u256_lt shift 256))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (if-let true (mask_covers (u256_shr shift (u256_max)) y))
      (Op.Eq x y))

;; (x << s) == c => x == (c >> s), if x fits and c is aligned to 2^s.
(rule (rewrite (Op.Eq (shl (iconst shift) x) (iconst c)))
      (if-let true (u256_lt shift 256))
      (if-let true (u256_same (u256_shl shift (u256_shr shift c)) c))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (Op.Eq x (imm (u256_shr shift c))))

;; (x << s) < (y << s) => x < y, if neither shift loses bits.
(rule (rewrite (Op.Lt (shl (iconst shift) x) (shl (iconst shift) y)))
      (if-let true (u256_lt shift 256))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (if-let true (mask_covers (u256_shr shift (u256_max)) y))
      (Op.Lt x y))

;; (x << s) < c => x < (c >> s), if x fits and c is aligned to 2^s.
(rule (rewrite (Op.Lt (shl (iconst shift) x) (iconst c)))
      (if-let true (u256_lt shift 256))
      (if-let true (u256_same (u256_shl shift (u256_shr shift c)) c))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (Op.Lt x (imm (u256_shr shift c))))

;; (x << s) > (y << s) => x > y, if neither shift loses bits.
(rule (rewrite (Op.Gt (shl (iconst shift) x) (shl (iconst shift) y)))
      (if-let true (u256_lt shift 256))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (if-let true (mask_covers (u256_shr shift (u256_max)) y))
      (Op.Gt x y))

;; (x << s) > c => x > (c >> s), if x fits and c is aligned to 2^s.
(rule (rewrite (Op.Gt (shl (iconst shift) x) (iconst c)))
      (if-let true (u256_lt shift 256))
      (if-let true (u256_same (u256_shl shift (u256_shr shift c)) c))
      (if-let true (mask_covers (u256_shr shift (u256_max)) x))
      (Op.Gt x (imm (u256_shr shift c))))

;; shl n, (and x, mask) => shl n, x
;; shr n, (and x, mask) => shr n, x
;; A mask may be omitted when every cleared bit is shifted out of the word.
(rule (rewrite (Op.Shl (iconst shift) (band x (iconst mask))))
  (if-let true (u256_same (u256_shl shift mask) (u256_shl shift (u256_max))))
  (Op.Shl (imm shift) x))
(rule (rewrite (Op.Shr (iconst shift) (band x (iconst mask))))
  (if-let true (u256_same (u256_shr shift mask) (u256_shr shift (u256_max))))
  (Op.Shr (imm shift) x))

;; byte i, (and x, mask) => byte i, x
;; BYTE ignores every mask bit outside the selected byte.
(rule (rewrite (Op.Byte (iconst index) (band x (iconst mask))))
  (if-let true (u256_eq (u256_byte index mask) 255))
  (Op.Byte (imm index) x))

;; byte i, (shl n, x) => byte (i + n / 8), x
;; byte i, (shr n, x) => byte (i - n / 8), x ; or zero if i < n / 8
;; Adjust byte indexes across byte-aligned shifts. Check the original index
;; before arithmetic so an out-of-range index cannot wrap back into the word.
;; Keep the producer in the root block: crossing a branch can replace a cheap
;; temporary with a loop-carried dependency that the stack scheduler must spill.
(rule (rewrite (Op.Byte (iconst index) (and shifted (shl (iconst shift) x))))
  (if-let true (in_current_block shifted))
  (if-let true (u256_lt index 32))
  (if-let byte (sign_byte shift))
  (Op.Byte (imm (u256_add index (u256_sub (u256 31) byte))) x))
(rule (rewrite (Op.Byte (iconst index) (and shifted (shr (iconst shift) x))))
  (if-let true (in_current_block shifted))
  (if-let true (u256_lt index 32))
  (if-let byte (sign_byte shift))
  (if-let true (u256_le (u256_sub (u256 31) byte) index))
  (Op.Byte (imm (u256_sub index (u256_sub (u256 31) byte))) x))
(rule (rewrite (Op.Byte (iconst index) (and shifted (shr (iconst shift) x))))
  (if-let true (in_current_block shifted))
  (if-let true (u256_lt index 32))
  (if-let byte (sign_byte shift))
  (if-let false (u256_le (u256_sub (u256 31) byte) index))
  (Op.Add (imm (u256 0)) (imm (u256 0))))

;; Seeded search: scripts/evm-rules/seeds.json.
;; ((x + y) - (x & y)) => (x | y)
(rule (rewrite (Op.Sub (add v0 v1) (band v0 v1))) (Op.Or v0 v1))
;; ((x + y) - (y & x)) => (x | y)
(rule (rewrite (Op.Sub (add v0 v1) (band v1 v0))) (Op.Or v0 v1))
;; ((x + y) - (x | y)) => (x & y)
(rule (rewrite (Op.Sub (add v0 v1) (bor v0 v1))) (Op.And v0 v1))
;; ((x + y) - (y | x)) => (x & y)
(rule (rewrite (Op.Sub (add v0 v1) (bor v1 v0))) (Op.And v0 v1))
;; ((x | y) - (x & y)) => (x ^ y)
(rule (rewrite (Op.Sub (bor v0 v1) (band v0 v1))) (Op.Xor v0 v1))
;; ((x | y) - (y & x)) => (x ^ y)
(rule (rewrite (Op.Sub (bor v0 v1) (band v1 v0))) (Op.Xor v0 v1))
;; ((x | y) - (x ^ y)) => (x & y)
(rule (rewrite (Op.Sub (bor v0 v1) (bxor v0 v1))) (Op.And v0 v1))
;; ((x | y) - (y ^ x)) => (x & y)
(rule (rewrite (Op.Sub (bor v0 v1) (bxor v1 v0))) (Op.And v0 v1))
;; ~(~y + x) => (y - x)
(rule (rewrite (Op.Not (add (bnot v0) v1))) (Op.Sub v0 v1))
;; ~(x + ~y) => (y - x)
(rule (rewrite (Op.Not (add v0 (bnot v1)))) (Op.Sub v1 v0))
;; ~(~x - y) => (x + y)
(rule (rewrite (Op.Not (sub (bnot v0) v1))) (Op.Add v0 v1))

;; Cross-compiler scalar and canonicalization audit.

;; Mul (mul x (iconst a)) (iconst b) => Mul x (imm (u256_mul a b))
(rule (rewrite (Op.Mul (mul x (iconst a)) (iconst b)))  (Op.Mul x (imm (u256_mul a b))))

;; Or (bor x (iconst a)) (iconst b) => Or x (imm (u256_or a b))
(rule (rewrite (Op.Or (bor x (iconst a)) (iconst b)))  (Op.Or x (imm (u256_or a b))))

;; Xor (bxor x (iconst a)) (iconst b) => Xor x (imm (u256_xor a b))
(rule (rewrite (Op.Xor (bxor x (iconst a)) (iconst b)))  (Op.Xor x (imm (u256_xor a b))))

;; Eq (add x (iconst a)) (iconst b) => Eq x (imm (u256_sub b a))
(rule (rewrite (Op.Eq (add x (iconst a)) (iconst b)))  (Op.Eq x (imm (u256_sub b a))))

;; Eq (sub x (iconst a)) (iconst b) => Eq x (imm (u256_add b a))
(rule (rewrite (Op.Eq (sub x (iconst a)) (iconst b)))  (Op.Eq x (imm (u256_add b a))))

;; Eq (bxor x (iconst a)) (iconst b) => Eq x (imm (u256_xor b a))
(rule (rewrite (Op.Eq (bxor x (iconst a)) (iconst b)))  (Op.Eq x (imm (u256_xor b a))))

;; Eq (bnot x) (iconst c) => Eq x (imm (u256_not c))
(rule (rewrite (Op.Eq (bnot x) (iconst c)))  (Op.Eq x (imm (u256_not c))))

;; Eq (add x z) (add y z) => Eq x y
(rule (rewrite (Op.Eq (add x z) (add y z)))  (Op.Eq x y))

;; Eq (add z x) (add y z) => Eq x y
(rule (rewrite (Op.Eq (add z x) (add y z)))  (Op.Eq x y))

;; Eq (add x z) (add z y) => Eq x y
(rule (rewrite (Op.Eq (add x z) (add z y)))  (Op.Eq x y))

;; Eq (add z x) (add z y) => Eq x y
(rule (rewrite (Op.Eq (add z x) (add z y)))  (Op.Eq x y))

;; Eq (bxor x z) (bxor y z) => Eq x y
(rule (rewrite (Op.Eq (bxor x z) (bxor y z)))  (Op.Eq x y))

;; Eq (bxor z x) (bxor y z) => Eq x y
(rule (rewrite (Op.Eq (bxor z x) (bxor y z)))  (Op.Eq x y))

;; Eq (bxor x z) (bxor z y) => Eq x y
(rule (rewrite (Op.Eq (bxor x z) (bxor z y)))  (Op.Eq x y))

;; Eq (bxor z x) (bxor z y) => Eq x y
(rule (rewrite (Op.Eq (bxor z x) (bxor z y)))  (Op.Eq x y))

;; Eq (sub x z) (sub y z) => Eq x y
(rule (rewrite (Op.Eq (sub x z) (sub y z)))  (Op.Eq x y))

;; Eq (sub z x) (sub z y) => Eq x y
(rule (rewrite (Op.Eq (sub z x) (sub z y)))  (Op.Eq x y))

;; Eq (bnot x) (bnot y) => Eq x y
(rule (rewrite (Op.Eq (bnot x) (bnot y)))  (Op.Eq x y))

;; Eq (mul x (iconst c)) (mul y (iconst c)) => Eq x y
(rule (rewrite (Op.Eq (mul x (iconst c)) (mul y (iconst c)))) (if-let true (u256_eq (u256_and c (u256 1)) 1)) (Op.Eq x y))

;; Ne (add x (iconst a)) (iconst b) => Ne x (imm (u256_sub b a))
(rule (rewrite (Op.Ne (add x (iconst a)) (iconst b)))  (Op.Ne x (imm (u256_sub b a))))

;; Ne (sub x (iconst a)) (iconst b) => Ne x (imm (u256_add b a))
(rule (rewrite (Op.Ne (sub x (iconst a)) (iconst b)))  (Op.Ne x (imm (u256_add b a))))

;; Ne (bxor x (iconst a)) (iconst b) => Ne x (imm (u256_xor b a))
(rule (rewrite (Op.Ne (bxor x (iconst a)) (iconst b)))  (Op.Ne x (imm (u256_xor b a))))

;; Ne (bnot x) (iconst c) => Ne x (imm (u256_not c))
(rule (rewrite (Op.Ne (bnot x) (iconst c)))  (Op.Ne x (imm (u256_not c))))

;; Ne (add x z) (add y z) => Ne x y
(rule (rewrite (Op.Ne (add x z) (add y z)))  (Op.Ne x y))

;; Ne (add z x) (add y z) => Ne x y
(rule (rewrite (Op.Ne (add z x) (add y z)))  (Op.Ne x y))

;; Ne (add x z) (add z y) => Ne x y
(rule (rewrite (Op.Ne (add x z) (add z y)))  (Op.Ne x y))

;; Ne (add z x) (add z y) => Ne x y
(rule (rewrite (Op.Ne (add z x) (add z y)))  (Op.Ne x y))

;; Ne (bxor x z) (bxor y z) => Ne x y
(rule (rewrite (Op.Ne (bxor x z) (bxor y z)))  (Op.Ne x y))

;; Ne (bxor z x) (bxor y z) => Ne x y
(rule (rewrite (Op.Ne (bxor z x) (bxor y z)))  (Op.Ne x y))

;; Ne (bxor x z) (bxor z y) => Ne x y
(rule (rewrite (Op.Ne (bxor x z) (bxor z y)))  (Op.Ne x y))

;; Ne (bxor z x) (bxor z y) => Ne x y
(rule (rewrite (Op.Ne (bxor z x) (bxor z y)))  (Op.Ne x y))

;; Ne (sub x z) (sub y z) => Ne x y
(rule (rewrite (Op.Ne (sub x z) (sub y z)))  (Op.Ne x y))

;; Ne (sub z x) (sub z y) => Ne x y
(rule (rewrite (Op.Ne (sub z x) (sub z y)))  (Op.Ne x y))

;; Ne (bnot x) (bnot y) => Ne x y
(rule (rewrite (Op.Ne (bnot x) (bnot y)))  (Op.Ne x y))

;; Ne (mul x (iconst c)) (mul y (iconst c)) => Ne x y
(rule (rewrite (Op.Ne (mul x (iconst c)) (mul y (iconst c)))) (if-let true (u256_eq (u256_and c (u256 1)) 1)) (Op.Ne x y))

;; Add x (sub (zero) y) => Sub x y
(rule (rewrite (Op.Add x (sub (zero) y)))  (Op.Sub x y))

;; Add (sub (zero) y) x => Sub x y
(rule (rewrite (Op.Add (sub (zero) y) x))  (Op.Sub x y))

;; Sub x (sub (zero) y) => Add x y
(rule (rewrite (Op.Sub x (sub (zero) y)))  (Op.Add x y))

;; Sub (all_ones) x => Not x
(rule (rewrite (Op.Sub (all_ones) x))  (Op.Not x))

;; Div x (shl n (one)) => Shr n x
(rule (rewrite (Op.Div x (shl n (one)))) (if-let true (has_bitwise_shifting)) (Op.Shr n x))

;; AddMod x (zero) m => Mod x m
(rule (rewrite (Op.AddMod x (zero) m))  (Op.Mod x m))

;; MulMod x (one) m => Mod x m
(rule (rewrite (Op.MulMod x (one) m))  (Op.Mod x m))

;; Div (div x (nonzero_const a)) (nonzero_const b) => Div x (imm (u256_mul a b))
(rule (rewrite (Op.Div (div x (nonzero_const a)) (nonzero_const b))) (if-let true (u256_le a (u256_div (u256_max) b))) (Op.Div x (imm (u256_mul a b))))

;; Eq (div x (nonzero_const c)) (zero) => Lt x (imm c)
(rule (rewrite (Op.Eq (div x (nonzero_const c)) (zero)))  (Op.Lt x (imm c)))

;; x / c != 0 => x > c - 1, for c != 0.
(rule (rewrite (Op.Ne (div x (nonzero_const c)) (zero))) (Op.Gt x (imm (u256_sub c (u256 1)))))

;; Not (sar s (bnot x)) => Sar s x
(rule (rewrite (Op.Not (sar s (bnot x))))  (Op.Sar s x))

;; Slt (sar s x) (zero) => Slt x (imm (u256 0))
(rule (rewrite (Op.SLt (sar s x) (zero)))  (Op.SLt x (imm (u256 0))))

;; Sar (iconst s) x => Sar (imm (u256 255)) x
(rule (rewrite (Op.Sar (iconst s) x)) (if-let true (u256_ge s 256)) (Op.Sar (imm (u256 255)) x))

;; And (signextend (iconst b) x) (iconst m) => And x (imm m)
(rule (rewrite (Op.And (signextend (iconst b) x) (iconst m))) (if-let true (u256_lt b 31)) (if-let true (u256_is_zero (u256_shr (u256_mul (u256_add b (u256 1)) (u256 8)) m))) (Op.And x (imm m)))

;; SignExtend (iconst b) (shr (iconst s) x) => Sar (imm s) x
(rule (rewrite (Op.SignExtend (iconst b) (shr (iconst s) x))) (if-let byte (sign_byte s)) (if-let true (u256_same b byte)) (if-let true (has_bitwise_shifting)) (Op.Sar (imm s) x))

;; Shr (iconst s) (shl (iconst s) x) => And x (imm (u256_shr s (u256_max)))
(rule (rewrite (Op.Shr (iconst s) (and shifted (shl (iconst s) x))))
      (if-let true (in_current_block shifted))
      (if-let true (single_use shifted))
      (if-let true (push_not_larger (u256_shr s (u256_max)) s))
      (Op.And x (imm (u256_shr s (u256_max)))))

;; Shl (iconst s) (shr (iconst s) x) => And x (imm (u256_shl s (u256_max)))
(rule (rewrite (Op.Shl (iconst s) (and shifted (shr (iconst s) x))))
      (if-let true (in_current_block shifted))
      (if-let true (single_use shifted))
      (if-let true (push_not_larger (u256_shl s (u256_max)) s))
      (Op.And x (imm (u256_shl s (u256_max)))))

;; Xor (bxor t x) (bxor t y) => Xor x y
(rule (rewrite (Op.Xor (bxor t x) (bxor t y)))  (Op.Xor x y))

;; Xor (bxor x t) (bxor t y) => Xor x y
(rule (rewrite (Op.Xor (bxor x t) (bxor t y)))  (Op.Xor x y))

;; Xor (bxor t x) (bxor y t) => Xor x y
(rule (rewrite (Op.Xor (bxor t x) (bxor y t)))  (Op.Xor x y))

;; Xor (bxor x t) (bxor y t) => Xor x y
(rule (rewrite (Op.Xor (bxor x t) (bxor y t)))  (Op.Xor x y))

;; Or (band x m) (and n (bnot m)) => Or x n
(rule (rewrite (Op.Or (band x m) (and n (bnot m))))  (Op.Or x n))

;; Or (and n (bnot m)) (band x m) => Or x n
(rule (rewrite (Op.Or (and n (bnot m)) (band x m)))  (Op.Or x n))

;; Or (band m x) (and n (bnot m)) => Or x n
(rule (rewrite (Op.Or (band m x) (and n (bnot m))))  (Op.Or x n))

;; Or (and n (bnot m)) (band m x) => Or x n
(rule (rewrite (Op.Or (and n (bnot m)) (band m x)))  (Op.Or x n))

;; And (bor x m) (and n (bnot m)) => And x n
(rule (rewrite (Op.And (bor x m) (and n (bnot m))))  (Op.And x n))

;; And (and n (bnot m)) (bor x m) => And x n
(rule (rewrite (Op.And (and n (bnot m)) (bor x m)))  (Op.And x n))

;; And (bor m x) (and n (bnot m)) => And x n
(rule (rewrite (Op.And (bor m x) (and n (bnot m))))  (Op.And x n))

;; And (and n (bnot m)) (bor m x) => And x n
(rule (rewrite (Op.And (and n (bnot m)) (bor m x)))  (Op.And x n))

;; And (sub (zero) x) (one) => And x (imm (u256 1))
(rule (rewrite (Op.And (sub (zero) x) (one)))  (Op.And x (imm (u256 1))))

;; Sub (zero) (shr (iconst s) x) => Sar (imm s) x
(rule (rewrite (Op.Sub (zero) (shr (iconst s) x))) (if-let true (u256_eq s 255)) (if-let true (has_bitwise_shifting)) (Op.Sar (imm s) x))

;; Sub (bor x (iconst c)) (iconst c) => And x (imm (u256_not c))
(rule (rewrite (Op.Sub (bor x (iconst c)) (iconst c)))  (Op.And x (imm (u256_not c))))

;; Ne (zext (and b (bool_value))) (one) => Eq b (imm_bool false)
(rule (rewrite (Op.Ne (zext (and b (bool_value))) (one)))  (Op.Eq b (imm_bool false)))

;; Select (eq (and c (bool_value)) (zero)) a b => Select c b a
(rule (rewrite (Op.Select (eq (and c (bool_value)) (zero)) a b))  (Op.Select c b a))

;; Select (and c (bool_value)) (and b (bool_value)) (zero) => And c b
(rule (rewrite (Op.Select (and c (bool_value)) (and b (bool_value)) (zero)))  (Op.And c b))

;; Select (and c (bool_value)) (one) (and b (bool_value)) => Or c b
(rule (rewrite (Op.Select (and c (bool_value)) (one) (and b (bool_value))))  (Op.Or c b))

;; Eq (select (and c (bool_value)) (iconst a) (iconst b)) (iconst b) => Eq c (imm_bool false)
(rule (rewrite (Op.Eq (select (and c (bool_value)) (iconst a) (iconst b)) (iconst b))) (if-let false (u256_same a b)) (Op.Eq c (imm_bool false)))

;; Ne (select (and c (bool_value)) (iconst a) (iconst b)) (iconst a) => Eq c (imm_bool false)
(rule (rewrite (Op.Ne (select (and c (bool_value)) (iconst a) (iconst b)) (iconst a))) (if-let false (u256_same a b)) (Op.Eq c (imm_bool false)))

;; Lt (bnot x) (bnot y) => Gt x y
(rule (rewrite (Op.Lt (bnot x) (bnot y)))  (Op.Gt x y))

;; Gt (bnot x) (bnot y) => Lt x y
(rule (rewrite (Op.Gt (bnot x) (bnot y)))  (Op.Lt x y))

;; Slt (bnot x) (bnot y) => Sgt x y
(rule (rewrite (Op.SLt (bnot x) (bnot y)))  (Op.SGt x y))

;; Sgt (bnot x) (bnot y) => Slt x y
(rule (rewrite (Op.SGt (bnot x) (bnot y)))  (Op.SLt x y))

;; Add x (iconst c) => Sub x (imm (u256_neg c))
;; Keep ADD by MAX: pointer-decrement loops schedule its commutative operands
;; more cheaply than SUB by one with an extra stack swap.
(rule (rewrite (Op.Add x (iconst c)))
      (if-let false (u256_is_all_ones c))
      (if-let true (u256_le (u256_shl (u256 255) (u256 1)) c))
      (Op.Sub x (imm (u256_neg c))))

;; And (byte (iconst i) x) (iconst m) => And x (imm (u256_and m (u256 255)))
(rule (rewrite (Op.And (byte (iconst i) x) (iconst m))) (if-let true (u256_eq i 31)) (Op.And x (imm (u256_and m (u256 255)))))

;; Not (bxor (bnot x) y) => Xor x y
(rule (rewrite (Op.Not (bxor (bnot x) y)))  (Op.Xor x y))

;; Not (bxor y (bnot x)) => Xor x y
(rule (rewrite (Op.Not (bxor y (bnot x))))  (Op.Xor x y))

;; And x (bnot (bxor x y)) => And x y
(rule (rewrite (Op.And x (bnot (bxor x y))))  (Op.And x y))

;; And (bnot (bxor x y)) x => And x y
(rule (rewrite (Op.And (bnot (bxor x y)) x))  (Op.And x y))

;; And x (bnot (bxor y x)) => And x y
(rule (rewrite (Op.And x (bnot (bxor y x))))  (Op.And x y))

;; And (bnot (bxor y x)) x => And x y
(rule (rewrite (Op.And (bnot (bxor y x)) x))  (Op.And x y))

;; Add (select c (iconst a) (iconst b)) (iconst k) => Select c (imm (u256_add a k)) (imm (u256_add b k))
(rule (rewrite (Op.Add (select c (iconst a) (iconst b)) (iconst k)))  (Op.Select c (imm (u256_add a k)) (imm (u256_add b k))))

;; Or (select c (iconst a) (iconst b)) (iconst k) => Select c (imm (u256_or a k)) (imm (u256_or b k))
(rule (rewrite (Op.Or (select c (iconst a) (iconst b)) (iconst k)))  (Op.Select c (imm (u256_or a k)) (imm (u256_or b k))))

;; Xor (select c (iconst a) (iconst b)) (iconst k) => Select c (imm (u256_xor a k)) (imm (u256_xor b k))
(rule (rewrite (Op.Xor (select c (iconst a) (iconst b)) (iconst k)))  (Op.Select c (imm (u256_xor a k)) (imm (u256_xor b k))))

;; And (select c (iconst a) (iconst b)) (iconst k) => Select c (imm (u256_and a k)) (imm (u256_and b k))
(rule (rewrite (Op.And (select c (iconst a) (iconst b)) (iconst k)))  (Op.Select c (imm (u256_and a k)) (imm (u256_and b k))))

;; Mul (select c (iconst a) (iconst b)) (iconst k) => Select c (imm (u256_mul a k)) (imm (u256_mul b k))
(rule (rewrite (Op.Mul (select c (iconst a) (iconst b)) (iconst k)))  (Op.Select c (imm (u256_mul a k)) (imm (u256_mul b k))))

;; Invert a constant bound only when its push cost does not grow. This keeps
;; compact shifted bounds available for lossless-shift cancellation.
;; Eq (lt x (iconst c)) (zero) => Gt x (imm (u256_sub c (u256 1)))
(rule (rewrite (Op.Eq (lt x (iconst c)) (zero))) (if-let false (u256_is_zero c)) (if-let true (push_not_larger (u256_sub c (u256 1)) c)) (Op.Gt x (imm (u256_sub c (u256 1)))))

;; Eq (gt x (iconst c)) (zero) => Lt x (imm (u256_add c (u256 1)))
(rule (rewrite (Op.Eq (gt x (iconst c)) (zero))) (if-let false (u256_is_all_ones c)) (if-let true (push_not_larger (u256_add c (u256 1)) c)) (Op.Lt x (imm (u256_add c (u256 1)))))

;; Eq (slt x (iconst c)) (zero) => SGt x (imm (u256_sub c (u256 1)))
(rule (rewrite (Op.Eq (slt x (iconst c)) (zero))) (if-let false (u256_same c (u256_shl (u256 255) (u256 1)))) (if-let true (push_not_larger (u256_sub c (u256 1)) c)) (Op.SGt x (imm (u256_sub c (u256 1)))))

;; Eq (sgt x (iconst c)) (zero) => SLt x (imm (u256_add c (u256 1)))
(rule (rewrite (Op.Eq (sgt x (iconst c)) (zero))) (if-let false (u256_same c (u256_shr (u256 1) (u256_max)))) (if-let true (push_not_larger (u256_add c (u256 1)) c)) (Op.SLt x (imm (u256_add c (u256 1)))))

;; SLt x (iconst c) => Eq x (imm (u256_shl (u256 255) (u256 1)))
(rule (rewrite (Op.SLt x (iconst c))) (if-let true (u256_same c (u256_add (u256_shl (u256 255) (u256 1)) (u256 1)))) (Op.Eq x (imm (u256_shl (u256 255) (u256 1)))))

;; SGt x (iconst c) => Eq x (imm (u256_shr (u256 1) (u256_max)))
(rule (rewrite (Op.SGt x (iconst c))) (if-let true (u256_same c (u256_sub (u256_shr (u256 1) (u256_max)) (u256 1)))) (Op.Eq x (imm (u256_shr (u256 1) (u256_max)))))

;; Ne (band (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero) => And a b
(rule (rewrite (Op.Ne (band (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))  (Op.And a b))

;; Ne (bor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero) => Or a b
(rule (rewrite (Op.Ne (bor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))  (Op.Or a b))

;; Ne (bxor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero) => Xor a b
(rule (rewrite (Op.Ne (bxor (zext (and a (bool_value))) (zext (and b (bool_value)))) (zero)))  (Op.Xor a b))

;; Shl (iconst s) (signextend (iconst b) x) => Shl (imm s) x
(rule (rewrite (Op.Shl (iconst s) (signextend (iconst b) x))) (if-let true (u256_lt b 31)) (if-let true (u256_le (u256_sub (u256 256) (u256_mul (u256_add b (u256 1)) (u256 8))) s)) (Op.Shl (imm s) x))

;; SDiv x (iconst c) => Shr (imm shift) x
(rule (rewrite (Op.SDiv x (iconst c))) (if-let shift (power_of_two_shift c)) (if-let true (u256_lt shift 255)) (if-let true (below_const x (u256_shl (u256 255) (u256 1)))) (if-let true (has_bitwise_shifting)) (Op.Shr (imm shift) x))

;; SDiv (and x (shl (iconst s) _)) (iconst c) => Sar (imm shift) x
(rule (rewrite (Op.SDiv (and x (shl (iconst s) _)) (iconst c))) (if-let shift (power_of_two_shift c)) (if-let true (u256_lt shift 255)) (if-let true (u256_le shift s)) (if-let true (has_bitwise_shifting)) (Op.Sar (imm shift) x))

;; Div (mul x (nonzero_const c)) (iconst c) => Add x (imm (u256 0))
(rule (rewrite (Op.Div (mul x (nonzero_const c)) (iconst c))) (if-let true (at_most_const x (u256_div (u256_max) c))) (Op.Add x (imm (u256 0))))

;; Or (band x (iconst a)) (iconst b) => Or x (imm b)
(rule (rewrite (Op.Or (band x (iconst a)) (iconst b))) (if-let true (u256_is_zero (u256_and (u256_not a) (u256_not b)))) (Op.Or x (imm b)))

;; And (bor x (iconst a)) (iconst b) => And x (imm b)
(rule (rewrite (Op.And (bor x (iconst a)) (iconst b))) (if-let true (u256_is_zero (u256_and a b))) (Op.And x (imm b)))

;; And (bor (band x (iconst a)) y) (iconst b) => And y (imm b)
(rule (rewrite (Op.And (bor (band x (iconst a)) y) (iconst b))) (if-let true (u256_is_zero (u256_and a b))) (Op.And y (imm b)))

;; And (bor y (band x (iconst a))) (iconst b) => And y (imm b)
(rule (rewrite (Op.And (bor y (band x (iconst a))) (iconst b))) (if-let true (u256_is_zero (u256_and a b))) (Op.And y (imm b)))

;; Eq (sar (iconst s) x) (zero) => SGt x (imm (u256_max))
(rule (rewrite (Op.Eq (sar (iconst s) x) (zero))) (if-let true (u256_ge s 255)) (Op.SGt x (imm (u256_max))))

;; Ne (sar (iconst s) x) (zero) => SLt x (imm (u256 0))
(rule (rewrite (Op.Ne (sar (iconst s) x) (zero))) (if-let true (u256_ge s 255)) (Op.SLt x (imm (u256 0))))

;; (x | nonzero_constant) == 0 => false; the truth-only consumer is decisive.
(rule (rewrite (Op.Eq (bor x (nonzero_const c)) (zero))) (Op.Eq (imm_bool false) (imm_bool true)))
;; (x | nonzero_constant) != 0 => true; preserve arbitrary returned words.
(rule (rewrite (Op.Ne (bor x (nonzero_const c)) (zero))) (Op.Eq (imm_bool true) (imm_bool true)))

;; addmod(0, constant, m) => mod(constant, m). Two constants keep their order.
(rule (rewrite (Op.AddMod (zero) (iconst x) m)) (Op.Mod (imm x) m))

;; mulmod(1, constant, m) => mod(constant, m). Two constants keep their order.
(rule (rewrite (Op.MulMod (one) (iconst x) m)) (Op.Mod (imm x) m))

;; x & (~x ^ y) => x & y.
(rule (rewrite (Op.And x (bxor (bnot x) y))) (Op.And x y))

;; x & (~x ^ y) => x & y.
(rule (rewrite (Op.And x (bxor y (bnot x)))) (Op.And x y))

;; x & (~x ^ y) => x & y.
(rule (rewrite (Op.And (bxor (bnot x) y) x)) (Op.And x y))

;; x & (~x ^ y) => x & y.
(rule (rewrite (Op.And (bxor y (bnot x)) x)) (Op.And x y))

;; (lt(x, y) ^ ne(x, y)) => gt(x, y).
(rule (rewrite (Op.Xor (lt x y) (ne x y))) (Op.Gt x y))

;; (lt(x, y) ^ ne(x, y)) => gt(x, y).
(rule (rewrite (Op.Xor (ne x y) (lt x y))) (Op.Gt x y))

;; (lt(x, y) ^ ne(y, x)) => gt(x, y).
(rule (rewrite (Op.Xor (lt x y) (ne y x))) (Op.Gt x y))

;; (lt(x, y) ^ ne(y, x)) => gt(x, y).
(rule (rewrite (Op.Xor (ne y x) (lt x y))) (Op.Gt x y))

;; (gt(x, y) ^ ne(x, y)) => lt(x, y).
(rule (rewrite (Op.Xor (gt x y) (ne x y))) (Op.Lt x y))

;; (gt(x, y) ^ ne(x, y)) => lt(x, y).
(rule (rewrite (Op.Xor (ne x y) (gt x y))) (Op.Lt x y))

;; (gt(x, y) ^ ne(y, x)) => lt(x, y).
(rule (rewrite (Op.Xor (gt x y) (ne y x))) (Op.Lt x y))

;; (gt(x, y) ^ ne(y, x)) => lt(x, y).
(rule (rewrite (Op.Xor (ne y x) (gt x y))) (Op.Lt x y))

;; (lt(x, y) | lt(y, x)) => ne(x, y).
(rule (rewrite (Op.Or (lt x y) (lt y x))) (Op.Ne x y))

;; (lt(x, y) ^ lt(y, x)) => ne(x, y).
(rule (rewrite (Op.Xor (lt x y) (lt y x))) (Op.Ne x y))

;; (gt(x, y) | gt(y, x)) => ne(x, y).
(rule (rewrite (Op.Or (gt x y) (gt y x))) (Op.Ne x y))

;; (gt(x, y) ^ gt(y, x)) => ne(x, y).
(rule (rewrite (Op.Xor (gt x y) (gt y x))) (Op.Ne x y))

;; (slt(x, y) ^ ne(x, y)) => sgt(x, y).
(rule (rewrite (Op.Xor (slt x y) (ne x y))) (Op.SGt x y))

;; (slt(x, y) ^ ne(x, y)) => sgt(x, y).
(rule (rewrite (Op.Xor (ne x y) (slt x y))) (Op.SGt x y))

;; (slt(x, y) ^ ne(y, x)) => sgt(x, y).
(rule (rewrite (Op.Xor (slt x y) (ne y x))) (Op.SGt x y))

;; (slt(x, y) ^ ne(y, x)) => sgt(x, y).
(rule (rewrite (Op.Xor (ne y x) (slt x y))) (Op.SGt x y))

;; (sgt(x, y) ^ ne(x, y)) => slt(x, y).
(rule (rewrite (Op.Xor (sgt x y) (ne x y))) (Op.SLt x y))

;; (sgt(x, y) ^ ne(x, y)) => slt(x, y).
(rule (rewrite (Op.Xor (ne x y) (sgt x y))) (Op.SLt x y))

;; (sgt(x, y) ^ ne(y, x)) => slt(x, y).
(rule (rewrite (Op.Xor (sgt x y) (ne y x))) (Op.SLt x y))

;; (sgt(x, y) ^ ne(y, x)) => slt(x, y).
(rule (rewrite (Op.Xor (ne y x) (sgt x y))) (Op.SLt x y))

;; (slt(x, y) | slt(y, x)) => ne(x, y).
(rule (rewrite (Op.Or (slt x y) (slt y x))) (Op.Ne x y))

;; (slt(x, y) ^ slt(y, x)) => ne(x, y).
(rule (rewrite (Op.Xor (slt x y) (slt y x))) (Op.Ne x y))

;; (sgt(x, y) | sgt(y, x)) => ne(x, y).
(rule (rewrite (Op.Or (sgt x y) (sgt y x))) (Op.Ne x y))

;; (sgt(x, y) ^ sgt(y, x)) => ne(x, y).
(rule (rewrite (Op.Xor (sgt x y) (sgt y x))) (Op.Ne x y))
