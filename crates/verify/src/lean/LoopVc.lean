-- Generated by solar-verify --emit-loopvc (format 1); do not edit.
import Verify.Obligation

/-!
# Loop cutpoint templates of solar-verify's verification conditions

`solar-verify --emit-loopvc DIR` cuts a function at the head of its loop and writes every
obligation of the function as a `Template`: the obligation solar-verify sent, with the loop's
candidate invariant and ranking function replaced by two declared symbols, the predicate `Inv`
(symbol `base`) and the ranking function `Rank` (symbol `base + 1`), applied to the cut's
parameters. `Template.instances cut c t` puts a candidate `c` back: every `Inv` application
becomes the conjunction of `c.conj` at its arguments and every `Rank` application `c.rank` at
its arguments; a template whose goal is an `Inv` application gives one obligation per conjunct,
as solar-verify checks each conjunct on its own. The module exported for a function proves, by
`rfl`, that the instances of its templates at the candidate of the run are exactly the
obligations solar-verify emitted for that run (`--emit-lean`).

A candidate is a list of terms over the cut's parameters: declared constants of the function's
script, numbered as there, that `subst` replaces by an application's arguments. A template never
has an `Inv` or `Rank` application under a binder, and a candidate's terms have no loose bound
variable, so substitution needs no shifting.
-/

namespace SolarVerify.LoopVc

open SolarVerify.Smt SolarVerify.Vc

/-- A loop cut: the declared constants (by symbol number) a candidate ranges over, in the
order of the arguments of the cut's `Inv` and `Rank` applications. -/
structure Cut where
  params : List Nat
  deriving Repr, Inhabited

/-- A candidate: the invariant's conjuncts and the ranking function, over the cut's
parameters. -/
structure Cand where
  conj : List Term
  rank : Option Term
  deriving Repr, Inhabited

/-- The term bound to symbol `f` by `σ`, if any. -/
def lookup : List (Nat × Term) → Nat → Option Term
  | [], _ => none
  | (g, t) :: σ, f => match Nat.beq f g with
    | true => some t
    | false => lookup σ f

mutual
/-- `t` with every constant `σ` binds replaced by its term. -/
def subst (σ : List (Nat × Term)) : Term → Term
  | .fn f [] => match lookup σ f with
    | some u => u
    | none => .fn f []
  | .fn f (a :: as) => .fn f (substList σ (a :: as))
  | .app op args => .app op (substList σ args)
  | .constArray s v => .constArray s (subst σ v)
  | .mk fs => .mk (substList σ fs)
  | .proj i t => .proj i (subst σ t)
  | .«forall» bs b => .«forall» bs (subst σ b)
  | .«exists» bs b => .«exists» bs (subst σ b)
  | .bool b => .bool b
  | .int i => .int i
  | .bv w n => .bv w n
  | .var i => .var i
/-- `subst` on each term of a list. -/
def substList (σ : List (Nat × Term)) : List Term → List Term
  | [] => []
  | t :: ts => subst σ t :: substList σ ts
end

/-- The conjunction of a candidate's conjuncts, as solar-verify assumes it at the loop head:
the term itself for one conjunct, `and` of them for several. -/
def conjoin : List Term → Term
  | [t] => t
  | ts => .app .and ts

mutual
/-- `t` with candidate `c` in place of the cut's `Inv` (symbol `base`) and `Rank` (symbol
`base + 1`). -/
def inst (cut : Cut) (c : Cand) (base : Nat) : Term → Term
  | .fn f args =>
    let args' := instList cut c base args
    match Nat.beq f base with
    | true => conjoin (c.conj.map (subst (cut.params.zip args')))
    | false => match Nat.beq f (base + 1), c.rank with
      | true, some r => subst (cut.params.zip args') r
      | _, _ => .fn f args'
  | .app op args => .app op (instList cut c base args)
  | .constArray s v => .constArray s (inst cut c base v)
  | .mk fs => .mk (instList cut c base fs)
  | .proj i t => .proj i (inst cut c base t)
  | .«forall» bs b => .«forall» bs (inst cut c base b)
  | .«exists» bs b => .«exists» bs (inst cut c base b)
  | .bool b => .bool b
  | .int i => .int i
  | .bv w n => .bv w n
  | .var i => .var i
/-- `inst` on each term of a list. -/
def instList (cut : Cut) (c : Cand) (base : Nat) : List Term → List Term
  | [] => []
  | t :: ts => inst cut c base t :: instList cut c base ts
end

/-- An obligation of the function with the cut's candidate abstracted: the template script
declares the function's `base` symbols, then `Inv` and `Rank`. -/
structure Template where
  script : Script
  base : Nat
  upto : Nat
  guard : Term
  goal : Term
  deriving Repr, Inhabited

/-- The template's script with candidate `c`: the function's own declarations, and every
assertion instantiated. -/
def Template.instScript (t : Template) (cut : Cut) (c : Cand) : Script where
  decls := t.script.decls.take t.base
  asserts := instList cut c t.base t.script.asserts

/-- The obligations a template stands for at candidate `c`: one per conjunct when its goal is an
`Inv` application, else one. -/
def Template.instances (t : Template) (cut : Cut) (c : Cand) : List Obligation :=
  let script := t.instScript cut c
  let guard := inst cut c t.base t.guard
  let one (goal : Term) : Obligation := { script, upto := t.upto, guard, goal }
  match t.goal with
  | .fn f args => match Nat.beq f t.base with
    | true => c.conj.map (fun b => one (subst (cut.params.zip (instList cut c t.base args)) b))
    | false => [one (inst cut c t.base t.goal)]
  | g => [one (inst cut c t.base g)]

/-- A template holds at candidate `c`: every obligation it stands for is valid. -/
def Template.Valid (t : Template) (cut : Cut) (c : Cand) : Prop :=
  ∀ o ∈ t.instances cut c, o.Valid

/-- A template whose instances are known obligations holds exactly when they do. -/
theorem Template.valid_iff {t : Template} {cut : Cut} {c : Cand} {obs : List Obligation}
    (h : t.instances cut c = obs) : t.Valid cut c ↔ ∀ o ∈ obs, o.Valid := by
  rw [Template.Valid, h]

end SolarVerify.LoopVc
