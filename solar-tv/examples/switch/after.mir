; === solar-tv/examples/switch/before.mir (after cfg-simplify) ===
@module Switch
fn @pick(arg0: i256) -> i256 {
  bb0:
    switch 5, default bb1, [arg0 => bb1, 5 => bb2]
  bb2:                                            ; preds = bb0
    ret 2
  bb1:                                            ; preds = bb0
    ret 1
}
