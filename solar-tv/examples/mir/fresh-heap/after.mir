@module FreshHeap
fn @entry() [entry] {
  bb0:
    tail_call @name
}

fn @name() {
  bb0:
    v0 = icall @name.body
    v1 = ptrtoint ptr<memory> v0 to i256
    returndata v1, 64
}

fn @name.body() -> ptr<memory> [may_return_memory] {
  bb0:
    v3 = heap_floor !metadata(alloc_ptr)
    v0 = inttoptr i256 v3 to ptr<memory> !metadata(memory=scratch)
    v4 = add v3, 64 !metadata(alloc_ptr)
    mstore 64, v4 !metadata(memory=scratch)
    v1 = ptrtoint ptr<memory> v0 to i256
    mstore v1, 13
    v2 = add v1, 32
    mstore v2, 0x5772617070656420457468657200000000000000000000000000000000000000
    ret v0
}
