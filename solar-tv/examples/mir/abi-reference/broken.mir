; === solar-tv/examples/mir/abi-reference/before.mir (after lower-abi-encode,lower-slices,lower-memory-objects) ===
@module State
fn @f() -> i256 {
  bb0:
    v4 = fmp
    v5 = ptrtoint ptr<memory> v4 to i256
    v6 = add v5, 32
    v7 = add v6, 32
    v8 = sub v7, v6
    mstore v6, 64
    v9 = mload 128
    v10 = add v9, 31
    v11 = and v10, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v12 = add v7, 32
    v13 = add v7, v11
    mstore v13, 0
    mstore v7, v9
    v15 = add v12, v11
    mcopy v12, 160, v9 !metadata(memory=heap, disjoint)
    v16 = sub v15, v6
    v17 = add v16, 0
    v18 = add v17, 31
    v19 = and v18, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0
    v20 = add v19, 32
    v21 = lt v20, v17
    jumpi v21, bb1, bb2
  bb2:                                            ; preds = bb0
    v22 = alloc v20 !metadata(preserves_fmp)
    v25 = ptrtoint ptr<memory> v22 to i256
    mstore v25, v17
    v23 = ptrtoint ptr<memory> v22 to i256
    v24 = add v23, 32
    v3 = mload v24
    ret v3
  bb1 [cold]:                                     ; preds = bb0
    mstore 32, 65 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
}
