; === solar-tv/examples/mir/abi-scalar/before.mir (after lower-abi-encode,lower-slices,lower-memory-objects) ===
@module Examples
fn @f() -> i256 {
  bb0:
    v2 = alloc 64 !metadata(preserves_fmp)
    v6 = ptrtoint ptr<memory> v2 to i256
    mstore v6, 32
    v4 = ptrtoint ptr<memory> v2 to i256
    v5 = add v4, 32
    mstore v5, 17
    v1 = ptrtoint ptr<memory> v2 to i256
    ret v1
}
