@module DomainSeparator
fn @name() -> ptr<memory> [selector=0x06fdde03, view, abi_params=[], abi_returns=[memory_bytes], abi_return_params=[bytes]] {
  bb0:
    v0 = alloc 64 !metadata(preserves_fmp)
    mstore v0, 13
    v1 = ptradd v0, 32
    mstore v1, 0x5772617070656420457468657200000000000000000000000000000000000000
    ret v0
}

fn @DOMAIN_SEPARATOR() -> i256 [selector=0x3644e515, view, abi_params=[], abi_returns=[word], abi_return_params=[bytes32]] {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0
    jump bb2
  bb2:                                            ; preds = bb1
    jump bb3
  bb3:                                            ; preds = bb2
    v2 = icall @name
    v3 = ptradd v2, 32
    v4 = mload v2
    v5 = keccak256 v3, v4
    jump bb4
  bb4:                                            ; preds = bb3
    v6 = phi [bb3: v5]
    jump bb5
  bb5:                                            ; preds = bb4
    jump bb6
  bb6:                                            ; preds = bb5
    v8 = mload 64 !metadata(memory=scratch)
    mstore v8, 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f
    v9 = add v8, 32
    mstore v9, v6
    v10 = add v8, 64
    mstore v10, 0xc89efdaa54c0f20c7adf612882df0950f5a951637e0307cdcb4c672f298b8bc6
    v11 = chainid
    v12 = add v8, 96
    mstore v12, v11
    v13 = address
    v14 = zext i160 v13 to i256
    v15 = add v8, 128
    mstore v15, v14
    v16 = keccak256 v8, 160
    ret v16
}
