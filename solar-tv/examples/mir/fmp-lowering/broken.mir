; === solar-tv/examples/mir/fmp-lowering/before.mir (after lower-alloc) ===
@module Morpho
@immutables
  DOMAIN_SEPARATOR: bytes32

; creation entry
fn @constructor() [constructor, creation_only] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb6, bb1
  bb1:                                            ; preds = bb0
    v2 = constructor_args_base
    v3 = constructor_args_end
    v4 = add v2, 32
    v5 = lt v3, v4
    jumpi v5, bb6, bb2
  bb2:                                            ; preds = bb1
    v6 = mload v2
    v7 = gt v6, 0xffffffffffffffffffffffffffffffffffffffff
    jumpi v7, bb6, bb3
  bb3:                                            ; preds = bb2
    v8 = trunc i256 v6 to i160
    v9 = ne v8, i160 0
    jumpi v9, bb5, bb4
  bb4 [cold]:                                     ; preds = bb3
    icall @revert_error, 12, 0x7a65726f20616464726573730000000000000000000000000000000000000000
    invalid
  bb5:                                            ; preds = bb3
    v10 = chainid
    v11 = address
    v12 = zext i160 v11 to i256
    v19 = mload 96 !metadata(memory=scratch, alloc_ptr)
    v13 = inttoptr i256 v19 to ptr<memory> !metadata(memory=scratch)
    v14 = ptrtoint ptr<memory> v13 to i256
    mstore v14, 0x47e79534a245952e8b16893a336b85a3d9ea9fa8c573f3d803afb92a79469218
    v15 = add v14, 32
    mstore v15, v10
    v16 = add v14, 64
    mstore v16, v12
    v17 = keccak256 v14, 96
    mstore 192, v17
    v18 = zext i160 v8 to i256
    sstore 0, v18 !metadata(storage=slot(0))
    log 0, 0, 0x167d3e9c1016ab80e58802ca9da10ce5c6a0f4debc46a2e7a2cd9e56899a4fb5, v18
    ret
  bb6 [cold]:                                     ; preds = bb0, bb1, bb2
    revert 0, 0
}

fn @revert_error(arg0: i256, arg1: i256) [cold] {
  bb0 [cold]:
    mstore 32, 32 !metadata(memory=scratch)
    mstore 64, arg0 !metadata(memory=scratch)
    mstore 96, arg1 !metadata(memory=scratch)
    mstore 0, 0x8c379a0 !metadata(memory=scratch)
    revert 28, 100
}
