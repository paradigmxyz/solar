@module WidthGuard
fn @f() {
  bb0:
    v0 = calldatasize
    v1 = lt v0, 68
    v2 = calldataload 4
    v6 = shr v2, 160
    v8 = zext i1 v1 to i256
    v9 = or v6, v8
    v4 = ne v9, 0
    jumpi v4, bb2, bb1
  bb1:                                            ; preds = bb0
    v5 = calldataload 4
    icall @touch, v5
    stop
  bb2 [cold]:                                     ; preds = bb0
    revert 0, 0
}

fn @touch(arg0: i256) {
  bb0:
    v0 = add arg0, 7
    sstore 0, v0
    ret
}
