@module WidthGuard
fn @f() {
bb0:
  v0 = calldatasize
  v1 = lt v0, 68
  v2 = calldataload 4
  v3 = gt v2, 0xffffffffffffffffffffffffffffffffffffffff
  v4 = or v1, v3
  jumpi v4, bb2, bb1
bb1:
  v5 = calldataload 4
  icall @touch, v5
  stop
bb2:
  revert 0, 0
}
fn @touch(arg0: i256) {
bb0:
  v0 = add arg0, 7
  sstore 0, v0
  ret
}
