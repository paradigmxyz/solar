@module CyclicDce
; runtime dispatch entry
fn @entry() [entry] {
  bb0:
    v0 = icall @f
    mstore 0, v0
    returndata 0, 32
}

fn @f() -> i256 {
  bb0:
    jump bb1
  bb1:                                            ; preds = bb0, bb2
    v2 = phi [bb0: 0], [bb2: v4]
    v3 = lt v2, 4
    jumpi v3, bb2, bb3
  bb3:                                            ; preds = bb1
    ret v2
  bb2:                                            ; preds = bb1
    v4 = add v2, 1
    icall @sink, v2
    jump bb1
}

fn @sink(arg0: i256) {
  bb0:
    sstore 0, arg0
    ret
}
