    v3 = phi [bb0: v1], [bb2: v6]
    v4 = lt v2, arg2
    jumpi v4, bb2, bb3
  bb3:                                            ; preds = bb1
    ret
  bb2:                                            ; preds = bb1
    sstore v3, 0 !metadata(storage=symbolic(v3))
    v5 = add v2, 1
    v6 = add v3, 1
    jump bb1
