fn @clear_storage_words(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    mstore 0, arg0 !metadata(memory=scratch)
    v7 = keccak256 0, 32 !metadata(memory=scratch)
    v1 = add v7, arg1
    jump bb1
  bb1:                                            ; preds = bb0, bb2
