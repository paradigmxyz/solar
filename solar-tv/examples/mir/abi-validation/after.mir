@module AbiValidation
fn @f(arg0: i256) -> i256 {
  bb0:
    mstore 128, 32
    mstore 160, arg0
    v3 = mload 128
    v5 = add v3, 160
    v6 = slt v3, 32
    jumpi v6, bb1, bb2
  bb2:                                            ; preds = bb0
    v7 = mload 160
    v8 = shl v7, 192
    v9 = ne v8, 0
    v10 = or v9, false
    v11 = zext i1 v10 to i256
    v12 = shr v7, 64
    jumpi v10, bb1, bb3
  bb3:                                            ; preds = bb2
    validate_abi uint192, v12
    ret v12
  bb1 [cold]:                                     ; preds = bb0, bb2
    revert 0, 0
}
