; === solar-tv/examples/mir/slots/before.mir (after lower-mapping-slots) ===
@module Slots
fn @f() -> i256 {
  bb0:
    mstore 0, 7 !metadata(memory=scratch)
    mstore 32, 9 !metadata(memory=scratch)
    mstore 0, 3 !metadata(memory=scratch)
    mstore 0, 5 !metadata(memory=scratch)
    v3 = xor 0xc2575a0e9e593c00f959f8c92f12db2869c3395a3b0502d05e2516446f71f85b, 0xae6299332bcd708cd60e3a8defa55de28078a50a4cf2b3de3a546253240ff9e1
    v4 = xor v3, 0x36b6384b5eca791c62761152d0c79bb0604c104a5fb6f4eb0703f3154bb3db8
    mstore 0, 3 !metadata(memory=scratch)
    v6 = xor v4, 0xc2575a0e9e593c00f959f8c92f12db2869c3395a3b0502d05e2516446f71f85b
    ret v6
}
