; === solar-tv/examples/mir/storage-arrays/before.mir (after lower-builtins,lower-slices,lower-memory-objects,lower-mapping-slots) ===
@module State
fn @f() -> i256 {
  bb0:
    v2 = sload 3 !metadata(storage=slot(3))
    v3 = gt v2, 0x7ffffffffffffff
    jumpi v3, bb1, bb2
  bb2:                                            ; preds = bb0
    v4 = add v2, 1
    v5 = mul v4, 32
    v6 = alloc checked v5
    v32 = ptrtoint ptr<memory> v6 to i256
    mstore v32, v2
    mstore 0, 3 !metadata(memory=scratch)
    v8 = add v2, 9
    v9 = div v8, 10
    jump bb3
  bb3:                                            ; preds = bb2, bb8
    v10 = phi [bb2: 0], [bb8: v28]
    v11 = lt v10, v9
    jumpi v11, bb4, bb5
  bb5:                                            ; preds = bb3
    v1 = ptrtoint ptr<memory> v6 to i256
    ret v1
  bb4:                                            ; preds = bb3
    v12 = add v10, 0xc2575a0e9e593c00f959f8c92f12db2869c3395a3b0502d05e2516446f71f85b
    v13 = sload v12 !metadata(storage=symbolic(v12))
    v14 = mul v10, 10
    v15 = sub v2, v14
    v16 = lt v15, 10
    v17 = select v16, v15, 10
    jump bb6
  bb6:                                            ; preds = bb4, bb7
    v18 = phi [bb4: 0], [bb7: v27]
    v19 = lt v18, v17
    jumpi v19, bb7, bb8
  bb8:                                            ; preds = bb6
    v28 = add v10, 1
    jump bb3
  bb7:                                            ; preds = bb6
    v20 = mul v18, 24
    v21 = shr v13, v20
    v22 = and v21, 0xffffff
    v23 = add v14, v18
    v24 = shl v23, 5
    v29 = ptrtoint ptr<memory> v6 to i256
    v30 = add v29, v24
    v31 = add v30, 32
    mstore v31, v22
    v27 = add v18, 1
    jump bb6
  bb1 [cold]:                                     ; preds = bb0
    mstore 32, 65 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
}
