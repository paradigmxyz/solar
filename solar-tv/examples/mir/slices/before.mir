@module Slices
fn @f(arg0: slice<calldata>, arg1: i256) -> i256 {
bb0:
  v0 = extract_value slice<calldata>, arg0, 0
  v1 = extract_value slice<calldata>, arg0, 1
  v2 = ptradd v0, arg1
  v3 = sub v1, arg1
  v4 = make_calldata_slice v2, v3
  v5 = icall @sum, v4
  ret v5
}

fn @sum(arg0: slice<calldata>) -> i256 {
bb0:
  v0 = extract_value slice<calldata>, arg0, 0
  v1 = extract_value slice<calldata>, arg0, 1
  v2 = ptrtoint ptr<calldata> v0 to i256
  v3 = add v2, v1
  ret v3
}
