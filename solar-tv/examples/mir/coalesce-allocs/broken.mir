; === solar-tv/examples/mir/coalesce-allocs/before.mir (after coalesce-allocs) ===
@module CoalesceAlloc
; creation entry
fn @constructor() [constructor] {
  bb0:
    v0 = callvalue
    v1 = ne v0, 0
    jumpi v1, bb2, bb1
  bb1:                                            ; preds = bb0
    v2 = alloc 128 !metadata(preserves_fmp)
    v3 = ptrtoint ptr<memory> v2 to i256
    mstore v3, 9
    v4 = add v3, 32
    mstore v4, 0x45524332304d6f636c0000000000000000000000000000000000000000000000
    v8 = ptrtoint ptr<memory> v2 to i256
    v9 = add v8, 64 !metadata(preserves_fmp)
    v5 = inttoptr i256 v9 to ptr<memory> !metadata(preserves_fmp)
    v6 = ptrtoint ptr<memory> v5 to i256
    mstore v6, 4
    v7 = add v6, 32
    mstore v7, 0x4532304d00000000000000000000000000000000000000000000000000000000
    icall @store_storage_bytes, 3, v2
    icall @store_storage_bytes, 4, v5
    ret
  bb2 [cold]:                                     ; preds = bb0
    revert 0, 0
}

fn @store_storage_bytes(arg0: i256, arg1: ptr<memory>) [may_return_memory] {
  bb0:
    v0 = sload arg0 !metadata(storage=symbolic(arg0))
    v1 = and v0, 1
    v2 = eq v1, 1
    v3 = sub 0, v1
    v4 = or v3, 127
    v5 = shr v0, 1
    v6 = and v5, v4
    v7 = lt v6, 32
    v8 = eq v2, v7
    jumpi v8, bb13, bb1
  bb1:                                            ; preds = bb0
    v9 = ptrtoint ptr<memory> arg1 to i256
    v10 = add v9, 32
    v11 = inttoptr i256 v10 to ptr<memory>
    v12 = mload v9
    v13 = add v6, 31
    v14 = shr v13, 5
    v15 = add v12, 31
    v16 = lt v15, v12
    jumpi v16, bb12, bb2
  bb2:                                            ; preds = bb1
    v17 = shr v15, 5
    v18 = lt v12, 32
    v19 = eq v18, false
    v20 = zext i1 v19 to i256
    v21 = mul v17, v20
    v22 = lt v12, v6
    v23 = and v2, v22
    jumpi v23, bb3, bb4
  bb3:                                            ; preds = bb2
    icall @clear_storage_words, arg0, v21, v14
    jump bb4
  bb4:                                            ; preds = bb2, bb3
    jumpi v18, bb10, bb5
  bb5:                                            ; preds = bb4
    v24 = add v12, v12
    v25 = or v24, 1
    sstore arg0, v25 !metadata(storage=symbolic(arg0))
    mstore 0, arg0 !metadata(memory=scratch)
    v26 = keccak256 0, 32 !metadata(memory=scratch)
    v27 = shr v12, 5
    jump bb6
  bb6:                                            ; preds = bb5, bb9
    v28 = phi [bb5: 0], [bb9: v46]
    v29 = lt v28, v27
    jumpi v29, bb9, bb7
  bb7:                                            ; preds = bb6
    v30 = and v12, 31
    v31 = eq v30, 0
    jumpi v31, bb11, bb8
  bb8:                                            ; preds = bb7
    v32 = shl v27, 5
    v33 = ptrtoint ptr<memory> v11 to i256
    v34 = add v33, v32
    v35 = mload v34
    v36 = sub 32, v30
    v37 = shl v36, 3
    v38 = shl 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, v37
    v39 = and v35, v38
    v40 = add v26, v27
    sstore v40, v39 !metadata(storage=symbolic(v40))
    jump bb11
  bb9:                                            ; preds = bb6
    v41 = shl v28, 5
    v42 = ptrtoint ptr<memory> v11 to i256
    v43 = add v42, v41
    v44 = mload v43
    v45 = add v26, v28
    sstore v45, v44 !metadata(storage=symbolic(v45))
    v46 = add v28, 1
    jump bb6
  bb10:                                           ; preds = bb4
    v47 = ptrtoint ptr<memory> v11 to i256
    v48 = mload v47
    v49 = sub 32, v12
    v50 = shl v49, 3
    v51 = shl 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, v50
    v52 = and v48, v51
    v53 = add v12, v12
    v54 = or v52, v53
    sstore arg0, v54 !metadata(storage=symbolic(arg0))
    jump bb11
  bb11:                                           ; preds = bb7, bb8, bb10
    ret
  bb12 [cold]:                                    ; preds = bb1
    mstore 32, 65 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
  bb13 [cold]:                                    ; preds = bb0
    mstore 32, 34 !metadata(memory=scratch)
    mstore 0, 0x4e487b71 !metadata(memory=scratch)
    revert 28, 36
}

fn @clear_storage_words(arg0: i256, arg1: i256, arg2: i256) {
  bb0:
    mstore 0, arg0 !metadata(memory=scratch)
    v0 = keccak256 0, 32 !metadata(memory=scratch)
    v1 = add v0, arg1
    jump bb1
  bb1:                                            ; preds = bb0, bb3
    v2 = phi [bb0: arg1], [bb3: v5]
    v3 = phi [bb0: v1], [bb3: v6]
    v4 = lt v2, arg2
    jumpi v4, bb3, bb2
  bb2:                                            ; preds = bb1
    ret
  bb3:                                            ; preds = bb1
    sstore v3, 0 !metadata(storage=symbolic(v3))
    v5 = add v2, 1
    v6 = add v3, 1
    jump bb1
}
