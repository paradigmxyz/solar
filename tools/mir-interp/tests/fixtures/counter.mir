// A counter: `increment()` adds one to slot 0, checked, and logs the caller; `count()` returns
// the slot. `@remaining` reads the gas left, which the interpreter cannot run.
@module Counter
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr 224, v0
    switch v1, default bb3, [0xd09de08a => bb1, 0x06661abd => bb2]
  bb1:
    tail_call @increment
  bb2:
    tail_call @count
  bb3:
    revert 0, 0
}

fn @increment() [selector=0xd09de08a, abi_wrapper] {
  bb0:
    v0 = sload 0
    v1 = icall @add, v0, 1
    sstore 0, v1
    v2: i256 = caller
    mstore 0, v1
    log2 0, 32, 0x7a2e4c9bdfb0c1ee2fb7e6d8d0e21e4d2e1c73f3a9a7ff1d6d8b1e8c1b0a9f01, v2
    stop
}

fn @count() [selector=0x06661abd, abi_wrapper] {
  bb0:
    v0 = sload 0
    mstore 0, v0
    returndata 0, 32
}

fn @add(arg0: i256, arg1: i256) -> i256 {
  bb0:
    v0 = add arg0, arg1
    v1 = lt v0, arg0
    jumpi v1, bb1, bb2
  bb1:
    mstore 0, 0x4e487b71
    mstore 32, 17
    revert 28, 36
  bb2:
    ret v0
}

fn @remaining() -> i256 {
  bb0:
    v0 = gas
    ret v0
}
