//@ compile-flags: -Zevm-ir-pipeline=peephole-early
// The peephole drops `push 0; add` in a loop body: the region from the header proves it.
@module ValidateLoop
bb0:
  push 0
  calldataload
  jump bb1
bb1 [loop]:
  dup 1
  jumpi bb2, bb3
bb2 [loop]:
  dup 1
  push 7
  sstore
  push 1
  swap 1
  sub
  push 0
  add
  jump bb1
bb3:
  dup 1
  push 7
  sstore
  stop
