//@ compile-flags: -Zevm-ir-pipeline=cfg-simplify,tail-merge,cfg-simplify
// CFG simplification threads the empty bb1 and tail merging shares the two stores' tail.
@module ValidateThreading
bb0:
  push 0
  calldataload
  jumpi bb1, bb2
bb1:
  jump bb3
bb2:
  push 2
  push 0
  mstore
  jump bb3
bb3:
  push 0
  calldataload
  jumpi bb4, bb5
bb4:
  push 1
  push 0
  sstore
  push 32
  push 0
  return
bb5:
  push 2
  push 0
  sstore
  push 32
  push 0
  return
