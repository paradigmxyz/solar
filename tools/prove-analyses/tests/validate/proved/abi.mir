//@ compile-flags: -Zmir-pipeline=lower-abi
// Each wrapper reverts on calldata shorter than its head and on a word that is not the canonical
// encoding of its type, and passes the words to the body. A result whose layout is a word is
// returned as is, and one with a source type cleaned to it.
@module ValidateAbi
@phase semantic
fn @narrow(arg0: i256, arg1: i256, arg2: i160) -> i256 [selector=0x10000001, abi_params=[uint8, int16, address], abi_returns=[word<uint8>]] {
  bb0:
    v0 = add arg0, arg1
    v1 = zext i160 arg2 to i256
    v2 = xor v0, v1
    ret v2
}

fn @flags(arg0: i1, arg1: i256) -> i256 [selector=0x10000002, abi_params=[bool, bytes4], abi_returns=[word]] {
  bb0:
    v0 = zext i1 arg0 to i256
    v1 = or arg1, v0
    ret v1
}

fn @signed(arg0: i256) -> i256 [selector=0x10000003, abi_params=[uint256], abi_returns=[word], abi_return_params=[int8]] {
  bb0:
    v0 = add arg0, 1
    ret v0
}

fn @owner() -> i256 [selector=0x10000004, abi_returns=[word], abi_return_params=[address]] {
  bb0:
    v0 = sload 0
    ret v0
}

fn @tag() -> i256 [selector=0x10000005, abi_returns=[word], abi_return_params=[bytes4]] {
  bb0:
    v0 = sload 1
    ret v0
}

fn @neg(arg0: i8, arg1: i8) -> i256 [selector=0x10000006, abi_params=[int8, enum<3, uint8>], abi_returns=[word]] {
  bb0:
    v0 = sext i8 arg0 to i256
    v1 = zext i8 arg1 to i256
    v2 = add v0, v1
    ret v2
}
