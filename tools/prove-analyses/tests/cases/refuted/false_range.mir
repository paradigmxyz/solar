//@ compile-flags: -Zmir-pipeline=lower-assumes
// A false range fact: calldata can hold any word, not only one below 10.
@module FalseRange
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = shr v0, 224
    switch v1, default bb2, [0x8de62f33 => bb1]
  bb1:
    tail_call @below
  bb2:
    revert 0, 0
}

fn @below() {
  bb0:
    v0 = calldataload 4
    v1 = add v0, 1
    assume ult sccp, v0, 10
    mstore 0, v1
    returndata 0, 32
}
