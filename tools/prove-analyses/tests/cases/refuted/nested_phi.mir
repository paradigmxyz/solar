//@ compile-flags: -Zmir-pipeline=lower-assumes
// A false fact after a join whose predecessor passes through an inner join. The
// fact bb3 checks ties its own calldata size read to v0, which bounds v0 only on
// the executions through bb3, not on those through bb4.
@module NestedPhi
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = lt v0, 0x10000000000000000
    jumpi v1, bb1, bb2
  bb1:
    jump bb5
  bb2:
    v2 = calldatasize
    v3 = eq v0, v2
    jumpi v3, bb3, bb4
  bb3:
    v4 = calldatasize
    assume eq cse, v4, v0
    jump bb6
  bb4:
    jump bb6
  bb6:
    v5 = phi [bb3: v4], [bb4: v0]
    jump bb5
  bb5:
    assume ult sccp, v0, 0x10000000000000000
    mstore 0, v0
    returndata 0, 32
}
