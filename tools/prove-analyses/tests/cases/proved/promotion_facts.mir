//@ compile-flags: -Zmir-pipeline=lower-assumes
// The loads SROA and frame-slot promotion keep read the word the promoted value was stored as,
// with no other write between, on each path into a join too.
@module PromotionFacts
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 4
    v1 = calldataload 36
    mstore 256, v0
    v2 = mload 256
    assume eq sroa, v2, v0
    v3 = ne v1, 0
    jumpi v3, bb1, bb2
  bb1:
    mstore 288, v0
    jump bb3
  bb2:
    mstore 288, v1
    jump bb3
  bb3:
    v4 = phi [bb1: v0], [bb2: v1]
    v5 = mload 288
    assume eq frame_slot_promotion, v5, v4
    mstore 0, v5
    returndata 0, 32
}
