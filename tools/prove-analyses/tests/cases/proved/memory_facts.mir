//@ compile-flags: -Zmir-pipeline=lower-assumes
// The storage facts loop-invariant code motion and storage promotion record are re-read where the
// loop can exit, so each is a loop invariant that the back edge's earlier pass proves: the loop
// writes only memory and another slot. The slots promotion found apart differ by construction. A
// record that a block is never reached gives no query, since proving it needs the callee.
@module MemoryFacts
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = sload 1
    v2 = sload 0
    v14 = calldatasize
    v15 = lt v14, 4
    jumpi v15, bb4, bb1
  bb1:
    v3 = phi [bb0: 0], [bb2: v7]
    v4 = sload 1
    assume eq licm, v1, v4
    v13 = sload 0
    assume eq storage_promotion, v2, v13
    v5 = lt v3, v0
    jumpi v5, bb2, bb3
  bb2:
    v6 = mload 128
    v8 = add v6, v1
    mstore 128, v8
    sstore 2, v8
    v11 = add v0, 1
    v12 = add v0, 2
    assume ne storage_promotion, v12, v11
    v7 = add v3, 1
    jump bb1
  bb3:
    v10 = mload 128
    sstore 0, v10
    stop
  bb4:
    assume eq noreturn_calls, 0, 1
    invalid
}
