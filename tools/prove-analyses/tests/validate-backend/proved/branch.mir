// Every block of a branch on two calldata words lowers faithfully.
@module ValidateBackendBranch
@phase lowered
fn @entry() [entry] {
  bb0:
    v0 = calldataload 0
    v1 = calldataload 32
    v2 = add v0, v1
    v3 = lt v0, v1
    jumpi v3, bb1, bb2
  bb1:
    v4 = sub v1, v0
    mstore 0, v4
    returndata 0, 32
  bb2:
    mstore 0, v2
    returndata 0, 32
}
