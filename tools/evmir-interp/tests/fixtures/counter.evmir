// A counter: `increment()` adds one to slot 0, panicking on overflow, and logs
// `Incremented(address)` with the caller and the new count; `count()` returns slot 0.
@module counter
bb0:
  push 0
  calldataload
  push 224
  shr
  dup 1
  push 0xd09de08a
  eq
  push bb2
  jumpi
  dup 1
  push 0x06661abd
  eq
  push bb4
  jumpi
  jump bb1
bb1 [cold]:
  push 0
  push 0
  revert
bb2:
  push 0
  sload
  push 1
  add
  dup 1
  iszero
  push bb3
  jumpi
  dup 1
  push 0
  sstore
  push 0
  mstore
  caller
  push 0xf57bb28dda50be2d99bc97dce404fae0ecca665bba60759ec491a82e893e4fd5
  push 32
  push 0
  log2
  stop
bb3 [cold]:
  push 0x4e487b71
  push 224
  shl
  push 0
  mstore
  push 0x11
  push 4
  mstore
  push 36
  push 0
  revert
bb4:
  push 0
  sload
  push 0
  mstore
  push 32
  push 0
  return
