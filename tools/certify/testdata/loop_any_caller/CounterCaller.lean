    ∀ x : Nat, x < 2 ^ 160 → x ≠ selfAddress →
    ∀ (σ : List (Nat × Nat)) (a : Nat), a < 2 ^ 256 →
    ∃ obs, (Loop.solidCoreRuntimeFrom x fuel).run c (bumpCall σ a) = some obs ∧
