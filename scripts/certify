#!/usr/bin/env bash
# Certifies one contract: compiles it with solar, exports every stage, writes the Lean proofs of
# the stages against the pinned solidity-lean checkout, builds them with lake, audits the axioms
# of every theorem and runs the negative tests. It fails closed: any step that does not check
# stops it with an error, and the only success line names what was proved.
#
#   scripts/certify FILE.sol [--contract C] [--name NAME] [--loops N] [--no-negatives]
#                   [--require-headline] [--require-spec] [-- SOLAR_OPTIONS...]
#
# CONTRACT defaults to the one contract of FILE with runtime code. NAME (default: FILE's base
# name in lowercase letters, digits and underscores) is the directory CERTIFIED/NAME of the
# solidity-lean checkout, its Lean library NAME and the namespace SolarTV.Milestone.<Name>.
# SOLAR_OPTIONS default to -Ogas --evm-version osaka (kept in CERTIFIED/NAME/options). --loops N
# (kept in CERTIFIED/NAME/loops) claims that a run's loops make at most N iterations in all; the
# first stage's end proof checks it. CERTIFIED/NAME/heartbeats, when present, raises the run proofs'
# maxHeartbeats.
#
# Steps:
# 1. The solidity-lean checkout: SOLIDITY_LEAN_DIR, which must be at the commit in
#    tools/certify/solidity-lean.rev, else a checkout of that commit in
#    target/certify/solidity-lean that the driver owns.
# 2. solar: SOLAR names the binary, else cargo builds this checkout's (CERTIFY_SKIP_BUILD=1
#    uses target/debug/solar as it is). Its version must name a commit whose compiler sources
#    are this checkout's committed ones.
# 3. Compiles CERTIFIED/NAME/NAME.sol with -Zemit-lean-stages, checks that the flag leaves the
#    runtime bytecode as it is, that it is CERTIFIED/NAME/bytecode.hex when that pin exists, and
#    the manifest's hashes.
# 4. tools/certify/certify.py writes CERTIFIED/NAME/Proofs: per pair of consecutive stages a
#    sym_exec proof, their composition from the first lowered MIR to the final EVM IR, and the
#    assembly walk of the bytecode against the final EVM IR.
# 5. Adds the library NAME to the lakefile when missing, builds it one module at a time, and
#    audits every theorem's axioms (only propext, Classical.choice and Quot.sound) and the
#    generated files (no sorry, native_decide, bv_decide, ofReduceBool, axiom or extern).
# 6. solar-verify --dry-run --dump-lean (SOLAR_VERIFY, else built from crates/verify when this
#    checkout has it) exports the contract's verification conditions; each function it leaves
#    raw, outside the fragment solidity-lean checks, is printed and recorded as REFUSED
#    (unproved), never as passing; --require-spec fails on any. When CERTIFIED/NAME/headline exists (lines "MODULE THEOREM": the source-to-bytecode or
#    spec-to-bytecode theorems solidity-lean states for the contract), builds each MODULE and
#    audits each THEOREM the same way. --require-headline fails when there is none.
# 6b. When CERTIFIED/NAME/shape.json exists, tools/certify/final.py writes CERTIFIED/NAME/Final.lean:
#    the published statement, fixed by the driver from shape.json and the bytecode this run
#    compiled (exact byte equality with the fresh export, then Shapes.Certified,
#    Shapes.Functional or, for a contract with no specification, Shapes.Compiled of it against the
#    checked source), with the proof shape.json names as its term. When shape.json has a generic
#    block, tools/certify/shape_gen.py first writes that proof (CERTIFIED/NAME/Shape.lean) from this
#    run's export: the generic source check, the backend stages, the final EVM IR's fuel and the
#    loop checker on an inferred certificate. The module is built and its theorem's axioms
#    audited; --require-final fails without it.
# 7. tools/certify/negative.sh: edited bytecode and stage artifacts fail with a mismatch, not a
#    timeout, while unedited controls pass; with shape.json, tools/certify/final_neg.sh: stale or
#    substituted bytecode, the strongest status without resources, a wrong postcondition, no
#    allowed status and a sorry proof each fail the published statement.
#
# The record's statuses (equivalence, termination, spec, resources, assumptions, excluded,
# strongest) come from the published statement when there is one; CERTIFIED is printed only when
# it is Shapes.Certified, all four proved. Each run also reports the stage statuses, never one blanket claim: mir_to_evmir (the stage proofs'
# composition from the first lowered MIR to the final EVM IR), assembly (decoded: the bytecode
# decodes to the final EVM IR's instructions; executed: a theorem that running the bytecode
# refines the final EVM IR, when the generator writes one), vc (solar-verify's conditions:
# exported, refused, or built and discharged with --require-spec) and end_to_end (a theorem from
# the source or spec to the exact bytecode: a headline or spec theorem), with each end-to-end
# theorem's full statement, so its hypotheses are visible. They go to the record,
# CERTIFIED/NAME/record.json and .lake/certify-NAME.json. That the regenerated files are the
# committed ones is a separate regression check, tools/certify/regenerated.sh, not part of
# certification.
#
# Environment: SOLIDITY_LEAN_DIR, SOLAR, CERTIFY_SKIP_BUILD, LEAN_MEMORY (MB per Lean process,
# default 3000), LEAN_NUM_THREADS (default 1), CARGO_BUILD_JOBS (default 2), CERTIFY_WRAP (a
# command prefix for every cargo, lake and lean process, such as a job slot limiter),
# CERTIFY_EXAMPLES (default Certified). Two escape hatches, each reported in the result line and
# refused when CI or GITHUB_ACTIONS is set: CERTIFY_ALLOW_UNPINNED=1 accepts a SOLIDITY_LEAN_DIR at another commit, and
# CERTIFY_ALLOW_FOREIGN_SOLAR=1 accepts a SOLAR built from other compiler sources.
set -euo pipefail

root="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
here="$root/tools/certify"
export LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-1}" CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
export LEAN_MEMORY="${LEAN_MEMORY:-3000}"
memory="$LEAN_MEMORY"
examples="${CERTIFY_EXAMPLES:-Certified}"
read -r -a wrap <<<"${CERTIFY_WRAP:-}"
caveats=()
# The escape hatches are for local work only: CI certifies against the pin with its own solar.
if [[ "${CI:-}" == true || -n "${GITHUB_ACTIONS:-}" ]]; then
    for var in CERTIFY_ALLOW_UNPINNED CERTIFY_ALLOW_FOREIGN_SOLAR; do
        [[ -z "${!var:-}" ]] || { echo "certify: error: $var is refused in CI" >&2; exit 1; }
    done
fi
hthms=()
# CERTIFY_WRAP prefixes the builds (a job slot limiter); the checker and the kernel replay never run
# through it, and a run with one set says so.
[[ -z "${CERTIFY_WRAP:-}" ]] || caveats+=("provenance: the builds ran through CERTIFY_WRAP=${CERTIFY_WRAP}")

die() { echo "certify: error: $*" >&2; exit 1; }
run() { "${wrap[@]}" "$@"; }
# capture, tree_diff and the checks of the run's inputs: every producer's exit status is checked.
# shellcheck source=tools/certify/inputs.sh
source "$here/inputs.sh"

# guarded LOG SPEC CMD...: CMD (a build, or a frontend that may run code of an untrusted module) in
# tools/certify/sandbox.sh, output to LOG. SPEC names the modules the step may rebuild, as
# "TARGET... [-- MINUS...]" (those reachable from the TARGETs by the package's import lines, less
# those reachable from the MINUS modules; empty for none), computed before the step and never from
# its output. The package's oleans are snapshotted before and checked after
# (tools/certify/guard_build.py): any other olean changed fails the run and is removed, so that
# nothing an untrusted module wrote survives into a later step or run.
# iso_bin: the bin directory, made once per run, whose lean is tools/certify/lean_iso.sh (each
# lean process of a sandboxed step in a further sandbox that may write only its own outputs), put
# first on PATH for every sandboxed step, so that no module's code can write another's olean.
iso_bin=
# resolve_toolchain: the toolchain directory, found once per run (from the lean lake runs), which
# must be the toolchain tools/certify/toolchain.sha256 records (a digest of every file's SHA-256).
# The driver runs lean and leanchecker by absolute path from it, never as lake env finds them:
# lake env puts each workspace package's .lake/build/bin first on PATH, and a lakefile runs code
# when lake evaluates it, so a binary planted there could stand in for either.
toolchain=
resolve_toolchain() {
    [[ -z "$toolchain" ]] || return 0
    local dir tc
    dir="$(cd "$(dirname "$(readlink -f "$(cd "$lean_dir" && lake env which lean)")")/.." && pwd)" ||
        die "cannot find the toolchain"
    tc="$(cd "$dir" && find . -type f | sort | xargs -d '\n' sha256sum | sha256sum | cut -c1-64)" ||
        die "cannot digest the toolchain at $dir"
    [[ "$tc" == "$(tr -d '[:space:]' < "$here/toolchain.sha256")" ]] ||
        die "the toolchain at $dir is not the one tools/certify/toolchain.sha256 records"
    [[ -x "$dir/bin/lean" && -x "$dir/bin/leanchecker" ]] || die "the toolchain at $dir has no bin/lean and bin/leanchecker"
    toolchain=$dir
}
# no_planted_bins: a build bin directory in the checkout or its path dependencies (outside the
# upstream packages) holds executables lake env would run before the toolchain's; the driver runs
# lean and leanchecker by absolute path anyway, and such a directory fails the run.
no_planted_bins() {
    local found
    found="$(find "$lean_dir" -path "$lean_dir/.lake/packages" -prune -o -type d -path '*/.lake/build/bin' -print)" ||
        die "cannot search $lean_dir for build bin directories"
    [[ -z "$found" ]] || die "the checkout has executables lake env would run before the toolchain's: $(head -3 <<<"$found" | tr '\n' ' ')"
}
iso_setup() {
    [[ -n "$iso_bin" ]] && return
    local tcroot
    resolve_toolchain
    tcroot=$toolchain
    export CERTIFY_REAL_LEAN="$tcroot/bin/lean" CERTIFY_ISO_DIR="$lean_dir/.lake/build/.iso" CERTIFY_ISO_RO="$lean_dir/.lake/build"
    iso_bin="$(bash "$here/sysroot.sh" "$tcroot" "$lean_dir/.lake/certify-sysroot")" || die "cannot set up the isolated lean"
}

guarded() {
    local glog=$1 spec=$2 snap="$lean_dir/.lake/certify-guard.snap" allow="$lean_dir/.lake/certify-guard.allow" status=0
    shift 2
    if [[ -n "$spec" ]]; then
        # shellcheck disable=SC2086
        python3 "$here/guard_build.py" allow "$lean_dir" "$allow" $spec || die "cannot list the modules of the step"
    else
        : > "$allow"
    fi
    python3 "$here/guard_build.py" snap "$lean_dir/.lake/build/lib/lean" "$snap" || die "cannot snapshot the package build"
    iso_setup
    run env PATH="$iso_bin:$PATH" bash "$here/sandbox.sh" "$lean_dir/.lake/build" "$@" > "$glog" 2>&1 || status=$?
    python3 "$here/guard_build.py" check "$lean_dir/.lake/build/lib/lean" "$snap" "$allow" ||
        die "a sandboxed step changed oleans of modules it may not build (removed, rebuilt from source next run)"
    return $status
}

# audit OUT MODULE... -- THEOREM...: tools/certify/audit.sh's axiom audit, failing the run. Its
# Lean frontend imports the audited modules, whose initializers run: in the sandbox, guarded.
audit() {
    local snap="$lean_dir/.lake/certify-guard.snap"
    python3 "$here/guard_build.py" snap "$lean_dir/.lake/build/lib/lean" "$snap" || die "cannot snapshot the package build"
    iso_setup
    CERTIFY_WRAP="${wrap[*]} env PATH=$iso_bin:$PATH bash $here/sandbox.sh $lean_dir/.lake/build" bash "$here/audit.sh" axioms "$lean_dir" "$@" ||
        die "the axiom audit fails"
    : > "$lean_dir/.lake/certify-guard.allow"
    python3 "$here/guard_build.py" check "$lean_dir/.lake/build/lib/lean" "$snap" "$lean_dir/.lake/certify-guard.allow" ||
        die "the axiom audit changed the package build (removed, rebuilt from source next run)"
}
usage="usage: scripts/certify FILE.sol [--contract C] [--name NAME] [--loops N] [--no-negatives] [--require-headline] [--require-spec] [--require-final] [-- SOLAR_OPTIONS...]"
[[ $# -ge 1 ]] || die "$usage"
[[ "$1" != -h && "$1" != --help ]] || { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; exit 0; }
[[ -f "$1" ]] || die "no such file $1"
file="$(realpath "$1")"
shift
contract=
name="$(basename "$file" .sol | tr 'A-Z-' 'a-z_')"
loops=
negatives=1
require_headline=0
require_spec=0
require_final=0
options=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --contract) contract=$2; shift 2 ;;
        --name) name=$2; shift 2 ;;
        --loops) loops=$2; shift 2 ;;
        --no-negatives) negatives=0; shift ;;
        --require-headline) require_headline=1; shift ;;
        --require-spec) require_spec=1; shift ;;
        --require-final) require_final=1; shift ;;
        --) shift; options=("$@"); break ;;
        *) die "unknown argument $1; $usage" ;;
    esac
done
[[ "$name" =~ ^[a-z][a-z0-9_]*$ ]] || die "the name $name is not lowercase letters, digits and _"
[[ -z "$contract" || "$contract" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "the contract $contract is not an identifier"
[[ -z "$loops" || "$loops" =~ ^[0-9]+$ ]] || die "--loops $loops is not a number"
cap="$(python3 -c 'import sys; print("".join(p[:1].upper() + p[1:] for p in sys.argv[1].split("_")))' "$name")"

echo "== 1. the pinned solidity-lean checkout"
pin="$(tr -d '[:space:]' < "$here/solidity-lean.rev")"
lean_dir="$(bash "$here/checkout.sh")" || exit 1
head="$(git -C "$lean_dir" rev-parse HEAD)"
[[ "$head" == "$pin" ]] || caveats+=("solidity-lean at $head, not the pinned $pin")
[[ -d "$lean_dir/$examples" || ! -e "$lean_dir/$examples" ]] || die "$lean_dir/$examples is not a directory"
if [[ -f "$lean_dir/lakefile.lean" ]]; then lakefile=lakefile.lean
elif [[ -f "$lean_dir/lakefile.toml" ]]; then lakefile=lakefile.toml
else die "$lean_dir has no lakefile"; fi
echo "solidity-lean $(git -C "$lean_dir" rev-parse HEAD) at $lean_dir"
dir="$examples/$name"
committed=0
git -C "$lean_dir" ls-files --error-unmatch "$dir/bytecode.hex" > /dev/null 2>&1 && committed=1
cd "$lean_dir"
mkdir -p "$dir"
source="$dir/$name.sol"
[[ "$file" == "$(realpath -m "$source")" ]] || cp "$file" "$source"
if [[ ${#options[@]} -eq 0 ]]; then
    if [[ -f "$dir/options" ]]; then
        mapfile -t options < "$dir/options"
        check_options "$dir/options" "${options[@]}"
    else
        options=(-Ogas --evm-version osaka)
    fi
fi
# Checked before anything is written or compiled: one option per line, each a flag or its value.
check_options "the solar options" "${options[@]}"
printf '%s\n' "${options[@]}" > "$dir/options"
if [[ -n "$loops" ]]; then
    if [[ "$loops" -eq 0 ]]; then rm -f "$dir/loops"; else echo "$loops" > "$dir/loops"; fi
fi
if [[ -e "$dir/loops" ]]; then loops="$(cat "$dir/loops")" || die "cannot read $dir/loops"; else loops=0; fi
check_number "$dir/loops" "$loops"
# CERTIFIED/NAME/heartbeats, when present, is the run proofs' maxHeartbeats (certify.py's
# --heartbeats), for a contract whose symbolic runs need more than the default: a larger budget
# can only let a proof pass, never change what it states.
heartbeats="$(cat "$dir/heartbeats" 2>/dev/null || echo 2000000)"
# CERTIFIED/NAME/joins, when present, cuts the programs at their join points too (certify.py's
# --joins), for a contract whose paths share too many blocks to evaluate each.
joins=()
[[ ! -f "$dir/joins" ]] || joins=(--joins)
[[ "$heartbeats" =~ ^[0-9]+$ ]] || die "$dir/heartbeats is not a number"
# CERTIFIED/NAME/recdepth, when present, is the cut-point segment proofs' maxRecDepth (certify.py's
# --recdepth), for stages whose symbolic segments nest deeper than Lean's default; like the
# heartbeats it can only let a proof pass.
recdepth="$(cat "$dir/recdepth" 2>/dev/null || true)"
[[ -z "$recdepth" || "$recdepth" =~ ^[0-9]+$ ]] || die "$dir/recdepth is not a number"

echo "== 2. solar"
if [[ -n "${SOLAR:-}" ]]; then
    solar="$(realpath "$SOLAR")"
else
    if [[ -z "${CERTIFY_SKIP_BUILD:-}" ]]; then
        (cd "$root" && run cargo build --locked -j "$CARGO_BUILD_JOBS" --bin solar 2>&1 | tail -n 1) ||
            die "cargo cannot build solar"
    fi
    solar="${CARGO_TARGET_DIR:-$root/target}/debug/solar"
fi
[[ -x "$solar" && -f "$solar" ]] || die "no solar binary at $solar"
# The compiler must be an executable the toolchain linked, never a script that could forward
# --version to one binary and compile with another.
[[ "$(head -c 4 "$solar" | od -An -tx1 | tr -d ' \n')" == 7f454c46 ]] || die "$solar is not an ELF executable"
version_out="$("$solar" --version)" || die "$solar --version fails"
version="$(sed -n 's/^Commit SHA: //p' <<<"$version_out")"
[[ "$version" =~ ^[0-9a-f]{40}$ ]] || version="$(sed -n 's/.*+commit\.\([0-9a-f]\{8\}\).*/\1/p' <<<"$version_out" | sed -n 1p)"
[[ -n "$version" ]] || die "cannot read the compiler commit from $solar --version"
if ! { git -C "$root" diff --quiet HEAD -- crates Cargo.toml Cargo.lock &&
    git -C "$root" cat-file -e "$version^{commit}" 2>/dev/null &&
    git -C "$root" diff --quiet "$version" HEAD -- crates Cargo.toml Cargo.lock; }; then
    [[ "${CERTIFY_ALLOW_FOREIGN_SOLAR:-}" == 1 ]] ||
        die "$solar reports commit $version, whose compiler sources are not this checkout's committed ones (touch crates/config/build.rs and rebuild, or CERTIFY_ALLOW_FOREIGN_SOLAR=1)"
    caveats+=("solar $version, not built from this checkout's compiler sources")
fi
echo "solar $version"

# Provenance: what the run starts from. Each doubt is a caveat that starts with "provenance:", and
# the strongest status needs none: a checkout with changes outside the outputs the driver
# regenerates, a solar binary this run did not build whose digest is not the recorded one
# (CERTIFY_SOLAR_SHA256, from PINS.md), and a build directory this run did not rebuild from source
# (CERTIFY_CLEAN_BUILD=1 removes the package's build directory first, so that every module of the
# package is compiled again from its source; the upstream packages stay trusted by directory).
# The checkout is compared file by file with the tree of its HEAD (tools/certify/clean_tree.py:
# replacement objects off, replace refs and grafts refused, index flags reported, every committed
# file hashed from disk, untracked and ignored files counted), except for the outputs the driver
# writes under Certified/*/; final's closure is checked again below against this contract's own.
generated='^Certified/[a-z][a-z0-9_]*/(Statement\.lean|Final\.lean|record\.json|options|loops|\.compile\.log|Shape\.lean|VC\.lean|VC/.*|Discharge\.lean|Discharge/.*|SpecConnect\.lean|gen/.*|Proofs/.*)$'
tree_diff dirty "clean_tree.py on the solidity-lean checkout" python3 "$here/clean_tree.py" "$lean_dir" --allow "$generated"
[[ -z "$dirty" ]] ||
    caveats+=("provenance: the solidity-lean checkout is not its commit: $(head -5 <<<"$dirty" | tr '\n' ';')")
# The driver and the compiler sources of this checkout, the same way.
tree_diff driver_dirty "clean_tree.py on the solar checkout" \
    python3 "$here/clean_tree.py" "$root" --prefix scripts --prefix tools/certify --prefix crates --prefix Cargo.toml --prefix Cargo.lock
[[ -z "$driver_dirty" ]] ||
    caveats+=("provenance: the solar checkout (driver or compiler sources) is not its commit $(git -C "$root" rev-parse HEAD): $(head -5 <<<"$driver_dirty" | tr '\n' ';')")
solar_sha="$(sha256sum "$solar" | cut -c1-64)" || die "cannot digest $solar"
# Only a compiler this run built counts: a binary named by SOLAR or kept by CERTIFY_SKIP_BUILD is a
# caveat whatever digest the runner records for it (CERTIFY_SOLAR_SHA256 is the runner's word).
if [[ -n "${SOLAR:-}" || -n "${CERTIFY_SKIP_BUILD:-}" ]]; then
    if [[ "${CERTIFY_SOLAR_SHA256:-}" == "$solar_sha" ]]; then
        caveats+=("provenance: solar was not built by this run (its digest $solar_sha is the runner's recorded CERTIFY_SOLAR_SHA256)")
    else
        caveats+=("provenance: solar was not built by this run and its digest $solar_sha is not the recorded CERTIFY_SOLAR_SHA256")
    fi
elif [[ -n "${CERTIFY_SOLAR_SHA256:-}" && "${CERTIFY_SOLAR_SHA256}" != "$solar_sha" ]]; then
    caveats+=("provenance: the solar this run built has digest $solar_sha, not the recorded CERTIFY_SOLAR_SHA256")
fi
if [[ "${CERTIFY_CLEAN_BUILD:-}" == 1 ]]; then
    # Everything compiled or cached in the checkout goes: the package's and its path dependencies'
    # build directories, lake's configuration cache, and every file the driver kept (the replay
    # cache among them), so that every module is compiled and replayed again from its source; the
    # upstream git-pinned packages under .lake/packages stay trusted by directory.
    find "$lean_dir" -path "$lean_dir/.lake/packages" -prune -o -type d -path '*/.lake/build' -prune -exec rm -rf {} + ||
        die "cannot remove the build directories of $lean_dir"
    rm -rf "$lean_dir/.lake/build" "$lean_dir/.lake/config"
    # A fresh checkout has no .lake yet: nothing of the driver's to remove.
    if [[ -d "$lean_dir/.lake" ]]; then
        find "$lean_dir/.lake" -maxdepth 1 -name 'certify*' -exec rm -rf {} + || die "cannot remove the driver's files in $lean_dir/.lake"
    fi
    mkdir -p "$lean_dir/.lake/build"
    # The path dependencies (vendor/, committed and checked above) build here, before any module of
    # the run's own proofs exists, since the sandboxed steps may write the package's build only.
    (cd "$lean_dir" && run lake "-KleanMemory=$memory" build EvmYul EvmInteraction 2>&1 | tail -n 1) ||
        die "cannot build the path dependencies of $lean_dir"
else
    caveats+=("provenance: the starting build directory is trusted, not rebuilt from source (CERTIFY_CLEAN_BUILD=1)")
fi
echo "solar sha256 $solar_sha"

echo "== 3. compile $source and export its stages (${options[*]})"
compile() { "$solar" "$source" "${options[@]}" --emit=bin-runtime "$@"; }
# solar's status is checked on its own, never through a pipe: output it printed before failing
# counts for nothing.
status=0
json="$(compile 2>"$dir/.compile.log")" || status=$?
if [[ $status -ne 0 ]]; then cat "$dir/.compile.log" >&2; die "solar does not compile $source (exit $status)"; fi
rm -f "$dir/.compile.log"
if [[ -z "$contract" ]]; then
    contract="$(python3 -c '
import json, sys
c = [k.rsplit(":", 1)[1] for k, v in json.loads(sys.argv[1])["contracts"].items() if v.get("bin-runtime")]
print(c[0] if len(c) == 1 else "")
' "$json")" || die "cannot read solar's output for $source as its JSON"
    [[ -n "$contract" ]] || die "$source has no single contract with runtime code; name one with --contract"
fi
# bin_runtime WHAT: the runtime bytecode of the contract in solar's JSON on stdin, failing with
# WHAT when the output is not JSON, has no such contract, or has no bin-runtime string for it.
bin_runtime() {
    python3 -c '
import json, sys
what, key = sys.argv[1], sys.argv[2]
try:
    out = json.loads(sys.stdin.read())
except ValueError as e:
    sys.exit(f"certify: error: {what} is not JSON: {e}")
contracts = out.get("contracts") if isinstance(out, dict) else None
if not isinstance(contracts, dict) or key not in contracts:
    sys.exit(f"certify: error: {what} has no contract {key}")
v = contracts[key].get("bin-runtime") if isinstance(contracts[key], dict) else None
if v is None:
    sys.exit(f"certify: error: {what} has no runtime bytecode (bin-runtime) for {key}")
if not isinstance(v, str):
    sys.exit(f"certify: error: {what} has a bin-runtime for {key} that is not a string")
print(v)
' "$1" "$source:$contract"
}
plain="$(bin_runtime "solar's output" <<<"$json")" || die "$source has no contract $contract with runtime bytecode (above)"
check_hex "the runtime bytecode solar emits for $contract" "$plain"
rm -rf "$dir/gen"
status=0
exported_json="$(compile "-Zemit-lean-stages=$dir/gen" 2>"$dir/.export.log")" || status=$?
if [[ $status -ne 0 ]]; then
    grep -E '^error' -A3 "$dir/.export.log" >&2 || cat "$dir/.export.log" >&2
    rm -f "$dir/.export.log"
    die "the exporter rejects $contract (exit $status, above): outside the fragment the stages have Lean semantics for"
fi
rm -f "$dir/.export.log"
exported="$(bin_runtime "solar's output with -Zemit-lean-stages" <<<"$exported_json")" ||
    die "the export of $contract has no runtime bytecode (above)"
check_hex "the runtime bytecode solar emits for $contract with -Zemit-lean-stages" "$exported"
[[ "$plain" == "$exported" ]] || die "-Zemit-lean-stages changed the bytecode"
if [[ -e "$dir/bytecode.hex" ]]; then
    [[ -f "$dir/bytecode.hex" ]] || die "$dir/bytecode.hex is not a file"
    pinned="$(tr -d '[:space:]' < "$dir/bytecode.hex")" || die "cannot read $dir/bytecode.hex"
    check_hex "the pinned $dir/bytecode.hex" "$pinned"
    [[ "$plain" == "$pinned" ]] ||
        die "the bytecode is not the pinned $dir/bytecode.hex: $plain"
else
    echo "$plain" > "$dir/bytecode.hex"
fi
gen="$dir/gen/$contract"
[[ -f "$gen/manifest.json" ]] || die "the exporter wrote no $gen/manifest.json"
python3 - "$gen" "$source" "$plain" <<'EOF' || die "the manifest does not match the compiled artifacts"
import hashlib, json, pathlib, sys

directory, source, bytecode = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
manifest = json.loads((directory / "manifest.json").read_text())
sha = lambda path: hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
assert [s["path"] for s in manifest["sources"]] == [source], manifest["sources"]
assert manifest["sources"][0]["sha256"] == sha(source), "source hash"
assert manifest["bytecode"] == bytecode, "manifest bytecode"
assert manifest["bytecode_sha256"] == hashlib.sha256(bytes.fromhex(bytecode)).hexdigest()
for stage in manifest["stages"]:
    assert stage["sha256"] == sha(directory / stage["file"]), stage["file"]
print("stages:", ", ".join(f"{s['definition']} ({s['pass']})" for s in manifest["stages"]))
print("bytecode:", bytecode, "sha256", manifest["bytecode_sha256"])
EOF

echo "== 4. write the proofs"
rm -rf "$dir/Proofs" "$dir/Proofs.lean"
info="$(python3 "$here/certify.py" "$gen" --gen-module "$name.gen.$contract" \
    --proof-dir "$dir/Proofs" --proof-module "$name.Proofs" --namespace "SolarTV.Milestone.$cap" \
    --label "$name" --loops "$loops" --heartbeats "$heartbeats" "${joins[@]}" ${recdepth:+--recdepth "$recdepth"})" || die "certify.py cannot write the proofs"
final="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["final"])' "$info")" ||
    die "certify.py's output names no final theorem"
ident_re="^[A-Za-z_][A-Za-z0-9_.']*$"
[[ "$final" =~ $ident_re ]] || die "certify.py names the final theorem '$final', which is not a Lean name"
echo "$info"

echo "== 5. build and audit the proofs"
# Nothing this run checks may come from a compiled module it did not compile: the package's
# compiled forms of this contract's modules (its proofs, generated stages, statement and published
# proof) are removed with their traces, so that each is built again from the source this run wrote.
rm -rf "$lean_dir/.lake/build/lib/lean/$name" "$lean_dir/.lake/build/ir/$name"
if [[ $lakefile == lakefile.lean ]]; then
    if ! grep -Eq "^lean_lib («$name»|$name)( |$)" lakefile.lean; then
        cat >> lakefile.lean <<EOF

-- $name: the stages of $examples/$name/$name.sol's $contract and their kernel proofs, which
-- solar's scripts/certify writes.
lean_lib «$name» where
  srcDir := "$examples"
  roots := #[\`$name.Proofs]
  globs := #[.submodules \`$name]
EOF
    fi
elif ! grep -q "^name = \"$name\"$" lakefile.toml; then
    cat >> lakefile.toml <<EOF

# $name: the stages of $examples/$name/$name.sol's $contract and their kernel proofs, which
# solar's scripts/certify writes.
[[lean_lib]]
name = "$name"
srcDir = "$examples"
roots = ["$name.Proofs"]
globs = ["$name.+"]
moreLeanArgs = ["-M", "$memory"]
EOF
fi
# The generated files may use none of the escapes the kernel does not check.
bash "$here/audit.sh" scan "$dir" || die "the generated files of $name fail the scan"
mkdir -p .lake
log="$lean_dir/.lake/certify-$name.log"
rm -f "$lean_dir/.lake/certify-vacuous-$name" "$lean_dir/.lake/certify-$name.json.binding"
# lean_modules DIR: the module of each .lean file directly in $examples/DIR, sorted; fails when
# DIR is missing.
lean_modules() {
    local f
    [[ -d "$examples/$1" ]] || { echo "certify: error: no directory $examples/$1" >&2; return 1; }
    for f in "$examples/$1"/*.lean; do
        [[ -f "$f" ]] || continue
        f="${f#"$examples/"}"
        f="${f%.lean}"
        printf '%s\n' "${f//\//.}"
    done
}
capture_nonempty stages "the list of $contract's exported stages ($dir/gen/$contract)" lean_modules "$name/gen/$contract"
capture_nonempty runs "the list of the run proofs ($dir/Proofs/Runs)" lean_modules "$name/Proofs/Runs"
# One module at a time, so that one Lean process runs at a time: the exported stages, which the
# proofs import, then the proofs.
# The execution proof, when certify.py writes one (the final EVM IR inside the assembly checker's
# fragment), runs the bytecode as the final EVM IR.
execution=()
[[ -f "$dir/Proofs/Execution.lean" ]] && execution=("$name.Proofs.Execution")
for module in "${stages[@]}" "${runs[@]}" "$name.Proofs.Stages" "$name.Proofs.Assembly" "${execution[@]}" "$name.Proofs"; do
    printf '%s: ' "$module"
    if ! guarded "$log" "$module" lake "-KleanMemory=$memory" build "$module"; then
        grep -E '^error' -A12 "$log" | head -60 >&2 || tail -40 "$log" >&2
        die "$module does not check"
    fi
    tail -n 1 "$log"
done

# proof_theorems: the theorems $dir/Proofs declares, qualified; none is an empty list (grep's 1),
# and grep failing otherwise fails the run.
proof_theorems() {
    local hits status=0
    hits="$(grep -rhoE '^theorem [A-Za-z0-9_'"'"']+' "$dir/Proofs")" || status=$?
    [[ $status -le 1 ]] || return "$status"
    [[ -n "$hits" ]] || return 0
    awk '{print $2}' <<<"$hits" | sort -u | sed "s/^/SolarTV.Milestone.$cap./"
}
capture thms "the list of the theorems of $dir/Proofs" proof_theorems
[[ ${#thms[@]} -gt 0 ]] || die "no theorems in $dir/Proofs"
printf '%s\n' "${thms[@]}" | grep -qx "$final" || thms+=("$final")
audit "$lean_dir/.lake/certify-audit-$name.out" "$name.Proofs" -- "${thms[@]}"
echo "audited ${#thms[@]} theorems"
mir_status="proved: $final"
executes="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1]).get("executes", ""))' "$info")"
if [[ -n "$executes" ]]; then
    printf '%s\n' "${thms[@]}" | grep -qx "$executes" || die "certify.py names $executes, which $dir/Proofs does not prove"
    assembly_status="executed: $executes"
else
    assembly_status="decoded only: $name.Proofs.Assembly (the bytecode decodes to the final EVM IR's instructions; no execution theorem)"
    caveats+=("assembly decoded, not executed")
fi
e2e_thms=()
e2e_kind=""

# prebuild_packages TARGET...: the modules of the lake packages (the manifest's, at its pinned
# revisions) that the package modules reachable from the TARGETs import, built now, before any
# module of the run's own statement or proofs is built, and outside the sandbox, which may write
# only the package's own build directory. The packages' modules are not trusted for being built
# here: every module of the published closure is replayed through the kernel below.
prebuild_packages() {
    local mods
    capture mods "the list of the package modules $* import" python3 "$here/guard_build.py" packages "$lean_dir" "$@"
    [[ ${#mods[@]} -gt 0 ]] || return 0
    printf 'lake packages (%s modules imported): ' "${#mods[@]}"
    (cd "$lean_dir" && lake "-KleanMemory=$memory" build "${mods[@]/#/+}" > "$lean_dir/.lake/certify-packages-$name.log" 2>&1) ||
        { grep -E '^error' -A8 "$lean_dir/.lake/certify-packages-$name.log" | head -40 >&2; die "the lake packages $* import do not build"; }
    tail -n 1 "$lean_dir/.lake/certify-packages-$name.log"
}

echo "== 6. the spec (solar-verify) and the headline theorems"
# What the headline and the published statement import from the lake packages, built first.
pre_targets=()
if [[ -f "$dir/headline" || -f "$dir/spec" ]]; then
    capture pre_lines "the theorems $dir/headline names" entries $( [[ -f "$dir/headline" ]] && echo "$dir/headline" ) $( [[ -f "$dir/spec" ]] && echo "$dir/spec" )
    for line in "${pre_lines[@]}"; do read -r m _ <<<"$line"; pre_targets+=("$m"); done
fi
if [[ -f "$dir/shape.json" ]]; then
    capture pre_shape "the modules $dir/shape.json names" \
        python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("\n".join(d.get("spec_modules",[])+[d["proof_module"]]))' "$dir/shape.json"
    pre_targets+=("${pre_shape[@]}")
fi
[[ $require_spec -eq 0 ]] || pre_targets+=(Verify.VC.Discharge)
if [[ ${#pre_targets[@]} -gt 0 ]]; then
    if grep -q '"mathlib"' "$lean_dir/lake-manifest.json" 2>/dev/null && [[ ! -d "$lean_dir/.lake/packages/mathlib/.lake/build/lib" ]]; then
        (cd "$lean_dir" && run lake exe cache get) || die "cannot fetch Mathlib's build cache"
    fi
    prebuild_packages "${pre_targets[@]}"
fi
# solar-verify's verification conditions as Lean: every function whose conditions fall outside
# the fragment solidity-lean's checks model is refused, recorded as unproved and never passes.
spec_status="not checked: no solar-verify"
refused=()
verify="${SOLAR_VERIFY:-}"
if [[ -z "$verify" && -d "$root/crates/verify" ]]; then
    if [[ -z "${CERTIFY_SKIP_BUILD:-}" ]]; then
        (cd "$root" && run cargo build --locked -j "$CARGO_BUILD_JOBS" -p solar-verify --bin solar-verify 2>&1 | tail -n 1)
    fi
    verify="${CARGO_TARGET_DIR:-$root/target}/debug/solar-verify"
fi
if [[ -n "$verify" ]]; then
    [[ -x "$verify" ]] || die "no solar-verify binary at $verify"
    spec_dir="$lean_dir/.lake/certify/$name"
    bash "$here/spec.sh" "$verify" "$source" "$spec_dir" "Certified.$cap.VC" || die "the spec export fails"
    [[ -f "$spec_dir/refused" ]] || die "spec.sh wrote no record of the refused functions ($spec_dir/refused)"
    mapfile -t refused < "$spec_dir/refused"
    spec_status="exported to .lake/certify/$name/VC.lean"
    [[ -s "$spec_dir/VC.lean" ]] || spec_status="refused as a whole by solar-verify"
    for entry in "${refused[@]}"; do echo "REFUSED (unproved) $entry"; done
    if [[ $require_spec -eq 1 && ${#refused[@]} -gt 0 ]]; then
        die "${#refused[@]} function(s) of $contract are outside the spec fragment (above)"
    fi
    if [[ $require_spec -eq 1 ]]; then
        # The conditions become the module NAME.VC, discharged in the kernel by Verify.VC.Discharge's
        # dischargeScript (no solver, no verdict). CERTIFIED/NAME/spec (lines "MODULE THEOREM") must
        # then name the theorem that composes them with the bytecode: one theorem from the spec to
        # the exact bytecode, built and audited with the headline.
        cp "$spec_dir/VC.lean" "$dir/VC.lean"
        [[ -f Verify/VC/Discharge.lean ]] || die "--require-spec: the pinned solidity-lean has no Verify/VC/Discharge.lean to discharge the conditions with"
        # The discharge imports Mathlib's tactics: fetch its build cache rather than build it.
        if grep -q '"mathlib"' lake-manifest.json 2>/dev/null && [[ ! -d .lake/packages/mathlib/.lake/build/lib ]]; then
            run lake exe cache get || die "cannot fetch Mathlib's build cache"
        fi
        bash "$here/audit.sh" scan "$dir/VC.lean" || die "the exported conditions fail the scan"
        printf '%s: ' "$name.VC"
        guarded "$log" "$name.VC" lake "-KleanMemory=$memory" build "$name.VC" || { tail -40 "$log" >&2; die "$name.VC does not check"; }
        tail -n 1 "$log"
        # How many obligations the script has and which are vacuous (their hypotheses refuted),
        # by evaluation: the count only sizes the generated modules, whose proof fails when it is
        # wrong, and vacuity is reported, never trusted.
        probe="$lean_dir/.lake/certify-vc-probe-$name.lean"
        printf 'import %s
import Verify.VC.Discharge
open SolidCore.Verify.VC
#eval IO.println s!"COUNT {(obligations Certified.%s.VC.script).length}"
#eval IO.println s!"VACUOUS {((List.range (obligations Certified.%s.VC.script).length).filter (fun i => vacuousAt Certified.%s.VC.script i))}"
'             "$name.VC" "$cap" "$cap" "$cap" > "$probe"
        guarded "$log" "" lake env lean -M "$memory" "$probe" || { tail -40 "$log" >&2; die "cannot count the obligations of $name.VC"; }
        count="$(sed -n 's/^COUNT //p' "$log")"
        vacuous="$(sed -n 's/^VACUOUS //p' "$log")"
        [[ "$count" =~ ^[0-9]+$ ]] || die "cannot count the obligations of $name.VC"
        [[ -f scripts/verify/gen-discharged.py ]] || die "--require-spec: the pinned solidity-lean has no scripts/verify/gen-discharged.py"
        rm -rf "$dir/Discharge" "$dir/Discharge.lean"
        (cd "$examples" && python3 ../scripts/verify/gen-discharged.py "$name.Discharge" "Certified.$cap.VC"             "$name.VC" "Certified.$cap.VC.script" "$count") || die "cannot write the discharge of $name.VC"
        bash "$here/audit.sh" scan "$dir/Discharge.lean" "$dir/Discharge" || die "the discharge fails the scan"
        # One part at a time, so that one Lean process runs at a time.
        mapfile -t parts < <(cd "$examples" && ls "$name"/Discharge/Part*.lean 2>/dev/null | sed 's|\.lean$||; s|/|.|g' | sort -V)
        for module in "${parts[@]}" "$name.Discharge"; do
            printf '%s: ' "$module"
            guarded "$log" "$module" lake "-KleanMemory=$memory" build "$module" || { grep -E '^error' -A12 "$log" | head -40 >&2 || tail -40 "$log" >&2; die "$module does not check: the conditions are not discharged"; }
            tail -n 1 "$log"
        done
        audit "$lean_dir/.lake/certify-vc-$name.out" "$name.Discharge" -- "Certified.$cap.VC.script_valid"
        spec_status="exported and discharged in the kernel ($count obligations): Certified.$cap.VC.script_valid"
        echo "$vacuous" > "$lean_dir/.lake/certify-vacuous-$name"
        [[ "$vacuous" == "[]" ]] || caveats+=("vacuous obligations (hypotheses refuted) at $vacuous")
        # The source-level connection, generically: when CERTIFIED/NAME/spec-connect names
        # (one line "CORE_MODULE NAMESPACE SPEC_MODULE BUNDLE") the contract's checked SolidCore
        # contract and solar-verify's spec bundle, tools/certify/spec_connect.py writes NAME.SpecConnect,
        # whose F_holds state each function's spec of SolidCore's contract on the stage's calls.
        if [[ -f "$dir/spec-connect" ]]; then
            capture sc_lines "the entries of $dir/spec-connect" entries "$dir/spec-connect"
            read -r core_mod core_ns spec_mod spec_bundle rest <<<"${sc_lines[0]:-}"
            [[ -n "${spec_bundle:-}" && -z "${rest:-}" ]] || die "$dir/spec-connect is not CORE_MODULE NAMESPACE SPEC_MODULE BUNDLE"
            capture holds "spec_connect.py, which refuses functions of $contract (above)," python3 "$here/spec_connect.py" \
                --core-module "$core_mod" --namespace "$core_ns" --spec-module "$spec_mod" --bundle "$spec_bundle" \
                --module-name "$name.SpecConnect" --out "$dir/SpecConnect.lean" --lean "${wrap[*]} lake env lean -M $memory" \
                --cwd "$lean_dir"
            [[ ${#holds[@]} -gt 0 ]] || die "spec_connect.py connects no function of $contract"
            bash "$here/audit.sh" scan "$dir/SpecConnect.lean" || die "$dir/SpecConnect.lean fails the scan"
            printf '%s: ' "$name.SpecConnect"
            guarded "$log" "$name.SpecConnect" lake "-KleanMemory=$memory" build "$name.SpecConnect" || { grep -E '^error' -A12 "$log" | head -40 >&2 || tail -40 "$log" >&2; die "$name.SpecConnect does not check"; }
            tail -n 1 "$log"
            audit "$lean_dir/.lake/certify-spec-$name.out" "$name.SpecConnect" -- "${holds[@]}"
            spec_status+="; source spec holds of SolidCore (generic, not yet of the bytecode): ${holds[*]}"
        fi
        [[ -f "$dir/spec" ]] || die "--require-spec: $dir/spec is missing: solidity-lean discharges no VC of $name against its bytecode"
        spec_theorems() { entries "$dir/spec" | awk '{print $2}'; }
        capture_nonempty spec_thms "the theorems $dir/spec names" spec_theorems
        spec_status+="; composed with the bytecode by ${spec_thms[*]}"
    fi
elif [[ $require_spec -eq 1 ]]; then
    die "--require-spec needs solar-verify (SOLAR_VERIFY, or crates/verify in this checkout)"
fi
[[ ${#refused[@]} -eq 0 ]] || caveats+=("${#refused[@]} spec function(s) refused, unproved")
echo "spec: $spec_status"
if [[ -f "$dir/headline" || ( $require_spec -eq 1 && -f "$dir/spec" ) ]]; then
    hfiles=()
    [[ ! -f "$dir/headline" ]] || hfiles+=("$dir/headline")
    [[ ! -f "$dir/spec" ]] || hfiles+=("$dir/spec")
    capture lines "the theorems $dir/headline names" entries "${hfiles[@]}"
    [[ ${#lines[@]} -gt 0 ]] || die "$dir/headline names no theorem"
    hmods=()
    for line in "${lines[@]}"; do
        read -r hmod hthm rest <<<"$line"
        [[ -n "$hmod" && -n "$hthm" && -z "$rest" ]] || die "$dir/headline: '$line' is not MODULE THEOREM"
        hmods+=("$hmod") hthms+=("$hthm")
    done
    sort_unique() { printf '%s\n' "$@" | sort -u; }
    capture umods "the list of the headline modules" sort_unique "${hmods[@]}"
    # The backend proofs need no Mathlib; a headline over SolidCore may, so fetch its build cache
    # rather than build it.
    if grep -q '"mathlib"' lake-manifest.json 2>/dev/null && [[ ! -d .lake/packages/mathlib/.lake/build/lib ]]; then
        run lake exe cache get || die "cannot fetch Mathlib's build cache"
    fi
    for module in "${umods[@]}"; do
        printf '%s: ' "$module"
        hfile="$examples/${module//.//}.lean"
        [[ -f "$hfile" ]] || hfile="${module//.//}.lean"
        if [[ -f "$hfile" ]]; then
            bash "$here/audit.sh" scan "$hfile" || die "$hfile fails the scan"
        fi
        if ! guarded "$log" "$module" lake "-KleanMemory=$memory" build "$module"; then
            grep -E '^error' -A12 "$log" | head -60 >&2 || tail -40 "$log" >&2
            die "$module does not check"
        fi
        tail -n 1 "$log"
    done
    audit "$lean_dir/.lake/certify-headline-$name.out" "${umods[@]}" -- "${hthms[@]}"
    e2e_thms=("${hthms[@]}")
    e2e_kind="contract-specific"
    # Whether each end-to-end theorem is about the freshly exported bytecode: its statement, or
    # else its proof, must reach (through the definitions it unfolds) a constant of the module
    # under NAME.gen.CONTRACT (its Bytecode or Manifest) this run exported. A theorem about a checked-in copy of the code
    # that never meets the fresh export is reported unbound. The check only reads the
    # environment, so a failure to run it is reported, never taken as binding.
    bind="$lean_dir/.lake/certify-bind-$name.lean"
    {
        printf 'import Lean\n'
        printf 'import %s\n' "${umods[@]}" "$name.gen.$contract.Bytecode" "$name.gen.$contract.Manifest"
        cat "$here/bind.lean.in"
        printf '\nopen Lean in\n#eval show CoreM Unit from do\n  let env ← getEnv\n'
        for t in "${hthms[@]}"; do
            printf '  IO.println s!"BIND %s {bindsTo env %s %s false} {bindsTo env %s %s true}"\n' \
                "$t" "\`$name.gen.$contract" "\`$t" "\`$name.gen.$contract" "\`$t"
        done
    } > "$bind"
    if guarded "$log" "" lake env lean -M "$memory" "$bind"; then
        sed -n 's/^BIND \([^ ]*\) \([a-z]*\) \([a-z]*\)$/\1 \2 \3/p' "$log" > "$lean_dir/.lake/certify-$name.json.binding"
    else
        : > "$lean_dir/.lake/certify-$name.json.binding"
        caveats+=("the binding of the end-to-end theorems to the fresh bytecode was not checked")
    fi
elif [[ $require_headline -eq 1 ]]; then
    die "$dir/headline is missing: solidity-lean states no source or spec theorem for $name"
else
    echo "no $dir/headline: no end-to-end theorem"
    caveats+=("not end to end: solidity-lean states no source or spec theorem for $name")
fi

echo "== 6b. the published statement"
# CERTIFIED/NAME/shape.json names the statement's inputs (the checked source, the declared valid
# calls, allowed statuses, specification, environment assumptions and, for the strongest status,
# the gas bound) and the proof term. tools/certify/final.py writes CERTIFIED/NAME/Final.lean, whose
# Statement it builds from shape.json and from $plain, the bytecode this run compiled, never from a
# proof module; the kernel must accept the proof at exactly that type, the statement binds the
# fresh export to $plain by exact equality, and the axiom audit admits only propext,
# Classical.choice and Quot.sound. The statuses come from the statement's kind alone.
final_record="$lean_dir/.lake/certify-$name.json.final"
replay_receipt="$lean_dir/.lake/certify-$name.json.replay"
rm -f "$final_record" "$replay_receipt"
final_thm=
if [[ -f "$dir/shape.json" ]]; then
    if python3 -c 'import json,sys; sys.exit(0 if "generic" in json.load(open(sys.argv[1])) else 1)' "$dir/shape.json"; then
        python3 "$here/shape_gen.py" "$dir/shape.json" --name "$name" --certified "$examples" \
            --out "$dir/Shape.lean" || die "shape_gen.py cannot write the proof of the published statement"
    fi
    # A specification from solar-verify's export: written fresh from the source in this run, as
    # NAME.gen.CONTRACT.Spec, the bundle the statement's postcondition reads (Shapes.bundlePost).
    if python3 -c 'import json,sys; sys.exit(0 if "spec_export" in json.load(open(sys.argv[1])) else 1)' "$dir/shape.json"; then
        [[ -n "$verify" && -x "$verify" ]] || die "shape.json takes its specification from solar-verify's export, and there is no solar-verify"
        rm -f "$dir/gen/$contract/Spec.lean"
        "$verify" --emit-lean-spec "$dir/gen/$contract/Spec.lean" --lean-spec-module "Certified.$name.gen.$contract.Spec" \
            "$source" > "$log" 2>&1 || { cat "$log" >&2; die "solar-verify cannot export the specification of $source"; }
        [[ -s "$dir/gen/$contract/Spec.lean" ]] || die "solar-verify wrote no specification for $source"
        # The whole module, of this run's source: truncated or stale fails here, before Lean reads it.
        python3 "$here/export_check.py" spec "$dir/gen/$contract/Spec.lean" "Certified.$name.gen.$contract.Spec" \
            --source "$source" --contract "$contract" || die "the exported specification of $source is not whole"
        bash "$here/audit.sh" scan "$dir/gen/$contract/Spec.lean" || die "the exported specification fails the scan"
    fi
    # The checked SolidCore source AST, when shape.json names it, must be the front end's AST of
    # this run's source (tools/certify/source_bind.sh), else the run fails.
    rm -f "$lean_dir/.lake/certify-$name.json.source"
    if python3 -c 'import json,sys; sys.exit(0 if "source_ast" in json.load(open(sys.argv[1])) else 1)' "$dir/shape.json"; then
        capture sa_lines "the source_ast of $dir/shape.json" \
            python3 -c 'import json,sys; a=json.load(open(sys.argv[1]))["source_ast"]; print(a["file"], a["namespace"], a["contract"])' "$dir/shape.json"
        read -r sfile sns scontract srest <<<"${sa_lines[0]:-}"
        [[ ${#sa_lines[@]} -eq 1 && -n "${scontract:-}" && -z "${srest:-}" ]] ||
            die "$dir/shape.json's source_ast is not one FILE NAMESPACE CONTRACT"
        bash "$here/source_bind.sh" "$lean_dir" "$source" "$sfile" "$sns" "$scontract" > "$log" 2>&1 ||
            { cat "$log" >&2; die "the checked source AST of $name cannot be bound to this run's source (above)"; }
        cat "$log"
        sed -n 's/^source: //p' "$log" > "$lean_dir/.lake/certify-$name.json.source"
    fi
    rm -f "$dir/Final.lean" "$dir/Statement.lean"
    final_thm="$(python3 "$here/final.py" "$dir/shape.json" --name "$name" --contract "$contract" \
        --hex "$plain" --out "$dir/Final.lean" --statement-out "$dir/Statement.lean" --record "$final_record")" ||
        die "final.py cannot write the published statement"
    # Its record is where the statuses come from: missing, empty or malformed fails the run.
    check_final_record "$final_record"
    bash "$here/audit.sh" scan "$dir/Final.lean" "$dir/Statement.lean" || die "the published statement fails the scan"
    capture_nonempty fmods "the modules $dir/shape.json names" \
        python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("\n".join(d.get("spec_modules",[])+[d["proof_module"]]))' "$dir/shape.json"
    for module in "${fmods[@]}"; do [[ -n "$module" ]] || die "$dir/shape.json names an empty module"; done
    for module in "${fmods[@]}"; do
        mfile="${module//.//}.lean"
        [[ -f "$mfile" ]] || mfile="$examples/${module//.//}.lean"
        [[ -f "$mfile" ]] || die "shape.json names $module, which is not in $lean_dir"
        bash "$here/audit.sh" scan "$mfile" || die "$mfile fails the scan"
    done
    # The statement first, before any code of the proof module runs.
    printf '%s: ' "$name.Statement"
    if ! guarded "$log" "$name.Statement" lake "-KleanMemory=$memory" build "$name.Statement"; then
        grep -E '^error' -A12 "$log" | head -60 >&2 || tail -40 "$log" >&2
        die "$name.Statement does not check"
    fi
    tail -n 1 "$log"
    # Building the proof runs its code (commands, macros, tactics) as this user. It builds in its
    # own PID namespace and a private mount namespace where all of $HOME is read-only (the
    # toolchain, elan's proxies, this checkout, the package's sources, lakefile and .lake but its
    # build directory, the lake packages), with a private /tmp. The
    # oleans of the statement's closure, lake's configuration cache, the toolchain, the driver and
    # what the driver wrote are fingerprinted before and after it (in this process's memory), and no module of
    # the package may take a toolchain root's name: any difference fails the run.
    # The toolchain must be the one tools/certify/toolchain.sha256 records, so that nothing an
    # earlier run executed has changed it (resolve_toolchain); the checker and the replay run its
    # lean and leanchecker by absolute path, never through CERTIFY_WRAP.
    resolve_toolchain
    no_planted_bins
    # The upstream packages the checker trusts without replay, resolved now, before any code of the
    # proof runs: each package's directory and the module roots it may provide.
    CERTIFY_TRUSTED_ROOTS=
    for pkg in mathlib:Mathlib batteries:Batteries aesop:Aesop importGraph:ImportGraph Qq:Qq plausible:Plausible proofwidgets:ProofWidgets LeanSearchClient:LeanSearchClient; do
        pdir="$(realpath -e "$lean_dir/.lake/packages/${pkg%%:*}")" || die "no package ${pkg%%:*} under .lake/packages"
        CERTIFY_TRUSTED_ROOTS+="$pdir=${pkg#*:};"
    done
    export CERTIFY_TRUSTED_ROOTS
    # No replay cache: a cache left by an earlier run (or planted in the checkout) could name a
    # module whose olean holds a declaration the kernel never checked, so every module of final's
    # closure outside the upstream packages is replayed in every run (below). The cache earlier
    # drivers kept is removed so that nothing reads it.
    rm -f "$lean_dir/.lake/certify-replayed-v2"
    # closure_oleans MODULE: the olean of every module of MODULE's closure, one per line; fails
    # when the checker fails or lists none, so that a fingerprint never covers an empty closure.
    closure_oleans() {
        local listing
        listing="$(lake env "$toolchain/bin/lean" --run "$here/check_final.lean" --closure "$1")" || return 1
        awk '$1 == "MODULE" { print $3 }' <<<"$listing" | grep . || return 1
    }
    # fingerprint_files: what the fingerprint covers, each producer's status checked (a group
    # piped on would report only its last command's).
    fingerprint_files() {
        closure_oleans "$name.Statement" || return 1
        find "$toolchain" "$here" -type f || return 1
        if [[ -d "$lean_dir/.lake/config" ]]; then
            find "$lean_dir/.lake/config" -type f -name 'lakefile.olean*' ! -name '*.lock' || return 1
        fi
        echo "$lean_dir/lakefile.lean"; echo "$lean_dir/lake-manifest.json"; echo "$lean_dir/lean-toolchain"
        # What the driver wrote before the build and reads after it.
        for f in "$final_record" "$lean_dir/.lake/certify-$name.json.binding" "$lean_dir/.lake/certify-vacuous-$name"                 "$lean_dir/.lake/certify-$name.json.source" "$dir/Statement.lean" "$dir/Final.lean"                 "$lean_dir/.lake/certify-headline-$name.out" "$lean_dir/.lake/certify-audit-$name.out"; do
            if [[ -e "$f" ]]; then echo "$f"; fi
        done
        printf '%s\n' "$root/scripts/certify"
    }
    fingerprint() {
        local files
        files="$(fingerprint_files)" || return 1
        sort -u <<<"$files" | xargs -r -d '\n' sha256sum | sha256sum
    }
    before="$(fingerprint)" || die "cannot fingerprint the statement's closure"
    printf '%s: ' "$name.Final"
    # shellcheck disable=SC2016
    # The modules the proof brings in beyond the statement are built one at a time, each in its
    # own guarded step that may change that module's olean only: a module (the proof module or
    # anything it imports) can then never rewrite another module, whatever the statements on disk.
    python3 "$here/guard_build.py" order "$lean_dir" "$lean_dir/.lake/certify-order" "$name.Final" -- "$name.Statement" ||
        die "cannot order the modules of the proof of $name"
    capture_nonempty order "the build order of the proof of $name" cat "$lean_dir/.lake/certify-order"
    [[ "${order[-1]}" == "$name.Final" ]] || die "the build order of the proof of $name does not end with $name.Final"
    for m in "${order[@]}"; do
        if ! guarded "$log" "=$m" lake "-KleanMemory=$memory" build "$m"; then
            grep -E '^error' -A12 "$log" | head -60 >&2 || tail -40 "$log" >&2
            die "$name.Final does not check ($m): the proof is not of the published statement"
        fi
    done
    tail -n 1 "$log"
    after="$(fingerprint)" || die "cannot fingerprint the statement's closure"
    [[ "$before" == "$after" ]] || die "building the proof of $name changed the statement's closure, the toolchain or the driver"
    # The build ran in its own PID namespace, so nothing it started outlives it; as a second line,
    # the oleans of final's whole closure are fingerprinted now and again after the checker, the
    # replay and the audit have read them.
    closure_fp() {
        local files
        files="$(closure_oleans "$name.Final")" || return 1
        sort -u <<<"$files" | xargs -r -d '\n' sha256sum | sha256sum
    }
    closure_before="$(closure_fp)" || die "cannot fingerprint final's closure"
    for r in Init Std Lean Lake; do
        [[ ! -e "$lean_dir/.lake/build/lib/lean/$r" && ! -e "$lean_dir/.lake/build/lib/lean/$r.olean" ]] ||
            die "the build left a module named like the toolchain's $r in the package's build"
    done
    # The checker reads the compiled environments with nothing but Lean imported: final's type is
    # exactly the statement module's Statement, that module does not import the proof module, and
    # final's axioms are the three admitted.
    proof_mod="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["proof_module"])' "$dir/shape.json")"
    no_planted_bins
    if ! lake env "$toolchain/bin/lean" --run "$here/check_final.lean" "$name" "$proof_mod" > "$log" 2>&1; then
        cat "$log" >&2
        die "the checker refuses the published statement of $name"
    fi
    grep -v '^MODULE ' "$log"
    # Every module of final's closure that is not upstream must come from a committed, unchanged
    # source, or be one of this contract's own modules: an untracked, ignored or edited file
    # (another contract's generated module among them) imported by the statement or its proof is
    # a provenance caveat.
    unbound="$(python3 - "$log" "$lean_dir" "$name" "$here/clean_tree.py" <<'PYEOF'
import os, re, subprocess, sys, tempfile
log, top, name, ct = sys.argv[1:]
need = {}
out = []
for line in open(log):
    if not line.startswith("MODULE "):
        continue
    _, mod, path, kind, *_ = line.split()
    if kind != "replay" or mod == name or mod.startswith(name + "."):
        continue
    marker = "/.lake/build/lib/lean/"
    if marker not in path:
        out.append("no source for " + mod); continue
    pkg = path.split(marker)[0]
    rel = mod.replace(".", "/") + ".lean"
    lf = os.path.join(pkg, "lakefile.lean")
    dirs = ["", "Certified", "Certified/w1", "tv"] + (re.findall(r'srcDir\s*:=\s*"([^"]+)"', open(lf).read()) if os.path.isfile(lf) else [])
    src = next((c for c in (os.path.join(pkg, d, rel) for d in dirs) if os.path.isfile(c)), None)
    if src is None:
        out.append("no source for " + mod); continue
    repo = subprocess.run(["git", "-C", os.path.dirname(src), "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    if not repo:
        out.append("not in a git checkout: " + mod); continue
    need.setdefault(os.path.realpath(repo), []).append(os.path.relpath(os.path.realpath(src), os.path.realpath(repo)))
for repo, paths in need.items():
    with tempfile.NamedTemporaryFile("w", delete=False) as f:
        f.write("\n".join(sorted(set(paths))) + "\n")
    r = subprocess.run([sys.executable, ct, repo, "--paths", f.name], capture_output=True, text=True)
    os.unlink(f.name)
    out += r.stdout.splitlines()
    if r.returncode not in (0, 1):
        out.append("cannot check " + repo)
print("\n".join(out))
PYEOF
)" || die "cannot check the sources of final's closure"
    [[ -z "$unbound" ]] ||
        caveats+=("provenance: final's closure imports modules whose sources are not committed: $(head -5 <<<"$unbound" | tr '\n' ';')")
    # An olean can hold a declaration the kernel never checked (a proof module may add one with the
    # kernel check switched off), so every module of final's closure, the toolchain's and the
    # upstream packages' included, is replayed through the kernel by the toolchain's leanchecker in
    # this run, nothing skipped for an earlier run or trusted for its directory, and accounted for
    # module by module (tools/certify/replay.py): leanchecker must exit 0 and report replaying each,
    # their oleans must be unchanged, and any module left over fails the run.
    # CERTIFY_REPLAY_TRUST_UPSTREAM=1 (local work only) skips the toolchain and the upstream
    # packages, trusted by their directory (decided again from the toolchain's lib/lean and
    # CERTIFY_TRUSTED_ROOTS, never from the checker's mark alone); that is a provenance caveat
    # naming how many, which blocks the strongest status.
    replay_plan="$lean_dir/.lake/certify-$name.replay-plan"
    include_trusted=(--include-trusted)
    [[ "${CERTIFY_REPLAY_TRUST_UPSTREAM:-}" != 1 ]] || include_trusted=()
    python3 "$here/replay.py" plan "$log" "$replay_plan" --syslib "$toolchain/lib/lean" \
        --require "$name.Final" --require "$name.Statement" --require "$proof_mod" ${include_trusted[@]+"${include_trusted[@]}"} ||
        die "cannot account for the closure of $name.Final"
    capture_nonempty replay_mods "the modules of $name.Final's closure to replay" awk '$1 == "replay" { print $2 }' "$replay_plan"
    replay_status=0
    no_planted_bins
    # In batches, each one leanchecker process, all in this run; the first failing batch stops it.
    # leanchecker replays a batch's modules in parallel, so CERTIFY_REPLAY_BATCH (default 400)
    # bounds its memory; it changes nothing that is replayed.
    batch="${CERTIFY_REPLAY_BATCH:-400}"
    [[ "$batch" =~ ^[1-9][0-9]*$ ]] || die "CERTIFY_REPLAY_BATCH is not a positive number: $batch"
    : > "$log.replay"
    for ((i = 0; i < ${#replay_mods[@]}; i += batch)); do
        lake env "$toolchain/bin/leanchecker" --verbose "${replay_mods[@]:i:batch}" >> "$log.replay" 2>&1 ||
            { replay_status=$?; break; }
    done
    python3 "$here/replay.py" account "$replay_plan" "$log.replay" "$replay_status" "$replay_receipt" \
        --checker "$toolchain/bin/leanchecker" --toolchain "$toolchain" ||
        die "the kernel replay of $name.Final's closure is not accounted for"
    trusted_n="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["trusted_count"])' "$replay_receipt")" ||
        die "cannot read the replay receipt $replay_receipt"
    [[ "$trusted_n" == 0 ]] ||
        caveats+=("provenance: $trusted_n modules of the published closure trusted by directory, not replayed in this run (CERTIFY_REPLAY_TRUST_UPSTREAM=1)")
    audit "$lean_dir/.lake/certify-final-$name.out" "$name.Final" -- "$final_thm"
    closure_after="$(closure_fp)" || die "cannot fingerprint final's closure"
    [[ "$closure_after" == "$closure_before" ]] || die "final's closure changed while it was checked"
    echo "published: $final_thm"
elif [[ $require_final -eq 1 ]]; then
    die "--require-final: $dir/shape.json is missing: no published statement for $name"
else
    echo "no $dir/shape.json: no published statement"
    caveats+=("no published statement: equivalence, termination, spec and resources not stated together")
fi

echo "== 7. negative tests"
if [[ $negatives -eq 1 ]]; then
    bash "$here/negative.sh" "$lean_dir" "$examples" "$name" "$contract" || die "a negative test of $name fails (above)"
    if [[ -f "$dir/shape.json" ]]; then
        CERTIFY_LEAN="lake env lean -M $memory" bash "$here/final_neg.sh" "$lean_dir" "$examples" "$name" "$contract" "$plain" ||
            die "a variant of the published statement checks"
    fi
else
    echo "skipped (--no-negatives)"
    caveats+=("negative tests skipped")
fi

# The run's record: each status, the end-to-end theorems' statements, what was refused, and
# under which caveats.
record="$lean_dir/.lake/certify-$name.json"
if [[ -f "$dir/shape.json" ]]; then
    check_final_record "$final_record"
    [[ -s "$replay_receipt" ]] || die "no receipt of the kernel replay of $name.Final's closure ($replay_receipt)"
fi
printf '%s\n' "${refused[@]}" > "$record.refused"
printf '%s\n' "${caveats[@]}" > "$record.caveats"
printf '%s\n' "${e2e_thms[@]}" > "$record.headline"
python3 - "$record" "$dir/record.json" "$lean_dir/.lake/certify-headline-$name.out" "$contract" "$name" \
    "$source" "$plain" "$version" "$head" "$final" "$mir_status" "$assembly_status" "$spec_status" \
    "$negatives" "$e2e_kind" "$lean_dir/.lake/certify-vacuous-$name" \
    "$lean_dir/.lake/certify-audit-$name.out" "$executes" "$lean_dir/.lake/certify-$name.json.binding" \
    "$final_record" "$replay_receipt" <<'EOF'
import json, re, sys

(out, committed, audit_out, contract, name, source, bytecode, solar, lean, final, mir, assembly,
 spec, negatives, e2e_kind, vacuous_file, proofs_audit, executes, binding_file,
 final_file, replay_file) = sys.argv[1:]
lines = lambda suffix: [l for l in open(out + suffix).read().splitlines() if l]
e2e = lines(".headline")
text = open(audit_out).read() if e2e else ""


def statement(thm, text=text):
    # The audit file's "#check @THM" output, "@THM : TYPE", up to the next report line.
    short = re.escape(thm.rsplit(".", 1)[-1])
    found = re.search(r"^@?\S*" + short + r" :\s*(.*?)(?=^\S|\Z)", text, re.M | re.S)
    return " ".join(found.group(1).split()) if found else None


def depth_step(ch):
    return 1 if ch in "([{⦃" else -1 if ch in ")]}⦄" else 0


def premises(ty):
    # The binders and premises before the conclusion, at bracket depth 0: a reading aid. The
    # statement itself is authoritative.
    out = []
    while ty.startswith("∀"):
        body, j, depth = ty[1:], 0, 0
        while j < len(body) and not (depth == 0 and body[j] == ","):
            depth += depth_step(body[j])
            j += 1
        out += [b.strip() for b in re.findall(r"[({⦃\[]([^(){}\[\]⦃⦄]*:[^(){}\[\]⦃⦄]*)[)}⦄\]]", body[:j])]
        ty = body[j + 1 :].strip()
    parts, depth, cur = [], 0, ""
    for ch in ty:
        depth += depth_step(ch)
        if ch == "→" and depth == 0:
            parts.append(cur.strip())
            cur = ""
        else:
            cur += ch
    return out + parts


stmts = {t: statement(t) for t in e2e}
binding = {t: "not checked" for t in e2e}
try:
    for line in open(binding_file).read().splitlines():
        t, by_statement, by_proof = line.split()
        binding[t] = (
            "statement reaches the fresh export" if by_statement == "true"
            else "proof reaches the fresh export, statement does not" if by_proof == "true"
            else "never reaches the fresh export"
        )
except (OSError, ValueError):
    pass
# Headline files also name negative controls (a wrong spec that fails); they bind nothing.
negative = lambda t: any(w in t.rsplit(".", 1)[-1] for w in ("wrong", "fails", "rejects", "mutant"))
bound = [t for t in e2e if not negative(t) and not binding[t].startswith(("never", "not"))]
# The execution theorem's statement and premises (such as Assemble.EnvOk for environment reads).
exec_stmt = statement(executes, open(proofs_audit).read()) if executes else None
try:
    vacuous = "obligations with refuted hypotheses: " + open(vacuous_file).read().strip()
except OSError:
    vacuous = "not checked"
# The owner's acceptance statuses, each reported apart. They come from the published statement
# (Final.lean, checked by the kernel against the driver's fixed statement) when there is one; the
# strongest status needs all four. Without one, nothing is stated together.
try:
    final = json.load(open(final_file))
except (OSError, ValueError):
    final = None
if final:
    statuses = dict(final["statuses"])
    statuses["assumptions"] = final["assumptions"] or "none beyond the statement's scope"
    statuses["excluded"] = final["excluded"]
    statuses["environment"] = ("fixed, not quantified: one frame, caller 0x2000, the contract at "
                               "0x1000, the block and transaction of Target.message")
    provenance = [c for c in open(sys.argv[1] + ".caveats").read().splitlines() if c.startswith("provenance:")]
    statuses["provenance"] = "; ".join(c[len("provenance: "):] for c in provenance) or "clean"
    # The kernel replay's receipt: every module of the closure replayed in this run or trusted by
    # directory, none unaccounted for (the run fails before this otherwise).
    try:
        replay = json.load(open(replay_file))
    except (OSError, ValueError):
        replay = None
    # The strongest status needs the whole closure replayed in this run: none trusted.
    replay_ok = bool(replay) and replay.get("unaccounted") == [] and replay.get("replayed_count", 0) > 0 and (
        replay["closure"] == replay["replayed_count"]) and replay["trusted_count"] == 0
    statuses["replay"] = (
        f"all {replay['closure']} modules of the published closure replayed by leanchecker in this run; 0 unaccounted"
        if replay_ok else
        f"{replay['replayed_count']} of {replay['closure']} modules of the published closure replayed in this run; "
        f"{replay['trusted_count']} trusted by directory, not replayed "
        f"({', '.join(f'{k}: {len(v)}' for k, v in replay['trusted'].items()) or 'none'})"
        if replay else "not accounted for")
    statuses["strongest"] = bool(final.get("strongest")) and not provenance and replay_ok and all(
        v.startswith(("proved", "not applicable")) for v in final["statuses"].values())
else:
    replay = None
    statuses = {
        "equivalence": "not proved: stage refinement only (" + mir + "; assembly " + assembly.split(":")[0] + ")",
        "termination": "not proved",
        "spec": ("proved of the fresh bytecode (" + e2e_kind + "): " + ", ".join(bound)) if bound
        else ("proved only of a checked-in copy of the code: " + ", ".join(e2e)) if e2e else "not proved",
        "resources": "not proved",
        "assumptions": "see hypotheses and assembly_hypotheses",
        "strongest": False,
    }
try:
    source_ast = open(out + ".source").read().strip() or None
except OSError:
    source_ast = None
statuses["source"] = source_ast or "not bound: the checked SolidCore source AST is not regenerated from the source in this run"
if final:
    # The published statement is about running the exact bytes (Target.runWith), so execution is
    # proved there; the Proofs/ walk alone may only decode.
    assembly = ("executed: inside the published statement " + final["theorem"]
                + " (Shapes.Equiv and Resources over Target.runWith of the exact bytes); Proofs/: " + assembly)
record = {
    "contract": contract,
    "name": name,
    "source": source,
    "bytecode": bytecode,
    "solar": solar,
    "solidity_lean": lean,
    "mir_to_evmir": mir,
    "assembly": assembly,
    "vc": spec,
    "end_to_end": (f"proved ({e2e_kind}): " + ", ".join(e2e)) if e2e else "not proved",
    # The owner's acceptance statuses, each reported apart; the strongest status needs all of
    # equivalence, termination, spec and resources. The stage proofs are one-directional (every
    # result of the later stage is matched by the earlier one's, or a failure that changes
    # nothing), and nothing here proves termination or gas bounds yet.
    "statuses": statuses,
    "final": final,
    "replay": replay if final else None,
    "end_to_end_statement": stmts,
    "binding": binding,
    "hypotheses": {t: premises(s) if s else None for t, s in stmts.items()},
    "refused": [
        {"function": r.split(": ", 1)[0], "reason": r.split(": ", 1)[-1], "status": "refused (unproved)"}
        for r in lines(".refused")
    ],
    "vacuous": (final["statuses"].get("vacuity", "not checked") if final else "not checked: no published statement"),
    "vc_vacuous": vacuous,
    "source_ast": source_ast,
    "assembly_statement": exec_stmt,
    "assembly_hypotheses": premises(exec_stmt) if exec_stmt else None,
    "negative_tests": negatives == "1",
    # The published statement proves execution of the exact bytes, so the decoding caveat of the
    # Proofs/ walk does not apply to a contract that has one.
    "caveats": [c for c in lines(".caveats") if not (final and c.startswith("assembly decoded"))],
    "backend": {"theorem": final},
}
for path in (out, committed):
    with open(path, "w") as f:
        json.dump(record, f, indent=2, ensure_ascii=False)
        f.write("\n")
EOF
rm -f "$record.refused" "$record.caveats" "$record.headline" "$record.binding"
check_run_record "$record"
echo "record: $record and $dir/record.json"
echo "mir_to_evmir: $mir_status"
python3 -c 'import json,sys; print("assembly: " + json.load(open(sys.argv[1]))["assembly"])' "$record"
echo "vc: $spec_status"
if [[ ${#e2e_thms[@]} -gt 0 ]]; then echo "end_to_end: proved ($e2e_kind): ${e2e_thms[*]}"; else echo "end_to_end: not proved"; fi
python3 -c 'import json,sys; c=json.load(open(sys.argv[1]))["caveats"]; c and print("caveats: " + "; ".join(c))' "$record"
python3 -c 'import json,sys; s=json.load(open(sys.argv[1]))["statuses"]; print("statuses: " + ", ".join(k + " " + str(s[k]) for k in ("equivalence", "termination", "spec", "resources", "vacuity", "source", "strongest") if k in s))' "$record"
strongest="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["statuses"]["strongest"])' "$record")" ||
    die "cannot read the strongest status from $record"
[[ "$strongest" == True || "$strongest" == False ]] || die "$record's strongest status is '$strongest'"
# CERTIFIED needs equivalence, termination, spec and resources together, from the published
# statement the kernel checked (kind certified); any other run reports what it checked instead.
if [[ "$strongest" == "True" ]]; then
    echo "CERTIFIED $name ($contract): equivalence, termination, spec and resources by $final_thm; bytecode $plain"
elif [[ -s "$final_record" ]]; then
    missing="$(python3 -c 'import json,sys; s=json.load(open(sys.argv[1]))["statuses"]; print(", ".join(k for k in ("equivalence", "termination", "spec", "resources") if not str(s[k]).startswith("proved")))' "$record")"
    echo "CHECKED $name ($contract), published $final_thm; not certified: not proved: ${missing:-none}; bytecode $plain"
elif [[ ${#e2e_thms[@]} -gt 0 ]]; then
    echo "CHECKED $name ($contract), spec of the bytecode by ${e2e_thms[*]}; not certified: equivalence, termination and resources not proved; bytecode $plain"
else
    echo "CHECKED $name ($contract), not end to end: $final (first lowered MIR to final EVM IR), assembly ${assembly_status%%:*}; bytecode $plain"
fi
